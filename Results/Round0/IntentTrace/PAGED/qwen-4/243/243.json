  "input_elements": [
    {
      "id": "i1",
      "content": "The process starts with the User Begin Creating Account,"
    },
    {
      "id": "i2",
      "content": "followed by User Create Account."
    },
    {
      "id": "i3",
      "content": "After that, the User Create Account is followed by Enter Country."
    },
    {
      "id": "i4",
      "content": "Once the country is entered, the next step is to Enter Credit Card and Bank Details."
    },
    {
      "id": "i5",
      "content": "Once the Credit Card and Bank Details are entered, the next step is to Enter Personal Details."
    },
    {
      "id": "i6",
      "content": "After entering the Personal Details, the next step is to Verify Personal Account."
    },
    {
      "id": "i7",
      "content": "If the account is not verified, then the Account Creation is rejected. However, if the account is verified, then the Account Creation is confirmed."
    },
    {
      "id": "i8",
      "content": "If the account is not verified, then the Account Creation is rejected."
    },
    {
      "id": "i9",
      "content": "if the account is verified, then the Account Creation is confirmed."
    },
    {
      "id": "i10",
      "content": "In case of Account Creation Rejection, the process ends with the Account Creation being rejected."
    },
    {
      "id": "i11",
      "content": "On the other hand, if the Account Creation is confirmed, the process ends with the Account Successfully Created."
    }
  ]
