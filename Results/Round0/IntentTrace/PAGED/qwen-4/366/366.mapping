      "justification": "Captures the negative condition on the first branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "initiate the procurement process"
      ],
      "justification": "Exact match for the action taken when the article is initially unavailable."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
