      ],
      "justification": "Matches the post-shipment verification step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If it"
      ],
      "justification": "Introduces the second exclusive decision point regarding post-shipment availability."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "is still not available"
      ],
      "justification": "Captures the negative condition for the second decision."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "initiate the procurement process"
      ],
      "justification": "Exact match for the fallback procurement action."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
