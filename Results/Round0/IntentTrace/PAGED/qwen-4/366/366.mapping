      "justification": "Captures the positive condition on the first branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "proceed to ship it"
      ],
      "justification": "Direct match for the shipping action under the positive branch."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
