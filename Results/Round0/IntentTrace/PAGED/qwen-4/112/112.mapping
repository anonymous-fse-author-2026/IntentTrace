{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "Implicit process start combined with the initial registration step."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "Decision point checking for an exception need, leading to the request action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "On the other hand, if an exception is not needed, the process can continue."
      ],
      "justification": "Handles the negative case of the exception decision."
    },
    {
      "refs": [
        "action:n4",
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "After the exception is approved, the next step is course enrollment, followed by seminar group enrollment."
      ],
      "justification": "Approval check, implicit branching, and sequential enrollment steps."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the seminar group enrollment is completed, the homework assignment can be started."
      ],
      "justification": "Direct mapping to starting the homework."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After working on the homework, it should be turned in."
      ],
      "justification": "Direct mapping to submitting the homework."
    },
    {
      "refs": [
        "action:n11",
        "action:n25"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated, and the process can continue."
      ],
      "justification": "Evaluation step and subsequent flow continuation."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given. However, if it was the last homework, the process can continue."
      ],
      "justification": "Decision on homework completion status directing flow to either repeat or proceed."
    },
    {
      "refs": [
        "action:n14",
        "action:n15",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "Parallel split for concurrent tasks, summary step, individual tasks, and implicit merge point."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After signing up for the exam, it should be attended."
      ],
      "justification": "Sequential exam registration and attendance steps."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once the exam is attended, it will be evaluated."
      ],
      "justification": "Direct mapping to the exam evaluation step."
    },
    {
      "refs": [
        "action:n21",
        "action:n22",
        "action:n23",
        "action:n24",
        "action:n26"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue. However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Exam result decision, pass/fail outcomes, retry loop path, merge point, and process termination."
    }
  ],
