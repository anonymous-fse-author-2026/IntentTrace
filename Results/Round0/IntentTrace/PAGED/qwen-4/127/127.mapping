{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "The opening clause implicitly triggers the process start (init and n1) and explicitly defines the first task (n2)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer"
      ],
      "justification": "The conditional phrasing supports both the condition-modeled-as-action (n3) and the subsequent XOR decision node (b1)."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "they should then check the availability of the parts"
      ],
      "justification": "The affirmative guard path directs flow to the availability check action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if they already have the availability information, they can proceed with the process"
      ],
      "justification": "The negative guard path directs flow to the proceeding action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer"
      ],
      "justification": "The second conditional phrasing supports both the condition-modeled-as-action (n6) and the subsequent XOR decision node (b2)."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "the team can also continue with the process"
      ],
      "justification": "The affirmative continuation implies convergence back to the main flow."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if they need to record the customer's details"
      ],
      "justification": "The negative guard path directs flow to recording customer details."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "they should order and receive the part from Disuki"
      ],
      "justification": "Direct paraphrase of the procurement step following the details recording."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the team can then contract the customer"
      ],
      "justification": "Direct paraphrase of the contracting step following part receipt."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected, the team can proceed with the payment"
      ],
      "justification": "Collection of all parts implies a convergence point, immediately followed by the payment action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end"
      ],
      "justification": "Payment completion maps to the explicit end action and the structural end node."
    }
  ],
