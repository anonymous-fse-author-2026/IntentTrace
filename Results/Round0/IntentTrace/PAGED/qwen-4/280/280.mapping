{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "The opening clause implicitly signals process initiation and directly describes the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "then Check Levels of Inventory"
      ],
      "justification": "Direct sequential action following the initialization."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the inventory"
      ],
      "justification": "Introduces the exclusive decision point regarding inventory status."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "is below or equal to the minimum"
      ],
      "justification": "Captures the threshold and operator for the first branch path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report"
      ],
      "justification": "Action step directly matches the consequence of the first condition."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "is greater than the minimum"
      ],
      "justification": "Captures the threshold and operator for the alternative branch path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report"
      ],
      "justification": "Action step directly matches the consequence of the alternative condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)"
      ],
      "justification": "Action faithfully captures the purchase order creation step triggered by the report condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "The clause explicitly describes process termination for the above-minimum scenario, justifying both the terminal action and the structural end node."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Action step captures the mandatory review following PO creation."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the PO is rejected"
      ],
      "justification": "Introduces the XOR decision point regarding PO approval status."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If the PO is rejected"
      ],
      "justification": "Guard condition aligns with the rejection path trigger."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "it needs to be reworked."
      ],
      "justification": "Action step matches the required rework consequence."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the PO is approved"
      ],
      "justification": "Guard condition aligns with the approval path trigger."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "it is printed and released in the system."
      ],
      "justification": "Action step matches the printing and releasing consequence."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs"
      ],
      "justification": "The timing word triggers an AND split, and the clause describes the first parallel action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "and mail the POs to the supplier."
      ],
      "justification": "Describes the second parallel action running concurrently."
    },
    {
      "refs": [
        "label:n10->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Label marks the state transition after reservation, and action captures receiving the slip."
    },
    {
      "refs": [
        "label:n11->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Label marks the state transition after mailing, and action captures receiving the inventory."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Single clause supports the decision gateway, its guard condition, and the subsequent proceed action."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Single clause supports the decision gateway, its guard condition, and the subsequent proceed action."
    },
    {
      "refs": [
        "action:n16",
        "label:n15->n17"
      ],
      "verbatim_texts": [
        "If the Invoice is received"
      ],
      "justification": "Supports both the explicit invoice receipt action and the transitional label indicating invoice arrival."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match."
      ],
      "justification": "Action step directly matches moving forward to the matching stage."
    },
    {
      "refs": [
        "guard:b5->n18"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful"
      ],
      "justification": "Introduces the decision point and guard for a successful match outcome."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "release the funds."
      ],
      "justification": "Action step matches the fund release consequence."
    },
    {
      "refs": [
        "label:n18->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Label captures the post-release state transition, and action captures issuing the payment."
    },
    {
      "refs": [
        "label:n19->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete"
      ],
      "justification": "Label marks the payment state, and action captures the cycle completion milestone."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Explicit textual closure signal justifies the final structural end node."
    }
  ],
