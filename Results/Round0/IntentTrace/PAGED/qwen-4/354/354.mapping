{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks,"
      ],
      "justification": "The opening clause implicitly triggers the process start and directly describes the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then they should select the method for exit control checks."
      ],
      "justification": "Direct paraphrase of the second sequential step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics, they should undergo a check using biometrics."
      ],
      "justification": "The conditional clause introduces the XOR split, and the consequent specifies the biometrics action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the passenger prefers to use ID documents, they should undergo checks using identity documents."
      ],
      "justification": "Directly describes the alternative path action following the XOR split."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After the exit control checks,"
      ],
      "justification": "Indicates that the two divergent check paths (biometrics vs ID) rejoin before the next decision point."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "if the passenger is denied permission,"
      ],
      "justification": "Models the conditional evaluation as an action step followed by a branch, faithfully preserving the source logic per paraphrase rules."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should leave the area."
      ],
      "justification": "Exact match for the negative-arm action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Direct paraphrase of the positive-arm action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful,"
      ],
      "justification": "Models the second conditional evaluation and branch point, accurately reflecting the source condition."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the passenger should leave the area and the process ends."
      ],
      "justification": "Captures the negative outcome action, the structural process termination, and the implicit convergence of final paths."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Direct paraphrase of the successful outcome path leading to termination."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Redundant but faithful restatement of the terminal state; redundancy is acceptable as it does not alter behavior and directly corresponds to the source."
    }
  ],
