{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "The opening clause implicitly starts the process (init) and explicitly describes triggering the resupply cycle and checking inventory levels."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "Captures the conditional check, the implied XOR branch, the positive guard outcome, and the purchase order creation action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Maps to the negative guard condition, the termination step for sufficient inventory, and the structural process end."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Direct match for the post-creation review step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "Captures the rejection condition, the XOR decision point, the positive rejection guard, and the rework action."
    },
    {
      "refs": [
        "guard:b2->n22",
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Maps to the approval path guard and the subsequent approval check and fund reservation steps."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "Corresponds to the second textual instance of the rejection and rework branch."
    },
    {
      "refs": [
        "action:n13",
        "guard:b4->n14",
        "action:n14",
        "guard:b4->c1",
        "guard:b5->c1"
      ],
      "verbatim_texts": [
        "Otherwise, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Corresponds to the second textual instance of the approval path, including associated guards, branches, and the converge point where reworked/approved flows rejoin."
    },
    {
      "refs": [
        "action:n9",
        "action:n12"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Covers the sequential review steps following rework cycles."
    },
    {
      "refs": [
        "action:n24",
        "action:n15"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Matches the fund reservation and supplier dispatch actions across the approval paths."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Matches the explicit concurrency trigger (AND branches), the implicit flow converges for parallel tracks, and the receipt actions for both documents."
    },
    {
      "refs": [
        "action:n18",
        "action:n27"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Direct match for the packing slip recording actions across parallel paths."
    },
    {
      "refs": [
        "action:n19",
        "action:n28"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Direct match for the invoice recording actions across parallel paths."
    },
    {
      "refs": [
        "action:n20",
        "action:n29"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Maps to the packing slip recording termination steps and their corresponding structural end nodes."
    },
    {
      "refs": [
        "action:n21",
        "action:n30"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Maps to the invoice recording termination steps and their corresponding structural end nodes."
    }
