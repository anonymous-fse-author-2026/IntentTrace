{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "The opening sentence implicitly starts the process, describes initiating the resupply cycle, and specifies the initial inventory check step."
    },
    {
      "refs": [
        "action:n3",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report. If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "The conditional logic introduces the XOR branch and the corresponding decision action, while specifying both report generation outcomes."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "Directly matches the action to create purchase orders under the specified report condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "The clause describes terminating the process for the above-minimum case, supporting both the termination action and the structural end node."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Faithfully restates the requirement to review the newly created purchase order."
    },
    {
      "refs": [
        "action:n9",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked. If the PO is approved, it is printed and released in the system."
      ],
      "justification": "The approval/rejection logic defines the XOR branch, the status check action, and both downstream actions (print/release and rework)."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "The keyword 'Simultaneously' triggers the AND gateway, and the clause details both parallel execution actions."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip. If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Each conditional directly maps to its respective receipt action following the parallel execution branches."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice. If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "These transitional clauses signal the reconvergence of the parallel tracking paths before proceeding to invoicing, justifying both the converge node and the receive-invoice action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Directly supports the transition step into the matching phase."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "The clause covers performing the match operation and the subsequent fund release upon a successful outcome."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Clearly specifies the payment issuance step immediately following fund release."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "The closing statement marks the final completion action and the terminal end node of the overall process."
    }
  ],
