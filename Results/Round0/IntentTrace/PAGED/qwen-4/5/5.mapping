      ],
      "justification": "Directly corresponds to the purchase order submission step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the P.O. is submitted, proceed to Ship Material."
      ],
      "justification": "Captures the transition to the shipping step upon PO completion."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "At this point, check if the shipment is okay."
      ],
      "justification": "Corresponds to the first verification step modeled as an action."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If it is, then proceed to Send Payment.",
        "However, if there are any problems with the shipment, communicate them accordingly."
      ],
      "justification": "These conditional clauses implicitly define the exclusive choice gateway."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is, then proceed to Send Payment."
      ],
      "justification": "Directly maps to the positive outcome arm of the first check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if there are any problems with the shipment, communicate them accordingly."
      ],
      "justification": "Directly maps to the negative outcome arm of the first check."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After checking the shipment status again"
      ],
      "justification": "Paraphrases the second verification step mentioned in the text."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "if it is okay, proceed to Send Payment.",
        "Otherwise, communicate any shipment problems."
      ],
      "justification": "These clauses define the second exclusive choice gateway."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "if it is okay, proceed to Send Payment."
      ],
      "justification": "Maps to the positive outcome of the second check."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Otherwise, communicate any shipment problems."
      ],
      "justification": "Maps to the negative outcome of the second check."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, once the payment is sent, the process comes to an end."
      ],
      "justification": "Explicitly states the final action and the termination of the process."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "In case there were any shipment problems, make sure to communicate them before proceeding to Ship Material."
      ],
      "justification": "Captures the loop-back communication requirement before shipping."
    }
