{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "Captures the process initiation and the initial team joining/agreement steps."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model and check it."
      ],
      "justification": "Directly matches the model creation and verification step."
    },
    {
      "refs": [
        "label:n3->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\", then assign negative points."
      ],
      "justification": "Label indicates the condition state, branch handles the XOR decision, and actions cover the check and point assignment."
    },
    {
      "refs": [
        "label:n5->n6",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\", assign negative points again."
      ],
      "justification": "Matches the second conditional check and repeated point assignment."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Both redundant action nodes faithfully restate the continuation step."
    },
    {
      "refs": [
        "label:n8->n10",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Label denotes the decision path, branch handles the condition, and actions cover the issue check and remediation."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "Guard and branch represent the conditional flow; actions represent the check and subsequent continuation."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Matches the conditional analysis requirement and role assignment action."
    },
    {
      "refs": [
        "guard:b5->n16",
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Covers the condition, continuation, and execution of role-based work."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct match of the monitoring and consultation step."
    },
    {
      "refs": [
        "label:n19->n20",
        "action:n20",
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it. If not, continue working according to your role."
      ],
      "justification": "Captures the acceptance check, presentation, and fallback working step."
    },
    {
      "refs": [
        "label:n22->n23",
        "action:n23",
        "action:n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again. If not, continue working according to your role."
      ],
      "justification": "Captures the second acceptance iteration and corresponding actions."
    },
    {
      "refs": [
        "action:n26",
        "action:n27",
        "action:n28",
        "action:n29"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Multiple redundant end nodes and actions all map to the final closing statement."
    }
  ],
