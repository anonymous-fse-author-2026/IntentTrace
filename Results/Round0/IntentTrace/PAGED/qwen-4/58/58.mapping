{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "The opening clause explicitly starts the process (init) and describes the first prioritization action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information. If the customer exists,"
      ],
      "justification": "Describes checking customer info/existence and implicitly triggers the XOR decision point."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "we move on to checking their payment history."
      ],
      "justification": "Directly matches the positive arm action following the existence check."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "On the other hand, if the customer does not exist, we need to verify their customer status."
      ],
      "justification": "Directly matches the negative arm action for non-existent customers."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process."
      ],
      "justification": "Captures the conditional evaluation and the implied branch gateway."
    },
    {
      "refs": [
        "action:n7",
        "action:n6",
        "action:n31"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Covers the condition check, branch split, decline action, and the implicit path termination represented by n31."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Directly matches the two sequential actions for wholesaler customers."
    },
    {
      "refs": [
        "action:n11",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Captures the availability condition, XOR split, production/decline action, explicit end-step action, and process termination."
    },
    {
      "refs": [
        "action:n14",
        "action:n30"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Matches the continuation/confirmation action and its implicit path termination."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "The word 'Simultaneously' drives the AND split, followed by the two parallel notification actions."
    },
    {
      "refs": [
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Sequentially covers packing, invoicing, and the resulting readiness state."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Matches the order closure step and the subsequent delivery action."
    },
    {
      "refs": [
        "action:n22",
        "action:n23",
        "action:n29"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Covers payment verification, the branch decision, the closing action, and its implicit path termination."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Directly matches the outstanding payment branch action."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Captures the reminder count condition, XOR split, and continuation action."
    },
    {
      "refs": [
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Matches the high-reminder threshold action, the explicit end-step action, and the final process termination node."
    }
  ],
