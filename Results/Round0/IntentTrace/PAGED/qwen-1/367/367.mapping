      "verbatim_texts": [
        "receive the Packing Slip",
        "receive the Invoice",
        "proceed to the Three-way match",
        "release the funds",
        "issue the payment"
      ],
      "reason": "The entire receipt, validation, fund release, and payment issuance sequence described later in the source is completely absent from the model."
    }
