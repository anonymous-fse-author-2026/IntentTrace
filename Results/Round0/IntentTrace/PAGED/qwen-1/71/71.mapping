    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it does, the process ends."
      ],
      "justification": "Positive requirement outcome guard, the explicit end action, and the structural end node all derive from this clause."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
