{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "The opening sentence explicitly starts the process and describes the first two sequential actions."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
      ],
      "justification": "Captures the initial conditional decision, the condition text modeled as an action, the positive branch guard, and the corresponding delivery processing action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance."
      ],
      "justification": "Maps the alternative condition guard and the resulting outstanding balance state action."
    },
    {
      "refs": [
        "action:n6",
        "action:n8"
      ],
      "verbatim_texts": [
        "In the case of an Outstanding Balance, a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "Describes placing a new order, specifies the explicit termination location, and maps to the process end node."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If a new order is placed, it will be recorded in the Accounts Receivable."
      ],
      "justification": "Direct mapping to the accounts receivable recording step following the new order placement."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If Payments are Received, the process continues."
      ],
      "justification": "Covers the payment verification step, the decision point, the positive outcome guard, and the convergence node implied by process continuation."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "However, if no payments are received, the order is dropped."
      ],
      "justification": "Maps the negative payment outcome guard, the drop action, the resulting state, and the termination of this specific path."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Next, identify the order for installation."
      ],
      "justification": "Direct paraphrase mapping to the order identification step."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n14",
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled, an Installer will be assigned."
      ],
      "justification": "Covers the scheduling condition, the exclusive decision branch, the positive guard, the assignment action, the resulting state, and the branch's endpoint."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "On the other hand, if the order does not require installation, it will be packed for delivery."
      ],
      "justification": "Maps the alternative condition guard, the packing action, the resulting state, and the termination of this alternative path."
    }
  ],
