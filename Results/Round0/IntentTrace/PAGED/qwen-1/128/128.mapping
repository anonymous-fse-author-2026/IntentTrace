{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "The opening clause implicitly signals process initiation and describes the first return action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process. However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Captures the decision inquiry and the implicit XOR split between two return methods."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "\"Delivery Crew picks-up items at the event site\""
      ],
      "justification": "Directly matches the conditional payload on the positive guard path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the items are counted and compared to the original contract"
      ],
      "justification": "Exact paraphrase of the counting verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Covers the order status assessment and the three-way XOR branching logic."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "\"Order is incomplete and items are missing\""
      ],
      "justification": "Matches the threshold condition for the missing-items branch."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "\"Order is complete but items are damaged\""
      ],
      "justification": "Matches the threshold condition for the damaged-items branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Direct match for the customer notification action on the missing-item path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Direct match for the damage notification action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Exact match for the inventory removal step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process. However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Captures the follow-up compliance check and its binary split."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "when the process is complete, it ends."
      ],
      "justification": "Structural termination node paired with the explicit completion statement."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Represents the repair evaluation question and the subsequent XOR decision."
    },
    {
      "refs": [
        "guard:b4->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "\"Items are repaired and added into inventory\""
      ],
      "justification": "Both the guard condition and the resulting action step directly reuse this exact phrase."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "\"Items can't be repaired and are discarded\""
      ],
      "justification": "Direct match for the discard state action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "we email the customer with replacement charges"
      ],
      "justification": "Direct match for the post-discard notification."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\" we continue the process. If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Matches the final routing decision point between packing and storage."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges, and the process is complete."
      ],
      "justification": "Implicit flow convergence precedes the final reconciliation email action."
    }
  ],
