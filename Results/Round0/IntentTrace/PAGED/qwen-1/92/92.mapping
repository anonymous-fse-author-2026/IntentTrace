      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To start,"
      ],
      "justification": "The opening temporal phrase implicitly signals the process start."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request."
      ],
      "justification": "The conditional introduces the XOR branch, the condition is captured by the decision-style action step, and the result matches the registration action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "Direct match for the alternative path action when a fee exists."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Explicit statement of termination following the direct-registration path justifies the end node."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Faithful restatement of the verification step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Captures the second XOR decision point and the action taken on the positive outcome."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Direct match for the outcome on the negative/rejection arm."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Exact match for the follow-up step triggered by the approval notification."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Explicit termination statement on the rejection path justifies the second end node."
    }
  ],
