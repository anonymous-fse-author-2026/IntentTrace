@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start: Initiate New Resupply Cycle;
:Check Inventory Levels;
:v1: Check Inventory Levels ({Inventory <= Minimum, Inventory > Minimum}); <<objectSignal>>
if () then ([v1 = 'Inventory <= Minimum'])
:Generate Equal to or below minimum Report;
:Create Purchase Order (PO);
:Review PO;
:v2: Review PO ({Approved, Rejected}); <<objectSignal>>
if () then ([v2 = 'Approved'])
:Print and Release PO;
split
:Reserve Funds for Released POs;
-> Funds Reserved;
:Receive Packing Slip;
:v3: Receive Packing Slip ({Packing Slip Received}); <<objectSignal>>
if () then ([v3 = 'Packing Slip Received'])
:Proceed to Receive Invoice;
:Receive Invoice;
endif
kill
split again
:Mail POs to Supplier;
-> POs Mailed;
:Receive Inventory;
:v4: Receive Inventory ({Inventory Received}); <<objectSignal>>
if () then ([v4 = 'Inventory Received'])
:Proceed to Receive Packing Slip;
-> Invoice Received;
:Three-way Match;
:v5: Three-way Match ({Successful Match}); <<objectSignal>>
if () then ([v5 = 'Successful Match'])
:Release Funds;
-> Funds Released;
:Issue Payment;
-> Payment Issued;
:End: Resupply Cycle Complete;
stop
endif
endif
end split
else ([v2 = 'Rejected'])
:Rework PO;
endif
else ([v1 = 'Inventory > Minimum'])
:Generate Above Minimum Report;
:End: Process Ends (Above Minimum);
stop
endif
@enduml