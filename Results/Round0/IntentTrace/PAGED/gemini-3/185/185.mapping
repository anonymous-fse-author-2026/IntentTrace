      ],
      "justification": "Captures the low priority condition."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked"
      ],
      "justification": "Exact match for checking compliance."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
