      ],
      "justification": "Exact match for entering SLA information."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The date for completion is also entered"
      ],
      "justification": "Exact match for entering the completion date."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
