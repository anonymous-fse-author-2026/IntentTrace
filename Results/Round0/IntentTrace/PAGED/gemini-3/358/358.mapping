    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n3",
        "action:n5",
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "However, if the answer is \"Yes\","
      ],
      "justification": "This condition justifies the 'Yes' branches and the associated action to give priority for both initial decisions, as the model interprets them in parallel."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
