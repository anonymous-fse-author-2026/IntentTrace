{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For TS recruitment, the first step is to advise unsuccessful candidates."
      ],
      "justification": "The text initiates the process and explicitly describes the first step of advising unsuccessful candidates."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\""
      ],
      "justification": "Captures the conditional check for more candidates."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the position should be re-advertised."
      ],
      "justification": "Direct paraphrase of re-advertising the position."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "if the terms and conditions of the offer for a candidate need to be sorted out"
      ],
      "justification": "Captures the condition to check terms and conditions."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form"
      ],
      "justification": "Direct paraphrase of sending the appointment approval form."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the manager is an external resource"
      ],
      "justification": "Captures the check for an external resource manager."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "if the approver is an existing employee of the client, the process continues."
      ],
      "justification": "Matches the action to continue the process for existing employees."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the form is approved"
      ],
      "justification": "Captures the approval of the form."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "they may not authorize the form."
      ],
      "justification": "Captures the conditional check on whether the form was authorized by the external approver."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "justification": "Direct paraphrase of scanning and recording the form."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the candidate has not accepted, the process continues."
      ],
      "justification": "Matches the continuation of the process when terms/redundancy are not accepted."
    },
    {
      "refs": [
        "action:n14",
        "action:n20"
      ],
      "verbatim_texts": [
        "The TS HR coordinator informs the recruitment manager, who then liaises with the HR representative"
      ],
      "justification": "Captures the action to inform the manager and liaise with HR, which appears redundantly in the model."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If there are any variations"
      ],
      "justification": "Captures the conditional check for variations."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "a complete business case is required."
      ],
      "justification": "Matches the creation of a business case."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Otherwise, the process continues."
      ],
      "justification": "Matches the continuation of the process."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate."
      ],
      "justification": "Captures the condition for a medical assessment."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "arrange and complete",
        "take up to 21 days"
      ],
      "justification": "Matches the action and duration of the medical assessment."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory"
      ],
      "justification": "Captures the condition checking the assessment result."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "the next candidate on the shortlist should be contacted."
      ],
      "justification": "Matches the action of contacting the next candidate."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "if the assessment is fine, the process continues."
      ],
      "justification": "Matches the process continuation action."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "The recruitment manager makes a formal verbal offer of employment to the candidate."
      ],
      "justification": "Direct paraphrase of making the verbal offer."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "If the candidate accepts"
      ],
      "justification": "Captures the candidate acceptance condition."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "the recruitment manager creates a formal written offer."
      ],
      "justification": "Direct paraphrase of creating a written offer."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "If the candidate declines, the process continues."
      ],
      "justification": "Matches the process continuation upon declining."
    },
    {
      "refs": [
        "branch:b11"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "The keyword implies parallel execution supported by an AND gateway."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "the commencement pack and letter of appointment are sent to the candidate."
      ],
      "justification": "Matches sending the commencement documents."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "if there is a \"40%\" rate"
      ],
      "justification": "Captures the check for the 40% rate."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "renegotiation is required."
      ],
      "justification": "Matches the renegotiation action."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful"
      ],
      "justification": "Captures the condition verifying successful renegotiations."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "the next candidate on the shortlist should be identified."
      ],
      "justification": "Direct paraphrase of identifying the next candidate."
    },
    {
      "refs": [
        "action:n33"
      ],
      "verbatim_texts": [
        "the process continues."
      ],
      "justification": "Matches the continuation step."
    },
    {
      "refs": [
        "action:n34"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "The closing statement supports the final procedural actions, end event, and the implied convergence of prior open paths."
    }
  ],
  "mutations": [],
  "omissions": [
    {
      "verbatim_texts": [
        "check if the candidate has accepted a voluntary redundancy.",
        "if the candidate has accepted, further investigation is required."
      ],
      "reason": "The model missed the explicit action to investigate if a voluntary redundancy was accepted."
    }
  ],
