{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "The text initiates the process and implies the start action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process. However, if the \"Delivery Crew picks-up items at the event site,\""
      ],
      "justification": "The conditions open an XOR decision regarding how the items were returned."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "Delivery Crew picks-up items at the event site"
      ],
      "justification": "Matches the specific branch condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the items are counted and compared to the original contract"
      ],
      "justification": "Direct paraphrase of the counting step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\""
      ],
      "justification": "Describes the evaluation of the order status leading to a split."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "Order is incomplete and items are missing"
      ],
      "justification": "Matches the condition for incomplete orders."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "Order is complete but items are damaged"
      ],
      "justification": "Matches the condition for damaged items."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Direct paraphrase of emailing the customer regarding missing items."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process. However, if the \"Customer does not return the missing items,\""
      ],
      "justification": "Sets up the decision point for missing items return."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Direct paraphrase of emailing about damage."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "temporarily take them out of inventory"
      ],
      "justification": "Direct paraphrase of taking damaged items out of inventory."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\""
      ],
      "justification": "Condition modeled as an action step to check repair status and branch."
    },
    {
      "refs": [
        "action:n10",
        "guard:b4->n10"
      ],
      "verbatim_texts": [
        "Items are repaired and added into inventory"
      ],
      "justification": "Matches the condition and action for repaired items."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Items can't be repaired and are discarded"
      ],
      "justification": "Direct paraphrase of discarding irrepairable items."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "email the customer with replacement charges"
      ],
      "justification": "Direct paraphrase of emailing replacement charges."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\" we continue the process. If the \"Items are stored for future orders,\""
      ],
      "justification": "Models the final item allocation condition as an action and branch."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges"
      ],
      "justification": "Direct paraphrase of the final emailing step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "when the process is complete, it ends"
      ],
      "justification": "Matches the end of the process, modeled as both a node and an action."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "we still continue the process"
      ],
      "justification": "Rejoining multiple alternative paths into a common continued process."
    }
  ],
