      ],
      "verbatim_texts": [
        "checking for payment"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is received"
      ],
      "justification": "Sets up the payment XOR decision."
    },
    {
      "refs": [
        "guard:b3->n16"
      ],
      "verbatim_texts": [
        "If the payment is received"
      ],
      "justification": "Positive guard for payment."
    },
    {
      "refs": [
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "If the payment is not received"
      ],
      "justification": "Negative guard for payment."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "close the order"
      ],
