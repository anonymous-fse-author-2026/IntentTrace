{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start"
      ],
      "justification": "The start of the process is explicitly modeled with an init node and a start action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "placing an order"
      ],
      "justification": "Direct paraphrase of the order placement step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the customer"
      ],
      "justification": "Direct match for the customer check step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\""
      ],
      "justification": "The conditional statement sets up the XOR branch and is also represented as an action."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "\"not eligible to order\""
      ],
      "justification": "Maps the negative outcome to the guard."
    },
    {
      "refs": [
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "\"eligible to order\""
      ],
      "justification": "Maps the positive outcome to the guard."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "inform them"
      ],
      "justification": "Direct paraphrase of informing the customer."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Explicitly marks the end of the process, captured as both an action and an end node."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "open a new order in the ERP system"
      ],
      "justification": "Direct paraphrase of opening the order."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "perform an availability check"
      ],
      "justification": "Direct paraphrase of the availability check."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\""
      ],
      "justification": "Sets up the XOR decision and its accompanying action for product availability."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Negative outcome for availability guard."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process"
      ],
      "justification": "Positive outcome mapped to a guard and the implied convergence."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "start producing the missing parts"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "Matches the parallel AND gateway."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "ship the products"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "send the invoice"
      ],
      "justification": "Direct paraphrase."
    },
