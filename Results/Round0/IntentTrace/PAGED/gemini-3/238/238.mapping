      "justification": "Matches the branch point and the negative availability condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed to Produce the Goods"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "if the Article is available"
      ],
      "justification": "Matches the condition modeled as an action and the positive guard."
    },
    {
      "refs": [
        "action:n9"
      ],
