{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO,"
      ],
      "justification": "Matches the start of the process and the WIGGO initialization action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "start by placing an Order"
      ],
      "justification": "Direct paraphrase of the order placement step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to Check the Customer's Credit Limit"
      ],
      "justification": "Direct paraphrase of the credit limit check."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\""
      ],
      "justification": "Captures the decision branch and the condition modeled as an action step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
