        "content": [
          "To begin the process for WIGGO,",
          "start by placing an Order",
          "proceed to Check the Customer's Credit Limit",
          "If the response is \"Okay\"",
          "proceed to Check the Availability of the Article",
          "After checking the availability, if the response is \"Okay\", proceed to Check the Availability of the Article again. If the response is \"No\", send a Denial to the Customer.",
          "If the Article is not available",
          "proceed to Produce the Goods",
          "After checking the availability of the Article,",
          "send an Order Confirmation",
          "Simultaneously,",
          "Ship the Goods",
          "Check the Payment status",
          "If the payment has been received",
          "close the Order",
          "and end the process"
        ]
      },
