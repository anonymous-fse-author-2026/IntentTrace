        "check the inventory level"
      ],
      "justification": "Direct match to the inventory check step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum"
      ],
      "justification": "The condition opens the XOR decision and guards the positive branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "create a purchase order"
      ],
      "justification": "Direct paraphrase of creating the purchase order."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum"
      ],
      "justification": "The condition maps to the negative branch guard."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
