{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "The text explicitly defines the initialization and the first steps of joining the team and agreeing on the domain."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "create a process model and check it."
      ],
      "justification": "Direct paraphrase of creating the model and then performing a check (modeled as an action step)."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\", then assign negative points."
      ],
      "justification": "Captures the conditional check (branch) and the ensuing action of assigning negative points."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\", assign negative points again."
      ],
      "justification": "Captures the secondary conditional check (modeled as an action and a branch) and the repeated assignment of negative points."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Direct mapping to the positive continuation path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Direct paraphrase of the fixing and extension step."
    },
    {
      "refs": [
        "action:n8",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process. If you need to analyze the field of study,"
      ],
      "justification": "The model represents the two conditional choices and their continuations using these combined actions and branch."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "assign roles in the team."
      ],
      "justification": "Direct match for the role assignment action."
    },
    {
      "refs": [
        "action:n9",
        "action:n14",
        "action:n15",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Matches the conditional OK path and the redundant actions representing continuing the process and working according to roles. The structural nodes support these parallel/repeated flows."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct paraphrase of the progress check step."
    },
    {
      "refs": [
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it."
      ],
      "justification": "Matches the decision node evaluating project acceptance and the ensuing presentation action."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Direct match for the negative path consequence."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Matches the second acceptance check and the repeated presentation action."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Direct match for the negative path consequence."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "The final presentation action and explicitly stated end of the process, along with structural converges bringing the flows together."
    }
