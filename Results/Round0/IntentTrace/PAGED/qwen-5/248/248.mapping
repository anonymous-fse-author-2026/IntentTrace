        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process at the Italian restaurant, first enter and ask for the menu."
      ],
      "justification": "The opening clause implicitly initiates the process and describes the first explicit action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After checking the offers,"
      ],
      "justification": "Directly corresponds to the preparatory checking step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "simultaneously"
      ],
      "justification": "The concurrency keyword explicitly maps to the AND gateway splitting the flow."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "take the following steps: order a glass of red wine and a salad."
      ],
      "justification": "Lists the two parallel ordering steps triggered by the concurrent branch."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Once the order is placed,"
      ],
      "justification": "The completion phrasing signals where the parallel paths rejoin before proceeding."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "wait for it to arrive and then enjoy the salad and wine."
      ],
      "justification": "Describes the sequential waiting and consumption steps after convergence."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After finishing, you will be asked if you would like a dessert."
      ],
      "justification": "Captures the transitional inquiry step regarding dessert."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If you answer \"yes\" to tiramisu, then go ahead and order it."
      ],
      "justification": "The conditional introduces the XOR decision and specifies the action on the positive arm."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you answer \"no\" to tiramisu, then simply decline any dessert."
      ],
      "justification": "Specifies the action taken on the negative decision arm."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If you did order tiramisu, wait for it to be served, then enjoy it."
      ],
      "justification": "Describes the sequential substeps that occur only when tiramisu was ordered."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "Once you are ready,"
      ],
      "justification": "Temporal marker indicates the rejoining of the dessert decision paths back to the main flow."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "ask for the bill and proceed to pay it."
      ],
      "justification": "Directly maps to the final financial transaction steps."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "After settling the bill, you can leave the restaurant and the process will be complete."
      ],
      "justification": "Covers the departure action, the explicit completion state, and the implicit process end."
    }
