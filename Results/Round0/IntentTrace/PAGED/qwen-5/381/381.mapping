      ],
      "verbatim_texts": [
        "If a code is available, the process will end along with the hotel reservation."
      ],
      "reason": "The model incorrectly inserts 'within 24 hours' and '(flight)' while dropping 'along with the hotel reservation', altering both the stated condition and the complete outcome."
