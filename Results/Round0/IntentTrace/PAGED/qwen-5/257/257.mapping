      "verbatim_texts": [
        "To begin, start by providing the requested shipping information."
      ],
      "justification": "The opening clause implicitly starts the process and describes the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, proceed to determine the shipping details."
      ],
