    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "If a \"Saved shipping address\" has been selected, then continue with the process."
      ],
      "justification": "Captures the condition check, the implicit branch split, and the continuation action for the saved address scenario."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if a \"New shipping address\" has been entered, also continue with the process."
      ],
      "justification": "Captures the alternative condition check, its corresponding branch, and the continuation action for the new address scenario."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once that is done, confirm the shipping address and ensure that it is correct."
      ],
      "justification": "Signals the rejoining of the address paths and describes the subsequent confirmation action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After confirming the shipping address, proceed to select the desired shipping speed."
      ],
      "justification": "Direct paraphrase of the shipping speed selection step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Finally, once the shipping speed has been chosen, the process comes to an end."
      ],
      "justification": "Describes the final user action and explicitly marks the process termination."
    }
