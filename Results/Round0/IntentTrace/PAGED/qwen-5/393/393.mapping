{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "the first step is to advise unsuccessful candidates"
      ],
      "justification": "Implicitly triggers process start, marks the initial step, and defines the first action."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\", then the position should be re-advertised."
      ],
      "justification": "Captures the condition, the XOR decision point, and the resulting re-advertisement action."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "if the terms and conditions of the offer for a candidate need to be sorted out"
      ],
      "justification": "Models the conditional trigger for the subsequent decision path."
    },
    {
      "refs": [
        "action:n8",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the candidate has not accepted, the process continues."
      ],
      "justification": "Maps to the negative branch outcome where processing proceeds without further blocking."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form"
      ],
      "justification": "Direct match to the document submission step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the manager is an external resource"
      ],
      "justification": "Conditional decision based on the approver's employment status."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the form is approved"
      ],
      "justification": "Paraphrase of the approval condition governing the next flow."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "they may not authorize the form"
      ],
      "justification": "Rephrased as a verification check regarding external authorization capability."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "justification": "Exact match for the scanning and recording step."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If there are any variations, a complete business case is required."
      ],
      "justification": "Accurately models the variation check, branch, and mandatory business case creation."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Otherwise, the process continues."
      ],
      "justification": "Matches the default continuation path when no variations exist."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate."
      ],
      "justification": "Correctly captures the condition and the exact 12% threshold."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "it can take up to 21 days to arrange and complete."
      ],
      "justification": "Matches the timing constraint and the arrangement action for medical assessments."
    },
    {
      "refs": [
        "action:n14",
        "action:n20"
      ],
      "verbatim_texts": [
        "The TS HR coordinator informs the recruitment manager, who then liaises with the HR representative to confirm the offer to the candidate."
      ],
      "justification": "Both actions reflect this coordination step, appearing redundantly across converging paths."
    },
    {
      "refs": [
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory, the next candidate on the shortlist should be contacted."
      ],
      "justification": "Captures the satisfaction check, decision split, and fallback contact action."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "if the assessment is fine, the process continues."
      ],
      "justification": "Matches the positive assessment outcome leading to continuation."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "The recruitment manager makes a formal verbal offer of employment to the candidate."
      ],
      "justification": "Direct match to the verbal offer step."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "If the candidate accepts, the recruitment manager creates a formal written offer."
      ],
      "justification": "Accurately models candidate acceptance, the branch, and the subsequent written offer generation."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "If the candidate declines, the process continues."
      ],
      "justification": "Matches the rejection path where processing moves forward."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Simultaneously, the commencement pack and letter of appointment are sent to the candidate."
      ],
      "justification": "AND gateway captures the concurrent execution, while the action matches document dispatch."
    },
    {
      "refs": [
        "action:n29",
        "action:n30"
      ],
      "verbatim_texts": [
        "if there is a \"40%\" rate, renegotiation is required."
      ],
      "justification": "Threshold and required renegotiation action are correctly modeled."
    },
    {
      "refs": [
        "action:n31",
        "action:n32"
      ],
      "verbatim_texts": [
        "if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified."
      ],
      "justification": "Captures the success/failure verification, branch, and fallback candidate identification."
    },
    {
      "refs": [
        "action:n33"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful, the process continues."
      ],
      "justification": "Matches the successful renegotiation continuation path."
    },
    {
      "refs": [
        "action:n34"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicit termination statement maps directly to the end action and terminal node."
    }
  ],
  "mutations": [
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "it is necessary to check if the candidate has accepted a voluntary redundancy."
      ],
      "reason": "The source explicitly requires checking voluntary redundancy acceptance, but the model element incorrectly states checking whether terms and conditions need sorting out."
    }
  ],
  "omissions": [],
  "additions": [
    {
      "refs": [
        "action:n12"
      ],
      "reason": "The step to contact an external approver for clarification has no supporting text in the source description."
    }
  ],
