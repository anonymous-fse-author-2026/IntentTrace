        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process"
      ],
      "justification": "Implicitly triggers the workflow (init) and explicitly models the starting step described in the opening phrase."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "the customer needs to gather the required items and then inquire about the availability of products."
      ],
      "justification": "Covers the initial preparation and product inquiry steps in sequence."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "After sending the inquiry, they should wait for the invoice."
      ],
      "justification": "Directly captures the action of sending the inquiry and the subsequent waiting period."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the invoice is received, the customer should review the pricing and terms of the items and then send a purchase requisition."
      ],
      "justification": "Maps the review action and the following submission of the purchase requisition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After sending the requisition, they need to wait for the purchase invoice and shipment."
      ],
      "justification": "Exact match for the waiting step following the requisition."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the purchase invoice and shipment are received, the customer can proceed to receive the invoice."
      ],
      "justification": "Captures the receipt of documents/shipment and the immediately following procedural step mentioned in the text."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Upon receiving the invoice, they should make the payment."
      ],
      "justification": "Direct correspondence to the payment action triggered by the invoice."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the payment is made, the transaction is complete and the process ends."
      ],
      "justification": "Models the final completion state and signals the logical termination of the process."
    }
  ],
