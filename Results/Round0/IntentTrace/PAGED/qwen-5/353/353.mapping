{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by checking if the order has been received."
      ],
      "justification": "Covers process initiation and the first two sequential actions described in the opening sentence."
    },
    {
      "refs": [
        "action:n3",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the sum of the order is less than 500, then continue with the process."
      ],
      "justification": "Maps to the first exclusive choice condition and its positive consequent action."
    },
    {
      "refs": [
        "action:n4",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the sum of the order is greater than 2000, compute a discount of 4%."
      ],
      "justification": "Maps to the second condition and the corresponding discount calculation step."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the sum of the order falls between 1000 and 1500, compute a discount of 3%."
      ],
      "justification": "Maps to the third range condition and its discount computation."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Similarly, if the sum of the order falls between 500 and 999, compute a discount of 2%."
      ],
      "justification": "Maps to the fourth range condition and its discount computation."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After checking the sum of the order, if it is still less than 500, continue with the process."
      ],
      "justification": "Captures the repeated low-sum condition check and the continuation action."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the sum of the order is greater than 2000, compute a discount of 4%."
      ],
      "justification": "Repetition of the high-sum condition and its discount computation."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Once again, check the sum of the order. If it is less than 500, continue with the process."
      ],
      "justification": "Captures the third repetition of the low-sum check and continuation."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the sum of the order falls between 1000 and 1500, compute a discount of 3%."
      ],
      "justification": "Repetition of the medium-high range condition and discount step."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Likewise, if the sum of the order falls between 500 and 999, compute a discount of 2%."
      ],
      "justification": "Repetition of the medium-low range condition and discount step."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Finally, create the bill and the process will come to an end."
      ],
      "justification": "Covers the final billing action, the termination description, and the implicit end node."
    }
  ],
