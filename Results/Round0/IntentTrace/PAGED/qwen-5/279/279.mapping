      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "At the beginning,"
      ],
      "justification": "The opening phrase implicitly triggers the process start (init) and is directly restated by the Start process action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "if someone \"Knows SLA\","
      ],
      "justification": "The conditional clause implies an exclusive decision point (XOR branch) and is captured by the Knows SLA action node."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "they should \"continue the process\"."
      ],
      "justification": "Faithfully restates the positive outcome path of the first condition, with minor contextual phrasing preserved."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If they don't \"Know SLA\", they should \"Look up\"."
      ],
      "justification": "Captures the negative outcome path and corresponding action of the first branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, they should enter the date."
      ],
      "justification": "The temporal cue 'After that' signals the rejoining of both SLA paths (converge) immediately before the date entry action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the task is \"Urgent\","
      ],
      "justification": "The second conditional implies an exclusive decision point (XOR branch) and is represented by the Task is Urgent action node."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they should \"Red Stamp\"."
      ],
      "justification": "Directly matches the positive outcome action of the urgency condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is \"Non Urgent\", they should \"continue the process\"."
      ],
      "justification": "Captures the negative outcome path and continuation action of the second branch."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "The conclusion phrase implies the merging of urgency paths (converge), performs the final end process action, and explicitly marks the process termination (end)."
    }
  ],
