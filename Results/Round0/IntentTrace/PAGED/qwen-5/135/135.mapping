      ],
      "verbatim_texts": [
        "To begin the process, start with Low Inventory."
      ],
      "justification": "Opening clause implicitly triggers the process start and defines the initial inventory state."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed to Create P.R.."
      ],
      "justification": "Directly corresponds to the first procurement request creation step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "move on to Create P.R.,"
      ],
      "justification": "Matches the explicitly repeated instruction in the source text."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "followed by Submit P.O.."
      ],
      "justification": "Directly corresponds to the purchase order submission step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "In case there were any previous shipment problems, make sure to communicate them"
      ],
      "justification": "Captures the conditional check for prior issues and the required communication action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "proceed to Ship Material."
      ],
      "justification": "Directly matches the physical dispatch step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "At this point, check if the shipment is okay."
      ],
      "justification": "Describes both the verification action and the immediate decision split."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if there are any problems with the shipment, communicate them accordingly."
      ],
      "justification": "Maps the negative condition outcome and its corresponding communication step."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed to Send Payment."
      ],
      "justification": "Maps the positive verification outcome and the subsequent payment dispatch."
    },
    {
      "refs": [
        "action:n10",
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "However, if there are any problems with the shipment, communicate them accordingly."
      ],
      "justification": "Reinforces the problem-handling branch and action for the first verification cycle."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After checking the shipment status again, if it is okay"
      ],
      "justification": "Describes the secondary status verification and its conditional gate."
    },
    {
      "refs": [
        "action:n12",
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "proceed to Send Payment."
      ],
      "justification": "Matches the payment execution following the second successful check."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "Otherwise, communicate any shipment problems."
      ],
      "justification": "Matches the fallback communication step triggered by a failed second check."
    },
    {
      "refs": [
        "action:n14",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Finally, once the payment is sent, the process comes to an end."
      ],
      "justification": "Closing sentence explicitly terminates the workflow; multiple terminal nodes reflect path convergence and acceptable redundancy."
    }
