        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If there are, they should recalculate the refund"
      ],
      "justification": "Guard captures the positive outcome ('If there are'); action matches the repeated recalculation."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If not, they should send another letter of denial"
      ],
      "justification": "Guard captures the negative outcome ('If not'); action matches the second denial letter."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Finally, they should write back the case data and the process will come to an end."
      ],
      "justification": "Covers the final data write-back action, the explicit end-step action, and the terminal end node."
