    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "if the answer is no, they should send a letter of denial"
      ],
      "justification": "Guard captures the negative condition value; action matches the denial letter step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "check again if there are any new findings"
      ],
      "justification": "Action models the repeat inquiry; branch captures the second decision split."
    },
    {
