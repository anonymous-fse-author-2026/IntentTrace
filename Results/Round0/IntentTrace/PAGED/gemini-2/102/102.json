  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start with the Resupply Cycle Triggered step"
    },
    {
      "id": "i2",
      "content": "checking the Inventory Level"
    },
    {
      "id": "i3",
      "content": "If the \"Inventory level is at or below the minimum\""
    },
    {
      "id": "i4",
      "content": "Create Purchase Order"
    },
    {
      "id": "i5",
      "content": "if the \"Inventory Level is above the minimum\""
    },
    {
      "id": "i6",
      "content": "then the process ends."
    },
    {
      "id": "i7",
      "content": "Reviewing the Purchase Order"
    },
    {
      "id": "i8",
      "content": "If the Purchase Order is approved"
    },
    {
      "id": "i9",
      "content": "reserve the funds for the purchase"
    },
    {
      "id": "i10",
      "content": "if the Purchase Order is rejected"
    },
    {
      "id": "i11",
      "content": "rework the order"
    },
    {
      "id": "i12",
      "content": "send the Order to Suppliers"
    },
    {
      "id": "i13",
      "content": "In case the order needs to be reworked, review the Purchase Order again."
    },
    {
      "id": "i14",
      "content": "Simultaneously, complete the following steps:"
    },
    {
      "id": "i15",
      "content": "the Supplier sends a packing slip"
    },
    {
      "id": "i16",
      "content": "and an invoice."
    },
    {
      "id": "i17",
      "content": "Once the packing slip is received, record it."
    },
    {
      "id": "i18",
      "content": "when the invoice is received, record it as well."
    },
    {
      "id": "i19",
      "content": "After recording the packing slip and invoice,"
    },
    {
      "id": "i20",
      "content": "release the reserved funds and issue the payment to the supplier"
    },
    {
      "id": "i21",
      "content": "Finally, the process ends after the payment is issued to the supplier."
    }
  ]
