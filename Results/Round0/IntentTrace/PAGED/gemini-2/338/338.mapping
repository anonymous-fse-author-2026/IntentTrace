{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Initially"
      ],
      "justification": "The word 'Initially' maps to the initialization and a start action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
      "justification": "The text describes an XOR condition and condition action, leading to the positive branch."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the action to be taken is \"Research schedule\""
      ],
      "justification": "Direct paraphrase of the research schedule action."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the option is not selected"
      ],
      "justification": "Condition for the negative branch."
    },
    {
      "refs": [
        "action:n4",
        "action:n11"
      ],
      "verbatim_texts": [
        "provide indications"
      ],
      "justification": "Direct mapping to providing indications action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed with the research schedule"
      ],
      "justification": "Direct mapping to researching schedule."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule"
      ],
      "justification": "Direct mapping to the validation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory"
      ],
      "justification": "Condition check opens a branch."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Condition mapping to the negative branch for schedule check."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "perform the action \"Research schedule\""
      ],
      "justification": "Action taken when schedule is not satisfactory."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory"
      ],
      "justification": "Checks the schedule a second time, starting another branch."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "If it is"
      ],
      "justification": "Positive outcome of the schedule check."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "if the schedule is satisfactory"
      ],
      "justification": "Positive outcome of the secondary schedule check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "write a ticket order to SNCF"
      ],
      "justification": "Both satisfactory paths converge at the writing of a ticket order."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "validate it"
      ],
      "justification": "Validating ticket order."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Check approval, opening branch."
    },
    {
      "refs": [
        "guard:b4->n15",
        "guard:b5->n18",
        "guard:b6->n22"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Negative condition for the ticket checks."
    },
    {
      "refs": [
        "action:n15",
        "action:n18",
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "then the process ends."
      ],
      "justification": "Process termination mappings."
    },
    {
      "refs": [
        "guard:b4->n16",
        "guard:b5->n19"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Positive path condition."
    },
    {
      "refs": [
        "action:n16",
        "action:n19"
      ],
      "verbatim_texts": [
        "then validate the ticket order"
      ],
      "justification": "Validation step repetition mapping."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved"
      ],
      "justification": "Second approval check mapping."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved"
      ],
      "justification": "Third approval check mapping."
    },
    {
      "refs": [
        "guard:b6->n21"
      ],
      "verbatim_texts": [
        "If it is"
      ],
      "justification": "Final positive condition."
    }
  ],
  "mutations": [],
  "omissions": [],
  "additions": [
    {
      "refs": [
        "action:n12"
      ],
      "reason": "The text 'If it is still not satisfactory, then provide indications' does not state that the process ends here, yet an 'End' action step is modeled."
    }
  ],
