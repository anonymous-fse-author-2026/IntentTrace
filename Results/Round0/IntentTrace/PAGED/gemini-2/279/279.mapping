      ],
      "justification": "Sets up the XOR branch for the task urgency check, modeled alongside an action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they should \"Red Stamp\""
      ],
      "justification": "Direct paraphrase of the urgent task action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is \"Non Urgent\", they should \"continue the process\""
      ],
      "justification": "Direct paraphrase of the non-urgent task alternative path."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "Finally"
      ],
      "justification": "Implies the joining of the urgency branches before ending the process."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Describes the termination of the process, supporting both the end node and the action step representing it."
