    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If they don't \"Know SLA\", they should \"Look up\""
      ],
      "justification": "Direct paraphrase of the negative path action."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
