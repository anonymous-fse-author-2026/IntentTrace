  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start with Password Verification"
    },
    {
      "id": "i2",
      "content": "followed by Verifiy Password"
    },
    {
      "id": "i3",
      "content": "If you choose \"Select Cancel\""
    },
    {
      "id": "i4",
      "content": "you will be directed to iforgot.apple.com"
    },
    {
      "id": "i5",
      "content": "However, if you select \"Reset password\""
    },
    {
      "id": "i6",
      "content": "you will be automatically directed to iforgot.apple.com"
    },
    {
      "id": "i7",
      "content": "In case you choose \"Retry\""
    },
    {
      "id": "i8",
      "content": "you will need to re-enter your password"
    },
    {
      "id": "i9",
      "content": "After that, go to iforgot.apple.com and proceed with Reset Password."
    },
    {
      "id": "i10",
      "content": "Once you are automatically directed to iforgot.apple.com, proceed with Reset Password."
    },
    {
      "id": "i11",
      "content": "If you need to re-enter your password, do so and then verify it."
    },
    {
      "id": "i12",
      "content": "Once the password is reset, you can return to the iTunes purchases page."
    },
    {
      "id": "i13",
      "content": "From there, select the price of the item."
    },
    {
      "id": "i14",
      "content": "If prompted to \"Enter Password\""
    },
    {
      "id": "i15",
      "content": "verify the password"
    },
    {
      "id": "i16",
      "content": "Alternatively, if asked to \"Enter Apple ID\""
    },
    {
      "id": "i17",
      "content": "enter the password"
    },
    {
      "id": "i18",
      "content": "Finally, enter the password and verify it."
    }
  ]
