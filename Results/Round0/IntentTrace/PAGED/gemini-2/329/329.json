  "input_elements": [
    {
      "id": "i1",
      "content": "To initiate the process, begin by processing incoming orders."
    },
    {
      "id": "i2",
      "content": "Once the order is received,"
    },
    {
      "id": "i3",
      "content": "proceed to send the collected order list."
    },
    {
      "id": "i4",
      "content": "implement it in the database."
    },
    {
      "id": "i5",
      "content": "gather all the information in one excel-file."
    },
    {
      "id": "i6",
      "content": "Subsequently, check the order and customer details."
    },
    {
      "id": "i7",
      "content": "If the \"permit data\" option is selected,"
    },
    {
      "id": "i8",
      "content": "proceed with permitting the data."
    },
    {
      "id": "i9",
      "content": "However, if the \"not permit data\" option is chosen,"
    },
    {
      "id": "i10",
      "content": "release the data if permitted"
    },
    {
      "id": "i11",
      "content": "or contact the selling agency if not permitted."
    },
    {
      "id": "i12",
      "content": "check the worth of the orders."
    },
    {
      "id": "i13",
      "content": "If the orders are to be released,"
    },
    {
      "id": "i14",
      "content": "continue with the process."
    },
    {
      "id": "i15",
      "content": "However, if the order is to be canceled,"
    },
    {
      "id": "i16",
      "content": "the process will end."
    },
    {
      "id": "i17",
      "content": "if the value is less than 5000,"
    },
    {
      "id": "i18",
      "content": "if the value is greater than or equal to 5000,"
    },
    {
      "id": "i19",
      "content": "the order will need to be signed off by the board of directors."
    },
    {
      "id": "i20",
      "content": "collect the order and start production."
    },
    {
      "id": "i21",
      "content": "Send the memorandum and invoice,"
    },
    {
      "id": "i22",
      "content": "followed by the quality report."
    },
    {
      "id": "i23",
      "content": "Check the quality of the production"
    },
    {
      "id": "i24",
      "content": "and send the quality report."
    },
    {
      "id": "i25",
      "content": "collect the goods."
    },
    {
      "id": "i26",
      "content": "Sign off on the memo"
    },
    {
      "id": "i27",
      "content": "and pick the goods."
    },
    {
      "id": "i28",
      "content": "send them to complete the process."
    },
    {
      "id": "i29",
      "content": "complete the process."
    }
  ]
