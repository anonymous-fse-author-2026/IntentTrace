  "mutations": [
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "less than 5.000 \u20ac"
      ],
      "reason": "The source specifies 'less than 5.000 \u20ac' (<) but the model implemented '<= 5000 \u20ac'."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "ensure that it is completed"
      ],
      "reason": "The model omitted the step to ensure completion after typing orders into the database."
    },
    {
      "verbatim_texts": [
        "Send the Excel list to the student and upon receiving it, continue with the process."
      ],
      "reason": "The model missed this secondary action flow involving the Excel list."
    },
    {
      "verbatim_texts": [
        "continue with the check"
      ],
      "reason": "The model omitted continuing with the check after sending for sign-off for orders > 5.000 \u20ac."
    },
    {
      "verbatim_texts": [
        "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
      ],
      "reason": "The model omitted this entire sequence of actions."
    },
    {
      "verbatim_texts": [
        "the goods will be produced."
      ],
      "reason": "The model omitted the step stating the goods will be produced."
    },
    {
      "verbatim_texts": [
        "ensure that the memo is achieved in the warehouse."
      ],
      "reason": "The model omitted this verification step."
    },
    {
      "verbatim_texts": [
        "report the achievement to the finance department."
      ],
      "reason": "The model missed the step to report the achievement after sending the invoice."
    },
    {
      "verbatim_texts": [
        "Also, send the goods"
      ],
      "reason": "The model failed to include sending the goods."
    },
    {
      "verbatim_texts": [
        "Finally, archive the memo"
      ],
      "reason": "The model omitted archiving the memo before closing the order."
    }
  ],
