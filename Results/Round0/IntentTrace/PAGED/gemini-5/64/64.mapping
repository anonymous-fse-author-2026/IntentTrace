{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process for the election of a rector, it is necessary to begin with the rector's final year in their current position."
      ],
      "justification": "Starts the process and describes the first step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "the acceptance of proposals for candidates for the rector position should be launched."
      ],
      "justification": "Direct paraphrase of launching the acceptance of proposals."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the rector can nominate themselves as a candidate for the position."
      ],
      "justification": "Direct paraphrase of self-nomination."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the acceptance of proposals should be stopped."
      ],
      "justification": "Direct paraphrase of stopping proposals."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If a candidate meets the required criteria"
      ],
      "justification": "Describes the conditional branch and the positive check."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should be included in the list of candidates."
      ],
      "justification": "Direct paraphrase of including the candidate."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "if a candidate does not meet the criteria, they should be informed of the refusal and the process will come to an end."
      ],
      "justification": "Describes informing the candidate of refusal and formally ending the process for that path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the list of candidates has been formed, it should be made public."
      ],
      "justification": "Direct paraphrase of making the list public."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Indicates the start of parallel activities."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the candidates should promote their ideas to the public"
      ],
      "justification": "Direct paraphrase of the promotion step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "organize a public meeting of the Academic Senate."
      ],
      "justification": "Direct paraphrase of organizing the meeting."
    },
    {
      "refs": [
        "action:n11",
        "action:n19",
        "action:n27"
      ],
      "verbatim_texts": [
        "The public meeting should then commence"
      ],
      "justification": "Implies the parallel branches rejoin to start the meeting, matching the redundant instances modeled."
    },
    {
      "refs": [
        "action:n12",
        "action:n20",
        "action:n28"
      ],
      "verbatim_texts": [
        "an election should be conducted and the votes should be counted."
      ],
      "justification": "Direct paraphrase of the election and vote counting, spanning redundant elements."
    },
    {
      "refs": [
        "action:n18",
        "action:n26",
        "action:n34"
      ],
      "verbatim_texts": [
        "another election should be conducted."
      ],
      "justification": "Captures the action to retry the election, unrolled multiple times."
    },
    {
      "refs": [
        "action:n13",
        "action:n21",
        "action:n29"
      ],
      "verbatim_texts": [
        "if the voting is successful"
      ],
      "justification": "Captures the conditional split and successful vote actions across the redundant paths."
    },
    {
      "refs": [
        "action:n14",
        "action:n22",
        "action:n30"
      ],
      "verbatim_texts": [
        "the result of the election should be announced."
      ],
      "justification": "Direct paraphrase matching redundant elements."
    },
    {
      "refs": [
        "action:n15",
        "action:n23",
        "action:n31"
      ],
      "verbatim_texts": [
        "the public meeting should be concluded"
      ],
      "justification": "Direct paraphrase matching redundant elements."
    },
    {
      "refs": [
        "action:n16",
        "action:n24",
        "action:n32"
      ],
      "verbatim_texts": [
        "the candidate should be informed of the election results"
      ],
      "justification": "Direct paraphrase matching redundant elements."
    },
    {
