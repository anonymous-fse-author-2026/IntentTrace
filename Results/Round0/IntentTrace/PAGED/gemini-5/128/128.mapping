  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "The initial sentence describes the start of the process and maps to the init node and the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\""
      ],
      "justification": "The condition initiates the XOR branch and is modeled as an action step questioning how items were returned."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "Delivery Crew picks-up items at the event site,"
      ],
      "justification": "Maps to the alternative path condition for item pickup."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the items are counted and compared to the original contract."
      ],
      "justification": "Direct paraphrase of the counting action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\""
      ],
      "justification": "The condition initiates the XOR branch for order status."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "Order is incomplete and items are missing,"
      ],
      "justification": "Maps directly to the guard for incomplete and missing items."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "Order is complete but items are damaged,"
      ],
      "justification": "Maps directly to the guard for damaged items."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Direct paraphrase of emailing the customer for missing items."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "Condition initiates the decision branch regarding customer returning items."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Direct paraphrase of the emailing action for damage."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "we temporarily take them out of inventory."
      ],
      "justification": "Direct paraphrase of the action to remove items from inventory."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\""
      ],
      "justification": "Condition initiates the decision branch for repair status."
    },
    {
      "refs": [
        "action:n10",
        "guard:b4->n10"
      ],
      "verbatim_texts": [
        "Items are repaired and added into inventory,"
      ],
      "justification": "Maps to both the condition guard and the action step representing the state."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Items can't be repaired and are discarded,"
      ],
      "justification": "Direct paraphrase of the discarded state."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "we email the customer with replacement charges."
      ],
      "justification": "Direct paraphrase of the emailing action for replacements."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\""
      ],
      "justification": "Condition initiates the decision branch about packed items."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges"
      ],
      "justification": "Direct paraphrase."
    },
