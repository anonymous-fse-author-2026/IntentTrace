  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks"
      ],
      "justification": "The text implicitly starts the process and explicitly describes the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "they should select the method for exit control checks."
      ],
      "justification": "Direct paraphrase of the method selection step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics,"
      ],
      "justification": "The conditional phrase opens the XOR decision for the check method."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "they should undergo a check using biometrics."
      ],
      "justification": "Direct paraphrase of the biometrics check."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should undergo checks using identity documents."
      ],
      "justification": "Direct paraphrase of the ID documents check."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After the exit control checks,"
      ],
      "justification": "Implies the convergence of the parallel check paths."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "if the passenger is denied permission"
      ],
      "justification": "The conditional acts as the XOR branch and is also modeled redundantly as an action to evaluate the permission, which is a valid paraphrase."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should leave the area."
      ],
      "justification": "Matches the negative permission outcome."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they should proceed to the next step."
      ],
      "justification": "Matches the positive permission outcome."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful"
      ],
      "justification": "The conditional converges the previous steps, opens a new XOR branch, and is also modeled as an evaluation action step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the passenger should leave the area and the process ends."
      ],
      "justification": "Direct paraphrase of the unsuccessful outcome action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the passenger should continue to the next step and the process ends."
      ],
      "justification": "Direct paraphrase of the successful outcome action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Provides the structural end node and justifies the redundantly modeled End action."
    }
  ],
