{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "Initiates the process and captures the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed with the Registration gross pathology request."
      ],
      "justification": "Matches the registration step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "create a barcode scan at the start."
      ],
      "justification": "Matches the barcode scan action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "assign a container to the gross pathology request."
      ],
      "justification": "Matches assigning a container."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "move on to the Specimen description."
      ],
      "justification": "Matches specimen description step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "pay attention to the scan start."
      ],
      "justification": "Matches the first scan attention."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "pay attention to the scan end."
      ],
      "justification": "Matches scan end step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Matches the second scan start step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "proceed with Macroscopic description writing."
      ],
      "justification": "Matches macroscopic description step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Indicates parallel execution matching the AND gateway."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Tissue processing"
      ],
      "justification": "Matches the tissue processing step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required."
      ],
      "justification": "Captures the first digitalization check and decision point."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Matches the negative outcome path for the first check."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "proceed with Digitalization."
      ],
      "justification": "Matches the positive outcome path for the first check."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required again."
      ],
      "justification": "Captures the second digitalization check and decision point."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Matches the negative outcome path for the second check."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "proceed with Digitalization."
      ],
      "justification": "Matches the positive outcome path for the second check."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "assign cases to the pathologist"
      ],
      "justification": "Matches the assignment step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "move on to Microscopic examination and diagnosis."
      ],
      "justification": "Matches the examination and diagnosis step."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "write the pathology report."
      ],
      "justification": "Matches writing the report."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "confirm it."
      ],
      "justification": "Matches confirming the report."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "deliver it."
      ],
      "justification": "Matches delivering the report."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "proceed with the post-report processing."
      ],
      "justification": "Matches post-report processing."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "close it."
      ],
      "justification": "Matches closing the procedure."
    },
    {
      "refs": [
        "action:n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, deliver the pathology report and complete the post-report processing."
      ],
      "justification": "Matches the final step and implicitly resolves and completes the process paths."
    }
  ],
