{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "The text initiates the process and describes the items being returned."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\""
      ],
      "justification": "Indicates the conditional branch and the action step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "if the \"Delivery Crew picks-up items at the event site,\""
      ],
      "justification": "Describes the alternative return method."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\""
      ],
      "justification": "Describes the conditional check for complete orders."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "if the \"Order is incomplete and items are missing,\""
      ],
      "justification": "Describes the conditional check for incomplete orders."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Describes the condition and the resulting action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "if the \"Items are packed for an existing order,\""
      ],
      "justification": "Describes the packing condition."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "if the \"Items are stored for future orders,\""
      ],
      "justification": "Describes the storing condition."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Describes the missing items check and the email action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Describes taking damaged items out of inventory."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "Describes the condition of customer returning missing items."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "if the \"Customer does not return the missing items,\""
      ],
      "justification": "Describes the alternative of not returning missing items."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Captures the end of the process."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\""
      ],
      "justification": "Describes the repaired condition."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Captures the condition for discarded items and the subsequent email."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\""
      ],
      "justification": "Repeated condition for packing items."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\""
      ],
      "justification": "Repeated condition for storing items."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Captures another process termination."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "and the process is complete."
      ],
      "justification": "Captures the final process termination."
    }
  ],
