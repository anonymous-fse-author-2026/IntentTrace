{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\""
      ],
      "justification": "Starts the process and describes the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000"
      ],
      "justification": "Describes the first conditional split."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the report should be reviewed"
      ],
      "justification": "Action step for reviewing the report."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation"
      ],
      "justification": "Describes the alternative path and checking translation need."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If translation is required"
      ],
      "justification": "Branching point for translation."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed to translate the receipts"
      ],
      "justification": "Action to translate."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts"
      ],
      "justification": "Action to confirm receipts on the negative branch."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision"
      ],
      "justification": "Rejoining point that leads into the review decision evaluation."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the report is rejected"
      ],
      "justification": "Condition for rejected report."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "edit the report"
      ],
      "justification": "Action to edit the rejected report."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Condition for approved report."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "continue to check if there is a need for translation"
      ],
      "justification": "Action to check translation need."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision"
      ],
      "justification": "Implies a subsequent decision point."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If the report is rejected"
      ],
      "justification": "Condition for rejected report on the second review."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "edit the report"
      ],
      "justification": "Action to edit after second review rejection."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Condition for approved report on second review."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "translate the receipts"
      ],
      "justification": "Action to translate after approval."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "and then confirm them"
      ],
      "justification": "Action to confirm after translation."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "evaluate the receipts decision"
      ],
      "justification": "Action evaluating the receipt status."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the receipts are accepted"
      ],
      "justification": "Condition assessing accepted receipts."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "proceed to process the expense"
      ],
      "justification": "Action to process expense."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report"
      ],
      "justification": "Condition and action for rejected receipts."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it"
      ],
      "justification": "Action and structural end denoting the completion of the flow."
    }
  ],
