  "input_elements": [
    {
      "id": "i1",
      "content": "To initiate the process for the election of a rector, it is necessary to begin with the rector's final year in their current position."
    },
    {
      "id": "i2",
      "content": "the acceptance of proposals for candidates for the rector position should be launched."
    },
    {
      "id": "i3",
      "content": "the rector can nominate themselves as a candidate for the position."
    },
    {
      "id": "i4",
      "content": "the acceptance of proposals should be stopped."
    },
    {
      "id": "i5",
      "content": "If a candidate meets the required criteria"
    },
    {
      "id": "i6",
      "content": "they should be included in the list of candidates."
    },
    {
      "id": "i7",
      "content": "if a candidate does not meet the criteria"
    },
    {
      "id": "i8",
      "content": "they should be informed of the refusal and the process will come to an end."
    },
    {
      "id": "i9",
      "content": "Once the list of candidates has been formed"
    },
    {
      "id": "i10",
      "content": "it should be made public."
    },
    {
      "id": "i11",
      "content": "Simultaneously"
    },
    {
      "id": "i12",
      "content": "the candidates should promote their ideas to the public"
    },
    {
      "id": "i13",
      "content": "organize a public meeting of the Academic Senate."
    },
    {
      "id": "i14",
      "content": "The public meeting should then commence"
    },
    {
      "id": "i15",
      "content": "ensuring that all members are able to vote for a new rector."
    },
    {
      "id": "i16",
      "content": "an election should be conducted"
    },
    {
      "id": "i17",
      "content": "the votes should be counted."
    },
    {
      "id": "i18",
      "content": "If the voting fails"
    },
    {
      "id": "i19",
      "content": "another election should be conducted."
    },
    {
      "id": "i20",
      "content": "if the voting is successful"
    },
    {
      "id": "i21",
      "content": "the result of the election should be announced."
    },
    {
      "id": "i22",
      "content": "the public meeting should be concluded and the candidate should be informed of the election results, marking the end of the process."
    }
  ]
