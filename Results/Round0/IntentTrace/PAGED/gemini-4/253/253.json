    {
      "id": "i1",
      "content": "To begin the process, start with the Resupply Cycle Triggered step"
    },
    {
      "id": "i2",
      "content": "checking the Inventory Level. If the \"Inventory level is at or below the minimum\""
    },
    {
      "id": "i3",
      "content": "proceed to Create Purchase Order"
    },
    {
      "id": "i4",
      "content": "if the \"Inventory Level is above the minimum\""
    },
    {
      "id": "i5",
      "content": "the process ends"
    },
    {
      "id": "i6",
      "content": "Reviewing the Purchase Order"
    },
    {
      "id": "i7",
      "content": "If the Purchase Order is approved"
    },
    {
      "id": "i8",
      "content": "reserve the funds for the purchase"
    },
    {
      "id": "i9",
      "content": "if the Purchase Order is rejected"
    },
    {
      "id": "i10",
      "content": "rework the order"
    },
    {
      "id": "i11",
      "content": "send the Order to Suppliers"
    },
    {
      "id": "i12",
      "content": "review the Purchase Order again"
    },
    {
      "id": "i13",
      "content": "Simultaneously"
    },
    {
      "id": "i14",
      "content": "the Supplier sends a packing slip and an invoice"
    },
    {
      "id": "i15",
      "content": "Once the packing slip is received"
    },
    {
      "id": "i16",
      "content": "record it"
    },
    {
      "id": "i17",
      "content": "when the invoice is received"
    },
    {
      "id": "i18",
      "content": "record it as well"
    },
    {
      "id": "i19",
      "content": "After recording the packing slip and invoice"
    },
    {
      "id": "i20",
      "content": "release the reserved funds and issue the payment to the supplier"
    },
    {
      "id": "i21",
      "content": "Finally, the process ends"
