      "content": "check the invoice for any mismatches"
    },
    {
      "id": "i3",
      "content": "If there is a need to \"re-send the invoice to the customer\""
    },
    {
      "id": "i4",
      "content": "proceed with continuing the process"
    },
    {
      "id": "i5",
      "content": "If the option is to \"post the invoice\""
    },
    {
      "id": "i6",
      "content": "then also continue the process"
    },
    {
      "id": "i7",
      "content": "Alternatively, if the decision is to \"block the invoice\""
    },
    {
      "id": "i8",
      "content": "then again continue the process"
    },
    {
      "id": "i9",
      "content": "park the invoice"
    },
