{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process, begin by processing incoming orders."
      ],
      "justification": "Matches the initialization and first action step of the process."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once the order is received"
      ],
      "justification": "Direct paraphrase of receiving the order."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to send the collected order list."
      ],
      "justification": "Direct match for sending the order list."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "implement it in the database."
      ],
      "justification": "Matches the action of implementing the list in the database."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "gather all the information in one excel-file."
      ],
      "justification": "Direct match for the excel gathering step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check the order and customer details."
      ],
      "justification": "Direct paraphrase of checking details."
    },
    {
      "refs": [
        "action:n7",
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the \"permit data\" option is selected,"
      ],
      "justification": "Matches the XOR branch, the condition check, and the positive guard."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed with permitting the data."
      ],
      "justification": "Direct paraphrase of permitting data."
    },
    {
      "refs": [
        "guard:b1->n9"
      ],
      "verbatim_texts": [
        "if the \"not permit data\" option is chosen,"
      ],
      "justification": "Matches the negative guard condition."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the data will not be permitted."
      ],
      "justification": "Direct paraphrase of the negative action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "release the data if permitted"
      ],
      "justification": "Matches the conditional release action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "contact the selling agency if not permitted"
      ],
      "justification": "Matches the conditional contact action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "check the worth of the orders."
      ],
      "justification": "Matches the action and implies the paths rejoining before checking worth."
    },
    {
      "refs": [
        "action:n13",
        "guard:b2->n14"
      ],
      "verbatim_texts": [
        "If the orders are to be released,"
      ],
      "justification": "Matches the XOR branch, decision check, and positive guard."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Matches the continuation step."
    },
    {
      "refs": [
        "guard:b2->n15"
      ],
      "verbatim_texts": [
        "if the order is to be canceled,"
      ],
      "justification": "Matches the negative guard condition."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "the process will end."
      ],
      "justification": "Matches the explicit ending step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "if the value is less than 5000,"
      ],
      "justification": "Matches the decision action and XOR branch."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Matches the continuation step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "the order will need to be signed off by the board of directors."
      ],
      "justification": "Matches the sign off action."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "collect the order and start production."
      ],
      "justification": "Matches the collection action and implies paths rejoining."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Send the memorandum and invoice,"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "followed by the quality report."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Check the quality of the production"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "and send the quality report."
      ],
      "justification": "Matches the repeated sending of the report."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "send the memorandum and collect the goods."
      ],
      "justification": "Matches the parallel logic and collecting action."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "Sign off on the memo"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "pick the goods."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "send them to complete the process."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "complete the process."
      ],
      "justification": "Matches the process completion and final end node."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "if the value is less than 5000,"
