{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Matches the start of the process and the initial order placement."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "Check the Customer's Credit Limit."
      ],
      "justification": "Matches the action to check the credit limit."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\","
      ],
      "justification": "Matches the condition for a positive credit limit response."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article."
      ],
      "justification": "Matches the first availability check."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the response is \"No\","
      ],
      "justification": "Matches the negative condition for credit check."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "send a Denial to the Customer."
      ],
      "justification": "Matches the denial action."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "After checking the availability, if the response is \"Okay\","
      ],
      "justification": "Matches the condition and implicit check state for the first availability check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article again."
      ],
      "justification": "Matches the second availability check."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the response is \"No\","
      ],
      "justification": "Matches the negative availability condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "send a Denial to the Customer."
      ],
      "justification": "Matches the denial action due to unavailability."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If the Article is not available,"
      ],
      "justification": "Matches the negative availability condition after the second check."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "proceed to Produce the Goods."
      ],
      "justification": "Matches the production action."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "if the Article is available,"
      ],
      "justification": "Matches the positive availability condition."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "proceed to Collect the Goods."
      ],
      "justification": "Matches the collection action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "send an Order Confirmation."
      ],
      "justification": "Matches the confirmation action."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "Matches the parallel split for shipping and invoicing."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Ship the Goods"
      ],
      "justification": "Matches the shipping action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "and Send the Invoice."
      ],
      "justification": "Matches the invoicing action."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Matches the payment check action."
    },
    {
      "refs": [
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "If the payment has been received,"
      ],
      "justification": "Matches the positive payment condition."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "close the Order"
      ],
      "justification": "Matches closing the order upon payment."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "and end the process."
      ],
      "justification": "Matches the process end after payment."
    },
    {
      "refs": [
        "guard:b4->n19"
      ],
      "verbatim_texts": [
        "If the payment has not been received,"
      ],
      "justification": "Matches the negative payment condition."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Matches the reminder count check."
    },
    {
      "refs": [
        "guard:b5->n21"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3,"
      ],
      "justification": "Matches the condition for writing off the order."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Write off the Order."
      ],
      "justification": "Matches the write-off action."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Matches the reminder action."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "close the Order"
      ],
      "justification": "Matches closing the order after write-off."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "and end the process."
      ],
      "justification": "Matches the process end after write-off."
    }
  ],
