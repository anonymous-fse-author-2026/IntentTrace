      ],
      "verbatim_texts": [
        "if the sum of the order is greater than 2000, compute a discount of 4%."
      ],
      "justification": "Exact correspondence of the upper-bound threshold condition and the associated discount computation step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the sum of the order falls between 1000 and 1500, compute a discount of 3%."
      ],
      "justification": "Exact correspondence of the mid-high range condition and the associated discount computation step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if the sum of the order falls between 500 and 999, compute a discount of 2%."
      ],
      "justification": "Exact correspondence of the mid-low range condition and the associated discount computation step."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "less than 500, then continue with the process."
      ],
      "justification": "Directly maps the lower-bound condition to the guard controlling the default/continuation path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "less than 500, then continue with the process.",
        "create the bill"
      ],
      "justification": "The action combines the immediate continuation instruction for the low-value case with the eventual bill creation step described at the end of the text."
    },
    {
      "refs": [
        "label:n3->n2",
        "label:n4->n2",
        "label:n5->n2"
      ],
      "verbatim_texts": [
        "Once again, check the sum of the order."
      ],
      "justification": "The repetitive instruction to re-evaluate the order total after applying a discount is accurately captured by the loop-back transition labels."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the process will come to an end."
