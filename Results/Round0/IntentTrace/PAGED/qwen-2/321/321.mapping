{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For buyers, the process begins by choosing a book."
      ],
      "justification": "The opening clause implicitly triggers the start node, describes initiating the buyer flow, and specifies the first concrete action of choosing a book."
    },
    {
      "refs": [
        "action:n3",
        "action:n4",
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "After selecting a book, they can either view the book details or see a list of new copies. Alternatively, they can also view a list of used copies."
      ],
      "justification": "Describes the decision point following selection and enumerates the three mutually exclusive viewing options modeled as the branch and its outgoing actions."
    },
    {
      "refs": [
        "action:n7",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If they choose to view the book details, they have the option to then view a list of new copies or proceed to select a copy and end the process."
      ],
      "justification": "Captures the secondary decision point and its two outcomes: viewing new copies or selecting a copy to terminate, matching the modeled branch and actions."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if they choose to view a list of used copies, they can evaluate the list and then select their preferred copy to complete the process."
      ],
      "justification": "Directly maps the sequential evaluation step and the subsequent selection/completion step to the corresponding actions."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "end the process."
      ],
      "justification": "The explicit statement of process termination justifies the end action and structural end node."
    },
    {
      "refs": [
        "label:n5->c1",
        "label:n8->c1",
        "label:n9->c1",
        "label:n11->c1"
      ],
      "verbatim_texts": [
        "complete the process."
      ],
      "justification": "The alternative phrasing for termination supports the convergence point and the transitional labels indicating flow completion across all paths."
    }
  ],
