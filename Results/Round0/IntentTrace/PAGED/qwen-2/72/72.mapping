{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Covers the process initiation and the initial billing and invoicing steps."
    },
    {
      "refs": [
        "action:n3",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Maps the completeness check, conditional split, return action, and implicit termination for the incomplete path."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Captures the transition to compliance verification and the associated decision node."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Direct match for resolving non-compliance via phone contact."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Covers the mail-back return path and its implicit end state."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Exact match for invoice payment and client notification."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Matches the parallel client billing step indicated by 'Simultaneously'."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Covers the no-response condition, decision split, and waiting period assignment."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Maps the reminder issuance and the explicit process conclusion."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Models the satisfaction evaluation, branching logic, and discrepancy resolution."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Captures the continuation path for satisfied clients and the corresponding final end state."
    }
  ],
