{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts"
      ],
      "justification": "Implicitly marks process initialization and directly matches the explicit 'start' action step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then Receive Invoice."
      ],
      "justification": "Direct match to the immediate receiving step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "guard:b1->n6",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned. However, if the invoice is complete, the process continues."
      ],
      "justification": "The conditional check is modeled as an action node feeding a XOR branch. Guards correctly map to incomplete ('No') and complete ('Yes') outcomes, leading to the return action."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted. On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Condition modeled as action with branching logic. Guards capture the non-compliant and compliant (modeled as 'No'/negative) states."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved. But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Direct paraphrases of the two resolution/return paths based on contact method."
    },
    {
      "refs": [
        "action:n10",
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Matches the payment execution and the subsequent compliance resolution step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "'Simultaneously' signals parallel execution justifying the AND branch nodes, immediately followed by the Bill Client action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "a period of 10 days is given."
      ],
      "justification": "Exact match for the waiting period action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Covers the reminder action and the explicit process termination point."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "client is notified of the payment"
      ],
      "justification": "Direct match to the notification step."
    },
    {
      "refs": [
        "action:n18",
        "guard:b3->n19",
        "guard:b3->n20"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved. However, if the client is satisfied, the process continues."
      ],
      "justification": "Satisfaction check modeled as action with XOR branch. Guards accurately reflect unsatisfied and satisfied states."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "payment discrepancy is resolved."
      ],
      "justification": "Direct match to the discrepancy resolution step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "the process continues."
      ],
      "justification": "Direct match to the continuation instruction."
    }
