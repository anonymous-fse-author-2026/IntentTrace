    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start,"
      ],
      "justification": "Captures the process initiation and the introductory start step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request. However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "Models the XOR decision regarding the fee and frames it as a check/action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to register a post-seminar request"
      ],
      "justification": "Direct match for the no-fee path action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "create a purchase request"
      ],
      "justification": "Direct match for the fee path action."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Marks the termination point after the initial post-seminar registration."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Captures both the checking action and the subsequent XOR split on approval status."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Matches the outcome of the approval path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Matches the outcome of the rejection path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Matches the follow-up action after approval notification."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Marks the termination point following a rejection notification."
    }
  ],
