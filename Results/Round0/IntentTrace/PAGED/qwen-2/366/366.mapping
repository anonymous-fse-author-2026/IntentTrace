      ],
      "verbatim_texts": [
        "To begin the process, start by checking the order received"
      ],
      "justification": "The opening clause implicitly starts the process (init) and describes the initial two action steps."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to check the availability of the article."
      ],
      "justification": "Directly matches the third action step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the article is not available,"
      ],
      "justification": "The conditional clause triggers the XOR branch, the corresponding check action, and the negative guard path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the next step is to initiate the procurement process."
      ],
      "justification": "Faithfully restates the action on the first negative branch."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "However, if the article is available,"
      ],
      "justification": "Captures the positive condition for the alternative branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "proceed to ship it."
      ],
      "justification": "Direct paraphrase of the shipping action on the first positive branch."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After shipping the article, check its availability again."
      ],
      "justification": "Exact match for the repeated availability check step."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If it is still not available,"
      ],
      "justification": "The second conditional clause triggers the second XOR branch, its check action, and the negative guard."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "initiate the procurement process."
      ],
      "justification": "Matches the repeated procurement action on the second negative branch."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n10"
      ],
      "verbatim_texts": [
        "Otherwise, proceed to ship the article."
      ],
      "justification": "Covers the positive fallback condition and the subsequent shipping action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the article is shipped, the next step is to complete the financial settlement."
      ],
      "justification": "Directly maps to the settlement step following convergence."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After the financial settlement is done, the process ends with the receipt of payment."
      ],
      "justification": "The closing clause signals the process termination (end) and describes the final action."
    }
