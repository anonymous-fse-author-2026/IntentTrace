    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts with an informational meeting that lasts half a day, involving the customer and the web design team."
      ],
      "justification": "Implicit process initiation and the first substantive action step."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the meeting is successful, the next step is to work on the storyboard"
      ],
      "justification": "Conditional decision point, routing to the positive arm, and executing the storyboard task."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "However, if the meeting is not successful, the process ends."
      ],
      "justification": "Negative routing from the initial meeting decision leads directly to termination."
    },
    {
      "refs": [
        "action:n6",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the storyboard is successful, the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "AND split creates parallel execution paths for site design and content preparation following the storyboard success."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the site is built, it goes through a review process that lasts 1 day."
      ],
      "justification": "Parallel flows rejoin before the single review step."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the review is successful, it moves on to the approval stage, which takes half a day."
      ],
      "justification": "Positive review outcome routes directly to the approval action."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11",
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the approval is complete, the process ends. However, if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
      ],
      "justification": "Routes approval outcomes to either termination or the initial rebuild step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the rebuild is complete, the process ends."
      ],
      "justification": "Termination action following the rebuild completion phase."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Condition and action for the secondary rebuild attempt."
    }
  ],
