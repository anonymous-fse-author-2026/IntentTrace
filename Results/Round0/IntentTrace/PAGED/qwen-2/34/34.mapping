{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially, it is important to check the Referee Reports."
      ],
      "justification": "The opening clause implicitly initiates the process (init) and describes the first concrete step (n2), while 'Initially' supports the generic start action (n1)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "monitor if the Referee Reports have been completed. If they have been completed"
      ],
      "justification": "Captures the monitoring/condition check and the subsequent XOR split between completed and incomplete paths."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "flag it and send a reminder."
      ],
      "justification": "Directly maps to the negative arm action of the first decision."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "check again if the Referee Reports have been completed. If they have"
      ],
      "justification": "Represents the re-evaluation step and the second XOR branching point based on the re-checked status."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the Referee Reports have been completed, you can move on to organizing interviews for the Selection Panel with the top candidates."
      ],
      "justification": "Signals the rejoining of the report-monitoring paths (converge) before proceeding to the interview organization action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "receive feedback from the interview candidates."
      ],
      "justification": "Exact paraphrase of the post-interview step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "check if a Psychometric Test is required. If it is"
      ],
      "justification": "Models the requirement check and the XOR gateway determining whether to proceed to HR checks or skip to coordination."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If not, you can continue with the process and coordinate the second round of selection."
      ],
      "justification": "Maps to the negative outcome of the psychometric test requirement check."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "check if an HR Specialist is required. If an HR Specialist is required"
      ],
      "justification": "Captures the secondary nested condition and its XOR split."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "schedule the test with a third party."
      ],
      "justification": "Direct match for the positive HR specialist branch outcome."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Otherwise, you can proceed to complete the Psychometric Test."
      ],
      "justification": "Direct match for the negative HR specialist branch outcome."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "request the final candidate ranking and continue with the process."
      ],
      "justification": "Faithfully restates the penultimate process step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, you should request the final candidate ranking and continue with the process."
      ],
      "justification": "The final joining of alternative testing paths (converge), followed by closure of the modeled workflow (end/n15)."
    }
  ],
