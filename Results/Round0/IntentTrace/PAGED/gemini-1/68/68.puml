@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start process;
:Items returned by customer or picked up by delivery crew;
:v1: Items returned by customer or picked up by delivery crew ({Delivery crew picks up items at event site}); <<objectSignal>>
if () then ([v1 = 'Delivery crew picks up items at event site'])
:Count and compare items to contract;
:Order status after count;
:v2: Order status after count ({All items returned, Items missing, Items damaged}); <<objectSignal>>
switch ()
case ([v2 = 'All items returned'])
:Items disposition for returned items;
:v3: Items disposition for returned items ({Stored for future orders}); <<objectSignal>>
if () then ([v3 = 'Stored for future orders'])
:End process;
stop
endif
case ([v2 = 'Items missing'])
:Email customer missing items and replacement charges;
:Customer returns missing items;
:v4: Customer returns missing items ({Customer does not return missing items}); <<objectSignal>>
if () then ([v4 = 'Customer does not return missing items'])
:End process;
stop
endif
case ([v2 = 'Items damaged'])
:Email customer damage and additional charges;
:Temporarily remove damaged items from inventory;
:Can damaged items be repaired;
:v5: Can damaged items be repaired ({Can be repaired, Cannot be repaired}); <<objectSignal>>
if () then ([v5 = 'Can be repaired'])
:Repair items and add to inventory;
else ([v5 = 'Cannot be repaired'])
:Discard items and email customer replacement charges;
endif
:Items disposition after repair;
:v6: Items disposition after repair ({Stored for future orders}); <<objectSignal>>
if () then ([v6 = 'Stored for future orders'])
:End process;
stop
endif
endswitch
endif
@enduml