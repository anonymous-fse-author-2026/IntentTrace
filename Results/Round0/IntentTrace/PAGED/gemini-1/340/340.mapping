  "mutations": [
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer"
      ],
      "reason": "The model checks if they 'Need to check availability', but the text condition is whether they need to elicit information."
    },
    {
      "refs": [
        "guard:b1->c2"
      ],
      "verbatim_texts": [
        "if they already have the availability information"
      ],
      "reason": "The model's guard uses 'Proceed with process or after contacting customer', completely ignoring the text's condition about already having availability information."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer"
      ],
      "reason": "The text uses 'parts are supplied to the customer' as a condition, but the model changes it to 'Order not needed proceed'."
    },
    {
      "refs": [
        "action:n5",
        "label:n4->n5"
      ],
      "verbatim_texts": [
        "However, if they need to record the customer's details"
      ],
      "reason": "The text specifies a condition of needing to record details, but the model mutates this into checking if parts need to be ordered."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "if they need to record the customer's details"
      ],
      "reason": "The model incorrectly changes the condition for receiving parts to 'Order and receive the part' instead of testing if customer details need recording."
    },
    {
      "refs": [
        "label:n7->n8"
      ],
      "verbatim_texts": [
        "if they need to record the customer's details, they should order and receive the part"
      ],
      "reason": "The model places 'Record the customer's details' as a transition label after receiving the part, reversing the text's logic where recording details is the precondition for ordering and receiving."
    }
  ],
