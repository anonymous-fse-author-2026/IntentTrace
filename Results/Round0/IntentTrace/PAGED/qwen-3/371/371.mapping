      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Covers the implicit process start and the three initial UI steps described in the opening clause."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000,"
      ],
      "justification": "Models the first conditional check and the XOR split point."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the report should be reviewed."
      ],
      "justification": "Direct paraphrase of the positive branch outcome."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed to check if there is a need for translation."
      ],
      "justification": "Captures the secondary decision point and its associated branch gateway."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "proceed to translate the receipts."
      ],
      "justification": "Direct match for the translation requirement arm."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "confirm the receipts."
      ],
      "justification": "Direct match for the negative translation arm."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "evaluate the review decision."
      ],
      "justification": "Maps the first review evaluation step and its decision gateway."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "edit the report."
      ],
      "justification": "Corresponds to the first rejection path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Maps the second explicit review evaluation and decision split."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "edit the report."
      ],
      "justification": "Corresponds to the second rejection path."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "translate the receipts and then confirm them."
      ],
      "justification": "Directly captures the combined translation and confirmation steps on the approval path."
    },
    {
