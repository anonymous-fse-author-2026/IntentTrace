  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, you should choose your destination and calculate the distance."
      ],
      "justification": "Captures the implicit process start and the initial planning actions described in the opening sentence."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "While doing so, continue to check if you need to book a train or a flight."
      ],
      "justification": "Describes the ongoing verification step and implies the subsequent XOR decision point between transport modes."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the answer is \"no\", then proceed to book a train."
      ],
      "justification": "Directly corresponds to the fallback action when train booking is required."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the answer is \"yes\", then book a flight."
      ],
      "justification": "Directly corresponds to the alternative action for flight booking."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours, the process will end."
      ],
      "justification": "Maps the conditional check, the successful path, and the immediate process termination."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Otherwise, if 24 hours have passed, you should call a travel agency."
      ],
      "justification": "Matches the contingency action taken when the time window expires."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "In that case, the process will end as well."
      ],
      "justification": "Aligns with the final closing statement indicating process completion."
    }
  ],
  "mutations": [
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If a code is available, the process will end along with the hotel reservation."
      ],
      "reason": "The model incorrectly imposes a 'within 24 hours' constraint and appends '(flight)' to these steps, whereas the source text states the condition simply as 'If a code is available' without a time limit."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "On the other hand, if a code is not available, you should cancel your journey."
      ],
      "reason": "The model substitutes 'call travel agency' for the source's explicit instruction to 'cancel your journey', altering the prescribed action."
    }
  ],
