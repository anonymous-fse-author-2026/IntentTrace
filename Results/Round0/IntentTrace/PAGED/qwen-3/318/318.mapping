{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process, start by receiving the order."
      ],
      "justification": "Opening clause establishes the process start and first action step."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: check the order and check the customer."
      ],
      "justification": "Concurrency marker implies AND branch splitting into two parallel check actions."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the order is okay"
      ],
      "justification": "Conditional check modeled as action step n4 initiates the XOR decision branch."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the order is not okay"
      ],
      "justification": "Guard captures the negative outcome of the order check condition."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "send a refusal and end the process"
      ],
      "justification": "Directly matches the refusal and termination steps for the negative order path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "if the customer is permitted"
      ],
      "justification": "Customer permission check models the conditional action and subsequent XOR branch."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the customer is not permitted"
      ],
      "justification": "Guard aligns with the negative permission outcome."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "if the customer is permitted"
      ],
      "justification": "Guard aligns with the positive permission outcome."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "send a refusal and end the process"
      ],
      "justification": "Matches the refusal and termination steps for the negative customer path."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "continue with the process"
      ],
      "justification": "Implicit merge point where conditional paths rejoin before proceeding."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Release the order and then transfer the data in the database."
      ],
      "justification": "Sequential actions match the release and data transfer steps exactly."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the data is transferred, check the worth of the order."
      ],
      "justification": "Worth check action triggers the subsequent value-based decision branch."
    },
    {
      "refs": [
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "greater than 10.000 \u20ac"
      ],
      "justification": "Guard correctly captures the monetary threshold comparison."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "Otherwise"
      ],
      "justification": "Guard captures the fallback condition when threshold is not met."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "sign off on the order"
      ],
      "justification": "Direct match for the positive threshold outcome action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "continue with the process"
      ],
      "justification": "Direct match for the fallback continuation step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Sign off on the order and forward it to production."
      ],
      "justification": "Combined action step faithfully restates the forwarding instruction."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: check the product quality, start production, and produce the product."
      ],
      "justification": "Concurrency marker splits into three parallel production-related actions via AND branch."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "create a material report"
      ],
      "justification": "Direct match for the material report generation step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once the report is created, send it to the warehouse."
      ],
      "justification": "Temporal condition and sending action match exactly."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "After sending the report to the warehouse, the process ends."
      ],
      "justification": "Action and end node jointly cover the post-warehouse termination statement."
    },
    {
      "refs": [
        "action:n22",
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "At the same time, create a quality report, send the product to shipment, and send the order to accounting."
      ],
      "justification": "Second concurrency split covers report, shipment, and accounting parallel steps."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "Once the report is created, send it to Finance."
      ],
      "justification": "Matches the Finance reporting step."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Ship the product and send the invoice."
      ],
      "justification": "Direct match for combined shipping and invoicing action."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "After sending the report, archive it."
      ],
      "justification": "Matches the archiving step."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Archive the report and end the process."
      ],
      "justification": "Action and structural end node cover the final archival and termination."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "Check the payment."
      ],
      "justification": "Implicit convergence point preceding the payment verification step."
    },
    {
      "refs": [
        "action:n29",
        "action:n30"
      ],
      "verbatim_texts": [
        "Check the payment. If the payment is received"
      ],
      "justification": "Payment check actions and initiation of the received/not-received decision branch."
    },
    {
      "refs": [
        "guard:b4->n31"
      ],
      "verbatim_texts": [
        "is received"
      ],
      "justification": "Guard aligns with the positive payment status."
    },
    {
      "refs": [
        "guard:b4->n32"
      ],
      "verbatim_texts": [
        "is not received"
      ],
      "justification": "Guard aligns with the negative payment status."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "close the order"
      ],
      "justification": "Direct match for the order closure on successful payment."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "check if a reminder has been sent more than three times"
      ],
      "justification": "Reminder frequency check action triggers the subsequent legal/follow-up branch."
    },
    {
      "refs": [
        "guard:b5->n33"
      ],
      "verbatim_texts": [
        "has been sent more than three times"
      ],
      "justification": "Guard captures the high-frequency threshold condition."
    },
    {
      "refs": [
