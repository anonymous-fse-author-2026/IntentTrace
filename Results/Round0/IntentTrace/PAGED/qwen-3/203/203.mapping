      "verbatim_texts": [
        "At the start, the loan application is checked."
      ],
      "justification": "The opening sentence establishes the process start and specifies the initial verification step. n1 and n2 split the initiation and checking actions."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the application is rejected,"
      ],
      "justification": "Introduces the exclusive decision point. n3 captures the condition text, while the guards model the positive/negative outcomes branching from it."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Directly represents the termination path taken when the rejection condition is met."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if special terms are agreed upon, the process continues."
      ],
      "justification": "Captures the alternative pathway and continuation condition when the application is not rejected."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "Once the funds are disbursed,"
      ],
      "justification": "Describes the funding action and the temporal/completion condition for moving to the final stage."
    },
    {
      "refs": [
        "action:n7",
        "action:n8",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Covers the final termination statements. The model redundantly splits the ending into two terminator pairs, but both align with the closing text without changing process behavior."
    }
