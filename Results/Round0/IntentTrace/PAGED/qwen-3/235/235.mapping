{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "The process starts when the customer enters the website and then searches for the desired item."
      ],
      "justification": "The opening clause implicitly starts the process and describes the first two sequential actions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After finding the desired item, they click on it and enter the desired item page."
      ],
      "justification": "Directly maps to the clicking action described after finding the item."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "From there, they choose an action."
      ],
      "justification": "Faithfully restates the step of choosing an action on the item page."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If they choose to view the quantity amount, they can see the quantity amount."
      ],
      "justification": "The conditional clause introduces the XOR branch and describes the first alternative action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Alternatively, if they choose to enter a quantity amount, they can input it."
      ],
      "justification": "Describes the second alternative action under the same decision point."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the quantity amount is viewed or entered, they return to the desired item page."
      ],
      "justification": "The completion condition implies the converge node, and the clause describes the subsequent return action."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "From there, they add the item to their cart, and once it's added, they choose another action."
      ],
      "justification": "Covers both the cart addition step and the following action-selection step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If they choose to continue shopping, they return to the desired item page."
      ],
      "justification": "Introduces the second XOR branch and maps to the continue-shopping path and its immediate outcome."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if they choose to check out the current item, they proceed to check out."
      ],
      "justification": "Describes the alternative branch path and the subsequent checkout initiation step."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "After checking out the item, they confirm it, and once it's confirmed, they choose another action."
      ],
      "justification": "Captures the confirmation step and the following choice point."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If they choose to proceed to check out, they go to the check-out page."
      ],
      "justification": "Opens the third XOR branch and maps to the action of going to the checkout page."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Alternatively, if they choose to recalculate the shipping, they can do so."
      ],
      "justification": "Directly describes the shipping recalculation alternative."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Lastly, if they choose to enter a coupon code, they can enter it."
      ],
      "justification": "Directly describes the coupon code entry alternative."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once they proceed to check out, recalculate the shipping, or enter a coupon code, they enter the check-out page."
      ],
      "justification": "The joint completion condition implies the converge node, and the clause states the resulting navigation action."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "From there, they enter their billing information, and the process ends."
      ],
      "justification": "Describes the final data entry action and explicitly signals the process termination."
    }
  ],
