{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "The opening clause implicitly triggers the start event, justifies the explicit 'start' action, and describes the initial receipt step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is sorted per client."
      ],
      "justification": "Direct paraphrase of the first sorting step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor."
      ],
      "justification": "Direct paraphrase of the second sorting step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice."
      ],
      "justification": "Exact match to the attachment instruction."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form."
      ],
      "justification": "Direct paraphrase of the data entry step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked."
      ],
      "justification": "The action node performs the verification; the XOR branch node captures the subsequent decision fork implied by the check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Describes the early-termination condition and its terminal node."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered. The date for completion is also entered and the priority is checked."
      ],
      "justification": "Both action nodes faithfully restate the sequential data-entry and priority-assessment steps on the positive path. Minor consolidation is acceptable under the paraphrase rule."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "The branch marks the priority decision; the action captures the high-priority outcome."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Direct paraphrase of the compliance verification step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff... If it is a normal case... If none of these conditions apply..."
      ],
      "justification": "The multi-condition paragraph implies an exclusive gateway splitting into three distinct paths."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the non-compliance invoice is processed."
      ],
      "justification": "Direct paraphrase of the experienced-staff workflow."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "the client is called."
      ],
      "justification": "Direct match to the normal-case routing instruction."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Captures the fallback communication action and its associated termination point."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO"
      ],
      "justification": "Direct paraphrase of the final processing step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Closing clause confirms successful completion and maps to the final end node."
    }
  ],
