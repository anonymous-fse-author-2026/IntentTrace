{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts with an informational meeting that lasts half a day"
      ],
      "justification": "The opening clause implicitly triggers the process start node and describes the initial meeting phase captured by the 'Start' action."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the meeting is successful, the next step is to work on the storyboard, which takes a full day"
      ],
      "justification": "Captures the conditional check, the implicit XOR decision gateway, and the resulting storyboard action with its exact duration."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the meeting is not successful, the process ends."
      ],
      "justification": "Maps the negative outcome of the first decision directly to process termination."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the storyboard is successful, the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "The successful storyboard condition triggers an AND split into two parallel tasks. Action n5 captures the site design duration, while n6 captures content preparation."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "After that, the site development takes 2 days"
      ],
      "justification": "'After that' signals the rejoining of parallel paths (converge/merge label) immediately preceding the site development step with its 2-day duration."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the site is built, it goes through a review process that lasts 1 day."
      ],
      "justification": "Direct match for the sequential review step and its exact 1-day duration."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the review is successful, it moves on to the approval stage, which takes half a day."
      ],
      "justification": "Covers the review success evaluation, the second XOR gateway, and the subsequent approval action with its precise duration."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If the approval is complete, the process ends."
      ],
      "justification": "Directly maps the positive approval outcome to the corresponding end node."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
      ],
      "justification": "Captures the rejection branch leading to the first rebuild action with its exact 3-day duration."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the rebuild is complete, the process ends."
      ],
      "justification": "Maps the second decision point regarding the rebuild, along with the successful path that terminates the process."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Captures the final rejection scenario, the second rebuild action with matching duration, and the subsequent process conclusion."
    }
  ],
