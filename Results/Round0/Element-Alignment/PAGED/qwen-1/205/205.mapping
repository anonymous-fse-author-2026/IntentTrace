{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the process for ACME Company, the Resupply Cycle is triggered"
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial cycle action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level."
      ],
      "justification": "Directly maps to the inventory verification step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the Inventory is greater than the Minimum Level"
      ],
      "justification": "Captures the exclusive decision point based on inventory thresholds."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, a Purchase Order is created."
      ],
      "justification": "Corresponds to the negative branch outcome of the inventory check."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "The Purchase Order is then reviewed."
      ],
      "justification": "Directly maps to the review step."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected, it is reworked. However, if the Purchase Order is accepted, funds are reserved for payment."
      ],
      "justification": "The conditional logic supports the decision node, while the two arms justify the rework and fund reservation actions."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reserving funds for payment, the Purchase Order is sent to the Supplier."
      ],
      "justification": "Directly maps to the dispatch step following fund reservation."
    },
    {
      "refs": [
        "action:n9",
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: the Packing Slip is received and the Invoice is received."
      ],
      "justification": "The word 'Simultaneously' justifies the AND branch, and the clause lists the two concurrent receipt actions."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Upon receiving the Packing Slip, it is recorded."
      ],
      "justification": "Directly maps to the packing slip recording step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Similarly, upon receiving the Invoice, it is recorded."
      ],
      "justification": "Directly maps to the invoice recording step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the funds are released for payment"
      ],
      "justification": "Paraphrased action capturing the fund release trigger."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "the payment is issued to the Supplier."
      ],
      "justification": "Directly maps to the final payment issuance step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, the process ends with the issuance of payment to the Supplier."
      ],
      "justification": "The closing clause explicitly terminates the process and justifies both the structural end node and the summary action."
    }
  ],
  "mutations": [],
  "omissions": [
    {
      "verbatim_texts": [
        "then the process ends."
      ],
      "reason": "The source explicitly specifies an early termination path when inventory exceeds the minimum level, but the model lacks a corresponding action or terminal node for this positive branch outcome."
    }
