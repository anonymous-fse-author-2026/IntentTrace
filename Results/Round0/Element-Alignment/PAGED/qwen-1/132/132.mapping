{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, the customer makes an enquiry."
      ],
      "justification": "The opening clause implicitly initiates the process and describes the first customer action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, we check if the article is in stock."
      ],
      "justification": "Directly describes the inventory verification step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the article is available",
        "if the article is not available"
      ],
      "justification": "The mutually exclusive conditional clauses establish the XOR decision gateway."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the article is available, we continue with the process."
      ],
      "justification": "Positive branch outcome leads to continuing the workflow."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the article is not available, we abort the enquiry and end the process."
      ],
      "justification": "Negative branch outcome triggers the abort action and terminates this path."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "At the same time, we complete the following steps simultaneously: reserving the article and calculating the price."
      ],
      "justification": "Source explicitly lists these two tasks as the concurrent/sequential work block."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "First, we reserve the article"
      ],
      "justification": "Clarifies the execution order for the reservation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "once it is reserved, we calculate the price."
      ],
      "justification": "Clarifies that pricing follows reservation."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "After that, we send the offer, and once the offer is sent, we wait for the customer to accept it."
      ],
      "justification": "Sequential steps for transmitting the offer and pausing for customer response."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the customer accepts the offer, we dispatch the article."
      ],
      "justification": "Acceptance acts as a conditional check (branch/guard), which upon success triggers the dispatch action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Finally, once the article is dispatched, the process comes to an end."
      ],
      "justification": "Explicit statement of the final step and overall process termination."
    }
  ],
