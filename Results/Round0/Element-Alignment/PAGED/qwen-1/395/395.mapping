{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially, it is important to check the Referee Reports."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial check action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "monitor if the Referee Reports have been completed."
      ],
      "justification": "Describes the monitoring step that naturally forms the first conditional branch."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "if they have not been completed, you should flag it and send a reminder."
      ],
      "justification": "Directly supports the negative guard condition and the corresponding flag-and-reminder action."
    },
    {
      "refs": [
        "label:n4->n5",
        "action:n5",
        "label:n5->n6"
      ],
      "verbatim_texts": [
        "After that, you should check again if the Referee Reports have been completed."
      ],
      "justification": "Covers the loop-back label, the second check action, and the transition label leading to the next decision."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n4"
      ],
      "verbatim_texts": [
        "If not, you should flag it again and send another reminder."
      ],
      "justification": "Captures the second decision point, the guard for the incomplete state, and the repeated flag/reminder action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If they have been completed, you can proceed with the process."
      ],
      "justification": "The positive outcome of the referral checks converges the parallel/looping paths and triggers the proceed action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "move on to organizing interviews for the Selection Panel with the top candidates."
      ],
      "justification": "Exact match for the interview organization step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the interviews, it is necessary to receive feedback from the interview candidates."
      ],
      "justification": "Direct match for the feedback collection step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Next, you need to check if a Psychometric Test is required."
      ],
      "justification": "Describes the assessment check and the subsequent XOR decision gateway."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If not, you can continue with the process and coordinate the second round of selection."
      ],
      "justification": "Matches the guard for the test-not-required path and the coordination action."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required, you should schedule the test with a third party."
      ],
      "justification": "Aligns with the HR specialist requirement condition and the third-party scheduling action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Otherwise, you can proceed to complete the Psychometric Test."
      ],
      "justification": "Direct match for the internal completion of the psychometric test."
    },
    {
      "refs": [
        "label:n11->c2",
        "label:n12->c2",
        "label:n13->c2",
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, you should request the final candidate ranking and continue with the process."
      ],
      "justification": "All remaining flow labels, the convergence node, the final ranking action, and the structural end nodes are collectively justified by this concluding instruction."
    }
  ],
