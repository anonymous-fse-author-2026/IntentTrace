{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order and then proceed to Check the Customer's Credit Limit."
      ],
      "justification": "Covers the implicit start, initialization action, and the first two sequential process steps."
    },
    {
      "refs": [
        "action:n4",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "Captures the XOR decision point, the positive outcome state node, and the subsequent check step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Directly maps the negative condition guard and the denial action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "guard:b2->n9",
        "action:n7",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods. However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Maps the availability decision, its guards, the state indicator, and both resulting actions."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Exact match for the confirmation dispatch step."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "AND gateway splits into parallel shipping and invoicing tasks, which rejoin at the converge node."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Direct match for the payment verification step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment has been received"
      ],
      "justification": "State/action capturing the successful payment outcome."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "Positive payment path leads to order closure and process termination."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Negative payment path routes to the reminder count evaluation step."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Threshold condition correctly triggers the write-off action."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Matches the supplementary reminder dispatch step."
    },
    {
      "refs": [
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Final sequence post-write-off converging to closure and termination."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\""
      ],
      "reason": "The guard condition specifies v1 = 'Yes', whereas the source text explicitly states the expected response value is 'Okay'."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "After checking the availability, if the response is \"Okay\", proceed to Check the Availability of the Article again. If the response is \"No\", send a Denial to the Customer."
      ],
      "reason": "The model completely omits this second availability check loop and its associated conditional denial branch."
    }
  ],
  "additions": [
    {
      "refs": [
        "action:n19"
      ],
      "reason": "Models an 'End' action on the negative branch of the reminder count check (v4='No'), but the source text does not describe any behavior or termination when the reminder count is below 3."
    },
    {
      "refs": [
        "guard:b4->n19"
      ],
      "reason": "No supporting verbatim portion was mapped from the input text.",
      "source_line": "guard b4->n19: v4 = 'No'"
    }
