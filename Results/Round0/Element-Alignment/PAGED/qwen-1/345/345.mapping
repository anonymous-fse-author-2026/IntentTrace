{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "The opening clause implies the process start and describes the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "then proceed to Check Levels of Inventory."
      ],
      "justification": "Direct paraphrase of the next sequential step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the inventory is"
      ],
      "justification": "Introduces the exclusive choice point for evaluating inventory levels."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "\"greater than\" the minimum"
      ],
      "justification": "Captures the comparison operator and threshold context for the upper bound path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "generate an \"Above Minimum Report\""
      ],
      "justification": "Directly matches the reporting action for sufficient inventory."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "\"below or equal to\" the minimum"
      ],
      "justification": "Captures the comparison operator and threshold context for the lower bound path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an \"Equal to or below minimum Report\""
      ],
      "justification": "Directly matches the reporting action for low inventory."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process ends with the End Resupply Cycle."
      ],
      "justification": "Describes the finalization action and implicitly concludes this branch of the workflow."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "POs are Created."
      ],
      "justification": "Directly matches the purchase order creation step triggered by low inventory."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the POs are Created, they are subject to POs Review."
      ],
      "justification": "Temporal phrasing denotes the state transition into the review phase."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the POs are"
      ],
      "justification": "Introduces the exclusive decision point regarding approval status."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "\"rejected\""
      ],
      "justification": "Matches the exact condition guarding the rework pathway."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "they need to be \"reworked\""
      ],
      "justification": "Directly matches the corrective action required upon rejection."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "\"approved\""
      ],
      "justification": "Matches the exact condition guarding the fulfillment pathway."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "they are \"Printed and released in the system\""
      ],
      "justification": "Faithfully restates the system release step for approved orders."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Explicitly signals the termination of the main workflow path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the POs are \"reworked\", then POs are Created again."
      ],
      "justification": "Describes the feedback loop that regenerates purchase orders after rework."
    }
