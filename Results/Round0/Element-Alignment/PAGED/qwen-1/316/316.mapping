      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial registration action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If an exception is needed"
      ],
      "justification": "The conditional phrase establishes the XOR decision point, faithfully restated as an action step checking the condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then a Request for the exception should be made."
      ],
      "justification": "Direct mapping of the positive branch action."
    },
    {
      "refs": [
        "action:n4",
        "label:n4->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if an exception is not needed, the process can continue."
      ],
      "justification": "Captures the negative branch outcome and the transition label indicating continuation."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "the process can continue."
      ],
      "justification": "Implies the rejoining of the exception-needed and exception-not-needed paths before proceeding to the next phase."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After the exception is approved"
      ],
      "justification": "Conditional state check modeled as an action, triggering the subsequent decision/flow point."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the next step is course enrollment"
      ],
      "justification": "Direct paraphrase of the course enrollment step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
