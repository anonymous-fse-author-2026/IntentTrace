{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle."
      ],
      "justification": "The opening clause implicitly initiates the process and describes the first action. The 'start' action is a redundant restatement of the initiation phase, which is acceptable."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the current inventory level."
      ],
      "justification": "Direct match for the inventory verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is above the minimum, then the process ends."
      ],
      "justification": "Captures the conditional decision point, the termination action for the positive arm, and the corresponding structural end node."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "if the inventory level is below the minimum, create a purchase order."
      ],
      "justification": "Maps directly to the alternative path action when inventory falls short."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the purchase order is created, review it."
      ],
      "justification": "Exact match for the post-creation review step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order."
      ],
      "justification": "Covers the rejection decision gate and the immediate rework action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, review it again."
      ],
      "justification": "Direct match for the secondary review step following rework."
    },
    {
      "refs": [
        "action:n9",
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: reserve funds for the purchase and send the purchase order to the supplier."
      ],
      "justification": "Identifies the concurrent split point and maps to both the combined action and the isolated supplier notification action described in the clause."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, release the reserved funds and then the process ends."
      ],
      "justification": "All listed elements correspond to receiving the slip, releasing funds, and terminating the process. Duplicate nodes are redundant but faithfully restate the source text and do not alter process behavior."
    }
  ],
