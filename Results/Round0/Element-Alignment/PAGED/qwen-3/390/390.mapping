  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "The opening sentence establishes the process trigger (init) and sequentially describes the initial setup actions."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\""
      ],
      "justification": "The conditional clause introduces the XOR decision point, with the condition string modeled as an action state."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed with processing the order for delivery"
      ],
      "justification": "Direct match for the action taken on the positive branch of the first decision."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance"
      ],
      "justification": "Captures the alternative condition and the resulting outstanding balance state/action."
    },
    {
      "refs": [
        "action:n7",
        "action:n12",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "In the case of an Outstanding Balance, a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "Covers placing a new order and the explicit process termination. Multiple end nodes/actions are redundant but faithfully correspond to this single textual endpoint."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If a new order is placed, it will be recorded in the Accounts Receivable."
      ],
      "justification": "Direct match for the accounting recording step following order placement."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If Payments are Received"
      ],
      "justification": "Introduces the payment condition and the corresponding XOR decision point."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the process continues"
      ],
      "justification": "Matches the continuation action on the positive payment path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "if no payments are received, the order is dropped"
      ],
      "justification": "Matches the negative payment outcome and resulting drop action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Next, identify the order for installation."
      ],
      "justification": "Direct match for the installation identification step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled"
      ],
      "justification": "Condition modeling the scheduling requirement and introducing the subsequent XOR split."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "an Installer will be assigned"
      ],
      "justification": "Direct match for the installer assignment action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "if the order does not require installation, it will be packed for delivery"
      ],
      "justification": "Matches the alternative path outcome when installation is unnecessary."
    }
  ],
