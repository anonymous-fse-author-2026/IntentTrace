{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the process for ACME Company, the Resupply Cycle is triggered"
      ],
      "justification": "Implicitly starts the process (init) and describes the initial trigger action. 'start' is a redundant restatement of the initiation phase, which is acceptable per redundancy rules."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "checking the Inventory Level"
      ],
      "justification": "Direct paraphrase of the inventory verification step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the Inventory is greater than the Minimum Level"
      ],
      "justification": "Captures the conditional decision point regarding inventory status."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, a Purchase Order is created."
      ],
      "justification": "Direct mapping to the outcome of the negative inventory branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "The Purchase Order is then reviewed."
      ],
      "justification": "Exact restatement of the purchase order review step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected, it is reworked."
      ],
      "justification": "The rejection condition opens the XOR branch, and the consequent clause directly maps to the rework action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "if the Purchase Order is accepted, funds are reserved for payment."
      ],
      "justification": "Maps the acceptance condition's outcome to the fund reservation step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reserving funds for payment, the Purchase Order is sent to the Supplier."
      ],
      "justification": "Direct paraphrase of transmitting the PO following fund reservation."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Explicit timing word denoting parallel execution branching."
    },
    {
      "refs": [
        "action:n9",
        "action:n11"
      ],
      "verbatim_texts": [
        "the Packing Slip is received and the Invoice is received"
      ],
      "justification": "Lists the two concurrent receiving steps enabled by the parallel branch."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Upon receiving the Packing Slip, it is recorded."
      ],
      "justification": "Directly maps the packing slip documentation step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Similarly, upon receiving the Invoice, it is recorded."
      ],
      "justification": "Directly maps the invoice documentation step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the funds are released for payment"
      ],
      "justification": "Captures the fund release step that precedes final payment issuance."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "the payment is issued to the Supplier."
      ],
      "justification": "Exact restatement of the payment execution step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, the process ends with the issuance of payment to the Supplier."
      ],
      "justification": "Explicitly marks the process termination aligned with the final payment action."
    }
  ],
