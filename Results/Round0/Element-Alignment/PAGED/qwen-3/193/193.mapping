{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "Implicitly starts the process and describes the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed with the Registration gross pathology request."
      ],
      "justification": "Direct paraphrase of the second step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During the \"Registration gross pathology request\" step, make sure to create a barcode scan at the start."
      ],
      "justification": "Exact match for the barcode creation requirement."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the registration is complete, assign a container to the gross pathology request."
      ],
      "justification": "Direct match for container assignment."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After assigning a container, move on to the Specimen description."
      ],
      "justification": "Direct match for specimen description step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "For the \"Specimen description\" step, pay attention to the scan start."
      ],
      "justification": "Direct match for scan start attention."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Then, pay attention to the scan end."
      ],
      "justification": "Direct match for scan end attention."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Finally, pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Direct match for continued scan start attention."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Following that, proceed with Macroscopic description writing."
      ],
      "justification": "Direct match for macroscopic writing step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "Timing word indicates parallel (AND) split."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Tissue processing"
      ],
      "justification": "Lists the two tasks executed in parallel."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required."
      ],
      "justification": "Lists the two tasks executed in parallel."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\"",
        "If the answer is \"yes,\""
      ],
      "justification": "Conditional logic implies an XOR branch."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "proceed with Digitalization."
      ],
      "justification": "Action taken when condition is yes."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Action taken when condition is no."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Next, check if \"Digitalization?\" is required again."
      ],
      "justification": "Direct match for the second digitalization check."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\"",
        "If the answer is \"yes,\""
      ],
      "justification": "Second conditional logic implies another XOR branch."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "proceed with Digitalization."
      ],
      "justification": "Action taken when second condition is yes."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Action taken when second condition is no."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "After that, assign cases to the pathologist and then move on to Microscopic examination and diagnosis."
      ],
      "justification": "Covers both case assignment and examination steps."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the microscopic examination and diagnosis are complete, write the pathology report."
      ],
      "justification": "Direct match for report writing."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "After writing the report, confirm it."
      ],
      "justification": "Direct match for report confirmation."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the pathology report is confirmed, deliver it."
      ],
      "justification": "Direct match for report delivery."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Then, proceed with the post-report processing."
      ],
      "justification": "Direct match for post-report processing step."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "To conclude the pathology procedure, close it."
      ],
      "justification": "Direct match for closing the procedure."
    },
    {
      "refs": [
        "action:n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, deliver the pathology report and complete the post-report processing."
      ],
      "justification": "Covers final delivery and completion steps."
    }
  ],
