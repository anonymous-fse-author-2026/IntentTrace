{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks"
      ],
      "justification": "The opening clause implicitly triggers the process start (init) and directly describes the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "select the method for exit control checks"
      ],
      "justification": "Directly corresponds to the selection step described immediately after immigration checks."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics, they should undergo a check using biometrics."
      ],
      "justification": "The conditional introduces the XOR branch, and the consequent describes the biometrics action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "if the passenger prefers to use ID documents, they should undergo checks using identity documents."
      ],
      "justification": "Describes the alternative path and corresponding action under the same XOR branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission"
      ],
      "justification": "Completion of parallel checks implies convergence (c1). The subsequent condition triggers the evaluation step (n5) and splits the flow (b2)."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should leave the area."
      ],
      "justification": "Directly matches the action taken on the denied-permission path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Captures the alternative branch outcome and the subsequent proceeding action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful"
      ],
      "justification": "Introduces the explicitly repeated evaluation step and its associated decision branch."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the passenger should leave the area and the process ends."
      ],
      "justification": "Matches the unsuccessful outcome action, including the termination signal."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Captures the successful path action, the structural rejoin before termination, the explicit End step, and the final end node, all signaled by the closing clause."
    }
  ],
