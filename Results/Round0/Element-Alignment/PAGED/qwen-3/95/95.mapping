{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "The opening clause implicitly starts the process and explicitly describes the initialization action and the first order-placing step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to Check the Customer's Credit Limit"
      ],
      "justification": "Directly matches the credit verification step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article"
      ],
      "justification": "Matches the instruction for the first availability check."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the response is \"No\", send a Denial to the Customer"
      ],
      "justification": "Captures the XOR decision point, the explicit negative guard condition, and the corresponding denial action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article again"
      ],
      "justification": "Matches the repeated availability check instruction verbatim."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer"
      ],
      "justification": "Captures the second conditional branch, its negative guard, and the denial action."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods"
      ],
      "justification": "Maps the unavailability condition to the branch, guard, and production action."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if the Article is available, proceed to Collect the Goods"
      ],
      "justification": "Maps the availability condition to the alternative guard and collection action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "send an Order Confirmation"
      ],
      "justification": "Directly restates the confirmation step."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice"
      ],
      "justification": "The temporal keyword 'Simultaneously' explicitly justifies the AND gateway supporting both shipping and invoicing actions."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the Payment status"
      ],
      "justification": "Directly matches the payment verification step."
    },
    {
      "refs": [
        "guard:b4->n20",
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process"
      ],
      "justification": "Fully covers the successful-payment branch, guard, close action, termination action, and end node."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3"
      ],
      "justification": "Matches the negative payment guard and models the subsequent reminder-count evaluation as an action step, which preserves the source logic."
    },
    {
      "refs": [
        "guard:b5->n23",
        "guard:b5->n27",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order"
      ],
      "justification": "Captures the reminder-threshold decision, both explicit and implicit guard paths, and the write-off action."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder"
      ],
      "justification": "Directly matches the supplementary reminder step."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process"
      ],
      "justification": "Covers the post-write-off sequence: closing, terminating, and reaching the end node."
    }
  ],
