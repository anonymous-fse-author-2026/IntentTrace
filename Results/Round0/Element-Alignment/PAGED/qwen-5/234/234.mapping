{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process"
      ],
      "justification": "The opening phrase implicitly triggers the init node and directly justifies the explicit 'start' action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin by supplying the requirement and then documenting it."
      ],
      "justification": "Direct paraphrase of the initial documentation step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the order is received via fax,"
      ],
      "justification": "The conditional structure implies a reception check step and establishes the XOR branch."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "received via fax, input the order into an Excel file."
      ],
      "justification": "Guard captures the fax condition; action captures the corresponding input step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "received via mail or phone, also input the order into an Excel file."
      ],
      "justification": "Guard captures the mail/phone condition; action captures the corresponding input step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "send it to the student."
      ],
      "justification": "Direct match for sending the Excel list."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list,"
      ],
      "justification": "Temporal clause justifies the receipt and parallel task initiation step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "type the orders into the MS-Access database."
      ],
      "justification": "Direct match for database entry."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "control the incoming order.",
        "continue to do the check."
      ],
      "justification": "Combines the concurrent control and check steps mentioned in adjacent clauses."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "ensure that it is completed."
      ],
      "justification": "Matches the verification/completion step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the order is correct,"
      ],
      "justification": "Conditional implies a correctness decision step and opens the XOR branch."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "correct, release it."
      ],
      "justification": "Guard and action align with the positive correctness outcome."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "if the order is incorrect, contact the selling agency."
      ],
      "justification": "Guard and action align with the negative correctness outcome."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac,"
      ],
      "justification": "Value condition implies a valuation check step and opens the XOR branch."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "release it."
      ],
      "justification": "Direct match for the release action on the lower-value path."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off"
      ],
      "justification": "Guard and action align with the higher-value threshold and sign-off step."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "contact the client and release the order."
      ],
      "justification": "Single span covers both the client contact and subsequent release actions."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "they will initiate production."
      ],
      "justification": "Direct match for PPC production initiation."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved,"
      ],
      "justification": "Solvability condition implies a check step and opens the XOR branch."
    },
    {
      "refs": [
        "guard:b4->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "cannot be solved, cancel the order."
      ],
      "justification": "Guard and action align with the unsolvable cancellation path."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the issue can be solved, release the order."
      ],
      "justification": "Guard and action align with the solvable release path."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled,"
      ],
      "justification": "Cancellation condition implies a check step and opens the XOR branch."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "needs to be cancelled, the process ends."
      ],
      "justification": "Guard and action align with the termination path."
    },
    {
      "refs": [
        "guard:b5->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If not, check the quality of the goods."
      ],
      "justification": "Guard and action align with the alternative quality check path."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "create and send a quality report to the finance department."
      ],
      "justification": "Direct match for report generation and distribution."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "Release the order via memo"
      ],
      "justification": "Exact match for the memo-based release step."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Send the invoice"
      ],
      "justification": "Paraphrase preserving the core invoicing action directed at finance."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "commission the goods"
      ],
      "justification": "Exact match for goods commissioning."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "sign and send the memo.",
        "ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "Combines the signing/sending action with its logistical delivery target."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "archive the memo"
      ],
      "justification": "Exact match for archival step."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "close the order."
      ],
      "justification": "Exact match for final closing step."
    },
    {
      "refs": [
        "end:e4"
      ],
      "verbatim_texts": [
        "This marks the end of the process."
      ],
      "justification": "Closing statement explicitly signals the terminal end node."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "less than 5.000 \u20ac"
      ],
      "reason": "The model guard uses the `<=` operator (<= 5000 \u20ac), but the source text specifies a strictly less than (`<`) condition."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "ensure that the memo is achieved in the warehouse."
      ],
      "reason": "The source explicitly requires verifying memo completion at the warehouse, which lacks a corresponding model element."
    },
    {
      "verbatim_texts": [
        "send the goods"
      ],
      "reason": "The source explicitly describes shipping the goods alongside memo handling, but no action element models this dispatch step."
    }
  ],
