{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "Implicit start node followed by two sequential initiation actions."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "XOR branch captures the conditional logic; action n3 represents the condition threshold and n4 represents the positive-arm task."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Negative arm leads directly to process termination."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Direct mapping to the post-creation review step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "Second XOR branch captures the rejection condition and its corresponding rework action."
    },
    {
      "refs": [
        "action:n7",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Positive arm condition and the funding reservation action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Maps to the subsequent review step on the rework path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Maps to the final dispatch step on the approval path."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "At the same time"
      ],
      "justification": "Concurrency keyword explicitly justifies the AND gateway splitting the flow."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Lists the two parallel receiving tasks initiated by the AND split."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Sequential recording step for the packing slip path."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Sequential recording step for the invoice path."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Finalization of the packing slip sub-path leading to termination."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Finalization of the invoice sub-path leading to termination."
    }
  ],
