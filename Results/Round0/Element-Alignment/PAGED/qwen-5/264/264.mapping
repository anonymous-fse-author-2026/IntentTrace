{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "The opening clause implies the process start and directly describes the first sending action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Direct temporal sequence and action match."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Exact paraphrase of the TS contact step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Matches the explicit check step following receipt."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized."
      ],
      "justification": "The conditional clause triggers the XOR branch, defines the resource check action, and specifies the internal authorization outcome."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Matches the alternative branch outcome for external resources."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Direct match for the documentation sending step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Exact paraphrase of the scanning and system recording action."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Single compound span covers both the secondary check and the subsequent sending actions."
    },
    {
      "refs": [
        "action:n12",
        "action:n20"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Span covers HR reception, the end-of-process marker action, and implicitly justifies the end node."
    },
    {
      "refs": [
        "action:n13",
        "action:n15"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "First variation decision branch, condition label, and continuation action are fully captured."
    },
    {
      "refs": [
        "action:n14",
        "action:n16"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed."
      ],
      "justification": "Matches the negative variation path condition and the business case completion action."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Second textual repetition of the no-variation branch, condition check, and continuation."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed and attached."
      ],
      "justification": "Second textual repetition of the variation branch with the added attachment requirement faithfully captured."
    }
