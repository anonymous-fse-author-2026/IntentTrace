{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "Opening clause establishes the process start and the initial trigger step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level."
      ],
      "justification": "Direct description of the second sequential step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\""
      ],
      "justification": "Conditional phrase introduces the XOR branch and is faithfully restated as an action step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then proceed to Create Purchase Order."
      ],
      "justification": "Action on the positive branch path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "Negative branch path describes early process termination."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Sequential step following purchase order creation."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved"
      ],
      "justification": "Conditional phrase introduces the second XOR branch and captures the approval status."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then reserve the funds for the purchase."
      ],
      "justification": "Action executed on the approved path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the Purchase Order is rejected, then rework the order."
      ],
      "justification": "Action executed on the rejected path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Sequential step triggered after fund reservation."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Describes the loopback/review action for reworked orders."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Concurrency keyword explicitly triggers an AND branch."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "the Supplier sends a packing slip and an invoice."
      ],
      "justification": "Single joined clause describes both parallel supplier actions."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it."
      ],
      "justification": "Direct mapping to the packing slip recording step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Similarly, when the invoice is received, record it as well."
      ],
      "justification": "Direct mapping to the invoice recording step."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice,"
      ],
      "justification": "Completion of the two parallel recording tasks implies the flow convergence."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "release the reserved funds"
      ],
      "justification": "First post-convergence financial action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "and issue the payment to the supplier."
      ],
      "justification": "Second post-convergence financial action."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Closing sentence describes the final action and signals process termination."
    }
  ],
