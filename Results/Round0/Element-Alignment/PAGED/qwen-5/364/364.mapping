      "verbatim_texts": [
        "At the start, we receive a form."
      ],
      "justification": "Covers process initialization and the first two action steps derived from the opening clause."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "we check if it is complete"
      ],
