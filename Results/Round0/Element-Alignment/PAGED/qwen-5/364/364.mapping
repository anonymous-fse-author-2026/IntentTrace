    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If it needs to be sent back, the process ends."
      ],
      "justification": "The conditional introduces the XOR branch, and the outcome describes the ending action and termination point."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "if we need to check the income"
      ],
