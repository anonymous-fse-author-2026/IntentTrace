        "action:n1"
      ],
      "verbatim_texts": [
        "the process begins with a request to purchase a motorcycle."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial customer request action."
    },
    {
      "refs": [
        "action:n2",
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the request is received, the next step is to either continue the process if a production order is received or update the sales information and proceed to order dispatch."
      ],
      "justification": "This span covers the XOR decision point, the condition check modeled as an action step, and both resulting branches."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier."
      ],
      "justification": "Captures the material availability check, the exclusive branch, and the ordering action for unavailable materials."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier, the goods are issued and the motorcycles are produced."
      ],
      "justification": "Direct mapping to the material receipt and subsequent production steps."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "At the same time, the stock is updated and the motorcycles are dispatched."
      ],
      "justification": "The temporal phrase indicates concurrent paths rejoining (converge), followed by the stock update and dispatch actions."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After the goods are issued and the motorcycles are produced, the stock is updated and the process ends."
      ],
      "justification": "Describes the rejoining of flows after production, the final state update, and marks the process termination. The end state is correctly captured despite being modeled as both an action and an end node."
    }
  ],
