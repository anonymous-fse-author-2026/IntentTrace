      ],
      "verbatim_texts": [
        "the process begins with a request to purchase a motorcycle."
      ],
      "justification": "Implicit start node supported by the opening clause, paired with the first action step."
    },
    {
      "refs": [
        "action:n2",
        "action:n3",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the request is received, the next step is to either continue the process if a production order is received or update the sales information and proceed to order dispatch."
      ],
      "justification": "Covers the exclusive choice, the conditional trigger modeled as an action/state, and the two alternative path actions."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier."
      ],
      "justification": "Maps the conditional split, the material status check modeled as an action, and the supplier ordering step."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Alternatively, if there are available goods for production, a manufacturing order is placed."
      ],
      "justification": "Captures the alternative decision point, the availability condition modeled as an action, and the manufacturing order placement."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier, the goods are issued and the motorcycles are produced."
      ],
      "justification": "Structural branch handles flow control after receipt; actions match the supplier receipt trigger, goods issuance, and production steps."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "At the same time, the stock is updated and the motorcycles are dispatched."
      ],
      "justification": "Timing phrase justifies the AND gateway, followed by the concurrent stock update and dispatch actions."
    },
    {
      "refs": [
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "After the goods are issued and the motorcycles are produced, the stock is updated and the process ends."
      ],
      "justification": "Convergence node joins the prior paths; actions cover the second stock update, explicit termination step, and implicit process end."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, the stock is updated and the sales information is updated."
      ],
      "justification": "Concurrency marker supports the merge/join structure, and the action matches the sales information update."
    }
  ],
