{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "The opening phrase implicitly signals process initiation and directly describes the first registration action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If there is no fee,"
      ],
      "justification": "The conditional phrasing implies an explicit check step and establishes the XOR decision point that splits the workflow."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "you should proceed to register a post-seminar request."
      ],
      "justification": "Direct correspondence to the positive arm of the fee condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "you need to create a purchase request."
      ],
      "justification": "Direct correspondence to the negative arm of the fee condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Describes the terminal state condition for the no-fee branch, supporting both the descriptive action node and the structural end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Exact match for the subsequent verification step on the fee path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "The conditional introduces the second XOR split and its positive outcome action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Direct match for the negative outcome action of the approval check."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Direct match for the required follow-up action after approval."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Explicitly states process termination upon rejection. The converge node handles the implicit merging of divergent paths before final termination, while the action node captures the end-condition state and the structural node marks the process completion."
    }
  ],
