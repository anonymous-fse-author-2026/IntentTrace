      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Initialization and opening UI steps align with the source introduction."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "Action n4 restates the condition, branch captures the split, and action n5 matches the positive outcome."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "proceed to check if there is a need for translation."
      ],
      "justification": "Matches the step following the negative expense condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Branch and action correctly model the translation requirement."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "confirm the receipts."
      ],
      "justification": "Matches the alternative confirmation step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Directly matches the first evaluation instruction."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Branch, guard value, and action align perfectly with the rejection path."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Guard value and action match the approval path."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "translate the receipts and then confirm them."
      ],
      "justification": "Both actions correspond to the sequential steps described under the approval condition."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Direct match for the final evaluation step."
    },
    {
      "refs": [
        "guard:b5->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Branch, guard, and action match the acceptance path."
    },
    {
      "refs": [
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Guard and action match the rejection path."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Final steps and structural termination nodes align with the closing sentence."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "greater than 1000"
      ],
      "reason": "Guard content 'v1 = Yes' loses the explicit numeric threshold and operator from the source."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "less than or equal to 1000"
      ],
      "reason": "Guard content 'v1 = No' replaces the specific comparison and threshold with a generic boolean."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "translation is required"
      ],
      "reason": "Guard content 'v2 = Yes' substitutes the explicit condition with a generic affirmative."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "reason": "Guard content 'v2 = No' replaces the implicit negation condition with a generic boolean."
    },
    {
      "refs": [
        "guard:b4->n12",
        "guard:b4->n13"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision. If the report is rejected, edit the report. If it is approved, translate the receipts and then confirm them."
      ],
      "reason": "The model introduces a XOR branch with Yes/No guards that incorrectly splits translation and confirmation into mutually exclusive paths, omitting the preceding second review decision evaluation and misrepresenting the sequential approval steps."
    }
  ],
