      ],
      "verbatim_texts": [
        "The loan application process starts with receiving the loan application."
      ],
      "justification": "The opening sentence implicitly triggers the process start and explicitly describes the initial reception step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Simultaneously,"
      ],
      "justification": "The timing keyword signals concurrent execution, directly justifying the AND split."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "assessing the loan risk"
      ],
      "justification": "Direct match to the first parallel assessment task."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "checking the credit history."
      ],
      "justification": "Direct match to the second parallel assessment task."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After that,"
      ],
      "justification": "Temporal cue indicates the parallel paths rejoin (converge) and their completion is acknowledged before proceeding."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the eligibility of the applicant is assessed."
      ],
      "justification": "Exact paraphrase of the sequential eligibility evaluation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the applicant is eligible,"
      ],
      "justification": "Conditional clause opens the XOR decision; modeling the condition check as an action step is permitted and faithfully preserves the source meaning."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the acceptance pack is prepared."
      ],
      "justification": "Direct match to the positive-arm preparation step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the applicant is not eligible, the application is rejected."
      ],
      "justification": "Covers the negative conditional outcome and the corresponding rejection action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the application is rejected, the loan application process ends."
      ],
      "justification": "Describes the termination condition and the final state for the rejection path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the applicant is eligible, the acceptance pack is prepared."
      ],
      "justification": "Repetitive source clause restating the same preparation step; redundancy is acceptable and maps to the existing element."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "The prepared acceptance pack is then sent."
      ],
      "justification": "Direct match to the dispatch step following preparation."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the acceptance pack is sent, the process ends."
      ],
      "justification": "Describes the successful completion transition and process termination."
    }
