{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process, begin by supplying the requirement and then documenting it."
      ],
      "justification": "Covers the implicit start event, the explicit start action, and the first two sequential documentation steps."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the order is received via fax"
      ],
      "justification": "The fax condition is modeled as an action step feeding directly into the XOR decision node."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone, also input the order into an Excel file."
      ],
      "justification": "Guard captures the alternative routing condition; action captures the shared downstream input step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete after a week, send it to the student."
      ],
      "justification": "Direct paraphrase of the handoff step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list, type the orders into the MS-Access database."
      ],
      "justification": "Direct paraphrase of the data entry step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed."
      ],
      "justification": "Direct paraphrase of the completion verification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the database is completed, control the incoming order."
      ],
      "justification": "Direct paraphrase of the next sequential task."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "At the same time, continue to do the check."
      ],
      "justification": "Explicit concurrency marker triggers the AND split and the concurrent checking task."
    },
    {
      "refs": [
        "action:n11",
        "action:n12",
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "If the order is correct, release it."
      ],
      "justification": "Condition modeled as action feeds XOR branch; guard and action capture the positive outcome."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Send the Excel list to the student and upon receiving it, continue with the process."
      ],
      "justification": "Direct paraphrase of the intermediate routing step."
    },
    {
      "refs": [
        "guard:b2->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Guard captures negative condition; action captures the resulting communication task."
    },
    {
      "refs": [
        "action:n15",
        "action:n16",
        "guard:b3->n16"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac, release it."
      ],
      "justification": "Monetary condition modeled as action feeds XOR branch; guard and action capture the low-value release path."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "High-value path splits into sign-off and continued checking; n17/n18/n19 model the split logic and respective tasks."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
      ],
      "justification": "Parallel sign-off and check paths reconvene (c1/n20) before proceeding to agency contact."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Once the order is signed off, contact the client and release the order."
      ],
      "justification": "Direct paraphrase of the post-signoff sequence."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "Direct paraphrase of the production trigger."
    },
    {
      "refs": [
        "action:n24",
        "guard:b4->n25",
        "action:n25",
        "guard:b4->n27",
        "action:n27"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order. If the issue can be solved, release the order."
      ],
      "justification": "Solvability check modeled as action/branch pair; guards and actions accurately map to both cancellation and release outcomes."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "After PPC initiates production, the goods will be produced."
      ],
      "justification": "Direct paraphrase of the manufacturing step."
    },
    {
      "refs": [
        "action:n29",
        "guard:b5->n30",
        "action:n26",
        "action:n30"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends."
      ],
      "justification": "Cancellation check leads to termination; model contains redundant end nodes covering the single textual end point, which is acceptable."
    },
    {
      "refs": [
        "guard:b5->n31",
        "action:n31"
      ],
      "verbatim_texts": [
        "If not, check the quality of the goods."
      ],
      "justification": "Negative path continues to quality inspection."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "justification": "Direct paraphrase of reporting step."
    },
    {
      "refs": [
        "action:n33",
        "action:n34"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "justification": "Direct paraphrase of sequential memo distribution steps."
    },
    {
      "refs": [
        "action:n35",
        "action:n36"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "justification": "Invoice tracking path initiates at AND split; steps follow sequentially."
    },
    {
      "refs": [
        "action:n37",
        "action:n38"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods and sign and send the memo."
      ],
      "justification": "Concurrent commissioning path marked by explicit AND split."
    },
    {
      "refs": [
        "action:n39",
        "action:n40"
      ],
      "verbatim_texts": [
        "Also, send the goods and ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "Third concurrent logistics path marked by AND split."
    },
    {
      "refs": [
        "action:n41"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order."
      ],
      "justification": "Parallel invoice, commission, and shipment paths merge (c2/c3/c4) before the final archival step."
    },
    {
      "refs": [
        "action:n42"
      ],
      "verbatim_texts": [
        "This marks the end of the process."
      ],
      "justification": "Explicit closure statement mapped to final action and terminal end node."
    }
  ],
