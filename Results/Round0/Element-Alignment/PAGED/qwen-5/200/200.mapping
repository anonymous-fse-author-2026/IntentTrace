{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "The opening clause implicitly starts the process and describes the first two sequential actions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "The conditional opens the XOR decision and specifies the action for the negative path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Direct paraphrase of the positive eligibility path action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Maps the termination action and end node for the ineligible branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Open a new order in the ERP system and perform an availability check."
      ],
      "justification": "Direct match for the availability check step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\""
      ],
      "justification": "Implies the XOR decision gateway regarding product availability."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "Action triggered when the product is unavailable."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process. Prepare the products for shipment."
      ],
      "justification": "Both action nodes represent the shipment preparation step; redundancy is permitted and faithfully reflects the source."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "\"Simultaneously\" triggers parallel AND splits for concurrent execution; the three actions map directly to the listed steps."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Decision point for payment status, the closing action, and the associated end point."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Action for the negative payment outcome."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Action checks the reminder count, branch evaluates the threshold, and action executes the loop/continuation."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Action triggers upon threshold, followed by the final process end node."
    }
  ],
