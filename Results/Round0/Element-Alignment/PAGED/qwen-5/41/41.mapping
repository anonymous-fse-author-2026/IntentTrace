  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks, and then they should select the method for exit control checks."
      ],
      "justification": "The opening sentence implies process initiation, explicitly states starting, undergoing immigration checks, and selecting the exit control method."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics, they should undergo a check using biometrics."
      ],
      "justification": "Captures the decision split for biometrics and the corresponding biometric check action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the passenger prefers to use ID documents, they should undergo checks using identity documents."
      ],
      "justification": "Directly maps to the alternative path for using identity documents."
    },
    {
      "refs": [
        "action:n6",
        "action:n7",
        "action:n8",
        "action:n10"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission, they should leave the area."
      ],
      "justification": "Models the permission-denied condition, the XOR branch, and the redundant 'leave the area' actions."
    },
    {
      "refs": [
        "action:n9",
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Maps to the permission-granted path and the action of proceeding forward."
    },
    {
      "refs": [
        "action:n12",
        "action:n13",
        "action:n14",
        "action:n16",
        "action:n18",
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends."
      ],
      "justification": "Covers the unsuccessful outcome condition, branching logic, leaving the area, and multiple redundant termination actions and end nodes."
    },
    {
      "refs": [
        "action:n15",
        "action:n17",
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Captures the successful outcome, continuing the process, and the redundant finalization nodes and actions."
    }
  ],
