  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process, make sure the Freights are ready to be shipped and then ship the freight."
      ],
      "justification": "The opening sentence implicitly initiates the process and describes the first three sequential actions."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: deliver the freight and notify the delivery."
      ],
      "justification": "The concurrency indicator justifies the AND branch splitting into the two parallel delivery and notification tasks."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->n7",
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the request for merchandise return is lodged"
      ],
      "justification": "The conditional clause triggers the XOR decision point and its guards modeling the lodged versus non-lodged states."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the return is accepted, proceed with accepting the merchandise return. If the return is rejected, reject the merchandise return."
      ],
      "justification": "Directly maps to the outcomes for accepted and rejected return requests."
    },
    {
      "refs": [
        "label:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it has been 5 days, invoice the customer. Invoice the customer and the process ends with the customer being invoiced."
      ],
      "justification": "Captures the time-based condition, the corresponding action, label, and the termination of that path."
    },
    {
      "refs": [
        "label:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If a loss claim report is lodged, approve the loss claim and the process ends."
      ],
      "justification": "Maps the loss claim condition, gating label, approval action, and process termination."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Accept the merchandise return and proceed with returning the merchandise. Return the merchandise and the process ends with the merchandise being returned."
      ],
      "justification": "Describes the procedural step following acceptance and the final state for the returned merchandise."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Reject the merchandise return and the process ends with the merchandise return request being rejected."
      ],
      "justification": "Matches the terminal state described for rejected return requests."
    }
  ],
