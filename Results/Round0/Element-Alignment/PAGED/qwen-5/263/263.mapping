      "verbatim_texts": [
        "The process starts with an informational meeting"
      ],
      "justification": "The opening phrase implicitly triggers the init node, and the generic 'Start' action redundantly restates the beginning of the workflow."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the meeting is successful, the next step is to work on the storyboard, which takes a full day"
      ],
      "justification": "Captures the conditional check modeled as an action, the corresponding XOR split, and the storyboard step with its correct duration."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "if the meeting is not successful, the process ends."
      ],
      "justification": "Directly maps the negative meeting outcome to the end-process action and the structural end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "and preparing the content."
      ],
      "justification": "The conjunction implies a parallel/inclusive split (AND gateway) leading to the content preparation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After that, the site development"
      ],
      "justification": "The transition to site development implies that prior parallel tasks must converge first."
    },
