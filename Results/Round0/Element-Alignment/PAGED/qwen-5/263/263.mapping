      ],
      "verbatim_texts": [
        "If the rebuild is complete"
      ],
      "justification": "Models the completion check as an action step; core meaning aligns with the source condition."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Maps the successful rebuild outcome to process termination."
    },
    {
