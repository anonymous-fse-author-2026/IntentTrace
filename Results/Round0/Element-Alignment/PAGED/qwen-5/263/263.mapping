      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the review is successful, it moves on to the approval stage, which takes half a day."
      ],
      "justification": "Maps the success condition check, the XOR branch, and the approval step with the correct duration."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If the approval is complete, the process ends."
      ],
      "justification": "Directly maps the positive approval outcome to the termination action and end node."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
      ],
      "justification": "Exact match for the rejection path and the rebuild duration."
