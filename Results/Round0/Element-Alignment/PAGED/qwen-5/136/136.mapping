      ],
      "justification": "Directly describes the termination step and implicitly supports the structural end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "perform an availability check."
      ],
      "justification": "Exact match for the availability verification step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\". If it is not, start producing the missing parts."
      ],
