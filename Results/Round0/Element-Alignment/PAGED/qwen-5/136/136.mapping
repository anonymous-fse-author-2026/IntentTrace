      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them. Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "The conditional defines the XOR split and explicitly names the action for each branch."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
