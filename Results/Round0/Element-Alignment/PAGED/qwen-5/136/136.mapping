        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order. If the payment is not received, send a reminder."
      ],
      "justification": "Defines the payment status decision branch and the two corresponding outcome actions."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "ending the process."
      ],
      "justification": "Explicitly marks the conclusion of this specific payment-handling path."
    },
    {
      "refs": [
