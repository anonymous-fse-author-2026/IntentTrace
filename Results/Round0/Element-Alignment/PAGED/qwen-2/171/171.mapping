      "justification": "The guard captures the positive condition ('approved' mapped to 'Yes'), and the action captures the payout step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "checks again if the request is approved or not."
      ],
      "justification": "Explicitly describes a second approval decision point, supporting the second branch and its associated condition-action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not approved, the process goes back to entering expenses."
      ],
      "justification": "Matches the second negative path condition and loop-back action."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "if it is approved, the expenses can be paid out."
      ],
      "justification": "Matches the second positive path condition and payout action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "after the expenses are paid out, the process comes to an end."
