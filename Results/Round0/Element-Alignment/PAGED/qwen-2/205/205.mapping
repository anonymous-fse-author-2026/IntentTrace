      ],
      "verbatim_texts": [
        "To initiate the process for ACME Company, the Resupply Cycle is triggered"
      ],
      "justification": "Implicitly starts the process and describes triggering the cycle. 'start' is redundant but aligns with the initiation concept per redundancy rules."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level"
      ],
      "justification": "Direct paraphrase of the inventory check step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the Inventory is greater than the Minimum Level"
      ],
      "justification": "Conditional clause implies an XOR branch decision point."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, a Purchase Order is created."
      ],
      "justification": "Matches the alternative path action when the condition is false."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "The Purchase Order is then reviewed."
      ],
      "justification": "Direct match to the review step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected",
        "However, if the Purchase Order is accepted"
      ],
      "justification": "Both conditional phrases trigger the same XOR decision point."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "it is reworked."
      ],
      "justification": "Direct match to the rejection outcome action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "funds are reserved for payment."
      ],
      "justification": "Direct match to the acceptance outcome action."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "In case the Purchase Order is rejected, it is reworked. On the other hand, if the Purchase Order is accepted, funds are reserved for payment."
      ],
      "justification": "Verbatim repetition in the source redundantly supports the same branch and actions. Treated as match per redundancy rule."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reserving funds for payment, the Purchase Order is sent to the Supplier."
      ],
      "justification": "Direct match to the dispatch step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed:"
      ],
      "justification": "'Simultaneously' explicitly signals parallel execution, implying an AND branch."
    },
    {
      "refs": [
        "action:n9",
        "action:n11"
      ],
      "verbatim_texts": [
        "the Packing Slip is received and the Invoice is received."
      ],
      "justification": "Lists the two concurrent receipt actions spawned by the AND branch."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Upon receiving the Packing Slip, it is recorded."
      ],
      "justification": "Direct match to the packing slip recording step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Similarly, upon receiving the Invoice, it is recorded."
      ],
      "justification": "Direct match to the invoice recording step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the funds are released for payment,"
      ],
      "justification": "Direct match to the fund release step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "the payment is issued to the Supplier."
      ],
      "justification": "Direct match to the payment issuance step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, the process ends with the issuance of payment to the Supplier."
      ],
      "justification": "Explicitly states the final action and process termination, supporting both the end action and structural end node."
    }
