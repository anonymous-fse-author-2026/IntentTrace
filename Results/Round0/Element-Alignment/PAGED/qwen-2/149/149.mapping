        "action:n4"
      ],
      "verbatim_texts": [
        "the next step is to either continue the process if a production order is received or update the sales information and proceed to order dispatch."
      ],
      "justification": "Captures the conditional check (modeled as an action step), the XOR gateway, and both resulting paths. Paraphrasing preserves exact logic and targets."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier."
      ],
      "justification": "Maps the material availability verification, the subsequent decision split, and the ordering action triggered when materials are unavailable."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier, the goods are issued and the motorcycles are produced."
      ],
      "justification": "Directly matches the material receipt step and the combined issuance-and-production step."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "At the same time, the stock is updated and the motorcycles are dispatched."
      ],
      "justification": "Captures the concurrent execution of stock updating and motorcycle dispatching, aligned with the temporal marker 'At the same time'."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Directly corresponds to the explicit termination of the workflow described in the closing sequence."
    }
