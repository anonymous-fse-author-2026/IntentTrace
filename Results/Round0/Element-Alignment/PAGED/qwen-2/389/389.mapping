    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the test is not green, they should upgrade the test level."
      ],
      "justification": "Direct match for the alternative path action."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "After that, they need to check if the level satisfies the project requirements again."
      ],
      "justification": "Both actions cover the repeated requirement check step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If it does, the process ends."
      ],
      "justification": "Second positive outcome branch leading to termination."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If not, they should upgrade the test level once more."
      ],
      "justification": "Direct match for the final fallback action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If not, they should upgrade the test level once more."
      ],
      "justification": "Implied process conclusion following the final step, matching the textual endpoint."
