    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Direct mapping to the main workflow continuation."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
