  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, go to the Amazon homepage."
      ],
      "justification": "The initial sentence implies the start and the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "search for a book."
      ],
      "justification": "Direct paraphrase of searching for a book."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "click on the link that says \"22 used\" to see the used books available."
      ],
      "justification": "Direct paraphrase of clicking the used books link."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "click on the \"Add to Cart\" button for the second book on the list."
      ],
      "justification": "Direct paraphrase of adding the second book to the cart."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "click on the \"Proceed to Checkout\" button."
      ],
      "justification": "Direct paraphrase of proceeding to checkout."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "enter your email address and select the option that says \"I am a new customer\"."
      ],
      "justification": "Direct paraphrase of entering email and selecting new customer."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "click on the \"Sign in using our secure server\" button."
      ],
      "justification": "Direct paraphrase of signing in."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "enter your customer details and click on the \"Create account\" button."
      ],
      "justification": "Direct paraphrase of entering details and creating account."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "enter your shipping details and click on the \"Continue\" button."
      ],
      "justification": "Direct paraphrase of entering shipping details."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "select your preferred shipping options and click on \"Continue\" again."
      ],
      "justification": "Direct paraphrase of selecting shipping options."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "choose your payment method and enter your credit card details."
      ],
      "justification": "Direct paraphrase of entering payment method and details."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Click on the \"Add your card\" button to save your card information."
      ],
      "justification": "Direct paraphrase of adding card."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "click on \"Continue\" to proceed."
      ],
      "justification": "Direct paraphrase of continuing."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "choose your billing address and select the option to use the address you've chosen."
      ],
      "justification": "Direct paraphrase of choosing billing address."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, click on \"Place your order in AUD\" to complete the process."
      ],
      "justification": "Direct paraphrase of placing order and completing the process."
    }
