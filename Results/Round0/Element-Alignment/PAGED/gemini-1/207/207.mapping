{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, for CAB, the first step is to assess the change request."
      ],
      "justification": "Matches the start of the process and the initial assessment action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the affected systems for any impacts on the business unit"
      ],
      "justification": "Direct paraphrase of checking affected systems."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "determine whether the change request should be approved or not"
      ],
      "justification": "The determination implies the XOR branch and the action itself."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the change request should be approved in its current state"
      ],
      "justification": "Condition for the positive approval branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then it is approved"
      ],
      "justification": "Action reflecting current-state approval."
    },
    {
      "refs": [
        "action:n6",
        "guard:b4->n21",
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the change request is ultimately approved, the change is implemented."
      ],
      "justification": "Captures the ultimate approval condition, determination, and implementation actions reused across the branches."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "if the change request should not be approved in its current state"
      ],
      "justification": "Condition for requiring further evaluation."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "further evaluation is needed to determine if the change will be acceptable with more information provided."
      ],
      "justification": "Captures the further evaluation step and the implied subsequent branch."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9",
        "guard:b4->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "if the change is deemed unacceptable, it is rejected"
      ],
      "justification": "Captures the unacceptability condition and corresponding rejection actions mapped across the diagram."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "In this case, a request for more information is made to the Change Coordinator."
      ],
      "justification": "The alternative to rejection is needing more info; condition and action match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "followed by an email enquiry to the Change Coordinator"
      ],
      "justification": "Direct action mapping."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the approval register is updated within a timeframe of 3 business days"
      ],
      "justification": "Direct action mapping."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The email enquiry is also forwarded to the Change Requester."
      ],
      "justification": "Direct action mapping."
    },
    {
      "refs": [
        "action:n15",
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If there are no further inquiries or issues"
      ],
      "justification": "Captures the conditional check, the XOR gateway, the guard, and the modeled state action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "the process concludes after 3 business days"
      ],
      "justification": "Text explicitely defines an ending step, justifying the action and the end node."
    },
    {
      "refs": [
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "if there are inquiries from the CAB"
      ],
      "justification": "Condition for the inquiry path."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "a response is expected within 1-3 business days"
      ],
      "justification": "Direct action mapping."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the response is received from the requester, it is forwarded to the CAB for further evaluation."
      ],
      "justification": "Direct action mapping."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Based on the response, a final determination is made regarding the approval of the change request."
      ],
      "justification": "Action capturing the final determination and implying the decision point."
    }
  ],
