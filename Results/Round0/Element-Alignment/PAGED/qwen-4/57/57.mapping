      ],
      "justification": "Direct match to the post-cart action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "continue with the process"
      ],
      "justification": "Matches the instruction following the 'Continue Shopping' selection."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "enter their address, shipping method, and payment information."
      ],
      "justification": "Exact alignment with the checkout data entry step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "authorize the credit card and check the inventory levels."
      ],
      "justification": "Direct match to the concurrent validation tasks."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the credit card is approved and there is inventory in stock, they can continue with the process."
      ],
      "justification": "These elements collectively model the positive outcome evaluation and continuation path described in the source."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "In either case, the order confirmation number should be displayed, followed by the final order being shown to the customer."
      ],
      "justification": "Direct match to displaying the confirmation number and presenting the final order."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Additionally, the order should be confirmed and a confirmation notice should be emailed to the customer."
      ],
      "justification": "Exact alignment with the final confirmation and notification steps."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once the order entry is complete, the process will end."
      ],
      "justification": "Captures the completion trigger and the explicit process termination."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "the transaction will end."
      ],
      "justification": "Matches the explicit termination condition for the negative outcome path."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if the credit card is denied or there is no inventory in stock,"
      ],
      "justification": "Captures the negative condition scenario leading to transaction end."
    }
