    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "make a purchase and then connect to the website."
      ],
      "justification": "Direct paraphrase of the initial required steps."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, they should search for an item."
      ],
      "justification": "Exact match to the searching step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If they choose to \"Add item to cart\"",
