{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "Captures process initialization and the two sequential ordering steps described in the opening clause."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
      ],
      "justification": "Models the XOR branch triggered by the credit allowance condition, with the condition itself captured as an action node and the subsequent delivery processing step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance."
      ],
      "justification": "Captures the resulting state/action when the credit limit is exceeded on the negative branch path."
    },
    {
      "refs": [
        "action:n7",
        "action:n12"
      ],
      "verbatim_texts": [
        "In the case of an Outstanding Balance, a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "Maps to placing a replacement order and the explicit process termination point at the warehouse."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If a new order is placed, it will be recorded in the Accounts Receivable."
      ],
      "justification": "Directly corresponds to the accounting recording step following the new order placement."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "If Payments are Received, the process continues."
      ],
      "justification": "Captures the payment condition branch and the workflow continuation path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "However, if no payments are received, the order is dropped."
      ],
      "justification": "Corresponds to the fallback action when payments are absent."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Next, identify the order for installation."
      ],
      "justification": "Direct mapping to the installation identification step."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled, an Installer will be assigned."
      ],
      "justification": "Models the scheduling condition branch and the installer assignment action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "On the other hand, if the order does not require installation, it will be packed for delivery."
      ],
      "justification": "Captures the alternative path for orders not requiring installation."
    }
  ],
