{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For MyCorp, the process begins"
      ],
      "justification": "Covers the implicit process start and the contextual initialization action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "by entering expenses"
      ],
      "justification": "Directly matches the first expense entry step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After entering expenses, the next step is to generate a spreadsheet."
      ],
      "justification": "Faithfully restates the transitional instruction and the spreadsheet generation action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the spreadsheet is generated, the request can be approved or disapproved."
      ],
      "justification": "Describes the conditional check (modeled as an action node) and implies the XOR decision split."
    },
    {
      "refs": [
        "label:n3->n4",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the request is not approved, the process goes back to entering expenses."
      ],
      "justification": "Maps the negative outcome label and the loop-back action to re-enter expenses."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the request is approved, the expenses can be paid out."
      ],
      "justification": "Matches the positive outcome action following initial approval."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Captures the repeated verification step and its associated decision point."
    },
    {
      "refs": [
        "label:n5->n7",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is not approved, the process goes back to entering expenses."
      ],
      "justification": "Maps the second negative outcome label and the subsequent loop-back action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "But if it is approved, the expenses can be paid out."
      ],
      "justification": "Matches the second positive outcome action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Finally, after the expenses are paid out, the process comes to an end."
      ],
      "justification": "Covers the final termination action and the implicit process end node."
    }
  ],
