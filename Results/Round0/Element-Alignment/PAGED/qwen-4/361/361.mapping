{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial trigger step; 'start' and 'trigger: resupply cycle' directly paraphrase it."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the current inventory level."
      ],
      "justification": "Direct paraphrase of the inventory check step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the inventory level is above the minimum",
        "if the inventory level is below the minimum"
      ],
      "justification": "Captures the two alternative conditions driving the XOR decision point."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process ends."
      ],
      "justification": "Both the action describing the termination path and the structural end node are justified by the clause indicating process completion when above the minimum."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "create a purchase order."
      ],
      "justification": "Direct match to the action taken when inventory is below the minimum."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "review it."
      ],
      "justification": "Direct match to the post-creation review step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected",
        "if the purchase order is accepted"
      ],
      "justification": "Captures the acceptance/rejection conditions driving the second XOR decision point."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "rework the purchase order."
      ],
      "justification": "Direct match to the rework step upon rejection."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "review it again."
      ],
      "justification": "Direct match to the secondary review after rework."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps:"
      ],
      "justification": "Temporal and instructional cue justifies the split into concurrent sub-tasks."
    },
    {
      "refs": [
        "action:n9",
        "action:n12"
      ],
      "verbatim_texts": [
        "reserve funds for the purchase and send the purchase order to the supplier."
      ],
      "justification": "Both elements cover the funding and supplier dispatch tasks described in the same clause; redundancy is permissible."
    },
    {
      "refs": [
        "action:n10",
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, release the reserved funds"
      ],
      "justification": "Both elements faithfully restate the trigger condition and subsequent fund release step."
    },
    {
      "refs": [
        "action:n11",
        "action:n14"
      ],
      "verbatim_texts": [
        "and then the process ends."
      ],
      "justification": "The closing clause justifies both the descriptive end-action nodes and the structural end terminals."
    }
  ],
