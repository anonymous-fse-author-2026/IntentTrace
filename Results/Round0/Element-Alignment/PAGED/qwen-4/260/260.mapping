{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "The opening clause establishes the process initiation (including the redundant start action) and the first operational step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After receiving the invoice, it is sorted per client."
      ],
      "justification": "Directly maps to the client sorting step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once sorted per client, it is then sorted per vendor."
      ],
      "justification": "Directly maps to the vendor sorting step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "The next step is to attach the invoice entry form to the invoice."
      ],
      "justification": "Exact correspondence to the attachment step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After attaching the form, the required information is entered onto the form."
      ],
      "justification": "Exact correspondence to data entry."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Following that, the completeness of the invoice is checked."
      ],
      "justification": "Exact correspondence to the completeness check."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the invoice is not complete",
        "If it is complete"
      ],
      "justification": "Models the XOR decision point based on invoice completeness."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Captures the termination path for incomplete invoices."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered. The date for completion is also entered"
      ],
      "justification": "Combines entering SLA information and the completion date."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "and the priority is checked."
      ],
      "justification": "Maps to the priority verification step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the priority is high",
        "If it is low"
      ],
      "justification": "Models the XOR decision point on priority level."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "a red stamp is placed on the entry invoice."
      ],
      "justification": "Action triggered by high priority."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Maps to the compliance verification step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If it is not complete",
        "If it is complete"
      ],
      "justification": "Models the decision point regarding compliance status."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Handles routing to experienced staff."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Handles the normal case routing."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Covers the fallback mailing action and its associated process termination."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO"
      ],
      "justification": "Maps to the final batching and allocation step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Marks the conclusion of the successful processing path."
    }
  ],
