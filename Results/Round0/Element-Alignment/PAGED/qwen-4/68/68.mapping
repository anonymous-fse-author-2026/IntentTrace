{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "The opening clause implicitly starts the process (init) and the action element explicitly restates the initiation."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Rental Items are Returned to the Store."
      ],
      "justification": "Action content paraphrases the initial return step while preserving the core meaning."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "However, if the \"Delivery Crew picks-up items at the event site,\""
      ],
      "justification": "Branch captures the split in return methods; guard extracts the delivery crew condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct match for the inventory verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\""
      ],
      "justification": "Action denotes evaluating order status; branch models the resulting decision point."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "Order is complete and all items were returned"
      ],
      "justification": "Guard condenses the positive completion condition without altering logic."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "Order is incomplete and items are missing"
      ],
      "justification": "Guard correctly isolates the missing items condition."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "Order is complete but items are damaged"
      ],
      "justification": "Guard accurately captures the damage condition on the third branch arm."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\""
      ],
      "justification": "Action represents the disposition decision; branch splits the subsequent paths."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "Items are stored for future orders"
      ],
      "justification": "Guard isolates the storage alternative condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Exact alignment with the notification step for missing inventory."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "Action tracks the follow-up return; branch splits based on customer action."
    },
    {
      "refs": [
        "guard:b4->n8"
      ],
      "verbatim_texts": [
        "Customer does not return the missing items"
      ],
      "justification": "Guard correctly specifies the negative path condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Action and end node both correspond to the first explicit termination point."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Direct match for the damage notification instruction."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Exact match for the temporary inventory removal step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\""
      ],
      "justification": "Action denotes repair assessment; branch models the subsequent decision."
    },
    {
      "refs": [
        "guard:b5->n12"
      ],
      "verbatim_texts": [
        "Items are repaired and added into inventory"
      ],
      "justification": "Guard captures the successful repair outcome."
    },
    {
      "refs": [
        "guard:b5->n13"
      ],
      "verbatim_texts": [
        "Items can't be repaired and are discarded"
      ],
      "justification": "Guard accurately reflects the discard condition."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "\"Items are repaired and added into inventory,\""
      ],
      "justification": "Action restates the repair and restock procedure."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "\"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Action combines the discard step and associated customer billing as described."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order."
      ],
      "justification": "Action covers final disposition routing; branch splits the last paths."
    },
    {
      "refs": [
        "guard:b6->n16"
      ],
      "verbatim_texts": [
        "Items are stored for future orders"
      ],
      "justification": "Guard isolates the final storage alternative."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Action and end node align with the second stated completion."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges, and the process is complete."
      ],
      "justification": "Converge implies paths rejoining before finalization; action and end node match the closing email and termination."
    }
  ],
