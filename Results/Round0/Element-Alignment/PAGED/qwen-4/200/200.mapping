{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To begin the process,"
      ],
      "justification": "Implicit start node directly aligned with the introductory temporal phrase."
    },
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "start by placing an order"
      ],
      "justification": "Core meaning preserved despite slight abstraction in the element label; faithful to the initial instruction."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check the customer."
      ],
      "justification": "Exact match for the first verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "The conditional clause simultaneously justifies the XOR split and the immediate notification action on that arm."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Termination action and end node jointly grounded in this concluding clause for the ineligible path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Directly matches the positive eligibility branch action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "and perform an availability check."
      ],
      "justification": "Exact alignment with the inventory verification instruction."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\"."
      ],
      "justification": "Models the decision point governing product stock levels."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "Faithfully captures the fallback manufacturing step triggered by unavailability."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Both nodes redundantly restate the same source instruction; redundancy is acceptable and neither alters behavior."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "ship the products and send the invoice while checking for payment."
      ],
      "justification": "Maps to the three concurrent subtasks; duplicated check nodes preserve the source wording without changing logic."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Payment-success condition, order closure action, and path endpoint all derive from this positive outcome span."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Direct match for the negative payment outcome action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3,"
      ],
      "justification": "The threshold evaluation and its controlling XOR gateway are both anchored to this conditional phrase."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Exact paraphrase of the loop-back instruction."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "inform the lawyer and end the process."
      ],
      "justification": "Escalation action and final termination node share this concluding clause."
    }
  ],
