  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "The opening clause explicitly starts the process (init) and describes the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed with the Registration gross pathology request."
      ],
      "justification": "Direct match for the registration step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "make sure to create a barcode scan at the start."
      ],
      "justification": "Captures the scanning requirement specified during registration."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "assign a container to the gross pathology request."
      ],
      "justification": "Direct match for the container assignment step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "move on to the Specimen description."
      ],
      "justification": "Direct match for the specimen description step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "pay attention to the scan start."
      ],
      "justification": "Maps to the first scan attention step within specimen description."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "pay attention to the scan end."
      ],
      "justification": "Maps to the second scan attention step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Exact match for the repeated scan start step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "proceed with Macroscopic description writing.",
        "Simultaneously, complete the following steps:"
      ],
      "justification": "The text describes macroscopic writing alongside a simultaneous split (AND gateway) for subsequent tasks."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Tissue processing,"
      ],
      "justification": "Direct match for the tissue processing task."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required."
      ],
      "justification": "The check implies a decision point (XOR branch) leading to conditional outcomes."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process."
      ],
      "justification": "Direct match for the negative branch outcome."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Direct match for the positive branch outcome."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required again."
      ],
      "justification": "The repeated check implies a second decision point (XOR branch)."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process."
      ],
      "justification": "Direct match for the second negative branch outcome."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Direct match for the second positive branch outcome."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "assign cases to the pathologist"
      ],
      "justification": "Direct match for case assignment."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Microscopic examination and diagnosis"
      ],
      "justification": "Direct match for the examination step."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "write the pathology report"
      ],
      "justification": "Direct match for report writing."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "confirm it"
      ],
      "justification": "Direct match for report confirmation."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "deliver it"
      ],
      "justification": "Direct match for report delivery."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "proceed with the post-report processing"
      ],
      "justification": "Direct match for post-report processing."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "close it"
      ],
      "justification": "Direct match for closing the procedure."
    },
    {
