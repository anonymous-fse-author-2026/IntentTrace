      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "Implicit process start combined with the two initial sequential steps."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n5",
        "action:n4"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty, if not, continue the process. If it is empty, the process ends."
      ],
      "justification": "Covers the check action, the XOR decision, both outcome guards, the termination action, and the structural end node."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Direct paraphrase of the verification step."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Maps the XOR branch, the positive guard, and the resulting recording action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Maps the negative guard and the corresponding telephone call action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Exact match for the post-call data completion step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Direct match including timing and destination."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Condition modeled as an action step alongside the branch, guard, and stamp action, all faithfully restating the source."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Maps the negative guard and the corresponding notification action."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Termination action and structural end node for the rejection path."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Direct match for the data writing step following the stamping action."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles. Ask Charles to write the amount in the register."
      ],
      "justification": "'Simultaneously' triggers the AND branch; subsequent sentences describe the parallel calculation and handoff/instruction steps."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Direct match for printing and sending the membership card."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Termination action and structural end node for the successful membership path."
