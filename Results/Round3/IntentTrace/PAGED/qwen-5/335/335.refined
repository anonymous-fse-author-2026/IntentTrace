init(i1)
action(n1, "start Purchase Order-to-Delivery phase")
action(n2, "formally review the purchase invoice and ensure its accuracy")
branch(b1, XOR)
converge(c1)
action(n4, "approve the purchase invoice")
action(n5, "continue with the process")
action(n6, "trigger payment")
action(n7, "process ends")
end(e1)
defines(v1, "invoice amount", {[-]})
actor(a_default, "Default", [i1, n1, n2, b1, c1, n4, n5, n6, n7, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, c1)
precedence(n5, c1)
precedence(c1, n6)
precedence(n6, n7)
precedence(n7, e1)
guard(b1, n4, v1 > 5000)
guard(b1, n5, v1 <= 5000)