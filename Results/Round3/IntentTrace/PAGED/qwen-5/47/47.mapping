{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Captures the process initiation and the first two sequential actions described in the opening unit."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Models the completeness check and the negative path. Guard 'No' correctly corresponds to an incomplete invoice triggering a return."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Captures the positive completeness path leading to the next evaluation stage."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Opens the compliance decision and routes to the appropriate further checks action on a 'No' outcome."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Captures the compliant positive path allowing the process to proceed."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Models the resolution feasibility check and the successful phone resolution path."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Handles the alternative case where phone resolution fails ('No'), correctly routing to returning the invoice."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved.",
        "If the invoice is returned, non-compliance is resolved."
      ],
      "justification": "Converges previous branches, executes payment, and handles the returned-invoice sub-path to resolve non-compliance. Redundant source units are safely grouped."
    },
    {
      "refs": [
        "guard:b8->n19"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved.",
        "If the invoice is returned, non-compliance is resolved."
      ],
      "justification": "Converges previous branches, executes payment, and handles the returned-invoice sub-path to resolve non-compliance. Redundant source units are safely grouped."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved.",
        "If the invoice is returned, non-compliance is resolved."
      ],
      "justification": "Converges previous branches, executes payment, and handles the returned-invoice sub-path to resolve non-compliance. Redundant source units are safely grouped."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Directly implements the parallel billing step."
    },
    {
      "refs": [
        "action:n21",
        "guard:b8->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Checks for client response, and on 'None' (no response), correctly triggers the 10-day waiting period."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Implements the client notification step. Payment is already covered structurally earlier; repetition is harmless."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Models the post-wait reminder action and correctly terminates the process flow."
    },
    {
      "refs": [
        "action:n27",
        "guard:b9->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Evaluates client satisfaction and routes to discrepancy resolution on a negative outcome."
    },
    {
      "refs": [
        "guard:b9->n29",
        "action:n29"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Captures the positive satisfaction path allowing continued processing."
    }
  ],
