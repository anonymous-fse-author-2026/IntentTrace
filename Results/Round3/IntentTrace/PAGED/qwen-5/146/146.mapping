  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, the customer makes an enquiry."
      ],
      "justification": "Captures the process initiation and the first substantive step. The generic 'start' action is harmless structural redundancy that preserves behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, we check if the article is in stock."
      ],
      "justification": "Models the stock verification action and the implicit XOR split that determines subsequent flow."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the article is available, we continue with the process."
      ],
      "justification": "Accurately represents the positive condition that allows the process to proceed to the next steps."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the article is not available, we abort the enquiry and end the process."
      ],
      "justification": "Captures the negative condition, the abort action, and the terminal event for this branch."
    },
    {
      "refs": [
        "action:n5",
        "action:n6",
        "label:n5->n6"
      ],
      "verbatim_texts": [
        "First, we reserve the article, and once it is reserved, we calculate the price."
      ],
      "justification": "Sequentially models reservation and price calculation. The connection label reflects the state transition implied by 'once it is reserved'."
    },
    {
      "refs": [
        "label:n6->n7",
        "action:n7",
        "action:n8",
        "label:n7->n8"
      ],
      "verbatim_texts": [
        "After that, we send the offer, and once the offer is sent, we wait for the customer to accept it."
      ],
      "justification": "Models sending the offer and waiting for acceptance. Connection labels represent the completion states of preceding steps, acting as harmless structural plumbing that preserves flow."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the customer accepts the offer, we dispatch the article."
      ],
      "justification": "Directly corresponds to the dispatch step triggered by customer acceptance."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Finally, once the article is dispatched, the process comes to an end."
      ],
      "justification": "Captures the concluding step and the final process termination."
    }
  ],
