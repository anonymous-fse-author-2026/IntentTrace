{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n3"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Covers process initiation and the first two sequential steps."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Models the decision on completeness and the return action for the incomplete case."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if the invoice is complete"
      ],
      "justification": "Captures the positive branch condition for invoice completeness."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "further checks are conducted"
      ],
      "justification": "Represents the compliance verification step and introduces the subsequent decision gateway."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Matches the phone resolution condition and action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Matches the mail-back condition and return action."
    },
    {
      "refs": [
        "guard:b2->c1",
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Converges the compliance branches into the payment and conditional resolution step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Bill Client."
      ],
      "justification": "Directly models the client billing step."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Captures the response check and the waiting period for the no-response case."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Models the alternative (response) branch leading to payment and notification."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Matches the reminder action and explicit process termination."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Captures the satisfaction check and discrepancy resolution for the negative case."
    },
    {
      "refs": [
        "guard:b4->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Matches the positive satisfaction outcome, continuation action, and terminal nodes for the branch."
    }
  ],
