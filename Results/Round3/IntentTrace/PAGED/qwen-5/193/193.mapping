{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "Establishes the process start and captures the initial arrival/action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed with the Registration gross pathology request."
      ],
      "justification": "Direct paraphrase of the registration step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "make sure to create a barcode scan at the start."
      ],
      "justification": "Captures the barcode creation requirement, contextualized within the registration phase."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "assign a container to the gross pathology request."
      ],
      "justification": "Direct match for container assignment."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "move on to the Specimen description."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "pay attention to the scan start."
      ],
      "justification": "Preserves the first scan checkpoint."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "pay attention to the scan end."
      ],
      "justification": "Preserves the second scan checkpoint."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Direct match for the continued registration scan."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "proceed with Macroscopic description writing."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Tissue processing,"
      ],
      "justification": "Models the explicit simultaneity using an AND gateway alongside the tissue processing step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required."
      ],
      "justification": "Triggers the first XOR decision point."
    },
    {
      "refs": [
        "guard:b1->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process."
      ],
      "justification": "Correctly models the negative branch condition and outcome."
    },
    {
      "refs": [
        "guard:b1->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Correctly models the positive branch condition and outcome."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Next, check if \"Digitalization?\" is required again."
      ],
      "justification": "Triggers the second XOR decision point."
    },
    {
      "refs": [
        "guard:b2->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process."
      ],
      "justification": "Applies the same negative branch logic to the second check."
    },
    {
      "refs": [
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Applies the same positive branch logic to the second check."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "assign cases to the pathologist and then move on to Microscopic examination and diagnosis."
      ],
      "justification": "Splits the compound sequential instruction into two distinct actions without changing order or behaviour."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "write the pathology report."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "confirm it."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "deliver it."
      ],
      "justification": "Matches the first delivery instruction."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "proceed with the post-report processing."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "To conclude the pathology procedure, close it."
      ],
      "justification": "Direct match for the closure step."
    },
    {
      "refs": [
        "action:n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, deliver the pathology report and complete the post-report processing."
      ],
      "justification": "Splits the final compound closing instruction into two actions and correctly places the process endpoint."
    }
  ],
