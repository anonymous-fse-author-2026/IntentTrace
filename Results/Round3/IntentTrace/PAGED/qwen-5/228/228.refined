init(i1)
action(n1, "start the procedure")
branch(b1, XOR)
action(n2, "can capture data from FMA")
action(n4, "can capture data from Jamendo")
converge(c1)
action(n7, "get music ids for the genre")
action(n8, "is genre missing")
action(n10, "are there additional genres")
action(n13, "is sample missing")
action(n15, "download the sample")
action(n17, "if there are no additional samples, the process ends")
end(e2)
defines(v1, "can capture data from FMA", {true, false})
defines(v2, "can capture data from Jamendo", {true, false})
defines(v3, "is genre missing", {true, false})
defines(v4, "are there additional genres", {true, false})
defines(v5, "is sample missing", {true, false})
defines(v6, "are there additional samples", {true, false})
actor(a_default, "Default", [i1, n1, b1, n2, n4, c1, n7, n8, n10, n13, n15, n17, e2])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n2)
precedence(b1, n4)
precedence(n2, c1)
precedence(n4, c1)
precedence(c1, n7)
precedence(n7, n8)
precedence(n8, n10)
precedence(n10, n13)
precedence(n13, n15)
precedence(n15, n17)
precedence(n17, e2)
guard(b1, n2, v1 = true)
guard(b1, n4, v1 = false)