  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "the process begins with a request to purchase a motorcycle."
      ],
      "justification": "Captures the process start and the initial request action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once the request is received, the next step is to either continue the process if a production order is received or update the sales information and proceed to order dispatch."
      ],
      "justification": "Describes the transition into the decision point. Modeling the condition as an action/check node and opening the XOR branch preserves the intended flow."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier."
      ],
      "justification": "Correctly captures the unavailability condition and the resulting ordering step."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Alternatively, if there are available goods for production, a manufacturing order is placed."
      ],
      "justification": "Correctly captures the availability condition and the manufacturing order placement."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier, the goods are issued and the motorcycles are produced."
      ],
      "justification": "Splits the compound source sentence into two sequential action steps. Splitting equivalent steps preserves behaviour."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "At the same time, the stock is updated and the motorcycles are dispatched."
      ],
      "justification": "Models the concurrent dispatch path and opens the parallel/simultaneous branch."
    },
    {
      "refs": [
        "action:n9",
        "action:n11"
      ],
      "verbatim_texts": [
        "After the goods are issued and the motorcycles are produced, the stock is updated and the process ends."
      ],
      "justification": "Captures the post-production stock update, termination action, and structural end node."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "Simultaneously, the stock is updated and the sales information is updated."
      ],
      "justification": "Captures the simultaneous sales/stock update path, its routing guard, and the structural joins that recombine the parallel flows."
    }
  ],
