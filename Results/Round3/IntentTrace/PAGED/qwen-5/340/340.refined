init(i1)
action(n2, "identify parts")
action(n3, "does the team need to elicit information from the customer?")
branch(b1, XOR)
action(n4, "check availability of the parts")
converge(c1)
action(n8, "record customer details")
action(n6, "order part from Disuki")
action(n7, "receive part from Disuki")
action(n9, "contract the customer")
action(n10, "collect all necessary parts")
action(n11, "proceed with payment")
action(n12, "end of process")
end(e1)
defines(v1, "condition", {"Need to elicit information", "Already have information or supplied", "Record customer details"})
actor(a_default, "Default", [i1, n2, n3, b1, n4, c1, n8, n6, n7, n9, n10, n11, n12, e1])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(n3, n4)
precedence(n4, c1)
precedence(b1, c1)
precedence(b1, n8)
precedence(n8, n6)
precedence(n6, n7)
precedence(n7, c1)
precedence(c1, n9)
precedence(n9, n10)
precedence(n10, n11)
precedence(n11, n12)
precedence(n12, e1)
guard(b1, n3, v1 = 'Need to elicit information')
guard(b1, c1, v1 = 'Already have information or supplied')
guard(b1, n8, v1 = 'Record customer details')
label(i1, n2, "Identify the parts")
label(n2, b1, "Check if information needs to be elicited")
label(n10, n11, "Proceed to payment step")
label(n11, n12, "Payment completed")