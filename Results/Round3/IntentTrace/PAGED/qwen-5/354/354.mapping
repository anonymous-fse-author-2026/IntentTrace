{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks, and then they should select the method for exit control checks."
      ],
      "justification": "Describes the process start and the first two sequential actions."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics, they should undergo a check using biometrics."
      ],
      "justification": "Captures the opening XOR decision, the biometric choice guard, and the corresponding check action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the passenger prefers to use ID documents, they should undergo checks using identity documents."
      ],
      "justification": "Captures the ID document alternative guard, the corresponding check action, and the subsequent flow convergence."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission, they should leave the area."
      ],
      "justification": "Opens the second decision point and models the denial condition and associated action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Models the allowance condition and the corresponding continuation action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends."
      ],
      "justification": "Repeats the unsuccessful outcome scenario. The model captures it as a redundant but behaviour-preserving action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Repeats the successful outcome scenario and explicitly notes process termination, correctly mapped to the final action and end node."
    }
  ],
