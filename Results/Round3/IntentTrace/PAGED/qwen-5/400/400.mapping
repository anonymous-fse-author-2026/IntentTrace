      ],
      "verbatim_texts": [
        "if the answer is \"No\", then we continue the process."
      ],
      "justification": "Initiates the process and captures the first 'No' condition and continuation step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"No\" again, we continue the process."
      ],
      "justification": "Direct restatement of the repeated 'No' continuation."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if the answer is \"Yes\", then we give it priority."
      ],
      "justification": "Captures the 'Yes' branch leading to prioritization."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, we look up the Vendor on SAP."
      ],
      "justification": "Direct step following the first decision block, with convergence node handling flow rejoining."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If the answer is \"No\", then we need a Vendor master record and the process ends."
      ],
      "justification": "Captures the second decision's 'No' path requiring a vendor record."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "But if the answer is \"Yes\", then we enter the invoice in SAP."
      ],
      "justification": "Captures the 'Yes' path for entering the invoice. Guard value preserves the intended positive condition."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "And if the answer is \"Yes\" again, then we enter the invoice in SAP."
      ],
      "justification": "Captures the reiterated 'Yes' condition and duplicate invoice entry step explicitly described in the text."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the invoice is entered in SAP, we place the entered invoices in the normal Outbox and the process ends."
      ],
      "justification": "Final processing step and termination point."
    }
