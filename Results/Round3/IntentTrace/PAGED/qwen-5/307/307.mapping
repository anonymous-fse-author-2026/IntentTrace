      "verbatim_texts": [
        "To begin the validation process, start by checking the received invoice for any errors."
      ],
      "justification": "The opening unit initiates the process and describes the initial checking step. The redundant 'start' action and structural init preserve the intended behaviour."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If any errors are found, continue with the process."
      ],
      "justification": "Opens the XOR decision and captures the positive branch. The guard uses a generic variable but preserves the conditional logic."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If no errors are found, mark the \"invoice entered correctly\" box."
      ],
      "justification": "Captures the negative decision path and the corresponding marking action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Simultaneously, highlight any errors on the invoice entry form and keep a record of the DEO's performance."
      ],
      "justification": "Direct paraphrase of the highlighting and recording step. Treating a simultaneous step sequentially is a harmless modeling choice that preserves behaviour."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the \"invoice entered correctly\" box is ticked, the invoice is checked and the process ends."
      ],
      "justification": "Covers the final checking action and the process termination point for this path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If an error exists, the process also ends."
      ],
      "justification": "A condition modeled as an action step is an acceptable re-typing that preserves behaviour. Termination is handled by the shared end node."
    }
