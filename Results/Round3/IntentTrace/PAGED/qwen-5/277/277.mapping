{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME Company, we first trigger the Resupply Cycle."
      ],
      "justification": "The start node and first action directly correspond to the process initiation step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, we check the inventory level."
      ],
      "justification": "Direct match to the inventory verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once the inventory level is checked, we proceed to create a purchase order."
      ],
      "justification": "Direct match to the PO creation step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the purchase order is not good",
        "we reject it.",
        "if the purchase order is good",
        "we approve it."
      ],
      "justification": "The XOR gateway correctly captures the decision point splitting into approval and rejection paths."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the purchase order is not good"
      ],
      "justification": "Guard abstracts the negative condition ('not good') using 'v1 = No', preserving the branch logic."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "we reject it."
      ],
      "justification": "Action on the rejection path matches the source text."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if the purchase order is good"
      ],
      "justification": "Guard abstracts the positive condition ('good') using 'v1 = Yes', preserving the branch logic."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "we approve it."
      ],
      "justification": "Action on the approval path matches the source text."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "In case the purchase order is rejected, we rework it."
      ],
      "justification": "Direct match to the rework step following rejection."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, we review it again."
      ],
      "justification": "Direct match to the review step following rework."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "we reserve funds for the purchase."
      ],
      "justification": "Direct match to the fund reservation step following approval."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, we send the purchase order to the supplier."
      ],
      "justification": "Direct match to sending the PO outward."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "receive the packing slip and receive the invoice."
      ],
      "justification": "The AND split and two subsequent actions correctly model the simultaneous receipt of both documents."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After receiving the packing slip, we record it."
      ],
      "justification": "Direct match to recording the packing slip."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Similarly, after receiving the invoice, we record it as well."
      ],
      "justification": "Direct match to recording the invoice."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Next, we release funds for payment"
      ],
      "justification": "Direct match to the fund release step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "and issue the payment."
      ],
      "justification": "Direct match to the payment issuance step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued."
      ],
      "justification": "Final termination action and end node correctly conclude the process flow."
    }
  ],
