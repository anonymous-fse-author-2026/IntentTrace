{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "Initializes the process and captures the first required step."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model and check it."
      ],
      "justification": "Describes creating the model and performing the initial check, modeled as sequential steps."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\", then assign negative points."
      ],
      "justification": "Correctly links the negative condition to the penalty action."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\", assign negative points again."
      ],
      "justification": "Models the secondary check and the repeated penalty accurately."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Captures the positive continuation path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Directly matches the issue resolution and level extension step."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n12",
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process. If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Establishes the branching decision and correctly labels the two divergent paths."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "Maps the 'check' guard condition to its corresponding continuation action."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Maps the 'analyze' guard condition to role assignment and converges the branch."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process"
      ],
      "justification": "Models the condition check for proceeding further."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "and perform work according to your assigned role."
      ],
      "justification": "Captures the subsequent execution step based on assigned roles."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct match for the progress monitoring step."
    },
    {
      "refs": [
        "action:n19",
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it."
      ],
      "justification": "Opens the acceptance decision and routes to the presentation action when true."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Routes to continued work when not accepted and converges the flow."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Final presentation step and process termination. Source redundancy (i15) is behaviorally absorbed here."
    }
  ],
