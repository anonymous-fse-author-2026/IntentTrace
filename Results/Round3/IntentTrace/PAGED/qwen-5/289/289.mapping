{
  "matches": [
    {
      "refs": [
        "action:a_start"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Implicit start node and the initial UI interaction step match the opening instruction."
    },
    {
      "refs": [
        "guard:b_exp->a_rev",
        "action:a_rev"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "XOR split correctly models the high-value threshold (>1000) and routes to the review action."
    },
    {
      "refs": [
        "guard:b_exp->a_chkTrans",
        "action:a_chkTrans"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Guard captures the <=1000 condition and the subsequent check action preserves the low-value path."
    },
    {
      "refs": [
        "guard:b_trans->a_trans",
        "action:a_trans"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Decision splits on translation need; Yes guard routes directly to the translation action."
    },
    {
      "refs": [
        "guard:b_trans->a_conf",
        "action:a_conf"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "No guard routes to the confirmation action, matching the alternative branch."
    },
    {
      "refs": [
        "guard:b_r1->a_edit1",
        "action:a_edit1",
        "guard:b_r2->a_edit1",
        "guard:b_r3->a_edit1",
        "guard:b_r4->a_edit2",
        "action:a_edit2",
        "guard:b_rec->a_edit3",
        "action:a_edit3"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Multiple explicit branches and guards faithfully model the repeatedly stated rejection/edit loop throughout the text. Redundant structuring does not alter behaviour."
    },
    {
      "refs": [
        "guard:b_r1->a_chkCont",
        "action:a_chkCont",
        "guard:b_r2->a_chkCont",
        "guard:b_r3->a_chkCont"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Guards capture the Approved outcome routing back to the translation-check step, preserving the iterative approval flow."
    },
    {
      "refs": [
        "guard:b_r4->a_transConf",
        "action:a_transConf"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Models the final approval branch where translation and confirmation are combined into a single sequenced action."
    },
    {
      "refs": [
        "guard:b_rec->a_proc",
        "action:a_proc"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Split on receipt status routes Accepted to processing; converges and end node provide structural closure matching the text's final termination."
    }
  ],
