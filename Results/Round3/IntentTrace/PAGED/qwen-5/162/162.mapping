{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please provide the userdata for flickr."
      ],
      "justification": "Captures the process initiation and the first action. Splitting the implicit start marker and the credential request preserves the original flow."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the login is successful, the process will end."
      ],
      "justification": "Models the positive outcome of the login decision. The abstract guard v1='Yes' correctly represents a successful login condition without changing behavior."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the login fails, we will continue with the process."
      ],
      "justification": "Models the negative outcome branch and the transition to the retry prompt. Guard v1='No' aligns with login failure."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If you want to try again, please provide the userdata for flickr."
      ],
      "justification": "Captures the user choice to retry and routes back to providing credentials."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if you choose to abort, the process will end."
      ],
      "justification": "Captures the abort choice and the corresponding termination path."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If you still want to try again, please provide the userdata for flickr."
      ],
      "justification": "Faithfully models the source text's redundant restatement of the retry option. Redundancy that preserves behavior is a match."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "Alternatively, if you decide to abort, the process will end."
      ],
      "justification": "Faithfully models the source text's redundant restatement of the abort option. Structural end nodes are harmless plumbing."
    }
  ],
