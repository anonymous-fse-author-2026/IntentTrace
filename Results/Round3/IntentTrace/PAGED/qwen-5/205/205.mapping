{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the process for ACME Company, the Resupply Cycle is triggered"
      ],
      "justification": "Covers process initiation, the explicit trigger action, and boilerplate 'start' node."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level."
      ],
      "justification": "Direct mapping to the inventory verification step."
    },
    {
      "refs": [
        "guard:b1->e1"
      ],
      "verbatim_texts": [
        "If the Inventory is greater than the Minimum Level, then the process ends."
      ],
      "justification": "XOR branch models the decision; guard 'v1 = Above' preserves the 'greater than' condition routing to termination."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, a Purchase Order is created."
      ],
      "justification": "Guard 'v1 = Below' captures the complementary case, leading to PO creation."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "The Purchase Order is then reviewed."
      ],
      "justification": "Direct step mapping."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected, it is reworked."
      ],
      "justification": "Second XOR branch; guard 'v2 = Rejected' correctly routes to the rework action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "if the Purchase Order is accepted, funds are reserved for payment."
      ],
      "justification": "Guard 'v2 = Accepted' routes to fund reservation."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reserving funds for payment, the Purchase Order is sent to the Supplier."
      ],
      "justification": "Direct step mapping following reserve action."
    },
    {
      "refs": [
        "action:n9",
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: the Packing Slip is received and the Invoice is received."
      ],
      "justification": "AND gateway models concurrent execution; actions capture receipt of both documents."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Upon receiving the Packing Slip, it is recorded."
      ],
      "justification": "Direct step mapping."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Similarly, upon receiving the Invoice, it is recorded."
      ],
      "justification": "Direct step mapping."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the funds are released for payment"
      ],
      "justification": "Converge joins parallel tracks; n13 captures release, n14 captures issuance. Timing and sequence preserved."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the funds are released for payment, the payment is issued to the Supplier."
      ],
      "justification": "Converge joins parallel tracks; n13 captures release, n14 captures issuance. Timing and sequence preserved."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, the process ends with the issuance of payment to the Supplier."
      ],
      "justification": "Confirms terminal state after final payment step. Maps to the same structural end node used for early exits, which is behaviour-preserving."
    }
  ],
