  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "Implicit process start and first action step directly restated."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level."
      ],
      "justification": "Action node performs the initial inventory check described in the source."
    },
    {
      "refs": [
        "guard:b1->n3",
        "guard:b1->n4",
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\", then proceed to Create Purchase Order. However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "XOR gateway splits the flow based on inventory level. Guards abstract the binary outcomes as v1=Yes/No, which preserves the decision logic. Positive arm creates PO; negative arm terminates early with an end node."
    },
    {
      "refs": [
        "action:n5",
        "action:n6",
        "guard:b2->n7",
        "guard:b2->n8",
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved, then reserve the funds for the purchase. On the other hand, if the Purchase Order is rejected, then rework the order."
      ],
      "justification": "Covers the review step, approval condition check, XOR split, abstract Yes/No guards preserving the two outcomes, fund reservation path, and rework path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "send the Order to Suppliers."
      ],
      "justification": "Direct paraphrase of the shipment step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "review the Purchase Order again."
      ],
      "justification": "Direct paraphrase of the re-review step following rework."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the Supplier sends a packing slip and an invoice."
      ],
      "justification": "AND gateway initiates concurrent processing; action models the supplier sending both documents."
    },
    {
      "refs": [
        "label:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it."
      ],
      "justification": "Label captures the trigger condition on the connection; action captures the receiving and recording behaviour."
    },
    {
      "refs": [
        "label:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "when the invoice is received, record it as well."
      ],
      "justification": "Label captures the trigger condition; action captures the receiving and recording behaviour."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice"
      ],
      "justification": "Source phrase signals synchronization of the parallel paths; converge node correctly implements this structural join."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "Direct restatement of the final financial actions."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Explicit termination step and end node matching the source conclusion."
    }
