{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "Covers process initiation and the first prioritization step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check the customer's information."
      ],
      "justification": "Directly corresponds to the second step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the customer exists, we move on to checking their payment history."
      ],
      "justification": "Models the positive branch condition and the corresponding verification action."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if the customer does not exist, we need to verify their customer status."
      ],
      "justification": "Models the negative branch condition and the corresponding verification action."
    },
    {
      "refs": [
        "guard:b2->c_main"
      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process."
      ],
      "justification": "Captures the decision point and conditional continuation."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Matches the private customer branch, the declining message action, and the implicit end of this path."
    },
    {
      "refs": [
        "action:n9",
        "action:n10",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Matches the alternative wholesaler branch and its two sequential steps."
    },
    {
      "refs": [
        "action:n12",
        "guard:b4->n12"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Correctly models the unavailable products path, combined action, and termination."
    },
    {
      "refs": [
        "guard:b4->c_main"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Captures the positive branch condition and flow convergence. The confirmation step is modeled implicitly within the continuing flow without changing behaviour."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "Direct match for the simultaneous notification step."
    },
    {
      "refs": [
        "action:n17",
        "action:n19"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Splits the single sentence into two equivalent modelling steps preserving the same meaning and order."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Matches the delivery action, flow convergence, and successful process completion."
    },
    {
      "refs": [
        "action:n20",
        "guard:b5->n20"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Models the payment-received condition and the corresponding closing action."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Matches the negative payment branch and the reminder check step."
    },
    {
      "refs": [
        "action:n26",
        "guard:b6->n26"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Captures the low-reminder condition and continuation flow."
    },
    {
      "refs": [
        "action:n27",
        "guard:b6->n27"
      ],
      "verbatim_texts": [
        "if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Matches the high-reminder condition, the specific action, and process termination."
    }
  ],
