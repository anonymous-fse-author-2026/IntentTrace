{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle."
      ],
      "justification": "Initial start node and first action directly correspond to the opening instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, check the current inventory level."
      ],
      "justification": "Direct match for the inventory check step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is above the minimum, then the process ends."
      ],
      "justification": "Branch, guard, action, and end node collectively model the early termination path for sufficient inventory."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the inventory level is below the minimum, create a purchase order."
      ],
      "justification": "Guard and action capture the condition and subsequent purchase order creation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the purchase order is created, review it."
      ],
      "justification": "Direct match for the initial review step."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order."
      ],
      "justification": "Models the rejection branch, rework action, and convergence point for the negative path."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "But if the purchase order is accepted, continue the process.",
        "However, if the purchase order is accepted, continue the process."
      ],
      "justification": "Guard captures the acceptance condition. The duplicate source sentence is harmless redundancy and does not change behaviour."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->c1",
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, review it again."
      ],
      "justification": "Action matches the re-review step. Branch and guards handle the implicit subsequent decision logic required to loop or proceed."
    },
    {
      "refs": [
        "label:c1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: reserve funds for the purchase and send the purchase order to the supplier."
      ],
      "justification": "Label preserves the temporal marker. Action combines the two parallel sub-steps. Converge joins accepted paths prior to execution."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, release the reserved funds and then the process ends."
      ],
      "justification": "Covers receipt, fund release, and final termination. Splitting into sequential actions preserves the described behaviour."
    }
  ],
