init(i1)
action(n1, "Informational meeting (half day)")
branch(b1, XOR)
action(n3, "Work on storyboard (full day)")
branch(b_sb, XOR)
branch(b4, AND)
action(n5, "Site design (10 days)")
action(n6, "Content preparation")
converge(c1)
action(n7, "Merge: Site design and content preparation completed")
action(n8, "Site development (2 days)")
action(n9, "Review process (1 day)")
action(n11, "Approval stage (half a day)")
branch(b_appr, XOR)
action(n13, "Rebuild site (3 days)")
branch(b_rb1, XOR)
action(n16, "Rebuild site again (3 days)")
end(e1)
end(e2)
end(e3)
end(e4)
end(e_sb)
defines(v1, "Is the informational meeting successful?", {true, false})
defines(v_sb, "Is the storyboard successful?", {true, false})
defines(v3, "Approval result", {"complete", "rejected"})
defines(v4, "Rebuild result", {"complete", "rejected"})
actor(a_customer, "Customer", [n1, n3])
actor(a_web, "Web Design Team", [n5, n6, n7, n8, n9, n11, n13, n16])
actor(a_ctrl, "Control Flow", [i1, b1, b_sb, b4, c1, b_appr, b_rb1, e1, e2, e3, e4, e_sb])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n3)
precedence(b1, e1)
precedence(n3, b_sb)
precedence(b_sb, b4)
precedence(b_sb, e_sb)
precedence(b4, n5)
precedence(b4, n6)
precedence(n5, c1)
precedence(n6, c1)
precedence(c1, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, n11)
precedence(n11, b_appr)
precedence(b_appr, e2)
precedence(b_appr, n13)
precedence(n13, b_rb1)
precedence(b_rb1, e3)
precedence(b_rb1, n16)
precedence(n16, e4)
guard(b1, n3, "v1 = true")
guard(b1, e1, "v1 = false")
guard(b_sb, b4, "v_sb = true")
guard(b_sb, e_sb, "v_sb = false")
guard(b_appr, e2, "v3 = 'complete'")
guard(b_appr, n13, "v3 = 'rejected'")
guard(b_rb1, e3, "v4 = 'complete'")
guard(b_rb1, n16, "v4 = 'rejected'")