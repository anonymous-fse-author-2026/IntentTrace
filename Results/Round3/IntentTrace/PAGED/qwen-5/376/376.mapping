      ],
      "verbatim_texts": [
        "To start"
      ],
      "justification": "Implicitly triggers the process start and models the initial setup step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "please provide the userdata for flickr."
      ],
      "justification": "Directly captures the first required user input action."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the login is successful"
      ],
      "justification": "Models the login evaluation and the positive decision path. Variable abstraction preserves the original boolean logic."
    },
    {
      "refs": [
        "guard:b1->b2"
      ],
      "verbatim_texts": [
        "if the login fails"
      ],
      "justification": "Captures the negative branch condition that routes flow to the retry/abort decision."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the process will end."
      ],
      "justification": "Represents the termination point reached upon a successful login."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If you want to try again"
      ],
      "justification": "Implements the retry decision and the convergence point that loops back to re-provide userdata."
    },
    {
      "refs": [
        "guard:b2->e1"
      ],
      "verbatim_texts": [
        "On the other hand, if you choose to abort"
      ],
      "justification": "Captures the abort decision path directing flow directly to the process end."
    }
