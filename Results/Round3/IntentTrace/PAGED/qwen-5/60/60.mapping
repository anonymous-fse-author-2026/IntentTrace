{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Initialization and opening steps. Redundant splitting and added structural convergence preserve the original behaviour."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "Condition modeled as an action step feeding a branch/guard. Threshold and positive outcome correctly preserved."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Negative branch of the expense check correctly leads to checking translation need."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Positive arm of the translation requirement decision."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Negative arm of the translation requirement decision."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Joins preceding paths and performs the review decision evaluation."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "First rejection branch correctly triggers editing."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "First approval branch correctly continues to translation check."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Re-evaluates decision after looping/approval path. Structural convergence is harmless plumbing."
    },
    {
      "refs": [
        "guard:b6->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Second approval branch correctly sequences translation and confirmation."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Evaluates decision and opens the final split."
    },
    {
      "refs": [
        "guard:b5->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Acceptance branch correctly proceeds to processing."
    },
    {
      "refs": [
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Rejection branch correctly routes to editing."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Final termination step and process end node. Processing expense was already covered in the acceptance path, making this a harmless redundancy."
    }
  ],
