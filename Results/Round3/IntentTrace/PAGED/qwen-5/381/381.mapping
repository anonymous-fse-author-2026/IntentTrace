{
  "matches": [
    {
      "refs": [
        "action:a1"
      ],
      "verbatim_texts": [
        "To begin with, you should choose your destination and calculate the distance."
      ],
      "justification": "Start node and initial action correspond directly to the opening step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "While doing so, continue to check if you need to book a train or a flight."
      ],
      "justification": "Introduces the XOR decision point between the two transport options."
    },
    {
      "refs": [
        "guard:b1->a3",
        "action:a3"
      ],
      "verbatim_texts": [
        "If the answer is \"no\", then proceed to book a train."
      ],
      "justification": "Correctly captures the negative condition and the resulting train booking step."
    },
    {
      "refs": [
        "guard:b1->a4",
        "action:a4"
      ],
      "verbatim_texts": [
        "However, if the answer is \"yes\", then book a flight."
      ],
      "justification": "Correctly captures the positive condition and the resulting flight booking step."
    },
    {
      "refs": [
        "guard:b2->a5",
        "action:a5"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours, the process will end."
      ],
      "justification": "Models the time-window condition, the associated action/state, and the process termination."
    },
    {
      "refs": [
        "guard:b2->a6",
        "action:a6"
      ],
      "verbatim_texts": [
        "Otherwise, if 24 hours have passed, you should call a travel agency."
      ],
      "justification": "Captures the alternative time condition and the required agency contact step."
    },
    {
      "refs": [
        "guard:b3->a7",
        "action:a7"
      ],
      "verbatim_texts": [
        "If a code is available, the process will end along with the hotel reservation."
      ],
      "justification": "Models the second availability check, its positive outcome, and termination."
    },
    {
      "refs": [
        "guard:b3->a8",
        "action:a8"
      ],
      "verbatim_texts": [
        "On the other hand, if a code is not available, you should cancel your journey. In that case, the process will end as well."
      ],
      "justification": "Captures the negative outcome action, final termination point, and flow convergence."
    }
  ],
