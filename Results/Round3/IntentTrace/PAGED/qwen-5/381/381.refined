init(start)
action(a1, "choose your destination and calculate the distance")
action(a3, "book a train")
action(a4, "book a flight")
action(a5, "code available within 24 hours")
action(a6, "call a travel agency")
action(a7, "process ends along with the hotel reservation")
action(a8, "cancel your journey")
branch(b1, XOR)
branch(b2, XOR)
branch(b3, XOR)
converge(c1)
end(e1)
end(e2)
end(e3)
defines(v_mode, "transport mode", {"train", "flight"})
defines(v_time, "time check", {"within_24h", "passed_24h"})
defines(v_code, "code availability", {"available", "not_available"})
actor(actor_default, "Default", [start, a1, b1, a3, a4, c1, b2, a5, e1, a6, b3, a7, e2, a8, e3])
precedence(start, a1)
precedence(a1, b1)
precedence(b1, a3)
precedence(b1, a4)
precedence(a3, c1)
precedence(a4, c1)
precedence(c1, b2)
precedence(b2, a5)
precedence(b2, a6)
precedence(a5, e1)
precedence(a6, b3)
precedence(b3, a7)
precedence(b3, a8)
precedence(a7, e2)
precedence(a8, e3)
guard(b1, a3, v_mode = 'train')
guard(b1, a4, v_mode = 'flight')
guard(b2, a5, v_time = 'within_24h')
guard(b2, a6, v_time = 'passed_24h')
guard(b3, a7, v_code = 'available')
guard(b3, a8, v_code = 'not_available')