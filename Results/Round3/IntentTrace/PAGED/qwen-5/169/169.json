  "input_elements": [
    {
      "id": "i1",
      "content": "The first step is to receive and categorize the invoice."
    },
    {
      "id": "i2",
      "content": "If the instruction is to"
    },
    {
      "id": "i4",
      "content": "Forward Invoice to Admin Officer"
    },
    {
      "id": "i5",
      "content": "sort the invoice"
    },
    {
      "id": "i6",
      "content": "However, if the instruction is to"
    },
    {
      "id": "i8",
      "content": "Reject invoice"
    },
    {
      "id": "i9",
      "content": "the process ends there"
    },
    {
      "id": "i10",
      "content": "On the other hand, if the instruction is to"
    },
    {
      "id": "i12",
      "content": "Return invoice to client for completion"
    },
    {
      "id": "i13",
      "content": "the invoice is received and categorized again"
    },
    {
      "id": "i14",
      "content": "Alternatively, if the instruction is to"
    },
    {
      "id": "i16",
      "content": "Process Invoice for SAP Entry"
    },
    {
      "id": "i17",
      "content": "the invoice is forwarded for validation"
    },
    {
      "id": "i18",
      "content": "it is then validated"
    },
    {
      "id": "i19",
      "content": "and the process ends"
    }
  ]
