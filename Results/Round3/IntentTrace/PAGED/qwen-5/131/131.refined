init(i1)
action(n1, "start the process")
action(n2, "empty the mailbox")
action(n3, "check if mailbox is empty")
branch(b1, XOR)
action(n4, "end process")
action(n_i5, "check if mailbox is empty again")
action(n5, "verify information completeness")
branch(b2, XOR)
action(n6, "add incoming mail number  date  and record in letter book")
action(n7, "make telephone call to sender")
action(n8, "complete data by adding incoming mail number  date  and record in letter book")
converge(c1)
action(n9, "take letter book and member register to Miranda every Wednesday evening")
branch(b3, XOR)
action(n11, "stamp 'new Member' on the letter and write date")
action(n17, "write to applicant and inform them of decision")
action(n18, "end process")
action(n12, "After stamping \"new Member\" on the letter and writing the date on it, write the data.")
action(n13, "calculate the fee and hand the letter to Charles. Ask Charles to write the amount in the register.")
action(n15, "Print the membership card with all the data and send it to the new member.")
action(n16, "The process ends.")
action(n_ima17, "Hand the letter to Charles and add the new member to the register.")
action(n_ima18, "Prepare an invoice for the new members and continue the process.")
action(n_ima19, "Ask Charles to write the amount in the register and write the fee amount to the register.")
end(e1)
end(e2)
end(e3)
defines(v1, "check if mailbox is empty", {"Yes", "No"})
defines(v2, "verify information completeness", {"Complete", "Not Complete"})
defines(v3, "check if applicant becomes a member", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n_i5, n5, b2, n6, n7, n8, c1, n9, b3, n11, n17, n18, n12, n13, n15, n16, n_ima17, n_ima18, n_ima19, e1, e2, e3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n_i5)
precedence(n4, e1)
precedence(n_i5, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n7)
precedence(n7, n8)
precedence(n6, c1)
precedence(n8, c1)
precedence(c1, n9)
precedence(n9, b3)
precedence(b3, n11)
precedence(b3, n17)
precedence(n17, n18)
precedence(n18, e3)
precedence(n11, n12)
precedence(n12, n13)
precedence(n13, n15)
precedence(n15, n16)
precedence(n16, n_ima17)
precedence(n_ima17, n_ima18)
precedence(n_ima18, n_ima19)
precedence(n_ima19, e2)
guard(b1, n4, v1 = 'Yes')
guard(b1, n_i5, v1 = 'No')
guard(b2, n6, v2 = 'Complete')
guard(b2, n7, v2 = 'Not Complete')
guard(b3, n11, v3 = 'Yes')
guard(b3, n17, v3 = 'No')