      "verbatim_texts": [
        "For the company, the first step is to look at the order."
      ],
      "justification": "Start node corresponds to the initial step described in the text."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "If the order is to be rejected, the process should continue. If the order is to be accepted, the process should also continue."
      ],
      "justification": "Action abstracts the conditional evaluation that proceeds regardless of the outcome, preserving the behaviour."
    },
    {
      "refs": [
        "action:n_prepare",
        "action:n_check_avail"
      ],
      "verbatim_texts": [
        "At the same time, two steps need to be completed: preparing the assembling order and checking availability."
      ],
      "justification": "AND gateway models concurrent execution ('At the same time'), actions match the two specified tasks, and converge rejoins the flow."
    },
    {
      "refs": [
        "guard:b_availability->n_check_again",
        "action:n_check_again"
      ],
      "verbatim_texts": [
        "If there is a backorder, availability needs to be checked again and the process ends."
      ],
      "justification": "XOR split and guard capture the backorder condition; action and end node correctly model the re-check and termination."
    },
    {
      "refs": [
        "guard:b_availability->n_assemble"
      ],
      "verbatim_texts": [
        "If the item can be reserved, the process should continue."
      ],
      "justification": "Guard condition correctly captures the reserved case leading to process continuation."
    },
    {
      "refs": [
        "action:n_assemble",
        "action:n_ship"
      ],
      "verbatim_texts": [
        "The next steps are to assemble the bike and then ship the product."
      ],
      "justification": "Sequential actions directly match the final steps; end node represents natural process completion."
    }
