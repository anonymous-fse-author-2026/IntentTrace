@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:supply requirement and document it;
:check order reception method;
:v1: check order reception method ({Fax, Mail/Phone}); <<objectSignal>>
if () then ([v1 = 'Fax'])
:input order into Excel (fax);
else ([v1 = 'Mail/Phone'])
:input order into Excel (mail/phone);
endif
:send Excel list to student;
:receive Excel list and start parallel tasks;
split
:type orders into MS-Access database;
split again
:control incoming order and check;
end split
:orders input completed and checked;
:decision on order correctness;
:v2: decision on order correctness ({Correct, Incorrect}); <<objectSignal>>
if () then ([v2 = 'Correct'])
:release order (correct);
else ([v2 = 'Incorrect'])
:contact selling agency (incorrect);
:check if issue solvable;
:v4: check if issue solvable ({Unsolvable, Solvable}); <<objectSignal>>
if () then ([v4 = 'Unsolvable'])
:cancel order (unsolvable);
stop
else ([v4 = 'Solvable'])
:release order (solvable);
endif
endif
:check order value;
:v3: check order value ({< 5000 €, > 5000 €}); <<objectSignal>>
if () then ([v3 = '< 5000 €'])
:release order (<5k€);
else ([v3 = '> 5000 €'])
:send for sign-off (>5k€);
:contact client after sign-off;
:release order post sign-off;
endif
:PPC initiates production;
:check if order needs cancellation;
:v5: check if order needs cancellation ({Cancel, Do not cancel}); <<objectSignal>>
if () then ([v5 = 'Cancel'])
:process ends (cancel);
stop
else ([v5 = 'Do not cancel'])
:check quality of goods;
:create and send quality report;
:release order via memo;
:ensure that the memo is achieved in the warehouse;
:v6: final processing path ({Invoice, Commission}); <<objectSignal>>
if () then ([v6 = 'Invoice'])
:send invoice to finance;
else ([v6 = 'Commission'])
:commission goods;
:sign and send memo to logistic;
:send the goods;
endif
:ensure memos are archived;
:close order;
stop
endif
@enduml