{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by supplying the requirement and then documenting it."
      ],
      "justification": "Implicit process start and initial documentation step faithfully captured."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the order is received via fax"
      ],
      "justification": "XOR split correctly routes fax-received orders to Excel input."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "input the order into an Excel file."
      ],
      "justification": "XOR split correctly routes fax-received orders to Excel input."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone"
      ],
      "justification": "Alternative reception channels and their corresponding Excel input are preserved."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "also input the order into an Excel file."
      ],
      "justification": "Alternative reception channels and their corresponding Excel input are preserved."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete after a week, send it to the student."
      ],
      "justification": "Direct match for the weekly list distribution step."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list, type the orders into the MS-Access database."
      ],
      "justification": "Receiving and database entry modeled as sequential actions without behavioural loss."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed. Once the database is completed, control the incoming order. At the same time, continue to do the check."
      ],
      "justification": "Database completion verification, order control, and checking are covered by these combined steps."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the order is correct, release it."
      ],
      "justification": "Correctness decision gateway and positive release path align perfectly. n11 models the check itself."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Negative branch correctly directs to agency contact."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac, release it."
      ],
      "justification": "Value threshold (< 5000 \u20ac) and immediate release action match source logic."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "Higher-value branch correctly triggers sign-off procedure."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "Once the order is signed off, contact the client and release the order."
      ],
      "justification": "Post-sign-off client contact and release are captured; convergence joins preceding flows."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "PPC production initiation accurately mapped."
    },
    {
      "refs": [
        "guard:b4->n21",
        "action:n21",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order."
      ],
      "justification": "Unsolvable issue condition correctly leads to cancellation. n20 represents the solvability assessment."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the issue can be solved, release the order."
      ],
      "justification": "Solvable issue branch properly releases the order."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends."
      ],
      "justification": "Cancellation trigger terminates the flow as specified."
    },
    {
      "refs": [
        "guard:b5->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If not, check the quality of the goods."
      ],
      "justification": "Continuation path correctly proceeds to quality inspection."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "justification": "Quality report generation and dispatch directly matched."
    },
    {
      "refs": [
        "action:n27",
        "action:n33"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "justification": "Memo release and warehouse verification split into two nodes while preserving required behaviour."
    },
    {
      "refs": [
        "guard:b_end->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "justification": "Invoice handling modeled within the parallel task stream."
    },
    {
      "refs": [
        "guard:b_end->n29",
        "action:n29",
        "action:n30",
        "action:n34"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods and sign and send the memo. Also, send the goods and ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "Concurrent commissioning, memo signing, and goods dispatch accurately represented across multiple steps."
    },
    {
      "refs": [
        "action:n31",
        "action:n32"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order. This marks the end of the process."
      ],
      "justification": "Final archival and order closure mapped; structural end nodes cover all valid termination points described in the text."
    }
  ],
