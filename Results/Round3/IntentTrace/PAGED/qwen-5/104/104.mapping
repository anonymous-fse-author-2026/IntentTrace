{
  "matches": [
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "Initially, if the option \"research schedule directly\" is selected, then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Starts the process and correctly branches when the direct research option is selected."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Correctly models the alternative path, providing indications and proceeding to research."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Validates schedule and performs the first satisfactoriness check. Conditionals are re-typed as action steps, which preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Branches on the first check; routes back to research schedule if unsatisfactory."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n12"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Routes to ticket order creation if schedule is satisfactory."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\". If it is still not satisfactory, then \"provide indications\". Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Restates the second iteration of researching and checking schedule satisfaction. Redundant modeling choice does not alter overall behaviour."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Covers writing the ticket order followed immediately by its validation."
    },
    {
      "refs": [
        "action:n14",
        "guard:b4->n15",
        "action:n15",
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
      ],
      "justification": "First approval check: ends process if rejected, validates order if approved. Termination is modeled as an action step, which is a permissible re-typing."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->n18",
        "action:n18",
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
      ],
      "justification": "Second approval check with identical logic to the first. Faithfully matches source repetition."
    },
    {
      "refs": [
        "action:n20",
        "guard:b6->n21",
        "action:n21",
        "guard:b6->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved. If it is, then the process ends. If it is not, then the process ends."
      ],
      "justification": "Third approval check where both outcomes terminate the process. Fully preserves the described behaviour."
    }
  ],
