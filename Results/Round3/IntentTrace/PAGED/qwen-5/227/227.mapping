    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there is coverage, offer immediate help."
      ],
      "justification": "Correctly models the positive conditional branch and its associated action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is no coverage, send out an offer for emergency help."
      ],
      "justification": "Correctly models the negative conditional branch and its associated action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the offer is rejected, ask for a rejection notification."
      ],
      "justification": "Accurately captures the rejection condition and follow-up action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is accepted, proceed with internal accounting."
      ],
      "justification": "Accurately captures the acceptance condition and follow-up action."
    },
    {
      "refs": [
        "action:n9_1",
        "guard:b3_1->c1",
        "action:n9_2",
        "guard:b3_2->c1",
        "action:n9_3",
        "guard:b3_3->c1"
      ],
      "verbatim_texts": [
        "Repeat the same steps if necessary."
      ],
      "justification": "Models the loop-back logic. Redundant branching structure does not alter behaviour, so it remains a match."
    },
    {
      "refs": [
        "action:n12_1",
