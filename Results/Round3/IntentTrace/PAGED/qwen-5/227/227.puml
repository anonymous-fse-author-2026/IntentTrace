@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process with Insurance emergency;
:analyze the insurance agreement;
:v1: is there coverage ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:offer immediate help;
:repeat the same steps if necessary;
:v3: repeat the same steps if necessary ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'No'])
:conclude the process;
endif
else ([v1 = 'No'])
:send out an offer for emergency help;
:v2: has the offer been accepted ({Accepted, Rejected}); <<objectSignal>>
if () then ([v2 = 'Rejected'])
:ask for a rejection notification;
:repeat the same steps if necessary;
:v3: repeat the same steps if necessary ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'No'])
:conclude the process;
endif
else ([v2 = 'Accepted'])
:proceed with internal accounting;
:repeat the same steps if necessary;
:v3: repeat the same steps if necessary ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'No'])
:conclude the process;
endif
endif
endif
stop
@enduml