{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "Implicit start node and first action step correspond to the opening statement."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After receiving the invoice, it is sorted per client."
      ],
      "justification": "Direct match for the client sorting step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once sorted per client, it is then sorted per vendor."
      ],
      "justification": "Direct match for the vendor sorting step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice"
      ],
      "justification": "Direct paraphrase of attaching the form."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form"
      ],
      "justification": "Direct match for entering required information."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked"
      ],
      "justification": "Models the completeness check and the subsequent decision point."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete"
      ],
      "justification": "Guards accurately capture the two branches of the completeness decision."
    },
    {
      "refs": [
        "guard:b1->n9"
      ],
      "verbatim_texts": [
        "If it is complete"
      ],
      "justification": "Guards accurately capture the two branches of the completeness decision."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Termination action and end node for the incomplete invoice path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the information for the SLA is entered.",
        "The date for completion is also entered"
      ],
      "justification": "Merges SLA entry and date entry into a single coherent step without changing behaviour."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the priority is checked"
      ],
      "justification": "Direct match for the priority check step."
    },
    {
      "refs": [
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "If the priority is high"
      ],
      "justification": "Correctly models the high-priority branch condition and the stamping action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "a red stamp is placed on the entry invoice"
      ],
      "justification": "Correctly models the high-priority branch condition and the stamping action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is low",
        "If it is low, the process continues."
      ],
      "justification": "Models the low-priority continuation path and flow rejoining."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Direct match for the compliance check step."
    },
    {
      "refs": [
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff"
      ],
      "justification": "Models the experienced staff condition and corresponding processing action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the non-compliance invoice is processed"
      ],
      "justification": "Models the experienced staff condition and corresponding processing action."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "If it is a normal case"
      ],
      "justification": "Models the normal case condition and client call action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "the client is called"
      ],
      "justification": "Models the normal case condition and client call action."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If none of these conditions apply"
      ],
      "justification": "Captures the fallback condition, mailing action, and associated process termination."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "a postal mail is sent requesting complete information and the process ends"
      ],
      "justification": "Captures the fallback condition, mailing action, and associated process termination."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Direct match for the final client contact step."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO"
      ],
      "justification": "Models batching, successful completion marker, and structural join/end nodes for the process conclusion."
    }
  ],
