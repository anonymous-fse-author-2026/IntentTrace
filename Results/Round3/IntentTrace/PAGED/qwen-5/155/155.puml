@startuml
!theme plain
|a_default| Default
|a_default|
start
:Resupply Cycle Triggered;
:Check Inventory Level;
:v1: Inventory Level Check ({Inventory level is at or below the minimum, Inventory Level is above the minimum}); <<objectSignal>>
if () then ([v1 = 'Inventory level is at or below the minimum'])
:Create Purchase Order;
:Reviewing Purchase Order;
:Purchase Order Approved;
:v2: Purchase Order Status ({Purchase Order is approved, Purchase Order is rejected}); <<objectSignal>>
if () then ([v2 = 'Purchase Order is approved'])
:Reserve Funds for Purchase;
:Send Order to Suppliers;
split
:Supplier sends packing slip;
:Record packing slip;
split again
:Supplier sends invoice;
:Record invoice;
end split
:Release reserved funds;
:Issue payment to supplier;
:End Process;
stop
else ([v2 = 'Purchase Order is rejected'])
:Rework Order;
:Reviewing Purchase Order;
endif
else ([v1 = 'Inventory Level is above the minimum'])
:End Process;
stop
endif
@enduml