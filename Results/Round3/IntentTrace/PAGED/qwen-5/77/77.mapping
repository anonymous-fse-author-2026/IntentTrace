{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "Initiates the process and executes the first setup step exactly as described."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model and check it."
      ],
      "justification": "Directly models the second sequential step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\", then assign negative points."
      ],
      "justification": "Captures the penalty action triggered by the specified condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\", assign negative points again."
      ],
      "justification": "Accurately reflects the repeated penalty step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Models the continuation path when the condition is satisfied."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Directly captures the remediation and level-extension step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "Faithfully restates the conditional continuation step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Direct match for the role assignment step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Covers the work-performing step. The converge node is structural plumbing that safely merges prior conditional paths without altering behaviour."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Exact match for the monitoring and consultation step."
    },
    {
      "refs": [
        "guard:b1->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it."
      ],
      "justification": "Establishes the decision split and the positive outcome path. The guard uses an abstract variable name but preserves the branching logic and target."
    },
    {
      "refs": [
        "guard:b1->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Captures the fallback/retry path from the same decision point."
    },
    {
      "refs": [
        "guard:b1->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Captures the secondary acceptance/presentation path."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Final presentation action and process termination, fully aligned with the closing statement."
    }
  ],
