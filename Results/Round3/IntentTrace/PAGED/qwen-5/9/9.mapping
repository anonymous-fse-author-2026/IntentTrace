{
  "matches": [
    {
      "refs": [
        "action:n_i1"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Initiates the process and describes the first combined billing/receiving step."
    },
    {
      "refs": [
        "guard:b1->n_i2",
        "action:n_i2"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Opens the XOR decision for invoice status, applies the correct incomplete guard, and executes the return action."
    },
    {
      "refs": [
        "guard:b1->n_i3",
        "action:n_i3"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues. If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Captures the completeness condition and transitions to compliance checking."
    },
    {
      "refs": [
        "guard:b2->n_i4",
        "action:n_i4"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Models the compliance decision split, the compliant guard, and the continuation action."
    },
    {
      "refs": [
        "guard:b2->n_i5",
        "action:n_i5"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Correctly represents the phone resolution path and its outcome."
    },
    {
      "refs": [
        "guard:b2->n_i6",
        "action:n_i6"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Correctly represents the mail-back path and return outcome."
    },
    {
      "refs": [
        "guard:b3->n_i8",
        "action:n_i8"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Splits into the payment track, guarded appropriately, with matching action content."
    },
    {
      "refs": [
        "guard:b3->n_i9",
        "action:n_i9"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Covers the simultaneous billing track, modeled with a path guard and exact action content."
    },
    {
      "refs": [
        "action:n_i10"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Direct match; conditional wait modeled as an action step preserves behavior."
    },
    {
      "refs": [
        "action:n_i11"
      ],
      "verbatim_texts": [
        "If the invoice is returned, non-compliance is resolved."
      ],
      "justification": "Direct paraphrase of the resolution step."
    },
    {
      "refs": [
        "action:n_i12"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Direct match combining payment and notification."
    },
    {
      "refs": [
        "action:n_i13"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Covers the reminder action, process termination, and structural convergence of prior branches."
    },
    {
      "refs": [
        "action:n_i14"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved. However, if the client is satisfied, the process continues."
      ],
      "justification": "Client satisfaction check modeled as an action step preserves the decision behavior and flows to the final endpoint."
    }
  ],
