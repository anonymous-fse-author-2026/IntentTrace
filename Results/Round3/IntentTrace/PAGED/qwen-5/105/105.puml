@startuml
!theme plain
|a_default| Default
|a_default|
start
:make an appointment at the hairdresser's;
:go to the hairdresser's;
:v_svc: service type ({wash, dye, cut}); <<objectSignal>>
switch ()
case ([v_svc = "wash"])
:wash hair;
case ([v_svc = "dye"])
:dye hair;
case ([v_svc = "cut"])
:cut hair;
endswitch
:pay the hairdresser;
:You have completed this procedure;
stop
@enduml