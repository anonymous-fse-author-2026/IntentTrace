@startuml
!theme plain
|a_default| Default
|a_default|
start
:start process for WIGGO by placing an Order;
:Check the Customers Credit Limit;
:v1: Is Credit Limit Okay ({Okay, No}); <<objectSignal>>
if () then ([v1 = 'Okay'])
:Check the Availability of the Article;
:v3: Article Availability for Production ({Not Available, Available}); <<objectSignal>>
if () then ([v3 = 'Not Available'])
:Produce the Goods;
else ([v3 = 'Available'])
:Collect the Goods;
endif
:Send an Order Confirmation;
split
:Ship the Goods;
split again
:Send the Invoice;
end split
:Check the Payment status;
:v4: Has Payment been received ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:Close the Order due to Payment received;
:End process;
stop
else ([v4 = 'No'])
:Is Reminder count greater or equal to 3;
:v5: Is Reminder count greater or equal to 3 ({No, Yes}); <<objectSignal>>
if () then ([v5 = 'No'])
:Send a Reminder;
else ([v5 = 'Yes'])
:Write off the Order;
:Close the Order after Write off;
stop
endif
endif
else ([v1 = 'No'])
:Send a Denial to the Customer due to Credit Limit;
stop
endif
@enduml