{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "Initiates the process and captures the initial resupply trigger and inventory check steps."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "Models the low-inventory decision point. Guard v1='Yes' correctly aligns with the 'at or below minimum' condition leading to purchase order creation."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Models the sufficient-inventory outcome. Guard v1='No' correctly aligns with the 'above minimum' condition leading to process termination."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "The review step is modeled as a conditional check on purchase status, feeding into the next decision gateway. This is a behavior-preserving re-typing."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "Captures the rejection condition (v2='Yes') leading to the rework action."
    },
    {
      "refs": [
        "guard:b2->n_reserve",
        "action:n_reserve"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Captures the approval condition (v2='No') leading to fund reservation."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Models the post-rework review step. The rework action itself is already captured by n8 per the previous unit; redundancy does not change behavior."
    },
    {
      "refs": [
        "action:n_reserve",
        "action:n_send"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Combines the previously captured fund reservation with the subsequent step of sending the order to the supplier."
    },
    {
      "refs": [
        "action:n_recv_ps",
        "action:n_recv_inv"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Implements the simultaneous (AND gateway) reception of the packing slip and invoice."
    },
    {
      "refs": [
        "action:n_recv_ps",
        "action:n_rec_ps"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Sequentially models receiving and then recording the packing slip."
    },
    {
      "refs": [
        "action:n_recv_inv",
        "action:n_rec_inv"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Sequentially models receiving and then recording the invoice."
    },
    {
      "refs": [
        "action:n_rec_ps"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Recording the packing slip correctly concludes this process branch."
    },
    {
      "refs": [
        "action:n_rec_inv"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Recording the invoice correctly concludes this process branch."
    }
  ],
