    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is, you should then check if an HR Specialist is required."
      ],
      "justification": "Positive guard routes to the HR specialist check action, which opens the next XOR decision. Modelling choice preserves sequential flow."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
