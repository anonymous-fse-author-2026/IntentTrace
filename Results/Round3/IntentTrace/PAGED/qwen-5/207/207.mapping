{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, for CAB, the first step is to assess the change request."
      ],
      "justification": "Initiates the process and describes the first assessment step. Redundant phrasing in n1 and n2 preserves behaviour and is accepted as a match."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the affected systems for any impacts on the business unit"
      ],
      "justification": "Direct paraphrase of checking system impacts."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "determine whether the change request should be approved or not"
      ],
      "justification": "The action describes the decision point, which structurally bifurcates into a branch."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the change request should be approved in its current state, then it is approved."
      ],
      "justification": "Correctly captures the affirmative approval condition and resulting action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the change request should not be approved in its current state, further evaluation is needed to determine if the change will be acceptable with more information provided."
      ],
      "justification": "Correctly captures the negative approval condition leading to further evaluation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the change request is ultimately approved, the change is implemented."
      ],
      "justification": "Implementation step followed by termination of this path."
    },
    {
      "refs": [
        "action:n9_rej"
      ],
      "verbatim_texts": [
        "On the other hand, if the change is deemed unacceptable, it is rejected."
      ],
      "justification": "Direct match to the rejection outcome."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "a request for more information is made to the Change Coordinator."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "an email enquiry to the Change Coordinator."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the approval register is updated within a timeframe of 3 business days."
      ],
      "justification": "Direct match preserving the explicit 3-day timeframe."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The email enquiry is also forwarded to the Change Requester."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If there are no further inquiries or issues"
      ],
      "justification": "Structural branch and guard capture the condition for proceeding without inquiries."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "the process concludes after 3 business days."
      ],
      "justification": "Finalization step for the no-inquiries path, matching the stated duration."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "if there are inquiries from the CAB, a response is expected within 1-3 business days."
      ],
      "justification": "Captures the inquiry condition and the expected 1-3 day response window."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the response is received from the requester, it is forwarded to the CAB for further evaluation."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Based on the response, a final determination is made regarding the approval of the change request."
      ],
      "justification": "Final decision step and subsequent process termination."
    }
  ],
