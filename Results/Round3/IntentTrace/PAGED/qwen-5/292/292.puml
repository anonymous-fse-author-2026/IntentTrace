@startuml
!theme plain
|a_default| Default
|a_default|
start
:receive claim;
:create and record claim;
:decide on claim;
:v1: claim decision ({Reject, Accept}); <<objectSignal>>
if () then ([v1 = 'Reject'])
:reject claim;
:review rejection;
:continue the process;
split
:operate outgoing payment;
:close the claim;
split again
end split
stop
else ([v1 = 'Accept'])
:accept claim;
:offer benefit;
:prepare discharge;
:record payment;
split
split again
end split
endif
@enduml