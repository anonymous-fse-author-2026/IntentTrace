{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "Start node and first action correspond directly to the opening unit."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Direct paraphrase of the creation and recording step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "Decision step modeled as an action followed by an XOR gateway. Preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "Guard captures the rejection condition; action performs the rejection."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "Guard captures acceptance condition. Actions n9 and n10 together preserve the acceptance branch behaviour through harmless re-typing/splitting."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Follows the rejection path with the appropriate review step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Action matches the discharge preparation step on the acceptance path."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Action matches the payment recording step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process. But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Both sub-cases lead to continuing the process. Modeling this as a single 'continue the process' action correctly preserves the unified flow behaviour."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicit end point matches the process termination."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "Two actions in the model correspond to the two steps listed in the source unit. Content matches exactly."
    }
  ],
