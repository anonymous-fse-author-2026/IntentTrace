  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start with Orders Required and then place a Bulk order."
    },
    {
      "id": "i2",
      "content": "If the condition is \"Order with prior internal credit allowance\""
    },
    {
      "id": "i3",
      "content": "proceed with processing the order for delivery."
    },
    {
      "id": "i4",
      "content": "However, if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance."
    },
    {
      "id": "i5",
      "content": "a new order is placed and the process ends at the Warehouse."
    },
    {
      "id": "i6",
      "content": "If a new order is placed, it will be recorded in the Accounts Receivable."
    },
    {
      "id": "i7",
      "content": "If Payments are Received, the process continues."
    },
    {
      "id": "i8",
      "content": "However, if no payments are received, the order is dropped."
    },
    {
      "id": "i9",
      "content": "Next, identify the order for installation."
    },
    {
      "id": "i10",
      "content": "If the installation needs to be scheduled, an Installer will be assigned."
    },
    {
      "id": "i11",
      "content": "On the other hand, if the order does not require installation, it will be packed for delivery."
    }
  ]
}