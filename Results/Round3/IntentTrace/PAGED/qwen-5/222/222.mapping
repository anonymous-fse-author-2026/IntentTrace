      ],
      "justification": "Directly maps to the third validation check."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the batched invoices are allocated to the Data Entry Officer and this is done by 9 am on the next working day."
      ],
      "justification": "Captures the allocation step and its timing constraint."
    },
    {
      "refs": [
        "action:n7",
        "action:n8",
        "guard:b1->c1",
        "guard:b1->c2"
      ],
      "verbatim_texts": [
        "for the step \"Process invoice batch\", this should be repeated until all invoices are processed."
      ],
      "justification": "Models the required looping behavior for processing batches using a check node, XOR gateway, and feedback converges. Preserves the repetition logic."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "take it to the outbox."
      ],
      "justification": "Directly maps to moving the batch to the outbox."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "guard:b2->c2",
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "clear the outbox of the Data Entry Officer every hour. This process of clearing the outbox is done every hour until the outbox is completely cleared"
      ],
      "justification": "Models the hourly clearing loop and termination condition using an action, decision node, XOR gateway, and converges. Preserves the repetition and completion logic."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "which marks the end of the process."
      ],
      "justification": "Captures the finalization step and the explicit process termination point."
    }
