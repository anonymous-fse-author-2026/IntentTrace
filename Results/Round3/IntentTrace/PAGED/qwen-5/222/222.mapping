      "verbatim_texts": [
        "To start the SSP process, first ensure that the Invoice is ready for verification."
      ],
      "justification": "The opening unit implicitly starts the process and describes the initial preparation step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
