init(i1)
branch(b_ret, XOR)
action(n2, "Customer returns the items to the store")
action(n3, "Delivery Crew picks-up items at the event site")
converge(c1)
action(n4, "items are counted and compared to the original contract")
branch(b_status, XOR)
action(n5, "Order is complete and all items were returned")
action(n6, "Order is incomplete and items are missing")
action(n7, "Order is complete but items are damaged, email customer")
converge(c_st)
branch(b_dest1, XOR)
action(n8, "Items are packed for an existing order")
action(n9, "Items are stored for future orders")
converge(c_dst)
branch(b_post, XOR)
action(n10, "email customer to inform them of missing items and replacement charges")
action(n_proc, "proceed with the process")
branch(b_cust, XOR)
action(n12, "Customer returns the missing items")
action(n13, "Customer does not return the missing items")
action(n11, "temporarily take damaged items out of inventory")
branch(b_repair, XOR)
action(n15, "Items are repaired and added into inventory")
action(n16, "Items can't be repaired and are discarded")
converge(c_dest2_join)
branch(b_dest2, XOR)
action(n17, "Items are packed for an existing order")
action(n18, "Items are stored for future orders")
action(n20, "email customer with replacement charges")
end(e1)
end(e2)
end(e3)
