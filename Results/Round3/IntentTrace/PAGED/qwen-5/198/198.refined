init(i1)
action(n2, "identify the parts")
action(n3, "already have availability information")
action(n4, "check availability of parts")
action(n5, "parts supplied to customer")
branch(b1, XOR)
action(n6, "order and receive part from Disuki")
action(n7, "contract the customer")
action(n8, "proceed with payment")
action(n9, "end process")
end(e1)
converge(c1)
defines(v1, "branch_condition", {"ElicitInfo", "HaveAvail", "PartsSupplied", "RecordDetails", "Direct"})
defines(v2, "needs to record the customer's details", {"Yes", "No"})
actor(a_default, "Default", [i1, n2, n3, n4, n5, b1, n6, n7, n8, n9, e1, c1])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(b1, n5)
precedence(b1, n6)
precedence(b1, c1)
precedence(n3, c1)
precedence(n4, c1)
precedence(n5, c1)
precedence(n6, c1)
precedence(c1, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, e1)
guard(b1, n3, v1 = 'HaveAvail')
guard(b1, n4, v1 = 'ElicitInfo')
guard(b1, n5, v1 = 'PartsSupplied')
guard(b1, n6, v1 = 'RecordDetails')
guard(b1, c1, v1 = 'Direct')