{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "Start node and first action correctly capture the initial step described in the text."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer, they should then check the availability of the parts."
      ],
      "justification": "Establishes the XOR gateway and models the first conditional branch and its associated action. Variable assignment preserves the decision logic."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "On the other hand, if they already have the availability information, they can proceed with the process."
      ],
      "justification": "Models the second condition and implicit continuation step. Re-typing a condition as an action preserves behaviour and is a match."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer, the team can also continue with the process."
      ],
      "justification": "Captures the third condition and resulting state accurately. Condition-to-action re-typing does not change behaviour."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if they need to record the customer's details, they should order and receive the part from Disuki."
      ],
      "justification": "Fourth condition and corresponding action are faithfully represented."
    },
    {
      "refs": [
        "guard:b1->c1",
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "Convergence joins the alternative paths. The direct guard is structural plumbing for continuation. The subsequent action correctly captures contracting the customer."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected, the team can proceed with the payment."
      ],
      "justification": "Payment step directly matches the source text. Precondition is handled implicitly by the process flow."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "Final step and termination node correctly model the conclusion of the process."
    }
  ],
