@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process by identifying the vacancy;
:Is there a suitable candidate available;
:v1: Is there a suitable candidate available ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:advertise the vacancy;
else ([v1 = 'Yes'])
:Is there a suitable candidate available;
endif
:v2: Is there a suitable candidate available ({ReAdv, Proceed}); <<objectSignal>>
if () then ([v2 = 'Proceed'])
->;
else ([v2 = 'ReAdv'])
:advertise the vacancy again;
endif
:select the appropriate applicant;
:appoint the candidate;
:process ends;
stop
@enduml