init(start)
action(i1, "The process starts with an informational meeting that lasts half a day")
branch(b_meeting, XOR)
action(i2, "If the meeting is successful,")
action(i3, "work on the storyboard, which takes a full day")
action(i5, "If the storyboard is successful,")
action(i6, "the next steps are site design")
branch(b4, AND)
action(i7, "site design, which takes 10 days")
action(i8, "and preparing the content.")
action(i9, "preparing the content")
converge(c1)
action(i10, "After that,")
action(i11, "the site development takes 2 days")
action(i12, "goes through a review process that lasts 1 day.")
action(i13, "If the review is successful,")
action(i14, "moves on to the approval stage, which takes half a day.")
branch(b_app, XOR)
action(i15, "If the approval is complete,")
converge(c_reb)
action(i16, "the site needs to be rebuilt, which takes 3 days.")
branch(b_reb, XOR)
action(i17, "If the rebuild is complete,")
action(i18, "the site needs to be rebuilt again, which also takes 3 days.")
converge(c_end)
action(i4, "the process ends.")
end(e1)

defines(v_meeting, "Is the meeting successful?", {"Yes", "No"})
defines(v_app, "Is the approval complete?", {"Yes", "No"})
defines(v_reb, "Is the rebuild complete?", {"Yes", "No"})

actor(a_default, "Default", [start, i1, b_meeting, i2, i3, i5, i6, b4, i7, i8, i9, c1, i10, i11, i12, i13, i14, b_app, i15, c_reb, i16, b_reb, i17, i18, c_end, i4, e1])

precedence(start, i1)
precedence(i1, b_meeting)

precedence(b_meeting, i2)
guard(b_meeting, i2, v_meeting = "Yes")

precedence(b_meeting, c_end)
guard(b_meeting, c_end, v_meeting = "No")

precedence(i2, i3)
precedence(i3, i5)
precedence(i5, i6)
precedence(i6, b4)

precedence(b4, i7)
precedence(b4, i8)

precedence(i7, c1)

precedence(i8, i9)
precedence(i9, c1)

precedence(c1, i10)
precedence(i10, i11)
precedence(i11, i12)
precedence(i12, i13)
precedence(i13, i14)
precedence(i14, b_app)

precedence(b_app, i15)
guard(b_app, i15, v_app = "Yes")

precedence(b_app, c_reb)
guard(b_app, c_reb, v_app = "No")

precedence(i15, c_end)

precedence(c_reb, i16)
precedence(i16, b_reb)

precedence(b_reb, i17)
guard(b_reb, i17, v_reb = "Yes")

precedence(b_reb, i18)
guard(b_reb, i18, v_reb = "No")

precedence(i17, c_end)
precedence(i18, c_reb)

precedence(c_end, i4)
precedence(i4, e1)