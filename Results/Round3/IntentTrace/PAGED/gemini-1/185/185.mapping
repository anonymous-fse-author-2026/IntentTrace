{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "the process begins by receiving the invoice"
      ],
      "justification": "Starts the process and models the initial receipt step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "it is sorted per client"
      ],
      "justification": "Direct action match for sorting per client."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor"
      ],
      "justification": "Direct action match for sorting per vendor."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n8",
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Maps the gateway for completeness, the negative path branch/guard, and the subsequent end."
    },
    {
      "refs": [
        "action:n7",
        "guard:b1->n7",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered."
      ],
      "justification": "Maps the positive branch guard, the conditional restatement, and the resulting SLA entry action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The date for completion is also entered"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the priority is checked"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n12",
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "If the priority is high"
      ],
      "justification": "Opens the priority branch and models the 'high' path condition."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "a red stamp is placed on the entry invoice"
      ],
      "justification": "Direct action match for the 'high' priority outcome."
    },
    {
      "refs": [
        "action:n13",
        "guard:b2->n13"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Maps the 'low' priority path and logically merges the flow back together."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n17",
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "If it is not complete, the check continues."
      ],
      "justification": "Opens the compliance branch and correctly maps the 'not complete' condition."
    },
    {
      "refs": [
        "action:n18",
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "If it is complete, the process continues."
      ],
      "justification": "Maps the 'complete' path condition."
    },
    {
      "refs": [
        "action:n20",
        "guard:b4->n20",
        "guard:b3->b4"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff"
      ],
      "justification": "Structurally links to the next decision gateway and maps the 'experienced staff' condition."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "the non-compliance invoice is processed"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n21",
        "guard:b4->n21"
      ],
      "verbatim_texts": [
        "If it is a normal case"
      ],
      "justification": "Maps the 'normal case' condition."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "the client is called"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n24",
        "guard:b4->n24"
      ],
      "verbatim_texts": [
        "If none of these conditions apply"
      ],
      "justification": "Maps the default/else condition correctly."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "a postal mail is sent requesting complete information and the process ends"
      ],
      "justification": "Models the action of sending mail and explicitly ends the flow."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Merges the compliance flows back together and triggers the final call client action."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Properly models the final process termination."
    }
  ],
