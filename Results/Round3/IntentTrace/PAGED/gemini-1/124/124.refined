init(i1)
action(n2, "look at the order")
branch(b1, XOR)
action(i3, "the process should continue")
action(i5, "the process should also continue")
action(i6, "At the same time, two steps need to be completed:")
branch(b_and, AND)
action(n4, "preparing the assembling order")
action(n5, "checking availability")
branch(b2, XOR)
action(n7, "availability needs to be checked again")
action(n8, "the process ends")
end(e_loop)
converge(c2)
action(n9, "assemble the bike")
action(n10, "ship the product")
end(e2)
defines(v1, "order status", {"Accepted", "Rejected"})
defines(v2, "backorder?", {"Yes", "No"})
actor(a_default, "Default", [i1, n2, b1, i3, i5, i6, b_and, n4, n5, b2, n7, n8, e_loop, c2, n9, n10, e2])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, i3)
precedence(i3, e2)
precedence(b1, i5)
precedence(i5, i6)
precedence(i6, b_and)
precedence(b_and, n4)
precedence(b_and, n5)
precedence(n4, c2)
precedence(n5, b2)
precedence(b2, n7)
precedence(n7, n8)
precedence(n8, e_loop)
precedence(b2, c2)
precedence(c2, n9)
precedence(n9, n10)
precedence(n10, e2)
guard(b1, i5, v1 = 'Accepted')
guard(b1, i3, v1 = 'Rejected')
guard(b2, n7, v2 = 'Yes')
guard(b2, c2, v2 = 'No')