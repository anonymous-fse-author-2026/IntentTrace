@startuml
!theme plain
|a_default| Default
|a_default|
start
:To begin the process for WIGGO,;
:placing an Order;
:Check the Customer's Credit Limit;
:v1: Credit Limit Okay ({No, Okay}); <<objectSignal>>
if () then ([v1 = 'No'])
->;
else ([v1 = 'Okay'])
:Check the Availability of the Article;
:v2: Article Available ({Okay, No, Not available, Available}); <<objectSignal>>
switch ()
case ([v2 = 'No'])
case ([v2 = 'Okay'])
:Check the Availability of the Article;
stop
case ([v2 = 'Not available'])
:Produce the Goods;
:send an Order Confirmation;
split
:Ship the Goods;
split again
:Send the Invoice;
end split
:Check the Payment status;
:v3: Payment Received ({Received, Not received}); <<objectSignal>>
if () then ([v3 = 'Received'])
:Close the Order;
:End;
stop
else ([v3 = 'Not received'])
:Check if the Reminder count is greater than or equal to 3;
:v4: Reminder Count Ge 3 ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:Write Off the Order;
:Close the Order;
:End;
stop
else ([v4 = 'No'])
:Additionally, send a Reminder;
endif
endif
case ([v2 = 'Available'])
:Collect the Goods;
endswitch
endif
:Send Denial To Customer;
stop
@enduml