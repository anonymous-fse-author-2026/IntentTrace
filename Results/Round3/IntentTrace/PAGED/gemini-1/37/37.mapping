  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Initializes the process and correctly captures the opening step."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "Check the Customer's Credit Limit"
      ],
      "justification": "Models the credit check. The extra action explicitly stating the condition is a harmless rewording/redundancy."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the response",
        "is \"Okay\"",
        "if the response is \"No\""
      ],
      "justification": "Accurately splits the flow based on the credit check outcome."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the response",
        "is \"Okay\"",
        "if the response is \"No\""
      ],
      "justification": "Accurately splits the flow based on the credit check outcome."
    },
    {
      "refs": [
        "action:n4",
        "action:n6"
      ],
      "verbatim_texts": [
        "Check the Availability of the Article"
      ],
      "justification": "Models the first availability check, accommodating the redundant conditional check."
    },
    {
      "refs": [
        "action:n5",
        "action:n7"
      ],
      "verbatim_texts": [
        "send a Denial to the Customer"
      ],
      "justification": "Properly triggers a denial in the respective negative paths."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "if the response"
      ],
      "justification": "Branches correctly based on the outcome of the first article availability check."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the response is \"No\""
      ],
      "justification": "Branches correctly based on the outcome of the first article availability check."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Check the Availability of the Article again"
      ],
      "justification": "Models the second availability check correctly."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If the Article is",
        "not available",
        "available"
      ],
      "justification": "Splits the flow according to whether the article is found available on the second check."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If the Article is",
        "not available",
        "available"
      ],
      "justification": "Splits the flow according to whether the article is found available on the second check."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Produce the Goods"
      ],
      "justification": "Direct match for the negative availability path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Collect the Goods"
      ],
      "justification": "Direct match for the positive availability path."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "send an Order Confirmation"
      ],
      "justification": "Sends the order confirmation as described."
