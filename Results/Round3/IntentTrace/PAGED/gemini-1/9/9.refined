init(init_node)
action(i1, "In the beginning, the process starts with Bill for Purchased Goods/Services")
action(i2, "Receive Invoice")
branch(b_after_i2, XOR)
action(i3, "If the invoice is incomplete")
action(i4, "it is returned")
action(i5, "if the invoice is complete")
action(i6, "the process continues")
branch(b_after_i6, XOR)
action(i7, "If the invoice is non-compliant")
action(i8, "further checks are conducted")
branch(b_after_i8, XOR)
action(i12, "if the issue requires mail back")
action(i13, "the invoice is returned")
action(i10, "If the issue can be resolved with a phone call")
converge(c_before_i11)
action(i11, "non-compliance is resolved")
action(i9, "if the invoice is compliant")
converge(c_before_i14)
action(i14, "the invoice is paid")
branch(b14, AND)
branch(b_returned, XOR)
action(i15, "if it is returned")
action(i16, "Bill Client")
branch(b_after_bill, XOR)
action(i17, "If there is no response")
action(i18, "a period of 10 days is given")
action(i21, "After 10 days, a reminder is sent")
action(i19, "If the invoice is returned")
action(i20, "The invoice is paid and the client is notified of the payment")
branch(b_after_i20, XOR)
action(i23, "If the client is unsatisfied")
action(i24, "payment discrepancy is resolved")
action(i25, "if the client is satisfied")
converge(c_before_i22)
action(i22, "the process ends")
end(e1)
end(e2)
defines(v_inv, "Invoice completeness", {"incomplete", "complete"})
defines(v_comp, "Invoice compliance", {"non-compliant", "compliant"})
defines(v_issue, "Issue resolution", {"mail back", "phone call"})
defines(v14, "Is it returned after payment?", {"Yes", "No"})
defines(v_bill, "Client response", {"no response", "returned", "paid"})
defines(v_client, "Client satisfaction", {"unsatisfied", "satisfied"})
actor(a_default, "Default", [init_node, i1, i2, b_after_i2, i3, i4, i5, i6, b_after_i6, i7, i8, b_after_i8, i12, i13, i10, c_before_i11, i11, i9, c_before_i14, i14, b14, b_returned, i15, i16, b_after_bill, i17, i18, i21, i19, i20, b_after_i20, i23, i24, i25, c_before_i22, i22, e1, e2])
precedence(init_node, i1)
precedence(i1, i2)
precedence(i2, b_after_i2)
precedence(b_after_i2, i3)
precedence(i3, i4)
precedence(i4, e1)
precedence(b_after_i2, i5)
precedence(i5, i6)
precedence(i6, b_after_i6)
precedence(b_after_i6, i7)
precedence(i7, i8)
precedence(i8, b_after_i8)
precedence(b_after_i8, i12)
precedence(i12, i13)
precedence(i13, e1)
precedence(b_after_i8, i10)
precedence(i10, c_before_i11)
precedence(b_after_i6, i9)
precedence(i9, c_before_i14)
precedence(c_before_i11, i11)
precedence(i11, c_before_i14)
precedence(c_before_i14, i14)
precedence(i14, b14)
precedence(b14, b_returned)
precedence(b14, i16)
precedence(b_returned, i15)
precedence(b_returned, e2)
precedence(i15, c_before_i11)
precedence(i16, b_after_bill)
precedence(b_after_bill, i17)
precedence(i17, i18)
precedence(i18, i21)
precedence(i21, c_before_i22)
precedence(b_after_bill, i19)
precedence(i19, c_before_i11)
precedence(b_after_bill, i20)
precedence(i20, b_after_i20)
precedence(b_after_i20, i23)
precedence(i23, i24)
precedence(i24, e1)
precedence(b_after_i20, i25)
precedence(i25, c_before_i22)
precedence(c_before_i22, i22)
precedence(i22, e1)
guard(b_after_i2, i3, v_inv = 'incomplete')
guard(b_after_i2, i5, v_inv = 'complete')
guard(b_after_i6, i7, v_comp = 'non-compliant')
guard(b_after_i6, i9, v_comp = 'compliant')
guard(b_after_i8, i12, v_issue = 'mail back')
guard(b_after_i8, i10, v_issue = 'phone call')
guard(b_returned, i15, v14 = 'Yes')
guard(b_returned, e2, v14 = 'No')
guard(b_after_bill, i17, v_bill = 'no response')
guard(b_after_bill, i19, v_bill = 'returned')
guard(b_after_bill, i20, v_bill = 'paid')
guard(b_after_i20, i23, v_client = 'unsatisfied')
guard(b_after_i20, i25, v_client = 'satisfied')