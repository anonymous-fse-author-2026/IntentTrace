precedence(n11, e3)
precedence(n12, b5)
precedence(b5, n16)
precedence(b5, n17)
precedence(n16, e5)
precedence(n17, e5)
guard(b1, n3, v1 = 'No')
guard(b1, n4, v1 = 'Yes')
guard(b3, n11, v3 = 'Complete')
guard(b3, n12, v3 = 'Rejected')
guard(b5, n16, v5 = 'Complete')
guard(b5, n17, v5 = 'Rejected again')