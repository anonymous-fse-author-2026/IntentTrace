init(i1)
action(n1, "Start with an informational meeting that lasts half a day, involving the customer and the web design team.")
branch(b1, XOR)
action(n3, "End process")
end(e1)
action(n4, "Work on the storyboard which takes a full day and involves the customer and the web design team.")
branch(b6, AND)
action(n5, "Prepare the content")
action(n6, "Site design which takes 10 days and is done by the web design team")
converge(c1)
action(n7, "Site development which takes 2 days and is also done by the web design team.")
action(n8, "Go through a review process that lasts 1 day.")
action(n10, "Approval stage which takes half a day.")
branch(b3, XOR)
action(n11, "The process ends.")
end(e3)
action(n12, "Rebuild the site which takes 3 days.")
branch(b5, XOR)
action(n16, "The process ends.")
end(e5)
action(n17, "Rebuild the site again which also takes 3 days.")
defines(v1, "informational meeting", {"Yes", "No"})
defines(v3, "approval complete", {"Complete", "Rejected"})
defines(v5, "rebuild complete", {"Complete", "Rejected again"})
actor(a_default, "Default", [i1, b1, n3, e1, b6, n5, c1, n8, n10, b3, n11, e3, n12, b5, n16, e5, n17])
actor(a_customer_web_design, "Customer and Web Design Team", [n1, n4])
actor(a_web_design, "Web Design Team", [n6, n7])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, e1)
precedence(n4, b6)
precedence(b6, n5)
precedence(b6, n6)
precedence(n5, c1)
precedence(n6, c1)
