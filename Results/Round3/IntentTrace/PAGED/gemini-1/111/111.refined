init(i1)
action(n1, "Check the loan application")
branch(b1, XOR)
action(n5, "Disburse funds")
end(e1)
end(e2)
defines(v1, "Application outcome", {"Rejected", "Special terms"})
actor(a_default, "Default", [i1, n1, b1, n5, e1, e2])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, e1)
precedence(b1, n5)
precedence(n5, e2)
guard(b1, e1, v1 = 'Rejected')
guard(b1, n5, v1 = 'Special terms')