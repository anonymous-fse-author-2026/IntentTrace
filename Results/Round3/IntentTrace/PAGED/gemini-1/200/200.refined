init(i1)
action(n1, "Start Process")
action(i2, "start by placing an order")
action(n2, "Check Customer Eligibility")
branch(b1, XOR)
action(n3, "Inform Ineligible Customer")
action(n4, "End Process - Ineligible")
end(e1)
action(n5, "Open New Order in ERP System")
action(n6, "Perform Availability Check")
branch(b2, XOR)
action(i10, "start producing the missing parts")
action(i11, "continue the process")
converge(c_avail)
action(n8, "Prepare Products for Shipment")
branch(b6, AND)
action(n10, "Ship Products")
action(n11, "Send Invoice")
converge(c_pay)
action(n12, "Check Payment Status")
branch(b3, XOR)
converge(c_end_order)
action(n14, "close the order")
end(e2)
action(n15, "Send Payment Reminder")
action(n16, "Check Number of Reminders")
branch(b4, XOR)
action(n18, "inform the lawyer and end the process.")
end(e3)
action(n20, "Otherwise, if the payment is not received, send a reminder and close the order, ending the process.")
end(e4)

defines(v1, "Check Customer Eligibility", {"Eligible", "Not Eligible"})
defines(v2, "Perform Availability Check", {"Available", "Not Available"})
defines(v3, "Check Payment Status", {"Received", "Not Received", "Not Received (Close)"})
defines(v4, "Check Number of Reminders", {"< 3", "== 3"})

actor(a_default, "Default", [i1, n1, i2, n2, b1, n3, n4, e1, n5, n6, b2, i10, i11, c_avail, n8, b6, n10, n11, c_pay, n12, b3, c_end_order, n14, e2, n15, n16, b4, n18, e3, n20, e4])

precedence(i1, n1)
precedence(n1, i2)
precedence(i2, n2)
precedence(n2, b1)

precedence(b1, n3)
guard(b1, n3, v1 = "Not Eligible")
precedence(n3, n4)
precedence(n4, e1)

precedence(b1, n5)
guard(b1, n5, v1 = "Eligible")
precedence(n5, n6)
precedence(n6, b2)

precedence(b2, i10)
guard(b2, i10, v2 = "Not Available")
precedence(i10, c_avail)

precedence(b2, i11)
guard(b2, i11, v2 = "Available")
precedence(i11, c_avail)

precedence(c_avail, n8)
precedence(n8, b6)

precedence(b6, n10)
precedence(n10, c_end_order)

precedence(b6, n11)
precedence(n11, c_end_order)

precedence(b6, c_pay)
precedence(c_pay, n12)
precedence(n12, b3)

precedence(b3, c_end_order)
guard(b3, c_end_order, v3 = "Received")
precedence(c_end_order, n14)
precedence(n14, e2)

precedence(b3, n15)
guard(b3, n15, v3 = "Not Received")
precedence(n15, n16)
precedence(n16, b4)

precedence(b3, n20)
guard(b3, n20, v3 = "Not Received (Close)")
precedence(n20, e4)

precedence(b4, c_pay)
guard(b4, c_pay, v4 = "< 3")

precedence(b4, n18)
guard(b4, n18, v4 = "== 3")
precedence(n18, e3)