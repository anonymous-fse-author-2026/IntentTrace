{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "Starts the process."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "start by placing an order"
      ],
      "justification": "Places an order."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check the customer"
      ],
      "justification": "Checks customer eligibility."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\""
      ],
      "justification": "Decision gateway and condition for ineligible customer."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "inform them"
      ],
      "justification": "Action to inform the customer."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Ends the process for ineligible customers."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "open a new order in the ERP system"
      ],
      "justification": "Eligible customer path opening a new order."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "perform an availability check"
      ],
      "justification": "Availability check step."
    },
    {
      "refs": [
        "guard:b2->i10"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Decision for product not available."
    },
    {
      "refs": [
        "action:i10"
      ],
      "verbatim_texts": [
        "start producing the missing parts"
      ],
      "justification": "Producing missing parts."
    },
    {
      "refs": [
        "guard:b2->i11",
        "action:i11"
      ],
      "verbatim_texts": [
        "continue the process"
      ],
      "justification": "Condition and action to continue process if available."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Joins paths and prepares for shipment."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "Parallel gateway for shipping and invoicing."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "ship the products"
      ],
      "justification": "Ships the products."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "send the invoice"
      ],
      "justification": "Sends the invoice."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "checking for payment"
      ],
      "justification": "Joins paths and checks for payment."
    },
    {
      "refs": [
        "guard:b3->c_end_order"
      ],
      "verbatim_texts": [
        "If the payment is received"
      ],
      "justification": "Decision and condition for received payment."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "close the order"
      ],
      "justification": "Closes order and ends the path."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "send a reminder"
      ],
      "justification": "Condition and action for not received payment."
    },
    {
      "refs": [
        "guard:b3->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "Otherwise, if the payment is not received, send a reminder and close the order, ending the process."
      ],
      "justification": "Alternative condition ending the process after reminder."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->c_pay"
      ],
      "verbatim_texts": [
        "If the number of reminders"
      ],
      "justification": "Checks reminder count and loops back if under threshold."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "inform the lawyer and end the process."
      ],
      "justification": "Informs lawyer and ends the process if threshold reached."
    }
  ],
