      ],
      "verbatim_texts": [
        "start the process"
      ],
      "justification": "Initiates the process directly corresponding to the source text."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "empty the mailbox"
      ],
      "justification": "Direct match for emptying the mailbox."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "Captures the step and the subsequent decision point for checking the mailbox."
    },
    {
      "refs": [
        "guard:b1->n19",
        "guard:b5->n5"
      ],
      "verbatim_texts": [
        "if not"
      ],
      "justification": "Matches the negative conditions of the mailbox checks."
    },
    {
      "refs": [
        "guard:b1->c3",
        "guard:b5->c3"
      ],
      "verbatim_texts": [
        "If it is empty"
      ],
      "justification": "Matches the positive condition where the mailbox is empty, which converges to the end event."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Matches the termination step of the process for the empty mailbox scenario."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again"
      ],
      "justification": "Matches the second check on the mailbox and its associated decision gateway."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Captures the information completeness check and the branching point for the outcome."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If it is complete"
      ],
      "justification": "Captures the positive guard condition for complete information."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Direct match for the action taken when information is complete."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If it is not complete"
      ],
      "justification": "Captures the negative guard condition for incomplete information."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "make a telephone call to the sender."
      ],
      "justification": "Direct match for the action taken when information is incomplete."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Direct match for the follow-up step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "The convergence step joins the previous complete/incomplete flows to execute this action."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member"
      ],
      "justification": "Matches the decision node and the positive branch for successful membership."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member"
      ],
      "justification": "Matches the negative branch for unsuccessful membership."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "write to them and inform them of the decision."
      ],
      "justification": "Direct match for the rejection path and its subsequent end point."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "write the data."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "Simultaneously,"
      ],
      "justification": "Translates to the AND gateway indicating parallel actions."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "calculate the fee"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "hand the letter to Charles. Ask Charles to write the amount in the register."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Joins the concurrent flows and executes the membership card step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Matches the termination steps for the successful process."
    },
    {
      "refs": [
        "action:n24"
      ],
