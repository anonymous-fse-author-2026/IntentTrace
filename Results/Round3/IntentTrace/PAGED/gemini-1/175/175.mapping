{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Models the start of the process corresponding directly to the input."
    },
    {
      "refs": [
        "action:i2",
        "guard:b1->i2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\""
      ],
      "justification": "Initiates the branch and defines the condition and step for the customer return path."
    },
    {
      "refs": [
        "action:i3",
        "guard:b1->i3"
      ],
      "verbatim_texts": [
        "if the \"Delivery Crew picks-up items at the event site,\""
      ],
      "justification": "Defines the condition and step for the delivery crew pickup and subsequently converges the paths."
    },
    {
      "refs": [
        "action:i4"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Matches the action of counting and comparing items."
    },
    {
      "refs": [
        "action:i5",
        "guard:b2->i5"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\""
      ],
      "justification": "Opens the branch and covers the complete/returned scenario."
    },
    {
      "refs": [
        "action:i6",
        "guard:b2->i6"
      ],
      "verbatim_texts": [
        "if the \"Order is incomplete and items are missing,\""
      ],
      "justification": "Matches the condition for incomplete missing orders."
    },
    {
      "refs": [
        "action:i7",
        "guard:b2->i7"
      ],
      "verbatim_texts": [
        "Similarly, if the \"Order is complete but items are damaged,\""
      ],
      "justification": "Matches the condition for complete but damaged items."
    },
    {
      "refs": [
        "action:i8"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Direct match for the email action."
    },
    {
      "refs": [
        "action:i9",
        "guard:b3->i9"
      ],
      "verbatim_texts": [
        "if the \"Items are packed for an existing order,\""
      ],
      "justification": "Branches and matches the packed items condition."
    },
    {
      "refs": [
        "action:i10",
        "guard:b3->i10"
      ],
      "verbatim_texts": [
        "if the \"Items are stored for future orders,\""
      ],
      "justification": "Matches the stored items condition and converges the branch."
    },
    {
      "refs": [
        "action:i11"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Direct match for the customer email regarding replacement charges."
    },
    {
      "refs": [
        "action:i12"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges,"
      ],
      "justification": "Models the condition logically."
    },
    {
      "refs": [
        "action:i13"
      ],
      "verbatim_texts": [
        "temporarily take them out of inventory."
      ],
      "justification": "Matches the action of removing from inventory."
    },
    {
      "refs": [
        "action:i14",
        "guard:b4->i14"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "Branches and models the customer return condition."
    },
    {
      "refs": [
        "action:i15",
        "guard:b4->i15"
      ],
      "verbatim_texts": [
        "if the \"Customer does not return the missing items,\""
      ],
      "justification": "Models the non-return condition."
    },
    {
      "refs": [
        "action:i16"
      ],
      "verbatim_texts": [
        "when the process is complete, it ends."
      ],
      "justification": "Matches the process termination step."
    },
    {
      "refs": [
        "action:i17",
        "guard:b5->i17"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\""
      ],
      "justification": "Models the branch and repaired items condition."
    },
    {
      "refs": [
        "action:i18",
        "guard:b5->i18"
      ],
      "verbatim_texts": [
        "On the other hand, if the \"Items can't be repaired and are discarded,\""
      ],
      "justification": "Matches the discarded items condition correctly."
    },
    {
      "refs": [
        "action:i19"
      ],
      "verbatim_texts": [
        "we email the customer with replacement charges."
      ],
      "justification": "Direct action match and convergence."
    },
    {
      "refs": [
        "action:i20"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order."
      ],
      "justification": "Direct match for the final packing step."
    },
    {
      "refs": [
        "action:i21",
        "guard:b6->i21"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\""
      ],
      "justification": "Matches branch and condition."
    },
    {
      "refs": [
        "action:i22",
        "guard:b6->i22"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\""
      ],
      "justification": "Matches branch condition and converges."
    },
    {
      "refs": [
        "action:i23"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Matches the completion/end point."
    },
    {
      "refs": [
        "action:i24"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges"
      ],
      "justification": "Direct match for customer email action."
    },
    {
      "refs": [
        "action:i25"
      ],
      "verbatim_texts": [
        "and the process is complete."
      ],
      "justification": "Matches final termination node."
    }
  ],
  "mutations": [],
  "omissions": [],
  "additions": [],
