    },
    {
      "id": "c1",
      "type": "converge"
    },
    {
      "id": "i4",
      "type": "action",
      "content": "During this step, the items are counted and compared to the original contract."
    },
    {
      "id": "b2",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i5",
      "type": "action",
      "content": "If the \"Order is complete and all items were returned,\""
    },
    {
      "id": "i6",
      "type": "action",
      "content": "if the \"Order is incomplete and items are missing,\""
    },
    {
      "id": "i7",
      "type": "action",
      "content": "Similarly, if the \"Order is complete but items are damaged,\""
    },
    {
      "id": "b3",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i9",
      "type": "action",
      "content": "if the \"Items are packed for an existing order,\""
    },
    {
      "id": "i10",
      "type": "action",
      "content": "if the \"Items are stored for future orders,\""
    },
    {
      "id": "c4",
      "type": "converge"
    },
    {
      "id": "i16",
      "type": "action",
      "content": "when the process is complete, it ends."
    },
    {
      "id": "e1",
      "type": "end"
    },
    {
      "id": "i11",
      "type": "action",
      "content": "In case of missing items and replacement charges, we email the customer to inform them."
