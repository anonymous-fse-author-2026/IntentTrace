      ],
      "justification": "Negative conditions corresponding to the various checks (schedule and ticket orders) throughout the process."
    },
    {
      "refs": [
        "action:n_i10",
        "guard:b2->n_i10"
      ],
      "verbatim_texts": [
        "If it is"
