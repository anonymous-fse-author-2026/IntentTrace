{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process for the election of a rector, it is necessary to begin with the rector's final year in their current position."
      ],
      "justification": "Starts the process and captures the first action of beginning with the rector's final year."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "the acceptance of proposals for candidates for the rector position should be launched."
      ],
      "justification": "Direct match for launching the acceptance of proposals."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the rector can nominate themselves as a candidate for the position."
      ],
      "justification": "Direct match for the rector self-nominating."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the acceptance of proposals should be stopped."
      ],
      "justification": "Direct match for stopping the acceptance."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1->n6",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If a candidate meets the required criteria"
      ],
      "justification": "Models the condition about meeting criteria, splitting the flow into positive and negative branches."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should be included in the list of candidates."
      ],
      "justification": "Positive outcome of the criteria check."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they should be informed of the refusal and the process will come to an end."
      ],
      "justification": "Negative outcome of the criteria check and the resulting process end."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "it should be made public."
      ],
      "justification": "Making the list public."
    },
    {
      "refs": [
        "action:n_sim"
      ],
      "verbatim_texts": [
        "Simultaneously,"
      ],
      "justification": "The word indicating parallel execution supports the AND branch, its eventual convergence, and the re-typed action node."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the candidates should promote their ideas to the public"
      ],
      "justification": "First parallel action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "organize a public meeting of the Academic Senate."
      ],
      "justification": "Second parallel action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The public meeting should then commence, ensuring that all members are able to vote for a new rector."
      ],
      "justification": "Action following the parallel branches."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Following the meeting, an election should be conducted and the votes should be counted."
      ],
      "justification": "The main election step, which also serves as the structural merge point for the 'another election' loop."
    },
    {
      "refs": [
        "action:n13",
        "guard:b2->n13",
        "guard:b2->n14"
      ],
      "verbatim_texts": [
        "If the voting fails"
      ],
      "justification": "Establishes the XOR split evaluating the success of the voting, including the condition modeled as an action and its guards."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "another election should be conducted."
      ],
      "justification": "The fallback loop action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "the result of the election should be announced."
      ],
      "justification": "Action taken when the voting does not fail."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "the public meeting should be concluded"
      ],
      "justification": "Direct match for concluding the meeting."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "the candidate should be informed of the election results"
      ],
      "justification": "Direct match for informing the candidate."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "marking the end of the process."
      ],
      "justification": "Explicitly marks the end of the entire process."
    }
  ],
