init(i1)
action(n1, "start")
action(n2, "Bill for Purchased Goods/Services and then Receive Invoice")
branch(b_and, AND)
branch(b1, XOR)
action(n4, "Return invoice due to incompleteness")
action(n7, "Is the invoice non-compliant?")
action(n6, "further checks are conducted")
branch(b2, XOR)
action(n8, "Resolve non-compliance via phone call")
action(n9, "Return invoice due to mail back requirement")
action(n10, "if it is returned, non-compliance is resolved.")
action(n12, "Bill Client")
branch(b3, XOR)
action(n13, "Is there no response from client?")
action(n14, "Give 10 days waiting period")
action(n15, "After 10 days, a reminder is sent and the process ends.")
action(n11, "Pay the invoice and notify client of payment")
branch(b4, XOR)
action(n16, "Resolve payment discrepancy if client is unsatisfied")
action(n17, "Continue process if client is satisfied")
end(e_end)
defines(v1, "Invoice Evaluation", {"Incomplete", "Non-compliant"})
defines(v2, "Resolution Method", {"Phone call", "Mail back"})
defines(v3, "Client Response", {"No response", "Response received"})
defines(v4, "Client Satisfaction", {"Unsatisfied", "Satisfied"})
actor(a_default, "Default", [i1, n1, n2, b_and, b1, n4, n7, n6, b2, n8, n9, n10, n12, b3, n13, n14, n15, n11, b4, n16, n17, e_end])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b_and)
precedence(b_and, b1)
precedence(b_and, n12)
precedence(b1, n4)
precedence(n4, e_end)
precedence(b1, n7)
precedence(n7, n6)
precedence(n6, b2)
precedence(b2, n8)
precedence(n8, e_end)
precedence(b2, n9)
precedence(n9, n10)
precedence(n10, e_end)
precedence(n12, b3)
precedence(b3, n13)
precedence(n13, n14)
precedence(n14, n15)
precedence(n15, e_end)
precedence(b3, n11)
precedence(n11, b4)
precedence(b4, n16)
precedence(n16, e_end)
precedence(b4, n17)
precedence(n17, e_end)
guard(b1, n4, v1 = "Incomplete")
guard(b1, n7, v1 = "Non-compliant")
guard(b2, n8, v2 = "Phone call")
guard(b2, n9, v2 = "Mail back")
guard(b3, n13, v3 = "No response")
guard(b3, n11, v3 = "Response received")
guard(b4, n16, v4 = "Unsatisfied")
guard(b4, n17, v4 = "Satisfied")