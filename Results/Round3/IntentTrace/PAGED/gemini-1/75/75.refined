init(i1)
action(n1, "start")
action(n2, "receive claim")
action(n3, "create and record the claim")
action(n4, "make a decision on the claim")
branch(b1, XOR)
action(n5, "reject the claim")
action(n6, "review the claim rejection")
branch(b4, XOR)
action(n14, "If the claim rejection is accepted")
action(n15, "But if the claim rejection is not accepted")
converge(c2)
action(n7, "continue the process")
action(n8, "offer the benefit")
action(n9, "prepare the claim discharge")
action(n10, "record the benefit payment")
converge(c1)
branch(b2, AND)
action(n11, "operate outgoing payment")
action(n12, "close the claim")
converge(c3)
action(n13, "end of process")
end(e1)
defines(v1, "make a decision on the claim", {"Rejected", "Accepted"})
defines(v2, "claim rejection accepted", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, n6, b4, n14, n15, c2, n7, n8, n9, n10, c1, b2, n11, n12, c3, n13, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n5)
precedence(b1, n8)
precedence(n5, n6)
precedence(n6, b4)
precedence(b4, n14)
precedence(b4, n15)
precedence(n14, c2)
precedence(n15, c2)
precedence(c2, n7)
precedence(n7, c1)
precedence(n8, n9)
precedence(n9, n10)
precedence(n10, c1)
precedence(c1, b2)
precedence(b2, n11)
precedence(b2, n12)
precedence(n11, c3)
precedence(n12, c3)
precedence(c3, n13)
precedence(n13, e1)
guard(b1, n5, v1 = 'Rejected')
guard(b1, n8, v1 = 'Accepted')
guard(b4, n14, v2 = 'Yes')
guard(b4, n15, v2 = 'No')