@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start and enter the metadata;
:Proceed to the IN-Patient step;
split
:Send data to suppliers;
:Extract data from suppliers;
:Transfer data to doctor phone;
:Confirm the GOP;
:Process ends after confirming GOP;
stop
split again
:Create a claim;
:Register the case;
:Handle the claim;
:Extract data from suppliers;
:Enter data on patient record or confirm IN-Patient status;
:v1: Enter data on patient record or confirm IN-Patient status ({Enter, Confirm}); <<objectSignal>>
if () then ([v1 = 'Enter'])
:Enter data on patient record;
:Register the case;
:Handle the claim;
:Receive the payment;
else ([v1 = 'Confirm'])
:Confirm IN-Patient status;
:Send data back to suppliers;
:Receive the payment;
endif
:Process ends after receiving payment;
stop
end split
@enduml