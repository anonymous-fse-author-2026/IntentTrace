      "verbatim_texts": [
        "In the beginning,"
      ],
      "justification": "Starts the process as indicated by the introductory phrase."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "if the answer is \"No\", then we continue the process.",
        "If the answer is \"No\" again, we continue the process."
      ],
      "justification": "Captures the negative branch where the process skips priority and continues."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "However, if the answer is \"Yes\","
      ],
      "justification": "Positive condition of the first decision."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then we give it priority."
      ],
      "justification": "Action taken on the positive branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "we look up the Vendor on SAP."
      ],
      "justification": "Direct match for the lookup action."
    },
    {
      "refs": [
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "If the answer is \"No\","
      ],
      "justification": "Decision branch indicating a missing vendor."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "we need a Vendor master record"
      ],
      "justification": "Action required when a vendor is missing."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Terminates the process when a vendor is missing."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "But if the answer is \"Yes\","
      ],
      "justification": "Branch condition when a vendor is successfully found."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "then we enter the invoice in SAP."
      ],
      "justification": "Action to enter the invoice when the vendor is found."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "if the answer is \"Yes\""
      ],
      "justification": "Alternative positive condition capturing the check for priority."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "then we give it priority."
      ],
      "justification": "Priority step for the alternative path."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "And if the answer is \"Yes\" again",
        "then we enter the invoice in SAP."
      ],
      "justification": "Subsequent step to enter the invoice on the prioritized path."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "we place the entered invoices in the normal Outbox"
      ],
      "justification": "Final standard step after paths converge."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Normal process termination at the end of the standard flow."
    }
