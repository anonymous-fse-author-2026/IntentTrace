@startuml
!theme plain
|a_default| Default
|a_default|
start
:start acme process;
:receive customer request;
:check inventory level;
:v1: check inventory level ({at or below minimum, above minimum}); <<objectSignal>>
if () then ([v1 = "at or below minimum"])
:accept the customer request;
:create a purchase order;
:review purchase order;
:v2: review purchase order ({approved, rejected}); <<objectSignal>>
if () then ([v2 = "rejected"])
:rework purchase order;
:review it again;
else ([v2 = "approved"])
:approve purchase order and reserve funds;
:send purchase order;
split
:receive packing slip;
:record packing slip;
split again
:receive invoice;
:record invoice;
end split
:release reserved funds and issue payment;
stop
endif
else ([v1 = "above minimum"])
:reject the customer request;
stop
endif
@enduml