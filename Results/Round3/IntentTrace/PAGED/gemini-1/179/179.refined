action(n23, "present the project")
action(n25, "present the project and end the process")
end(e1)
converge(c1)
converge(c2)
converge(c3)

defines(v1, "is the process model OK", {"Yes", "No"})
defines(v3, "need to check the process and assign points or analyze field of study", {"Check", "Analyze"})
defines(v4, "is the process OK after checking and assigning points", {"Yes", "No"})
