@startuml
!theme plain
|a_default| Default
|a_default|
start
:start buyer process;
:choose a book;
:choose what to do after selecting book;
:v1: choose what to do after selecting book ({view details, view new, view used}); <<objectSignal>>
switch ()
case ([v1 = "view details"])
:view book details;
:choose what to do after viewing book details;
:v2: choose what to do after viewing book details ({view new, select copy}); <<objectSignal>>
if () then ([v2 = "view new"])
:view list of new copies from book details;
else ([v2 = "select copy"])
:select a copy and complete process;
endif
case ([v1 = "view new"])
:view list of new copies;
case ([v1 = "view used"])
:view list of used copies;
:evaluate list of used copies;
:select preferred copy and complete process;
endswitch
stop
@enduml