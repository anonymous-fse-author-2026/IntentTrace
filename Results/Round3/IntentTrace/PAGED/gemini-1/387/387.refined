init(i1)
action(i2, "trigger the resupply cycle")
action(i3, "check the inventory level")
branch(b1, XOR)
action(i4, "If the inventory level is at or below the minimum,")
action(i5, "create a purchase order")
action(i6, "if the inventory level is above the minimum, the process ends.")
end(e1)
converge(c1)
branch(b2, XOR)
action(i7, "If the purchase status is rejected,")
action(i8, "rework the purchase order")
action(i9, "reserve the funds")
action(i10, "Rework the purchase order and then review it.")
action(i11, "send the order to the supplier")
action(i12, "At the same time,")
branch(b3, AND)
action(i13, "receive the packing slip")
action(i14, "receive the invoice")
action(i15, "Receive the packing slip and then record it")
action(i16, "Receive the invoice and then record it")
action(i17, "Record the packing slip and the process ends.")
end(e2)
action(i18, "Record the invoice and the process ends.")
end(e3)

defines(v1, "is inventory level at or below minimum", {true, false})
defines(v2, "is purchase status rejected", {true, false})

actor(a_default, "Default", [i1, i2, i3, b1, i4, i5, i6, e1, c1, b2, i7, i8, i9, i10, i11, i12, b3, i13, i14, i15, i16, i17, e2, i18, e3])

precedence(i1, i2)
precedence(i2, i3)
precedence(i3, b1)
precedence(b1, i4)
precedence(b1, i6)
precedence(i6, e1)
precedence(i4, i5)
precedence(i5, b2)
precedence(b2, i7)
precedence(b2, c1)
precedence(c1, i9)
precedence(i7, i8)
precedence(i8, i10)
precedence(i10, c1)
precedence(i9, i11)
precedence(i11, i12)
precedence(i12, b3)
precedence(b3, i13)
precedence(b3, i14)
precedence(i13, i15)
precedence(i15, i17)
precedence(i17, e2)
precedence(i14, i16)
precedence(i16, i18)
precedence(i18, e3)

guard(b1, i4, v1 = true)
guard(b1, i6, v1 = false)
guard(b2, i7, v2 = true)
guard(b2, c1, v2 = false)