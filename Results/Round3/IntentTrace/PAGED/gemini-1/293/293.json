{
  "elements": [
    {
      "id": "i1",
      "type": "init"
    },
    {
      "id": "n1",
      "type": "action",
      "content": "For TS recruitment"
    },
    {
      "id": "n2",
      "type": "action",
      "content": "advise unsuccessful candidates"
    },
    {
      "id": "n3",
      "type": "action",
      "content": "If there are \"no more candidates\""
    },
    {
      "id": "b1",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "n4",
      "type": "action",
      "content": "the position should be re-advertised"
    },
    {
      "id": "e1",
      "type": "end"
    },
    {
      "id": "n6",
      "type": "action",
      "content": "However, if the terms and conditions of the offer for a candidate need to be sorted out"
    },
    {
      "id": "n7",
      "type": "action",
      "content": "check if the candidate has accepted a voluntary redundancy"
    },
    {
      "id": "b3",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "n8",
      "type": "action",
      "content": "if the candidate has accepted"
    },
    {
      "id": "i10",
      "type": "action",
      "content": "further investigation is required"
    },
    {
      "id": "n9",
      "type": "action",
      "content": "If the candidate has not accepted"
    },
    {
      "id": "i9",
      "type": "action",
      "content": "the process continues"
    },
    {
      "id": "c1",
      "type": "converge"
    },
    {
      "id": "n11",
      "type": "action",
      "content": "sends an Appointment Approval form"
    },
    {
      "id": "n12",
      "type": "action",
      "content": "received by the next level manager"
    },
    {
      "id": "n13",
      "type": "action",
      "content": "If the manager is an external resource"
    },
    {
      "id": "b4",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "n14",
      "type": "action",
      "content": "they may not authorize the form"
    },
    {
      "id": "e2",
      "type": "end"
    },
    {
      "id": "n16",
      "type": "action",
      "content": "if the approver is an existing employee of the client"
    },
    {
      "id": "i16",
      "type": "action",
      "content": "If the form is approved"
    },
    {
      "id": "n19",
      "type": "action",
      "content": "the recruitment manager sends the form and other documentation"
    },
    {
      "id": "n20",
      "type": "action",
      "content": "received by the client HR"
    },
    {
      "id": "n21",
      "type": "action",
      "content": "scans the completed form and records the position against the stored position in GovSource"
    },
    {
      "id": "n22",
      "type": "action",
      "content": "If there are any variations"
    },
    {
      "id": "b6",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "n23",
      "type": "action",
      "content": "a complete business case is required"
    },
    {
      "id": "n24",
      "type": "action",
      "content": "Otherwise, the process continues"
    },
    {
      "id": "c2",
      "type": "converge"
    },
    {
      "id": "n25",
      "type": "action",
      "content": "The Appointment Approval is carried forward."
    },
    {
      "id": "n26",
      "type": "action",
      "content": "If the position requires a medical assessment"
    },
    {
      "id": "b7",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "n27",
      "type": "action",
      "content": "it is applicable for a 12% rate"
    },
    {
      "id": "n28",
      "type": "action",
      "content": "Otherwise, a medical assessment is not necessary"
    },
    {
      "id": "n29",
      "type": "action",
      "content": "take up to 21 days to arrange and complete"
    },
    {
      "id": "c3",
      "type": "converge"
    },
    {
      "id": "n30",
      "type": "action",
      "content": "The TS HR coordinator informs the recruitment manager"
    },
    {
      "id": "n31",
      "type": "action",
      "content": "liaises with the HR representative to confirm the offer to the candidate"
    },
    {
      "id": "n32",
      "type": "action",
      "content": "If the assessment is not satisfactory"
    },
    {
      "id": "b8",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "n33",
      "type": "action",
      "content": "the next candidate on the shortlist should be contacted"
    },
    {
      "id": "e4",
      "type": "end"
    },
    {
      "id": "n34",
      "type": "action",
      "content": "if the assessment is fine"
    },
    {
      "id": "n35",
      "type": "action",
      "content": "makes a formal verbal offer of employment to the candidate"
    },
    {
      "id": "b9",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "n36",
      "type": "action",
      "content": "If the candidate accepts"
    },
    {
      "id": "n37",
      "type": "action",
      "content": "creates a formal written offer"
    },
    {
      "id": "n38",
      "type": "action",
      "content": "If the candidate declines, the process continues."
    },
    {
      "id": "c4",
      "type": "converge"
    },
    {
      "id": "i37",
      "type": "action",
      "content": "Simultaneously"
    },
    {
      "id": "n39",
      "type": "action",
      "content": "the commencement pack and letter of appointment are sent to the candidate"
    },
    {
      "id": "n40",
      "type": "action",
      "content": "Once the candidate receives these documents"
    },
    {
      "id": "n41",
      "type": "action",
      "content": "if there is a \"40%\" rate"
    },
    {
      "id": "b10",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "n42",
      "type": "action",
      "content": "renegotiation is required"
    },
    {
      "id": "n43",
      "type": "action",
      "content": "If the renegotiation is successful"
    },
    {
      "id": "b11",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "n44",
      "type": "action",
      "content": "the next candidate on the shortlist should be identified"
    },
    {
      "id": "e5",
      "type": "end"
    },
    {
      "id": "n45",
      "type": "action",
      "content": "if the renegotiation is unsuccessful"
    },
    {
      "id": "n46",
      "type": "action",
      "content": "If the renegotiation is successful, the process continues."
    },
    {
      "id": "e6",
      "type": "end"
    },
    {
      "id": "n47",
      "type": "action",
      "content": "Otherwise, if the candidate accepts, the process continues."
    },
    {
      "id": "e7",
      "type": "end"
    }
  ],
