init(i1)
action(n1, "For TS recruitment")
action(n2, "advise unsuccessful candidates")
action(n3, 'If there are "no more candidates"')
branch(b1, XOR)
action(n4, "the position should be re-advertised")
end(e1)
action(n6, "However, if the terms and conditions of the offer for a candidate need to be sorted out")
action(n7, "check if the candidate has accepted a voluntary redundancy")
branch(b3, XOR)
action(n8, "if the candidate has accepted")
action(i10, "further investigation is required")
action(n9, "If the candidate has not accepted")
action(i9, "the process continues")
converge(c1)
action(n11, "sends an Appointment Approval form")
action(n12, "received by the next level manager")
action(n13, "If the manager is an external resource")
branch(b4, XOR)
action(n14, "they may not authorize the form")
end(e2)
action(n16, "if the approver is an existing employee of the client")
action(i16, "If the form is approved")
action(n19, "the recruitment manager sends the form and other documentation")
action(n20, "received by the client HR")
action(n21, "scans the completed form and records the position against the stored position in GovSource")
action(n22, "If there are any variations")
branch(b6, XOR)
action(n23, "a complete business case is required")
action(n24, "Otherwise, the process continues")
converge(c2)
action(n25, "The Appointment Approval is carried forward.")
action(n26, "If the position requires a medical assessment")
branch(b7, XOR)
action(n27, "it is applicable for a 12% rate")
action(n28, "Otherwise, a medical assessment is not necessary")
action(n29, "take up to 21 days to arrange and complete")
converge(c3)
action(n30, "The TS HR coordinator informs the recruitment manager")
action(n31, "liaises with the HR representative to confirm the offer to the candidate")
action(n32, "If the assessment is not satisfactory")
branch(b8, XOR)
action(n33, "the next candidate on the shortlist should be contacted")
end(e4)
action(n34, "if the assessment is fine")
action(n35, "makes a formal verbal offer of employment to the candidate")
branch(b9, XOR)
action(n36, "If the candidate accepts")
action(n37, "creates a formal written offer")
action(n38, "If the candidate declines, the process continues.")
converge(c4)
action(i37, "Simultaneously")
action(n39, "the commencement pack and letter of appointment are sent to the candidate")
action(n40, "Once the candidate receives these documents")
action(n41, 'if there is a "40%" rate')
branch(b10, XOR)
action(n42, "renegotiation is required")
action(n43, "If the renegotiation is successful")
branch(b11, XOR)
action(n44, "the next candidate on the shortlist should be identified")
end(e5)
action(n45, "if the renegotiation is unsuccessful")
action(n46, "If the renegotiation is successful, the process continues.")
end(e6)
action(n47, "Otherwise, if the candidate accepts, the process continues.")
end(e7)
