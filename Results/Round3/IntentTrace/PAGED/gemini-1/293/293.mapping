      ],
      "justification": "Initiates the process and captures the context as an action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "advise unsuccessful candidates"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\""
      ],
      "justification": "Correctly captures the decision and the condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the position should be re-advertised"
      ],
      "justification": "Action accurately represents the outcome and correctly terminates the branch."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "However, if the terms and conditions of the offer for a candidate need to be sorted out"
      ],
      "justification": "Captures the alternative branch logic."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the candidate has accepted a voluntary redundancy"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "if the candidate has accepted"
      ],
      "justification": "Sets up the decision point and captures the positive condition."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If the candidate has not accepted"
      ],
      "justification": "Captures the alternative condition."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "the process continues"
      ],
      "justification": "Reflects the process continuation and the structural convergence of paths."
    },
    {
      "refs": [
        "action:i10"
      ],
      "verbatim_texts": [
        "further investigation is required"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "sends an Appointment Approval form"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "received by the next level manager"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n13",
        "guard:b4->n13"
      ],
      "verbatim_texts": [
        "If the manager is an external resource"
      ],
      "justification": "Captures the decision branch and positive condition correctly."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "they may not authorize the form"
      ],
      "justification": "Captures the resulting action and implicit ending."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "if the approver is an existing employee of the client"
      ],
      "justification": "Captures the alternative condition branch."
    },
    {
      "refs": [
        "action:i16"
      ],
      "verbatim_texts": [
        "If the form is approved"
      ],
      "justification": "Models the condition as a sequential step, which preserves behaviour."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "the recruitment manager sends the form and other documentation"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "received by the client HR"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "scans the completed form and records the position against the stored position in GovSource"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n22",
        "guard:b6->n22"
      ],
      "verbatim_texts": [
        "If there are any variations"
      ],
      "justification": "Sets up the XOR decision and captures the condition."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "a complete business case is required"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n24",
        "guard:b6->n24"
      ],
      "verbatim_texts": [
        "Otherwise, the process continues"
      ],
      "justification": "Captures the alternative path and the convergence."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "The Appointment Approval is carried forward."
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n26",
        "guard:b7->n26"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment"
      ],
      "justification": "Sets up the XOR decision and the corresponding condition."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "it is applicable for a 12% rate"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n28",
        "guard:b7->n28"
      ],
      "verbatim_texts": [
        "Otherwise, a medical assessment is not necessary"
      ],
      "justification": "Captures the alternative branch correctly."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "take up to 21 days to arrange and complete"
      ],
      "justification": "Action properly aligns with the source phrase and converges."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "The TS HR coordinator informs the recruitment manager"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "liaises with the HR representative to confirm the offer to the candidate"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n32",
        "guard:b8->n32"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory"
      ],
      "justification": "Correctly translates the XOR decision and condition."
    },
    {
      "refs": [
        "action:n33"
      ],
      "verbatim_texts": [
        "the next candidate on the shortlist should be contacted"
      ],
      "justification": "Provides the resultant step and ends the sub-flow appropriately."
    },
    {
      "refs": [
        "action:n34",
        "guard:b8->n34"
      ],
      "verbatim_texts": [
        "if the assessment is fine"
      ],
      "justification": "Captures the alternative condition effectively."
    },
    {
      "refs": [
        "action:n35"
      ],
      "verbatim_texts": [
        "makes a formal verbal offer of employment to the candidate"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n36",
        "guard:b9->n36"
      ],
      "verbatim_texts": [
        "If the candidate accepts"
      ],
      "justification": "Sets up the XOR decision and acceptance condition."
    },
    {
      "refs": [
        "action:n37"
      ],
      "verbatim_texts": [
        "creates a formal written offer"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n38",
        "guard:b9->n38"
      ],
      "verbatim_texts": [
        "If the candidate declines, the process continues."
      ],
      "justification": "Accurately represents the alternate branch logic and converges paths."
    },
    {
      "refs": [
        "action:i37"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Indicates concurrent process flow represented correctly."
    },
    {
      "refs": [
        "action:n39"
      ],
      "verbatim_texts": [
        "the commencement pack and letter of appointment are sent to the candidate"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n40"
      ],
      "verbatim_texts": [
        "Once the candidate receives these documents"
      ],
      "justification": "Translates the trigger as an action step appropriately."
    },
    {
      "refs": [
        "action:n41",
        "guard:b10->n41"
      ],
      "verbatim_texts": [
        "if there is a \"40%\" rate"
      ],
      "justification": "Establishes an XOR branch and the corresponding percentage check."
    },
    {
      "refs": [
        "action:n42"
      ],
      "verbatim_texts": [
        "renegotiation is required"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n47",
        "guard:b10->n47"
      ],
      "verbatim_texts": [
        "Otherwise, if the candidate accepts, the process continues."
      ],
      "justification": "Captures the alternative decision and concludes the sub-flow as there are no further steps."
    },
    {
      "refs": [
        "action:n43",
        "guard:b11->n43"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful"
      ],
      "justification": "Translates condition to a decision branch perfectly."
    },
    {
      "refs": [
        "action:n46"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful, the process continues."
      ],
      "justification": "Action correctly states the process continuation and concludes it as intended by the text limits."
    },
    {
      "refs": [
        "action:n45",
        "guard:b11->n45"
      ],
      "verbatim_texts": [
        "if the renegotiation is unsuccessful"
      ],
      "justification": "Captures the alternate failing state condition."
    },
    {
      "refs": [
        "action:n44"
      ],
      "verbatim_texts": [
        "the next candidate on the shortlist should be identified"
      ],
      "justification": "Reflects the final step on the unsuccessful renegotiation path."
    }
