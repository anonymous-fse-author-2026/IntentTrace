init(i1)
action(n1, "start")
converge(c1)
action(n2, "provide userdata for flickr")
action(n3, "is login successful")
branch(b1, XOR)
converge(c2)
action(n4, "end process")
end(e1)
action(n_fail, "if the login fails")
action(n_cont, "we will continue with the process")
branch(b2, XOR)
action(n5, "If you want to try again")
action(n_abort, "if you choose to abort")
defines(v1, "is login successful", {"Yes", "No"})
defines(v2, "do you want to try again", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, c1, n2, n3, b1, c2, n4, e1, n_fail, n_cont, b2, n5, n_abort])
precedence(i1, n1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n_fail)
precedence(n3, c2)
precedence(n_fail, n_cont)
precedence(n_cont, b2)
precedence(b2, n5)
precedence(b2, n_abort)
precedence(n5, c1)
precedence(n_abort, c2)
precedence(c2, n4)
precedence(n4, e1)
guard(b1, n3, v1 = 'Yes')
guard(b1, n_fail, v1 = 'No')
guard(b2, n5, v2 = 'Yes')
guard(b2, n_abort, v2 = 'No')