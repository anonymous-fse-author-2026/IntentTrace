{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "Initializes the process as described in the text, correctly introducing the starting point."
    },
    {
      "refs": [
        "action:i2",
        "guard:b1->i2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\""
      ],
      "justification": "Models the XOR branch for the entry mechanism and captures its first condition and action."
    },
    {
      "refs": [
        "action:i3",
        "guard:b1->i3"
      ],
      "verbatim_texts": [
        "if the \"Delivery Crew picks-up items at the event site,\""
      ],
      "justification": "Models the alternative initial condition and action for beginning the process."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the items are counted and compared to the original contract"
      ],
      "justification": "Captures the convergence after the initial alternative paths and executes the counting action."
    },
    {
      "refs": [
        "guard:b2->b3"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\""
      ],
      "justification": "Models the main decision split evaluating the items' status, and its first conditional path."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "if the \"Order is incomplete and items are missing,\""
      ],
      "justification": "Guard correctly represents the missing items path."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "if the \"Order is complete but items are damaged,\""
      ],
      "justification": "Guard correctly represents the damaged items path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Matches the action of informing the customer about damage."
    },
    {
      "refs": [
        "action:n17",
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "if the \"Items are packed for an existing order,\""
      ],
      "justification": "Models the decision for what to do with completely returned items and properly maps the packing action."
    },
    {
      "refs": [
        "action:n18",
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "if the \"Items are stored for future orders,\""
      ],
      "justification": "Captures the alternative storing path for returned items."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Matches the action sequence for missing items."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "we temporarily take them out of inventory"
      ],
      "justification": "Properly represents the process action for damaged items."
    },
    {
      "refs": [
        "action:i13",
        "guard:b4->i13"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "Captures the decision branch and positive condition/action for a customer returning missing items."
    },
    {
      "refs": [
        "action:i14",
        "guard:b4->i14"
      ],
      "verbatim_texts": [
        "if the \"Customer does not return the missing items,\""
      ],
      "justification": "Captures the negative condition path for missing items."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Properly joins the parallel or branching paths and models the process endpoint."
    },
    {
      "refs": [
        "action:n12",
        "guard:b5->n12"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\""
      ],
      "justification": "Captures the evaluation decision for damaged items and the repair route."
    },
    {
      "refs": [
        "action:n13",
        "guard:b5->n13"
      ],
      "verbatim_texts": [
        "if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Correctly models the alternative path for items that cannot be repaired."
    },
    {
      "refs": [
        "action:n20",
        "guard:b6->n20"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\""
      ],
      "justification": "Correctly matches the decision point for repaired items and the packing sequence."
    },
    {
      "refs": [
        "action:n21",
        "guard:b6->n21"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\""
      ],
      "justification": "Alternative storing sequence modelled accurately."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Joins the completed processes branches and ends correctly."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges"
      ],
      "justification": "Ends the path with the final action described in the text implicitly leading to the end of the process."
    }
  ],
