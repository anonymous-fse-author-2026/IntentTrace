{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "Initiates the process."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process. However, if the \"Delivery Crew picks-up items at the event site,\""
      ],
      "justification": "Sets up the first decision."
    },
    {
      "refs": [
        "action:i3",
        "guard:b1->i3"
      ],
      "verbatim_texts": [
        "Customer returns the items to the store"
      ],
      "justification": "Branch path for customer returns."
    },
    {
      "refs": [
        "action:i4",
        "guard:b1->i4"
      ],
      "verbatim_texts": [
        "Delivery Crew picks-up items at the event site"
      ],
      "justification": "Branch path for delivery crew pickup."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "the items are counted and compared to the original contract"
      ],
      "justification": "Matches the item counting action."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\""
      ],
      "justification": "Sets up the branch for order status."
    },
    {
      "refs": [
        "action:i7",
        "guard:b2->i7"
      ],
      "verbatim_texts": [
        "Order is complete and all items were returned"
      ],
      "justification": "Branch path for complete orders."
    },
    {
      "refs": [
        "action:i8",
        "guard:b2->i8"
      ],
      "verbatim_texts": [
        "Order is incomplete and items are missing"
      ],
      "justification": "Branch path for incomplete orders."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "we still continue the process."
      ],
      "justification": "Action and convergence representing process continuation."
    },
    {
      "refs": [
        "action:i10",
        "guard:b2->i10"
      ],
      "verbatim_texts": [
        "Order is complete but items are damaged"
      ],
      "justification": "Branch path for damaged items."
    },
    {
      "refs": [
        "action:i11"
      ],
      "verbatim_texts": [
        "email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Action to email customer."
    },
    {
      "refs": [
        "action:i12",
        "guard:b5->i12"
      ],
      "verbatim_texts": [
        "Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Alternative branch path for stored items."
    },
    {
      "refs": [
        "action:i13"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Email action for missing items."
    },
    {
      "refs": [
        "action:i14"
      ],
      "verbatim_texts": [
        "temporarily take them out of inventory"
      ],
      "justification": "Action to remove items from inventory."
    },
    {
      "refs": [
        "action:i15"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "Decision branch for returning missing items."
    },
    {
      "refs": [
        "action:i16",
        "guard:b3->i16"
      ],
      "verbatim_texts": [
        "Customer returns the missing items"
      ],
      "justification": "Path where customer returns missing items."
    },
    {
      "refs": [
        "action:i17",
        "guard:b3->i17"
      ],
      "verbatim_texts": [
        "Customer does not return the missing items"
      ],
      "justification": "Path where customer does not return missing items."
    },
    {
      "refs": [
        "action:i18"
      ],
      "verbatim_texts": [
        "when the process is complete, it ends."
      ],
      "justification": "Redundant condition representing process end modeled as an action."
    },
    {
      "refs": [
        "action:i19"
      ],
      "verbatim_texts": [
        "it ends."
      ],
      "justification": "Termination point and structural convergences mapping the process ending."
    },
    {
      "refs": [
        "action:i20"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\""
      ],
      "justification": "Decision branch for item repair."
    },
    {
      "refs": [
        "action:i21",
        "guard:b4->i21"
      ],
      "verbatim_texts": [
        "Items are repaired and added into inventory"
      ],
      "justification": "Path for repaired items."
    },
    {
      "refs": [
        "action:i22",
        "guard:b4->i22"
      ],
      "verbatim_texts": [
        "Items can't be repaired and are discarded"
      ],
      "justification": "Path for discarded items."
    },
    {
      "refs": [
        "action:i23"
      ],
      "verbatim_texts": [
        "email the customer with replacement charges"
      ],
      "justification": "Action to email replacement charges."
    },
    {
      "refs": [
        "action:i24",
        "guard:b5->i24"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\""
      ],
      "justification": "Branch and path for items packed."
    },
    {
      "refs": [
        "action:i25"
      ],
      "verbatim_texts": [
        "customer is then emailed with replacement charges"
      ],
      "justification": "Final action to email customer."
    }
  ],
