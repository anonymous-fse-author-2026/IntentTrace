{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for ACME Company"
      ],
      "justification": "Initiates the process and provides the start step for ACME Company."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "receiving the customer request"
      ],
      "justification": "Captures the action of receiving the customer request."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the current inventory level"
      ],
      "justification": "Direct match for the step of checking inventory."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the inventory level",
        "is at or below the minimum"
      ],
      "justification": "Opens the XOR decision and captures the condition to accept the request."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "accept the customer request"
      ],
      "justification": "Positive outcome of the inventory level check."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "is above the minimum"
      ],
      "justification": "Captures the condition for the negative branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "reject the customer request"
      ],
      "justification": "Negative outcome of the inventory check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "create a purchase order"
      ],
      "justification": "Direct match for purchase order creation."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "is rejected",
        "the process ends"
      ],
      "justification": "Terminates the process if the customer request is rejected."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "review it"
      ],
      "justification": "Represents the review of the created (or reworked) purchase order."
    },
    {
      "refs": [
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "If the purchase order"
      ],
      "justification": "Opens the review decision and executes the rework branch for rejected purchase orders."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "rework the purchase order"
      ],
      "justification": "Opens the review decision and executes the rework branch for rejected purchase orders."
    },
    {
      "refs": [
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "is approved"
      ],
      "justification": "The condition representing an approved purchase order."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "reserve the funds"
      ],
      "justification": "Action triggered if the purchase order is approved."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "needs to be reworked, review it again"
      ],
      "justification": "Paraphrase match for the loop action to review a reworked order."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "send the purchase order"
      ],
      "justification": "Direct match for sending the purchase order."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive the packing slip"
      ],
      "justification": "Opens the parallel split for subsequent steps and handles receiving the packing slip."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "receive the invoice"
      ],
      "justification": "Direct match for receiving the invoice in the parallel branch."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Upon receiving the packing slip, record it"
      ],
      "justification": "Recording the packing slip after receipt."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "upon receiving the invoice, record it as well"
      ],
      "justification": "Recording the invoice after receipt."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Release the reserved funds and issue the payment."
      ],
      "justification": "Converges the parallel branches and processes the release and payment action."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Finally, issue the payment"
      ],
      "justification": "Direct match for the restated payment issue action."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Closes the main flow of the process."
    }
