init(i1)
action(n1, "start")
converge(c1)
action(n2, "enter expenses")
action(n3, "generate spreadsheet")
action(n4, "is request approved?")
branch(b1, XOR)
action(n6, "pay out expenses")
action(n7, "is request approved?")
branch(b2, XOR)
action(n9, "pay out expenses")
end(e1)
converge(c2)
action(n5, "goes back to entering expenses")
action(n8, "If the request is not approved")
action(n10, "if the request is approved")
action(n11, "If it is not approved")
defines(v1, "is request approved?", {"No", "Yes"})
defines(v2, "is request approved?", {"No", "Yes"})
actor(a_default, "Default", [i1, n1, c1, n2, n3, n4, b1, n6, n7, b2, n9, e1, c2, n5, n8, n10, n11])
precedence(i1, n1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n10)
precedence(n10, n6)
precedence(b1, n8)
precedence(n8, c2)
precedence(c2, n5)
precedence(n5, c1)
precedence(n6, n7)
precedence(n7, b2)
precedence(b2, n9)
precedence(b2, n11)
precedence(n11, c2)
precedence(n9, e1)
guard(b1, n8, v1 = 'No')
guard(b1, n10, v1 = 'Yes')
guard(b2, n11, v2 = 'No')
guard(b2, n9, v2 = 'Yes')