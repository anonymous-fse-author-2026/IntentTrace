{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process"
      ],
      "justification": "Initializes the process correctly according to the first text span."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin by clicking on \"Start\""
      ],
      "justification": "Direct match for clicking Start."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "selecting \"Edit Report\""
      ],
      "justification": "Direct match for the Edit Report step, with a structural converge node to support later loops."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the expense is"
      ],
      "justification": "Opens the branch based on the expense amount."
    },
    {
      "refs": [
        "action:n_i5",
        "guard:b1->n_i5"
      ],
      "verbatim_texts": [
        "greater than 1000"
      ],
      "justification": "Positive branch of the expense check, modeled correctly with threshold > 1000."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the report should be reviewed"
      ],
      "justification": "Direct match for the review step."
    },
    {
      "refs": [
        "action:n_i7",
        "guard:b1->n_i7"
      ],
      "verbatim_texts": [
        "is less than or equal to 1000"
      ],
      "justification": "Negative branch of the expense check, correctly capturing the <= 1000 condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check if there is a need for translation"
      ],
      "justification": "Direct match for checking the translation requirement."
    },
    {
      "refs": [
        "action:n_i9",
        "guard:b2->n_i9"
      ],
      "verbatim_texts": [
        "If translation is required"
      ],
      "justification": "Opens the translation branch with a conditional guard."
    },
    {
      "refs": [
        "action:n7",
        "action:n12"
      ],
      "verbatim_texts": [
        "translate the receipts"
      ],
      "justification": "Both instances of translating receipts align directly with the source step."
    },
    {
      "refs": [
        "action:n_i11",
        "guard:b2->n_i11"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Negative branch for translation requirement."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "confirm the receipts"
      ],
      "justification": "Direct match for confirming the receipts."
    },
    {
      "refs": [
        "action:n_i13"
      ],
      "verbatim_texts": [
        "After this"
      ],
      "justification": "Sequencer step joining the upstream translation paths before evaluating the review decision."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "evaluate the review decision"
      ],
      "justification": "Action and branch correctly reflect evaluating the review decision."
    },
    {
      "refs": [
        "action:n_i15",
        "guard:b3->n_i15",
        "action:n_i15_2",
        "guard:b4->n_i15_2"
      ],
      "verbatim_texts": [
        "If the report is rejected"
      ],
      "justification": "Both loops for rejecting the report map correctly to the rejection condition."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "edit the report"
      ],
      "justification": "Action and plumbing matching the 'edit the report' loop-back step."
    },
    {
      "refs": [
        "action:n_i17",
        "guard:b3->n_i17",
        "action:n_i17_2",
        "guard:b4->n_i17_2"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Both branches for an approved report mapped successfully to the condition."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "continue to check if there is a need for translation."
      ],
      "justification": "Direct match for the translation check sequence."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision"
      ],
      "justification": "The second evaluation of the review decision represented accurately."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "confirm them"
      ],
      "justification": "Direct match for the second confirmation."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "evaluate the receipts decision"
      ],
      "justification": "Step evaluating the receipt decision and opening the corresponding branch."
    },
    {
      "refs": [
        "action:n_i22",
        "guard:b5->n_i22"
      ],
      "verbatim_texts": [
        "If the receipts are accepted"
      ],
      "justification": "Positive path for receipt acceptance."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "process the expense"
      ],
      "justification": "Direct match for processing the expense."
    },
    {
      "refs": [
        "action:n_i24",
        "guard:b5->n_i24"
      ],
      "verbatim_texts": [
        "If they are rejected"
      ],
      "justification": "Negative path for receipt rejection."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "ending it"
      ],
      "justification": "Properly terminates the process."
    }
  ],
