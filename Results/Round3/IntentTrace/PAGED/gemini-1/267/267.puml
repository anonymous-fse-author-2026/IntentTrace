:v6: Is ticket order approved after third validation ({Yes, No}); <<objectSignal>>
if () then ([v6 = 'No'])
->;
else ([v6 = 'Yes'])
:End process;
stop
endif
endif
endif
:End process;
stop
case ([v2 = 'Yes_alt'])
:Proceed with writing ticket order to SNCF;
