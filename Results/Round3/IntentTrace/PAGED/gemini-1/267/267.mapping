{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially"
      ],
      "justification": "Initializes the process and models the startup action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
      "justification": "Captures the decision and the branching conditions for whether the option is selected."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the action to be taken is \"Research schedule\""
      ],
      "justification": "Action performed when the option is selected."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then \"provide indications\""
      ],
      "justification": "Action performed on the alternative path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed with the research schedule"
      ],
      "justification": "Follow-up action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule"
      ],
      "justification": "Validation step modeled as an action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory"
      ],
      "justification": "Decision point evaluating the schedule."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\""
      ],
      "justification": "Negative branch condition and the corresponding research action."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\""
      ],
      "justification": "Negative branch condition and the corresponding research action."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "proceed with writing a ticket order to SNCF"
      ],
      "justification": "Positive branch to write the ticket order."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n11",
        "guard:b3->c1"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory"
      ],
      "justification": "Additional check and structural branch modeling the 'still not satisfactory' condition."
    },
    {
      "refs": [
        "action:n12",
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "write a ticket order to SNCF"
      ],
      "justification": "Alternative ticket writing action and guard."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it"
      ],
      "justification": "Ticket validation action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved"
      ],
      "justification": "Decision point to check approval."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->c3",
        "guard:b5->c3",
        "guard:b6->c3"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends"
      ],
      "justification": "Maps the negative outcomes ending the process."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order"
      ],
      "justification": "Positive outcome leading to the next validation."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved"
      ],
      "justification": "Second approval check."
    },
    {
      "refs": [
        "action:n20",
        "guard:b5->n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved"
      ],
      "justification": "Third approval check and the guard leading to it."
    },
    {
      "refs": [
        "action:n22",
        "guard:b6->n22"
      ],
      "verbatim_texts": [
        "If it is, then the process ends"
      ],
      "justification": "Final process conclusion upon approval."
    }
  ],
