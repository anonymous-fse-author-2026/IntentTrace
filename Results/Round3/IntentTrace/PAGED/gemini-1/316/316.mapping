{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "Starts the process and initiates course registration."
    },
    {
      "refs": [
        "action:n_i2",
        "guard:b1->n_i2"
      ],
      "verbatim_texts": [
        "If an exception is needed,"
      ],
      "justification": "Opens decision for exception and describes the positive condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "a Request for the exception should be made."
      ],
      "justification": "Action describing exception request."
    },
    {
      "refs": [
        "action:n_i4",
        "action:n4",
        "guard:b1->n_i4"
      ],
      "verbatim_texts": [
        "if an exception is not needed,"
      ],
      "justification": "Negative condition and corresponding flow for exception."
    },
    {
      "refs": [
        "action:n_i5",
        "label:n4->c1"
      ],
      "verbatim_texts": [
        "the process can continue."
      ],
      "justification": "Process continuation path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After the exception is approved,"
      ],
      "justification": "Exception approval handling and structural rejoin."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the next step is course enrollment,"
      ],
      "justification": "Course enrollment step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "followed by seminar group enrollment."
      ],
      "justification": "Seminar group enrollment step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the seminar group enrollment is completed, the homework assignment can be started."
      ],
      "justification": "Starts the homework process and loops rejoin point."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After working on the homework, it should be turned in."
      ],
      "justification": "Action for turning in the homework."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated"
      ],
      "justification": "Evaluate homework step."
    },
    {
      "refs": [
        "action:n_i12",
        "guard:b3->n_i12"
      ],
      "verbatim_texts": [
        "If it was not the last homework,"
      ],
      "justification": "Condition for repeating homework loop."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "another homework assignment will be given."
      ],
      "justification": "Action of assigning repeat homework."
    },
    {
      "refs": [
        "action:n_i14",
        "action:n15",
        "guard:b3->n_i14"
      ],
      "verbatim_texts": [
        "if it was the last homework,"
      ],
      "justification": "Condition for exiting the homework loop."
    },
    {
      "refs": [
        "action:n_i15"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed:"
      ],
      "justification": "AND branch for parallel process steps."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "granting accreditation"
      ],
      "justification": "Granting accreditation step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "announcing the date of the exam."
      ],
      "justification": "Announcing exam step."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "After signing up for the exam,"
      ],
      "justification": "Exam sign-up action and structural branch merges."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "it should be attended."
      ],
      "justification": "Attend exam step."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the exam is attended, it will be evaluated."
      ],
      "justification": "Evaluate exam step."
    },
    {
      "refs": [
        "action:n22",
        "action:n_i21",
        "guard:b4->n_i21"
      ],
      "verbatim_texts": [
        "If the exam is passed,"
      ],
      "justification": "Decision and condition for a passed exam."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "the course is considered passed"
      ],
      "justification": "Action resulting from passed exam."
    },
    {
      "refs": [
        "action:n_i23"
      ],
      "verbatim_texts": [
        "the course is considered passed and the process can continue."
      ],
      "justification": "Process successfully finishes."
    },
    {
      "refs": [
        "action:n_i24",
        "guard:b4->n_i24"
      ],
      "verbatim_texts": [
        "if the exam is failed,"
      ],
      "justification": "Condition for failed exam."
    },
    {
      "refs": [
        "action:n24",
        "action:n_i25"
      ],
      "verbatim_texts": [
        "another sign-up for the exam is required."
      ],
      "justification": "Action for retrying exam after a failure."
    }
  ],
