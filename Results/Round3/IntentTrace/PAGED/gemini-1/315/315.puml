@startuml
!theme plain
|a_default| Default
|a_default|
start
:make appointment at hairdresser's;
:go to hairdresser;
:v_service: Service ({wash, dye, cut}); <<objectSignal>>
switch ()
case ([v_service = "wash"])
:need hair washed?;
:wash hair;
case ([v_service = "dye"])
:want hair dyed?;
:dye hair;
case ([v_service = "cut"])
:need haircut?;
:cut hair;
endswitch
:pay hairdresser;
:end process;
stop
@enduml