{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Starts the process, describes the first step, and opens the XOR branch."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\""
      ],
      "justification": "Positive guard for discussing terms."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Action step for discussing terms."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "Otherwise,"
      ],
      "justification": "Negative guard for discussing terms."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Continuation action and structural convergence."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Action modeling the check for terms modification."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "continue to check if the change is within the set client limits."
      ],
      "justification": "Checks client limits and opens the subsequent decision branch."
    },
    {
      "refs": [
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "If it is not,"
      ],
      "justification": "Negative arm for the limit check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "relay the applicant's changes."
      ],
      "justification": "Action to relay changes when not in limits."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is within the limits,"
      ],
      "justification": "Positive arm for the limit check and its corresponding continuation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "relay the applicant's changes and continue with the process."
      ],
      "justification": "Direct match for relaying changes and continuing."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Action and decision branch for acceptable changes."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they are,"
      ],
      "justification": "Positive condition arm and its continuation step."
    },
    {
      "refs": [
        "guard:b4->n18"
      ],
      "verbatim_texts": [
        "If not,"
      ],
      "justification": "Negative condition arm."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "select a new applicant from the list."
      ],
      "justification": "Action executed when changes are not acceptable."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Action and decision branch for client acceptance."
    },
    {
      "refs": [
        "guard:b5->n20"
      ],
      "verbatim_texts": [
        "If they do,"
      ],
      "justification": "Positive arm for client acceptance."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Explicitly finishes the process, appropriately matched to redundant ending structures."
    },
    {
