{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "Initially, it is important to check the Referee Reports."
      ],
      "justification": "Initializes the process and describes the first checking action."
    },
    {
      "refs": [
        "action:i2",
        "action:n2"
      ],
      "verbatim_texts": [
        "At the same time, you should continue to monitor if the Referee Reports have been completed."
      ],
      "justification": "Maps to redundant action steps for monitoring and sets up the decision gateway."
    },
    {
      "refs": [
        "action:i3",
        "guard:b1->i3"
      ],
      "verbatim_texts": [
        "If they have been completed,"
      ],
      "justification": "Positive conditional path."
    },
    {
      "refs": [
        "action:i4",
        "guard:b1->i4"
      ],
      "verbatim_texts": [
        "if they have not been completed,"
      ],
      "justification": "Negative conditional path."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "you should flag it and send a reminder."
      ],
      "justification": "Action to send a reminder and structural convergence of the process flow."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "After that, you should check again if the Referee Reports have been completed."
      ],
      "justification": "The re-evaluation step and its corresponding decision gateway."
    },
    {
      "refs": [
        "action:i7",
        "guard:b1_loop->i7"
      ],
      "verbatim_texts": [
        "If they have,"
      ],
      "justification": "Positive branch of the re-evaluation."
    },
    {
      "refs": [
        "action:i8",
        "guard:b1_loop->i8"
      ],
      "verbatim_texts": [
        "If not,"
      ],
      "justification": "Negative branch of the re-evaluation."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "you should flag it again and send another reminder."
      ],
      "justification": "Action step for the second reminder and structural convergence."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "you can move on to organizing interviews for the Selection Panel with the top candidates."
      ],
      "justification": "Redundant action steps capturing the organization of interviews; behavior is preserved."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After the interviews, it is necessary to receive feedback from the interview candidates."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Next, you need to check if a Psychometric Test is required."
      ],
      "justification": "Checking action and the associated decision gateway."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If it is,"
      ],
      "justification": "Positive condition."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "you should then check if an HR Specialist is required."
      ],
      "justification": "Checking step and the nested decision gateway."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "you can continue with the process and coordinate the second round of selection."
      ],
      "justification": "The negative branch (implied 'if not') and the corresponding action."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required,"
      ],
      "justification": "Positive condition for the HR specialist check."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "you should schedule the test with a third party."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "Otherwise,"
      ],
      "justification": "Negative condition for the HR specialist check."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "you can proceed to complete the Psychometric Test."
      ],
      "justification": "Action step for the test and convergence of the HR specialist branches."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, you should request the final candidate ranking and continue with the process."
      ],
      "justification": "Final step and termination of the process flow."
    }
  ],
