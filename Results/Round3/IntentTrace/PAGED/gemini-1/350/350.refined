init(start_node)
action(i1, "To start, please provide the userdata for flickr.")
action(i2, "please provide the userdata for flickr.")
action(i3, "If the login is successful,")
action(i4, "the process will end.")
action(i5, "if the login fails,")
action(i6, "If you want to try again,")
action(i7, "if you choose to abort,")
action(i8, "If you still want to try again,")
action(i9, "if you decide to abort,")
converge(c_login)
branch(b_login, XOR)
converge(c_end)
branch(b_fail, XOR)
converge(c_i2)
end(e_end)
defines(v_login, "login status", {"Successful", "Fails"})
defines(v_retry, "retry decision", {"Try", "Abort", "StillTry", "DecideAbort"})
actor(a_default, "Default", [start_node, i1, i2, i3, i4, i5, i6, i7, i8, i9, c_login, b_login, c_end, b_fail, c_i2, e_end])
precedence(start_node, i1)
precedence(i1, c_login)
precedence(i2, c_login)
precedence(c_login, b_login)
precedence(b_login, i3)
precedence(b_login, i5)
precedence(i3, c_end)
precedence(i5, b_fail)
precedence(b_fail, i6)
precedence(b_fail, i7)
precedence(b_fail, i8)
precedence(b_fail, i9)
precedence(i6, c_i2)
precedence(i8, c_i2)
precedence(c_i2, i2)
precedence(i7, c_end)
precedence(i9, c_end)
precedence(c_end, i4)
precedence(i4, e_end)
guard(b_login, i3, v_login = 'Successful')
guard(b_login, i5, v_login = 'Fails')
guard(b_fail, i6, v_retry = 'Try')
guard(b_fail, i7, v_retry = 'Abort')
guard(b_fail, i8, v_retry = 'StillTry')
guard(b_fail, i9, v_retry = 'DecideAbort')