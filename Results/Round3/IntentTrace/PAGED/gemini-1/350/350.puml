@startuml
!theme plain
|a_default| Default
|a_default|
start
:To start, please provide the userdata for flickr.;
:v_login: login status ({Successful, Fails}); <<objectSignal>>
if () then ([v_login = 'Successful'])
:If the login is successful,;
else ([v_login = 'Fails'])
:if the login fails,;
:v_retry: retry decision ({Try, Abort, StillTry, DecideAbort}); <<objectSignal>>
switch ()
case ([v_retry = 'Try'])
:If you want to try again,;
:please provide the userdata for flickr.;
case ([v_retry = 'Abort'])
:if you choose to abort,;
case ([v_retry = 'StillTry'])
:If you still want to try again,;
case ([v_retry = 'DecideAbort'])
:if you decide to abort,;
endswitch
endif
:the process will end.;
stop
@enduml