  "mutations": [
    {
      "refs": [
        "guard:b5->n17",
        "guard:b5->n29"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "reason": "The source specifies 'Simultaneously', which indicates a parallel (AND) execution. The model incorrectly implements this as an exclusive (XOR) decision branch with invented decision guards, altering the core behaviour."
    }
  ],
  "omissions": [],
  "additions": [
    {
      "refs": [
        "guard:b8->n6"
      ],
      "reason": "The model introduces an XOR decision branching between 'Check again' and 'Verify', but the source text describes these as sequential steps without any such decision point."
    },
    {
      "refs": [
        "guard:b8->n9"
      ],
      "reason": "The model introduces an XOR decision branching between 'Check again' and 'Verify', but the source text describes these as sequential steps without any such decision point."
    }
