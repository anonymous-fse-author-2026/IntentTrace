      ],
      "verbatim_texts": [
        "start the process"
      ],
      "justification": "Starts the process and models the initial step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "empty the mailbox"
      ],
      "justification": "Direct match for emptying the mailbox."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "Models the first check of the mailbox and opens the decision."
    },
    {
      "refs": [
        "guard:b1->c3",
        "guard:b2->c3"
      ],
      "verbatim_texts": [
        "if not"
      ],
      "justification": "Models the negative outcome of the mailbox checks."
    },
    {
      "refs": [
        "action:n5",
        "action:n26"
      ],
      "verbatim_texts": [
        "continue the process"
      ],
      "justification": "Captures the steps to continue the process when the mailbox is not empty or at the end of the new member flow."
    },
    {
      "refs": [
        "guard:b1->c4",
        "guard:b2->c4"
      ],
      "verbatim_texts": [
        "If it is empty"
      ],
      "justification": "Models the positive outcome of the mailbox checks."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Terminates the process when the mailbox is empty."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again"
      ],
      "justification": "Models the second check of the mailbox."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Models the information verification step and its resulting decision."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If it is complete"
      ],
      "justification": "Positive arm of the information completeness check."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "add the incoming mail number, date, and record it in the letter book"
      ],
      "justification": "Direct match for the data entry step."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is not complete"
      ],
      "justification": "Negative arm of the information completeness check."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "make a telephone call to the sender"
      ],
      "justification": "Direct match for contacting the sender."
    },
    {
      "refs": [
        "label:n11->n12"
      ],
      "verbatim_texts": [
        "After the telephone call"
      ],
      "justification": "Temporal dependency modeled as a label."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "complete the data by adding the incoming mail number, date, and record it in the letter book"
      ],
      "justification": "Completes the data entry step and re-joins the flow."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda"
      ],
      "justification": "Direct match."
    },
    {
