      ],
      "justification": "Captures the 'otherwise' condition (no code within 24h) via the guard, and models the 24 hours passing condition as an action step. This preserves behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "call a travel agency"
      ],
      "justification": "Direct match for calling the travel agency."
    },
    {
