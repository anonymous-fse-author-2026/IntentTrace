      ],
      "verbatim_texts": [
        "To begin with, you should choose your destination and calculate the distance."
      ],
      "justification": "The opening unit implicitly starts the process and describes the first action of choosing destination and calculating distance."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check if you need to book a train or a flight."
      ],
      "justification": "Models the check and structural split (and implicit convergence) for deciding between booking a train or a flight."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the answer is \"no\""
      ],
      "justification": "Captures the negative outcome condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to book a train"
      ],
      "justification": "Direct match for the action of booking a train."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the answer is \"yes\""
      ],
      "justification": "Captures the positive outcome condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "book a flight"
      ],
      "justification": "Direct match for the action of booking a flight."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours"
      ],
      "justification": "Opens the decision gateway for code availability and captures the positive condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the process will end."
      ],
      "justification": "Matches the end of the process and represents it structurally and actively."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
