@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process;
:claim what is requested;
:check insured status of claimant;
:v1: is claimant insured? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:evaluate the claim;
:is claim simple or complex?;
:v2: is claim simple or complex? ({simple, complex}); <<objectSignal>>
if () then ([v2 = 'simple'])
:simple one;
else ([v2 = 'complex'])
:complex one;
endif
:send the relevant forms accordingly;
repeat :;
:Once the forms are returned;
:check them for completeness;
:v3: are all relevant details provided? ({Yes, No}); <<objectSignal>>
backward:inform the claimant to complete them;
repeat while () is ([v3 = 'No']) not ([v3 = 'Yes'])
:register the claim;
:the process comes to an end;
stop
else ([v1 = 'No'])
:reject the claim;
:notify the claimant;
:end process;
stop
endif
@enduml