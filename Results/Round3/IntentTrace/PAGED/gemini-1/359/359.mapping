  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Initializes the process and models the first identifying action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "Models the first decision point and condition. The condition is modeled both as a guard and redundantly as an action, which preserves behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "advertise the vacancy."
      ],
      "justification": "Direct match for the negative path action."
    },
    {
      "refs": [
        "guard:b1->n_cont"
      ],
      "verbatim_texts": [
        "if there is a suitable candidate available"
      ],
      "justification": "Direct match for the positive path condition."
    },
    {
      "refs": [
        "action:n_cont"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Direct match for the positive path action and the structural convergence of the first branch."
    },
    {
      "refs": [
        "guard:b2->n5",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available"
      ],
      "justification": "Captures the second decision point, its negative condition, the implicit opposite condition, and the subsequent path convergence."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "advertise the vacancy again."
      ],
      "justification": "Direct match for the subsequent advertising action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "proceed with selecting the appropriate applicant."
      ],
      "justification": "Direct match for the selection action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed"
      ],
      "justification": "Captures the final events and the termination of the process. Splitting the end description into two redundant actions still preserves the behaviour."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Captures the final events and the termination of the process. Splitting the end description into two redundant actions still preserves the behaviour."
    }
