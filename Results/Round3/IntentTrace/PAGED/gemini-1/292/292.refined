init(i1)
action(n1, "To start the process")
action(n2, "receiving the claim")
action(n3, "create the claim and record it")
action(n4, "make a decision on the claim")
branch(b1, XOR)
action(n16, "If the claim is to be rejected")
action(n5, "reject it")
action(n6, "review the claim rejection")
branch(b2, XOR)
action(n18, "If the claim rejection is accepted")
action(n19, "if the claim rejection is not accepted")
converge(c2)
action(n7, "continue the process")
action(n17, "if the claim is to be accepted")
action(n9, "offer the benefit")
action(n10, "prepare the claim discharge")
action(n11, "record the benefit payment")
converge(c1)
branch(b3, XOR)
action(n13, "operate outgoing payment")
action(n14, "close the claim")
converge(c3)
action(n15, "the process ends")
end(e1)
defines(v1, "decision on the claim", {"rejected", "accepted"})
defines(v2, "claim rejection accepted", {"accepted", "not accepted"})
defines(v3, "payment or close", {"payment", "close"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n16, n17, n5, n6, b2, n18, n19, c2, n7, n9, n10, n11, c1, b3, n13, n14, c3, n15, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n16)
precedence(b1, n17)
precedence(n16, n5)
precedence(n17, n9)
precedence(n5, n6)
precedence(n6, b2)
precedence(b2, n18)
precedence(b2, n19)
precedence(n18, c2)
precedence(n19, c2)
precedence(c2, n7)
precedence(n7, c1)
precedence(n9, n10)
precedence(n10, n11)
precedence(n11, c1)
precedence(c1, b3)
precedence(b3, n13)
precedence(b3, n14)
precedence(n13, c3)
precedence(n14, c3)
precedence(c3, n15)
precedence(n15, e1)
guard(b1, n16, v1 = 'rejected')
guard(b1, n17, v1 = 'accepted')
guard(b2, n18, v2 = 'accepted')
guard(b2, n19, v2 = 'not accepted')
guard(b3, n13, v3 = 'payment')
guard(b3, n14, v3 = 'close')