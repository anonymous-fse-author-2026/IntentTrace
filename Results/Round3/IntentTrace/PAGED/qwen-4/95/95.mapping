{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "The opening unit implicitly starts the process and describes the initial ordering action."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "Check the Customer's Credit Limit"
      ],
      "justification": "Directly models the credit limit verification step."
    },
    {
      "refs": [
        "guard:b1->i3",
        "action:i3"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "Opens the first XOR decision, applies the 'Okay' guard, and executes the corresponding availability check."
    },
    {
      "refs": [
        "guard:b1->i4",
        "action:i4"
      ],
      "verbatim_texts": [
        "However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Applies the 'No' guard, sends the denial, and terminates this execution path."
    },
    {
      "refs": [
        "guard:b2->i5",
        "action:i5"
      ],
      "verbatim_texts": [
        "if the response is \"Okay\", proceed to Check the Availability of the Article again."
      ],
      "justification": "Models the repeated availability check triggered by an 'Okay' response."
    },
    {
      "refs": [
        "guard:b2->i6",
        "action:i6"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Handles the alternative negative outcome for the repeated check, sending a denial and ending the path."
    },
    {
      "refs": [
        "guard:b3->i7",
        "action:i7"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Correctly splits on unavailability and routes to production."
    },
    {
      "refs": [
        "guard:b3->i8",
        "action:i8"
      ],
      "verbatim_texts": [
        "However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Correctly routes available articles to collection."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Rejoins the availability branches and proceeds to send the confirmation."
    },
    {
      "refs": [
        "action:i10"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "Groups the simultaneous shipping and invoicing into a single logical action, preserving behaviour."
    },
    {
      "refs": [
        "action:i11"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Structural convergence leads into the payment status check as described in the flow."
    },
    {
      "refs": [
        "guard:b5->i12",
        "action:i12"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "Routes received payments to order closure and explicitly ends the process."
    },
    {
      "refs": [
        "guard:b5->i14",
        "action:i14"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Guard captures the unpaid condition; action covers the reminder count evaluation."
    },
    {
      "refs": [
        "guard:b6->i15",
        "action:i15"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Correctly applies the >=3 threshold and triggers the write-off."
    },
    {
      "refs": [
        "guard:b6->i16",
        "action:i16"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Handles the complementary case (<3 reminders) by sending a reminder instead."
    },
    {
      "refs": [
        "action:i17"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Finalizes the write-off path with order closure and process termination."
    }
  ],
