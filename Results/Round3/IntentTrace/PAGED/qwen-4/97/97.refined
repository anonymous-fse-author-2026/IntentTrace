init(i1)
action(n1, "start verifying account")
action(n2, "Is the amount less than 200 euros")
branch(b1, XOR)
action(n3, "Approve the expense report")
action(n4, "Evaluate the expense report")
action(n5, "Is the expense report acceptable")
branch(b2, XOR)
action(n6, "Approve the expense report")
action(n7, "End process")
end(e1)
action(n8, "End process")
end(e2)
defines(v1, "amount", {[0-1000000]})
defines(v2, "report_status", {"acceptable", "not satisfactory"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, b2, n6, n7, e1, n8, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n4, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n8)
precedence(n6, n7)
precedence(n7, e1)
precedence(n3, e1)
precedence(n8, e2)
guard(b1, n3, v1 < 200)
guard(b1, n4, v1 >= 200)
guard(b2, n6, v2 = 'acceptable')
guard(b2, n8, v2 = 'not satisfactory')