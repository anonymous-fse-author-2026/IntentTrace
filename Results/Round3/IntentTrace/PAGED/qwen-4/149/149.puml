@startuml
!theme plain
|a_default| Default
|a_default|
start
:Request to Purchase Motorcycle;
:Production Order Received?;
:v1: Production Order Received? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Continue with Production Order;
:v2: Material Availability ({Unavailable, Available}); <<objectSignal>>
if () then ([v2 = 'Unavailable'])
:Order Materials from Supplier;
split
:Receive Materials from Supplier;
:Issue Goods and Produce Motorcycles;
split again
end split
else ([v2 = 'Available'])
:Place Manufacturing Order;
split
split again
end split
endif
:v3: Post Production Action ({Dispatch, UpdateSales}); <<objectSignal>>
if () then ([v3 = 'Dispatch'])
:Dispatch Motorcycles;
else ([v3 = 'UpdateSales'])
:Update Stock and Sales Information;
endif
else ([v1 = 'No'])
:Update Sales Information and Proceed to Dispatch;
endif
stop
@enduml