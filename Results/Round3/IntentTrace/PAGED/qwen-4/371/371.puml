@startuml
!theme plain
|a_default| Default
|a_default|
start
:To start the ExpenseReport process, begin by clicking on "Start" and then selecting "Edit Report".;
:click Start;
:select Edit Report;
:If the expense is greater than 1000, the report should be reviewed.;
:v1: expense ({[-]}); <<objectSignal>>
if () then ([v1 > 1000])
:review report;
else ([v1 <= 1000])
:However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation.;
:v3: translation required? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:proceed to translate the receipts.;
else ([v3 = 'No'])
:confirm the receipts.;
endif
endif
:After this, evaluate the review decision.;
:v2: review decision ({Rejected, Approved}); <<objectSignal>>
if () then ([v2 = 'Rejected'])
:If the report is rejected, edit the report.;
stop
else ([v2 = 'Approved'])
:If it is approved, continue to check if there is a need for translation.;
:v3: translation required? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:proceed to translate the receipts.;
else ([v3 = 'No'])
:confirm the receipts.;
endif
:Once again, evaluate the review decision.;
:v4: evaluate review decision ({Rejected, Approved}); <<objectSignal>>
if () then ([v4 = 'Rejected'])
:If the report is rejected, edit the report.;
stop
else ([v4 = 'Approved'])
:translate the receipts;
:then confirm them;
:Finally, evaluate the receipts decision.;
:v5: evaluate receipts decision ({Accepted, Rejected}); <<objectSignal>>
if () then ([v5 = 'Accepted'])
:If the receipts are accepted, proceed to process the expense.;
else ([v5 = 'Rejected'])
:If they are rejected, edit the report.;
endif
stop
endif
endif
@enduml