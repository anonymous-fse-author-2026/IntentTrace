{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Initializes the process and details the starting clicks. Splitting the instruction into discrete actions preserves behavior."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "Captures the threshold condition and the review action. Modeling the conditional statement as an additional action node alongside the branch/guard is behavior-preserving."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Captures the complementary threshold and directs flow toward the translation check."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9",
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts. If not, confirm the receipts."
      ],
      "justification": "Correctly splits the flow based on whether translation is needed and rejoins the paths afterwards."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Direct match for the review evaluation step."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Models the rejection branch leading to report editing and a terminal state."
    },
    {
      "refs": [
        "guard:b2->n18",
        "action:n18",
        "guard:b6->n13",
        "action:n13",
        "guard:b6->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Follows the approval path to re-check translation needs, implementing the required conditional split."
    },
    {
      "refs": [
        "action:n11",
        "guard:b4->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Re-evaluates the review decision and branches into the rejection path. The editing step mirrors earlier logic and is fully supported."
    },
    {
      "refs": [
        "guard:b4->n19",
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "translate the receipts and then confirm them."
      ],
      "justification": "Follows the approval path from the second evaluation. Splits the compound instruction into two sequential actions, preserving order and meaning."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Direct match for the final evaluation step."
    },
    {
      "refs": [
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Models the acceptance branch leading directly to expense processing."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Models the rejection branch leading to report editing and process termination."
    }
  ],
