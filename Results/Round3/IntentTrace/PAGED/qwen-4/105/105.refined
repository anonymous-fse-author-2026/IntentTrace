init(i1)
action(n2, "make an appointment at the hairdresser's")
action(n3, "go to the hairdresser's")
branch(b1, XOR)
action(n5, "wash hair")
action(n7, "dye hair")
action(n9, "cut hair")
converge(c1)
action(n10, "pay the hairdresser")
end(e1)
defines(v_service, "service_type", {"wash", "dye", "cut"})
actor(a_default, "Default", [i1, n2, n3, b1, n5, n7, n9, c1, n10, e1])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(b1, n7)
precedence(b1, n9)
precedence(n5, c1)
precedence(n7, c1)
precedence(n9, c1)
precedence(c1, n10)
precedence(n10, e1)
guard(b1, n5, v_service = 'wash')
guard(b1, n7, v_service = 'dye')
guard(b1, n9, v_service = 'cut')