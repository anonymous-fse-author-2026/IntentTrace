      "verbatim_texts": [
        "we start by checking if the input is a \"URN\"."
      ],
      "justification": "Starts the process and captures the initial conditional check as an action."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If it is, we proceed with the step of \"ONS-Resolving URN to a domain-name\"."
      ],
      "justification": "Models the XOR decision point, the URN condition guard, and the positive branch action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the input is a \"URL\", we simply continue with the process."
      ],
      "justification": "Models the alternative URL condition guard and its corresponding continuation step."
    },
    {
      "refs": [
        "converge:n5"
      ],
      "verbatim_texts": [
        "If it is, we proceed with the step of \"ONS-Resolving URN to a domain-name\".",
        "If the input is a \"URL\", we simply continue with the process."
      ],
      "justification": "Rejoins the split flows after both input type cases are handled."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once we have resolved the URN to a domain-name, we send a DNS query."
      ],
      "justification": "Directly corresponds to sending the DNS query after resolution."
    },
    {
      "refs": [
        "action:n10",
        "action:n12"
      ],
      "verbatim_texts": [
        "The result of this query is a list of URLs, which we then use to link to a designated DS."
      ],
      "justification": "Splits the single source sentence into receiving the URL list and using it to link to the DS, preserving behaviour."
    },
    {
      "refs": [
        "action:n14",
        "action:n16"
      ],
      "verbatim_texts": [
        "Finally, we link to the designated DS and the process comes to an end."
      ],
      "justification": "Restates the final linking step, marks process completion, and terminates the flow."
    }
