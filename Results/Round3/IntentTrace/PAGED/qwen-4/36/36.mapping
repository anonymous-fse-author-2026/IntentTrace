{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Establishes process start and the first decision point. Checking condition modeled as action is behaviour-preserving."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Positive branch of the first decision accurately captured."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Negative branch and flow rejoin correctly represent the alternative path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Direct paraphrase of the next sequential step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits."
      ],
      "justification": "Captures the subsequent validation check and opens the correct XOR gateway."
    },
    {
      "refs": [
        "action:n6",
        "guard:b3->n6"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "Correctly models the outcome when changes fall outside client limits."
    },
    {
      "refs": [
        "action:n7",
        "guard:b3->n7"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process. After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Models the outcome when changes are within limits. Redundant source phrasing does not affect behaviour."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Exact behavioural match."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Exact behavioural match."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Exact behavioural match."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Exact behavioural match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Exact behavioural match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Correctly initiates the next decision point."
    },
    {
      "refs": [
        "action:n14",
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If they are, continue with the process."
      ],
      "justification": "Positive outcome path correctly captured."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->n15"
      ],
      "verbatim_texts": [
        "If not, select a new applicant from the list."
      ],
      "justification": "Negative outcome path correctly captured."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Correctly initiates the final decision point."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Correctly models process termination and joins parallel/concurrent flows structurally."
    },
    {
      "refs": [
        "action:n18",
        "guard:b5->n18"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Correctly models the fallback path when client rejects changes."
    }
  ],
