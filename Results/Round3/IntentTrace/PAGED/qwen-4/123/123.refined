init(s0)
action(i1, "Obtain raw material from received list")
branch(b1, XOR)
action(i6, "Check raw material")
end(i8)
action(n6, "Select supplier")
action(n7, "Send material purchase order")
action(n_check2, "Check raw material")
end(e2)
defines(v1, "Is raw material available in stock?", {"Available", "Not Available"})
actor(a_default, "Default", [s0, i1, b1, i6, i8, n6, n7, n_check2, e2])
precedence(s0, i1)
precedence(i1, b1)
precedence(b1, i6)
guard(b1, i6, v1 = 'Available')
precedence(i6, i8)
precedence(b1, n6)
guard(b1, n6, v1 = 'Not Available')
precedence(n6, n7)
precedence(n7, n_check2)
precedence(n_check2, e2)