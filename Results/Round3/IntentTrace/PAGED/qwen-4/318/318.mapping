      ],
      "verbatim_texts": [
        "send a reminder."
      ],
      "justification": "Standard reminder step."
    },
    {
      "refs": [
        "action:n35"
      ],
      "verbatim_texts": [
        "complete the court proceedings."
      ],
      "justification": "Court procedure step."
    },
    {
      "refs": [
        "action:n36"
      ],
      "verbatim_texts": [
        "send the reminder."
      ],
      "justification": "Secondary reminder step."
    }
