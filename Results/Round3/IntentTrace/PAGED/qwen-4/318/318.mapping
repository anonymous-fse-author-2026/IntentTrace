{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process, start by receiving the order."
      ],
      "justification": "Start node and first action correspond to the opening instruction."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "check the order and check the customer."
      ],
      "justification": "Parallel checks initiated by an AND gateway."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If the order is okay,"
      ],
      "justification": "Decision node and positive guard."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the order is not okay,"
      ],
      "justification": "Negative guard for the order check."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "if the customer is permitted,"
      ],
      "justification": "Decision node and positive guard for customer permission."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the customer is not permitted,"
      ],
      "justification": "Negative guard for customer permission."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "send a refusal."
      ],
      "justification": "Action for unpermitted customer."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "end the process."
      ],
      "justification": "Termination step."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "send a refusal and end the process."
      ],
      "justification": "Combined refusal and termination step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Release the order and then transfer the data in the database."
      ],
      "justification": "Sequential administrative steps."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "check the worth of the order. If it is greater than 10.000 \u20ac,"
      ],
      "justification": "Threshold check action and branching point."
    },
    {
      "refs": [
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "greater than 10.000 \u20ac"
      ],
      "justification": "Explicit threshold value for the positive guard."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "Otherwise,"
      ],
      "justification": "Falling into the negative branch."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "sign off on the order."
      ],
      "justification": "Positive outcome action."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Sign off on the order and forward it to production."
      ],
      "justification": "Continuation and forwarding action."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "check the product quality, start production, and produce the product."
      ],
      "justification": "Three parallel production steps triggered by an AND gateway."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "create a material report."
      ],
      "justification": "Report generation step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "send it to the warehouse."
      ],
      "justification": "Dispatch step followed by flow convergence."
    },
    {
      "refs": [
        "action:n22",
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "create a quality report, send the product to shipment, and send the order to accounting."
      ],
      "justification": "Three parallel dispatch/report steps."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "send it to Finance."
      ],
      "justification": "Finance notification step."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Ship the product and send the invoice."
      ],
      "justification": "Shipping and billing step."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "archive it."
      ],
      "justification": "Archiving step."
    },
    {
      "refs": [
        "action:n37"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Explicit textual announcement of process termination mapped to end node."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "Check the payment."
      ],
      "justification": "Payment verification step."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "If the payment is received,"
      ],
      "justification": "Payment decision split."
    },
    {
      "refs": [
        "guard:b4->n31"
      ],
      "verbatim_texts": [
        "payment is received"
      ],
      "justification": "Positive payment guard."
    },
    {
      "refs": [
        "guard:b4->n32"
      ],
      "verbatim_texts": [
        "payment is not received"
      ],
      "justification": "Negative payment guard."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "close the order."
      ],
      "justification": "Order closure step."
    },
    {
      "refs": [
        "action:n38"
      ],
      "verbatim_texts": [
        "Close the order and end the process."
      ],
      "justification": "Final convergence and termination."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "check if a reminder has been sent more than three times."
      ],
      "justification": "Reminder frequency check and branch."
    },
    {
      "refs": [
        "guard:b5->n33"
      ],
      "verbatim_texts": [
        "more than three times"
      ],
      "justification": "Threshold guard for exceeding reminders."
    },
    {
      "refs": [
        "guard:b5->n34"
      ],
      "verbatim_texts": [
        "check if a reminder has been sent more than three times."
      ],
      "justification": "Implicit fallback guard for remaining within limit."
    },
    {
      "refs": [
        "action:n33"
      ],
      "verbatim_texts": [
        "acquire a lawyer."
      ],
      "justification": "Legal escalation step."
    },
    {
