init(start)
action(n1, "start the process")
action(n2, "undergo immigration checks")
action(n3, "select method for exit control checks")
branch(b5, XOR)
action(n4, "use biometrics for exit control checks")
action(n5, "use ID documents for exit control checks")
converge(join_method)
branch(b1, XOR)
action(n8, "leave the area")
action(n9, "proceed to the next step")
converge(c2)
action(n18, "process ends")
end(e1)
defines(v_method, "exit control method", {"biometrics", "id_documents"})
defines(v_result, "check outcome status", {"denied_unsuccessful", "allowed_successful"})
actor(a_default, "Default", [start, n1, n2, n3, b5, n4, n5, join_method, b1, n8, n9, c2, n18, e1])
precedence(start, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b5)
precedence(b5, n4)
precedence(b5, n5)
precedence(n4, join_method)
precedence(n5, join_method)
precedence(join_method, b1)
precedence(b1, n8)
precedence(b1, n9)
precedence(n8, c2)
precedence(n9, c2)
precedence(c2, n18)
precedence(n18, e1)
guard(b5, n4, v_method = 'biometrics')
guard(b5, n5, v_method = 'id_documents')
guard(b1, n8, v_result = 'denied_unsuccessful')
guard(b1, n9, v_result = 'allowed_successful')