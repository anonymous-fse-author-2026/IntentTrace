{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For TS recruitment, the first step is to advise unsuccessful candidates."
      ],
      "justification": "Initial trigger and first action align directly."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\", then the position should be re-advertised."
      ],
      "justification": "Branch and guard correctly route the 'no more candidates' condition to re-advertisement."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "if the terms and conditions of the offer for a candidate need to be sorted out, it is necessary to check if the candidate has accepted a voluntary redundancy"
      ],
      "justification": "Models the alternative path of the initial decision, splitting the compound check into sequential steps as described."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the candidate has not accepted, the process continues."
      ],
      "justification": "Negative outcome of the redundancy check continues the flow."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the candidate has accepted, further investigation is required."
      ],
      "justification": "Positive outcome triggers investigation and merges flows back together."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form, which is then received by the next level manager."
      ],
      "justification": "Directly maps sending and receiving steps."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the manager is an external resource, they may not authorize the form."
      ],
      "justification": "Models the external manager path and its authorization constraint."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "However, if the approver is an existing employee of the client, the process continues."
      ],
      "justification": "Models the internal/client employee path continuing the process."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the form is approved, the recruitment manager sends the form and other documentation, which is received by the client HR."
      ],
      "justification": "Captures approval and subsequent transfer to client HR."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "justification": "Direct match for scanning and recording."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If there are any variations, a complete business case is required."
      ],
      "justification": "Routes variation scenarios to business case creation."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "Otherwise, the process continues."
      ],
      "justification": "Default continuation path."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment"
      ],
      "justification": "Structural decision point for medical assessment requirement."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "it is applicable for a 12% rate"
      ],
      "justification": "Positive branch applies the specified rate."
    },
    {
      "refs": [
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "Otherwise, a medical assessment is not necessary."
      ],
      "justification": "Negative branch skips assessment and merges flow."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "The TS HR coordinator informs the recruitment manager, who then liaises with the HR representative to confirm the offer to the candidate."
      ],
      "justification": "Direct match for coordination and liaison step."
    },
    {
      "refs": [
        "guard:b6->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory, the next candidate on the shortlist should be contacted."
      ],
      "justification": "Handles unsatisfactory assessment outcome."
    },
    {
      "refs": [
        "guard:b6->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "However, if the assessment is fine, the process continues."
      ],
      "justification": "Handles satisfactory assessment outcome."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "The recruitment manager makes a formal verbal offer of employment to the candidate."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b7->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If the candidate accepts, the recruitment manager creates a formal written offer."
      ],
      "justification": "Acceptance path generates written offer."
    },
    {
      "refs": [
        "guard:b7->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If the candidate declines, the process continues."
      ],
      "justification": "Declination path continues process."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Simultaneously, the commencement pack and letter of appointment are sent to the candidate."
      ],
      "justification": "Direct match for document dispatch."
    },
    {
      "refs": [
        "action:n27",
        "guard:b8->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "Once the candidate receives these documents, if there is a \"40%\" rate, renegotiation is required."
      ],
      "justification": "Models receipt and branches on the 40% rate triggering renegotiation."
    },
    {
      "refs": [
        "guard:b8->n29",
        "action:n29"
      ],
      "verbatim_texts": [
        "Otherwise, if the candidate accepts, the process continues."
      ],
      "justification": "Alternative path when 40% rate does not apply/candidate accepts."
    },
    {
      "refs": [
        "guard:b9->n30",
        "action:n30"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful, the process continues."
      ],
      "justification": "Successful renegotiation continues flow."
    },
    {
      "refs": [
        "guard:b9->n31",
        "action:n31"
      ],
      "verbatim_texts": [
        "However, if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified."
      ],
      "justification": "Unsuccessful renegotiation routes to identifying next candidate."
    }
  ],
  "mutations": [],
  "omissions": [],
  "additions": [],
