branch(b2, XOR)
converge(c2)
defines(v1, "do you want to select a copy or view new copies?", {"select_copy", "view_new_copies"})
defines(v2, "initial_choice", {"details", "new_copies", "used_copies"})
actor(a_default, "Default", [i1, n2, n3, n4, n5, b1, n6, n7, e1, n8, n9, n10, n11, e2, c1, b2, c2])
precedence(i1, n2)
precedence(n5, b1)
precedence(n7, e1)
