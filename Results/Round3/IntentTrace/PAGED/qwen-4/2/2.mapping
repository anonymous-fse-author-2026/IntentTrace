      ],
      "verbatim_texts": [
        "For TS recruitment, the first step is to advise unsuccessful candidates."
      ],
      "justification": "Implicit process start and the initial advising step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
