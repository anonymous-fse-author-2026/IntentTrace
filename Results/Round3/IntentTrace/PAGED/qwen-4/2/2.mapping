        "action:n4"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\", then the position should be re-advertised."
      ],
      "justification": "Models the candidate availability check, the split, and the re-advertisement path when true."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check if the candidate has accepted a voluntary redundancy.",
        "if the candidate has accepted, further investigation is required."
      ],
      "justification": "Captures the voluntary redundancy check, the branching logic, and the investigation step when accepted."
    },
