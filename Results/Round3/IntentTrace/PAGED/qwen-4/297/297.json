  "input_elements": [
    {
      "id": "i1",
      "content": "To become a member, start the process at 8:00 am and then empty the mailbox."
    },
    {
      "id": "i2",
      "content": "Check if the mailbox is empty, if not, continue the process. If it is empty, the process ends."
    },
    {
      "id": "i4",
      "content": "Verify if the information is complete. If it is complete, add the incoming mail number, date, and record it in the letter book."
    },
    {
      "id": "i5",
      "content": "If it is not complete, make a telephone call to the sender. After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
    },
    {
      "id": "i6",
      "content": "Every Wednesday evening, take the letter book and member register to Miranda."
    },
    {
      "id": "i7",
      "content": "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it. If the applicant cannot become a member, write to them and inform them of the decision."
    },
    {
      "id": "i8",
      "content": "After stamping \"new Member\" on the letter and writing the date on it, write the data."
    },
    {
      "id": "i9",
      "content": "Simultaneously, calculate the fee and hand the letter to Charles. Ask Charles to write the amount in the register."
    },
    {
      "id": "i10",
      "content": "Print the membership card with all the data and send it to the new member. The process ends."
    },
    {
      "id": "i11",
      "content": "Hand the letter to Charles and add the new member to the register. Prepare an invoice for the new members and continue the process."
    },
    {
      "id": "i12",
      "content": "Ask Charles to write the amount in the register and write the fee amount to the register."
    }
  ]
