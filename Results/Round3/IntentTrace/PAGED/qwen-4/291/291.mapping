{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "Initiates the process and captures the first action of starting and entering metadata."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After entering the metadata, proceed to the IN-Patient step."
      ],
      "justification": "Directly models the second step."
    },
    {
      "refs": [
        "guard:b2->n2",
        "guard:b2->n3",
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: send data to suppliers and create a claim."
      ],
      "justification": "Models the concurrent/split steps as a branch with guards routing to the respective paths. Behavior-preserving structural modeling."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the data is sent to suppliers, extract the data from the suppliers and transfer it to the doctor's phone."
      ],
      "justification": "Captures the extraction and transfer steps following the supplier interaction."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "After that, confirm the GOP and the process will come to an end."
      ],
      "justification": "Confirms GOP, notes the ending condition as an action, and places a structural end node."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Next, register the case and handle the claim."
      ],
      "justification": "Directly maps to registering the case and handling the claim."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status."
      ],
      "justification": "Maps to extracting data and updating records/status."
    },
    {
      "refs": [
        "action:n15",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Register the case, handle the claim, and then receive the payment."
      ],
      "justification": "Captures the registration, claim handling, and payment receipt sequence."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Enter the data on the patient's record or confirm the IN-Patient status, and then send the data back to the suppliers."
      ],
      "justification": "Models sending data back to suppliers (record/status update already covered by prior elements)."
    },
    {
      "refs": [
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "Finally, receive the payment and conclude the process."
      ],
      "justification": "Final payment step, conclusion action, and terminal end node."
    }
  ],
