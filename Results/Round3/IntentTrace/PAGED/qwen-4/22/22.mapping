      "verbatim_texts": [
        "the process begins with receiving an order request."
      ],
      "justification": "Covers the implicit start node, a redundant 'start' action, and the explicit order receipt. All preserve the initial behaviour."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, the order is registered and evaluated."
      ],
      "justification": "Splits the combined registration and evaluation into two sequential actions, which preserves the overall behaviour."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the evaluation result is \"NOK\""
      ],
      "justification": "Opens the XOR decision point and captures the negative evaluation condition using a standard variable abstraction."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then the order is considered as \"NOK\" and the process comes to an end."
      ],
      "justification": "Handles the status update and process termination for the negative evaluation path."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if the evaluation result is \"ok\""
      ],
      "justification": "Captures the positive evaluation guard condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then the installation process takes place."
      ],
      "justification": "Direct match for the installation step following a positive evaluation."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the installation is not successful"
      ],
      "justification": "Opens the second decision point and captures the installation failure condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the order is considered as \"NOK\" and the process ends."
      ],
      "justification": "Handles the status update and termination for the failed installation path."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "However, if the installation is successful"
      ],
      "justification": "Captures the success guard for the installation outcome."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the next step is to check the installation."
      ],
      "justification": "Direct match for the verification/check step on the success path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the installation is verified, the billing is prepared."
      ],
      "justification": "Direct match for the billing preparation step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
