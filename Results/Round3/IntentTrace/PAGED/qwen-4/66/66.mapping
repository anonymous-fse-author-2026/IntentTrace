      "verbatim_texts": [
        "To begin the process in the Admin Office, first check if it has started."
      ],
      "justification": "The init node and the first action step directly correspond to the opening instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, verify the completeness of the invoices."
      ],
      "justification": "Structural convergence and the verification action align with this unit."
    },
    {
