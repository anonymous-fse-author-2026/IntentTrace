{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "The opening unit defines the process start and two sequential initial actions, all captured correctly."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
      ],
      "justification": "Captures the positive arm of the first decision gateway and its associated action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance."
      ],
      "justification": "Captures the negative arm of the first decision and the resulting state/action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "In the case of an Outstanding Balance, a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "Directly models placing a new order and terminates this path at a structural end node."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If a new order is placed, it will be recorded in the Accounts Receivable."
      ],
      "justification": "Paraphrases the recording step accurately without changing behaviour."
    },
    {
      "refs": [
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "If Payments are Received, the process continues."
      ],
      "justification": "Opens the payment decision and routes the positive outcome forward to continue the process."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "However, if no payments are received, the order is dropped."
      ],
      "justification": "Routes the negative payment outcome to the drop-order action; n11 is a redundant restatement of the state, which is permitted."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Next, identify the order for installation."
      ],
      "justification": "Exact match for the sequential step following continued process flow."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled, an Installer will be assigned."
      ],
      "justification": "Models the installation scheduling branch and assignment action; n15 redundantly states the assigned state, preserving behaviour."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "On the other hand, if the order does not require installation, it will be packed for delivery."
      ],
      "justification": "Captures the alternative branch for packing, includes redundant state node n17, and adds necessary structural ends and convergence plumbing to close the process paths."
    }
  ],
