    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with Low Inventory."
      ],
      "justification": "Initial trigger and first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, proceed to Create P.R.."
      ],
      "justification": "Direct match for the first creation step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, move on to Create P.R.,"
      ],
      "justification": "Second mention of the same step in the source, preserved as a separate action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "followed by Submit P.O.."
      ],
      "justification": "Submission step and subsequent structural convergence."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the P.O. is submitted, proceed to Ship Material."
      ],
      "justification": "Direct match for the shipping step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "At this point, check if the shipment is okay."
      ],
      "justification": "Condition modeled as an explicit check action, preserving behaviour."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed to Send Payment."
      ],
      "justification": "First XOR split for the positive condition; guard abstracts 'okay' as v2='Yes'."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if there are any problems with the shipment, communicate them accordingly."
      ],
      "justification": "Negative branch outcome from the first check."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "After checking the shipment status again, if it is okay, proceed to Send Payment."
      ],
      "justification": "Re-check step followed by second XOR split for the positive outcome."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Otherwise, communicate any shipment problems."
      ],
      "justification": "Negative branch outcome from the second check."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, once the payment is sent, the process comes to an end."
      ],
      "justification": "Process termination."
    }
  ],
