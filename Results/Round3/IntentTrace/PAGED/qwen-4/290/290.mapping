    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n16"
      ],
      "verbatim_texts": [
        "if someone \"Knows SLA\""
      ],
      "justification": "Action 'Know SLA?' models the condition, branch opens the XOR split, and guard 'v1 = Yes' captures the positive path."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "they should \"continue the process\"."
      ],
      "justification": "Directly implements the positive branch outcome."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If they don't \"Know SLA\""
      ],
      "justification": "Guard 'v1 = No' correctly captures the negative decision path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should \"Look up\"."
      ],
      "justification": "Implements the negative branch outcome."
    },
    {
