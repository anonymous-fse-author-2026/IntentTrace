    },
    {
      "refs": [
        "action:n5",
        "action:n11",
        "guard:b2->n6",
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "If the task is \"Urgent\""
      ],
      "justification": "Condition actions and dual branches/guards collectively model the second XOR decision on task urgency."
    },
    {
      "refs": [
        "action:n6",
        "action:n12"
      ],
      "verbatim_texts": [
        "they should \"Red Stamp\"."
      ],
      "justification": "Implements the urgent/task-positive outcome. Redundant duplication preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->n9",
        "guard:b3->n15",
        "action:n9",
        "action:n15"
      ],
      "verbatim_texts": [
        "If it is \"Non Urgent\""
      ],
      "justification": "Guards capture the non-urgent condition ('v2/v3 = No') and actions implement the implied continuation path."
    },
    {
      "refs": [
        "action:n8",
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicit termination point. Multiple end markers are structural redundancy that preserve the final state."
    }
