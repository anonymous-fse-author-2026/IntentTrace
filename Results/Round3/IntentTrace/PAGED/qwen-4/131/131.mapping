{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "Initiates the process and captures the initial preparatory steps."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->b_mb2",
        "action:n4"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty... If it is empty, the process ends."
      ],
      "justification": "Captures the first mailbox verification, its XOR split, the condition to terminate, and the condition to continue."
    },
    {
      "refs": [
        "guard:b_mb2->n_mb_end",
        "guard:b_mb2->n5",
        "action:n_mb_end"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again... If it is empty, the process ends."
      ],
      "justification": "Captures the second mailbox verification, conditions to terminate or proceed, and the termination step."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "Verify if the information is complete. If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Models the verification step, the positive branch condition, and the corresponding recording action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Captures the negative branch condition and the required phone call."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Captures data completion after the call and merges the two information-completeness paths."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Direct match of the scheduled transfer step."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Models the membership approval split, its positive condition, and the stamping action."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Captures the rejection condition, notification action, and process termination for non-members."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Direct match of the post-stamping data entry step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles. Ask Charles to write the amount in the register."
      ],
      "justification": "Uses an AND gateway to correctly model the simultaneous execution described in the text."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Direct match of the card printing and mailing step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Restates the process conclusion; modeling as an action alongside a structural end node is redundant but behaviour-preserving."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Hand the letter to Charles and add the new member to the register."
      ],
      "justification": "Direct match of the handover and registration update."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Prepare an invoice for the new members and continue the process."
      ],
      "justification": "Direct match of the invoicing step."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register and write the fee amount to the register."
      ],
      "justification": "Captures the final financial registration steps and marks the structural end of the process."
    }
  ],
