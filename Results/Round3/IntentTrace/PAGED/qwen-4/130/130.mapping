{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To acquire a new client, the first step is to identify the need for a new client."
      ],
      "justification": "Opens the process and captures the initial identification step."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "prepare a portfolio presentation and analyze the market."
      ],
      "justification": "Splits a combined source task into two sequential actions; preserves behaviour."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once these steps are done, the next step is to send an offer to the potential client."
      ],
      "justification": "Direct paraphrase of the next required step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After sending the offer, it is necessary to inform management about the potential client's responses."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Following this, the responses need to be analyzed and negotiations can begin."
      ],
      "justification": "Splits the combined analysis and negotiation unit into two steps; preserves behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "During the negotiation process, it is important to detail the offer according to the client's preferences and receive their response."
      ],
      "justification": "Direct match covering detailing the offer and receiving feedback."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the response is positive"
      ],
      "justification": "Models the conditional check as an explicit action step followed by a branch gateway; condition-as-action is a valid re-typing match."
    },
    {
      "refs": [
        "guard:b1->n11"
      ],
      "verbatim_texts": [
        "If the response is positive"
      ],
      "justification": "Gate guard aligns with the positive condition (abstracted as v1 = true)."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the next step is to prepare a contract for signing."
      ],
      "justification": "Positive branch outcome."
    },
    {
      "refs": [
        "guard:b1->n12"
      ],
      "verbatim_texts": [
        "if the response is negative"
      ],
      "justification": "Gate guard aligns with the negative condition (abstracted as v1 = false)."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "it is important to analyze the reasons for the rejection and learn from the experience."
      ],
      "justification": "Negative branch outcome."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the contract is prepared",
        "it can be signed"
      ],
      "justification": "One element covers the preparatory lead-in and the signing action; merging is behaviour-preserving."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "and the process comes to an end."
      ],
      "justification": "Explicitly models termination. The redundant action node alongside the structural end node does not change behaviour."
    }
  ],
