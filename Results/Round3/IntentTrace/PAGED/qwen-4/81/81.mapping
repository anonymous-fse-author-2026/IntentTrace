      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "For SSP: The first step is to receive and categorize the invoice."
      ],
      "justification": "Starts the process and performs the initial receiving/categorizing step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "\"Forward Invoice to Admin Officer\""
      ],
      "justification": "Captures the exact instruction string used as the guard condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the next step is to sort the invoice."
      ],
      "justification": "Opens the decision split and performs the sorting step associated with the forward instruction."
    },
    {
      "refs": [
        "guard:b1->e2"
      ],
      "verbatim_texts": [
        "if the instruction is to \"Reject invoice\", then the process ends there."
      ],
      "justification": "Captures the rejection condition and the immediate process termination."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the instruction is to \"Return invoice to client for completion\", then the invoice is received and categorized again."
      ],
      "justification": "Captures the return-to-client guard and action. Using the instruction text as the action label is a harmless re-typing that preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n10"
      ],
      "verbatim_texts": [
        "if the instruction is to \"Process Invoice for SAP Entry\", then the invoice is forwarded for validation."
      ],
      "justification": "Captures the SAP entry condition on the branch."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "if the instruction is to \"Process Invoice for SAP Entry\", then the invoice is forwarded for validation."
      ],
      "justification": "Models the path for the SAP entry instruction and the subsequent forwarding step. Splitting into two actions preserves the described flow."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the invoice is forwarded for validation, it is then validated, and the process ends."
      ],
      "justification": "Performs the validation step and terminates the process. end:e1 is included as additional structural termination plumbing."
    }
  ],
