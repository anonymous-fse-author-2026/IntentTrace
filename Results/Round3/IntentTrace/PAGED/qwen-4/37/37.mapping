{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Initializes the process and performs the first order placement step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Check the Customer's Credit Limit"
      ],
      "justification": "Directly implements the credit limit verification step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\""
      ],
      "justification": "Opens the XOR decision and captures the positive guard condition correctly."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article"
      ],
      "justification": "Positive branch action matching the source instruction."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the response is \"No\""
      ],
      "justification": "Captures the negative guard condition for the credit check branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "send a Denial to the Customer"
      ],
      "justification": "Implements the rejection action on the negative branch."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "After checking the availability, if the response is \"Okay\""
      ],
      "justification": "Models the secondary decision point and positive guard correctly."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article again"
      ],
      "justification": "Directly matches the re-check instruction."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the response is \"No\""
      ],
      "justification": "Negative guard for the second availability check."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "send a Denial to the Customer"
      ],
      "justification": "Redundant but behaviorally identical denial step on the alternative path; redundancy is a match."
    },
    {
      "refs": [
        "action:n6",
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If the Article is not available"
      ],
      "justification": "n6 acts as a harmless intermediate state check; b3 opens the decision and guard captures the unavailability condition."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "proceed to Produce the Goods"
      ],
      "justification": "Directly implements the production step when unavailable."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "However, if the Article is available"
      ],
      "justification": "Captures the availability guard condition."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "proceed to Collect the Goods"
      ],
      "justification": "Directly implements the collection step when available."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Direct match for the confirmation dispatch step."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "AND-split (b6) and converges accurately model the parallel execution implied by 'Simultaneously'."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Direct match for payment verification."
    },
    {
      "refs": [
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "If the payment has been received"
      ],
      "justification": "Opens the payment decision and correctly models the received-payment guard."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "close the Order and end the process."
      ],
      "justification": "Handles successful payment completion and termination."
    },
    {
      "refs": [
        "guard:b4->n19"
      ],
      "verbatim_texts": [
        "If the payment has not been received"
      ],
      "justification": "Correctly models the unpaid payment guard condition."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Directly implements the reminder threshold evaluation."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Branches on the threshold guard and executes the write-off action."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Modeled as the alternative path (count < 3); preserves the intended conditional reminder behavior."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Completes the write-off path and terminates the process."
    }
  ],
