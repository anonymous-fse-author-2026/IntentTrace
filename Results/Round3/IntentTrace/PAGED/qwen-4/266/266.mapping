  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "The process starts with an informational meeting that lasts half a day"
      ],
      "justification": "Models process initiation and the first action with correct duration."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the meeting is successful"
      ],
      "justification": "Opens the XOR decision gate and models the positive path condition using an equivalent variable guard."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "work on the storyboard, which takes a full day"
      ],
      "justification": "Direct match for the storyboard step and its duration."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "However, if the meeting is not successful"
      ],
      "justification": "Models the negative path condition using an equivalent variable guard."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Correctly terminates the process on the negative branch. Redundant action+end structure does not change behaviour."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "AND gateway correctly splits the workflow into two parallel tasks (site design and content prep) with accurate durations. Implicit continuation after storyboard success is behaviour-preserving."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After that, the site development takes 2 days"
      ],
      "justification": "Converges parallel paths and executes the development step with correct duration."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the site is built, it goes through a review process that lasts 1 day."
      ],
      "justification": "Direct match for the review step and its duration."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "moves on to the approval stage, which takes half a day."
      ],
      "justification": "Implicit continuation after successful review leads directly to the approval stage with correct duration."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the approval is complete, the process ends."
      ],
      "justification": "XOR branch checks approval status, guard maps completion to approved state, and process correctly terminates."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
      ],
      "justification": "Negative approval branch triggers rebuild action with correct duration."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the rebuild is complete, the process ends."
      ],
      "justification": "XOR branch checks rebuild status, guard maps completion appropriately, and process correctly terminates."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Negative rebuild branch triggers second rebuild action with correct duration and condition."
    }
  ],
