  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by claiming what is requested"
      ],
      "justification": "Captures the implicit start event and the initial action step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then check the insured status of the claimant"
      ],
      "justification": "Direct step correspondence."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the claimant is insured"
      ],
      "justification": "Opens the XOR decision gateway and defines the positive guard condition."
    },
    {
      "refs": [
        "label:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed to evaluate the claim"
      ],
      "justification": "Label on the positive branch and the subsequent evaluation action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "label:b1->n5"
      ],
      "verbatim_texts": [
        "if the claimant is not insured"
      ],
      "justification": "Defines the negative guard condition and corresponding branch label."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "reject the claim"
      ],
      "justification": "Action taken on the negative branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "notify the claimant"
      ],
      "justification": "Direct notification step following rejection."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the process comes to an end"
      ],
      "justification": "Redundant end action paired with the explicit end node; preserves termination behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the claim is a simple one or a complex one"
      ],
      "justification": "Conditional statement modeled as an action step; re-typing preserves behaviour."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "send the relevant forms accordingly"
      ],
      "justification": "Direct action following classification."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the forms are returned, check them for completeness."
      ],
      "justification": "Direct step correspondence."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided"
      ],
      "justification": "Condition modeled as action, opens second XOR gateway, and defines positive guard."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "proceed to register the claim"
      ],
      "justification": "Action taken on the positive branch."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "if not all the relevant details are provided"
      ],
      "justification": "Defines the negative guard condition."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "inform the claimant to complete them"
      ],
      "justification": "Action taken on the negative branch."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Once the claim is registered, the process comes to an end."
      ],
      "justification": "Explicit terminal point for the successful registration path."
    }
