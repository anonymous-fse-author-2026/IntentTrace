init(i1)
action(n1, "Trigger the resupply cycle")
action(n2, "Check inventory level")
branch(b1, XOR)
action(n4, "End process due to sufficient inventory")
end(e1)
action(n5, "Create purchase order")
action(n6, "Review purchase order")
branch(b2, XOR)
action(n8, "Rework purchase order")
converge(c_rev)
action(n23, "Reserve funds")
action(n24, "Send order to supplier")
branch(b8, AND)
action(n25, "Receive packing slip")
action(n27, "Record packing slip")
end(e4)
action(n26, "Receive invoice")
action(n28, "Record invoice")
end(e5)
defines(v1, "Is inventory level at or below minimum", {"Yes", "No"})
defines(v2, "Is purchase status rejected", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, e1, n5, c_rev, n6, b2, n8, n23, n24, b8, n25, n27, e4, n26, n28, e5])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, e1)
precedence(n5, c_rev)
precedence(n8, c_rev)
precedence(c_rev, n6)
precedence(n6, b2)
precedence(b2, n8)
precedence(b2, n23)
precedence(n23, n24)
precedence(n24, b8)
precedence(b8, n25)
precedence(b8, n26)
precedence(n25, n27)
precedence(n27, e4)
precedence(n26, n28)
precedence(n28, e5)
guard(b1, n4, v1 = 'No')
guard(b1, n5, v1 = 'Yes')
guard(b2, n8, v2 = 'Yes')
guard(b2, n23, v2 = 'No')