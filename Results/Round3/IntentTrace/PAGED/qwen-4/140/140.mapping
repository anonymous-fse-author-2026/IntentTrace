{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle"
      ],
      "justification": "Start node and first action correspond to the opening unit."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then check the inventory level."
      ],
      "justification": "Second sequential step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "XOR gateway models the condition; guard represents the positive path; action performs the order creation."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Negative path terminates the process."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Review step follows order creation."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "Decision point and rework action for rejected status."
    },
    {
      "refs": [
        "converge:c_rev"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Converge node routes flow back to the review step, capturing the loop-back behaviour."
    },
    {
      "refs": [
        "guard:b2->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Approval branch and fund reservation action."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Completes the approval path by sending the order."
    },
    {
      "refs": [
        "branch:b8"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "AND gateway splits flow into two parallel branches."
    },
    {
      "refs": [
        "action:n25",
        "action:n27"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Sequential steps in the packing slip branch."
    },
    {
      "refs": [
        "end:e4"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Termination after recording the packing slip."
    },
    {
      "refs": [
        "action:n26",
        "action:n28"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Sequential steps in the invoice branch."
    },
    {
      "refs": [
        "end:e5"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Termination after recording the invoice."
    }
  ],
