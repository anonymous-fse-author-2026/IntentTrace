init(i1)
action(n1, "Start the loan process")
action(n2, "Check loan application")
action(n3, "Application rejected")
action(n4, "Process ends")
end(e1)
action(n5, "Special terms agreed upon")
action(n6, "Disburse funds")
action(n7, "Process ends")
end(e2)
branch(b1, XOR)
defines(v1, "Application rejected", {"Yes", "No"})
defines(v2, "Special terms agreed upon", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, e1, n5, n6, n7, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n5)
precedence(n3, n4)
precedence(n4, e1)
precedence(n5, n6)
precedence(n6, n7)
precedence(n7, e2)
guard(b1, n3, v1 = 'Yes')
guard(b1, n5, v1 = 'No')