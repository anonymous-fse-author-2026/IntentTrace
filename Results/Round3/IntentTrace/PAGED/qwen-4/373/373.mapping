{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The init node marks the process start and action n1 directly paraphrases the initial receiving step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Direct restatement of the creation and recording step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "Action n3 models the decision-making step, and branch b1 structurally implements the resulting split."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "The guard captures the rejection condition and action n4 executes the rejection."
    },
    {
      "refs": [
        "guard:b1->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "The guard captures the acceptance condition and action n15 executes the benefit offer."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Direct match to the rejection review step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Direct match to the discharge preparation step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Direct match to the payment recording step."
    },
    {
      "refs": [
        "guard:b2->n8",
        "guard:b2->c3",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process. But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "The branch and guards model the two review outcomes, both routing to continuation (one directly, one via convergence), preserving the unconditional forward flow."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Convergence nodes c1 and c2 structurally rejoin divergent flows, while action n14 and end e1 explicitly terminate the process."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "The AND gateway b3 models simultaneous execution, and actions n12/n13 directly implement the two parallel closing steps."
    }
  ],
