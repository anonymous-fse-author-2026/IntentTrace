{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "The opening unit implicitly starts the process and describes the initial UI interactions. Splitting into separate actions and adding a generic start step preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "Opens the first XOR decision and captures the positive path (expense > 1000 leads to reviewing). Abstract guard value correctly routes the flow."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Captures the negative path of the first decision (expense <= 1000 leads to checking translation need)."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Opens the translation decision and models the positive outcome (translate receipts)."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Models the negative outcome (confirm receipts) and structurally converges the two translation paths."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Direct match for the first review evaluation step."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Branches on review decision and captures the rejection path (edit report)."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Captures the approval path leading to the next translation check."
    },
    {
      "refs": [
        "action:n12",
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision. If the report is rejected, edit the report. If it is approved,"
      ],
      "justification": "Covers the second evaluation step, the branch, and the rejection path. A second 'edit report' action is behaviourally equivalent to earlier ones."
    },
    {
      "refs": [
        "guard:b4->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "translate the receipts and then confirm them."
      ],
      "justification": "Completes the approval path from the previous unit by merging translation and confirmation into one step, preserving behaviour."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Direct match for the final receipt evaluation and introduces the concluding branch."
    },
    {
      "refs": [
        "guard:b5->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Captures the acceptance path, processing step, and a terminal endpoint."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Captures the rejection path, redundant edit action, and a second terminal endpoint. Behaviour preserved."
    }
  ],
