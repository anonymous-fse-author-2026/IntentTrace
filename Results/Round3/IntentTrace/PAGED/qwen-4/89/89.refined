defines(v1, "Contact Faculty to inform of denial and ask if new content should be added", {"Yes", "No"})
defines(v2, "Price of the Course Packet is finalized", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, c1, n14, n4, b1, n6, n7, n8, n9, b2, n10, n11, e1, n12])
precedence(i1, n1)
precedence(n1, n2)
