defines(v2, "is declaration needed", {"If we need to check the declaration", "if we need to invite the declarant"})
actor(a_default, "Default", [i1, n2, n3, b1, n4, n5, e1, n6, n7, b2, n10, e2, n11, n12, e3])
precedence(i1, n2)
precedence(n2, n3)
