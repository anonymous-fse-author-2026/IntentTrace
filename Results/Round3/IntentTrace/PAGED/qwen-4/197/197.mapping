    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the customer can proceed to receive the invoice."
      ],
      "justification": "Direct restatement of the next step after the receipt conditions are met."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Upon receiving the invoice, they should make the payment."
