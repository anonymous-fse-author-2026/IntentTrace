{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "Initiates the process and covers the first two sequential actions described in the opening unit."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "Models the condition check and opens the XOR split."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if not"
      ],
      "justification": "Guard represents the negative outcome of the emptiness check."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "continue the process"
      ],
      "justification": "Direct paraphrase of the continuation step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Captures the positive outcome condition, the explicit end action, and the terminal node."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Direct match for the completeness verification step."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If it is complete"
      ],
      "justification": "Opens the second decision split and captures the true condition path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Exact match for the complete-data recording action."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is not complete"
      ],
      "justification": "Guard represents the false/incomplete condition path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "make a telephone call to the sender."
      ],
      "justification": "Exact match for the fallback communication step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Covers the post-call data completion and flow convergence."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Every Wednesday evening,"
      ],
      "justification": "Temporal trigger modeled as a periodicity check action; behaviour preserved."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "take the letter book and member register to Miranda."
      ],
      "justification": "Exact match for the physical transfer step."
    },
    {
      "refs": [
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member,"
      ],
      "justification": "Guard models the approval condition for the membership decision."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Exact match for the approved-member processing step."
    },
    {
      "refs": [
        "guard:b5->n18"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member,"
      ],
      "justification": "Guard models the rejection condition for the membership decision."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "write to them and inform them of the decision."
      ],
      "justification": "Exact match for the notification step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Direct match for the subsequent data writing step."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles."
      ],
      "justification": "Exact match preserving the simultaneous cue and dual action."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Exact match for the delegation step."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Exact match for the card production and dispatch step."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Explicit termination step paired with its end node."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Hand the letter to Charles and add the new member to the register."
      ],
      "justification": "Exact match for the final handover and registration update."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "Prepare an invoice for the new members and continue the process."
      ],
      "justification": "Covers invoice generation, process continuation, and the final end node."
    }
  ],
