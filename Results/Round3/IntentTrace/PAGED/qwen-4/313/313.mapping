{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "Establishes the process start and performs the initial registration step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no fee"
      ],
      "justification": "Splits the flow based on fee presence and executes the no-fee registration action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to register a post-seminar request"
      ],
      "justification": "Splits the flow based on fee presence and executes the no-fee registration action."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if there is a fee"
      ],
      "justification": "Captures the alternative branch condition and its corresponding purchase request creation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "you need to create a purchase request"
      ],
      "justification": "Captures the alternative branch condition and its corresponding purchase request creation."
    },
    {
      "refs": [
        "action:n5",
        "action:n13"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Models the termination of the no-fee path. Explicit 'end' action nodes alongside the terminal end node are harmless structural plumbing and do not alter behaviour."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the purchase request has been approved"
      ],
      "justification": "The conditional check is modeled as an action step followed by a decision gateway. Re-typing a condition as an action preserves behaviour and is classified as a match."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Correctly guards the positive branch and models the receipt of the approval notification."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "you will receive an approved notification"
      ],
      "justification": "Correctly guards the positive branch and models the receipt of the approval notification."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Performs the follow-up registration step after approval notification."
    },
    {
      "refs": [
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "if the purchase request is rejected"
      ],
      "justification": "Correctly guards the negative branch and models the receipt of the rejection notification."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "you will be notified of the rejection"
      ],
      "justification": "Correctly guards the negative branch and models the receipt of the rejection notification."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Captures the termination condition for the rejected branch, using an explicit end action node plus a terminal end node, which preserves behaviour."
    }
  ],
