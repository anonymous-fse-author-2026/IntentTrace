{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "The opening unit implicitly starts the process and describes the first identification step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer"
      ],
      "justification": "Introduces the XOR split and captures the first condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should then check the availability of the parts."
      ],
      "justification": "Action corresponding to the first condition."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "if they already have the availability information"
      ],
      "justification": "Second branch condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "they can proceed with the process."
      ],
      "justification": "Action corresponding to the second condition."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer"
      ],
      "justification": "Third branch condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the team can also continue with the process."
      ],
      "justification": "Action corresponding to the third condition; 'continue' preserves the meaning of proceeding."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if they need to record the customer's details, they should order and receive the part from Disuki."
      ],
      "justification": "Fourth branch condition and combined ordering action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "Follow-up contracting step after receiving parts."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected, the team can proceed with the payment."
      ],
      "justification": "Payment step following parts collection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "Concludes the process; the action and end node both cover this final termination."
    }
  ],
