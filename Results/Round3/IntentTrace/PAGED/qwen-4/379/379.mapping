{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "Initiates the process and performs the starting action as described in i1."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "then Check Levels of Inventory."
      ],
      "justification": "Directly corresponds to the inventory checking step in i2."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "Models the conditional check as an action followed by a branch and guard, preserving the decision logic of i3."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report."
      ],
      "justification": "Directly corresponds to the report generation step in i4."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum"
      ],
      "justification": "Captures the alternative branch condition from i5 using a boolean guard."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report."
      ],
      "justification": "Directly corresponds to the above-minimum report step in i6."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "Captures the PO creation step mandated by i7."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Represents the termination path and structural end node for the above-minimum case per i8."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Directly corresponds to the PO review requirement in i10."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Models the approval condition as an action and branch structure, preserving i9 logic."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Executes the positive outcome (printing/releasing) specified in i9."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked. If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Guard captures rejection condition; action captures rework step, fully preserving i19 behavior."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "AND gateway and parallel actions correctly model the simultaneous execution in i11; converge rejoins the flows."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Directly corresponds to the packing slip receipt step in i12."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Directly corresponds to the inventory receipt step in i13."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Directly corresponds to the invoice receipt step in i14."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Directly corresponds to proceeding to the match phase in i15."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Action n18 performs the match implied by context; n19 releases funds upon success, matching i16."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Directly corresponds to the payment issuance step in i17."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Finalizes the cycle, converges remaining flows, and reaches the terminal end node per i18."
    }
  ],
