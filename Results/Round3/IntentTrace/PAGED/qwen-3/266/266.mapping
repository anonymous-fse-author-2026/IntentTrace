{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts with an informational meeting that lasts half a day"
      ],
      "justification": "Initial unit establishes the start of the process. action:n1 redundantly models the initiation step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the meeting is successful"
      ],
      "justification": "Captures the explicit success condition for the initial decision point."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "However, if the meeting is not successful, the process ends."
      ],
      "justification": "Captures the explicit failure condition and the corresponding termination flow."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the next step is to work on the storyboard, which takes a full day"
      ],
      "justification": "Direct paraphrase of the storyboard creation step."
    },
    {
      "refs": [
        "guard:b_sb->n5",
        "guard:b_sb->e_sb_fail"
      ],
      "verbatim_texts": [
        "If the storyboard is successful"
      ],
      "justification": "Captures the explicit success condition. The added implicit failure termination path is a harmless structural choice that preserves overall behaviour."
    },
    {
      "refs": [
        "action:n6",
        "action:n5"
      ],
      "verbatim_texts": [
        "the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "Splits the combined step into two equivalent actions (design and content preparation), preserving the required behaviour."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After that, the site development takes 2 days and is also done by the web design team."
      ],
      "justification": "Direct match for the site development step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the site is built, it goes through a review process that lasts 1 day."
      ],
      "justification": "Direct match for the review step."
    },
    {
      "refs": [
        "guard:b2->n10",
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the review is successful"
      ],
      "justification": "Captures the explicit success condition. The added implicit failure termination path is a harmless structural choice."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "it moves on to the approval stage, which takes half a day."
      ],
      "justification": "Direct match for the approval step."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the approval is complete, the process ends."
      ],
      "justification": "Captures the approval completion condition and the resulting termination flow."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "However, if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
      ],
      "justification": "Captures the rejection condition and the corresponding first rebuild action."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the rebuild is complete, the process ends."
      ],
      "justification": "Captures the first rebuild completion condition and termination."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Captures the second rejection condition and the final rebuild action/termination."
    }
  ],
