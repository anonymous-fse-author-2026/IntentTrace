@startuml
!theme plain
|a_default| Default
|a_default|
start
:provide userdata for flickr;
:v1: login_successful ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
stop
else ([v1 = 'No'])
:login fails, continue with process;
:v2: want_to_try_again ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:provide userdata for flickr;
else ([v2 = 'No'])
:choose to abort, the process will end;
stop
endif
endif
@enduml