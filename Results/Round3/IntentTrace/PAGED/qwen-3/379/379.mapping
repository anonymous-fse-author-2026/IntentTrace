{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "Initial node and first action correspond to the opening statement."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Check Levels of Inventory."
      ],
      "justification": "Direct match to the second step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum,",
        "is greater than the minimum"
      ],
      "justification": "XOR gateway models the conditional split on inventory levels."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum,"
      ],
      "justification": "Guard captures the low-inventory threshold condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report."
      ],
      "justification": "Action corresponds to generating the low-stock report."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "is greater than the minimum"
      ],
      "justification": "Guard captures the high-inventory condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report."
      ],
      "justification": "Action corresponds to generating the high-stock report."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Models the termination path for sufficient inventory."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)."
      ],
      "justification": "Direct match for PO creation."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Review step correctly modeled as an action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is approved,",
        "If the PO is rejected,"
      ],
      "justification": "Action and XOR gateway model the approval/rejection decision point."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If the PO is approved,"
      ],
      "justification": "Guard represents the approval outcome."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "it is printed and released in the system."
      ],
      "justification": "Direct match for printing and releasing the approved PO."
    },
    {
      "refs": [
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected,"
      ],
      "justification": "Guard represents the rejection outcome."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "it needs to be reworked."
      ],
      "justification": "Direct match for reworking rejected POs."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "reserve funds for the released POs",
        "mail the POs to the supplier."
      ],
      "justification": "AND gateway models the simultaneous execution of funding and mailing."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "reserve funds for the released POs"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "mail the POs to the supplier."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
