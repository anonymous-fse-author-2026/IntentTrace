      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "receive the inventory."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "proceed to receive the Invoice."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match."
      ],
      "justification": "Navigation and execution of the three-way match are split across two actions, preserving behaviour."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
