  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "Initiates the process. action:n1 is a redundant start step that preserves behaviour."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "make a purchase and then connect to the website"
      ],
      "justification": "Direct behavioural match."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "search for an item"
      ],
      "justification": "Direct behavioural match."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If they choose to \"Add item to cart\", they can proceed to checkout. However, if they select \"Continue Shopping\", they should continue with the process."
      ],
      "justification": "Captures the decision point, both guarded branches, and convergence. action:n4 serves as a condition-placeholder, which is acceptable re-typing."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed to checkout"
      ],
      "justification": "Positive branch outcome."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "continue with the process"
      ],
      "justification": "Negative branch outcome."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "enter their address, shipping method, and payment information"
      ],
      "justification": "Direct behavioural match."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "At the same time, they should also authorize the credit card and check the inventory levels."
      ],
      "justification": "Correctly models concurrent execution using an AND gateway and convergence."
    },
    {
      "refs": [
        "guard:b3->c_merge"
      ],
      "verbatim_texts": [
        "If the credit card is approved and there is inventory in stock"
      ],
      "justification": "Positive condition gateway and guard."
    },
    {
      "refs": [
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "if the credit card is denied or there is no inventory in stock"
      ],
      "justification": "Negative condition guard."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the transaction will end"
      ],
      "justification": "Action corresponding to the failed approval/out-of-stock branch."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the order confirmation number should be displayed"
      ],
      "justification": "Handles the 'In either case' merge point before proceeding to the next step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "the final order being shown to the customer"
      ],
      "justification": "Direct behavioural match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the order should be confirmed"
      ],
      "justification": "Direct behavioural match."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "a confirmation notice should be emailed to the customer"
      ],
      "justification": "Direct behavioural match."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once the order entry is complete"
      ],
      "justification": "Condition modeled as a concluding action step; preserves sequential flow."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "the process will end"
      ],
      "justification": "Process termination point."
    }
