action(n8, "Conclude hardware inspection process after additional repairs")
end(e2)
defines(v1, "Is system functioning properly after test", {"Functioning", "Issues"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, b1, n6, e1, n7, n8, e2])
precedence(i1, n1)
precedence(n5, b1)
precedence(n6, e1)
