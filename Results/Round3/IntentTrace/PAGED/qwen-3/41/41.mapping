{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks"
      ],
      "justification": "The opening unit implicitly starts the process and describes the initial immigration check action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then they should select the method for exit control checks."
      ],
      "justification": "Directly corresponds to the method selection step."
    },
    {
      "refs": [
        "guard:b5->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics, they should undergo a check using biometrics."
      ],
      "justification": "Models the biometric choice branch and the corresponding check action."
    },
    {
      "refs": [
        "guard:b5->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the passenger prefers to use ID documents, they should undergo checks using identity documents."
      ],
      "justification": "Models the ID document alternative branch and its check action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission, they should leave the area."
      ],
      "justification": "Captures the denial condition branch and the leaving action."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Captures the permission granted condition and the proceeding action."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends."
      ],
      "justification": "Models the unsuccessful outcome branch, leaving action, and process termination."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Models the successful outcome branch, continuing action, and process termination."
    }
  ],
