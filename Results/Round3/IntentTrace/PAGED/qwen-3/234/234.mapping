{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by supplying the requirement and then documenting it."
      ],
      "justification": "Process start and initial requirement/documentation step directly correspond to the opening unit."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the order is received via fax, input the order into an Excel file."
      ],
      "justification": "XOR branch, guard, and action faithfully model the fax input condition and step; converge rejoins the parallel input path."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone, also input the order into an Excel file."
      ],
      "justification": "Guard and action correctly capture the alternative input channel and identical Excel entry step."
    },
    {
      "refs": [
        "action:n35"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete after a week, send it to the student."
      ],
      "justification": "Direct match for the weekly batch completion and handoff step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list, type the orders into the MS-Access database."
      ],
      "justification": "Exact paraphrase of the database entry step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the database is completed, control the incoming order."
      ],
      "justification": "Action covers the post-completion control step. The intermediate 'ensure that it is completed' (i6) is behaviorally merged into the completion condition of this step."
    },
    {
      "refs": [
        "action:n8a"
      ],
      "verbatim_texts": [
        "At the same time, continue to do the check."
      ],
      "justification": "AND branch correctly models parallel execution; action directly matches the simultaneous check requirement."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the order is correct, release it."
      ],
      "justification": "XOR gateway opens the multi-criteria decision; guard and action preserve the positive correctness outcome."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Guard and action correctly model the negative correctness branch."
    },
    {
      "refs": [
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac, release it."
      ],
      "justification": "Guard uses '5k' as a standard abbreviation for 5.000 \u20ac; behavior and threshold are preserved."
    },
    {
      "refs": [
        "guard:b2->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "Guard and action accurately reflect the high-value threshold and required sign-off/check steps; converge prepares for downstream flows."
    },
    {
      "refs": [
        "action:n14b"
      ],
      "verbatim_texts": [
        "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
      ],
      "justification": "Direct match for agency contact, issue resolution, and sign-off routing."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the order is signed off, contact the client and release the order."
      ],
      "justification": "Exact match for post-sign-off client communication and release."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "Sequential step for PPC receipt and production initiation matches source exactly."
    },
    {
      "refs": [
        "guard:b4->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order."
      ],
      "justification": "XOR split and guard/action correctly model the unsolvable issue cancellation path."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the issue can be solved, release the order."
      ],
      "justification": "Guard and action preserve the solvable issue release path; converge rejoins flows."
    },
    {
      "refs": [
        "action:n33"
      ],
      "verbatim_texts": [
        "After PPC initiates production, the goods will be produced."
      ],
      "justification": "Direct match for the physical production step following PPC initiation."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends."
      ],
      "justification": "Models cancellation check; end node captures the explicit termination stated in the text."
    },
    {
      "refs": [
        "guard:b5->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If not, check the quality of the goods."
      ],
      "justification": "Guard and action correctly handle the non-cancellation path proceeding to quality check; end node accounts for implicit path closure."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "justification": "Direct match for post-quality check reporting step."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "justification": "Exact match for memo release and warehouse confirmation. Fragment i23 is a duplicate of this clause and treated as noise."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "justification": "Direct match for invoicing and finance reporting steps."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods and sign and send the memo."
      ],
      "justification": "AND branch captures parallel execution; action matches the simultaneous commissioning and memo signing."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "Also, send the goods and ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "Direct match for parallel goods dispatch and logistics memo confirmation."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order."
      ],
      "justification": "Final archival/closure step and process termination align exactly with the concluding text."
    }
  ],
