{
  "matches": [
    {
      "refs": [
        "action:i1",
        "guard:b_init->i2",
        "guard:b_init->c_pre_i3"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially, if the option \"research schedule directly\" is selected, then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Establishes process start and initial branching logic based on option selection."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Covers the alternative initial path and flow convergence."
    },
    {
      "refs": [
        "action:i3"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Direct step to evaluate schedule satisfaction."
    },
    {
      "refs": [
        "action:i4",
        "guard:b_sat->i4"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Negative outcome of the first satisfaction check."
    },
    {
      "refs": [
        "action:i5",
        "guard:b_sat->i5"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Positive outcome proceeding to ticket creation."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\"."
      ],
      "justification": "Secondary check for unsatisfactory schedule."
    },
    {
      "refs": [
        "action:i7",
        "guard:b_sat2->i7"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Further unsatisfactory handling with branching guard."
    },
    {
      "refs": [
        "action:i8",
        "guard:b_sat2->i8"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Alternative satisfactory path merging to main flow."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Ticket order validation step."
    },
    {
      "refs": [
        "action:i10"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "First approval verification creating a decision point."
    },
    {
      "refs": [
        "action:i11",
        "guard:b_appr->i11"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Unapproved path correctly terminating the process."
    },
    {
      "refs": [
        "action:i12",
        "guard:b_appr->i12"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Approved path continuing to re-validation."
    },
    {
      "refs": [
        "action:i13"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Second approval re-check."
    },
    {
      "refs": [
        "action:i14"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Final approval re-check."
    },
    {
      "refs": [
        "action:i15"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Process termination upon final approval."
    }
  ],
