      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process.",
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Represents the post-verification decision: continuing the process or terminating with a decline message for private customers. Abstract guards preserve the branching logic."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Models the wholesaler pathway, including customer creation, availability check, and the subsequent decision gateway."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Correctly captures the unavailability path, production step, decline notification, and process termination."
    },
    {
      "refs": [
        "guard:b4->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Positive availability path leading to order confirmation and continuation."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "AND gateway accurately models the parallel notifications to both departments."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Splits the preparation and readiness steps while fully preserving the described behaviour."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Models the final delivery step following process convergence/closure."
    },
    {
      "refs": [
        "guard:b5->c3"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order.",
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Branches correctly based on payment status: closing the order immediately or proceeding to evaluate reminder count."
    },
    {
      "refs": [
        "guard:b5->b6"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order.",
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Branches correctly based on payment status: closing the order immediately or proceeding to evaluate reminder count."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order.",
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Branches correctly based on payment status: closing the order immediately or proceeding to evaluate reminder count."
    },
    {
      "refs": [
        "guard:b6->n29"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process.",
