init(i1)
action(n1, "start selling cars")
action(n2, "get a bonus?")
action(n3, "get a paycheck?")
action(n5, "pay the bill")
end(e1)
branch(b1, XOR)
converge(c1)
defines(v_income, "Income Type", {"bonus", "paycheck"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n5, e1, c1])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n2)
precedence(b1, n3)
precedence(n2, c1)
precedence(n3, c1)
precedence(c1, n5)
precedence(n5, e1)
guard(b1, n2, v_income = "bonus")
guard(b1, n3, v_income = "paycheck")