      ],
      "verbatim_texts": [
        "To check the account, we start by verifying the amount."
      ],
      "justification": "Implicit process start and the initial verification step."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the amount is less than 200 \u20ac"
      ],
      "justification": "Opens the first XOR decision; the guard abstracts the positive threshold condition while preserving the split."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "we proceed to approve the expense report"
      ],
      "justification": "Direct match for the low-amount approval path."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if the amount is 200 \u20ac or more"
      ],
      "justification": "Captures the alternative branch condition correctly."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "we evaluate the expense report"
      ],
      "justification": "Step taken when the amount meets or exceeds the threshold."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If the expense report is deemed acceptable"
      ],
      "justification": "Opens the second XOR decision; guard abstracts the acceptable outcome while preserving the split."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "it is approved"
      ],
      "justification": "Approval action following a successful evaluation."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the process comes to an end"
      ],
      "justification": "Explicit termination step and end node for the approval path."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the expense report is not satisfactory"
      ],
      "justification": "Captures the rejection/negative branch condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the process also ends"
      ],
      "justification": "Explicit termination step and end node for the rejection path."
