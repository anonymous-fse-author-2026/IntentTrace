@startuml
!theme plain
|a_default| Default
|a_default|
start
:make appointment at hairdresser's;
:go to hairdresser;
:v1: need hair washed? ({Yes, No})
v2: want hair dyed? ({Yes, No})
v3: need haircut? ({Yes, No}); <<objectSignal>>
fork
if () then ([v1 = 'Yes'])
:wash hair;
endif
fork again
if () then ([v2 = 'Yes'])
:dye hair;
endif
fork again
if () then ([v3 = 'Yes'])
:cut hair;
endif
end fork
:pay hairdresser;
:end process;
stop
@enduml