branch(b9, XOR)
action(n19, "process the expense")
action(n20, "edit the report")
action(n21, "end process")
end(e1)
branch(b7, XOR)
converge(c_loop)
converge(c_entry)
action(n22, "translate receipts final")
action(n23, "confirm receipts final")
