@startuml
!theme plain
|a_default| Default
|a_default|
start
:start ExpenseReport process by clicking Start then selecting Edit Report;
:Is expense greater than 1000;
:v1: expense_threshold ({>1000, <=1000}); <<objectSignal>>
if () then ([v1 = '>1000'])
:review the report;
else ([v1 = '<=1000'])
:Is translation needed;
:v2: translation_needed ({true, false}); <<objectSignal>>
if () then ([v2 = true])
:translate the receipts;
else ([v2 = false])
:confirm the receipts;
endif
endif
:evaluate review decision;
:v3: first_review_decision ({rejected, approved}); <<objectSignal>>
if () then ([v3 = 'rejected'])
:edit the report;
else ([v3 = 'approved'])
:check if translation is needed;
:v2: translation_needed ({true, false}); <<objectSignal>>
if () then ([v2 = true])
:translate the receipts;
else ([v2 = false])
:confirm receipts;
endif
:evaluate the review decision again;
:v5: second_review_decision ({rejected, approved}); <<objectSignal>>
if () then ([v5 = 'rejected'])
:edit the report;
else ([v5 = 'approved'])
:translate receipts final;
:confirm receipts final;
:evaluate receipts decision;
:v4: receipts_decision ({accepted, rejected}); <<objectSignal>>
if () then ([v4 = 'accepted'])
:process the expense;
:end process;
stop
else ([v4 = 'rejected'])
:edit the report;
endif
endif
endif
@enduml