@startuml
!theme plain
|a_default| Default
|a_default|
start
:choose a book;
:v2: initial choice ({details, new, used}); <<objectSignal>>
switch ()
case ([v2 = "details"])
:view: book details;
:do you want to select a copy or view new copies?;
:v1: do you want to select a copy or view new copies? ({true, false}); <<objectSignal>>
if () then ([v1 = true])
:select a copy;
else ([v1 = false])
:view: new copies;
endif
stop
case ([v2 = "used"])
:view: used copies;
:evaluate and select a copy from the list;
:end procedure;
stop
case ([v2 = "new"])
endswitch
@enduml