init(start)
action(i1, "To begin the process in the Admin Office, first check if it has started.")
action(n2, "Has the process started")
action(n4, "Check completeness of the invoices")
branch(b2, XOR)
action(n5, "Return invoices to client through postal mail")
action(i6, "If the invoices are still marked as \"Uncompleted\", they should be returned to the client via postal mail.")
action(n9, "Continue the process")
converge(c1)
action(i7, "Once the invoices are returned to the client, receive the completed ones.")
action(n8, "Mark relevant box on invoice entry form")
action(n10, "Check if the process has been completed")
action(n11, "End process")
end(e2)
defines(v1, "Has the process started", {"Yes", "No"})
defines(v2, "Invoice Completion Status", {"Completed", "Uncompleted"})
actor(a_default, "Default", [start, i1, n2, n4, b2, n5, i6, n9, c1, i7, n8, n10, n11, e2])
precedence(start, i1)
precedence(i1, n2)
precedence(n2, n4)
precedence(n4, b2)
precedence(b2, n5)
precedence(n5, i6)
precedence(i6, c1)
precedence(b2, n9)
precedence(n9, c1)
precedence(c1, i7)
precedence(i7, n8)
precedence(n8, n10)
precedence(n10, n11)
precedence(n11, e2)
guard(b2, n5, v2 = 'Uncompleted')
guard(b2, n9, v2 = 'Completed')