      ],
      "justification": "Exact match to the batch processing step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "then take it to the outbox."
      ],
      "justification": "Direct match to transferring the processed batch to the outbox."
    },
    {
      "refs": [
        "guard:b1->c1",
        "guard:b1->n9"
      ],
      "verbatim_texts": [
        "this should be repeated until all invoices are processed."
      ],
      "justification": "Models the required repetition/loop using a branch, convergence node, and continuation guards. Standard behavior-preserving abstraction for iteration control."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "make sure to clear the outbox of the Data Entry Officer every hour."
      ],
      "justification": "Captures the primary instruction to clear the outbox on an hourly basis."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "done every hour until the outbox is completely cleared"
      ],
      "justification": "Models the termination condition for the clearing routine. Re-typing a loop condition as an action step is a valid, behavior-preserving MATCH."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "which marks the end of the process."
      ],
