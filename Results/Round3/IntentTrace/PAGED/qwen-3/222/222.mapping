      "verbatim_texts": [
        "To start the SSP process, first ensure that the Invoice is ready for verification."
      ],
      "justification": "Implicitly initiates the workflow and captures the initial readiness verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, check for invoice completeness."
      ],
      "justification": "Direct paraphrase of the completeness check step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to check for SLA."
      ],
      "justification": "Direct match to the SLA verification step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "move on to checking for invoice compliance."
      ],
      "justification": "Direct match to the compliance check step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the batched invoices are allocated to the Data Entry Officer and this is done by 9 am on the next working day."
      ],
      "justification": "Accurately captures the allocation action and its explicit timing constraint."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
