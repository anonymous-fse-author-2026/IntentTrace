{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "Process initiation and first three sequential steps directly correspond to the opening unit."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them. Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Eligibility condition modeled as an action step followed by a structural XOR split, preserving decision behaviour."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them. Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Negative branch guard (v1='No') and corresponding inform action match the ineligible path."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them. Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Positive branch guard (v1='Yes') and corresponding ERP order action match the eligible path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Explicit termination step following the notification of an ineligible customer."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "perform an availability check"
      ],
      "justification": "Direct paraphrase of the availability check step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\"."
      ],
      "justification": "Availability condition modeled as an action plus structural split, preserving behaviour."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts. Otherwise, continue the process."
      ],
      "justification": "Captures the unavailable branch (produce parts), available branch (continue), and flow re-convergence."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Exact match for the preparation step."
    },
    {
      "refs": [
        "action:n12",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "Three actions covering shipping, invoicing, and payment checking. Ordering/plumbing differences do not change overall behaviour."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order. If the payment is not received, send a reminder."
      ],
      "justification": "Payment status condition modeled as action plus structural split."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order. If the payment is not received, send a reminder."
      ],
      "justification": "Positive payment branch (v3='Yes') leading to order closure."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order. If the payment is not received, send a reminder."
      ],
      "justification": "Negative payment branch (v3='No') leading to reminder and flow convergence."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process. Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Reminder count condition modeled as action plus structural split."
    },
    {
      "refs": [
        "guard:b4->c_loop",
        "guard:b4->n20",
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process. Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Loop continuation (<3) via converge, and termination path (=3) with lawyer notification, explicit end action, and end node. Behaviour fully preserved."
    }
