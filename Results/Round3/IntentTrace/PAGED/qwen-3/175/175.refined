init(p_start)
action(i1, "Rental Items are Returned to the Store")
branch(b_ret, XOR)
action(i2, "Customer returns the items to the store")
action(i3, "Delivery Crew picks-up items at the event site")
converge(c_ret)
action(i4, "During this step, the items are counted and compared to the original contract")
branch(b_stat, XOR)
action(i5, "Order is complete and all items were returned")
action(i6, "Order is incomplete and items are missing")
action(i7, "Order is complete but items are damaged")
branch(b_pck1, XOR)
action(i8, "Items are packed for an existing order")
action(i9, "Items are stored for future orders")
action(i10, "email customer with replacement charges")
branch(b_cus, XOR)
action(i12, "Customer returns the missing items")
action(i13, "Customer does not return the missing items")
action(i11, "temporarily take damaged items out of inventory")
branch(b_rep, XOR)
action(i14, "Items are repaired and added into inventory")
action(i15, "Items can't be repaired and are discarded")
action(i_email_dmg, "email customer with replacement charges")
converge(c_main)
action(i16, "Lastly, the items are packed for an existing order.")
branch(b_end, XOR)
action(i18, "Items are stored for future orders")
end(e_end)

defines(v_ret, "return method", {"store", "site"})
defines(v_stat, "order status", {"complete", "incomplete", "damaged"})
defines(v_pck1, "packing choice 1", {"packed", "stored"})
defines(v_cus, "customer return missing", {"returns", "not_returns"})
defines(v_rep, "repair outcome", {"repaired", "discarded"})
defines(v_final, "final packing choice", {"packed", "stored"})

actor(a_proc, "Process Actor", [p_start, i1, b_ret, i2, i3, c_ret, i4, b_stat, i5, i6, i7, b_pck1, i8, i9, i10, b_cus, i12, i13, i11, b_rep, i14, i15, i_email_dmg, c_main, i16, b_end, i18, e_end])

precedence(p_start, i1)
precedence(i1, b_ret)
precedence(b_ret, i2)
precedence(b_ret, i3)
precedence(i2, c_ret)
precedence(i3, c_ret)
precedence(c_ret, i4)
precedence(i4, b_stat)
precedence(b_stat, i5)
precedence(b_stat, i6)
precedence(b_stat, i7)
precedence(i5, b_pck1)
precedence(b_pck1, i8)
precedence(b_pck1, i9)
precedence(i8, c_main)
precedence(i9, c_main)
precedence(i6, i10)
precedence(i10, b_cus)
precedence(b_cus, i12)
precedence(b_cus, i13)
precedence(i12, c_main)
precedence(i13, c_main)
precedence(i7, i11)
precedence(i11, b_rep)
precedence(b_rep, i14)
precedence(b_rep, i15)
precedence(i14, c_main)
precedence(i15, i_email_dmg)
precedence(i_email_dmg, c_main)
precedence(c_main, i16)
precedence(i16, b_end)
precedence(b_end, i18)
precedence(b_end, e_end)
precedence(i18, e_end)

guard(b_ret, i2, v_ret = "store")
guard(b_ret, i3, v_ret = "site")
guard(b_stat, i5, v_stat = "complete")
guard(b_stat, i6, v_stat = "incomplete")
guard(b_stat, i7, v_stat = "damaged")
guard(b_pck1, i8, v_pck1 = "packed")
guard(b_pck1, i9, v_pck1 = "stored")
guard(b_cus, i12, v_cus = "returns")
guard(b_cus, i13, v_cus = "not_returns")
guard(b_rep, i14, v_rep = "repaired")
guard(b_rep, i15, v_rep = "discarded")
guard(b_end, i18, v_final = "stored")
guard(b_end, e_end, v_final = "packed")