{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process,"
      ],
      "justification": "Models the process initiation. Although the source unit acts as an announcer, mapping it to an init node and a start action is harmless structural plumbing that preserves behaviour."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "make sure the Freights are ready to be shipped"
      ],
      "justification": "Direct paraphrase of the preparatory step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then ship the freight."
      ],
      "justification": "Direct match for the shipping step."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: deliver the freight and notify the delivery."
      ],
      "justification": "Captures the AND split ('At the same time'), the two concurrent delivery/notification actions, and their convergence. Structural elements preserve the parallel behaviour."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the request for merchandise return is lodged, continue with the process."
      ],
      "justification": "Models the triggering event that initiates the subsequent decision logic."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "invoice the customer."
      ],
      "justification": "Direct match for the invoicing action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Invoice the customer and the process ends with the customer being invoiced."
      ],
      "justification": "Captures the terminal state associated with the invoicing path."
    },
    {
      "refs": [
        "guard:b1->n11"
      ],
      "verbatim_texts": [
        "If the return is accepted"
      ],
      "justification": "Opens the XOR decision and correctly guards the acceptance branch."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Accept the merchandise return and proceed with returning the merchandise."
      ],
      "justification": "Models the acceptance step. The subsequent 'return' action is logically split into the next model element, which preserves behaviour."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Return the merchandise and the process ends with the merchandise being returned."
      ],
      "justification": "Executes the return step and reaches the correct termination state for this path."
    },
    {
      "refs": [
        "guard:b1->n14"
      ],
      "verbatim_texts": [
        "If the return is rejected"
      ],
      "justification": "Correctly guards the rejection branch."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "reject the merchandise return."
      ],
      "justification": "Direct match for the rejection action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Reject the merchandise return and the process ends with the merchandise return request being rejected."
      ],
      "justification": "Captures the terminal state associated with the rejection path."
    },
    {
      "refs": [
        "guard:b1->n17"
      ],
      "verbatim_texts": [
        "If a loss claim report is lodged"
      ],
      "justification": "Correctly guards the loss claim branch."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "approve the loss claim and the process ends."
      ],
      "justification": "Approves the claim and terminates the process correctly on this path."
    }
  ],
