init(i1)
action(n2, "Check Answer")
branch(b1, XOR)
action(n3, "Acquire Pricing A")
branch(n4, XOR)
action(n5, "Acquire Pricing B")
action(n6, "Margin Calculation")
action(n7, "Prepare Offer")
action(n8, "Calculate Transport Rate")
end(e1)
converge(n9)
defines(v1, "Check Answer", {"No", "Yes"})
defines(v2, "Recheck Answer", {"No", "Yes"})
actor(a_default, "Default", [i1, n2, b1, n3, n4, n5, n6, n7, n8, e1, n9])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, n4)
precedence(n4, n5)
precedence(n4, n9)
precedence(n5, n9)
precedence(n9, n6)
precedence(n6, n7)
precedence(n7, n8)
precedence(n8, e1)
guard(b1, n3, v1 = 'No')
guard(b1, n4, v1 = 'Yes')
guard(n4, n5, v2 = 'No')
guard(n4, n9, v2 = 'Yes')