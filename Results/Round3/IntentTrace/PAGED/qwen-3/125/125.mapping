{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To create promotional YouTube videos, start by defining the audience."
      ],
      "justification": "The start node and two actions cover the initial goal and first step. Redundancy does not change behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once the audience is defined, develop a concept."
      ],
      "justification": "Direct paraphrase of the second step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After the concept is developed, determine the form or style."
      ],
      "justification": "Matches the third step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the form or style is determined, write the script."
      ],
      "justification": "Matches the fourth step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After the script is written, create a storyboard."
      ],
      "justification": "Matches the fifth step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the storyboard is created, shoot the video."
      ],
      "justification": "Matches the sixth step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After shooting the video, record the narration."
      ],
      "justification": "Matches the seventh step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the narration is recorded, create the graphics."
      ],
      "justification": "Matches the eighth step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After the graphics are created, find or create the music."
      ],
      "justification": "Matches the ninth step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the music is found or created, capture the video to the computer."
      ],
      "justification": "Matches the tenth step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After capturing the video, import the audio, including the narration, music, and sound effects."
      ],
      "justification": "Matches the eleventh step, preserving the list of audio components."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the audio is imported, import the graphics."
      ],
      "justification": "Matches the twelfth step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "After importing the graphics, create titles, subtitles, and credits."
      ],
      "justification": "Matches the thirteenth step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once the titles, subtitles, and credits are created, edit everything together."
      ],
      "justification": "Matches the fourteenth step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "After editing everything together, upload it to YouTube."
      ],
      "justification": "Matches the fifteenth step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Once uploaded to YouTube, the process ends."
      ],
      "justification": "Captures the final termination step and structural end node."
    }
  ],
