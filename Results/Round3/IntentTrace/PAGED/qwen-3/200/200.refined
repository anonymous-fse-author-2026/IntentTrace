init(i1)
action(n1, "Start Process")
action(n2, "Check Customer Eligibility")
branch(b1, XOR)
action(n3, "Inform Ineligible Customer")
action(n4, "End Process - Ineligible")
end(e1)
action(n5, "Open New Order in ERP System")
action(n6, "Perform Availability Check")
branch(b2, XOR)
action(n7, "Start Producing Missing Parts")
action(n8, "Continue Process")
action(n9, "Prepare Products for Shipment")
branch(b3, AND)
action(n10, "Ship Products")
action(n11, "Send Invoice")
action(n12, "Check Payment Status")
converge(c1)
converge(c2)
branch(b4, XOR)
action(n14, "Close Order - Payment Received")
end(e2)
action(n15, "Send Payment Reminder")
action(n16, "Check Number of Reminders")
branch(b5, XOR)
action(n17, "Continue Process")
action(n18, "Inform Lawyer")
end(e3)
defines(v1, "Customer Eligibility", {"not eligible", "eligible"})
defines(v2, "Product Availability", {"not available", "available"})
defines(v3, "Payment Status", {"received", "not received"})
defines(v4, "Reminder Count", {[0-3]})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, e1, n5, n6, b2, n7, n8, n9, b3, n10, n11, n12, c1, c2, b4, n14, e2, n15, n16, b5, n17, n18, e3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(n3, n4)
precedence(n4, e1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, b2)
precedence(b2, n7)
precedence(b2, c1)
precedence(n7, c1)
precedence(c1, n8)
precedence(n8, n9)
precedence(n9, b3)
precedence(b3, n10)
precedence(b3, n11)
precedence(b3, n12)
precedence(n10, c2)
precedence(n11, c2)
precedence(n12, c2)
precedence(c2, b4)
precedence(b4, n14)
precedence(n14, e2)
precedence(b4, n15)
precedence(n15, n16)
precedence(n16, b5)
precedence(b5, n17)
precedence(n17, c1)
precedence(b5, n18)
precedence(n18, e3)
guard(b1, n3, v1 = 'not eligible')
guard(b1, n5, v1 = 'eligible')
guard(b2, n7, v2 = 'not available')
guard(b2, c1, v2 = 'available')
guard(b4, n14, v3 = 'received')
guard(b4, n15, v3 = 'not received')
guard(b5, n17, v4 < 3)
guard(b5, n18, v4 = 3)