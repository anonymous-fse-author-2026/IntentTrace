    },
    {
      "refs": [
        "guard:b1->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Positive guard and corresponding digitalization action match the 'yes' branch instruction."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required again."
      ],
      "justification": "Direct match for the second digitalization check."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
