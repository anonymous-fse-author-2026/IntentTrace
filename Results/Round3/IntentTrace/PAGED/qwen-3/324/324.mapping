      ],
      "justification": "Direct match for macroscopic writing."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "complete the following steps: Tissue processing, check if \"Digitalization?\" is required."
      ],
      "justification": "Captures the tissue processing step initiated by this instruction."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required."
      ],
      "justification": "Models the explicit check as an action step, preserving behaviour."
    },
    {
      "refs": [
        "guard:b1->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process."
      ],
