{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "Covers the process initiation and the first substantive step. The extra 'start' action is redundant structural plumbing that does not alter behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model and check it."
      ],
      "justification": "Direct correspondence to the model creation and verification step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\""
      ],
      "justification": "Condition modeled across an action node, a gateway, and a guard. Preserves the decision logic exactly."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then assign negative points."
      ],
      "justification": "Maps directly to the consequence of the first failed check."
    },
    {
      "refs": [
        "action:n6",
        "action:n7",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\""
      ],
      "justification": "Models the secondary re-check condition using equivalent nodes and guard logic."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "assign negative points again."
      ],
      "justification": "Direct match for the second penalty assignment."
    },
    {
      "refs": [
        "guard:b1->c1",
        "guard:b2->c1",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Captures the successful paths from both checks, their convergence, and the explicit continuation step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Direct match for the remediation and extension step."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n12",
        "action:n12",
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process. If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Condenses the dual-condition split into a single action, branch, two guarded paths, and convergence. Behaviour is fully preserved."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Direct paraphrase of the post-approval workflow step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Exact match for monitoring and troubleshooting."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If the project is accepted"
      ],
      "justification": "Standard modeling of the acceptance decision point."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "present it."
      ],
      "justification": "Positive outcome action."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Negative outcome path and subsequent flow rejoining."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Represents the repeated presentation requirement. Conditional context is absorbed into the flow without changing behaviour."
    },
    {
      "refs": [
        "action:n21",
        "guard:b5->n21",
        "guard:b5->e2"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Final delivery and termination. Extra structural gate and guards act as harmless plumbing."
    }
  ],
