end(e1)
end(e2)
defines(v1, "do you need to book train or flight?", {"No", "Yes"})
defines(v2, "is code available within 24 hours?", {"Yes", "No"})
defines(v3, "is code now available?", {"Yes", "No"})
actor(a_default, "Default", [i1, n2, n3, b1, n4, n5, c1, b2, n8, b3, n10, n11, n12, e1, e2])
precedence(i1, n2)
precedence(n2, n3)
