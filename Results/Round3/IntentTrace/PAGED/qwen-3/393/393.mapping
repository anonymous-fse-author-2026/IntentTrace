{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For TS recruitment, the first step is to advise unsuccessful candidates."
      ],
      "justification": "Init node marks process start; action faithfully paraphrases the first step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n5",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\", then the position should be re-advertised."
      ],
      "justification": "Action poses the check, branch opens XOR, guards route true/false correctly, and action covers the re-advertisement outcome."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n40",
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "if the terms and conditions of the offer for a candidate need to be sorted out"
      ],
      "justification": "Models the condition as an action step followed by a branch. Guards and continue action preserve the true/false routing behaviour."
    },
    {
      "refs": [
        "action:n40",
        "guard:b40->n41",
        "guard:b40->n6",
        "action:n41"
      ],
      "verbatim_texts": [
        "it is necessary to check if the candidate has accepted a voluntary redundancy. If the candidate has not accepted, the process continues. On the other hand, if the candidate has accepted, further investigation is required."
      ],
      "justification": "Action performs the redundancy check, branch splits outcomes, guards route accepted/not-accepted correctly, and action captures the investigation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form, which is then received by the next level manager."
      ],
      "justification": "Directly models the form submission step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the manager is an external resource, they may not authorize the form.",
        "If the form is approved, the recruitment manager sends the form and other documentation, which is received by the client HR."
      ],
      "justification": "Models the external/internal check as an action+branch. Routing and subsequent approval/continuation steps preserve the original conditional behaviour."
    },
    {
      "refs": [
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "If the manager is an external resource, they may not authorize the form.",
        "If the form is approved, the recruitment manager sends the form and other documentation, which is received by the client HR."
      ],
      "justification": "Models the external/internal check as an action+branch. Routing and subsequent approval/continuation steps preserve the original conditional behaviour."
    },
    {
      "refs": [
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If the manager is an external resource, they may not authorize the form.",
        "If the form is approved, the recruitment manager sends the form and other documentation, which is received by the client HR."
      ],
      "justification": "Models the external/internal check as an action+branch. Routing and subsequent approval/continuation steps preserve the original conditional behaviour."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the manager is an external resource, they may not authorize the form.",
        "If the form is approved, the recruitment manager sends the form and other documentation, which is received by the client HR."
      ],
      "justification": "Models the external/internal check as an action+branch. Routing and subsequent approval/continuation steps preserve the original conditional behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the manager is an external resource, they may not authorize the form.",
        "If the form is approved, the recruitment manager sends the form and other documentation, which is received by the client HR."
      ],
      "justification": "Models the external/internal check as an action+branch. Routing and subsequent approval/continuation steps preserve the original conditional behaviour."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "justification": "Condenses scanning and recording into a single action step, preserving behaviour."
    },
    {
      "refs": [
        "action:n15",
        "guard:b5->n16",
        "guard:b5->n17",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If there are any variations, a complete business case is required. Otherwise, the process continues."
      ],
      "justification": "Branches on variations, routes to business case creation or continuation, and rejoins via structural converge. Behaviour is fully preserved."
    },
    {
      "refs": [
        "action:n42"
      ],
      "verbatim_texts": [
        "The Appointment Approval is carried forward."
      ],
      "justification": "Direct restatement of the carry-forward step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate. Otherwise, a medical assessment is not necessary.",
        "it can take up to 21 days to arrange and complete."
      ],
      "justification": "Checks requirement/rate, branches to assessment arrangement (incorporating the 21-day note) or skips to convergence. Values and timing preserved."
    },
    {
      "refs": [
        "guard:b6->n19"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate. Otherwise, a medical assessment is not necessary.",
        "it can take up to 21 days to arrange and complete."
      ],
      "justification": "Checks requirement/rate, branches to assessment arrangement (incorporating the 21-day note) or skips to convergence. Values and timing preserved."
    },
    {
      "refs": [
        "guard:b6->c2"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate. Otherwise, a medical assessment is not necessary.",
        "it can take up to 21 days to arrange and complete."
      ],
      "justification": "Checks requirement/rate, branches to assessment arrangement (incorporating the 21-day note) or skips to convergence. Values and timing preserved."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate. Otherwise, a medical assessment is not necessary.",
        "it can take up to 21 days to arrange and complete."
      ],
      "justification": "Checks requirement/rate, branches to assessment arrangement (incorporating the 21-day note) or skips to convergence. Values and timing preserved."
    },
    {
      "refs": [
        "action:n14",
        "action:n20"
      ],
      "verbatim_texts": [
        "The TS HR coordinator informs the recruitment manager, who then liaises with the HR representative to confirm the offer to the candidate."
      ],
      "justification": "Action is duplicated in the model, but redundancy does not alter process behaviour. Directly corresponds to the coordination step."
    },
    {
      "refs": [
        "action:n21",
        "guard:b7->n22",
        "guard:b7->n23",
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory, the next candidate on the shortlist should be contacted. However, if the assessment is fine, the process continues."
      ],
      "justification": "Branches on satisfaction, routes to contacting next candidate or continuing, and rejoins. Logic and outcomes match source."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "The recruitment manager makes a formal verbal offer of employment to the candidate."
      ],
      "justification": "Exact match for the verbal offer step."
    },
    {
      "refs": [
        "action:n25",
        "guard:b8->n26",
        "guard:b8->n27",
        "action:n26",
        "action:n27"
      ],
      "verbatim_texts": [
        "If the candidate accepts, the recruitment manager creates a formal written offer. If the candidate declines, the process continues."
      ],
      "justification": "Routes acceptance to written offer creation and decline to continuation. Rejoining converge preserves flow."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Simultaneously, the commencement pack and letter of appointment are sent to the candidate."
      ],
      "justification": "Directly models the document dispatch step."
    },
    {
      "refs": [
        "action:n29",
        "guard:b9->n30",
        "guard:b9->c4",
        "action:n30"
      ],
      "verbatim_texts": [
        "if there is a \"40%\" rate, renegotiation is required."
      ],
      "justification": "Checks for the 40% rate condition and branches to renegotiation or skips to convergence. Threshold preserved."
    },
    {
      "refs": [
        "action:n31",
        "guard:b10->n32",
        "guard:b10->n33",
        "action:n32",
        "action:n33"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful, the process continues. However, if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified."
      ],
      "justification": "Evaluates negotiation outcome, routes success to continuation and failure to next-candidate identification. Behaviour intact."
    },
    {
      "refs": [
        "action:n34"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Action and end node mark the explicit termination of the process."
    }
  ],
