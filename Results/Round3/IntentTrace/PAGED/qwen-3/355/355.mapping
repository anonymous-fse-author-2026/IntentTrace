{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by checking the customer's order."
      ],
      "justification": "Initiates the process and captures the first mandatory step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer is a registered customer, then check their payment morale."
      ],
      "justification": "First XOR branch arm with correct threshold/guard value and resulting action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they are a new customer, then check their status."
      ],
      "justification": "Second XOR branch arm with correct guard value and resulting action."
    },
    {
      "refs": [
        "guard:b1->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the customer is a wholesaler, enter their data and take the order."
      ],
      "justification": "Third XOR branch arm correctly modeling the wholesaler case and its combined action."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If their payment morale is good, continue with the process."
      ],
      "justification": "Positive payment morale path correctly guarded and routed to convergence for continuation."
    },
    {
      "refs": [
        "guard:b2->c1",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If their payment morale is bad or if they are an end customer, reject the order and end the process."
      ],
      "justification": "Negative payment morale path correctly guarded, executes rejection, and terminates. Minor merging of the 'end customer' clause does not alter behaviour."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, check the availability of the items."
      ],
      "justification": "Captures the availability check and adds structural AND gateway/converge to model the simultaneous/parallel flow indicated by 'At the same time'."
    },
    {
      "refs": [
        "action:n13",
        "guard:b4->n15",
        "action:n15",
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If the items are out of stock, start production. If they are in stock, continue with the process."
      ],
      "justification": "Models the stock check as an action step followed by an XOR split. Guards correctly map 'No' to out-of-stock/production and 'Yes' to in-stock/continuation. Re-typing condition as action preserves behaviour."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the availability is checked, send the order confirmation."
      ],
      "justification": "Directly implements the confirmation step after the stock check branch resolves."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If production is started, produce the article and send the order confirmation."
      ],
      "justification": "Splits the production workflow into distinct steps while preserving the sequence and duplicated confirmation requirement stated in the text."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Simultaneously, send the invoice and deliver the product."
      ],
      "justification": "Executes the final parallel activities and provides necessary structural converges and end nodes to terminate the parallel branches cleanly."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "Check the payment status."
      ],
      "justification": "Direct paraphrase of the payment verification step."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If payment is received, close the order."
      ],
      "justification": "Positive payment branch with correct guard value and resulting closure action."
    },
    {
      "refs": [
        "guard:b5->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If no payment is received, check the number of reminders."
      ],
      "justification": "Negative payment branch correctly guarded. Models the reminder count check as an action step, which preserves the behavioural flow."
    },
    {
      "refs": [
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If there are more than three reminders, engage a lawyer."
      ],
      "justification": "High-reminder branch correctly guarded and routed to legal engagement."
    },
    {
      "refs": [
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are three or fewer reminders, send a reminder."
      ],
      "justification": "Low-reminder branch correctly guarded and routed to sending another reminder."
    }
  ],
