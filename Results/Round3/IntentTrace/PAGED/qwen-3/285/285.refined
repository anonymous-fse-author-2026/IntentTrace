init(i1)
action(n1, "Emergency Determined")
action(n2, "Measuring Severity")
action(n3, "Quick Payment")
action(n4, "Approval of operation")
action(n5, "Standard Process")
end(e1)
converge(c1)
branch(b1, XOR)
defines(choice, "Decision", {"Quick Payment", "Approval of operation"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, e1, c1, b1])
precedence(i1, n1)
precedence(c1, n5)
precedence(n2, b1)
precedence(n1, n2)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, c1)
precedence(n5, e1)
guard(b1, n3, choice = "Quick Payment")
guard(b1, n4, choice = "Approval of operation")
label(b1, n3, "Quick Payment chosen")
label(b1, n4, "Approval chosen")
label(n3, c1, "Process continued")
label(n4, c1, "Process continued")