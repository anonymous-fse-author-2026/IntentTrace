{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, for CAB, the first step is to assess the change request."
      ],
      "justification": "Captures the process start and the initial assessment step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the affected systems for any impacts on the business unit"
      ],
      "justification": "Direct paraphrase of the second step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "determine whether the change request should be approved or not"
      ],
      "justification": "Models the preliminary determination step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the change request should be approved in its current state, then it is approved."
      ],
      "justification": "Structural split and positive arm: immediate approval and branch termination."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "However, if the change request should not be approved in its current state, further evaluation is needed"
      ],
      "justification": "Negative condition triggering further evaluation."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the change request should not be approved in its current state, further evaluation is needed",
        "to determine if the change will be acceptable with more information provided."
      ],
      "justification": "Combines the two segmented units describing the same evaluation step."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the change request is ultimately approved, the change is implemented."
      ],
      "justification": "Second decision split and positive arm: implementation and branch termination."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the change is deemed unacceptable, it is rejected."
      ],
      "justification": "Negative arm of the second decision: rejection."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "a request for more information is made to the Change Coordinator."
      ],
      "justification": "Direct match following rejection."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The request is then followed by an email enquiry to the Change Coordinator."
      ],
      "justification": "Sequential step following the initial request."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "the approval register is updated within a timeframe of 3 business days. The email enquiry is also forwarded to the Change Requester."
      ],
      "justification": "Splits the compound source unit into two distinct sequential actions while preserving order and meaning."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If there are no further inquiries or issues"
      ],
      "justification": "Third decision point and the condition/path for no inquiries."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "the process concludes after 3 business days."
      ],
      "justification": "Process conclusion under the no-inquiries condition."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "if there are inquiries from the CAB, a response is expected within 1-3 business days."
      ],
      "justification": "Alternative condition and the waiting step for a response."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the response is received from the requester, it is forwarded to the CAB for further evaluation."
      ],
      "justification": "Direct match describing the routing of the response."
    },
    {
      "refs": [
        "action:n20",
        "action:n21",
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "Based on the response, a final determination is made regarding the approval of the change request."
      ],
      "justification": "Models the final determination and expands its positive outcome (approval & implementation) to close the process loop, preserving overall behaviour."
    }
  ],
