{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "Implicitly starts the process and captures the initial prioritization step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information."
      ],
      "justification": "Direct paraphrase of the second step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer exists, we move on to checking their payment history."
      ],
      "justification": "Opens the decision point and models the positive branch condition and subsequent action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "On the other hand, if the customer does not exist, we need to verify their customer status."
      ],
      "justification": "Models the negative branch condition and the corresponding verification action."
    },
    {
      "refs": [
        "guard:b2->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process."
      ],
      "justification": "Captures the decision point and the continuation path for a good payment history."
    },
    {
      "refs": [
        "guard:b3->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Splits flow based on customer type, captures the private customer condition, action, and termination."
    },
    {
      "refs": [
        "guard:b3->n7",
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Captures the wholesaler condition and the two sequential actions described."
    },
    {
      "refs": [
        "guard:b4->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Models the unavailability decision, combined production/decline action, and process termination."
    },
    {
      "refs": [
        "guard:b4->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Captures the availability condition, continuation/confirmation action, and rejoins the main flow."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "Correctly models parallel execution (AND split/converge) for informing both departments."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Splits the compound sentence into two sequential behavioral steps while preserving meaning."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Directly captures the delivery step following closure."
    },
    {
      "refs": [
        "guard:b6->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Models the payment check, the positive branch, the closing action, and termination."
    },
    {
      "refs": [
        "guard:b6->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Captures the outstanding payment condition and the reminder check action."
    },
    {
      "refs": [
        "guard:b7->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Models the threshold decision (< 3), continuation action, and process end."
    },
    {
      "refs": [
        "guard:b7->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Captures the complementary threshold condition (>= 3 as binary alternative to < 3), activation action, and termination."
    }
  ],
  "mutations": [],
  "omissions": [],
  "additions": [
    {
      "refs": [
        "guard:b2->e_bad_payment"
      ],
      "reason": "No supporting verbatim portion was mapped from the input text.",
      "source_line": "guard b2->e_bad_payment: v_pay_good = false"
    }
  ],
