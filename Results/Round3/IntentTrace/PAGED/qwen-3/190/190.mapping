      ],
      "verbatim_texts": [
        "If the answer is \"No\", then we need a Vendor master record and the process ends."
      ],
      "justification": "Models the decision gateway, correctly applies the 'No' guard, executes the master record requirement, and terminates the process."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "But if the answer is \"Yes\", then we enter the invoice in SAP."
      ],
      "justification": "Correctly applies the 'Yes' guard and performs the invoice entry action."
    },
    {
      "refs": [
        "action:n10",
        "action:n12",
        "action:n13",
        "action:n15"
      ],
      "verbatim_texts": [
        "And if the answer is \"Yes\" again, then we enter the invoice in SAP."
      ],
      "justification": "Covers the repeated checks and second invoice entry. Includes a redundant priority step that does not change the core flow, classified as a match under relaxed rules."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Once the invoice is entered in SAP, we place the entered invoices in the normal Outbox and the process ends."
      ],
      "justification": "Captures placing invoices in the Outbox and the final termination points."
    }
