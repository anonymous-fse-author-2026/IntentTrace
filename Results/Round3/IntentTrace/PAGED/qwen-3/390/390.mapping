{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "Covers the process initiation and the initial sequential steps described in the opening unit. Splitting into multiple actions preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
      ],
      "justification": "Models the decision gateway and the positive branch for having prior credit allowance, followed by the delivery processing step."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "Captures the alternative branch when the allowance is exceeded, leading to a new order placement and termination at the warehouse."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "it will be recorded in the Accounts Receivable."
      ],
      "justification": "Represents the convergence of execution paths and the explicit recording action described in the source."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If Payments are Received, the process continues."
      ],
      "justification": "Models the payment condition check and the continuation path when payments are successful."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "the order is dropped"
      ],
      "justification": "Captures the negative payment outcome and the corresponding process termination."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "identify the order for installation."
      ],
      "justification": "Directly matches the identification step preceding the installation decision."
    },
    {
      "refs": [
        "action:n14",
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled, an Installer will be assigned."
      ],
      "justification": "Models the installation scheduling decision and the assignment of an installer on the positive branch."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "it will be packed for delivery."
      ],
      "justification": "Captures the alternative path when installation is not required, concluding with packing and process termination."
    }
  ],
