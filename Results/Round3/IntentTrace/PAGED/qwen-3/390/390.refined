init(i1)
action(n1, "start process")
action(n2, "Orders Required")
action(n3, "place Bulk order")
action(n4, "Order with prior internal credit allowance")
branch(b1, XOR)
action(n5, "process order for delivery")
action(n6, "Outstanding Balance")
action(n7, "place new order")
converge(c_ar)
action(n8, "record in Accounts Receivable")
action(n9, "Payments Received")
branch(b2, XOR)
action(n10, "continue process")
action(n11, "drop order")
end(e_drop)
action(n13, "identify order for installation")
action(n14, "installation required")
branch(b3, XOR)
action(n15, "assign Installer")
action(n16, "pack for delivery")
end(e2)
end(e3)
defines(v1, "Credit Check", {"Prior Allowance", "Exceeds Allowance"})
defines(v2, "Payment Receipt", {"Received", "Not Received"})
defines(v3, "Installation Schedule", {"Scheduled", "Not Required"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, n6, n7, c_ar, n8, n9, b2, n10, n11, e_drop, n13, n14, b3, n15, n16, e2, e3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n6)
precedence(n4, n5)
precedence(n5, c_ar)
precedence(n6, n7)
precedence(n7, c_ar)
precedence(c_ar, n8)
precedence(n8, n9)
precedence(n9, b2)
precedence(b2, n10)
precedence(b2, n11)
precedence(n10, n13)
precedence(n11, e_drop)
precedence(n13, n14)
precedence(n14, b3)
precedence(b3, n15)
precedence(b3, n16)
precedence(n15, e2)
precedence(n16, e3)
guard(b1, n4, v1 = 'Prior Allowance')
guard(b1, n6, v1 = 'Exceeds Allowance')
guard(b2, n10, v2 = 'Received')
guard(b2, n11, v2 = 'Not Received')
guard(b3, n15, v3 = 'Scheduled')
guard(b3, n16, v3 = 'Not Required')