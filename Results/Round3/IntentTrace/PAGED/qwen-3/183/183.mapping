      ],
      "verbatim_texts": [
        "To start the process"
      ],
      "justification": "Initiates the flow and captures the opening statement as a starting step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin by adding the image description and uploading the image."
      ],
      "justification": "Directly models the first operational step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the message \"Image upload successful\" appears"
      ],
      "justification": "Correctly opens the XOR decision and routes the positive condition via a guard. Abstract variable naming preserves the binary decision logic."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process will end."
      ],
      "justification": "Models the successful termination path."
    },
    {
      "refs": [
        "guard:b1->b2"
      ],
      "verbatim_texts": [
        "if the message indicates an unsuccessful upload, then try again."
      ],
      "justification": "Routes the negative upload result to the next decision gateway representing the retry prompt."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the option to try again is selected, the process will continue."
      ],
      "justification": "Correctly models the loop-back/convergence behavior when the user chooses to retry."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the option to try again is not selected, then an error will occur and the process will end."
      ],
      "justification": "Captures the negative retry choice, the resulting error state, and the final process termination."
    }
