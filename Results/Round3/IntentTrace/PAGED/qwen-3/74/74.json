    },
    {
      "id": "i6",
      "content": "Once the data is sent to suppliers, extract the data from the suppliers and transfer it to the doctor's phone"
    },
    {
      "id": "i7",
      "content": "confirm the GOP"
    },
    {
      "id": "i8",
      "content": "the process will come to an end"
    },
    {
      "id": "i9",
      "content": "register the case and handle the claim"
    },
    {
      "id": "i10",
      "content": "Extract the data from the suppliers"
    },
    {
      "id": "i11",
      "content": "enter it on the patient's record or confirm the IN-Patient status"
    },
    {
      "id": "i12",
      "content": "send the data back to the suppliers"
    },
    {
      "id": "i13",
      "content": "Finally, receive the payment and conclude the process"
