        "action:n_check"
      ],
      "verbatim_texts": [
        "To start the process, begin by checking if the order has been received."
      ],
      "justification": "Captures the process initiation and the initial order validation step."
    },
    {
      "refs": [
        "guard:b_decide->n_cont",
        "action:n_cont"
      ],
      "verbatim_texts": [
        "If the sum of the order is less than 500, then continue with the process."
      ],
      "justification": "Models the decision gateway, the < 500 condition, and the subsequent continuation action."
    },
    {
      "refs": [
        "guard:b_decide->n_d4",
        "action:n_d4"
      ],
      "verbatim_texts": [
        "However, if the sum of the order is greater than 2000, compute a discount of 4%."
      ],
      "justification": "Correctly captures the > 2000 condition and the corresponding 4% discount computation."
    },
    {
      "refs": [
        "action:n_d3"
      ],
      "verbatim_texts": [
        "If the sum of the order falls between 1000 and 1500, compute a discount of 3%."
      ],
      "justification": "Directly matches the 3% discount action for the specified range."
    },
    {
      "refs": [
        "action:n_d2"
      ],
      "verbatim_texts": [
        "Similarly, if the sum of the order falls between 500 and 999, compute a discount of 2%."
      ],
      "justification": "Directly matches the 2% discount action for the specified range."
    },
    {
      "refs": [
        "converge:c_merge"
      ],
      "verbatim_texts": [
        "If the sum of the order is less than 500, then continue with the process.",
        "However, if the sum of the order is greater than 2000, compute a discount of 4%.",
        "If the sum of the order falls between 1000 and 1500, compute a discount of 3%.",
        "Similarly, if the sum of the order falls between 500 and 999, compute a discount of 2%."
      ],
      "justification": "Structural join that merges the divergent conditional paths back into a single flow."
    },
    {
      "refs": [
        "action:n_bill"
      ],
      "verbatim_texts": [
        "Finally, create the bill and the process will come to an end."
      ],
      "justification": "Maps the final billing step and explicitly models the process termination."
    }
