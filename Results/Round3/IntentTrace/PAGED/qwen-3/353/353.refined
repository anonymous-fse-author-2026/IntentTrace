init(i1)
action(n_check, "check if order has been received")
branch(b_decide, XOR)
action(n_cont, "continue with the process")
action(n_d4, "compute a discount of 4%")
action(n_d3, "compute a discount of 3%")
action(n_d2, "compute a discount of 2%")
converge(c_merge)
action(n_bill, "create the bill")
end(e1)
defines(orderSum, "sum of the order", {[0-]})
actor(a_default, "Default", [i1, n_check, b_decide, n_cont, n_d4, n_d3, n_d2, c_merge, n_bill, e1])
precedence(i1, n_check)
precedence(n_check, b_decide)
precedence(b_decide, n_cont)
precedence(b_decide, n_d4)
precedence(b_decide, n_d3)
precedence(b_decide, n_d2)
precedence(n_cont, c_merge)
precedence(n_d4, c_merge)
precedence(n_d3, c_merge)
precedence(n_d2, c_merge)
precedence(c_merge, n_bill)
precedence(n_bill, e1)
guard(b_decide, n_cont, orderSum < 500)
guard(b_decide, n_d4, orderSum > 2000)
guard(b_decide, n_d3, orderSum >= 1000 && orderSum <= 1500)
guard(b_decide, n_d2, orderSum >= 500 && orderSum <= 999)