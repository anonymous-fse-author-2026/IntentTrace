{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process, begin by supplying the requirement and then documenting it."
      ],
      "justification": "Captures process initiation and splits the requirement supply and documentation steps as described."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n0"
      ],
      "verbatim_texts": [
        "If the order is received via fax"
      ],
      "justification": "Models the fax reception condition and opens the XOR branch."
    },
    {
      "refs": [
        "action:n0"
      ],
      "verbatim_texts": [
        "input the order into an Excel file"
      ],
      "justification": "Handles the fax-order input step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone"
      ],
      "justification": "Captures the alternative reception channel guard."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "also input the order into an Excel file"
      ],
      "justification": "Action for mail/phone path, merging behaviour with the fax path."
    },
    {
      "refs": [
        "action:n6",
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete after a week, send it to the student."
      ],
      "justification": "Both actions capture the weekly sending step; redundancy does not alter behaviour."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list, type the orders into the MS-Access database."
      ],
      "justification": "Direct paraphrase of the database entry step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed."
      ],
      "justification": "Direct match for completion verification."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the database is completed, control the incoming order."
      ],
      "justification": "Matches the control step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "At the same time, continue to do the check."
      ],
      "justification": "Matches the concurrent check step."
    },
    {
      "refs": [
        "action:n11",
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the order is correct"
      ],
      "justification": "Models the correctness condition and the positive release outcome."
    },
    {
      "refs": [
        "guard:b2->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Captures the negative branch and agency contact."
    },
    {
      "refs": [
        "action:n15",
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac"
      ],
      "justification": "Evaluates the low-value threshold and triggers immediate release."
    },
    {
      "refs": [
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac",
        "send it for sign off and continue with the check."
      ],
      "justification": "Splits the high-value branch into parallel sign-off and check tasks, then converges them. Behaviour preserved."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac",
        "send it for sign off and continue with the check."
      ],
      "justification": "Splits the high-value branch into parallel sign-off and check tasks, then converges them. Behaviour preserved."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac",
        "send it for sign off and continue with the check."
      ],
      "justification": "Splits the high-value branch into parallel sign-off and check tasks, then converges them. Behaviour preserved."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac",
        "send it for sign off and continue with the check."
      ],
      "justification": "Splits the high-value branch into parallel sign-off and check tasks, then converges them. Behaviour preserved."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac",
        "send it for sign off and continue with the check."
      ],
      "justification": "Splits the high-value branch into parallel sign-off and check tasks, then converges them. Behaviour preserved."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
      ],
      "justification": "Direct match for agency contact and sign-off handoff."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Once the order is signed off, contact the client and release the order."
      ],
      "justification": "Direct match for post-signoff client contact and release."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "Direct match for PPC production trigger."
    },
    {
      "refs": [
        "action:n24",
        "guard:b4->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved"
      ],
      "justification": "Evaluates unsolvable issues and routes to order cancellation."
    },
    {
      "refs": [
        "guard:b4->n27",
        "action:n27"
      ],
      "verbatim_texts": [
        "If the issue can be solved"
      ],
      "justification": "Routes solvable issues to order release."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "After PPC initiates production, the goods will be produced."
      ],
      "justification": "Direct match for goods production step."
    },
    {
      "refs": [
        "action:n29",
        "guard:b5->e2"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled"
      ],
      "justification": "Evaluates cancellation need and terminates the process."
    },
    {
      "refs": [
        "guard:b5->n31",
        "action:n31"
      ],
      "verbatim_texts": [
        "If not, check the quality of the goods."
      ],
      "justification": "Routes non-cancellation path to quality inspection."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "justification": "Direct match for quality reporting."
    },
    {
      "refs": [
        "action:n33",
        "action:n34"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "justification": "Splits memo release and warehouse verification into two equivalent steps."
    },
    {
      "refs": [
        "action:n35",
        "action:n36"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "justification": "Splits invoice sending and finance reporting into sequential steps."
    },
    {
      "refs": [
        "action:n37",
        "action:n38"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods and sign and send the memo."
      ],
      "justification": "Splits commissioning and memo signing/sending into parallel-equivalent actions."
    },
    {
      "refs": [
        "action:n39",
        "action:n40"
      ],
      "verbatim_texts": [
        "Also, send the goods and ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "Splits goods dispatch and logistics memo verification."
    },
    {
      "refs": [
        "action:n41"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order."
      ],
      "justification": "Final step and process termination points. Structural ends align with process conclusion."
    }
  ],
