init(i1)
action(n1, "wake up")
action(n2, "are you hungry?")
branch(b1, XOR)
action(n3, "take a shower (A)")
action(n4, "have breakfast (A)")
action(n5, "still not hungry after first action?")
branch(b2, XOR)
action(n6, "take a shower (B)")
action(n7, "have breakfast (B)")
action(n8, "get on the bus and complete process")
end(e1)
converge(c2)
defines(v1, "are you hungry?", {'No', 'Yes'})
defines(v2, "still not hungry after first action?", {'No', 'Yes'})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, b2, n6, n7, n8, e1, c2])
precedence(i1, n1)
precedence(n2, b1)
precedence(n5, b2)
precedence(n8, e1)
precedence(c2, n8)
precedence(n1, n2)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, n5)
precedence(n4, n5)
precedence(b2, n6)
precedence(b2, n7)
precedence(n6, c2)
precedence(n7, c2)
guard(b1, n3, v1 = 'No')
guard(b1, n4, v1 = 'Yes')
guard(b2, n6, v2 = 'No')
guard(b2, n7, v2 = 'Yes')