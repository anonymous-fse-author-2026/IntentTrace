  "input_elements": [
    {
      "id": "i1",
      "content": "Initially, the appointment approval form is sent."
    },
    {
      "id": "i2",
      "content": "After that, the approval is received."
    },
    {
      "id": "i3",
      "content": "Following the approval, there is a contact with TS to clarify the timing."
    },
    {
      "id": "i4",
      "content": "Once the approval is received, it is checked."
    },
    {
      "id": "i5",
      "content": "If the resource is internal,"
    },
    {
      "id": "i6",
      "content": "the appointment is authorized."
    },
    {
      "id": "i7",
      "content": "If the resource is external,"
    },
    {
      "id": "i8",
      "content": "the appointment is also authorized."
    },
    {
      "id": "i9",
      "content": "After the approval, the mandatory documentation along with the approval is sent to HR services."
    },
    {
      "id": "i10",
      "content": "The form is then scanned and recorded into the GovSource system."
    },
    {
      "id": "i11",
      "content": "The approval is checked"
    },
    {
      "id": "i12",
      "content": "and then sent along with the mandatory documentation to HR services."
    },
    {
      "id": "i13",
      "content": "HR services receive the documentations"
    },
    {
      "id": "i14",
      "content": "and this marks the end of the process."
    },
    {
      "id": "i15",
      "content": "If there are no variations,"
    },
    {
      "id": "i16",
      "content": "the process continues."
    },
    {
      "id": "i17",
      "content": "However, if there are variations,"
    },
    {
      "id": "i18",
      "content": "a business case is completed."
    }
  ]
