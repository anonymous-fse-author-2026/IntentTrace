{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Implicit start node and first action step directly correspond to the opening unit."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "The initial decision is modeled as a check action followed by an XOR branch, which preserves the behavioural logic."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "Negative guard and advertisement action accurately capture the condition and its consequence."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "Positive guard and continuation check correspond to the alternative branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available"
      ],
      "justification": "Flows rejoin at the converge node before the second decision point, modeled again as a check action leading to a branch."
    },
    {
      "refs": [
        "guard:b3->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "Negative guard and repeat advertisement action match the source instruction."
    },
    {
      "refs": [
        "guard:b3->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Positive guard and selection action correctly model the successful candidate path."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "Appointment step, end-of-process restatement, terminal node, and final convergence all align with the closing unit without altering behaviour."
    }
  ],
