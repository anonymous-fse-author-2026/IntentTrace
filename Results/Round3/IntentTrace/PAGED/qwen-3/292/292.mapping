{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The start node and first action jointly capture the process initiation and receipt of the claim."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Directly matches the claim creation and recording step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "The branch gateway and action together represent the decision point."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "Correctly captures the rejection condition and the subsequent rejection action."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "Correctly captures the acceptance condition and the benefit offer."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Models the review step that follows the rejection path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Faithfully restates preparing the claim discharge."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Directly matches recording the benefit payment."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process."
      ],
      "justification": "Captures the secondary decision and the continuation path when the rejection is accepted."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Captures the alternative continuation path when the rejection is not accepted."
    },
    {
      "refs": [
        "guard:b2->e11",
        "guard:b2->n7",
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "The structural routing nodes and action nodes collectively model the parallel final steps of operating payment and closing the claim."
    }
  ],
