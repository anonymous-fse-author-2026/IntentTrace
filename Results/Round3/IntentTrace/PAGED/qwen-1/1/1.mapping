      "verbatim_texts": [
        "To start the process, begin by checking if the order has been received."
      ],
      "justification": "The init node establishes the start of the process, and the action accurately paraphrases the initial verification step."
    },
    {
      "refs": [
        "guard:b1->n2",
        "action:n2"
      ],
      "verbatim_texts": [
        "If the sum of the order is less than 500, then continue with the process."
      ],
      "justification": "Models the XOR decision point and the first branch path (<500) along with its corresponding continuation action."
    },
    {
      "refs": [
