      ],
      "justification": "Captures the final temporal trigger preceding process completion."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Restates the termination event and attaches the terminal node for the low path. Structural restatement does not change behaviour."
