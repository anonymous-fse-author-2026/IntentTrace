{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "Implicitly starts the process and captures the initial identification step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer"
      ],
      "justification": "Opens the XOR decision and captures the elicitation condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should then check the availability of the parts."
      ],
      "justification": "Action taken when elicitation is needed."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if they already have the availability information, they can proceed with the process."
      ],
      "justification": "Alternative path that bypasses extra steps and rejoins the main flow."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer, the team can also continue with the process."
      ],
      "justification": "Redundant restatement of the continue/proceed path, mapping to the same converge point."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if they need to record the customer's details"
      ],
      "justification": "Condition for the recording path."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if they need to record the customer's details"
      ],
      "justification": "Segmentation artifact repeating the same condition."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "record the customer's details"
      ],
      "justification": "Direct match for the recording action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "they should order and receive the part from Disuki."
      ],
      "justification": "Step triggered after deciding to record details."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "Follows part receipt with contracting step."
    },
    {
      "refs": [
        "action:n12",
        "action:n10"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected,"
      ],
      "justification": "Timing condition modeled as an action step, preserving flow before payment."
    },
    {
      "refs": [
        "action:n12",
        "action:n10"
      ],
      "verbatim_texts": [
        "the team can proceed with the payment."
      ],
      "justification": "Payment step following collection."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "Finalization action and structural end node."
    }
  ],
