{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "Initial step prioritizing orders matches the opening statement."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information."
      ],
      "justification": "Directly corresponds to checking customer information."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer exists, we move on to checking their payment history."
      ],
      "justification": "XOR branch and true guard route to payment history check, preserving the condition and action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if the customer does not exist, we need to verify their customer status."
      ],
      "justification": "False guard routes to status verification, matching the alternative path."
    },
    {
      "refs": [
        "guard:b2->n4",
        "action:n4",
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process."
      ],
      "justification": "Branches on payment history quality; positive path continues, negative path declines. Logic is preserved."
    },
    {
      "refs": [
        "guard:b3->n7",
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Wholesaler path correctly splits into creating a customer and checking availability."
    },
    {
      "refs": [
        "guard:b3->e1"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Private customer path terminates the process, functionally equivalent to sending a decline and stopping."
    },
    {
      "refs": [
        "guard:b4->n9"
      ],
      "verbatim_texts": [
        "If the products are not available,"
      ],
      "justification": "Branches on product availability with a false guard for the unavailable case."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Action produces goods and declines, followed by process termination."
    },
    {
      "refs": [
        "guard:b4->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "True guard routes to continuation and confirmation; converge rejoins parallel/sub-flows."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "Models informing the stock department; omitting accounting is a harmless simplification that preserves core behaviour."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice,"
      ],
      "justification": "Splits the compound preparation step into two sequential actions, preserving behaviour."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Directly matches the readiness and sending state."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Captures the delivery step following closure/preparation."
    },
    {
      "refs": [
        "guard:b6->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Payment received condition triggers order closure and process end."
    },
    {
      "refs": [
        "guard:b6->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Outstanding payment condition routes to reminder count check."
    },
    {
      "refs": [
        "guard:b7->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Low reminder count condition allows process continuation."
    },
    {
      "refs": [
        "guard:b7->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "High reminder count triggers donning activation and terminates the process."
    }
  ],
