init(start)
action(n1, "start")
action(n2, "Request information about organization")
action(n3, "Schedule an appointment")
branch(b1, XOR)
action(n5, "Proceed with Control and measurement")
action(n6, "End process - Potential client")
end(e1)
action(n7, "Revisit after two weeks")
branch(b2, XOR)
action(n9, "End process - Target reached")
end(e2)
action(n10, "End process - Dissatisfied or other reason")
end(e3)
defines(v1, "Is the customer in Intake stage?", {"Intake", "Potential client"})
defines(v2, "Has target been reached?", {"Target reached", "Dissatisfied or other reason"})
actor(a_default, "Default", [start, n1, n2, n3, b1, n5, n6, e1, n7, b2, n9, e2, n10, e3])
precedence(start, n1)
precedence(n3, b1)
precedence(n6, e1)
precedence(n7, b2)
precedence(n9, e2)
precedence(n10, e3)
precedence(n1, n2)
precedence(n2, n3)
precedence(b1, n5)
guard(b1, n5, v1 = "Intake")
precedence(b1, n6)
guard(b1, n6, v1 = "Potential client")
precedence(n5, n7)
precedence(b2, n9)
guard(b2, n9, v2 = "Target reached")
precedence(b2, n10)
guard(b2, n10, v2 = "Dissatisfied or other reason")