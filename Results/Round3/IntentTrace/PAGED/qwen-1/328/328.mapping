        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, the customer should first request information about the organization and then schedule an appointment."
      ],
      "justification": "Covers process initialization and the first sequential steps of requesting information and scheduling an appointment."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the customer is in the \"Intake\" stage,"
      ],
      "justification": "Represents the decision point and the positive condition for the Intake stage."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "they should proceed with \"Control and measurement\"."
      ],
      "justification": "Direct paraphrase of proceeding with control and measurement."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the customer is a \"Potential client\", the process will come to an end."
      ],
      "justification": "Captures the alternative branch for Potential clients and the resulting process termination. Modeling the end condition as an action plus end node preserves behaviour."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After the \"Control and measurement\" stage, the customer should revisit after two weeks."
      ],
      "justification": "Direct match for the revisit step following control and measurement."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the target has been reached, the process will come to an end."
      ],
      "justification": "Captures the branch for reaching the target and the corresponding process end."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if the customer is dissatisfied or for any other reason, the process will also come to an end."
      ],
      "justification": "Captures the alternative branch for dissatisfaction/other reasons leading to process end. Consistent with source behaviour."
    }
  ],
