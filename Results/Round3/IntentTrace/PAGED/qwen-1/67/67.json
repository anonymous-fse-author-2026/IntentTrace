  "input_elements": [
    {
      "id": "i1",
      "content": "To begin with, the first step is Course registration."
    },
    {
      "id": "i2",
      "content": "If an exception is needed, then a Request for the exception should be made."
    },
    {
      "id": "i3",
      "content": "if an exception is not needed"
    },
    {
      "id": "i4",
      "content": "After the exception is approved, the next step is course enrollment, followed by seminar group enrollment."
    },
    {
      "id": "i5",
      "content": "the homework assignment can be started"
    },
    {
      "id": "i6",
      "content": "working on the homework"
    },
    {
      "id": "i7",
      "content": "it should be turned in"
    },
    {
      "id": "i8",
      "content": "The homework will then be evaluated"
    },
    {
      "id": "i9",
      "content": "If it was not the last homework, another homework assignment will be given."
    },
    {
      "id": "i10",
      "content": "if it was the last homework, the process can continue."
    },
    {
      "id": "i11",
      "content": "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
    },
    {
      "id": "i12",
      "content": "After signing up for the exam, it should be attended."
    },
    {
      "id": "i13",
      "content": "it will be evaluated"
    },
    {
      "id": "i14",
      "content": "If the exam is passed, the course is considered passed"
    },
    {
      "id": "i15",
      "content": "if the exam is failed, another sign-up for the exam is required."
    }
  ]
