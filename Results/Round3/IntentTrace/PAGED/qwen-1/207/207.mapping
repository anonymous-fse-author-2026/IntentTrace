{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, for CAB, the first step is to assess the change request."
      ],
      "justification": "Start node and first action directly correspond to the opening statement."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the affected systems for any impacts on the business unit"
      ],
      "justification": "Direct paraphrase of the second step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "determine whether the change request should be approved or not"
      ],
      "justification": "Captures the decision preparation step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the change request should be approved in its current state, then it is approved."
      ],
      "justification": "Models the positive decision path and approval action correctly using a boolean guard."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the change request should not be approved in its current state, further evaluation is needed to determine if the change will be acceptable with more information provided"
      ],
      "justification": "Models the negative decision path and subsequent evaluation step."
    },
    {
      "refs": [
        "action:n6",
        "action:n22"
      ],
      "verbatim_texts": [
        "the change is implemented."
      ],
      "justification": "Covers both instances of implementation in the flow (initial and post-review) along with their terminal nodes."
    },
    {
      "refs": [
        "action:n9",
        "action:n24"
      ],
      "verbatim_texts": [
        "if the change is deemed unacceptable, it is rejected."
      ],
      "justification": "Covers rejection steps and termination at relevant points in the process."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "In this case, a request for more information is made to the Change Coordinator."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The request is then followed by an email enquiry to the Change Coordinator."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the approval register is updated within a timeframe of 3 business days."
      ],
      "justification": "Direct match preserving the timeframe."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The email enquiry is also forwarded to the Change Requester."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If there are no further inquiries or issues, the process concludes after 3 business days."
      ],
      "justification": "Accurately models the condition for concluding early and the associated wait time."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "if there are inquiries from the CAB, a response is expected within 1-3 business days."
      ],
      "justification": "Accurately models the alternative inquiry path and expected response window."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the response is received from the requester, it is forwarded to the CAB for further evaluation."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n20",
        "guard:b4->n21",
        "guard:b4->n24",
        "action:n21"
      ],
      "verbatim_texts": [
        "Based on the response, a final determination is made regarding the approval of the change request."
      ],
      "justification": "Captures the final evaluation, decision gateway, outgoing guards, and positive outcome action."
    }
  ],
