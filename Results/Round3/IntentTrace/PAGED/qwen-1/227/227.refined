defines(v1, "is there coverage", {'Yes', 'No'})
defines(v2, "has the offer been accepted", {'Yes', 'No'})
defines(v3, "repeat the same steps if necessary", {'Yes', 'No'})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, n6, b2, n7, n8, c1, n9, b3, c_start, e1])
precedence(i1, c_start)
precedence(c_start, n1)
precedence(n1, n2)
precedence(n2, n3)
