@startuml
!theme plain
|a_default| Default
|a_default|
start
:make appointment at hairdresser's;
:go to hairdresser;
:v1: service ({washed, dyed, haircut, none}); <<objectSignal>>
switch ()
case ([v1 = 'washed'] need hair washed)
:wash hair;
case ([v1 = 'dyed'] want hair dyed)
:dye hair;
case ([v1 = 'haircut'] need haircut)
:cut hair;
case ([v1 = 'none'] no service needed)
endswitch
:pay hairdresser;
:end process;
stop
@enduml