{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for ACME Company, start by"
      ],
      "justification": "Structural start and introductory action correspond to the opening phrase."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "receiving the customer request"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the current inventory level."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum"
      ],
      "justification": "Opens the XOR decision and captures the lower-threshold condition."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the inventory level is above the minimum"
      ],
      "justification": "Captures the alternative branch condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "accept the customer request.",
        "After accepting the customer request, create a purchase order."
      ],
      "justification": "Merges acceptance and PO creation into a single step; merging preserves behaviour."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "reject the customer request.",
        "If the customer request is rejected, the process ends."
      ],
      "justification": "Combines rejection action and process termination."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the purchase order is created, review it."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order."
      ],
      "justification": "Opens the second XOR decision, captures the rejection condition, and performs the rework action."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "However, if the purchase order is approved"
      ],
      "justification": "Captures the approval condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "if the purchase order is approved, reserve the funds."
      ],
      "justification": "Combines approval outcome and fund reservation."
    },
    {
      "refs": [
        "converge:c_loop"
      ],
      "verbatim_texts": [
        "In case the purchase order needs to be reworked, review it again."
      ],
      "justification": "Structural converge element models the loop back to review after rework."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After reserving the funds, send the purchase order."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "receive the packing slip",
        "receive the invoice."
      ],
      "justification": "AND gateway models the simultaneous/parallel steps described in the source."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "receive the packing slip"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "receive the invoice."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Upon receiving the packing slip, record it."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Similarly, upon receiving the invoice, record it as well."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
