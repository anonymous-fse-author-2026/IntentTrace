      "verbatim_texts": [
        "At the beginning, if we can capture data from FMA, we should continue the process."
      ],
      "justification": "The init marks the process start, and the action models the FMA capture condition as a check step. Re-typing a condition as an action preserves behaviour."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Otherwise, if we can capture data from Jamendo, we should continue the process."
      ],
      "justification": "Models the Jamendo capture fallback condition as a check step. Paraphrase preserves behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, we need to get music ids for the genre."
      ],
      "justification": "Direct paraphrase of the music ID retrieval step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the genre is missing, we should continue the process."
      ],
      "justification": "Models the genre-missing condition as a check action. Decision logic is preserved."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if there are no additional genres, we should continue the process."
      ],
      "justification": "Checks for the existence of additional genres. Logically equivalent to the source condition; modelling choice preserves behaviour."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the sample is missing, we should continue the process."
      ],
      "justification": "Models the sample-missing condition as a check action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "We should download the sample."
      ],
      "justification": "Direct match for the sample download step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if there are no additional samples, the process ends."
      ],
      "justification": "The check action evaluates the sample availability condition, and the end node captures the explicit process termination. Together they preserve the final branch and termination behaviour."
    }
  ],
