{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process for IT Infrastructure, start with the Loan Application and then proceed to Receive Loan Application."
      ],
      "justification": "Initializes the process and captures the first three sequential steps."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "check the Banking Privilege Status."
      ],
      "justification": "Directly models the status check step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If there is a \"Construct Error Response\""
      ],
      "justification": "Opens the first decision point and captures the error condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then the process ends with an \"Error Message\"."
      ],
      "justification": "Models the negative outcome and termination."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "Otherwise, if there is a \"Retrieve Customer Information\""
      ],
      "justification": "Captures the alternative branch condition and the retrieval step."
    },
    {
      "refs": [
        "action:n_fc",
        "action:n7"
      ],
      "verbatim_texts": [
        "check the fulfillment of loan conditions."
      ],
      "justification": "Performs the condition check and sets up the next decision node."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8",
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, if there is a \"Calculate threshold amount\", continue with the process."
      ],
      "justification": "Handles both the implicit error exit and the explicit continuation path from the condition check."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If there is a \"Check Creditworthiness\", designate the Status. Furthermore, if there is a \"Check Creditworthiness\", designate the Status."
      ],
      "justification": "Executes the creditworthiness check and status designation; source redundancy is harmlessly processed."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the Status is designated, initialize the Loan Form. Similarly, once the Status is designated, initialize the Loan Form."
      ],
      "justification": "Directly implements the form initialization step."
    },
    {
      "refs": [
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If there is a \"Construct Approve Response\""
      ],
      "justification": "Opens the final approval decision and captures the positive condition."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "then the process ends with an \"Approved Message\"."
      ],
      "justification": "Models the approval outcome and process termination."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Otherwise, if there is a \"Construct Reject Response\", then the process ends with a \"Reject Message\"."
      ],
      "justification": "Captures the rejection condition, constructs the response, outputs the message, and terminates."
    }
  ],
