action(n14, "end process")
end(e1)
defines(v1, "is option to submit false", {true, false})
defines(v2, "is there another filter to apply", {true, false})
defines(v3, "is option to submit true", {true, false})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, b1, n6, n8, c1, n9, b2, n10, n11, c2, n12, n13, n14, e1])
precedence(i1, n1)
precedence(n1, n2)
