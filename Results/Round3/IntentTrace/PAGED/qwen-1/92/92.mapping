{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "Covers the initial registration step and implicitly marks the process start."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request."
      ],
      "justification": "Captures the first decision point, the 'no fee' guard, and the corresponding registration action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "Captures the alternative 'fee' guard and the purchase request creation action."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Structural terminator for the no-fee path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Directly models the approval status check step."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Captures the second decision point, the 'approved' guard, and the notification receipt action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Captures the 'rejected' guard and the rejection notification action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Models the subsequent registration step following approval."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Structural terminator for the rejection path."
    }
  ],
