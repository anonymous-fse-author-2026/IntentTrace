{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the process for ACME Company, the Resupply Cycle is triggered,"
      ],
      "justification": "Start node and first action directly correspond to the opening trigger phrase."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level."
      ],
      "justification": "Directly models the inventory check step."
    },
    {
      "refs": [
        "guard:b1->n16"
      ],
      "verbatim_texts": [
        "If the Inventory is greater than the Minimum Level, then the process ends."
      ],
      "justification": "Structural split and guards correctly capture the threshold logic (> Minimum vs Otherwise/<= Minimum)."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "Otherwise, a Purchase Order is created."
      ],
      "justification": "Structural split and guards correctly capture the threshold logic (> Minimum vs Otherwise/<= Minimum)."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, a Purchase Order is created."
      ],
      "justification": "Models the negative branch outcome."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "The Purchase Order is then reviewed."
      ],
      "justification": "Direct paraphrase of the review step."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected, it is reworked."
      ],
      "justification": "Gateway and guards correctly split flow based on Rejected/Accepted status."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "However, if the Purchase Order is accepted, funds are reserved for payment."
      ],
      "justification": "Gateway and guards correctly split flow based on Rejected/Accepted status."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected, it is reworked."
      ],
      "justification": "Models the rejection/rework path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if the Purchase Order is accepted, funds are reserved for payment."
      ],
      "justification": "Models the acceptance/fund reservation path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reserving funds for payment, the Purchase Order is sent to the Supplier."
      ],
      "justification": "Direct match to the sending step."
    },
    {
      "refs": [
        "action:n9",
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: the Packing Slip is received and the Invoice is received."
      ],
      "justification": "Two separate receive steps correctly capture the simultaneous inputs described."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Upon receiving the Packing Slip, it is recorded."
      ],
      "justification": "Direct match to the packing slip recording step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Similarly, upon receiving the Invoice, it is recorded."
      ],
      "justification": "Direct match to the invoice recording step."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the funds are released for payment, the payment is issued to the Supplier."
      ],
      "justification": "Condition modeled as an action step ('Release Funds') followed by the payment issuance action preserves behaviour."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Finally, the process ends with the issuance of payment to the Supplier."
      ],
      "justification": "End marker and final action align with the concluding termination statement."
    }
  ],
