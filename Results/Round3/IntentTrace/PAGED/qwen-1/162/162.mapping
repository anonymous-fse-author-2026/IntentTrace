  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start"
      ],
      "justification": "Marks the process initiation and corresponding starting step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "please provide the userdata for flickr."
      ],
      "justification": "Directly captures the initial input requirement."
    },
    {
      "refs": [
        "guard:b1->n_succ",
        "action:n_succ"
      ],
      "verbatim_texts": [
        "If the login is successful, the process will end."
      ],
      "justification": "Models the positive login condition leading to immediate termination. Guard abstracts the condition correctly without changing behaviour."
    },
    {
      "refs": [
        "guard:b1->n_fail",
        "action:n_fail"
      ],
      "verbatim_texts": [
        "However, if the login fails, we will continue with the process."
      ],
      "justification": "Captures the failure path that flows into the subsequent decision point. Added structural convergence preserves the rejoined flow."
    },
    {
      "refs": [
        "guard:b2->n_r1",
        "action:n_r1"
      ],
      "verbatim_texts": [
        "If you want to try again"
      ],
      "justification": "First retry option modeled as a guarded branch."
    },
    {
      "refs": [
        "guard:b2->n_a1",
        "action:n_a1"
      ],
      "verbatim_texts": [
        "if you choose to abort, the process will end."
      ],
      "justification": "First abort option leading to termination."
    },
    {
      "refs": [
        "guard:b2->n_r2",
        "action:n_r2"
      ],
      "verbatim_texts": [
        "If you still want to try again, please provide the userdata for flickr."
      ],
      "justification": "Redundant restatement of the retry path split into a separate branch. Behaviour is preserved despite the slight truncation in the action label."
    },
    {
      "refs": [
        "guard:b2->n_a2",
        "action:n_a2"
      ],
      "verbatim_texts": [
        "Alternatively, if you decide to abort, the process will end."
      ],
      "justification": "Redundant restatement of the abort path split into a separate branch. Behaviour is preserved."
    }
  ],
