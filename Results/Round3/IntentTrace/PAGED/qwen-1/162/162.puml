@startuml
!theme plain
|a_default| Default
|a_default|
start
:To start;
:please provide the userdata for flickr.;
:v_login: Login Status ({success, fail}); <<objectSignal>>
if () then (["v_login = 'success'"])
:If the login is successful;
stop
else (["v_login = 'fail'"])
:However, if the login fails, we will continue with the process.;
:v_choice: User Choice ({want_to_try_again, choose_to_abort, still_want_to_try_again, decide_to_abort}); <<objectSignal>>
switch ()
case (["v_choice = 'want_to_try_again'"])
:If you want to try again;
case (["v_choice = 'still_want_to_try_again'"])
:If you still want to try again;
case (["v_choice = 'choose_to_abort'"])
:if you choose to abort;
stop
case (["v_choice = 'decide_to_abort'"])
:if you decide to abort;
endswitch
endif
@enduml