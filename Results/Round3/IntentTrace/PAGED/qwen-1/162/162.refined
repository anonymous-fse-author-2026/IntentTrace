init(s)
end(e1)
end(e2)
action(n1, "To start")
action(n2, "please provide the userdata for flickr.")
action(n_succ, "If the login is successful")
action(n_fail, "However, if the login fails, we will continue with the process.")
action(n_r1, "If you want to try again")
action(n_r2, "If you still want to try again")
action(n_a1, "if you choose to abort")
action(n_a2, "if you decide to abort")
branch(b1, XOR)
branch(b2, XOR)
converge(c1)
defines(v_login, "Login Status", {'success', 'fail'})
defines(v_choice, "User Choice", {'want_to_try_again', 'choose_to_abort', 'still_want_to_try_again', 'decide_to_abort'})
actor(a_default, "Default", [s, n1, c1, n2, b1, n_succ, e1, n_fail, b2, n_r1, n_r2, n_a1, n_a2, e2])
precedence(s, n1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, b1)
precedence(b1, n_succ)
precedence(b1, n_fail)
precedence(n_fail, b2)
precedence(b2, n_r1)
precedence(b2, n_r2)
precedence(b2, n_a1)
precedence(b2, n_a2)
precedence(n_r1, c1)
precedence(n_r2, c1)
precedence(n_succ, e1)
precedence(n_a1, e2)
precedence(n_a2, e2)
guard(b1, n_succ, "v_login = 'success'")
guard(b1, n_fail, "v_login = 'fail'")
guard(b2, n_r1, "v_choice = 'want_to_try_again'")
guard(b2, n_r2, "v_choice = 'still_want_to_try_again'")
guard(b2, n_a1, "v_choice = 'choose_to_abort'")
guard(b2, n_a2, "v_choice = 'decide_to_abort'")