      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Captures the process initiation and the first two sequential actions."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "guard:b1->n7",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned. However, if the invoice is complete, the process continues."
      ],
      "justification": "Models the completeness check, the return outcome (ending that branch), and the continuation path correctly."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
        "guard:b2->c2",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted. On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Captures the compliance decision split and accurately routes both non-compliant and compliant outcomes."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->n10",
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved. But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Models the resolution check split, both branches, and the subsequent merge node."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Directly corresponds to the invoice payment step described in the unit."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Bill Client."
      ],
      "justification": "Exact match."
    },
    {
      "refs": [
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Correctly models the response check and the resulting wait period."
    },
    {
      "refs": [
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Captures the reminder action and the explicit process termination."
    }
  ],
