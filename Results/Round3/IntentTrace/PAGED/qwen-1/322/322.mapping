      ],
      "verbatim_texts": [
        "To begin the Expense Report process, start by receiving the expense report."
      ],
      "justification": "Covers process initiation and the initial receipt step. Redundant action nodes restating the same start/receipt behaviour are preserved as matches."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "verify the account and review the report."
      ],
      "justification": "Direct paraphrase of the verification and review step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the report is accepted,"
      ],
      "justification": "Models the XOR decision point and its positive condition. The variable guard 'v1 = Yes' faithfully abstracts 'accepted'."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed with processing the reimbursement."
      ],
      "justification": "Directly captures the reimbursement processing step on the acceptance path."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "However, if the report is rejected,"
      ],
      "justification": "Captures the negative condition of the branch. 'v1 = No' correctly abstracts 'rejected'."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "send an Expense Rejection Notification and end the process."
      ],
      "justification": "Covers the notification step and the termination of the rejection path. Explicit 'End' action plus end node preserves the finalisation behaviour."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the reimbursement is processed, proceed with the payment and end the process."
      ],
      "justification": "Captures the payment step and termination of the acceptance path after reimbursement. Modelling choices preserve the required flow and outcome."
    }
  ],
