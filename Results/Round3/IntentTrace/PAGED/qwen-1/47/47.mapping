{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Captures the process initiation and the first two sequential actions."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete"
      ],
      "justification": "Models the decision point and its negative condition using standard guard notation."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is returned."
      ],
      "justification": "Directly implements the action for the incomplete branch."
    },
    {
      "refs": [
        "guard:b1->b2"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Captures the positive condition routing to the next decision stage."
    },
    {
      "refs": [
        "guard:b2->n4"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant"
      ],
      "justification": "Opens the second decision and routes on the non-compliant condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "further checks are conducted."
      ],
      "justification": "Directly implements the required step for non-compliant invoices."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Captures the compliant branch condition and its continuation step."
    },
    {
      "refs": [
        "guard:b3->n5"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call"
      ],
      "justification": "Routes based on the phone call resolution condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "non-compliance is resolved."
      ],
      "justification": "Implements the resolution step for phone-call issues."
    },
    {
      "refs": [
        "guard:b3->n6"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back"
      ],
      "justification": "Captures the alternative condition requiring mail."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the invoice is returned."
      ],
      "justification": "Implements the return step for mail-back issues."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Joins previous branches and consolidates the payment and resolution steps into a single action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Directly models the parallel billing step."
    },
    {
      "refs": [
        "guard:b4->n10"
      ],
      "verbatim_texts": [
        "If there is no response"
      ],
      "justification": "Routes to the waiting period based on lack of response."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "a period of 10 days is given."
      ],
      "justification": "Implements the 10-day wait step."
    },
    {
      "refs": [
        "guard:b4->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the invoice is returned, non-compliance is resolved."
      ],
      "justification": "Handles the returned invoice path by resolving non-compliance."
    },
    {
      "refs": [
        "guard:b4->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Routes on the paid status and executes the client notification step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Combines the reminder action and the process termination point."
    },
    {
      "refs": [
        "guard:b5->n14"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied"
      ],
      "justification": "Routes to discrepancy resolution based on client dissatisfaction."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "payment discrepancy is resolved."
      ],
      "justification": "Directly implements the resolution step."
    },
    {
      "refs": [
        "guard:b5->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Captures the satisfaction condition, the continuation step, and joins the flow back together."
    }
  ],
