@startuml
!theme plain
|a_default| Default
|a_default|
start
:Request to purchase a motorcycle;
:Production order received;
:v1: Production order received ({true, false}); <<objectSignal>>
if () then ([v1 = true] Continue process)
:Continue the process;
else ([v1 = false] Update sales)
:Update sales information;
:Proceed to order dispatch;
endif
:v2: Materials unavailable ({true, false}); <<objectSignal>>
if () then ([v2 = true] Order materials)
:Materials unavailable;
:Order materials from supplier;
:Goods received from supplier;
else ([v2 = false] Manufacture)
:Available goods for production;
:Place manufacturing order;
endif
:Issue goods;
:Produce motorcycles;
:v5: Process outcome ({dispatch, end, sales}); <<objectSignal>>
switch ()
case ([v5 = "dispatch"] Dispatch path)
:Update stock;
:Dispatch motorcycles;
case ([v5 = "end"] End path)
:Update stock;
case ([v5 = "sales"] Sales update path)
:Update sales information;
endswitch
stop
@enduml