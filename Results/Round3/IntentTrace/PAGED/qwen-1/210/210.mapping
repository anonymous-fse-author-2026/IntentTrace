      ],
      "justification": "Models the alternative available goods condition and the manufacturing order placement."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier, the goods are issued"
      ],
      "justification": "Sequential steps capturing material receipt and goods issuance."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "and the motorcycles are produced"
      ],
      "justification": "Directly captures the production step following issuance."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "At the same time, the stock is updated and the motorcycles are dispatched"
      ],
      "justification": "Captures the concurrent stock update and dispatch operations."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "the stock is updated and the process ends"
      ],
      "justification": "Final stock update followed by process termination."
    },
    {
