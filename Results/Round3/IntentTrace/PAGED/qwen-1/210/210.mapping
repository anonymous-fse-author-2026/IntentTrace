      ],
      "justification": "Models the alternative/negative arm of the first XOR decision."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n6",
        "label:b2->n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier"
      ],
      "justification": "Models the unavailable materials condition and the corresponding supplier order action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "label:b2->n8",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
