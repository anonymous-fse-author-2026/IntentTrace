  "input_elements": [
    {
      "id": "i1",
      "content": "the process begins with a request to purchase a motorcycle"
    },
    {
      "id": "i2",
      "content": "continue the process if a production order is received"
    },
    {
      "id": "i3",
      "content": "update the sales information and proceed to order dispatch"
    },
    {
      "id": "i4",
      "content": "If there are unavailable materials, they are ordered from the supplier"
    },
    {
      "id": "i5",
      "content": "if there are available goods for production, a manufacturing order is placed"
    },
    {
      "id": "i6",
      "content": "Once the materials are received from the supplier, the goods are issued"
    },
    {
      "id": "i7",
      "content": "and the motorcycles are produced"
    },
    {
      "id": "i8",
      "content": "At the same time, the stock is updated and the motorcycles are dispatched"
    },
    {
      "id": "i9",
      "content": "the stock is updated and the process ends"
    },
    {
      "id": "i10",
      "content": "Simultaneously, the stock is updated and the sales information is updated"
    }
  ]
