{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Initial trigger and first action step correspond directly to the opening instruction."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "Decision split and positive branch correctly capture the threshold condition and review action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Negative branch guard and subsequent translation-check action align with the source."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Second decision split and positive translation path are preserved."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Alternative confirmation path and convergence point after the translation branch."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Direct match for the first review evaluation step."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Rejection branch and report-editing action correctly modeled."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Approval branch and subsequent translation check are captured."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Actions following the second approval path; the conditional is preserved structurally via flow ordering."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Direct match for the receipts evaluation step."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Acceptance branch and expense-processing action align with source."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Rejection branch and final edit action correctly modeled."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Termination action and end node correspond to the closing statement."
    }
  ],
  "mutations": [],
  "omissions": [
    {
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "reason": "The source explicitly requires a second evaluation of the review decision before proceeding to translate/confirm receipts, but no element in the model captures this intermediate step or its branching logic."
    }
  ],
