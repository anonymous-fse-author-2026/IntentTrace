action(i16, "If the issue cannot be solved, cancel the order.")
action(i17, "If the issue can be solved, release the order.")
action(i18, "After PPC initiates production, the goods will be produced.")
branch(b_cancel, XOR)
action(i19, "If the order needs to be cancelled, the process ends.")
action(i20, "If not, check the quality of the goods.")
action(i21, "Once the quality is checked, create and send a quality report to the finance department.")
action(i22, "Release the order via memo and ensure that the memo is achieved in the warehouse.")
branch(b_final, XOR)
action(i23, "Send the invoice and once it is sent, report the achievement to the finance department.")
action(i24, "At the same time, commission the goods and sign and send the memo.")
action(i25, "Also, send the goods and ensure that the signed memo is achieved in the logistic department.")
converge(c_final)
action(i26, "Finally, archive the memo and close order. This marks the end of the process.")
