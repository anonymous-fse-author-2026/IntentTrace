branch(b_input, XOR)
action(i2, "If the order is received via fax, input the order into an Excel file.")
action(i3, "If the order is received via mail or phone, also input the order into an Excel file.")
converge(c_excel)
action(i4, "Once the Excel list is complete after a week, send it to the student.")
action(i5, "Upon receiving the Excel list, type the orders into the MS-Access database.")
action(i6, "After typing the orders into the database, ensure that it is completed.")
action(i7, "Once the database is completed, control the incoming order. At the same time, continue to do the check.")
branch(b_correct, XOR)
action(i8, "If the order is correct, release it.")
action(i9, "Send the Excel list to the student and upon receiving it, continue with the process.")
action(i10, "However, if the order is incorrect, contact the selling agency.")
converge(c_correct)
branch(b_amount, XOR)
action(i11, "If the order is worth less than 5.000 €, release it.")
action(i12, "If the order is worth more than 5.000 €, send it for sign off and continue with the check.")
