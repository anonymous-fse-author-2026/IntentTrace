{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To start the process, begin by supplying the requirement and then documenting it."
      ],
      "justification": "Starts the process and covers the initial documentation step."
    },
    {
      "refs": [
        "guard:b_input->i2",
        "action:i2"
      ],
      "verbatim_texts": [
        "If the order is received via fax, input the order into an Excel file."
      ],
      "justification": "Models the fax condition as a split with a guard and the corresponding action."
    },
    {
      "refs": [
        "guard:b_input->i3",
        "action:i3"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone, also input the order into an Excel file."
      ],
      "justification": "Models the mail/phone condition, its action, and the convergence of the two input paths."
    },
    {
      "refs": [
        "action:i4"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete after a week, send it to the student."
      ],
      "justification": "Direct match to the weekly compilation and forwarding step."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list, type the orders into the MS-Access database."
      ],
      "justification": "Direct match to the database entry step."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed."
      ],
      "justification": "Direct match to the completion verification step."
    },
    {
      "refs": [
        "action:i7"
      ],
      "verbatim_texts": [
        "Once the database is completed, control the incoming order. At the same time, continue to do the check."
      ],
      "justification": "Direct match to the order control and checking step."
    },
    {
      "refs": [
        "guard:b_correct->i8",
        "action:i8"
      ],
      "verbatim_texts": [
        "If the order is correct, release it."
      ],
      "justification": "Models the correctness check as a split with a guard and the release action."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "Send the Excel list to the student and upon receiving it, continue with the process."
      ],
      "justification": "Direct match to the forwarding and continuation step."
    },
    {
      "refs": [
        "guard:b_correct->i10",
        "action:i10"
      ],
      "verbatim_texts": [
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Models the incorrect path with a guard, action, and convergence back to the main flow."
    },
    {
      "refs": [
        "guard:b_amount->i11",
        "action:i11"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac, release it."
      ],
      "justification": "Models the low-value condition as a split with a guard and release action."
    },
    {
      "refs": [
        "guard:b_amount->i12",
        "action:i12"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "Models the high-value condition and corresponding actions correctly."
    },
    {
      "refs": [
        "action:i13"
      ],
      "verbatim_texts": [
        "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
      ],
      "justification": "Direct match to the agency contact and sign-off step."
    },
    {
      "refs": [
        "action:i14"
      ],
      "verbatim_texts": [
        "Once the order is signed off, contact the client and release the order."
      ],
      "justification": "Direct match to the final client contact and release, merging the amount branches."
    },
    {
      "refs": [
        "action:i15"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "Direct match to the PPC production initiation."
    },
    {
      "refs": [
        "guard:b_issue->i16",
        "action:i16"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order."
      ],
      "justification": "Models the unsolvable issue path with a split, guard, and cancellation action."
    },
    {
      "refs": [
        "guard:b_issue->i17",
        "action:i17"
      ],
      "verbatim_texts": [
        "If the issue can be solved, release the order."
      ],
      "justification": "Models the solvable issue path correctly."
    },
    {
      "refs": [
        "action:i18"
      ],
      "verbatim_texts": [
        "After PPC initiates production, the goods will be produced."
      ],
      "justification": "Direct match to the goods production step."
    },
    {
      "refs": [
        "guard:b_cancel->i19",
        "action:i19"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends."
      ],
      "justification": "Models the cancellation decision, action, and explicit process termination."
    },
    {
      "refs": [
        "guard:b_cancel->i20",
        "action:i20"
      ],
      "verbatim_texts": [
        "If not, check the quality of the goods."
      ],
      "justification": "Models the non-cancellation path leading to quality inspection."
    },
    {
      "refs": [
        "action:i21"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "justification": "Direct match to the quality reporting step."
    },
    {
      "refs": [
        "action:i22"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "justification": "Direct match to the memo release and warehouse confirmation."
    },
    {
      "refs": [
        "guard:b_final->i23",
        "action:i23"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "justification": "Models the first final path (invoice) as a split branch with guard and action."
    },
    {
      "refs": [
        "guard:b_final->i24",
        "action:i24"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods and sign and send the memo."
      ],
      "justification": "Models the second concurrent path (commission) correctly."
    },
    {
      "refs": [
        "guard:b_final->i25",
        "action:i25"
      ],
      "verbatim_texts": [
        "Also, send the goods and ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "Models the third concurrent path (logistics) correctly."
    },
    {
      "refs": [
        "action:i26"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order. This marks the end of the process."
      ],
      "justification": "Merges the final paths, performs archiving, and explicitly terminates the process."
    }
  ],
  "mutations": [],
  "omissions": [],
  "additions": [],
