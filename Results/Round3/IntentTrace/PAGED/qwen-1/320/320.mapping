{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially,"
      ],
      "justification": "Initializes the process scope and start action."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
      "justification": "Opens the first decision gateway and conditions the positive path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\""
      ],
      "justification": "Executes the initial research schedule step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the option is not selected"
      ],
      "justification": "Conditions the negative path of the first decision."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Handles the alternative path; splitting into two sequential actions preserves the described behavior."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule,"
      ],
      "justification": "Performs the schedule validation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory."
      ],
      "justification": "Evaluates schedule satisfaction and establishes the second decision point."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is not,"
      ],
      "justification": "Routes to retry research when the schedule is unsatisfactory."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then perform the action \"Research schedule\""
      ],
      "justification": "Retries the research schedule action."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If it is,"
      ],
      "justification": "Routes to ticket creation when the schedule is satisfactory."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Creates the ticket order for SNCF."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Validates the newly created ticket order."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Checks approval status and opens the first approval gateway."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "then the process ends."
      ],
      "justification": "Terminates the process when the ticket order is not approved."
    },
    {
      "refs": [
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If it is approved,"
      ],
      "justification": "Routes to re-validation when the ticket order receives approval."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "then validate the ticket order."
      ],
      "justification": "Performs the second validation step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Second approval evaluation and gateway."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18",
        "guard:b5->n19"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Handles outcomes of the second check; routes to termination or proceeds to final validation."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Final validation and approval check gateway."
    },
    {
      "refs": [
        "guard:b6->n21",
        "action:n21",
        "guard:b6->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Handles final outcomes (both approved/not lead to termination) and converges parallel exit flows."
    }
  ],
