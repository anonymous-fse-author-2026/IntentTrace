{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Init node and first two actions directly correspond to the opening statement describing the start and initial steps."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Branch and guard capture the incomplete condition; action captures the return step."
    },
    {
      "refs": [
        "guard:b1->b2"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Guard on the alternative path represents the complete invoice continuing the flow."
    },
    {
      "refs": [
        "guard:b2->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Guard and action correctly model the non-compliant branch and subsequent checks."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Compliant path and convergence point represent the continuation flow for compliant invoices."
    },
    {
      "refs": [
        "guard:b3->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Branch and guard model the phone resolution condition; action captures the resolution step."
    },
    {
      "refs": [
        "guard:b3->n6"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Guard and action model the mail-back branch. The source redundantly states this twice; the model covers it once, preserving behaviour."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Guard and action model the mail-back branch. The source redundantly states this twice; the model covers it once, preserving behaviour."
    },
    {
      "refs": [
        "action:n7",
        "guard:b_pay->n8",
        "guard:b_pay->c3",
        "action:n8"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Convergence gathers previous paths, followed by payment action, branch checking return status, and respective resolution/continuation guards and action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "AND gateway and client billing action correctly model the simultaneous parallel workflow."
    },
    {
      "refs": [
        "guard:b_resp->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Branch and guard handle the no-response condition, leading to the waiting action."
    },
    {
      "refs": [
        "guard:b_resp->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the invoice is returned, non-compliance is resolved."
      ],
      "justification": "Guard and action capture the returned invoice path and its resolution."
    },
    {
      "refs": [
        "guard:b_resp->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Guard and action model the successful payment and notification path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Action and end node directly correspond to the final reminder and process termination."
    },
    {
      "refs": [
        "guard:b_sat->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Branch, guard, and action correctly model the unsatisfied client condition and discrepancy resolution."
    },
    {
      "refs": [
        "guard:b_sat->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Guard, action, and convergence point represent the satisfied client path flowing onward."
    }
  ],
