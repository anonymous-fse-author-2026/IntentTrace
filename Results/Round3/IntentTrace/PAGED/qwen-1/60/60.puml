@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:click: Start;
:select: Edit Report;
:is expense > 1000?;
:v1: expense amount ({[0-]}); <<objectSignal>>
if () then ([v1 > 1000])
:review report;
else ([v1 <= 1000])
:check translation need;
:v2: translation need ({Required, Not Required}); <<objectSignal>>
if () then ([v2 = 'Required'])
:translate receipts;
else ([v2 = 'Not Required'])
:confirm receipts;
endif
endif
:evaluate review decision;
:v3: review decision ({Rejected, Approved}); <<objectSignal>>
if () then ([v3 = 'Rejected'])
:edit report;
else ([v3 = 'Approved'])
:check translation need again;
:v4: second review decision ({Approved, Rejected}); <<objectSignal>>
if () then ([v4 = 'Approved'])
:translate receipts again;
:evaluate receipt decision;
:v5: receipt decision ({Accepted, Rejected}); <<objectSignal>>
if () then ([v5 = 'Accepted'])
:process expense;
:end;
else ([v5 = 'Rejected'])
:edit report;
endif
else ([v4 = 'Rejected'])
:edit report;
endif
endif
stop
@enduml