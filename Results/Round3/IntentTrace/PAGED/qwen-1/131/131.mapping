{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am"
      ],
      "justification": "Init node marks process start; action captures the initial step and timing condition."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then empty the mailbox."
      ],
      "justification": "Direct correspondence to the second sequential step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty,"
      ],
      "justification": "Action models the verification; branch prepares for the conditional split."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if not, continue the process."
      ],
      "justification": "Guard routes the negative outcome (not empty) to continuation."
    },
    {
      "refs": [
        "guard:b1->e1"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Guard routes the positive outcome (empty) directly to the termination node."
    },
    {
      "refs": [
        "action:n4",
        "guard:b6->n5",
        "guard:b6->e1"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again, if not, continue the process. If it is empty, the process ends."
      ],
      "justification": "Repeats the check logic with identical branching and routing semantics."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Direct match for the completeness verification step."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Branch opens the decision; guard routes the complete case forward."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Positive arm action matches the recording instruction."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Guard routes the incomplete case to the corrective action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Negative arm action matches the phone call instruction."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Action covers post-call data completion; converge merges the split flows."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Direct match for the scheduled transport task."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member,"
      ],
      "justification": "Models the membership eligibility check and routes the positive outcome."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Positive arm action matches the stamping and dating instruction."
    },
    {
      "refs": [
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Guard routes the negative outcome to the rejection notification."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Negative arm action matches the notification instruction."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Direct match for the subsequent data recording step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "calculate the fee"
      ],
      "justification": "AND gateway and convergence model the simultaneous execution context; action captures fee calculation."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "hand the letter to Charles."
      ],
      "justification": "Parallel action matches the instruction to pass the letter."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Direct match for the delegation step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Direct match for card printing and distribution."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Terminal node corresponds to the explicit end statement."
    }
  ],
