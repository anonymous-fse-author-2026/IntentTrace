    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If the option to submit is set to \"true\", then continue with the process."
      ],
      "justification": "The negative/complementary arm of the first branch. Routing through a convergence node structurally represents 'continuing with the process' without altering behaviour."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Additionally, check if there is another filter to apply."
      ],
      "justification": "Second conditional check modeled as an action plus explicit branch, preserving the decision logic."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If there is, continue with the process."
      ],
      "justification": "Positive outcome of the second check. Guard 'yes' semantically aligns with 'If there is', directing flow forward as described."
    },
    {
      "refs": [
        "guard:b2->e1"
      ],
      "verbatim_texts": [
        "If not, continue with the process."
      ],
      "justification": "Negative outcome of the second check. Routing to the end node aligns with process completion described later, preserving overall termination behaviour."
    },
    {
      "refs": [
        "action:n8",
