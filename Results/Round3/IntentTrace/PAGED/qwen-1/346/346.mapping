{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "Captures process initiation and the first sending step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Direct match for the approval reception step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Direct match for contacting TS."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Matches the initial approval checking step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Covers the redundant mention of checking approval later in the text. Redundancy preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized."
      ],
      "justification": "Models the XOR split and the internal-resource authorization path."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Models the external-resource authorization path."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized.",
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Rejoins the two resource-type branches after authorization."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Direct match for sending documentation to HR."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Covers the redundant restatement of sending documents to HR. Behaviour is preserved."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Direct match for scanning and recording the form."
    },
    {
      "refs": [
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Models the XOR split and the no-variations continuation path."
    },
    {
      "refs": [
        "guard:b2->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed."
      ],
      "justification": "Models the variations path requiring a business case."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues.",
        "However, if there are variations, a business case is completed.",
        "If there are no variations, the process continues. However, if there are variations, a business case is completed and attached."
      ],
      "justification": "Rejoins the variation branches. Covers the combined announcement phrase as well."
    },
    {
      "refs": [
        "action:n13",
        "action:n20"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Captures final receipt, explicit end description, and terminal node."
    }
