      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The opening unit implicitly starts the process and describes the first two steps. Splitting into a generic start and receive action preserves behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "create the claim and record it"
      ],
      "justification": "Direct paraphrase of the creation and recording step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "make a decision on the claim"
      ],
      "justification": "Captures the decision point and correctly opens the XOR gateway for the subsequent accept/reject paths."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "Guard correctly models the rejection condition; action matches the rejection step."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the claim is to be accepted, offer the benefit"
      ],
      "justification": "Guard correctly models the acceptance condition; action matches the benefit offer step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "review the claim rejection"
      ],
      "justification": "Direct match for the review step on the rejection path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "prepare the claim discharge"
      ],
      "justification": "Direct match for the discharge preparation step on the acceptance path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "record the benefit payment"
      ],
      "justification": "Direct match for recording the payment after discharge preparation."
    },
    {
      "refs": [
        "guard:b3->n_ra",
        "action:n_ra",
        "guard:b3->n_rna",
        "action:n_rna"
      ],
      "verbatim_texts": [
        "if the claim rejection is not accepted"
      ],
      "justification": "Models the split after rejection review. Conditions are represented as guards/state-actions. Re-typing and variable abstraction preserve the decision logic."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Both acceptance and non-acceptance paths converge here before continuing, exactly as described."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Models the termination path. Using a conditional branch/guard for the end state is a harmless modeling choice that preserves flow."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "operate outgoing payment and close the claim"
      ],
      "justification": "Captures the concurrent final steps. Modeling them as a parallel branch path converging back maintains the required behaviour."
    }
