init(i1)
action(n1, "start")
action(n2, "receive claim")
action(n3, "create and record the claim")
action(n4, "make a decision on the claim")
branch(b1, XOR)
action(n5, "reject the claim")
action(n6, "review the claim rejection")
action(n_ra, "rejection accepted")
action(n_rna, "rejection not accepted")
branch(b3, XOR)
converge(c2)
action(n7, "continue the process")
action(n8, "offer the benefit")
action(n9, "prepare the claim discharge")
action(n10, "record the benefit payment")
action(n11, "operate outgoing payment")
action(n12, "close the claim")
action(n13, "end of process")
end(e1)
converge(c1)
branch(b2, XOR)
defines(v1, "make a decision on the claim", {"Rejected", "Accepted"})
defines(v_rej, "rejection status", {"Accepted", "Not Accepted"})
defines(v2, "final outcome", {"End", "Payment"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, n6, n_ra, n_rna, b3, c2, n7, n8, n9, n10, c1, b2, n11, n12, n13, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, b3)
precedence(b3, n_ra)
precedence(b3, n_rna)
precedence(n_ra, c2)
precedence(n_rna, c2)
precedence(c2, n7)
precedence(b1, n8)
precedence(n8, n9)
precedence(n9, n10)
precedence(n7, c1)
precedence(n10, c1)
precedence(c1, b2)
precedence(b2, n13)
precedence(b2, n11)
precedence(n11, n12)
precedence(n13, e1)
precedence(n12, e1)
guard(b1, n5, v1 = 'Rejected')
guard(b1, n8, v1 = 'Accepted')
guard(b3, n_ra, v_rej = 'Accepted')
guard(b3, n_rna, v_rej = 'Not Accepted')
guard(b2, n13, v2 = 'End')
guard(b2, n11, v2 = 'Payment')