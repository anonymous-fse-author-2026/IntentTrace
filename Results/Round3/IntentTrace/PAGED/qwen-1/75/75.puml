@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:receive claim;
:create and record the claim;
:make a decision on the claim;
:v1: make a decision on the claim ({Rejected, Accepted}); <<objectSignal>>
if () then ([v1 = 'Rejected'])
:reject the claim;
:review the claim rejection;
:v_rej: rejection status ({Accepted, Not Accepted}); <<objectSignal>>
if () then ([v_rej = 'Accepted'])
:rejection accepted;
else ([v_rej = 'Not Accepted'])
:rejection not accepted;
endif
:continue the process;
else ([v1 = 'Accepted'])
:offer the benefit;
:prepare the claim discharge;
:record the benefit payment;
endif
:v2: final outcome ({End, Payment}); <<objectSignal>>
if () then ([v2 = 'Payment'])
:operate outgoing payment;
:close the claim;
else ([v2 = 'End'])
:end of process;
endif
stop
@enduml