      ],
      "verbatim_texts": [
        "To begin the process in the Admin Office, first check if it has started."
      ],
      "justification": "Captures the start of the process and the initial check described in the opening unit."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "verify the completeness of the invoices."
      ],
      "justification": "Directly corresponds to the verification step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they are marked as \"Uncompleted\", they should be returned to the client through postal mail."
      ],
      "justification": "Models the decision point and the negative arm correctly, preserving the threshold/value ('Uncompleted') and the resulting action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if they are marked as \"Completed\", the process should be continued."
      ],
      "justification": "Correctly captures the positive arm of the decision with the matching value ('Completed') and continuation step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoices are still marked as \"Uncompleted\", they should be returned to the client via postal mail."
      ],
      "justification": "The conditional check is modeled as an action step ('are invoices still marked uncompleted'), which preserves behaviour per relaxed matching rules. The actual return action is covered by n5 from the prior equivalent branch."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the invoices are returned to the client, receive the completed ones."
      ],
      "justification": "Directly corresponds to receiving the completed invoices after return."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "mark the relevant box on the invoice entry form"
      ],
      "justification": "Exact paraphrase of the marking step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "proceed with checking if the process has been completed."
      ],
      "justification": "Condition/check modeled as an action step, preserving behaviour."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Captures the terminal action and structural end/convergence points corresponding to the final statement."
    }
