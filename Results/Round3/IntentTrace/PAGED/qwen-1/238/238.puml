@startuml
!theme plain
|a_default| Default
|a_default|
start
:Place Order;
:Check Customers Credit Limit;
:v1: Credit Limit Okay ({Okay, No}); <<objectSignal>>
if () then ([v1 = 'Okay'])
:Check Availability Of Article;
:v5: Second Availability Check ({Okay, No}); <<objectSignal>>
if () then ([v5 = 'Okay'])
:Check Availability Again;
:v2: Article Available ({No, Yes}); <<objectSignal>>
if () then ([v2 = 'No'])
:Produce the Goods;
else ([v2 = 'Yes'])
:Collect the Goods;
endif
:Send Order Confirmation;
split
:Ship the Goods;
split again
:Send Invoice;
end split
:Check Payment Status;
:v3: Payment Received ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:Close the Order;
stop
else ([v3 = 'No'])
:Reminder Count Ge 3;
:v4: Reminder Count Ge 3 ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:Write Off the Order;
:Send Reminder;
:Close the Order;
else ([v4 = 'No'])
->;
endif
stop
endif
else ([v5 = 'No'])
->;
endif
else ([v1 = 'No'])
->;
endif
:Send Denial To Customer;
stop
@enduml