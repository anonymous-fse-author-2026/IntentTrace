      "verbatim_texts": [
        "For the supplier, the first step is to pick up the order."
      ],
      "justification": "Implicitly starts the process and directly models the first action step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "request a stock check"
