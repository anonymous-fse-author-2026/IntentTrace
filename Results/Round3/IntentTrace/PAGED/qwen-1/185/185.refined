defines(v1, "check completeness of the invoice", {'complete', 'incomplete'})
defines(v2, "check priority", {'high', 'low'})
defines(v3, "compliance decision", {'experienced_staff', 'normal_case', 'none_apply'})
defines(v4, "compliance completeness", {'complete', 'not_complete'})
