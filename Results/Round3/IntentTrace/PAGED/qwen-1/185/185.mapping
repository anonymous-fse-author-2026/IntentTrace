{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "Initiates the process and describes the first receiving step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "it is sorted per client"
      ],
      "justification": "Direct paraphrase of the sorting step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor"
      ],
      "justification": "Direct paraphrase of the second sorting step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked"
      ],
      "justification": "Describes the checking step and introduces the subsequent decision point."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Captures the negative condition, the resulting action label, and the process termination."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered."
      ],
      "justification": "Captures the positive condition, the resulting state label, and the SLA entry action."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "guard:b2->n12",
        "guard:b2->n13"
      ],
      "verbatim_texts": [
        "The date for completion is also entered and the priority is checked."
      ],
      "justification": "Maps the two sequential actions and the priority check split with its guards."
    },
    {
      "refs": [
        "action:n12",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "Maps the high-priority branch condition state and the stamping action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Maps the low-priority branch condition state."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->n25",
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Maps the compliance check action and its associated branching logic and guards."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "If it is not complete, the check continues."
      ],
      "justification": "Maps the incomplete compliance branch outcome."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is complete, the process continues."
      ],
      "justification": "Maps the complete compliance branch outcome."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Maps the first post-compliance conditional branch and its processing action."
    },
    {
      "refs": [
        "guard:b3->n19",
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Maps the second post-compliance conditional branch and the client call action."
    },
    {
      "refs": [
        "guard:b3->n21",
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Maps the fallback condition, mailing action, and process termination."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Maps the final client call action and the convergence points from the preceding branches."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO, and the process ends."
      ],
      "justification": "Maps the final batching/allocation action and the final process termination."
    }
  ],
