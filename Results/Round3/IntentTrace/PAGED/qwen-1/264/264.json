  "input_elements": [
    {
      "id": "i1",
      "content": "Initially, the appointment approval form is sent."
    },
    {
      "id": "i2",
      "content": "After that, the approval is received."
    },
    {
      "id": "i3",
      "content": "Following the approval, there is a contact with TS to clarify the timing."
    },
    {
      "id": "i4",
      "content": "Once the approval is received, it is checked."
    },
    {
      "id": "i5",
      "content": "If the resource is internal, the appointment is authorized."
    },
    {
      "id": "i6",
      "content": "If the resource is external, the appointment is also authorized."
    },
    {
      "id": "i7",
      "content": "After the approval, the mandatory documentation along with the approval is sent to HR services."
    },
    {
      "id": "i8",
      "content": "The form is then scanned and recorded into the GovSource system."
    },
    {
      "id": "i9",
      "content": "The approval is checked and then sent along with the mandatory documentation to HR services."
    },
    {
      "id": "i10",
      "content": "HR services receive the documentations and this marks the end of the process."
    },
    {
      "id": "i11",
      "content": "If there are no variations, the process continues."
    },
    {
      "id": "i12",
      "content": "However, if there are variations, a business case is completed."
    },
    {
      "id": "i13",
      "content": "However, if there are variations, a business case is completed and attached."
    }
  ]
