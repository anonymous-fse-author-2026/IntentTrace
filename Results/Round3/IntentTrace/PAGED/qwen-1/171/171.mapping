    {
      "refs": [
        "guard:b1->rejoin"
      ],
      "verbatim_texts": [
        "If the request is not approved"
      ],
      "justification": "Guard captures the negative condition; converge is structural plumbing that joins the feedback loops returning to the start."
    },
    {
      "refs": [
        "guard:b2->rejoin"
      ],
      "verbatim_texts": [
        "If it is not approved"
