action(n13, "assign roles in the team")
action(n14, "continue with the process and perform work according to your assigned role")
action(n15, "check the progress and consult any problems that arise")
action(n16, "is the project accepted")
branch(b1, XOR)
action(n17, "present it")
action(n18, "continue working according to your role")
converge(c1)
action(n19, "is the project accepted again")
branch(b2, XOR)
action(n20, "finally present the project and the process will come to an end")
action(n21, "continue working according to your role")
end(e1)
defines(v1, "project accepted first check", {"Yes", "No"})
defines(v2, "project accepted second check", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, n16, b1, n17, n18, c1, n19, b2, n20, n21, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, n5)
precedence(n5, n6)
precedence(n6, n7)
