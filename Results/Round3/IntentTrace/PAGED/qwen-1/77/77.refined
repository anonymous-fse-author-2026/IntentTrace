init(i1)
action(n1, "join the team and agree on the team's domain")
action(n2, "create a process model and check it")
action(n3, "is the process model NOT OK")
action(n4, "assign negative points")
action(n5, "is the process model still NOT OK")
action(n6, "assign negative points again")
action(n7, "can continue with the process")
action(n8, "are there any issues")
