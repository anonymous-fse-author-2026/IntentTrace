init(i1)
action(n2, "Passengers undergo immigration checks")
action(n3, "Select method for exit control checks: Biometrics or ID documents?")
branch(b1, XOR)
action(n4, "Undergo biometric check")
branch(b2, XOR)
action(n14, "After the exit control checks, if the passenger is denied permission, they should leave the area.")
action(n15, "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends.")
end(e1)
action(n16, "On the other hand, if the passenger is allowed to continue, they should proceed to the next step.")
action(n17, "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends.")
end(e2)
action(n5, "Check using identity documents")
branch(b3, XOR)
action(n18, "After the exit control checks, if the passenger is denied permission, they should leave the area.")
action(n19, "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends.")
end(e3)
action(n20, "On the other hand, if the passenger is allowed to continue, they should proceed to the next step.")
action(n21, "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends.")
end(e4)
defines(v1, "Select method for exit control checks: Biometrics or ID documents?", {'Biometrics', 'ID documents'})
defines(v2, "Is permission denied after biometric check?", {'Yes', 'No'})
defines(v3, "Is permission denied after ID document check?", {'Yes', 'No'})
actor(a_default, "Default", [i1, n2, n3, b1, n4, n5, b2, b3, n14, n15, e1, n16, n17, e2, n18, n19, e3, n20, n21, e4])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, b2)
precedence(n5, b3)
precedence(b2, n14)
precedence(n14, n15)
precedence(n15, e1)
precedence(b2, n16)
precedence(n16, n17)
precedence(n17, e2)
precedence(b3, n18)
precedence(n18, n19)
precedence(n19, e3)
precedence(b3, n20)
precedence(n20, n21)
precedence(n21, e4)
guard(b1, n4, v1 = 'Biometrics')
guard(b1, n5, v1 = 'ID documents')
guard(b2, n14, v2 = 'Yes')
guard(b2, n16, v2 = 'No')
guard(b3, n18, v3 = 'Yes')
guard(b3, n20, v3 = 'No')