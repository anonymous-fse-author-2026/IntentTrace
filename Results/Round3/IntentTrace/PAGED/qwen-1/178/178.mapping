      "verbatim_texts": [
        "Initially, if the answer is \"no\", then proceed with the acquisition of the pricing."
      ],
      "justification": "Captures the process start, first decision split, negative condition, and the corresponding pricing acquisition step."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "However, if the answer is \"yes\", then continue with the process."
      ],
      "justification": "Captures the positive condition for the first split and the structural convergence that resumes the main flow."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the answer is \"no\" again, then acquire the pricing."
      ],
      "justification": "Captures the second decision split, its negative condition, and the repeated pricing acquisition action."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "On the other hand, if the answer is \"yes\" once more, then continue with the process."
      ],
      "justification": "Captures the positive condition for the second split and the structural convergence that resumes the main flow."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After the margin calculation, the next step is the preparation of the offer."
      ],
      "justification": "Directly corresponds to the sequential steps of calculating the margin and preparing the offer."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the offer is prepared, the transport rate is calculated, and the process comes to an end."
      ],
      "justification": "Matches the final calculation step and the process termination. The redundant end action does not alter behaviour."
    }
