{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "Process initiation and the first action align with the opening instruction."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, proceed with the Registration gross pathology request."
      ],
      "justification": "Directly matches the registration step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During the \"Registration gross pathology request\" step, make sure to create a barcode scan at the start."
      ],
      "justification": "Captures the mandatory barcode scan during registration."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the registration is complete, assign a container to the gross pathology request."
      ],
      "justification": "Directly matches the container assignment step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After assigning a container, move on to the Specimen description."
      ],
      "justification": "Directly matches the specimen description step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "For the \"Specimen description\" step, pay attention to the scan start."
      ],
      "justification": "Maps to the first scan checkpoint."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Then, pay attention to the scan end."
      ],
      "justification": "Maps to the second scan checkpoint."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Finally, pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Maps to the third scan checkpoint."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Following that, proceed with Macroscopic description writing."
      ],
      "justification": "Directly matches the macroscopic writing step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Tissue processing, check if \"Digitalization?\" is required."
      ],
      "justification": "Covers tissue processing, the first digitalization check, and the resulting XOR split."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process."
      ],
      "justification": "Guard captures the negative outcome leading directly back to the main flow via convergence."
    },
    {
      "refs": [
        "guard:b1->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Guard and action accurately model the positive outcome and subsequent digitalization step."
    },
    {
      "refs": [
        "action:n14",
        "guard:b2->n16",
        "action:n16",
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "Next, check if \"Digitalization?\" is required again."
      ],
      "justification": "Models the repeated check and its implied conditional branching. Structuring it as a decision preserves the intended control flow."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "After that, assign cases to the pathologist and then move on to Microscopic examination and diagnosis."
      ],
      "justification": "Two actions correspond to the two consecutive steps listed in the unit."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the microscopic examination and diagnosis are complete, write the pathology report."
      ],
      "justification": "Directly matches the report writing step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "After writing the report, confirm it."
      ],
      "justification": "Directly matches the confirmation step."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the pathology report is confirmed, deliver it."
      ],
      "justification": "Directly matches the report delivery step."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Then, proceed with the post-report processing."
      ],
      "justification": "Directly matches the post-processing step."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "To conclude the pathology procedure, close it."
      ],
      "justification": "Directly matches the closure step."
    },
    {
      "refs": [
        "action:n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, deliver the pathology report and complete the post-report processing."
      ],
      "justification": "Final delivery/completion action, explicit End marker, and structural termination all align with the process conclusion."
    }
  ],
