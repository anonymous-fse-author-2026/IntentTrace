{
  "matches": [
    {
      "refs": [
        "action:n_check_order"
      ],
      "verbatim_texts": [
        "To begin the process, start by checking the customer's order."
      ],
      "justification": "Initializes the process and performs the first action."
    },
    {
      "refs": [
        "guard:b_cust->n_check_morale",
        "action:n_check_morale"
      ],
      "verbatim_texts": [
        "If the customer is a registered customer, then check their payment morale."
      ],
      "justification": "Splits flow by customer type and executes the registered customer path."
    },
    {
      "refs": [
        "guard:b_cust->n_check_status",
        "action:n_check_status"
      ],
      "verbatim_texts": [
        "If they are a new customer, then check their status."
      ],
      "justification": "Executes the new customer path and checks status."
    },
    {
      "refs": [
        "guard:b_cust->n_whole_data"
      ],
      "verbatim_texts": [
        "If the customer is a wholesaler,"
      ],
      "justification": "Handles the wholesaler condition and combines it with the corresponding action."
    },
    {
      "refs": [
        "action:n_whole_data"
      ],
      "verbatim_texts": [
        "enter their data and take the order."
      ],
      "justification": "Handles the wholesaler condition and combines it with the corresponding action."
    },
    {
      "refs": [
        "guard:b_morale->c_continue"
      ],
      "verbatim_texts": [
        "If their payment morale is good, continue with the process."
      ],
      "justification": "Routes good morale cases to the main continuation flow."
    },
    {
      "refs": [
        "guard:b_morale->c_reject",
        "action:n_reject"
      ],
      "verbatim_texts": [
        "If their payment morale is bad or if they are an end customer, reject the order and end the process."
      ],
      "justification": "Captures bad morale rejection path, merging it with status-based rejection and terminating."
    },
    {
      "refs": [
        "guard:b_status->c_continue"
      ],
      "verbatim_texts": [
        "If they are a new customer, then check their status.",
        "If their payment morale is good, continue with the process."
      ],
      "justification": "Evaluates customer status; non-end-customers implicitly continue the process, preserving behaviour."
    },
    {
      "refs": [
        "guard:b_status->c_reject"
      ],
      "verbatim_texts": [
        "If their payment morale is bad or if they are an end customer, reject the order and end the process."
      ],
      "justification": "Routes end customers to the rejection flow, matching the OR condition in the source."
    },
    {
      "refs": [
        "action:n_check_avail"
      ],
      "verbatim_texts": [
        "check the availability of the items."
      ],
      "justification": "Checks stock availability and prepares the subsequent split."
    },
    {
      "refs": [
        "guard:b_avail->n_out_stock",
        "action:n_out_stock"
      ],
      "verbatim_texts": [
        "If the items are out of stock, start production."
      ],
      "justification": "Out-of-stock path triggers production start."
    },
    {
      "refs": [
        "guard:b_avail->n_in_stock",
        "action:n_in_stock"
      ],
      "verbatim_texts": [
        "If they are in stock, continue with the process."
      ],
      "justification": "In-stock path models continuation; re-typing a condition as an action is behaviour-preserving."
    },
    {
      "refs": [
        "action:n_produce"
      ],
      "verbatim_texts": [
        "Once the availability is checked, send the order confirmation."
      ],
      "justification": "Joins both inventory paths, covers producing articles, and sends confirmation as required."
    },
    {
      "refs": [
        "action:n_conf"
      ],
      "verbatim_texts": [
        "produce the article and send the order confirmation."
      ],
      "justification": "Joins both inventory paths, covers producing articles, and sends confirmation as required."
    },
    {
      "refs": [
        "action:n_inv_del"
      ],
      "verbatim_texts": [
        "send the invoice and deliver the product."
      ],
      "justification": "Directly matches invoice and delivery step."
    },
    {
      "refs": [
        "action:n_check_pay"
      ],
      "verbatim_texts": [
        "Check the payment status."
      ],
      "justification": "Checks payment and prepares the payment decision split."
    },
    {
      "refs": [
        "guard:b_pay->n_close",
        "action:n_close"
      ],
      "verbatim_texts": [
        "If payment is received, close the order."
      ],
      "justification": "Payment received closes order and terminates successfully."
    },
    {
      "refs": [
        "guard:b_pay->n_check_rem",
        "action:n_check_rem"
      ],
      "verbatim_texts": [
        "If no payment is received, check the number of reminders."
      ],
      "justification": "Handles unpaid cases by checking reminder count and branching accordingly."
    },
    {
      "refs": [
        "guard:b_rem->n_engage_lawyer",
        "action:n_engage_lawyer"
      ],
      "verbatim_texts": [
        "If there are more than three reminders, engage a lawyer."
      ],
      "justification": "Correct threshold (>3) leads to lawyer engagement and termination."
    },
    {
      "refs": [
        "guard:b_rem->n_send_reminder",
        "action:n_send_reminder"
      ],
      "verbatim_texts": [
        "If there are three or fewer reminders, send a reminder."
      ],
      "justification": "Correct threshold (<=3) leads to sending a reminder and termination."
    }
  ],
