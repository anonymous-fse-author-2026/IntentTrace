{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Captures the process initiation and the first two sequential steps (billing for goods/services and receiving the invoice)."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5",
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned. However, if the invoice is complete, the process continues."
      ],
      "justification": "Models the completeness check, returning incomplete invoices (modeled as an action/end path), and continuing for complete ones. Guards abstract the condition to Yes/No without altering behavior."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->b2b",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted. On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Represents the compliance decision point, splitting into non-compliant (to further checks) and compliant (to convergence/continuation) paths."
    },
    {
      "refs": [
        "guard:b2b->n8",
        "action:n8",
        "guard:b2b->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved. But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Handles the sub-decision for non-compliant invoices, branching correctly into phone resolution or mail return."
    },
    {
      "refs": [
        "guard:b4->n10",
        "action:n10",
        "guard:b4->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved. Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Covers the payment and simultaneous client billing steps. Modeled as a split branch preserving the dual-action behavior described."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Directly corresponds to the waiting period action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Matches the notification step following payment."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Captures the reminder action and the subsequent process termination."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12",
        "guard:b3->e4"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved. However, if the client is satisfied, the process continues."
      ],
      "justification": "Models the final client satisfaction check, branching to dispute resolution if unsatisfied or proceeding/ending if satisfied."
    }
  ],
