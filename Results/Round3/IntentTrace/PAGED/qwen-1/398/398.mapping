    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "To start, please provide the userdata for flickr."
      ],
      "justification": "The start node and initial action directly correspond to the opening instruction."
    },
    {
      "refs": [
        "guard:b1->i2",
        "action:i2"
      ],
      "verbatim_texts": [
        "If the login is successful, the process will end."
      ],
      "justification": "The XOR split, positive guard, corresponding action, and end node collectively model the successful login path and termination."
    },
    {
      "refs": [
        "guard:b1->i3",
        "action:i3"
      ],
      "verbatim_texts": [
        "However, if the login fails, we will continue with the process."
      ],
      "justification": "Models the negative outcome that directs flow to the continuation/retry stage."
    },
    {
      "refs": [
        "guard:b2->i4",
        "action:i4"
      ],
      "verbatim_texts": [
        "If you want to try again, please provide the userdata for flickr."
      ],
      "justification": "Captures the second decision point and the retry action."
    },
    {
      "refs": [
        "guard:b2->i5",
        "action:i5"
      ],
      "verbatim_texts": [
        "On the other hand, if you choose to abort, the process will end."
      ],
      "justification": "Models the abort branch, action, and final termination point."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "However, if the login fails, we will continue with the process."
      ],
      "justification": "Structural convergence and abstract guard handle the implicit loop-back to retry; behaviour-preserving plumbing."
    }
