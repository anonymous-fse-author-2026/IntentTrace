  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, ask the 1st Level Support if there is an issue."
      ],
      "justification": "Structural start node and first action directly correspond to the opening instruction."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the issue is resolved, provide feedback for the account manager."
      ],
      "justification": "Models the first decision point; the guard abstracts 'resolved' to a boolean true, and the action matches the positive branch outcome."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is a 1st Level issue, ask the developer for assistance."
      ],
      "justification": "Captures the negative/default branch of the first decision (boolean false) and the corresponding escalation step."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "Then, check the result again. If the issue is resolved, provide feedback for the account manager."
      ],
      "justification": "Sequentially models the re-evaluation step, opens the second decision split, and handles the positive branch with matching guard and action."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is still a 1st Level issue, ask the developer for help."
      ],
      "justification": "Captures the negative branch of the second decision and the corresponding follow-up action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Ask the developer and then provide feedback for the 1st Level support."
      ],
      "justification": "Exact restatement of the subsequent procedural step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, provide feedback for the 1st Level support and then provide feedback for the account manager."
      ],
      "justification": "Final feedback actions combined with the structural end node faithfully complete the described workflow."
    }
  ],
