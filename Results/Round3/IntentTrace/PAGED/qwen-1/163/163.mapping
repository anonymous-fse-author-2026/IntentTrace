{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "The init node marks the process trigger described in the opening clause, while the action node faithfully restates the metadata entry step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed to the IN-Patient step."
      ],
      "justification": "Direct paraphrase of proceeding to the IN-Patient step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: send data to suppliers"
      ],
      "justification": "The AND branch structurally models the simultaneous ('at the same time') execution, and the action captures sending data to suppliers."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "and create a claim."
      ],
      "justification": "Captures the claim creation step mentioned alongside the parallel tasks."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the data is sent to suppliers, extract the data from the suppliers and transfer it to the doctor's phone."
      ],
      "justification": "Splits the source sentence into two sequential actions: extracting supplier data and transferring it to the doctor's phone. Preserves behaviour."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, confirm the GOP and the process will come to an end."
      ],
      "justification": "Models the GOP confirmation as an action, adds a procedural wrap-up step, and correctly terminates this flow path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "handle the claim."
      ],
      "justification": "Direct match for handling the claim."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "handle the claim accordingly."
      ],
      "justification": "Redundant restatement of claim handling. Does not alter behaviour, so treated as a match."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status."
      ],
      "justification": "Correctly splits the extraction and subsequent record-entry/status-confirmation into two aligned actions."
    },
    {
      "refs": [
        "action:n18",
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "Register the case, handle the claim, and then receive the payment."
      ],
      "justification": "Sequentially models case registration, claim handling, and payment receipt as described."
    },
    {
      "refs": [
        "action:n27",
        "action:n22"
      ],
      "verbatim_texts": [
        "Enter the data on the patient's record or confirm the IN-Patient status, and then send the data back to the suppliers."
      ],
      "justification": "Accurately captures the record entry/status confirmation followed by sending data back to suppliers."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, receive the payment and conclude the process."
      ],
      "justification": "Maps the final payment receipt and process conclusion to the corresponding action and end node."
    }
  ],
