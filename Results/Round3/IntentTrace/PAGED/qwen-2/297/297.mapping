{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "Covers process initiation and the first two steps. Paraphrasing and node splitting preserve behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if not, continue the process."
      ],
      "justification": "Models the negative branch and continuation step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Models the positive branch, termination action, and endpoint."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Models the positive branch and recording step."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Models the negative branch and call step."
    },
    {
      "refs": [
        "action:n12",
        "label:n11->n12"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Label captures timing; action captures the completion step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member,"
      ],
      "justification": "Models the positive decision path."
    },
    {
      "refs": [
        "guard:b4->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member,"
      ],
      "justification": "Models the negative decision path."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "write to them and inform them of the decision."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "stamp 'new Member' on the letter and write the date on it."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "write the data."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles. Ask Charles to write the amount in the register."
      ],
      "justification": "AND gateway and converges model the simultaneous execution; actions cover fee calculation and register updates."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "add the new member to the register."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Prepare an invoice for the new members"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n22",
        "action:n25"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Captures all termination points described in the text."
    }
