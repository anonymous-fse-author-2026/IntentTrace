  "input_elements": [
    {
      "id": "i1",
      "content": "The process starts with BUSINESS PROCESS REQUIREMENTS"
    },
    {
      "id": "i2",
      "content": "followed by SAP Configuration."
    },
    {
      "id": "i3",
      "content": "After that, it moves on to Communications Design."
    },
    {
      "id": "i4",
      "content": "Then, it proceeds to Learning Design."
    },
    {
      "id": "i5",
      "content": "Next, it involves Data Conversion Design & Test."
    },
    {
      "id": "i7",
      "content": "Once the SAP Configuration is completed, it moves on to IT Design, Development & Functional Test."
    },
    {
      "id": "i9",
      "content": "Similarly, after Communications Design, it moves on to Communications Deployment."
    },
    {
      "id": "i11",
      "content": "After Learning Design, it proceeds to Learning Deployment."
    },
    {
      "id": "i12",
      "content": "Following Data Conversion Design & Test"
    },
    {
      "id": "i13",
      "content": "Following Data Conversion Design & Test, it moves on to Integration Test. Once IT Design, Development & Functional Test is completed, it proceeds to Integration Test."
    },
    {
      "id": "i15",
      "content": "Once IT Design, Development & Functional Test is completed"
    },
    {
      "id": "i17",
      "content": "After Communications Deployment"
    },
    {
      "id": "i18",
      "content": "After Communications Deployment, it moves on to Deployment. Similarly, after Learning Deployment, it proceeds to Deployment. Following Integration Test, it moves on to Deployment."
    },
    {
      "id": "i20",
      "content": "Similarly, after Learning Deployment"
    },
    {
      "id": "i22",
      "content": "Following Integration Test"
    },
    {
      "id": "i23",
      "content": "it enters the PRODUCTION SUPPORT phase"
    },
    {
      "id": "i24",
      "content": "and the process comes to an end."
    }
  ]
