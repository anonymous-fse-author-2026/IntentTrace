  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "the process begins with receiving an order request."
      ],
      "justification": "Covers the process start and the initial reception step. 'start process' is harmless structural redundancy."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, the order is registered and evaluated."
      ],
      "justification": "Splits the compound registration and evaluation phrase into two sequential actions, preserving behaviour."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If the evaluation result is \"NOK\""
      ],
      "justification": "Correctly models the XOR split on evaluation result with matching guards ('NOK' and 'ok')."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the evaluation result is \"ok\", then the installation process takes place."
      ],
      "justification": "Correctly models the XOR split on evaluation result with matching guards ('NOK' and 'ok')."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then the order is considered as \"NOK\" and the process comes to an end."
      ],
      "justification": "Captures the negative evaluation outcome and process termination."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the evaluation result is \"ok\", then the installation process takes place."
      ],
      "justification": "Models the installation step triggered by a positive evaluation."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the installation is not successful"
      ],
      "justification": "Models the second XOR split on installation outcome. Guards use 'No'/'Yes' which are semantically equivalent to 'not successful'/'successful'."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "However, if the installation is successful, the next step is to check the installation."
      ],
      "justification": "Models the second XOR split on installation outcome. Guards use 'No'/'Yes' which are semantically equivalent to 'not successful'/'successful'."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if the installation is successful, the next step is to check the installation."
      ],
      "justification": "Direct match for the installation verification step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the installation is verified, the billing is prepared."
      ],
      "justification": "Direct match for the billing preparation step."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, if everything is in order, the order is marked as \"ok\" and the process is completed."
      ],
      "justification": "Preserves the final conditional check, marking step, and termination. Modeling the condition as an action ('everything in order') is an acceptable re-typing that does not change behaviour."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "then the order is considered as \"NOK\" and the process comes to an end.",
        "If the installation is not successful"
      ],
      "justification": "Structural plumbing that joins the two failure paths before termination. Preserves the overall flow without altering behaviour."
    }
