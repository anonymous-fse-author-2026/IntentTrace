        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Initiates the process and performs the first step of identifying the vacancy."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "Models the first decision point and its negative branch leading to advertising."
    },
    {
      "refs": [
        "guard:b1->c2"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available",
        "if there is a suitable candidate available"
      ],
      "justification": "Captures the positive condition for the first decision, allowing flow to continue."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then continue with the process. If there is still no suitable candidate available"
      ],
      "justification": "Bridges the positive path to the second availability check, modeling the implicit re-evaluation."
    },
    {
      "refs": [
        "guard:b3->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "Models the second decision's negative branch and the repeated advertising step."
    },
    {
      "refs": [
        "guard:b3->n7"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available"
      ],
      "justification": "Captures the positive condition for the second decision."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "then proceed with selecting the appropriate applicant."
      ],
      "justification": "Performs the selection step following a successful second check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed"
      ],
      "justification": "Executes the appointment step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Explicitly terminates the process flow."
    }
  ],
