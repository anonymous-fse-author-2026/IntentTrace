      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "Start node and initial action correspond directly to the opening instruction."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "checking the Inventory Level. If the \"Inventory level is at or below the minimum\""
      ],
      "justification": "Condition modeled as an action step, which preserves behaviour per relaxed guidelines."
    },
    {
      "refs": [
        "guard:b1->n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "\"Inventory level is at or below the minimum\""
      ],
      "justification": "Branch and guards capture the decision logic. Abstract Yes/No values correctly split the positive and negative paths."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then proceed to Create Purchase Order."
      ],
      "justification": "Direct match to the positive outcome action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process ends."
      ],
      "justification": "Termination action and end node correspond to the early exit condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Direct match to the review step following order creation."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved"
      ],
      "justification": "Captures the approval decision gate and its associated branch/guards."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "then reserve the funds for the purchase."
      ],
      "justification": "Direct match to the fund reservation step on the approval path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then rework the order."
      ],
      "justification": "Direct match to the rework step on the rejection path."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Structural join point handling the rework feedback loop described in the text."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Direct match to the shipping step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
