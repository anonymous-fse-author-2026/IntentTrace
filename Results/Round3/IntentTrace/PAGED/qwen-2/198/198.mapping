      ],
      "justification": "Direct match for the availability check step."
    },
    {
      "refs": [
        "guard:b1->c_merge"
      ],
      "verbatim_texts": [
        "if they already have the availability information"
      ],
      "justification": "Abstracts the pre-known availability condition as a direct-proceed guard."
    },
    {
      "refs": [
        "converge:c_merge"
      ],
      "verbatim_texts": [
