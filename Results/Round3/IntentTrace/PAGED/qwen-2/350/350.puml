@startuml
!theme plain
|a_default| Default
|a_default|
start
:provide userdata for flickr;
:v1: login_status ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:login successful;
stop
else ([v1 = 'No'])
:login fails;
:v2: retry_choice ({Try Again, Abort, Still Try Again, Decide to Abort}); <<objectSignal>>
switch ()
case ([v2 = 'Try Again'])
:try again;
case ([v2 = 'Abort'])
:abort;
stop
case ([v2 = 'Still Try Again'])
:still want to try again;
case ([v2 = 'Decide to Abort'])
:decide to abort;
endswitch
endif
@enduml