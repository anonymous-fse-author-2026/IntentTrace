{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Initiates the process and models the first ordering action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to Check the Customer's Credit Limit."
      ],
      "justification": "Directly corresponds to the credit limit check step."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "Models the XOR split and the positive guard/action for checking availability."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Negative guard and denial action match the source; end node structurally terminates this path."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "After checking the availability, if the response is \"Okay\", proceed to Check the Availability of the Article again."
      ],
      "justification": "Correctly captures the conditional re-check described in the text."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Matches the negative outcome of the second availability check and terminates the branch."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Guard 'No' aligns with 'not available' condition leading to production."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Guard 'Yes' aligns with 'available' condition leading to collection."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "send an Order Confirmation."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "AND gateway correctly models the simultaneous execution of shipping and invoicing."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b4->n20",
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "Branches on payment receipt, closes order, and structurally ends the process."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Negative payment branch correctly triggers the reminder count evaluation."
    },
    {
      "refs": [
        "guard:b5->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Positive threshold guard leads to the write-off action."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Models the alternative path for sending a reminder when the count threshold is not met, preserving intended behaviour."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Directly matches the final closing steps and process termination."
    }
  ],
