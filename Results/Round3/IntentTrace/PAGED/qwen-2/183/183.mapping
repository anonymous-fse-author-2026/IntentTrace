      ],
      "verbatim_texts": [
        "To start the process, begin by adding the image description and uploading the image."
      ],
      "justification": "The opening unit implicitly starts the process and describes the initial action. The model's action content matches it exactly."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the message indicates a successful upload, the process will end."
      ],
      "justification": "The condition is re-typed as a preceding action followed by an XOR gateway. The guard captures the success outcome, routing to the termination action and end node. This modeling choice preserves the described behaviour."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the message indicates an unsuccessful upload, then try again."
      ],
      "justification": "The negative branch routes to a retry prompt/action and a second XOR gateway, correctly modeling the split implied by the source text."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the option to try again is selected, the process will continue."
      ],
      "justification": "The 'Yes' guard directs flow to a convergence node, preserving the continuation loop described in the source."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the option to try again is not selected, then an error will occur and the process will end."
      ],
      "justification": "The 'No' guard handles the negative retry choice by routing to an error action and process termination, faithfully capturing the failure outcome."
    }
  ],
