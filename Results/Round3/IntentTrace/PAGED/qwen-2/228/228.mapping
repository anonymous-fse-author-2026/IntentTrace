        "action:n17"
      ],
      "verbatim_texts": [
        "On the other hand, if there are no additional samples, the process ends."
      ],
      "justification": "Models the final conditional check and maps the termination outcome to the end node. Re-typing the condition as an action leading to termination preserves the intended behaviour."
    }
