    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "If tomato sauce is stolen, cook it."
      ],
      "justification": "Re-types the conditional check as a dedicated action step followed by the cooking step; this modeling choice preserves the original behaviour."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After the sauce is cooked, combine all the meal components and prepare the meal."
      ],
      "justification": "Structurally joins the divergent flows back together and performs the final meal preparation action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "This concludes the process."
      ],
      "justification": "Marks the explicit termination point and adds the structural end node to finalize the process flow."
    }
