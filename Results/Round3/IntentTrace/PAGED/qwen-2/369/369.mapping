      ],
      "verbatim_texts": [
        "To begin the process, enter the kitchen."
      ],
      "justification": "Captures the process start node, the explicit start action, and the initial step of entering the kitchen."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: check if pesto is available and cook spaghetti."
      ],
      "justification": "Models the concurrent execution using an AND gateway and correctly splits it into the two simultaneous actions."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If pesto is available, retrieve it from the cupboard."
      ],
      "justification": "Opens the XOR decision point, applies the positive condition guard, and executes the stated retrieval action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If pesto is not available, take tomato sauce from your roommate."
      ],
      "justification": "Covers the negative branch condition and the corresponding alternative action taken when pesto is missing."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
