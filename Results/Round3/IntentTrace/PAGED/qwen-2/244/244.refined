init(i1)
action(n2, "check loan application")
branch(b1, XOR)
converge(c1)
action(n4, "end process")
end(e1)
action(n5, "are special terms agreed upon")
branch(b2, XOR)
action(n7, "disburse funds")
defines(v1, "is application rejected", {"Yes", "No"})
defines(v2, "are special terms agreed upon", {"No", "Yes"})
actor(a_default, "Default", [i1, n2, b1, c1, n4, e1, n5, b2, n7])
precedence(i1, n2)
