@startuml
!theme plain
|a_default| Default
|a_default|
start
:start selling cars;
:v1: did you get a bonus ({Yes, No})
v2: did you get a paycheck ({Yes, No}); <<objectSignal>>
fork
if () then ([v1 = 'Yes'])
:did you get a bonus;
:Yes continue process after bonus;
:pay the bill;
:process ends;
endif
fork again
if () then ([v2 = 'Yes'])
:did you get a paycheck;
:Yes continue process after paycheck;
endif
fork again
if () then ([v1 = 'No' AND v2 = 'No'])
endif
end fork
stop
@enduml