init(i1)
action(n1, "Start Process")
action(n2, "Check Customer Eligibility")
branch(b1, XOR)
action(n3, "Inform Ineligible Customer")
action(n4, "End Process - Ineligible")
end(e1)
action(n5, "Open New Order in ERP System")
action(n6, "Perform Availability Check")
branch(b2, XOR)
action(n7, "Start Producing Missing Parts")
action(n8, "Prepare Products for Shipment")
converge(c_prep)
branch(b_par, AND)
action(n10, "Ship Products")
action(n11, "Send Invoice")
action(n12, "Check Payment Status")
converge(c_par)
branch(b3, XOR)
action(n14, "Close Order - Payment Received")
end(e2)
action(n15, "Send Payment Reminder")
action(n16, "Check Number of Reminders")
branch(b4, XOR)
action(n17, "Continue Process")
action(n18, "Inform Lawyer")
end(e3)
defines(v1, "Check Customer Eligibility", {"not eligible to order", "eligible to order"})
defines(v2, "Perform Availability Check", {"available", "not available"})
defines(v3, "Check Payment Status", {"received", "not received"})
defines(v4, "Check Number of Reminders", {[0-3]})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, e1, n5, n6, b2, n7, n8, c_prep, b_par, n10, n11, n12, c_par, b3, n14, e2, n15, n16, b4, n17, n18, e3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n5)
precedence(n3, n4)
precedence(n4, e1)
precedence(n5, n6)
precedence(n6, b2)
precedence(b2, n7)
precedence(b2, c_prep)
precedence(n7, c_prep)
precedence(c_prep, n8)
precedence(n8, b_par)
precedence(b_par, n10)
precedence(b_par, n11)
precedence(b_par, n12)
precedence(n10, c_par)
precedence(n11, c_par)
precedence(n12, c_par)
precedence(c_par, b3)
precedence(b3, n14)
precedence(b3, n15)
precedence(n14, e2)
precedence(n15, n16)
precedence(n16, b4)
precedence(b4, n17)
precedence(b4, n18)
precedence(n17, c_prep)
precedence(n18, e3)
guard(b1, n3, v1 = 'not eligible to order')
guard(b1, n5, v1 = 'eligible to order')
guard(b2, n7, v2 = 'not available')
guard(b2, c_prep, v2 = 'available')
guard(b3, n14, v3 = 'received')
guard(b3, n15, v3 = 'not received')
guard(b4, n17, v4 < 3)
guard(b4, n18, v4 = 3)