{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order"
      ],
      "justification": "Opening unit supports the start node and initial setup action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check the customer."
      ],
      "justification": "Direct mapping to the eligibility verification step."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\""
      ],
      "justification": "Captures the negative eligibility condition on the decision gateway."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "inform them."
      ],
      "justification": "Action taken when the customer is ineligible."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the customer is \"eligible to order\""
      ],
      "justification": "Captures the positive eligibility condition on the decision gateway."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "open a new order in the ERP system."
      ],
      "justification": "Action taken when the customer is eligible."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Explicit termination point following the ineligible path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "perform an availability check."
      ],
      "justification": "Direct match for the inventory verification step."
    },
    {
      "refs": [
        "guard:b2->n7",
        "guard:b2->c_prep",
        "action:n7"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\". If it is not, start producing the missing parts."
      ],
      "justification": "Models the availability decision, production branch for unavailability, and flow convergence."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Direct match for the preparation step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "Announcer indicating parallel execution mapped to an AND gateway and subsequent parallel actions."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "ship the products and send the invoice while checking for payment."
      ],
      "justification": "Parallel actions faithfully representing the simultaneous operational steps."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Positive payment branch, order closure, and process termination."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Negative payment branch triggering the reminder action."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Threshold check for fewer than 3 reminders leading to process continuation/loop."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Termination threshold reached, triggering lawyer notification and final process end."
    }
  ],
