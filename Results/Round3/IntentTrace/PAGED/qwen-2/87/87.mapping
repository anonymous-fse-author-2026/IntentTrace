  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process in the Admin Office,"
      ],
      "justification": "The opening unit implicitly starts the process and defines the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "first check if it has started."
      ],
      "justification": "A condition modeled as an action step still preserves the behaviour described."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "verify the completeness of the invoices."
      ],
      "justification": "Direct correspondence to the verification step."
    },
    {
      "refs": [
        "guard:b3->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they are marked as \"Uncompleted\", they should be returned to the client through postal mail."
      ],
      "justification": "Branch, guard value, and return action correctly capture the first 'Uncompleted' condition and resulting step."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "if they are marked as \"Completed\", the process should be continued."
      ],
      "justification": "Guard and continuation action match the positive branch for the first check."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the invoices are still marked as \"Uncompleted\", they should be returned to the client via postal mail."
      ],
      "justification": "Second branch, guard, and action accurately reflect the repeated 'Uncompleted' check and return instruction."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "the process should be continued."
      ],
      "justification": "Matches the second mention of continuing the process upon completion status."
    },
    {
      "refs": [
        "action:n7",
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the invoices are returned to the client, receive the completed ones."
      ],
      "justification": "Two action nodes redundantly model the receipt step, and the converge node provides standard structural plumbing to rejoin flows. Behaviour is fully preserved."
    },
    {
      "refs": [
        "action:n8",
        "action:n10"
      ],
      "verbatim_texts": [
        "Then, mark the relevant box on the invoice entry form and proceed with checking if the process has been completed."
      ],
      "justification": "The single instruction is split into two sequential actions that together preserve the intended behaviour."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicitly matches the process termination statement."
    }
  ],
