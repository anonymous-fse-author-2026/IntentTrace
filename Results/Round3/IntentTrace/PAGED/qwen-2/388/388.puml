@startuml
!theme plain
|a_default| Default
|a_default|
start
:start process;
repeat :;
:Select filter;
:Apply filter;
:Click Submit button;
:Is submit option false;
:v1: Is submit option false ({false, true}); <<objectSignal>>
backward:Apply another filter;
repeat while () is ([v1 = false]) not ([v1 = true])
:Is there another filter to apply;
:v2: Is there another filter to apply ({yes, no}); <<objectSignal>>
if () then ([v2 = "yes"])
->;
else ([v2 = "no"])
:Is submit option true;
endif
:Continue with process;
stop
@enduml