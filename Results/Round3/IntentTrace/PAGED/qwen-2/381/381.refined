end(e6)
action(n10, "check if code is available (flight)")
defines(v1, "check if need to book train or flight", {true, false})
defines(v4, "code available after calling travel agency", {true, false})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, n6, n8, c1, b4, n14, e5, n15, n13, e6, n10])
precedence(i1, n1)
precedence(n1, n2)
