action(n3, "check if need to book train or flight")
branch(b1, XOR)
action(n4, "book a train")
action(n5, "book a flight")
action(n6, "check if code is available within 24 hours (train)")
action(n8, "Otherwise, if 24 hours have passed, you should call a travel agency")
