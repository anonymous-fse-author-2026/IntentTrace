{
  "matches": [
    {
      "refs": [
        "guard:b_opt->n_res_dir",
        "action:n_res_dir"
      ],
      "verbatim_texts": [
        "Initially, if the option \"research schedule directly\" is selected, then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Starts the process and captures the positive branch of the initial option selection."
    },
    {
      "refs": [
        "guard:b_opt->n_prov_ind",
        "action:n_prov_ind",
        "action:n_res_after"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Captures the negative branch of the initial option, including both actions and convergence before validation."
    },
    {
      "refs": [
        "action:n_val_sched"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Models the schedule validation step and opens the first satisfaction decision."
    },
    {
      "refs": [
        "guard:b_sat1->n_res_again",
        "action:n_res_again"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Handles the unsatisfactory outcome routing back to research."
    },
    {
      "refs": [
        "guard:b_sat1->c_pre_write"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Routes the satisfactory outcome toward ticket creation."
    },
    {
      "refs": [
        "branch:b_sat2"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\"."
      ],
      "justification": "Opens the second satisfaction evaluation point."
    },
    {
      "refs": [
        "guard:b_sat2->n_prov_ind2",
        "action:n_prov_ind2"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Handles the persistent unsatisfactory outcome."
    },
    {
      "refs": [
        "guard:b_sat2->c_pre_write"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Routes the satisfactory outcome to converge with the previous path before writing."
    },
    {
      "refs": [
        "action:n_write_tkt",
        "action:n_val_tkt1"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Directly maps writing and the first validation step."
    },
    {
      "refs": [
        "branch:b_app1"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Opens the first approval decision."
    },
    {
      "refs": [
        "guard:b_app1->e_rej1"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Maps the first rejection path and termination."
    },
    {
      "refs": [
        "guard:b_app1->n_val_tkt2",
        "action:n_val_tkt2"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Routes approval to the second validation step."
    },
    {
      "refs": [
        "guard:b_app2->e_rej2"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Covers the second approval check and its implicit rejection termination."
    },
    {
      "refs": [
        "guard:b_app2->n_val_tkt3",
        "action:n_val_tkt3"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Routes the second approval to a third validation and opens the final check."
    },
    {
      "refs": [
        "guard:b_app3->e_acc",
        "guard:b_app3->e_rej3"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Captures the final positive termination, alongside the matching negative termination implied by the full text."
    }
  ],
