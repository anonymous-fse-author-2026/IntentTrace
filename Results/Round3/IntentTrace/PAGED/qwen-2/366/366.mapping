      ],
      "verbatim_texts": [
        "To begin the process, start by checking the order received"
      ],
      "justification": "The start node and first action directly correspond to the opening instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to check the availability of the article."
      ],
      "justification": "Direct paraphrase of the second step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the article is not available, the next step is to initiate the procurement process."
      ],
      "justification": "Captures the negative branch of the first decision correctly."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the article is available, proceed to ship it."
      ],
      "justification": "Captures the positive branch of the first decision correctly."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After shipping the article, check its availability again."
      ],
      "justification": "Direct match for the re-check step."
    },
    {
