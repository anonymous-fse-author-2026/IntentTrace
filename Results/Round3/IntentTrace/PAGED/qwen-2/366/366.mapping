        "action:n8",
        "guard:b2->n9",
        "action:n9",
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is still not available, initiate the procurement process. Otherwise, proceed to ship the article."
      ],
      "justification": "Models the second decision split and both outcomes faithfully. The condition check is modeled as an action step followed by a branch, which preserves behaviour."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the article is shipped, the next step is to complete the financial settlement."
      ],
      "justification": "Direct match for the financial settlement step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After the financial settlement is done, the process ends with the receipt of payment."
      ],
      "justification": "Final step and termination point correspond to the closing instruction."
    }
