{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Captures process initiation and the initial sequential steps."
    },
    {
      "refs": [
        "label:b1->i2",
        "guard:b1->i2",
        "action:i2"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Models the decision point and the negative outcome path, including the termination after return."
    },
    {
      "refs": [
        "label:b1->i3",
        "guard:b1->i3",
        "action:i3"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Models the positive outcome path for invoice completeness."
    },
    {
      "refs": [
        "label:b_comp->i4",
        "guard:b_comp->i4",
        "action:i4"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Captures the compliance decision and the non-compliant handling branch."
    },
    {
      "refs": [
        "label:b_comp->i5",
        "guard:b_comp->i5",
        "action:i5"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Captures the compliant handling branch."
    },
    {
      "refs": [
        "label:b_res->i6",
        "guard:b_res->i6",
        "action:i6"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Models the resolution decision and the phone call outcome."
    },
    {
      "refs": [
        "label:b_res->i7",
        "guard:b_res->i7",
        "action:i7"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Models the mail-back outcome and subsequent process termination."
    },
    {
      "refs": [
        "action:i8"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Joins preceding flows and captures the payment and conditional resolution step."
    },
    {
      "refs": [
        "label:b1->i9",
        "guard:b1->i9",
        "action:i9"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Models the parallel/simultaneous billing path branching from the initial split."
    },
    {
      "refs": [
        "label:b_resp->i10",
        "guard:b_resp->i10",
        "action:i10"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Captures the response check decision and the waiting period outcome."
    },
    {
      "refs": [
        "label:b_resp->c11",
        "guard:b_resp->c11",
        "action:i11"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Models the positive response path, convergence, and payment/notification steps."
    },
    {
      "refs": [
        "action:i12"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Directly maps the waiting period expiration, reminder action, and process termination."
    },
    {
      "refs": [
        "label:b_sat->i13",
        "guard:b_sat->i13",
        "action:i13"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Captures the satisfaction decision and the discrepancy resolution path with termination."
    },
    {
      "refs": [
        "label:b_sat->i14",
        "guard:b_sat->i14",
        "action:i14"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Captures the satisfied client path and associated termination point."
    }
  ],
