{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, you should choose your destination and calculate the distance."
      ],
      "justification": "The opening unit establishes the process start and describes the first concrete action. Both structural and behavioral aspects are preserved."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "continue to check if you need to book a train or a flight."
      ],
      "justification": "The decision prompt is modeled as an action step feeding into an XOR branch. Re-typing a check as an action followed by a gateway preserves the intended control flow."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the answer is \"no\", then proceed to book a train."
      ],
      "justification": "Correctly captures the negative branch outcome. The guard variable v1='No' faithfully represents the conditional outcome, leading to the booking action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the answer is \"yes\", then book a flight."
      ],
      "justification": "Correctly captures the positive branch outcome. The guard v1='Yes' and subsequent action preserve the decision logic and result."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours, the process will end."
      ],
      "justification": "Models the time-based condition as a branch with a positive guard leading directly to a termination action and end node. Behavior is fully preserved."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "Otherwise, if 24 hours have passed, you should call a travel agency."
      ],
      "justification": "Captures the fallback/negative branch of the 24-hour check. The guard v2='No' correctly routes to the travel agency step."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If a code is available, the process will end along with the hotel reservation."
      ],
      "justification": "Models the second availability check's positive outcome. The guard, action, and structural end node together preserve the termination condition and its context."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if a code is not available, you should cancel your journey."
      ],
      "justification": "Captures the negative outcome of the second availability check, correctly routing to the cancellation step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "In that case, the process will end as well."
      ],
      "justification": "Represents the final termination following journey cancellation. The action and end node together preserve the concluding behavior."
    }
  ],
