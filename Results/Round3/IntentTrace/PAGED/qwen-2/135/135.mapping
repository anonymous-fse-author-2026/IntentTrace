      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with Low Inventory."
      ],
      "justification": "The opening unit implicitly starts the process and describes the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed to Create P.R."
      ],
      "justification": "Directly captures the first Create P.R. step."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "move on to Create P.R., followed by Submit P.O."
      ],
      "justification": "Maps the redundant Create P.R. step and the subsequent Submit P.O. step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "proceed to Ship Material"
      ],
      "justification": "Directly captures the shipping action."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "check if the shipment is okay"
      ],
      "justification": "Opens the first XOR decision point regarding shipment status."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed to Send Payment."
      ],
      "justification": "Captures the positive branch condition and the corresponding send payment action."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "if there are any problems with the shipment, communicate them accordingly."
      ],
      "justification": "Captures the negative branch condition and the communication action."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "if it is okay, proceed to Send Payment."
      ],
      "justification": "Models the repeated positive check and payment action. Redundancy preserves behaviour."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Otherwise, communicate any shipment problems."
      ],
      "justification": "Models the repeated negative branch. Redundancy does not alter process flow."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "once the payment is sent, the process comes to an end."
      ],
      "justification": "Terminal actions and end nodes faithfully represent the process conclusion. Duplicate end markers are harmless structural plumbing."
    }
  ],
