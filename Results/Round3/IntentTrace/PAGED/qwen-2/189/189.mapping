{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Covers the implicit process start and the first explicit validation step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Models the positive branch of the first decision and its outgoing guard."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Models the negative branch, its guard, and the subsequent convergence."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Direct step match following the merge."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits."
      ],
      "justification": "Condition modeled as an action step; behaviour-preserving match."
    },
    {
      "refs": [
        "guard:b3->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "Captures the negative limit-outcome path and its action."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process."
      ],
      "justification": "Captures the decision split, positive limit-outcome path, action, and merge."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Direct step match."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Direct step match."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Direct step match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Direct step match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Direct step match."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Direct step match."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Initial check step and the associated XOR decision gateway."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If they are, continue with the process."
      ],
      "justification": "Positive acceptability path and guard."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If not, select a new applicant from the list."
      ],
      "justification": "Negative acceptability path and guard."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Final check step and associated XOR decision gateway."
    },
    {
      "refs": [
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Positive client-acceptance path, end action, and structural termination nodes."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Negative client-acceptance path and guard."
    }
  ],
