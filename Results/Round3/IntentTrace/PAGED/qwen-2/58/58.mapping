{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "The initial trigger and first prioritization step directly align with the opening sentence."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information."
      ],
      "justification": "Customer information check implicitly introduces the existence decision point."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the customer exists"
      ],
      "justification": "Positive branch condition and subsequent payment history verification."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "we move on to checking their payment history"
      ],
      "justification": "Positive branch condition and subsequent payment history verification."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if the customer does not exist"
      ],
      "justification": "Negative branch condition and status verification step; 'New' guard label is a valid behavioral paraphrase."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "we need to verify their customer status"
      ],
      "justification": "Negative branch condition and status verification step; 'New' guard label is a valid behavioral paraphrase."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Decision split for private customers and the corresponding decline action."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Wholesaler branch captures creation, availability check, and the subsequent product split."
    },
    {
      "refs": [
        "guard:b4->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Unavailable path correctly models production, decline messaging, and process termination."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Available path continues workflow with confirmation step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "Parallel notification step merges back into the main flow."
    },
    {
      "refs": [
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Packing, invoicing, and delivery-readiness steps are decomposed but preserve identical behavior."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Delivery action faithfully restates the source requirement."
    },
    {
      "refs": [
        "guard:b5->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Payment receipt condition and order closure step align perfectly."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Outstanding payment branch and reminder count check match source logic."
    },
    {
      "refs": [
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Less-than-three threshold allows process continuation as specified."
    },
    {
      "refs": [
        "guard:b6->n27",
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Greater-than-three threshold triggers donning process and correctly terminates the workflow."
    }
  ],
