  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Structural start and first action both correspond to the opening instruction."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000"
      ],
      "justification": "First decision point and its positive guard capture the high-expense condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the report should be reviewed"
      ],
      "justification": "Action matches the positive outcome of the first decision."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000"
      ],
      "justification": "Negative guard for the first decision matches the low-expense condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "you should proceed to check if there is a need for translation"
      ],
      "justification": "Action matches the instruction to check translation need on the negative path."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If translation is required"
      ],
      "justification": "Second decision point and positive guard capture the translation requirement."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed to translate the receipts"
      ],
      "justification": "Action matches the translation step."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Convergence node and negative guard match the 'otherwise' branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "confirm the receipts"
      ],
      "justification": "Action matches the confirmation step on the negative path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Direct match for the first review evaluation step."
    },
    {
      "refs": [
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If the report is rejected"
      ],
      "justification": "Third decision point and rejection guard match the conditional."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report.",
        "edit the report."
      ],
      "justification": "Action matches the rejection handling instruction."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Approval guard for the third decision matches the condition."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "continue to check if there is a need for translation."
      ],
      "justification": "Action matches the loop-back instruction on approval."
    },
    {
      "refs": [
        "action:n11",
        "guard:b4->n12"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Second evaluation step, its branching point, and rejection guard are captured here."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Implied rejection action on the second evaluation is modeled consistently with the first."
    },
    {
      "refs": [
        "guard:b4->n13",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "translate the receipts and then confirm them."
      ],
      "justification": "Approval path on the second evaluation correctly splits into translation and confirmation actions."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Final evaluation step and its branching gateway match the source."
    },
    {
      "refs": [
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Acceptance guard and action match the positive receipt outcome."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Rejection guard and action match the negative receipt outcome."
    },
    {
