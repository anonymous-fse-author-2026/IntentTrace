    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the company, the first step is to look at the order."
      ],
      "justification": "Captures process initiation and the first examination step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the order is to be rejected, the process should continue. If the order is to be accepted, the process should also continue."
      ],
      "justification": "Models the rejection/acceptance check. Since both branches continue identically, a single action step preserves the unconditional flow. Fragments i3 and i4 carry no independent behavioural meaning and are dropped."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "preparing the assembling order"
      ],
      "justification": "Splits flow for parallel execution and starts the first concurrent task."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "checking availability"
      ],
      "justification": "Executes the second concurrent task and rejoins the parallel flows."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If there is a backorder"
      ],
      "justification": "Evaluates the backorder condition and routes to the re-check path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "availability needs to be checked again"
      ],
      "justification": "Direct paraphrase of the required re-evaluation step."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "and the process ends"
      ],
      "justification": "Explicit termination point for the backorder path."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If the item can be reserved"
      ],
      "justification": "Routes flow when the item is available for reservation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "assemble the bike"
      ],
      "justification": "Direct match to the assembly step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "then ship the product"
      ],
      "justification": "Direct match to the shipping step."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "then ship the product"
      ],
      "justification": "Implicit process completion after the final shipping step."
