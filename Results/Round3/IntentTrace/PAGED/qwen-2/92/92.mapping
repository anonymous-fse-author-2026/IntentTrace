  "matches": [
    {
      "refs": [
        "action:n0"
      ],
      "verbatim_texts": [
        "please register your participation for the event."
      ],
      "justification": "Start node and initial action correspond to the opening step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If there is no fee",
        "if there is a fee"
      ],
      "justification": "The XOR branch models the decision point regarding fees."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If there is no fee"
      ],
      "justification": "Guard captures the no-fee condition (v1 = 'No')."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if there is a fee"
      ],
      "justification": "Guard captures the fee condition (v1 = 'Yes')."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to register a post-seminar request"
      ],
      "justification": "Action for the no-fee path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "create a purchase request"
      ],
      "justification": "Action for the fee path."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Terminates the no-fee branch as specified."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "check if the purchase request has been approved"
      ],
      "justification": "Step following purchase request creation."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification",
        "if the purchase request is rejected, you will be notified of the rejection"
      ],
      "justification": "Decision point for approval status."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification"
      ],
      "justification": "Approved outcome path and notification."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "if the purchase request is rejected, you will be notified of the rejection"
      ],
      "justification": "Rejected outcome path and notification."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "you should then register a post-seminar request"
      ],
      "justification": "Follow-up action after receiving approval."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Terminates the rejection path."
    }
  ],
