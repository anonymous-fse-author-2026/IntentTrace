{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For MyCorp, the process begins by entering expenses."
      ],
      "justification": "Initiates the process and models the first explicit step described in the opening unit."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After entering expenses, the next step is to generate a spreadsheet."
      ],
      "justification": "Directly corresponds to the second sequential step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the spreadsheet is generated, the request can be approved or disapproved."
      ],
      "justification": "Models the first decision point. The conditional check is re-typed as an action step (n4) followed by an XOR branch, which preserves behaviour under the relaxed rules."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If the request is not approved, the process goes back to entering expenses."
      ],
      "justification": "Captures the negative branch outcome ('Disapproved') and the convergence node that structurally enables looping back to the start."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the request is approved, the expenses can be paid out."
      ],
      "justification": "Captures the positive branch guard and the corresponding payout action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Models the second decision point. Again, the check is re-typed as an action (n7) before the XOR branch, which is behaviour-preserving."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is not approved, the process goes back to entering expenses."
      ],
      "justification": "Captures the negative outcome of the second check, routing to the same convergence point for looping back."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if it is approved, the expenses can be paid out."
      ],
      "justification": "Captures the positive outcome of the second check and the associated payout action. Duplicating the payout step mirrors the source text's repetition and does not alter process behaviour."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Finally, after the expenses are paid out, the process comes to an end."
      ],
      "justification": "Models the final termination step and the explicit end node, completing the described flow."
    }
  ],
