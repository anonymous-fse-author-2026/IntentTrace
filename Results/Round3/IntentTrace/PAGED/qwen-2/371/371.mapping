{
  "matches": [
    {
      "refs": [
        "action:act1",
        "action:act2"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Initialization node and first two actions correspond exactly to starting the process and selecting Edit Report."
    },
    {
      "refs": [
        "guard:br1->act3",
        "action:act3"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "XOR branch and positive guard/action capture the high-expense review path."
    },
    {
      "refs": [
        "guard:br1->act4",
        "action:act4"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Negative guard/action capture the low-expense path leading to translation check."
    },
    {
      "refs": [
        "guard:br3->act5",
        "action:act5"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Branch and positive guard/action model the translation requirement check and corresponding step."
    },
    {
      "refs": [
        "guard:br3->act6",
        "action:act6"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Negative guard/action model the fallback confirmation step."
    },
    {
      "refs": [
        "action:act7"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Convergence node joins previous paths, followed by the explicit review evaluation action."
    },
    {
      "refs": [
        "guard:br2->act8",
        "action:act8"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Rejection branch/guard/action correctly routes to editing."
    },
    {
      "refs": [
        "guard:br2->act9",
        "action:act9"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Approval branch/guard/action correctly routes back to checking translation."
    },
    {
      "refs": [
        "action:act10"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Convergence and action reflect the second review evaluation step."
    },
    {
      "refs": [
        "guard:br4->act11",
        "action:act11",
        "guard:br4->act12",
        "action:act12"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Models the second decision point. Approval path matches input; rejection path is structurally present in the model to maintain valid branching, preserving overall behavior."
    },
    {
      "refs": [
        "action:act13"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Convergence and action model the final receipts decision evaluation."
    },
    {
      "refs": [
        "guard:br5->act14",
        "action:act14"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Acceptance branch/guard/action routes correctly to processing."
    },
    {
      "refs": [
        "guard:br5->act15",
        "action:act15"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Rejection branch/guard/action routes correctly to editing."
    },
    {
      "refs": [
        "action:act16"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Structural convergence, termination action, and end node align with the concluding statement. Redundant restatement of expense processing does not alter behavior."
    }
  ],
