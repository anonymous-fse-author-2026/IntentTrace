{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For developers practicing BPMN execution TDD, the first step is to understand the BPMN Model."
      ],
      "justification": "Initial unit establishes the process start and describes the first action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, they should write a failing test."
      ],
      "justification": "Direct paraphrase of the second step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "To make the test pass, they need to extend BPMN/mocks."
      ],
      "justification": "Direct paraphrase of the third step."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "Once the test is green,"
      ],
      "justification": "Models the conditional check as an action, opens the XOR branch, and routes the positive outcome correctly."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should check if the level satisfies the project requirements."
      ],
      "justification": "Captures the requirement check action and opens the subsequent decision gateway."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it does, the process ends."
      ],
      "justification": "Routes the positive outcome to the termination action and end event."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If not, they should continue the process."
      ],
      "justification": "Routes the negative outcome to the continuation action and merges flows back into the process loop."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the test is not green, they should upgrade the test level."
      ],
      "justification": "Routes the alternative test failure path to the upgrade action."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "After that, they need to check if the level satisfies the project requirements again."
      ],
      "justification": "Captures the repeated requirement check, its decision point, and the implied positive outcome ('If it does, the process ends') that immediately follows in the source."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If not, they should upgrade the test level once more."
      ],
      "justification": "Captures the final negative branch and termination path."
    }
  ],
