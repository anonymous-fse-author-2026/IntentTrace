@startuml
!theme plain
|a_default| Default
|a_default|
start
:start selling cars;
:v1: get a bonus ({yes, no})
v2: get a paycheck ({yes, no}); <<objectSignal>>
fork
if () then ([v1 = "yes"])
:get a bonus;
:continue process;
:pay the bill;
:end process;
stop
endif
fork again
if () then ([v2 = "yes" OR v1 = "no"])
:get a paycheck;
:continue process;
:pay the bill;
:end process;
stop
endif
end fork
@enduml