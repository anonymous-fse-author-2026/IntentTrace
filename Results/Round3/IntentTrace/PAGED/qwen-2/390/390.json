  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start with Orders Required and then place a Bulk order."
    },
    {
      "id": "i2",
      "content": "If the condition is \"Order with prior internal credit allowance\""
    },
    {
      "id": "i3",
      "content": "proceed with processing the order for delivery."
    },
    {
      "id": "i4",
      "content": "if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance."
    },
    {
      "id": "i5",
      "content": "a new order is placed"
    },
    {
      "id": "i6",
      "content": "the process ends at the Warehouse."
    },
    {
      "id": "i7",
      "content": "it will be recorded in the Accounts Receivable."
    },
    {
      "id": "i8",
      "content": "If Payments are Received"
    },
    {
      "id": "i9",
      "content": "the process continues."
    },
    {
      "id": "i10",
      "content": "if no payments are received, the order is dropped."
    },
    {
      "id": "i11",
      "content": "Next, identify the order for installation."
    },
    {
      "id": "i12",
      "content": "If the installation needs to be scheduled"
    },
    {
      "id": "i13",
      "content": "an Installer will be assigned."
    },
    {
      "id": "i14",
      "content": "if the order does not require installation, it will be packed for delivery."
    }
  ]
}