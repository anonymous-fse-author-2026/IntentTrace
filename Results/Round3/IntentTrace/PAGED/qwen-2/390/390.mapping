{
  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "Initialization node and the first two sequential actions directly correspond to the opening unit."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\""
      ],
      "justification": "First decision point and its positive guard condition."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance."
      ],
      "justification": "Negative guard and resulting state/action for the credit allowance decision."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed with processing the order for delivery."
      ],
      "justification": "Positive arm action following the first condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "a new order is placed"
      ],
      "justification": "Step triggered by the outstanding balance condition."
    },
    {
      "refs": [
        "guard:b4->e4"
      ],
      "verbatim_texts": [
        "the process ends at the Warehouse."
      ],
      "justification": "Structural split and abstract guards capturing the two described outcomes after placing a new order."
    },
    {
      "refs": [
        "guard:b4->n8"
      ],
      "verbatim_texts": [
        "it will be recorded in the Accounts Receivable."
      ],
      "justification": "Structural split and abstract guards capturing the two described outcomes after placing a new order."
    },
    {
      "refs": [
        "end:e4"
      ],
      "verbatim_texts": [
        "the process ends at the Warehouse."
      ],
      "justification": "Terminal node for the warehouse path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "it will be recorded in the Accounts Receivable."
      ],
      "justification": "Action capturing the Accounts Receivable recording step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If Payments are Received"
      ],
      "justification": "Payment check action and the second decision gateway."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If Payments are Received"
      ],
      "justification": "Positive guard for the payment receipt condition."
    },
    {
      "refs": [
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "if no payments are received, the order is dropped."
      ],
      "justification": "Negative guard covering the non-payment scenario."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the process continues."
      ],
      "justification": "Continuation step on successful payment."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "if no payments are received, the order is dropped."
      ],
      "justification": "Dropping the order and terminating the process on failed payment."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Next, identify the order for installation."
      ],
      "justification": "Direct match for the installation identification step."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled"
      ],
      "justification": "Installation scheduling condition and its positive guard."
    },
    {
      "refs": [
        "guard:b3->n16"
      ],
      "verbatim_texts": [
        "if the order does not require installation, it will be packed for delivery."
      ],
      "justification": "Negative guard for the installation requirement check."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "an Installer will be assigned."
      ],
      "justification": "Installer assignment action and associated path termination."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "if the order does not require installation, it will be packed for delivery."
      ],
      "justification": "Packing action and structural convergence/termination nodes handling flow completion."
    }
