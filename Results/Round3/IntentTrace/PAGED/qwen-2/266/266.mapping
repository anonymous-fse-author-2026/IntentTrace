{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts with an informational meeting"
      ],
      "justification": "Process initiation and the first activity are captured together."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the meeting is successful"
      ],
      "justification": "Decision point and positive guard correctly reflect the success condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "work on the storyboard"
      ],
      "justification": "Direct action corresponding to the storyboard step."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "if the meeting is not successful"
      ],
      "justification": "Negative guard correctly reflects the failure condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Termination step on the failure path."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "AND-split correctly models the two parallel tasks, followed by convergence."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After that, the site development takes 2 days"
      ],
      "justification": "Sequential development step following the parallel tasks."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "it goes through a review process that lasts 1 day"
      ],
      "justification": "Review step accurately modeled."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "approval stage, which takes half a day"
      ],
      "justification": "Approval step follows review; the transition condition is implicitly absorbed without changing behaviour."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If the approval is complete"
      ],
      "justification": "Decision point and positive guard for the completed approval."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Termination on the successful approval path."
    },
    {
      "refs": [
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "if the approval is rejected"
      ],
      "justification": "Negative guard for rejected approval."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "the site needs to be rebuilt"
      ],
      "justification": "Rebuild action triggered by rejection."
    },
    {
      "refs": [
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If the rebuild is complete"
      ],
      "justification": "Second decision point and positive guard for rebuild completion."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Termination after successful rebuild."
    },
    {
      "refs": [
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again"
      ],
      "justification": "Negative guard for repeated rejection."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "the site needs to be rebuilt again"
      ],
      "justification": "Final rebuild action and termination on repeat rejection."
    }
  ],
