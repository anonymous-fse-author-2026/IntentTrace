@startuml
!theme plain
|a_default| Default
|a_default|
start
:check Inventory Level;
:v1: Inventory level is at or below the minimum ({below_or_at_minimum, above_minimum}); <<objectSignal>>
if () then ([v1 = 'below_or_at_minimum'])
:Create Purchase Order;
:Reviewing the Purchase Order;
:v2: Purchase Order is approved ({approved, rejected}); <<objectSignal>>
if () then ([v2 = 'approved'])
:Reserve funds for purchase;
:Send Order to Suppliers;
split
:Supplier sends packing slip;
:record packing slip;
split again
:Supplier sends invoice;
:record invoice;
end split
:Release reserved funds and issue payment to supplier;
:End process after payment is issued;
stop
else ([v2 = 'rejected'])
:Rework the order;
:Review Purchase Order again;
endif
else ([v1 = 'above_minimum'])
:End process;
stop
endif
@enduml