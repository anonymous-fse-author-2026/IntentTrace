      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report.",
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Models the XOR decision on inventory levels correctly. Guards use variable assignments to represent the thresholds, preserving the branching logic and corresponding report generation actions."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report.",
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Models the XOR decision on inventory levels correctly. Guards use variable assignments to represent the thresholds, preserving the branching logic and corresponding report generation actions."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Correctly models the early termination path when inventory is above minimum."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs).",
        "If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Captures the creation of POs and the loopback structure for reworked POs. The converge node handles the retry flow, preserving behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Direct match for the PO review step."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked.",
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Models the review outcome decision correctly, with appropriate guards and actions for rejection (rework) and approval (print/release)."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked.",
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Models the review outcome decision correctly, with appropriate guards and actions for rejection (rework) and approval (print/release)."
    },
    {
