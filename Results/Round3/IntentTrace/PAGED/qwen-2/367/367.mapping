      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "Captures the process start, initialization of the resupply cycle, and the initial inventory check. Redundant 'start' action is harmless structural plumbing."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report.",
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Models the XOR decision on inventory levels correctly. Guards use variable assignments to represent the thresholds, preserving the branching logic and corresponding report generation actions."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report.",
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Models the XOR decision on inventory levels correctly. Guards use variable assignments to represent the thresholds, preserving the branching logic and corresponding report generation actions."
    },
    {
      "refs": [
