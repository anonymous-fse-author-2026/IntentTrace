      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked.",
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Models the review outcome decision correctly, with appropriate guards and actions for rejection (rework) and approval (print/release)."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "Correctly uses an AND gateway to split into parallel fund reservation and mailing tasks."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Direct match for the inventory reception step on the supplier-mailing branch."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip.",
        "If the Packing Slip is received, proceed to receive the Invoice. If the inventory is received, proceed to receive the Packing Slip.",
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "The converge node joins the parallel branches, and the subsequent action captures receiving the Invoice. Merging the intermediate packing slip steps into the join/invoice step preserves the sequential flow without changing behaviour."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Direct match for the three-way match step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Direct match for releasing funds after a successful match."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Direct match for issuing payment."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Correctly marks the final termination point of the process."
    }
