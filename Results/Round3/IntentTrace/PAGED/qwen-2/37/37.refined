init(i1)
end(e1)
action(n1, "start process for WIGGO by placing an Order")
action(n2, "Check the Customers Credit Limit")
branch(b1, XOR)
action(n4, "Check the Availability of the Article first time")
action(n5, "Send a Denial to the Customer due to Credit Limit")
branch(b_art, XOR)
action(n10, "Produce the Goods")
action(n11, "Collect the Goods")
converge(c1)
action(n12, "Send an Order Confirmation")
branch(b6, AND)
action(n13, "Ship the Goods")
action(n14, "Send the Invoice")
converge(c2)
action(n15, "Check the Payment status")
action(n17, "Close the Order due to Payment received")
action(n18, "End process")
defines(v1, "Is Credit Limit Okay", {"Okay", "No"})
defines(v_art, "Article Availability", {"Available", "Unavailable"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, n5, e1, b_art, n10, n11, c1, n12, b6, n13, n14, c2, n15, n17, n18])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, e1)
precedence(n4, b_art)
precedence(b_art, n10)
precedence(b_art, n11)
precedence(n10, c1)
precedence(n11, c1)
precedence(c1, n12)
precedence(n12, b6)
precedence(b6, n13)
precedence(b6, n14)
precedence(n13, c2)
precedence(n14, c2)
precedence(c2, n15)
precedence(n15, n17)
precedence(n17, n18)
precedence(n18, e1)
guard(b1, n4, v1 = 'Okay')
guard(b1, n5, v1 = 'No')
guard(b_art, n10, v_art = 'Unavailable')
guard(b_art, n11, v_art = 'Available')