      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "Captures the process start and the initial step of entering metadata."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to the IN-Patient step"
      ],
      "justification": "Directly models the transition to the IN-Patient step."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "complete the following steps: send data to suppliers and create a claim"
      ],
      "justification": "Accurately captures the two required steps of sending data and creating a claim."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "extract the data from the suppliers and transfer it to the doctor's phone"
      ],
      "justification": "Direct match for extracting supplier data and transferring it to the doctor."
    },
    {
      "refs": [
        "action:n7",
        "guard:b1->n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "confirm the GOP and the process will come to an end"
      ],
      "justification": "Models the GOP confirmation followed by process termination. The branch and guard provide structural routing without altering the described behavior."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Next, register the case and handle the claim"
      ],
      "justification": "Captures the subsequent registration and claim handling steps."
    },
    {
      "refs": [
        "action:n11",
        "action:n12",
        "guard:b2->n16",
        "guard:b2->c1",
        "action:n16"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status"
      ],
      "justification": "Correctly models the extraction step followed by an XOR split representing the 'or' condition between recording data and confirming status."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "confirm the IN-Patient status"
      ],
      "justification": "Redundant restatement of the confirmation action already modeled. Redundancy preserves behavior and is classified as a match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "send the data back to the suppliers"
      ],
      "justification": "Direct match for returning data to suppliers."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, receive the payment and conclude the process"
      ],
      "justification": "Accurately captures the final payment step and process conclusion."
    }
