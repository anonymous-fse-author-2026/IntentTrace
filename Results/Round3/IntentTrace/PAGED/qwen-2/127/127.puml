@startuml
!theme plain
|a_default| Default
|a_default|
start
:Identify parts;
:v1: Process Condition ({Elicit, HaveInfo, Supplied, Record}); <<objectSignal>>
switch ()
case ([v1 = 'Elicit'])
:Need to elicit information from customer;
:Check availability of parts;
case ([v1 = 'HaveInfo'])
:Proceed with process;
case ([v1 = 'Supplied'])
:Are parts supplied to customer;
case ([v1 = 'Record'])
:Record customer details;
:Order and receive part from Disuki;
endswitch
:Contract customer;
:Proceed with payment;
:End;
stop
@enduml