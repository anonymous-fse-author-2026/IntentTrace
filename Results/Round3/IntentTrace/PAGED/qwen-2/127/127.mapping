{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "The opening unit establishes the process start and the first action step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer"
      ],
      "justification": "Models the first conditional case. The branch/guard handle the split logic, while modeling the condition as an action step (n3) preserves behaviour under relaxed rules."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "check the availability of the parts"
      ],
      "justification": "Directly corresponds to the required step following the elicitation condition."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if they already have the availability information, they can proceed with the process"
      ],
      "justification": "Captures the second alternative case and the corresponding proceeding action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer"
      ],
      "justification": "Captures the third case. Modeling the condition as an action node (n6) alongside the guard preserves the decision behaviour."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if they need to record the customer's details"
      ],
      "justification": "Captures the fourth case condition and models it consistently with the other branches."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "order and receive the part from Disuki"
      ],
      "justification": "Direct paraphrase of the required step when customer details need recording."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "The converge node rejoins the parallel branches before executing the contraction step, preserving the sequential flow described."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected, the team can proceed with the payment."
      ],
      "justification": "Direct match for the payment preparation step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "Correctly captures the final termination condition and structural end node."
    }
  ],
