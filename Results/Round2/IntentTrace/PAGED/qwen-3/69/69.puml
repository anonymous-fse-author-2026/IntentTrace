@startuml
!theme plain
|a_default| Default
|a_default|
start
:trigger resupply cycle for ACME Company;
:check inventory level;
:create purchase order;
:v1: is purchase order good? ({true, false}); <<objectSignal>>
if () then ([v1 = true])
:approve purchase order;
:reserve funds for purchase;
:send purchase order to supplier;
split
:receive packing slip;
:record packing slip;
split again
:receive invoice;
:record invoice;
end split
:release funds for payment;
:issue payment;
else ([v1 = false])
:reject purchase order;
:rework purchase order;
:review purchase order again;
endif
stop
@enduml