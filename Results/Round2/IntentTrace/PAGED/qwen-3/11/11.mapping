{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the process for ACME Company, the Resupply Cycle is triggered"
      ],
      "justification": "Establishes the process trigger. Generic 'start' action and explicit cycle trigger both preserve the initial behaviour without change."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level"
      ],
      "justification": "Directly models the inventory check step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the Inventory is greater than the Minimum Level, then the process ends."
      ],
      "justification": "Condition modeled as an action step (permitted re-typing), XOR branch, positive guard ('Yes'), end action, and structural end node all faithfully represent this early termination path."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "Otherwise, a Purchase Order is created."
      ],
      "justification": "Negative guard ('No') and creation action correctly implement the fallback path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The Purchase Order is then reviewed."
      ],
      "justification": "Direct paraphrase of the review step."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->n9",
        "action:n9",
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected, it is reworked. However, if the Purchase Order is accepted, funds are reserved for payment."
      ],
      "justification": "Conditional decision modeled as an action step and XOR branch. Guards correctly map 'Rejected' to rework and 'Accepted' to fund reservation, preserving the branching logic."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After reserving funds for payment, the Purchase Order is sent to the Supplier."
      ],
      "justification": "Directly models the post-review supplier notification step."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: the Packing Slip is received and the Invoice is received."
      ],
      "justification": "AND branch correctly splits the flow to simultaneously receive both documents."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Upon receiving the Packing Slip, it is recorded."
      ],
      "justification": "Direct match for packing slip recording."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Similarly, upon receiving the Invoice, it is recorded."
      ],
      "justification": "Direct match for invoice recording."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Once the funds are released for payment, the payment is issued to the Supplier."
      ],
      "justification": "Sequentially models fund release followed by payment issuance, preserving the dependency order."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Finally, the process ends with the issuance of payment to the Supplier."
      ],
      "justification": "Structural convergence and terminal nodes combined with a redundant end action accurately reflect the process conclusion."
    }
  ],
