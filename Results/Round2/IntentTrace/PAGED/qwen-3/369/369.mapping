      "verbatim_texts": [
        "If pesto is available, retrieve it from the cupboard."
      ],
      "justification": "Opens the XOR decision, applies the positive condition, and executes the retrieval step."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If pesto is not available, take tomato sauce from your roommate."
      ],
      "justification": "Applies the negative condition on the same branch and executes the fallback retrieval step."
    },
    {
      "refs": [
        "action:n9",
