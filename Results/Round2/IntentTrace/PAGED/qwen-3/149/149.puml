@startuml
!theme plain
|a_default| Default
|a_default|
start
:Request to Purchase Motorcycle;
:v_ord: Order Status ({Production, Dispatch}); <<objectSignal>>
if () then ([v_ord = 'Production'])
:Continue Process if Production Order Received;
else ([v_ord = 'Dispatch'])
:Proceed to Order Dispatch;
endif
:v1: Material Status ({Unavailable, Available}); <<objectSignal>>
if () then ([v1 = 'Unavailable'])
:Order Materials from Supplier;
else ([v1 = 'Available'])
:Place Manufacturing Order;
endif
:Issue Goods and Produce Motorcycles;
split
:Update Stock and Dispatch Motorcycles;
split again
:Simultaneously Update Stock;
:Update Sales Information;
end split
stop
@enduml