    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "perform an availability check."
      ],
      "justification": "Direct paraphrase of the availability verification step."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\". If it is not, start producing the missing parts."
      ],
      "justification": "Decision on product availability. Guard correctly models the negative case, triggering production."
    },
    {
      "refs": [
        "guard:b2->c8",
        "action:n8"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process. Prepare the products for shipment."
      ],
      "justification": "Positive guard leads to convergence and the shipment preparation step."
    },
    {
      "refs": [
