      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "Initiates the process and covers the first two sequential actions."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them.",
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "XOR split handles customer eligibility. Guards capture both conditions accurately. Actions execute the corresponding outcomes."
    },
