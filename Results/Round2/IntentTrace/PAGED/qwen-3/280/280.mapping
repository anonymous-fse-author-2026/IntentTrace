{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "Implicit process start and initial action directly correspond to the opening unit."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Check Levels of Inventory"
      ],
      "justification": "Direct match for the first operational step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
      ],
      "justification": "Correctly opens the XOR decision, applies the accurate threshold guard (<= Minimum), and executes the corresponding report generation."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Captures the alternative branch guard (> Minimum) and the associated report generation step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Accurately models the termination path for the above-minimum scenario."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)"
      ],
      "justification": "Direct match for the PO creation step triggered when inventory is low."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Models the mandatory review step following PO creation."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Opens the approval/rejection split, sets the correct approval guard, and performs the print/release action."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Sets the correct rejection guard and models the required rework step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "AND gateway correctly bifurcates the parallel funding reservation and mailing tasks."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Correctly sequences packing slip receipt after fund reservation completes."
    },
    {
      "refs": [
        "label:n11->n13"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier"
      ],
      "justification": "Label captures the mailing transition condition; action captures the subsequent inventory receipt. Re-typing condition as label preserves behavior."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Label captures the mailing transition condition; action captures the subsequent inventory receipt. Re-typing condition as label preserves behavior."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Models the cross-path dependency where inventory arrival triggers packing slip processing."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Correctly chains packing slip arrival to invoice preparation."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Bridges invoice arrival to the matching phase setup."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Sequentially models the matching step followed by the conditional fund release, preserving the original logic."
    },
    {
      "refs": [
        "label:n18->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Label marks the post-release state; action executes the payment issuance. Behavior is fully preserved."
    },
    {
      "refs": [
        "label:n19->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Captures the final state label, completion marking, and main process termination node."
    }
  ],
