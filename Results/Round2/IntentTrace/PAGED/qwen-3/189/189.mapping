{
  "matches": [
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Captures process start, the initial inquiry, and the XOR split on yes/no responses."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Positive branch action matching the yes response."
    },
    {
      "refs": [
        "action:n4",
        "label:n4->c1"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Negative branch action; label is redundant directional text that does not alter behaviour."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "guard:b2->c3"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Second decision point and its corresponding yes/no split."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits."
      ],
      "justification": "Nested limit verification modeled as an action step followed by a branch; preserves decision flow."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "Branch taken when changes exceed limits."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process."
      ],
      "justification": "Branch taken when changes fall within limits."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Direct sequential step following the limit-check logic."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Acceptability verification and corresponding split."
    },
    {
      "refs": [
        "action:n17",
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "If they are, continue with the process."
      ],
      "justification": "Positive acceptance path."
    },
    {
      "refs": [
        "action:n18",
        "guard:b4->n18"
      ],
      "verbatim_texts": [
        "If not, select a new applicant from the list."
      ],
      "justification": "Negative acceptance path."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Client verification and split."
    },
    {
      "refs": [
        "action:n20",
        "guard:b5->n20"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Termination condition mapped to an explicit end node."
    },
    {
      "refs": [
        "action:n21",
        "guard:b5->n21"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Alternative path when client does not accept."
    }
  ],
