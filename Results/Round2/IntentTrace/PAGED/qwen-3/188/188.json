  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process for IT Infrastructure, start with the Loan Application and then proceed to Receive Loan Application."
    },
    {
      "id": "i2",
      "content": "check the Banking Privilege Status."
    },
    {
      "id": "i3",
      "content": "If there is a \"Construct Error Response\""
    },
    {
      "id": "i4",
      "content": "then the process ends with an \"Error Message\"."
    },
    {
      "id": "i5",
      "content": "Otherwise, if there is a \"Retrieve Customer Information\", check the fulfillment of loan conditions."
    },
    {
      "id": "i7",
      "content": "Otherwise, if there is a \"Calculate threshold amount\", continue with the process."
    },
    {
      "id": "i8",
      "content": "If there is a \"Check Creditworthiness\", designate the Status."
    },
    {
      "id": "i9",
      "content": "Once the Status is designated, initialize the Loan Form."
    },
    {
      "id": "i10",
      "content": "If there is a \"Construct Approve Response\""
    },
    {
      "id": "i11",
      "content": "then the process ends with an \"Approved Message\"."
    },
    {
      "id": "i12",
      "content": "Otherwise, if there is a \"Construct Reject Response\", then the process ends with a \"Reject Message\"."
    }
  ]
