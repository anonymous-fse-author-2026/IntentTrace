{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process for IT Infrastructure, start with the Loan Application and then proceed to Receive Loan Application."
      ],
      "justification": "Init node and first three actions directly capture the starting point and sequential steps described in the opening unit."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "check the Banking Privilege Status."
      ],
      "justification": "Direct match for the status check step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If there is a \"Construct Error Response\""
      ],
      "justification": "Branch and guard correctly model the condition for the error response path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then the process ends with an \"Error Message\"."
      ],
      "justification": "Action and end node correctly represent the termination via error message."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Otherwise, if there is a \"Retrieve Customer Information\", check the fulfillment of loan conditions."
      ],
      "justification": "Guard captures the alternative path condition; subsequent actions match retrieving info and checking fulfillment."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, if there is a \"Calculate threshold amount\", continue with the process."
      ],
      "justification": "Action correctly represents calculating the threshold amount."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If there is a \"Check Creditworthiness\", designate the Status."
      ],
      "justification": "Two actions correspond to checking creditworthiness and designating status."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the Status is designated, initialize the Loan Form."
      ],
      "justification": "Direct match for initializing the loan form."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If there is a \"Construct Approve Response\""
      ],
      "justification": "Action and branch correctly model the condition leading to the approval decision."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "then the process ends with an \"Approved Message\"."
      ],
      "justification": "Guard, action, and end node correctly represent the termination via approved message."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Otherwise, if there is a \"Construct Reject Response\", then the process ends with a \"Reject Message\"."
      ],
      "justification": "Actions, guard, and end node correctly model the rejection path and termination."
    }
  ],
