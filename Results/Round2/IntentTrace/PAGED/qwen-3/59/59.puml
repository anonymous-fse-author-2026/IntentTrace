@startuml
!theme plain
|a_default| Default
|a_default|
start
:Orders Required;
:place Bulk order;
:Order with prior internal credit allowance;
:v1: Order with prior internal credit allowance ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:process order for delivery;
else ([v1 = 'No'])
:Outstanding Balance;
:place new order;
:record in Accounts Receivable;
endif
:Payments are Received;
:v2: Payments are Received ({No, Yes}); <<objectSignal>>
if () then ([v2 = 'No'])
:drop order;
else ([v2 = 'Yes'])
:identify order for installation;
:installation needs to be scheduled;
:v3: installation needs to be scheduled ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:assign Installer;
else ([v3 = 'No'])
:pack for delivery;
endif
endif
stop
@enduml