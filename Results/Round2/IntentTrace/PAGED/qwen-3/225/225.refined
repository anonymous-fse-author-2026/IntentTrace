converge(c2)
branch(b3, AND)
defines(v1, "check inventory level", {"at_or_below", "above"})
defines(v2, "review purchase order", {"approved", "rejected"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, n_rej, e1, n6, b2, n7, n16, n8, n9, n10, n11, n12, n13, n14, n15, e2, c1, c2, b3])
