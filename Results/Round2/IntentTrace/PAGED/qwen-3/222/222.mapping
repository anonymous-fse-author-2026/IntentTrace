    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "then take it to the outbox."
      ],
      "justification": "Direct match for transferring the batch after processing."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "make sure to clear the outbox of the Data Entry Officer every hour.",
        "done every hour until the outbox is completely cleared"
      ],
      "justification": "Merges the recurring clearing task and its termination condition into a single behavioural step, preserving the required frequency and goal."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "done every hour until the outbox is completely cleared"
      ],
      "justification": "Models the loop's exit condition as a distinct check step; re-typing a condition as an action preserves behaviour and is a match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "which marks the end of the process."
      ],
      "justification": "Explicitly denotes process completion and aligns with the structural end node."
