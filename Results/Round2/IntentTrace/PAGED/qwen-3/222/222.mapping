      ],
      "justification": "Direct match for the fourth sequential step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the batched invoices are allocated to the Data Entry Officer and this is done by 9 am on the next working day."
      ],
      "justification": "Accurately captures the allocation action and its specific timing constraint."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "process the invoice batch",
