{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process"
      ],
      "justification": "Explicitly initiates the workflow. The generic 'start' action is a harmless structural duplicate."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Course Packet Information Received should be sent"
      ],
      "justification": "Direct paraphrase of the first substantive step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "followed by sending the Design to Faculty."
      ],
      "justification": "Captures the sequential ordering and the second sending step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After sending the Design to Faculty, the Faculty will choose the design."
      ],
      "justification": "Structural converge handles the post-sending flow; action captures the faculty selection step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "identify the content that requires copyright clearance"
      ],
      "justification": "Exact correspondence to the identification step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "contact the publisher to obtain clearance."
      ],
      "justification": "Direct match for the publisher contact step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If there is a need to \"Contact Faculty to inform of denial and ask if new content should be added\", then the process should be continued. However, if the \"Entire Course Packet Copyright Cleared\""
      ],
      "justification": "Models the copyright clearance decision point. Modeling the condition as an action step plus a branch preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If there is a need to \"Contact Faculty to inform of denial",
        "\"Contact Faculty to inform of denial and ask if new content should be added\"",
        "then the process should be continued."
      ],
      "justification": "Correctly captures the denial/negative condition and its routing."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If there is a need to \"Contact Faculty to inform of denial",
        "\"Contact Faculty to inform of denial and ask if new content should be added\"",
        "then the process should be continued."
      ],
      "justification": "Executes the required notification action on the denial path."
    },
    {
      "refs": [
        "guard:b1->n9"
      ],
      "verbatim_texts": [
        "if the \"Entire Course Packet Copyright Cleared\""
      ],
      "justification": "Captures the positive/cleared condition guarding the cost calculation path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "then the MPC should Calculate the Course Packet Cost."
      ],
      "justification": "Direct match for the cost calculation step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the MPC should add the Bookstore margin to determine the retail price."
      ],
      "justification": "Exact correspondence to the margin addition step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the Faculty needs to reconsider the course packet content to decrease the price, then the process should be continued. Alternatively, if the Price of the Course Packet is finalized"
      ],
      "justification": "Models the price finalization decision point. Action + branch re-typing preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "If the Faculty needs to reconsider the course packet content to decrease the price"
      ],
      "justification": "Captures the reconsideration condition routing back into the loop."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If the Faculty needs to reconsider the course packet content to decrease the price"
      ],
      "justification": "Models the re-evaluation step triggered by the reconsideration condition."
    },
    {
      "refs": [
        "guard:b2->n13"
      ],
      "verbatim_texts": [
        "if the Price of the Course Packet is finalized",
        "then the MPC should notify the Bookstore of the Course packet, Course number, Faculty name, and sections.",
        "Once the MPC notifies the Bookstore, the Packet information should be notified to the Bookstore"
      ],
      "justification": "Routes flow to the finalization notification when price is locked."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "if the Price of the Course Packet is finalized",
        "then the MPC should notify the Bookstore of the Course packet, Course number, Faculty name, and sections.",
        "Once the MPC notifies the Bookstore, the Packet information should be notified to the Bookstore"
      ],
      "justification": "Performs the bookstore notification. Includes the redundant restatement in i18, which does not change behaviour."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "and the process will end."
      ],
      "justification": "Marks the logical termination of the workflow."
    }
  ],
