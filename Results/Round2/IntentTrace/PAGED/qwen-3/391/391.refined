init(i1)
action(n2, "receive sealed shipment")
branch(b_reg, XOR)
action(a_reg, "register spare parts")
action(a_scan, "use barcode scanners")
converge(c_reg)
action(n4, "clear customs")
action(n5, "enter information into IT system")
action(n6, "end")
end(e1)
defines(v_reg, "registration_method", {"standard", "barcode"})
actor(a_default, "Default", [i1, n2, b_reg, a_reg, a_scan, c_reg, n4, n5, n6, e1])
precedence(i1, n2)
precedence(n2, b_reg)
precedence(b_reg, a_reg)
precedence(b_reg, a_scan)
precedence(a_reg, c_reg)
precedence(a_scan, c_reg)
precedence(c_reg, n4)
precedence(n4, n5)
precedence(n5, n6)
precedence(n6, e1)
guard(b_reg, a_reg, v_reg = 'standard')
guard(b_reg, a_scan, v_reg = 'barcode')
label(b_reg, a_reg, "standard registration")
label(b_reg, a_scan, "with barcode scanners")