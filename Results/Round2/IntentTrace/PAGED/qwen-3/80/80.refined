init(i1)
action(n1, "start booking service")
action(n2, "book a bus")
action(n3, "check bus availability")
action(n8, "receive necessary information")
action(n4, "is availability ok?")
branch(b1, XOR)
action(n5, "end booking process")
end(e1)
action(n6, "proceed to book the bus")
action(n7, "end booking process")
end(e2)
defines(v1, "is availability ok?", {"ok", "nok"})
actor(a_default, "Default", [i1, n1, n2, n3, n8, n4, b1, n5, e1, n6, n7, e2])
precedence(i1, n1)
precedence(n4, b1)
precedence(n5, e1)
precedence(n7, e2)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n8)
precedence(n8, n4)
precedence(b1, n5)
precedence(b1, n6)
precedence(n6, n7)
guard(b1, n5, v1 = 'nok')
guard(b1, n6, v1 = 'ok')