init(i1)
end(e_final)
action(n1, "Start process")
action(n2, "Items returned by customer or picked up by delivery crew")
branch(b1, XOR)
action(n17, "Continue via customer return")
action(n18, "Continue via delivery pickup")
converge(c2)
action(n3, "Count and compare items to contract")
action(n4, "Order status after count")
branch(b2, XOR)
action(n9, "Email customer damage and additional charges")
action(a_i9, "Items are packed for an existing order")
converge(c_m1)
action(a_i11, "Email customer missing items and replacement charges")
branch(b_cust, XOR)
action(a_i13, "Customer returns missing items")
action(a_i10, "Items are stored for future orders")
action(n10, "Temporarily remove damaged items from inventory")
converge(c_m3)
action(a_i14, "Customer does not return missing items")
converge(c_m2)
action(a_i15, "Finally, when the process is complete, it ends")
branch(b_repair, XOR)
action(n12, "Repair items and add to inventory")
action(n13, "Discard items and email customer replacement charges")
converge(c_repair)
action(n14, "Items disposition after repair")
branch(b_disp, XOR)
action(a_i20, "Items are packed for an existing order")
action(a_i21, "Items are stored for future orders")
converge(c_end)
action(a_i22, "Once again, when the process is complete, it ends")
action(a_i23, "Email customer with replacement charges")

