  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process,"
    },
    {
      "id": "i2",
      "content": "make sure the Freights are ready to be shipped"
    },
    {
      "id": "i3",
      "content": "then ship the freight."
    },
    {
      "id": "i4",
      "content": "At the same time, complete the following steps: deliver the freight and notify the delivery."
    },
    {
      "id": "i5",
      "content": "If the request for merchandise return is lodged, continue with the process."
    },
    {
      "id": "i6",
      "content": "If it has been 5 days"
    },
    {
      "id": "i7",
      "content": "invoice the customer."
    },
    {
      "id": "i8",
      "content": "If the return is accepted"
    },
    {
      "id": "i9",
      "content": "If the return is rejected"
    },
    {
      "id": "i10",
      "content": "reject the merchandise return."
    },
    {
      "id": "i11",
      "content": "If a loss claim report is lodged"
    },
    {
      "id": "i12",
      "content": "approve the loss claim and the process ends."
    },
    {
      "id": "i13",
      "content": "Invoice the customer and the process ends with the customer being invoiced."
    },
    {
      "id": "i14",
      "content": "Accept the merchandise return and proceed with returning the merchandise."
    },
    {
      "id": "i15",
      "content": "Reject the merchandise return and the process ends with the merchandise return request being rejected."
    },
    {
      "id": "i16",
      "content": "Return the merchandise and the process ends with the merchandise being returned."
    }
  ]
