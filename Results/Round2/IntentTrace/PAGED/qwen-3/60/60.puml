@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:click: Start;
:select: Edit Report;
:is expense > 1000?;
:v1: expense ({[0-]}); <<objectSignal>>
if () then ([v1 > 1000])
:review report;
else ([v1 <= 1000])
:check translation need;
:v2: translation status ({Required, Not required}); <<objectSignal>>
if () then ([v2 = 'Required'])
:translate receipts;
else ([v2 = 'Not required'])
:confirm receipts;
endif
endif
:evaluate review decision;
:v3: review decision ({Rejected, Approved}); <<objectSignal>>
if () then ([v3 = 'Approved'])
:check translation need again;
:evaluate review decision again;
:v6: second review decision ({Rejected, Approved}); <<objectSignal>>
if () then ([v6 = 'Approved'])
:translate receipts;
:confirm receipts;
:evaluate receipt decision;
:v5: receipt decision ({Accepted, Rejected}); <<objectSignal>>
if () then ([v5 = 'Accepted'])
:process expense;
:end;
else ([v5 = 'Rejected'])
:edit report;
:end;
stop
endif
else ([v6 = 'Rejected'])
:edit report;
endif
stop
else ([v3 = 'Rejected'])
->;
endif
@enduml