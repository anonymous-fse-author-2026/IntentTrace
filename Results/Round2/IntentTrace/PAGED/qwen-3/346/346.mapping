      ],
      "justification": "Negative arm outcome; structural convergence rejoins the flow without changing behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Direct correspondence to the sending step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
