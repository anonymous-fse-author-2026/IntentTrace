{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts with BUSINESS PROCESS REQUIREMENTS,"
      ],
      "justification": "The opening unit establishes the process start and the first requirement action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by SAP Configuration."
      ],
      "justification": "Directly captures the second sequential step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, it moves on to Communications Design."
      ],
      "justification": "Models the split into parallel tracks and the first design phase."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Then, it proceeds to Learning Design."
      ],
      "justification": "Captures the second parallel design track."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, it involves Data Conversion Design & Test."
      ],
      "justification": "Captures the third parallel design track."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the SAP Configuration is completed, it moves on to IT Design, Development & Functional Test."
      ],
      "justification": "Models the continuation of the IT track following SAP Configuration."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Similarly, after Communications Design, it moves on to Communications Deployment."
      ],
      "justification": "Captures the downstream step for the Communications track."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After Learning Design, it proceeds to Learning Deployment."
      ],
      "justification": "Captures the downstream step for the Learning track."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Following Data Conversion Design & Test, it moves on to Integration Test."
      ],
      "justification": "Joins the Data Conversion track into the Integration Test step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once IT Design, Development & Functional Test is completed, it proceeds to Integration Test."
      ],
      "justification": "Supports the same Integration Test step from the IT track, preserving the convergence behaviour."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After Communications Deployment, it moves on to Deployment."
      ],
      "justification": "Models the join of the Communications track into the final Deployment phase."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Similarly, after Learning Deployment, it proceeds to Deployment."
      ],
      "justification": "Supports the same Deployment step from the Learning track."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Following Integration Test, it moves on to Deployment."
      ],
      "justification": "Supports the same Deployment step from the Integration Test track."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Finally, after Deployment, it enters the PRODUCTION SUPPORT phase,"
      ],
      "justification": "Captures the final operational phase after deployment completes."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "and the process comes to an end."
      ],
      "justification": "Captures process termination; the 'End' action is a harmless restatement of the finishing point."
    }
  ],
