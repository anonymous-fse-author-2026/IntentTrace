  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "Start node and first action align with the opening unit."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum"
      ],
      "justification": "XOR gateway represents the conditional split."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "at or below the minimum, create a purchase order."
      ],
      "justification": "Positive branch condition and action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Negative branch condition and termination action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Direct paraphrase of review step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected"
      ],
      "justification": "XOR gateway for purchase status decision."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "is rejected, rework the purchase order."
      ],
      "justification": "Rejected path leads to rework."
    },
    {
      "refs": [
        "guard:b2->n23"
      ],
      "verbatim_texts": [
        "if the purchase status is approved"
      ],
      "justification": "Condition for the approved path."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Action on the approved path."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "AND gateway models the parallel execution signaled by the text."
    },
    {
      "refs": [
        "action:n16",
        "action:n18"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Split into receive and record steps, preserving order."
    },
    {
      "refs": [
        "action:n17",
        "action:n19"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Split into receive and record steps, preserving order."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends.",
        "Record the invoice and the process ends."
      ],
      "justification": "Join point where parallel paths conclude."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Termination point for the invoice path."
    }
