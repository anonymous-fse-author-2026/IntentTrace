{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Start node and initial actions directly correspond to the opening sequence."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Models the completeness check and the return path for incomplete invoices."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Captures the guard condition for complete invoices proceeding forward."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Models the compliance check and the branch leading to further checks for non-compliant invoices."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Captures the guard and action for compliant invoices continuing the process."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Decision and positive outcome for phone-based resolution are correctly modeled."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Negative outcome for mail-back requirement is captured via guard and descriptive action."
    },
    {
      "refs": [
        "action:n11",
        "action:n19"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Payment and non-compliance resolution steps are present, with convergence handling flow merging."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Billing action and associated split point correspond to the simultaneous step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Waiting period step preserves the described behavioural delay."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Notification action directly matches the source step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Reminder sending and process termination match the final timeline."
    },
    {
      "refs": [
        "guard:b9->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Decision branch and resolution action for unsatisfied clients are correctly captured."
    },
    {
      "refs": [
        "guard:b9->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Guard and action for satisfied clients continuing the process, plus structural convergences, match the source."
    }
  ],
