@startuml
!theme plain
|a1| Default
|a1|
start
:Bill for Purchased Goods/Services;
:Receive Invoice;
:Check Invoice Completeness;
:v1: Invoice Complete ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:Return Invoice: Incomplete;
stop
else ([v1 = 'Yes'])
:Check Invoice Compliance;
:v2: Invoice Compliant ({Non-Compliant, Compliant}); <<objectSignal>>
if () then ([v2 = 'Compliant'])
->;
else ([v2 = 'Non-Compliant'])
:Further Checks Conducted;
:Determine Resolution Method;
:v3: Resolution Method ({Phone, Mail}); <<objectSignal>>
if () then ([v3 = 'Phone'])
:Resolve Non-Compliance via Phone;
else ([v3 = 'Mail'])
:Return Invoice via Mail;
stop
endif
endif
:Pay Invoice;
:Bill Client;
:v5: Post-Billing Status ({No Response, Notified}); <<objectSignal>>
if () then ([v5 = 'No Response'])
:Wait for 10 Days;
:Send Reminder;
stop
else ([v5 = 'Notified'])
:Client Notified of Payment;
:Check Client Satisfaction;
:v4: Client Satisfaction ({Unsatisfied, Satisfied}); <<objectSignal>>
if () then ([v4 = 'Unsatisfied'])
:Resolve Payment Discrepancy;
stop
else ([v4 = 'Satisfied'])
:Continue Process;
:Send Reminder;
stop
endif
endif
endif
@enduml