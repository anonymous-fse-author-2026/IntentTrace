end(e1)
defines(v1, "check if the input is a URN", {"URN", "URL"})
defines(v2, "check if the input is a URN or a URL", {"URN", "URL"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, b2, n6, n7, c_merge, n8, n10, n12, n14, n16, e1])
precedence(i1, n1)
precedence(n2, b1)
