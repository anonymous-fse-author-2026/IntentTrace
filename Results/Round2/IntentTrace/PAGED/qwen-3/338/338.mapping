{
  "matches": [
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially, if the option \"research schedule directly\" is selected"
      ],
      "justification": "Initiates the process, models the option evaluation as an action and XOR branch, and captures the positive guard ('Yes' aligns with 'is selected')."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Directly models the first positive outcome action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Captures the negative guard ('No' aligns with 'not selected'), both resulting actions, and structurally converges the initial split paths."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Models the validation step, the satisfaction check, and the resulting XOR decision point."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9",
        "guard:b2->c2",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\". If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Maps the negative guard and associated action, plus the positive guard and ticket order action, with a structural convergence."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n23",
        "action:n23",
        "action:n11",
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\". If it is still not satisfactory, then \"provide indications\". Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Preserves the repeated satisfaction-loop logic, mapping the second check, branch, negative-path actions, and positive convergence guard exactly as described."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Direct match for the post-order validation step."
    },
    {
      "refs": [
        "action:n14",
        "guard:b4->n15",
        "action:n15",
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
      ],
      "justification": "Captures the first approval check, its failure branch/end point, and success branch/validation action."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->n18",
        "action:n18",
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
      ],
      "justification": "Mirrors the first approval cycle for the second check, preserving the repetitive behavior explicitly stated in the text."
    },
    {
      "refs": [
        "action:n20",
        "guard:b6->n21",
        "action:n21",
        "guard:b6->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved. If it is, then the process ends. If it is not, then the process ends."
      ],
      "justification": "Maps the final approval check and correctly models both outcomes leading to process termination, matching the source exactly."
    }
  ],
