{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "the process begins by receiving the invoice"
      ],
      "justification": "Process initiation and first action directly correspond to the opening unit."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is sorted per client"
      ],
      "justification": "Direct match for the first sorting step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor"
      ],
      "justification": "Direct match for the second sorting step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice"
      ],
      "justification": "Direct match for form attachment."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form"
      ],
      "justification": "Direct match for information entry."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked"
      ],
      "justification": "Checking action feeds directly into the subsequent XOR decision gateway."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Guard captures the 'not complete' condition, leading to the termination action and end node."
    },
    {
      "refs": [
        "guard:b1->n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered."
      ],
      "justification": "Guard captures the positive completeness condition."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered.",
        "The date for completion is also entered",
        "the priority is checked"
      ],
      "justification": "Single action step merges three sequential source steps. Merging preserves behavior."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the priority is checked"
      ],
      "justification": "Priority check action leads into the next XOR decision. Redundant with part of n9 but behaviorally consistent."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "High-priority guard and corresponding stamp action match the source."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Low-priority guard directs flow to a convergence point, preserving the continuation behavior."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Direct match for the compliance check step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If it is not complete, the check continues. If it is complete, the process continues."
      ],
      "justification": "Models the looping/continuation logic as an action step. Re-typing a condition as an action preserves behavior."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed.",
        "If it is a normal case, the client is called.",
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Branch opens the three-way routing decision covering all stated conditions."
    },
    {
      "refs": [
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Guard extracts the experienced staff condition."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Guard extracts the normal case condition."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Guard extracts the fallback/mail condition."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Executes the staff routing action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Executes the normal case routing action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Executes the mail action and correctly terminates via the end node as stated."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Direct match for the final client contact step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO"
      ],
      "justification": "Final batching action preceded by structural convergence. Preserves flow and termination."
    }
  ],
