@startuml
!theme plain
|a_default| Default
|a_default|
start
:start process;
:Orders Required;
:place Bulk order;
:v1: Credit Check ({Prior Allowance, Exceeds Allowance}); <<objectSignal>>
if () then ([v1 = 'Prior Allowance'])
:Order with prior internal credit allowance;
:process order for delivery;
else ([v1 = 'Exceeds Allowance'])
:Outstanding Balance;
:place new order;
endif
:record in Accounts Receivable;
:Payments Received;
:v2: Payment Receipt ({Received, Not Received}); <<objectSignal>>
if () then ([v2 = 'Received'])
:continue process;
:identify order for installation;
:installation required;
:v3: Installation Schedule ({Scheduled, Not Required}); <<objectSignal>>
if () then ([v3 = 'Scheduled'])
:assign Installer;
stop
else ([v3 = 'Not Required'])
:pack for delivery;
stop
endif
else ([v2 = 'Not Received'])
:drop order;
stop
endif
@enduml