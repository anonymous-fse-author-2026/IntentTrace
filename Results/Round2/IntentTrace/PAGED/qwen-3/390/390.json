  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start with Orders Required and then place a Bulk order."
    },
    {
      "id": "i2",
      "content": "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
    },
    {
      "id": "i6",
      "content": "a new order is placed and the process ends at the Warehouse."
    },
    {
      "id": "i7",
      "content": "it will be recorded in the Accounts Receivable."
    },
    {
      "id": "i8",
      "content": "If Payments are Received, the process continues."
    },
    {
      "id": "i11",
      "content": "the order is dropped"
    },
    {
      "id": "i12",
      "content": "identify the order for installation."
    },
    {
      "id": "i13",
      "content": "If the installation needs to be scheduled, an Installer will be assigned."
    },
    {
      "id": "i16",
      "content": "it will be packed for delivery."
    }
  ]
