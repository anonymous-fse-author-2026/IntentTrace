@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the procedure;
:do you desire new hair;
:visit the hairdresser;
:v1: service selection ({wash, cut, dry}); <<objectSignal>>
switch ()
case (["v1 = 'wash'"])
:do you want your hair washed;
:v2: want hair washed ({yes, no}); <<objectSignal>>
if () then (["v2 = 'yes'"])
:have your hair washed;
else (["v2 = 'no'"])
->;
endif
case (["v1 = 'cut'"])
:do you want your hair cut;
:v3: want hair cut ({yes, no}); <<objectSignal>>
if () then (["v3 = 'yes'"])
:have your hair cut;
else (["v3 = 'no'"])
->;
endif
case (["v1 = 'dry'"])
:do you want your hair dried;
:v4: want hair dried ({yes, no}); <<objectSignal>>
if () then (["v4 = 'yes'"])
:have your hair dried;
else (["v4 = 'no'"])
->;
endif
endswitch
:process complete you have obtained new hair;
stop
@enduml