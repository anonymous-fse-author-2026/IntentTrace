    {
      "id": "i1",
      "content": "To begin the process, the review clerk should start by reviewing the received application."
    },
    {
      "id": "i2",
      "content": "they should load the case data"
    },
    {
      "id": "i3",
      "content": "they should proceed to review the case"
    },
    {
      "id": "i4",
      "content": "they need to check if there are any new findings"
    },
    {
      "id": "i5",
      "content": "If the answer is yes, they should recalculate the refund"
    },
    {
      "id": "i6",
      "content": "if the answer is no, they should send a letter of denial"
    },
    {
      "id": "i7",
      "content": "they need to check again if there are any new findings"
    },
    {
      "id": "i8",
      "content": "If there are, they should recalculate the refund"
    },
    {
      "id": "i9",
      "content": "If not, they should send another letter of denial"
    },
    {
      "id": "i10",
      "content": "they should write back the case data and the process will come to an end"
    }
