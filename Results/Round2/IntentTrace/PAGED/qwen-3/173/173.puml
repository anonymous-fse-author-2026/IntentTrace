@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process by identifying the vacancy;
:Is there a suitable candidate available;
:v1: Is there a suitable candidate available ({Yes, No}); <<objectSignal>>
if () then ([v1 = "No"])
:advertise the vacancy;
:Is there a suitable candidate available;
else ([v1 = "Yes"])
:Is there a suitable candidate available;
endif
:v3: Is there a suitable candidate available ({Yes, No}); <<objectSignal>>
if () then ([v3 = "No"])
:advertise the vacancy again;
else ([v3 = "Yes"])
:select the appropriate applicant;
:appoint the candidate;
:process ends;
endif
stop
@enduml