{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by supplying the requirement and then documenting it."
      ],
      "justification": "Captures process initiation and the initial documentation step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the order is received via fax, input the order into an Excel file."
      ],
      "justification": "Correctly models the fax reception condition and corresponding Excel entry."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone, also input the order into an Excel file."
      ],
      "justification": "Correctly models the mail/phone reception condition and Excel entry."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the order is received via fax, input the order into an Excel file.",
        "If the order is received via mail or phone, also input the order into an Excel file."
      ],
      "justification": "XOR gateway splits the flow based on reception method; 'check order reception method' is a harmless re-typing of the implicit decision point."
    },
    {
      "refs": [
        "action:n35",
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete after a week, send it to the student."
      ],
      "justification": "Splits the timing condition and sending action into two steps, preserving behavior."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list, type the orders into the MS-Access database."
      ],
      "justification": "Directly maps receiving the list and entering data into the database."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed."
      ],
      "justification": "Combines completion verification, order control, and concurrent checking into compatible steps without changing flow."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the database is completed, control the incoming order."
      ],
      "justification": "Combines completion verification, order control, and concurrent checking into compatible steps without changing flow."
    },
    {
      "refs": [
        "action:n8a"
      ],
      "verbatim_texts": [
        "At the same time, continue to do the check."
      ],
      "justification": "Combines completion verification, order control, and concurrent checking into compatible steps without changing flow."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the order is correct, release it."
      ],
      "justification": "Correctly captures the positive outcome of the correctness check."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Correctly captures the negative outcome and subsequent agency contact."
    },
    {
      "refs": [
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac, release it."
      ],
      "justification": "Threshold (<5k\u20ac) and release action match the source."
    },
    {
      "refs": [
        "guard:b2->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "Threshold (>5k\u20ac) and sign-off/check actions match the source."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the order is correct, release it.",
        "However, if the order is incorrect, contact the selling agency.",
        "If the order is worth less than 5.000 \u20ac, release it.",
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "Merges two sequential decisions (correctness and value) into a single XOR gateway. This is a valid modeling choice that preserves all branching paths and outcomes."
    },
    {
      "refs": [
        "action:n14b"
      ],
      "verbatim_texts": [
        "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
      ],
      "justification": "Direct paraphrase of the agency follow-up and sign-off submission."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the order is signed off, contact the client and release the order."
      ],
      "justification": "Exact restatement of the post-sign-off steps."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "Direct match for production initiation."
    },
    {
      "refs": [
        "action:n33"
      ],
      "verbatim_texts": [
        "After PPC initiates production, the goods will be produced."
      ],
      "justification": "Direct match for goods production step."
    },
    {
      "refs": [
        "guard:b4->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order."
      ],
      "justification": "Correctly models the unsolvable path leading to cancellation."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the issue can be solved, release the order."
      ],
      "justification": "Correctly models the solvable path leading to release."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order.",
        "If the issue can be solved, release the order."
      ],
      "justification": "XOR gateway correctly splits solvable vs unsolvable outcomes."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends."
      ],
      "justification": "Models the cancellation decision, resulting action, and process termination."
    },
    {
      "refs": [
        "guard:b5->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If not, check the quality of the goods."
      ],
      "justification": "Models the non-cancellation path leading to quality inspection."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends.",
        "If not, check the quality of the goods."
      ],
      "justification": "XOR gateway correctly handles cancel vs proceed logic."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "justification": "Direct match for quality reporting."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "justification": "Splits the combined instruction into releasing the order and verifying warehouse receipt. Behavior preserved."
    },
    {
      "refs": [
        "action:n23w"
      ],
      "verbatim_texts": [
        "ensure that the memo is achieved in the warehouse"
      ],
      "justification": "Splits the combined instruction into releasing the order and verifying warehouse receipt. Behavior preserved."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "justification": "Condenses invoicing and finance reporting into a single matched action."
    },
    {
      "refs": [
        "action:n29",
        "action:n30"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods and sign and send the memo."
      ],
      "justification": "Maps commissioning and memo signing/sending to compatible steps."
    },
    {
      "refs": [
        "action:n34"
      ],
      "verbatim_texts": [
        "Also, send the goods and ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "Captures goods dispatch (logistics memo tracking is structurally handled elsewhere)."
    },
    {
      "refs": [
        "action:n31",
        "action:n32"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order."
      ],
      "justification": "Splits archiving and closing into two sequential actions, preserving behavior."
    }
  ],
