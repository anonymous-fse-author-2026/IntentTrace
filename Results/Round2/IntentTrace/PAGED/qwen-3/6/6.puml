@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:ask the 1st Level Support if there is an issue;
:is issue resolved;
:v1: is issue resolved ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:provide feedback for the account manager;
else ([v1 = 'No'])
:ask the developer for assistance;
:check result again is issue resolved;
:v2: check result again is issue resolved ({Yes, No, Other}); <<objectSignal>>
switch ()
case ([v2 = 'Yes'])
:provide feedback for the account manager;
case ([v2 = 'No'])
:ask the developer for help;
:provide feedback for the account manager;
stop
case ([v2 = 'Other'])
:ask the developer;
:provide feedback for the 1st Level support;
stop
endswitch
endif
:provide feedback for the 1st Level support;
:provide feedback for the account manager;
stop
@enduml