{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by checking the customer's order."
      ],
      "justification": "Initial trigger and first action captured correctly."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer is a registered customer, then check their payment morale."
      ],
      "justification": "Registered customer branch and corresponding check action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they are a new customer, then check their status."
      ],
      "justification": "New customer branch and status check action."
    },
    {
      "refs": [
        "guard:b1->n28",
        "action:n28",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the customer is a wholesaler, enter their data and take the order."
      ],
      "justification": "Condition modeled as action node followed by data entry and order taking. Behaviour preserved."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If their payment morale is good, continue with the process."
      ],
      "justification": "Checks morale condition and routes to continuation path."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->c1",
        "guard:b3->c1",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If their payment morale is bad or if they are an end customer, reject the order and end the process."
      ],
      "justification": "Covers both rejection conditions, the rejection action, and process termination points."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, check the availability of the items."
      ],
      "justification": "AND gateway and action correctly model simultaneous execution."
    },
    {
      "refs": [
        "action:n13",
        "guard:b4->n14",
        "action:n14",
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the items are out of stock, start production. If they are in stock, continue with the process."
      ],
      "justification": "Branches on stock status with correct actions for both arms."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Once the availability is checked, send the order confirmation."
      ],
      "justification": "Direct match for sending confirmation after availability check."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If production is started, produce the article and send the order confirmation."
      ],
      "justification": "Splits combined step into two sequential actions. Behaviour preserved."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Simultaneously, send the invoice and deliver the product."
      ],
      "justification": "Models simultaneous steps; converge nodes handle flow rejoinder."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "Check the payment status."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n20",
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If payment is received, close the order."
      ],
      "justification": "Checks payment condition and closes order on positive outcome."
    },
    {
      "refs": [
        "guard:b5->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If no payment is received, check the number of reminders."
      ],
      "justification": "Negative payment path leading to reminder count check."
    },
    {
      "refs": [
        "guard:b6->n24",
        "action:n24",
        "action:n23",
        "action:n25"
      ],
      "verbatim_texts": [
        "If there are more than three reminders, engage a lawyer."
      ],
      "justification": "Branches on reminder count > 3 and engages lawyer, ending this path."
    },
    {
      "refs": [
        "guard:b6->n26",
        "action:n26",
        "action:n27"
      ],
      "verbatim_texts": [
        "If there are three or fewer reminders, send a reminder."
      ],
      "justification": "Branches on <= 3 reminders and sends reminder, ending this path."
    }
  ],
