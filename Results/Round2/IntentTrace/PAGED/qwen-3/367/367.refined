init(i1)
action(n1, "start")
action(n2, "initiate new resupply cycle")
action(n3, "check levels of inventory")
branch(b1, XOR)
action(n5, "generate above minimum report")
action(n6, "the process ends")
end(e1)
action(n7, "generate equal to or below minimum report")
converge(c2)
action(n8, "create Purchase Orders (POs)")
action(n9, "review POs")
branch(b2, XOR)
action(n10, "rework PO")
action(n11, "print and release POs")
branch(b3, AND)
action(n12, "reserve funds for released POs")
action(n13, "mail POs to supplier")
action(n14, "receive inventory")
converge(c1)
action(n15, "receive Packing Slip")
action(n16, "receive Invoice")
action(n17, "Three-way match")
action(n18, "release funds")
action(n19, "issue payment")
action(n20, "the Resupply Cycle is complete")
end(e2)
defines(v1, "inventory_status", {"below_or_equal", "above"})
defines(v2, "PO_status", {"Rejected", "Approved"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n5, n6, e1, n7, c2, n8, n9, b2, n10, n11, b3, n12, n13, n14, c1, n15, n16, n17, n18, n19, n20, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, e1)
precedence(b1, n7)
precedence(n7, c2)
precedence(c2, n8)
precedence(n8, n9)
precedence(n9, b2)
precedence(b2, n10)
precedence(n10, c2)
precedence(b2, n11)
precedence(n11, b3)
precedence(b3, n12)
precedence(b3, n13)
precedence(n12, c1)
precedence(n13, n14)
precedence(n14, c1)
precedence(c1, n15)
precedence(n15, n16)
precedence(n16, n17)
precedence(n17, n18)
precedence(n18, n19)
precedence(n19, n20)
precedence(n20, e2)
guard(b1, n5, v1 = 'above')
guard(b1, n7, v1 = 'below_or_equal')
guard(b2, n10, v2 = 'Rejected')
guard(b2, n11, v2 = 'Approved')