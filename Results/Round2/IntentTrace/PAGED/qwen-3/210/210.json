  "input_elements": [
    {
      "id": "i1",
      "content": "For the customer, the process begins with a request to purchase a motorcycle."
    },
    {
      "id": "i2",
      "content": "continue the process if a production order is received"
    },
    {
      "id": "i3",
      "content": "production order is received"
    },
    {
      "id": "i4",
      "content": "or update the sales information and proceed to order dispatch."
    },
    {
      "id": "i5",
      "content": "If there are unavailable materials, they are ordered from the supplier."
    },
    {
      "id": "i6",
      "content": "Alternatively, if there are available goods for production, a manufacturing order is placed."
    },
    {
      "id": "i7",
      "content": "Once the materials are received from the supplier,"
    },
    {
      "id": "i8",
      "content": "the goods are issued"
    },
    {
      "id": "i9",
      "content": "and the motorcycles are produced."
    },
    {
      "id": "i11",
      "content": "the stock is updated and the motorcycles are dispatched."
    },
    {
      "id": "i12",
      "content": "After the goods are issued and the motorcycles are produced, the stock is updated"
    },
    {
      "id": "i13",
      "content": "and the process ends."
    },
    {
      "id": "i15",
      "content": "the sales information is updated"
    }
  ]
}