        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting"
      ],
      "justification": "The opening unit implicitly starts the process and describes the initial starting action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "entering the metadata"
      ],
      "justification": "Directly corresponds to the metadata entry step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to the IN-Patient step"
      ],
      "justification": "Models the transition to the IN-Patient step."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "send data to suppliers and create a claim"
      ],
      "justification": "Split compound instruction into two separate actions, preserving the original behaviour."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the data is sent to suppliers, extract the data from the suppliers and transfer it to the doctor's phone"
      ],
      "justification": "Accurately captures the data extraction and transfer to the doctor."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "confirm the GOP"
      ],
      "justification": "Direct paraphrase of the confirmation step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the process will come to an end"
      ],
      "justification": "Faithfully restates the intermediate conclusion mentioned in the source text."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "register the case and handle the claim"
      ],
      "justification": "Split compound step into registration and handling actions."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers"
      ],
      "justification": "Matches the second extraction step described in the source."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "enter it on the patient's record or confirm the IN-Patient status"
      ],
      "justification": "Directly aligns with the record entry or status confirmation option."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "send the data back to the suppliers"
      ],
      "justification": "Matches the data return step."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, receive the payment and conclude the process"
      ],
      "justification": "Covers the final payment receipt, process conclusion, and terminal end node."
    }
