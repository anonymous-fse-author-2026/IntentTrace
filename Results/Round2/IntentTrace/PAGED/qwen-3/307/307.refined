init(start_node)
action(i1, "To begin the validation process, start by checking the received invoice for any errors")
action(i4, "Simultaneously")
branch(b1, OR)
action(i2, "If any errors are found, continue with the process")
action(i3, 'If no errors are found, mark the "invoice entered correctly" box')
action(i5, "highlight any errors on the invoice entry form and keep a record of the DEO's performance")
converge(c1)
action(i6, "the process ends")
end(e1)
defines(v1, "check for errors", {"Yes", "No"})
actor(a_default, "Default", [start_node, i1, i4, b1, i2, i3, i5, c1, i6, e1])
precedence(start_node, i1)
precedence(i1, i4)
precedence(i4, b1)
precedence(b1, i2)
precedence(b1, i3)
precedence(b1, i5)
precedence(i2, c1)
precedence(i3, c1)
precedence(i5, c1)
precedence(c1, i6)
precedence(i6, e1)
guard(b1, i2, v1 = 'Yes')
guard(b1, i3, v1 = 'No')
guard(b1, i5, v1 = 'Yes')