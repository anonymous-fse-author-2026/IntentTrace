@startuml
!theme plain
|a_default| Default
|a_default|
start
:initiate rector's final year;
:launch acceptance of proposals for candidates;
:nominate as candidate;
:stop acceptance of proposals;
:check if candidate meets criteria;
:v1: check if candidate meets criteria ({Meets Criteria, Does not meet criteria}); <<objectSignal>>
if () then ([v1 = 'Meets Criteria'])
:include in list of candidates;
:form public list of candidates;
split
:make list public;
split again
:promote ideas to public;
split again
:organize public meeting of Academic Senate;
end split
:conduct public meeting of Academic Senate;
repeat :;
:conduct election;
:count votes;
:v2: check if voting successful ({Successful, Failed}); <<objectSignal>>
backward:repeat election process;
repeat while () is ([v2 = 'Failed']) not ([v2 = 'Successful'])
:announce election results;
:conclude public meeting and inform candidate;
stop
else ([v1 = 'Does not meet criteria'])
:inform of refusal and end process;
stop
endif
@enduml