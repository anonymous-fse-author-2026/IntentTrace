    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the Expense Report process, start by receiving the expense report."
      ],
      "justification": "The opening unit implicitly starts the process and describes the initial receipt action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "verify the account and review the report."
      ],
      "justification": "Direct paraphrase of the verification and review step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the report is accepted,"
      ],
      "justification": "Introduces the XOR decision point and captures the positive condition. The guard abstracts the text to v1='Yes', which preserves the decision behaviour."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed with processing the reimbursement."
      ],
      "justification": "Executes the reimbursement step on the accepted path."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "if the report is rejected,"
      ],
      "justification": "Captures the negative condition on the alternative edge. Abstracted to v1='No' but behaviourally equivalent to the source."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "send an Expense Rejection Notification"
      ],
      "justification": "Sends the rejection notice on the negative path."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "and end the process."
      ],
      "justification": "Terminates the process after rejection."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "proceed with the payment"
      ],
      "justification": "Proceeds with payment following successful reimbursement."
    },
    {
      "refs": [
        "label:n6->e1"
      ],
      "verbatim_texts": [
        "end the process."
      ],
      "justification": "Labels the transition and terminates the process after payment. Restating the ending condition on the edge does not change behaviour, so it is a match."
    }
  ],
