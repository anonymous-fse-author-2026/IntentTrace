{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am"
      ],
      "justification": "Initiates the process and captures the starting time condition."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then empty the mailbox."
      ],
      "justification": "Directly models the second step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty,",
        "if not, continue the process.",
        "If it is empty, the process ends."
      ],
      "justification": "Models the first conditional check: if empty ends, if not continues. Guards correctly map the yes/no outcomes."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty,",
        "if not, continue the process.",
        "If it is empty, the process ends."
      ],
      "justification": "Models the first conditional check: if empty ends, if not continues. Guards correctly map the yes/no outcomes."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty,",
        "if not, continue the process.",
        "If it is empty, the process ends."
      ],
      "justification": "Models the first conditional check: if empty ends, if not continues. Guards correctly map the yes/no outcomes."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty,",
        "if not, continue the process.",
        "If it is empty, the process ends."
      ],
      "justification": "Models the first conditional check: if empty ends, if not continues. Guards correctly map the yes/no outcomes."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1b->e1",
        "guard:b1b->n6"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again,"
      ],
      "justification": "Models the second identical check with appropriate branching to end or proceed."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Captures the verification step and opens the subsequent decision."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Positive branch outcome correctly mapped."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Negative branch outcome correctly mapped."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Post-call step and convergence point correctly modeled."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Directly captures the scheduled transfer step."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Positive membership decision branch and action."
    },
    {
      "refs": [
        "guard:b3->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Negative membership decision branch, notification action, and process termination."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Follow-up action after stamping directly captured."
    },
    {
      "refs": [
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles.",
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Models the concurrent/subsequent steps of fee calculation, handing over, and register updates. Structural split preserves behaviour."
    },
    {
      "refs": [
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles.",
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Models the concurrent/subsequent steps of fee calculation, handing over, and register updates. Structural split preserves behaviour."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles.",
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Models the concurrent/subsequent steps of fee calculation, handing over, and register updates. Structural split preserves behaviour."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles.",
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Models the concurrent/subsequent steps of fee calculation, handing over, and register updates. Structural split preserves behaviour."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Hand the letter to Charles and add the new member to the register."
      ],
      "justification": "Direct match for the handover and registration update."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Prepare an invoice for the new members and continue the process."
      ],
      "justification": "Direct match for invoice preparation."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register and write the fee amount to the register."
      ],
      "justification": "Direct match for final register writing instruction."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Direct match for card printing and mailing."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Explicit process termination step and end node."
    }
  ],
