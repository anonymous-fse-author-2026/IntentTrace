init(i1)
action(n1, "Start receiving the claim")
action(n2, "Create and record the claim")
action(n3, "Make decision on the claim")
branch(b1, XOR)
action(n4, "Reject the claim")
action(n5, "Offer the benefit")
action(n6, "Review the claim rejection")
branch(b2, XOR)
action(n7, "If the claim rejection is accepted, continue the process")
action(n8, "But if the claim rejection is not accepted, also continue the process")
action(n9, "Prepare the claim discharge")
action(n10, "Record the benefit payment")
converge(c_rej)
converge(c_main)
branch(b_final, XOR)
branch(b_pay, AND)
action(n12, "Operate outgoing payment")
action(n13, "Close the claim")
converge(c_pay)
action(n14, "Finally, the process ends")
end(e1)
defines(v1, "Make decision on the claim", {"Reject", "Accept"})
defines(v2, "Claim rejection review result", {"Accepted", "Not Accepted"})
defines(v3, "Final process step", {"End", "PayClose"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, n6, b2, n7, n8, n9, n10, c_rej, c_main, b_final, b_pay, n12, n13, c_pay, n14, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, n6)
precedence(n6, b2)
precedence(b2, n7)
precedence(b2, n8)
precedence(n5, n9)
precedence(n9, n10)
precedence(n7, c_rej)
precedence(n8, c_rej)
precedence(c_rej, c_main)
precedence(n10, c_main)
precedence(c_main, b_final)
precedence(b_final, n14)
precedence(b_final, b_pay)
precedence(b_pay, n12)
precedence(b_pay, n13)
precedence(n12, c_pay)
precedence(n13, c_pay)
precedence(c_pay, e1)
precedence(n14, e1)
guard(b1, n4, v1 = 'Reject')
guard(b1, n5, v1 = 'Accept')
guard(b2, n7, v2 = 'Accepted')
guard(b2, n8, v2 = 'Not Accepted')
guard(b_final, n14, v3 = 'End')
guard(b_final, b_pay, v3 = 'PayClose')