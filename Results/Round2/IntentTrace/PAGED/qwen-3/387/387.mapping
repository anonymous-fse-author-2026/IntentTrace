{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle"
      ],
      "justification": "Models the implicit process start and the initial trigger action. Redundant typing of start logic is behaviour-preserving."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "and then check the inventory level. If the inventory level"
      ],
      "justification": "Captures the sequential actions of triggering resupply continuation and checking inventory."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "is at or below the minimum"
      ],
      "justification": "Opens the first XOR decision and correctly applies the 'at or below' threshold guard."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "create a purchase order"
      ],
      "justification": "Directly matches the positive arm action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Captures the 'above' guard, the termination logic (modeled as an action step), and the terminal node."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Direct match for the review step following PO creation."
    },
    {
      "refs": [
        "action:n7",
        "action:n9"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Redundant restatement of the rework-and-review loop already captured by n7 and n9. Behaviour is preserved."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected"
      ],
      "justification": "Opens the second XOR decision and correctly applies the 'rejected' status guard."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "rework the purchase order"
      ],
      "justification": "Directly matches the rework action on rejection."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "if the purchase status is approved, reserve the funds."
      ],
      "justification": "Correctly models the 'approved' guard and the subsequent fund reservation."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "send the order to the supplier."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Correctly identifies concurrent execution as an AND gateway."
    },
    {
      "refs": [
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Splits the compound instruction into receive and record steps, preserving behaviour."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Maps the completion and termination of the packing slip sub-process."
    },
    {
      "refs": [
        "action:n16",
        "action:n18"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Splits the compound instruction into receive and record steps, preserving behaviour."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Maps the completion and termination of the invoice sub-process."
    }
