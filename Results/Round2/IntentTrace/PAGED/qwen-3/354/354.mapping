      ],
      "justification": "Structural rejoin point for the two parallel check paths described in the source."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission, they should leave the area.",
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Structural split point capturing the post-check permission decision."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission, they should leave the area."
      ],
      "justification": "Negative arm condition and resulting action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Positive arm condition and resulting action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends."
      ],
      "justification": "Restates the unsuccessful outcome handling and process termination."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Restates the successful outcome handling and process termination."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends.",
        "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Final convergence point for the two outcome paths."
    },
    {
