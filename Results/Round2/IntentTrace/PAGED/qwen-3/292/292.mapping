{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "Initiates the process and captures the first step of receiving the claim."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Directly models the creation and recording step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "Models the decision-making step preceding the first branch."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "Opens the XOR branch for the negative outcome and executes the rejection action."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "Captures the positive outcome guard and the corresponding benefit-offering action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Models the post-rejection review step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Models the preparation of the claim discharge."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Models the recording of the benefit payment."
    },
    {
      "refs": [
        "guard:b2->n15"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process."
      ],
      "justification": "Opens the second XOR branch and captures the guard for the accepted rejection path."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Captures the guard for the non-accepted rejection path, routing to the subsequent steps."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Models the explicit termination action, the end node, and the convergence point."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "Models the two final steps and their convergence."
    }
  ],
