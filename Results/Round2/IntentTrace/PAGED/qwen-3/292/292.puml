@startuml
!theme plain
|a_default| Default
|a_default|
start
:receive claim;
:create and record claim;
:decide on claim;
:v1: decide on claim ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:reject claim;
:review claim rejection;
else ([v1 = 'Yes'])
:offer benefit;
:prepare discharge;
:record benefit payment;
endif
:v2: payment path ({No, Yes}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:operate outgoing payment;
:close claim;
else ([v2 = 'No'])
:process ends;
endif
stop
@enduml