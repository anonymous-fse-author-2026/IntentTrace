{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Captures the initiation of the process and the initial UI interaction steps."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "Models the first conditional split correctly; condition modeled as an action plus a guard preserves the > 1000 threshold and review step."
    },
    {
      "refs": [
        "guard:b1->c1",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Correctly captures the <= 1000 alternative branch and directs flow to the translation check."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9",
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts. If not, confirm the receipts."
      ],
      "justification": "Accurately models the translation requirement decision and its two outcomes."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "First evaluation of the review decision modeled as an action followed by a split."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report. If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Correctly routes rejected reports to editing and approved reports back to the translation check convergence."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Second evaluation step matches the source text repetition."
    },
    {
      "refs": [
        "guard:b4->c3",
        "action:n12",
        "guard:b4->n20",
        "guard:n20->c3",
        "guard:n20->n13",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report. If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Models the second review decision outcome correctly; redundant guards for rejection do not alter behaviour."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Captures the final evaluation step before receipt handling."
    },
    {
      "refs": [
        "guard:b5->n16",
        "action:n16",
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense. If they are rejected, edit the report."
      ],
      "justification": "Correctly implements the accepted/rejected receipt logic and convergence point."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Structural end nodes and explicit End actions faithfully represent the process termination."
    }
  ],
