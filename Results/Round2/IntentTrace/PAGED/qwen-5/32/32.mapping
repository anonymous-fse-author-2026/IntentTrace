      ],
      "verbatim_texts": [
        "the process begins by entering expenses."
      ],
      "justification": "Start node and first action step correspond to the opening phrase describing the initial expense entry."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "generate a spreadsheet"
      ],
      "justification": "Direct paraphrase of the second step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the request can be approved or disapproved."
      ],
      "justification": "Models the first approval decision point as an action followed by an XOR gateway, preserving the branching behaviour."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the request is approved"
      ],
      "justification": "Captures the positive approval condition leading to payout."
    },
    {
      "refs": [
        "guard:b1->n1"
      ],
      "verbatim_texts": [
        "If the request is not approved, the process goes back to entering expenses."
      ],
      "justification": "Captures the negative approval condition and the structural join that loops back to the start."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "expenses can be paid out."
      ],
      "justification": "Direct match for the payout step following the first approval."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Models the second approval check as an action and XOR gateway, preserving the repeated decision logic."
    },
    {
      "refs": [
        "guard:b2->n1"
      ],
      "verbatim_texts": [
        "If it is not approved, the process goes back to entering expenses."
      ],
      "justification": "Captures the second disapproval path looping back to expense entry."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "But if it is approved"
      ],
      "justification": "Captures the second approval condition leading toward process completion."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Finally, after the expenses are paid out, the process comes to an end."
      ],
      "justification": "Action and end node together model the final termination of the process."
    }
  ],
