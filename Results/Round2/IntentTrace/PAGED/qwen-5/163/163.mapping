        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "Process initiation and the first action step directly correspond to the opening unit."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed to the IN-Patient step."
      ],
      "justification": "Direct copy of the second step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "At the same time,"
      ],
      "justification": "Captures the explicit concurrency/temporal signal in the text via an AND gateway."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "send data to suppliers and create a claim."
      ],
      "justification": "Direct copy of the concurrent task description."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the data is sent to suppliers, extract the data from the suppliers and transfer it to the doctor's phone."
      ],
      "justification": "Direct copy of the subsequent extraction and transfer step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "confirm the GOP and the process will come to an end."
      ],
      "justification": "Direct copy of the confirmation and early termination signal."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Next, register the case and handle the claim."
      ],
      "justification": "Direct copy of the registration and claim handling step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Create a claim and handle the claim accordingly."
      ],
      "justification": "Direct copy of the alternative/redundant claim handling instruction, preserving behaviour."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status."
      ],
      "justification": "Direct copy of the data entry/status confirmation step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Register the case, handle the claim, and then receive the payment."
      ],
      "justification": "Direct copy of the combined registration, claim handling, and payment step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Enter the data on the patient's record or confirm the IN-Patient status, and then send the data back to the suppliers."
      ],
      "justification": "Direct copy of the record update and supplier feedback step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Finally, receive the payment and conclude the process."
      ],
      "justification": "Final payment reception and process conclusion directly map to the terminal step and end node."
    }
