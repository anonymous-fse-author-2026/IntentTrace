init(i1)
action(n1, "start process")
action(n2, "Select filter")
action(n3, "Apply filter")
action(n4, "Click Submit button")
action(n5, "Is submit option false")
branch(b1, XOR)
action(n6, "Apply another filter")
action(n10, "continue with the process")
converge(c1)
action(n7, "Is there another filter to apply")
branch(b2, XOR)
action(n8, "verify final submission")
branch(b3, XOR)
action(n9, "continue with the process")
end(e1)
defines(v1, "Is submit option false", {"false", "true"})
defines(v2, "Is there another filter to apply", {"yes", "no"})
defines(v3, "Is submit option true", {"true", "false"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, b1, n6, n10, c1, n7, b2, n8, b3, n9, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, n5)
precedence(n5, b1)
precedence(b1, n6)
precedence(b1, c1)
precedence(n6, c1)
precedence(c1, n10)
precedence(n10, n7)
precedence(n7, b2)
precedence(b2, n8)
precedence(b2, c1)
precedence(n8, b3)
precedence(b3, n9)
precedence(b3, e1)
guard(b1, n6, v1 = 'false')
guard(b1, c1, v1 = 'true')
guard(b2, n8, v2 = 'no')
guard(b2, c1, v2 = 'yes')
guard(b3, n9, v3 = 'true')
guard(b3, e1, true)