      ],
      "verbatim_texts": [
        "To begin the process, start by checking the order received"
      ],
      "justification": "The opening unit establishes the process start and the initial checking step. The explicit 'Start process' action is a harmless structural restatement."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to check the availability of the article."
      ],
      "justification": "Direct paraphrase of the first availability check step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the article is not available,"
      ],
      "justification": "Captures the first decision point and the negative condition. The variable-based guard abstracts 'not available' to 'v1 = No' without changing behaviour."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "initiate the procurement process"
      ],
      "justification": "Matches the action taken when the article is initially unavailable."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if the article is available, proceed to ship it."
      ],
      "justification": "Captures the positive condition and the subsequent shipping action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After shipping the article, check its availability again."
      ],
      "justification": "Direct match for the post-shipment recheck step."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If it is still not available,"
      ],
      "justification": "Opens the second decision point and captures the negative condition for the recheck."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "initiate the procurement process."
      ],
      "justification": "Matches the procurement step triggered by the second unavailability check."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "Otherwise, proceed to ship the article."
      ],
      "justification": "Captures the fallback condition and the subsequent shipping action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "complete the financial settlement."
      ],
      "justification": "Direct match for the financial settlement step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "the process ends with the receipt of payment."
      ],
      "justification": "Captures the final step and explicitly marks the process termination points."
    }
