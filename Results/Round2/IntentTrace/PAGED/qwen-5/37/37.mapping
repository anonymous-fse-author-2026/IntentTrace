{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Captures the implicit process start and the first explicit action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Check the Customer's Credit Limit"
      ],
      "justification": "Models the credit check, the XOR split, and both conditional paths correctly."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\""
      ],
      "justification": "Models the credit check, the XOR split, and both conditional paths correctly."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the response is \"No\""
      ],
      "justification": "Models the credit check, the XOR split, and both conditional paths correctly."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article"
      ],
      "justification": "Directly matches the positive credit path action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "send a Denial to the Customer"
      ],
      "justification": "Handles the negative credit path and its implicit termination."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If the Article is not available"
      ],
      "justification": "Correctly splits based on article availability, executes the corresponding production/collection steps, and rejoins the flow. Transitional fragments i7-i9 carry no distinct behavioural meaning beyond this decision and are treated as noise."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "proceed to Produce the Goods"
      ],
      "justification": "Correctly splits based on article availability, executes the corresponding production/collection steps, and rejoins the flow. Transitional fragments i7-i9 carry no distinct behavioural meaning beyond this decision and are treated as noise."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "if the Article is available"
      ],
      "justification": "Correctly splits based on article availability, executes the corresponding production/collection steps, and rejoins the flow. Transitional fragments i7-i9 carry no distinct behavioural meaning beyond this decision and are treated as noise."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "proceed to Collect the Goods"
      ],
      "justification": "Correctly splits based on article availability, executes the corresponding production/collection steps, and rejoins the flow. Transitional fragments i7-i9 carry no distinct behavioural meaning beyond this decision and are treated as noise."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Direct match for the confirmation step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Ship the Goods"
      ],
      "justification": "Models the parallel execution of shipping and invoicing. i15 is a pure announcer and omitted."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Send the Invoice"
      ],
      "justification": "Models the parallel execution of shipping and invoicing. i15 is a pure announcer and omitted."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Checks payment status and branches correctly based on receipt."
    },
    {
      "refs": [
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "If the payment has been received"
      ],
      "justification": "Checks payment status and branches correctly based on receipt."
    },
    {
      "refs": [
        "guard:b4->n19"
      ],
      "verbatim_texts": [
        "If the payment has not been received"
      ],
      "justification": "Checks payment status and branches correctly based on receipt."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "close the Order and end the process."
      ],
      "justification": "Covers the order closure and process termination upon payment receipt."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "check if the Reminder count is greater than or equal to 3"
      ],
      "justification": "Represents the reminder threshold check as an action step, preserving behaviour."
    },
    {
      "refs": [
        "guard:b5->n20",
        "guard:b5->n21"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3"
      ],
      "justification": "Branches correctly based on whether the reminder count meets the threshold."
    },
    {
      "refs": [
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "Write off the Order"
      ],
      "justification": "Handles the write-off, subsequent closure, and termination for the high-reminder-count path."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Handles the reminder dispatch and branch termination when the count is below the threshold."
    }
  ],
