{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Initiates the process and captures the initial condition modeled as an action step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Branches on the answer, guard matches the 'Yes' condition, and action performs the discussion."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Guard handles the 'Otherwise' path and structural convergence preserves flow."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Action models the check condition; guard handles the implicit negative path continuing the flow."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits."
      ],
      "justification": "Branches on 'Yes', guard directs flow, and action represents the limit check condition."
    },
    {
      "refs": [
        "guard:b3->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "Handles the negative limit case with correct branching and corresponding action."
    },
    {
      "refs": [
        "guard:b3->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process."
      ],
      "justification": "Handles the positive limit case, continues the process, and rejoins split flows."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Directly restates the follow-up relay step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Matches the approval step and continuation."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Condition modeled as an action step preserves behaviour."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If they are, continue with the process."
      ],
      "justification": "Positive branch for acceptable changes continues the process."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If not, select a new applicant from the list."
      ],
      "justification": "Negative branch correctly selects a new applicant."
    },
    {
      "refs": [
        "action:n16",
        "action:n19"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Covers both occurrences of checking client acceptance in the source text."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17",
        "guard:b7->e1"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Covers both occurrences where client acceptance leads to process termination."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18",
        "guard:b7->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Covers both occurrences of selecting a new candidate when client does not accept."
    }
  ],
