init(n2)
action(n3, "check if form is complete")
branch(b1, XOR)
action(n4, "end process: form needs to be sent back")
end(e1)
branch(n5, XOR)
action(n6, "check deductibles")
action(n7, "check house")
action(n8, "make decision")
branch(b2, XOR)
action(n9, "end process: check declaration")
end(e2)
action(n10, "invite declarant")
end(e3)
converge(c1)
action(i4, "the process ends")
defines(v1, "check if form is complete", {"send_back", "check_income"})
defines(v2, "make decision", {"check_declaration", "invite_declarant"})
defines(v_split, "step_after_income", {"deductibles", "house"})
actor(a_default, "Default", [n2, n3, b1, n4, e1, n5, n6, n7, n8, b2, n9, e2, n10, e3, c1, i4])
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, n6)
precedence(n5, n7)
precedence(n6, c1)
precedence(n7, c1)
precedence(c1, n8)
precedence(n8, b2)
precedence(b2, n9)
precedence(b2, n10)
precedence(n4, i4)
precedence(i4, e1)
precedence(n9, e2)
precedence(n10, e3)
guard(b1, n4, v1 = "send_back")
guard(b1, n5, v1 = "check_income")
guard(n5, n6, v_split = "deductibles")
guard(n5, n7, v_split = "house")
guard(b2, n9, v2 = "check_declaration")
guard(b2, n10, v2 = "invite_declarant")
label(n2, n3, "At the start, we receive a form.")
label(b1, n5, "check income")