{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "Initial state and first action correctly capture team formation and domain agreement."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model and check it."
      ],
      "justification": "Model creation and subsequent check (modeled as an action step) preserve the original flow."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\", then assign negative points."
      ],
      "justification": "Correctly assigns negative points on the first failure condition."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\", assign negative points again."
      ],
      "justification": "Second evaluation and penalty correctly modeled as sequential steps."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Handles the positive outcome path by continuing the flow."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Accurately captures issue resolution and level extension."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process. If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Captures the conditional split announcement and gateway structure."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "First branch arm correctly guarded and acted upon."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Second branch arm correctly guarded and acted upon."
    },
    {
      "refs": [
        "action:n14",
        "guard:b4->n15",
        "action:n15",
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process"
      ],
      "justification": "Models the continuation condition. Redundant n16 and dual guards do not alter behaviour and are treated as matches."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "and perform work according to your assigned role."
      ],
      "justification": "Flow rejoins and proceeds to role-based work."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct match for progress monitoring and consultation."
    },
    {
      "refs": [
        "action:n19",
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it."
      ],
      "justification": "First acceptance check and corresponding presentation action."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Correctly handles the rejection path by returning to work."
    },
    {
      "refs": [
        "action:n22",
        "guard:b6->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Second acceptance check and repeated presentation."
    },
    {
      "refs": [
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Second rejection path mirrors the first, preserving loop behaviour."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Final convergence, presentation, and explicit termination match the closing instruction."
    }
  ],
