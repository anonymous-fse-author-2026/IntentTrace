@startuml
!theme plain
|a_admin| Admin Office
|a_admin|
start
:Begin process in Admin Office;
:Check if it has started;
:Verify completeness of the invoices;
:v_status: Invoice Status ({Completed, Uncompleted, Still_Uncompleted}); <<objectSignal>>
switch ()
case ([v_status = 'Uncompleted'])
:Return invoices to client through postal mail;
case ([v_status = 'Completed'])
:Continue the process;
case ([v_status = 'Still_Uncompleted'])
:Return invoices to client via postal mail;
endswitch
:Receive completed invoices;
:Mark relevant box on invoice entry form;
:Check if the process has been completed;
stop
@enduml