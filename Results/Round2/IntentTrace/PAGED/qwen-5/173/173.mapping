    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "The opening unit implicitly initiates the process and describes the first concrete step. The init node and action correctly capture this starting behaviour."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "First conditional check modeled as an action step followed by an XOR branch and guards. Using abstract variable guards (v1) to represent availability preserves the original decision logic."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then advertise the vacancy"
      ],
      "justification": "Directly corresponds to the outcome taken when the first condition is false."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "Models the continuation into the second decision point. Re-typing the continuation phrasing as a check action plus a structural branch preserves the flow without changing behaviour."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available"
      ],
      "justification": "Second negative condition captured by a guard routing to the re-advertisement path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then advertise the vacancy again"
      ],
      "justification": "Outcome of the second negative branch, directly matching the source text."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available"
      ],
      "justification": "Second positive condition captured by a guard routing to the selection path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "then proceed with selecting the appropriate applicant"
      ],
      "justification": "Outcome of the second positive branch, directly matching the source text."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "The final appointment step and explicit process termination are correctly modeled as sequential actions followed by an end node."
    }
  ],
