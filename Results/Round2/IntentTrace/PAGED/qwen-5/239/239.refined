init(i1)
branch(b_order, XOR)
converge(c_order)
branch(b_parallel, AND)
action(n_reject, "Order Rejected")
action(n_accept, "Order Accepted")
action(n_prepare, "Prepare Assembling Order")
action(n_check_avail, "Check Availability")
converge(c_parallel)
branch(b_availability, XOR)
action(n_check_again, "Check Availability Again")
end(e_backorder)
action(n_assemble, "Assemble Bike")
action(n_ship, "Ship Product")
end(e_final)
defines(v_order, "Order Status", {"Rejected", "Accepted"})
defines(v_availability, "Availability Status", {"Backorder", "Reserved"})
actor(a_default, "Default", [i1, b_order, n_reject, n_accept, c_order, b_parallel, n_prepare, n_check_avail, c_parallel, b_availability, n_check_again, e_backorder, n_assemble, n_ship, e_final])
precedence(i1, b_order)
precedence(b_order, n_reject)
precedence(b_order, n_accept)
precedence(n_reject, c_order)
precedence(n_accept, c_order)
precedence(c_order, b_parallel)
precedence(b_parallel, n_prepare)
precedence(b_parallel, n_check_avail)
precedence(n_prepare, c_parallel)
precedence(n_check_avail, c_parallel)
precedence(c_parallel, b_availability)
precedence(b_availability, n_check_again)
precedence(b_availability, n_assemble)
precedence(n_check_again, e_backorder)
precedence(n_assemble, n_ship)
precedence(n_ship, e_final)
guard(b_order, n_reject, v_order = 'Rejected')
guard(b_order, n_accept, v_order = 'Accepted')
guard(b_availability, n_check_again, v_availability = 'Backorder')
guard(b_availability, n_assemble, v_availability = 'Reserved')