    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "For the company, the first step is to look at the order."
      ],
      "justification": "Implicitly marks the start of the process as described."
    },
    {
      "refs": [
        "guard:b_order->n_reject",
        "guard:b_order->n_accept",
        "action:n_reject",
        "action:n_accept"
      ],
      "verbatim_texts": [
        "If the order is to be rejected, the process should continue. If the order is to be accepted, the process should also continue."
      ],
      "justification": "Correctly models the XOR decision on rejection vs acceptance and their convergence, preserving the stated continuation behaviour."
    },
    {
      "refs": [
        "action:n_prepare",
        "action:n_check_avail"
      ],
      "verbatim_texts": [
        "At the same time, two steps need to be completed: preparing the assembling order and checking availability."
      ],
      "justification": "Accurately captures the AND gateway for simultaneous preparation and availability checking, along with convergence."
    },
    {
      "refs": [
        "guard:b_availability->n_check_again",
        "action:n_check_again"
      ],
      "verbatim_texts": [
        "If there is a backorder, availability needs to be checked again and the process ends."
      ],
      "justification": "Fidelly represents the backorder condition, the re-check action, and the subsequent process termination."
    },
    {
      "refs": [
        "guard:b_availability->n_assemble"
      ],
      "verbatim_texts": [
        "If the item can be reserved, the process should continue."
      ],
      "justification": "Captures the positive reservation condition that allows the process to proceed to the next steps."
    },
    {
      "refs": [
        "action:n_assemble",
        "action:n_ship"
      ],
      "verbatim_texts": [
        "The next steps are to assemble the bike and then ship the product."
      ],
      "justification": "Directly maps the final sequential assembly and shipping steps, concluding the process."
    }
  ],
