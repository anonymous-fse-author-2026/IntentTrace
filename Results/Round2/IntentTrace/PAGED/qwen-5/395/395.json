  "input_elements": [
    {
      "id": "i1",
      "content": "Initially, it is important to check the Referee Reports."
    },
    {
      "id": "i2",
      "content": "monitor if the Referee Reports have been completed. If they have been completed"
    },
    {
      "id": "i4",
      "content": "proceed with the process"
    },
    {
      "id": "i5",
      "content": "if they have not been completed, you should flag it and send a reminder"
    },
    {
      "id": "i6",
      "content": "check again if the Referee Reports have been completed"
    },
    {
      "id": "i7",
      "content": "If not, you should flag it again and send another reminder"
    },
    {
      "id": "i8",
      "content": "organizing interviews for the Selection Panel with the top candidates"
    },
    {
      "id": "i9",
      "content": "receive feedback from the interview candidates"
    },
    {
      "id": "i10",
      "content": "check if a Psychometric Test is required"
    },
    {
      "id": "i11",
      "content": "If not, you can continue with the process and coordinate the second round of selection"
    },
    {
      "id": "i12",
      "content": "If an HR Specialist is required, you should schedule the test with a third party"
    },
    {
      "id": "i13",
      "content": "Otherwise, you can proceed to complete the Psychometric Test"
    },
    {
      "id": "i14",
      "content": "Finally, you should request the final candidate ranking and continue with the process"
    }
  ]
}