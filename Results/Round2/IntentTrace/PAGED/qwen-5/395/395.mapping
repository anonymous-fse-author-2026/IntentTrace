{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, it is important to check the Referee Reports."
      ],
      "justification": "Initiates the process and models the initial status check."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "monitor if the Referee Reports have been completed. If they have been completed",
        "if they have not been completed, you should flag it and send a reminder"
      ],
      "justification": "Opens the decision point based on whether the reports are complete or not."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "monitor if the Referee Reports have been completed. If they have been completed"
      ],
      "justification": "Routes the flow forward when reports are confirmed complete."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if they have not been completed, you should flag it and send a reminder"
      ],
      "justification": "Routes to the remediation path when reports are incomplete."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "if they have not been completed, you should flag it and send a reminder"
      ],
      "justification": "Executes the flagging and reminder step for incomplete reports."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "proceed with the process"
      ],
      "justification": "Models the explicit instruction to proceed once reports are verified complete."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "check again if the Referee Reports have been completed"
      ],
      "justification": "Re-checks status and opens the subsequent decision point."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "check again if the Referee Reports have been completed"
      ],
      "justification": "Handles the resolved completion path after re-checking."
    },
    {
      "refs": [
        "guard:b2->n16"
      ],
      "verbatim_texts": [
        "If not, you should flag it again and send another reminder"
      ],
      "justification": "Routes to the second remediation path if still incomplete."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If not, you should flag it again and send another reminder"
      ],
      "justification": "Directly implements the second-round flagging and reminder action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "organizing interviews for the Selection Panel with the top candidates"
      ],
      "justification": "Exact paraphrase of the interview organization step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "receive feedback from the interview candidates"
      ],
      "justification": "Exact paraphrase of the feedback collection step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "check if a Psychometric Test is required"
      ],
      "justification": "Models the requirement check and opens the multi-way decision point."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If not, you can continue with the process and coordinate the second round of selection"
      ],
      "justification": "Guard and action jointly cover the path when the test is not required."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required, you should schedule the test with a third party"
      ],
      "justification": "Guard and action jointly cover the third-party scheduling path."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Otherwise, you can proceed to complete the Psychometric Test"
      ],
      "justification": "Guard and action jointly cover the default path to internally complete the test."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, you should request the final candidate ranking and continue with the process"
      ],
      "justification": "Executes the final ranking request. Structural nodes handle flow convergence and termination without altering behaviour."
    }
  ],
