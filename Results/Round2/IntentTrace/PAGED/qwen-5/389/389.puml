!theme plain
|a_default| Default
|a_default|
start
:understand the BPMN Model;
:write a failing test;
:extend BPMN mocks to make the test pass;
:v1: is the test green ({True, False}); <<objectSignal>>
if () then (["v1 = 'True'"])
:check if the level satisfies the project requirements;
:does the level satisfy the project requirements;
:v2: does the level satisfy the project requirements ({True, False}); <<objectSignal>>
if () then (["v2 = 'True'"])
:end process;
stop
else (["v2 = 'False'"])
:continue the process (loop back to write a failing test);
endif
else (["v1 = 'False'"])
:upgrade the test level;
:check if the level satisfies the project requirements;
:does the level satisfy the project requirements;
:v3: does the level satisfy the project requirements ({True, False}); <<objectSignal>>
if () then (["v3 = 'True'"])
:end process;
stop
else (["v3 = 'False'"])
:upgrade the test level once more;
stop
endif
endif
