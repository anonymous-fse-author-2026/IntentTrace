{
  "matches": [
    {
      "refs": [
        "action:a_start"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "The init node marks the process start, and the action step directly paraphrases the opening instruction."
    },
    {
      "refs": [
        "guard:b_exp->a_rev",
        "action:a_rev"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "Captures the first decision point, the correct threshold guard (>1000), and the corresponding review action."
    },
    {
      "refs": [
        "guard:b_exp->a_chkTrans1",
        "action:a_chkTrans1"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Correctly models the alternative branch condition (<=1000) and the subsequent translation check step."
    },
    {
      "refs": [
        "guard:b_trans1->a_trans",
        "action:a_trans"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Maps the positive translation decision branch and the translate action accurately."
    },
    {
      "refs": [
        "guard:b_trans1->a_conf",
        "action:a_conf"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Correctly captures the negative translation branch and the confirm receipts action."
    },
    {
      "refs": [
        "guard:b_rev1->a_edit1",
        "action:a_edit1"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Models the first review evaluation split, the rejection guard, and the edit action."
    },
    {
      "refs": [
        "guard:b_rev1->a_chkTrans2",
        "action:a_chkTrans2"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Captures the approval branch from the first review and the repeated translation check."
    },
    {
      "refs": [
        "guard:b_rev2->a_edit2",
        "action:a_edit2",
        "guard:b_rev2->a_transConf",
        "action:a_transConf"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "The second review evaluation loop (b_rev2) and its branches faithfully reproduce the text's repeated decision logic. The approval branch correctly merges translation and confirmation into one action as stated."
    },
    {
      "refs": [
        "guard:b_rec->a_proc",
        "action:a_proc"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Accurately models the final receipts decision, the acceptance guard, and the expense processing action."
    },
    {
      "refs": [
        "guard:b_rec->a_edit3",
        "action:a_edit3"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Correctly captures the alternative rejection path and the corresponding edit action."
    }
  ],
