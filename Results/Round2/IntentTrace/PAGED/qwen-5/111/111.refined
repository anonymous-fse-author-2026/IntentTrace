init(i1)
action(n1, "Start loan application process")
branch(b1, XOR)
action(n3, "End process due to rejection")
end(e1)
action(n4, "Are special terms agreed upon")
action(n5, "Disburse funds")
defines(v1, "Is loan application rejected", {"Yes", "No"})
defines(v2, "Are special terms agreed upon", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, b1, n3, e1, n4, n5])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, e1)
precedence(n4, n5)
precedence(n5, e1)
guard(b1, n3, v1 = 'Yes')
guard(b1, n4, v1 = 'No')