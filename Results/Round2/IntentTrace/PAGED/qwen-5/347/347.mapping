{
  "matches": [
    {
      "refs": [
        "action:a1",
        "action:a2",
        "action:a3"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "Initiates the process and covers the first three sequential steps described in the opening unit."
    },
    {
      "refs": [
        "guard:b1->a4",
        "action:a4"
      ],
      "verbatim_texts": [
        "is below or equal to the minimum, generate an Equal to or below minimum Report"
      ],
      "justification": "Decision point and positive branch for low inventory levels, correctly triggering the corresponding report. Abstract guard preserves the conditional logic."
    },
    {
      "refs": [
        "guard:b1->a5",
        "action:a5"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report"
      ],
      "justification": "Alternative branch for sufficient inventory, correctly triggering the above-minimum report."
    },
    {
      "refs": [
        "action:a6"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)"
      ],
      "justification": "Direct correspondence to the PO creation step following the low-inventory path."
    },
    {
      "refs": [
        "action:a7"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Condition modeled as an action step preserves the mandatory review requirement without changing behaviour."
    },
    {
      "refs": [
        "guard:b2->a8",
        "action:a8"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Captures the rejection decision and rework action accurately."
    },
    {
      "refs": [
        "guard:b2->a9",
        "action:a9"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Captures the approval decision and subsequent print/release action."
    },
    {
      "refs": [
        "action:a10",
        "action:a11"
      ],
      "verbatim_texts": [
        "reserve funds for the released POs and mail the POs to the supplier"
      ],
      "justification": "Parallel split (AND gateway) correctly models the simultaneous reservation and mailing steps."
    },
    {
      "refs": [
        "action:a12"
      ],
      "verbatim_texts": [
        "receive the inventory"
      ],
      "justification": "Direct match for receiving inventory after the POs are mailed."
    },
    {
      "refs": [
        "action:a13"
      ],
      "verbatim_texts": [
        "receive the Packing Slip"
      ],
      "justification": "Direct match for receiving packing slip after funds are reserved."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "receive the Packing Slip",
        "receive the inventory"
      ],
      "justification": "Structural join point synchronizing the two parallel streams before proceeding."
    },
    {
      "refs": [
        "action:a14"
      ],
      "verbatim_texts": [
        "receive the Invoice"
      ],
      "justification": "Direct match for invoice receipt step."
    },
    {
      "refs": [
        "action:a15"
      ],
      "verbatim_texts": [
        "Three-way match"
      ],
      "justification": "Direct match for the matching procedure step."
    },
    {
      "refs": [
        "guard:b4->a16",
        "action:a16"
      ],
      "verbatim_texts": [
        "is successful, release the funds"
      ],
      "justification": "Decision on match success leading to fund release. Abstract guard preserves the conditional logic."
    },
    {
      "refs": [
        "action:a17"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Direct match for payment issuance following fund release."
    },
    {
      "refs": [
        "action:a18"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Final completion statement and process termination, correctly placed at the end of the flow."
    }
  ],
