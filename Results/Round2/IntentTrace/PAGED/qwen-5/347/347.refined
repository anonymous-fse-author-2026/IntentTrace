init(i1)
action(a1, "start the process for ACME")
action(a2, "begin New Resupply Cycle")
action(a3, "Check Levels of Inventory")
branch(b1, XOR)
action(a4, "generate Equal to or below minimum Report")
action(a5, "generate Above Minimum Report")
action(a6, "create Purchase Orders (POs)")
action(a7, "review PO")
branch(b2, XOR)
action(a8, "rework PO")
action(a9, "print and release PO in system")
branch(b3, AND)
action(a10, "reserve funds for released POs")
action(a11, "mail POs to supplier")
action(a12, "receive Inventory")
converge(c1)
action(a13, "receive the Packing Slip")
action(a14, "receive the Invoice")
action(a15, "Three-way match")
branch(b4, XOR)
action(a16, "release the funds")
action(a17, "issue the payment")
action(a18, "Resupply Cycle is complete process ends")
end(e1)
converge(c2)
defines(v1, "Is inventory below or equal to minimum", {"Yes", "No"})
defines(v2, "Is PO rejected", {"Yes", "No"})
defines(v3, "Is Three way match successful", {"Yes", "No"})
actor(a_default, "Default", [i1, a1, a2, a3, b1, a4, a5, a6, a7, b2, a8, a9, b3, a10, a11, a12, c1, a13, a14, a15, b4, a16, a17, a18, e1, c2])
precedence(i1, a1)
precedence(a1, a2)
precedence(a2, a3)
precedence(a3, b1)
precedence(b1, a4)
precedence(b1, a5)
precedence(a4, c2)
precedence(a8, c2)
precedence(c2, a6)
precedence(a6, a7)
precedence(a7, b2)
precedence(b2, a8)
precedence(b2, a9)
precedence(a9, b3)
precedence(b3, a10)
precedence(b3, a11)
precedence(a10, c1)
precedence(a11, a12)
precedence(a12, c1)
precedence(c1, a13)
precedence(a13, a14)
precedence(a14, a15)
precedence(a15, b4)
precedence(b4, a16)
precedence(b4, e1)
precedence(a16, a17)
precedence(a17, a18)
precedence(a18, e1)
precedence(a5, e1)
guard(b1, a4, v1 = 'Yes')
guard(b1, a5, v1 = 'No')
guard(b2, a8, v2 = 'Yes')
guard(b2, a9, v2 = 'No')
guard(b4, a16, v3 = 'Yes')
guard(b4, e1, v3 = 'No')