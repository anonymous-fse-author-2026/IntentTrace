  "input_elements": [
    {
      "id": "i1",
      "content": "To initiate the Drop-off tech process, the customer is first informed about canceling the order."
    },
    {
      "id": "i2",
      "content": "Then, the question arises: has the order already been fulfilled?"
    },
    {
      "id": "i3",
      "content": "If the answer is \"Yes,\""
    },
    {
      "id": "i4",
      "content": "the bag is marked as returned in IS."
    },
    {
      "id": "i5",
      "content": "if the answer is \"No,\""
    },
    {
      "id": "i6",
      "content": "the script(s) are marked as declined by the customer in IS."
    },
    {
      "id": "i7",
      "content": "If the bag is indeed returned, it is marked as such in IS."
    },
    {
      "id": "i8",
      "content": "On the other hand, if the bag is not returned, the script(s) are marked as declined by the customer in IS."
    },
    {
      "id": "i9",
      "content": "Once the bag is marked as returned in IS, the script bag is returned as well."
    },
    {
      "id": "i10",
      "content": "Similarly, when the script(s) are marked as declined by the customer in IS, the script order is declined."
    },
    {
      "id": "i11",
      "content": "the customer notification is processed"
    },
    {
      "id": "i12",
      "content": "the entire process comes to an end"
    }
  ]
}