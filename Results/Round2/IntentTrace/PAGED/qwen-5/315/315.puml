@startuml
!theme plain
|a_default| Default
|a_default|
start
:make appointment at hairdresser's;
:go to hairdresser;
:v1: need hair washed? ({Yes, No})
v2: want hair dyed? ({Yes, No})
v3: need haircut? ({Yes, No}); <<objectSignal>>
switch ()
case ([v1 = 'Yes'])
:need hair washed?;
:wash hair;
case ([v2 = 'Yes'])
:want hair dyed?;
:dye hair;
case ([v3 = 'Yes'])
:need haircut?;
:cut hair;
endswitch
:pay hairdresser;
:end process;
stop
@enduml