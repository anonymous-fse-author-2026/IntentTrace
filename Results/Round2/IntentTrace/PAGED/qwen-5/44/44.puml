@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:select a filter;
:apply the selected filter;
repeat :;
:click on Submit button;
:is option to submit false;
:v1: is option to submit false ({true, false}); <<objectSignal>>
backward:apply another filter;
repeat while () is ([v1 = true]) not ([v1 = false])
:If the option to submit is set to "true", then continue with the process.;
:continue with the process.;
:is there another filter to apply;
:v2: is there another filter to apply ({true, false}); <<objectSignal>>
if () then ([v2 = true])
:continue with process if another filter to apply;
else ([v2 = false])
:continue with process if no more filters;
endif
:is option to submit true;
:continue with process if option submit true;
stop
@enduml