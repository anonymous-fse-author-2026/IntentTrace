@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process;
:ensure Freights are ready to be shipped;
:ship the freight;
split
:deliver the freight;
split again
:notify the delivery;
end split
:is request for merchandise return lodged?;
:v_condition: trigger condition ({5 days, Accepted, Rejected, Loss claim}); <<objectSignal>>
switch ()
case ([v_condition = '5 days'])
:invoice the customer;
:end with customer being invoiced;
stop
case ([v_condition = 'Accepted'])
:accept the merchandise return;
:return the merchandise;
:end with merchandise being returned;
stop
case ([v_condition = 'Rejected'])
:reject the merchandise return;
:end with merchandise return request being rejected;
stop
case ([v_condition = 'Loss claim'])
:approve the loss claim;
:end with loss claim approved;
stop
endswitch
@enduml