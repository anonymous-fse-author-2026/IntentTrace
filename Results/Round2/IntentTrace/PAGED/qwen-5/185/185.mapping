{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "Process initiation and first action directly correspond to the opening unit."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After receiving the invoice, it is sorted per client."
      ],
      "justification": "Direct paraphrase of the sorting step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once sorted per client, it is then sorted per vendor."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "The next step is to attach the invoice entry form to the invoice."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After attaching the form, the required information is entered onto the form."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Following that, the completeness of the invoice is checked."
      ],
      "justification": "Covers the check action and the resulting decision point."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Captures the incomplete outcome guard, terminating action, and end node."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered."
      ],
      "justification": "Captures the complete outcome guard, placeholder action, and SLA data entry."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "The date for completion is also entered and the priority is checked."
      ],
      "justification": "Covers entering the date, priority check, and the resulting decision point."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "Captures the high-priority guard, placeholder, and stamping action."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Captures the low-priority guard, placeholder, and flow convergence."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Covers the compliance check action and its decision split."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If it is not complete, the check continues."
      ],
      "justification": "Captures the incomplete compliance guard, continuation action, and convergence."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is complete, the process continues."
      ],
      "justification": "Captures the complete compliance guard and continuation action."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Captures the multi-outcome branch node, experienced-staff routing guard, and processing action."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21",
        "action:n23"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Captures the normal-case guard and client call action."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Captures the fallback postal-mail guard, action, and termination."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Direct paraphrase of the final client contact step."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO, and the process ends."
      ],
      "justification": "Final batching/allocating action and process termination match exactly."
    }
  ],
