init(i1)
action(n1, "Provide requested shipping information")
action(n2, "Determine shipping details")
action(n3, "Is shipping address saved or new")
branch(b1, XOR)
action(n4, "Saved shipping address selected")
action(n5, "New shipping address entered")
action(n6, "Confirm shipping address")
action(n7, "Is shipping address correct")
action(n8, "Select desired shipping speed")
action(n9, "End")
end(e1)
converge(c1)
defines(v1, "Is shipping address saved or new", {"Saved", "New"})
defines(v2, "Is shipping address correct", {"Correct", "Incorrect"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, n6, n7, n8, n9, e1, c1])
precedence(i1, n1)
precedence(n3, b1)
precedence(n7, n8)
precedence(n9, e1)
precedence(c1, n6)
precedence(n1, n2)
precedence(n2, n3)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, c1)
precedence(n5, c1)
precedence(n6, n7)
precedence(n8, n9)
guard(b1, n4, v1 = 'Saved')
guard(b1, n5, v1 = 'New')