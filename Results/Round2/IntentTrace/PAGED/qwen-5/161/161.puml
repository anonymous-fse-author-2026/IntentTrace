@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:join the team and agree on domain;
:create process model and check it;
:is process model NOT OK?;
:v1: is process model NOT OK? ({Yes, Model OK}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:assign negative points;
:is process model STILL NOT OK?;
:v2: is process model STILL NOT OK? ({Yes, Model OK}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:assign negative points again;
else ([v2 = 'Model OK'])
->;
endif
else ([v1 = 'Model OK'])
->;
endif
:if process is okay continue with it;
:v6: process continuation choice ({Fix issues, Check/Analyze}); <<objectSignal>>
if () then ([v6 = 'Fix issues'] If there are any issues)
:fix issues in next session and extend to levels 2 and 3;
else ([v6 = 'Check/Analyze'] Need to check/analyze)
:check process and assign points or analyze field of study;
:v3: check process and assign points or analyze field of study ({Yes, No (check);After fixing}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:assign roles in team;
else ([v3 = 'No (check);After fixing'])
->;
endif
endif
:continue with process and perform work according role;
:check progress and consult problems;
:is project accepted?;
:v4: is project accepted? ({Yes, Not accepted}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:present project;
stop
else ([v4 = 'Not accepted'])
:continue working according role;
:is project accepted?;
:present project again;
:v5: is project accepted? ({Accepted, Not accepted}); <<objectSignal>>
if () then ([v5 = 'Accepted'])
:present project and end process;
stop
else ([v5 = 'Not accepted'])
:continue working according role;
endif
endif
@enduml