{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "The opening unit implicitly starts the process and describes the first registration action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If there is no fee"
      ],
      "justification": "Models the initial fee check, creates the XOR split, and defines the 'no fee' condition on the first outgoing edge."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if there is a fee",
        "if there is a fee"
      ],
      "justification": "Defines the 'fee' condition on the alternative branch. Combines two segmented fragments of the same condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "you should proceed to register a post-seminar request."
      ],
      "justification": "Direct mapping to the action taken when there is no fee."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "you need to create a purchase request."
      ],
      "justification": "Direct mapping to the action taken when there is a fee."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Captures the termination condition after post-seminar registration. The structural end node and descriptive action correspond to the same unit."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Models the approval verification step and establishes the subsequent decision gateway."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Condition guarding the approval branch."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "if the purchase request is rejected"
      ],
      "justification": "Condition guarding the rejection branch."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "you will receive an approved notification."
      ],
      "justification": "Outcome action on the approved path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "you will be notified of the rejection."
      ],
      "justification": "Outcome action on the rejected path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "you should then register a post-seminar request."
      ],
      "justification": "Follow-up action triggered upon receiving the approval notification."
    }
  ],
