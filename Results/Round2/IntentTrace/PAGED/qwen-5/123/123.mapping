      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for Metal Works, start by"
      ],
      "justification": "Initiates the process and names it based on the opening phrase."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "obtaining the raw material from the received list."
      ],
      "justification": "Directly captures the first operational step."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If the raw material is not available in stock"
      ],
      "justification": "XOR split correctly captures the negative availability condition; abstract guard 'v1 = No' aligns with the branching logic."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then select a supplier."
      ],
      "justification": "Action taken when stock is unavailable."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "However, if the raw material is available in stock,"
      ],
      "justification": "Abstract guard 'v1 = Yes' correctly routes the positive availability branch."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to check the raw material"
      ],
      "justification": "Direct step following the positive branch."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "and conclude the process."
      ],
      "justification": "Covers the conclusion of the available-stock path; extra 'End' action and structural end node are harmless redundancy."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After selecting a supplier, send the material purchase order."
      ],
      "justification": "Direct match for the post-supplier selection step."
    },
    {
      "refs": [
        "action:n8",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the material purchase order is sent, proceed to check the raw material"
      ],
      "justification": "Captures the final check and process conclusion after ordering; redundant end steps preserve overall termination behaviour."
    }
  ],
