init(i1)
end(e1)
action(n1, "Start process for flickr login")
action(n2, "Provide userdata for flickr login")
action(n3, "Is login successful")
action(n4, "End process after successful login")
branch(b1, XOR)
branch(b2, XOR)
converge(c1)
defines(v1, "Is login successful", {"Yes", "No"})
defines(v2, "User choice after failure", {"Retry", "Abort"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, b2, c1, e1])
precedence(i1, n1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, b2)
precedence(n4, e1)
precedence(b2, c1)
precedence(b2, e1)
guard(b1, n4, v1 = 'Yes')
guard(b1, b2, v1 = 'No')
guard(b2, c1, v2 = 'Retry')
guard(b2, e1, v2 = 'Abort')