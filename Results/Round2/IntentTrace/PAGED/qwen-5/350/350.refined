init(i_start)
action(a1, "To start, please provide the userdata for flickr.")
action(a_succ, "If the login is successful, the process will end.")
action(a_fail, "if the login fails, we will continue with the process")
action(a_retry, "If you want to try again, please provide the userdata for flickr.")
action(a_abort, "if you choose to abort, the process will end.")
branch(b_login, XOR)
branch(b_choice, XOR)
converge(c_loop)
end(e_finish)
defines(v_login, "login result", {"success", "fail"})
defines(v_choice, "user choice", {"try", "abort"})
actor(a_default, "Default", [i_start, a1, a_succ, a_fail, a_retry, a_abort, b_login, b_choice, c_loop, e_finish])
precedence(i_start, c_loop)
precedence(c_loop, a1)
precedence(a1, b_login)
precedence(b_login, a_succ)
precedence(a_succ, e_finish)
precedence(b_login, a_fail)
precedence(a_fail, b_choice)
precedence(b_choice, a_retry)
precedence(a_retry, c_loop)
precedence(b_choice, a_abort)
precedence(a_abort, e_finish)
guard(b_login, a_succ, v_login = 'success')
guard(b_login, a_fail, v_login = 'fail')
guard(b_choice, a_retry, v_choice = 'try')
guard(b_choice, a_abort, v_choice = 'abort')