@startuml
!theme plain
|a_default| Default
|a_default|
start
:Identify parts;
:v1: Process Path ({ElicitInfo, HaveAvailability, PartsSupplied, RecordDetails}); <<objectSignal>>
switch ()
case ([v1 = 'ElicitInfo'])
:Need to elicit information from customer;
:Check availability of parts;
case ([v1 = 'HaveAvailability'])
:Proceed with process;
case ([v1 = 'PartsSupplied'])
:Are parts supplied to customer;
case ([v1 = 'RecordDetails'])
:Record customer details;
:Order and receive part from Disuki;
endswitch
:Contract customer;
:Proceed with payment;
:End;
stop
@enduml