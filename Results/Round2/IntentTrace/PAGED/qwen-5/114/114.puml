@startuml
!theme plain
|a_default| Default
|a_default|
start
:start selling cars;
:v_path: route ({bonus, paycheck}); <<objectSignal>>
if () then ([v_path = 'bonus'])
:did you get a bonus;
:v1: did you get a bonus ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Yes continue process after bonus;
:pay the bill;
:process ends;
else ([v1 = 'No'])
->;
endif
else ([v_path = 'paycheck'])
:did you get a paycheck;
:v2: did you get a paycheck ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:Yes continue process after paycheck;
else ([v2 = 'No'])
->;
endif
endif
stop
@enduml