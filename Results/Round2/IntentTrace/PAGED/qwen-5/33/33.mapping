{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "Captures process initiation and the first sequential actions described in the opening unit."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Models the eligibility check and XOR gateway, correctly routing the negative condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Action taken on the negative eligibility branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Terminates the process following the customer notification."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Action taken on the positive eligibility branch."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Open a new order in the ERP system and perform an availability check."
      ],
      "justification": "Executes the availability check immediately after order creation."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n10",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\"."
      ],
      "justification": "Checks product availability and splits flow to production or continuation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "Handles manufacturing when items are unavailable."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Prepares goods before downstream parallel steps."
    },
    {
      "refs": [
        "action:n12",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "Splits flow into concurrent shipping, invoicing, and payment verification steps."
    },
    {
      "refs": [
        "action:n15",
        "guard:b3->n16",
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Evaluates payment status and sets up decision gateway."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Closes the order upon successful payment."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Sends a reminder when payment is pending."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Otherwise, if the payment is not received, send a reminder and close the order, ending the process."
      ],
      "justification": "Reflects the explicit termination clause attached to the reminder/closure step."
    },
    {
      "refs": [
        "action:n19",
        "guard:b4->n11",
        "guard:b4->n20"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Checks reminder count threshold and routes flow to continue or escalate."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Escalates to legal counsel and terminates the process upon reaching the limit."
    }
  ],
