    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the validation process, start by checking the received invoice for any errors."
      ],
      "justification": "Captures process initiation and the initial error-checking step. Splitting into 'start' and 'check' preserves the described behaviour."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If any errors are found, continue with the process."
      ],
      "justification": "Models the decision split and the positive path. The guard value 'Yes' abstracts the presence of errors, and the continuation step is directly represented."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If no errors are found, mark the \"invoice entered correctly\" box."
      ],
      "justification": "Models the negative decision path and the corresponding marking action. The guard value 'No' correctly abstracts the absence of errors."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Simultaneously, highlight any errors on the invoice entry form and keep a record of the DEO's performance."
      ],
      "justification": "Direct paraphrase of the simultaneous highlighting and recording step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the \"invoice entered correctly\" box is ticked, the invoice is checked and the process ends."
      ],
      "justification": "Captures the final validation step and process termination upon the box being ticked."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If an error exists, the process also ends."
      ],
      "justification": "A conditional clause modeled as an action step. Per the relaxed comparison principle, re-typing a condition as a step preserves behaviour and is a match."
    }
  ],
