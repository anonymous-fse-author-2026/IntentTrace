@startuml
!theme plain
|a_default| Default
|a_default|
start
:Identify Vacancy;
:v1: Any candidates available? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
->;
else ([v1 = 'No'])
:Advertise Vacancy;
:v2: After advertising  any candidates? ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:Select Applicant;
else ([v2 = 'No'])
:Advertise Again;
endif
stop
endif
@enduml