@startuml
!theme plain
|a_passenger| Passenger
|a_passenger|
start
:undergo immigration checks;
:select method for exit control checks;
:v1: exit control method ({Biometrics, ID Documents}); <<objectSignal>>
if () then ([v1 = 'Biometrics'])
:use biometrics for exit control checks;
else ([v1 = 'ID Documents'])
:use ID documents for exit control checks;
endif
:verify exit control results;
:v2: permission status ({Granted, Denied}); <<objectSignal>>
if () then ([v2 = 'Denied'])
:leave the area;
stop
else ([v2 = 'Granted'])
:proceed to the next step;
:assess final outcome;
:v3: final outcome ({Successful, Unsuccessful}); <<objectSignal>>
if () then ([v3 = 'Unsuccessful'])
:leave the area and the process ends;
stop
else ([v3 = 'Successful'])
:continue to the next step and the process ends;
stop
endif
endif
@enduml