end(e1)
branch(b1, XOR)
converge(c1)
defines(order_sum, "sum of the order", {[0-]})
actor(a_default, "Default", [i1, b1, i2, i3, i4, i5, i6, i7, i8, i9, i10, c1, e1])
precedence(i1, b1)
