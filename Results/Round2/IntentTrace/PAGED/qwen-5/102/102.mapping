{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "Initiates the process and executes the triggering step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level."
      ],
      "justification": "Directly maps to the initial inventory verification step."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "Inventory level is at or below the minimum"
      ],
      "justification": "Models the decision point and the guard for the low-inventory condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then proceed to Create Purchase Order."
      ],
      "justification": "Positive outcome of the inventory check."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if the Inventory Level is above the minimum"
      ],
      "justification": "Guard capturing the alternative inventory threshold."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process ends."
      ],
      "justification": "Termination action and structural end node for the sufficient-inventory path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Sequential step following PO creation."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved"
      ],
      "justification": "Captures the approval condition; modeling it alongside an action step and branch preserves the decision logic without altering behaviour."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the Purchase Order is rejected"
      ],
      "justification": "Guard for the rejection path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "then reserve the funds for the purchase."
      ],
      "justification": "Action taken upon approval."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then rework the order."
      ],
      "justification": "Action taken upon rejection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Dispatch step conditioned on funded status."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the Supplier sends a packing slip"
      ],
      "justification": "AND split initiates parallel supplier responses; maps to packing slip generation."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "and an invoice."
      ],
      "justification": "Second parallel supplier output."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it."
      ],
      "justification": "Records the slip; convergence gate ensures synchronization with invoice recording before proceeding."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Similarly, when the invoice is received, record it as well."
      ],
      "justification": "Records the invoice document."
    },
    {
      "refs": [
        "label:c1->n14"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice,"
      ],
      "justification": "Explicit condition linking the synchronized recordings to the next financial step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "Combined financial settlement step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Final cleanup action and main process termination."
    },
    {
      "refs": [
        "label:c2->n5"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Preserves the explicit feedback loop back to the review stage following a rework."
    }
  ],
