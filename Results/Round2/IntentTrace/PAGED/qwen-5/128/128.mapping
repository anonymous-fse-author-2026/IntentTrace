{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Captures the process start and the initial return step. Structural init and behavioral action align with the opening unit."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process. However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Models the initial XOR split between customer return and crew pickup, including convergence. Conditionals modeled as actions preserve behavior."
    },
    {
      "refs": [
        "guard:b1->c0"
      ],
      "verbatim_texts": [
        "Customer returns the items to the store"
      ],
      "justification": "Guard captures the first branch option exactly."
    },
    {
      "refs": [
        "guard:b1->c0"
      ],
      "verbatim_texts": [
        "Delivery Crew picks-up items at the event site"
      ],
      "justification": "Guard captures the second branch option exactly."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct match for the counting and comparison step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Captures the three-way decision on order status, structural branch/convergence, and the overarching conditional logic. Re-typing conditionals as actions is behavior-preserving."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "Order is complete and all items were returned"
      ],
      "justification": "Guard correctly assigns the 'complete' path to convergence."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "Order is incomplete and items are missing"
      ],
      "justification": "Guard correctly assigns the 'incomplete/missing' path to the missing-items action."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "Order is complete but items are damaged"
      ],
      "justification": "Guard correctly assigns the 'damaged' path to the damage-email action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Direct match for the damage notification step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Direct match for the missing-items notification step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Direct match for removing damaged items from inventory."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process. However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Models the decision on whether missing items are returned, splitting into two paths that immediately reconverge. Behavior preserved."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "Customer returns the missing items"
      ],
      "justification": "Guard captures the positive return path."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "Customer does not return the missing items"
      ],
      "justification": "Guard captures the negative return path."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Action announces process completion while the structural end node terminates the flow. Both align with the source."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Captures the repair-status decision, structural split/join, and conditional outcomes."
    },
    {
      "refs": [
        "guard:b4->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "Items are repaired and added into inventory"
      ],
      "justification": "Guard and redundant action both capture the repair success condition. Redundancy does not change behavior."
    },
    {
      "refs": [
        "guard:b4->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "Items can't be repaired and are discarded"
      ],
      "justification": "Guard and action capture the repair failure/discard condition. Matches source exactly."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "we email the customer with replacement charges."
      ],
      "justification": "Direct match for the replacement charge email."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order. If the \"Items are packed for an existing order,\" we continue the process. If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Models the packing vs storing split and convergence. Conditionals modeled as actions preserve behavior."
    },
    {
      "refs": [
        "guard:b5->c4"
      ],
      "verbatim_texts": [
        "Items are packed for an existing order"
      ],
      "justification": "Guard captures the packing path."
    },
    {
      "refs": [
        "guard:b5->c4"
      ],
      "verbatim_texts": [
        "Items are stored for future orders"
      ],
      "justification": "Guard captures the storing path."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges, and the process is complete."
      ],
      "justification": "Direct match for the final email and completion statement."
    }
  ],
