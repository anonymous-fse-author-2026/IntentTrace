{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process, begin by processing incoming orders."
      ],
      "justification": "Starts the process and captures the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once the order is received"
      ],
      "justification": "Models the reception condition as an action step; preserves timing/behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to send the collected order list."
      ],
      "justification": "Direct paraphrase of sending the list."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After collecting the order list, implement it in the database."
      ],
      "justification": "Captures implementation in DB with its preceding condition absorbed."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the data is implemented, gather all the information in one excel-file."
      ],
      "justification": "Direct match gathering data into Excel."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Subsequently, check the order and customer details."
      ],
      "justification": "Direct match for checking details."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the \"permit data\" option is selected",
        "if the \"not permit data\" option is chosen, the data will not be permitted."
      ],
      "justification": "Opens the XOR split based on the permit data choice."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "\"permit data\" option is selected"
      ],
      "justification": "Positive arm guard and action correctly capture the permit path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed with permitting the data."
      ],
      "justification": "Positive arm guard and action correctly capture the permit path."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "\"not permit data\" option is chosen"
      ],
      "justification": "Negative arm guard and action capture the non-permit path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "release the data if permitted"
      ],
      "justification": "Maps directly to the post-decision actions for both branches."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "contact the selling agency if not permitted."
      ],
      "justification": "Maps directly to the post-decision actions for both branches."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the agency is contacted, check the worth of the orders."
      ],
      "justification": "Captures checking order worth after agency contact."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the orders are to be released",
        "However, if the order is to be canceled, the process will end."
      ],
      "justification": "Opens the XOR split based on release/cancel decision."
    },
    {
      "refs": [
        "guard:b2->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Positive arm guard and action for releasing orders."
    },
    {
      "refs": [
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "if the order is to be canceled"
      ],
      "justification": "Negative arm guard, action, and end node for canceling orders."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "After checking the worth of the orders, if the value is less than 5000",
        "However, if the value is greater than or equal to 5000, the order will need to be signed off by the board of directors."
      ],
      "justification": "Opens the XOR split based on the 5000 threshold."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "value is less than 5000"
      ],
      "justification": "Guard and action for values under 5000 correctly preserve the condition."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "value is greater than or equal to 5000"
      ],
      "justification": "Guard and action for values >= 5000 correctly preserve the condition."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the order is signed off, collect the order and start production."
      ],
      "justification": "Rejoins flows and executes collection/start production step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Send the memorandum and invoice, followed by the quality report.",
        "Check the quality of the production and send the quality report."
      ],
      "justification": "Sequentially models sending memos/invoices, checking quality, and sending reports. Redundant report-sending steps do not change behaviour."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Send the memorandum and invoice, followed by the quality report.",
        "Check the quality of the production and send the quality report."
      ],
      "justification": "Sequentially models sending memos/invoices, checking quality, and sending reports. Redundant report-sending steps do not change behaviour."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Send the memorandum and invoice, followed by the quality report.",
        "Check the quality of the production and send the quality report."
      ],
      "justification": "Sequentially models sending memos/invoices, checking quality, and sending reports. Redundant report-sending steps do not change behaviour."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Send the memorandum and invoice, followed by the quality report.",
        "Check the quality of the production and send the quality report."
      ],
      "justification": "Sequentially models sending memos/invoices, checking quality, and sending reports. Redundant report-sending steps do not change behaviour."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "collect the goods."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "Sign off on the memo and pick the goods."
      ],
      "justification": "Split into two actions matching the compound step."
    },
    {
      "refs": [
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "After the goods are picked, send them to complete the process."
      ],
      "justification": "Final sending step and process completion/end nodes."
    }
  ],
