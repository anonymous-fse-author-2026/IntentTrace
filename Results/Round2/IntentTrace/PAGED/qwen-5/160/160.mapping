{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by claiming what is requested"
      ],
      "justification": "Implicit process start and first action step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then check the insured status of the claimant."
      ],
      "justification": "Direct paraphrase of the status check step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the claimant is insured"
      ],
      "justification": "Captures the first decision point and positive condition using abstract but behavior-preserving guard syntax."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed to evaluate the claim."
      ],
      "justification": "Action taken on the positive branch."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if the claimant is not insured, reject the claim."
      ],
      "justification": "Captures the negative condition and corresponding rejection action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "notify the claimant and the process comes to an end."
      ],
      "justification": "Notification step followed by termination of the rejected path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the claim is a simple one or a complex one, send the relevant forms accordingly."
      ],
      "justification": "Models the unconditional sending of forms; simplifying the 'simple or complex' phrasing preserves the core behavior."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the forms are returned"
      ],
      "justification": "Represents the receipt of returned forms."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "check them for completeness."
      ],
      "justification": "Direct match for the validation step."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided"
      ],
      "justification": "Second decision point with positive condition captured via abstract guard."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "proceed to register the claim."
      ],
      "justification": "Action taken when details are complete."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "if not all the relevant details are provided, inform the claimant to complete them."
      ],
      "justification": "Captures the incomplete details condition and the subsequent notification."
    }
  ],
