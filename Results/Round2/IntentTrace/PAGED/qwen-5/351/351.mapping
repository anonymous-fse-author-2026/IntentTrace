{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Models the process start, the initial question/action, and the resulting decision gateway."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Captures the positive branch condition and the corresponding action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Captures the negative branch condition and action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Directly models the next procedural check."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits."
      ],
      "justification": "Models the condition verification step and the subsequent decision split."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "Correctly maps the 'not within limits' condition to the relay action."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process."
      ],
      "justification": "Correctly maps the 'within limits' condition to the continuation action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Direct paraphrase of the sequential step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Models the acceptability check and its decision gateway."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they are, continue with the process."
      ],
      "justification": "Maps the positive acceptability outcome."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If not, select a new applicant from the list."
      ],
      "justification": "Maps the negative acceptability outcome."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Models the final client acceptance check and gateway."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Maps the positive client outcome to process termination."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Maps the negative client outcome."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes.",
        "If they do, the process ends.",
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "These elements redundantly restate the final decision loop present later in the raw text. Per relaxed comparison rules, redundant restatements that preserve behaviour are MATCHES. Converges act as harmless structural plumbing."
    },
    {
      "refs": [
        "guard:b6->n23"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes.",
        "If they do, the process ends.",
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "These elements redundantly restate the final decision loop present later in the raw text. Per relaxed comparison rules, redundant restatements that preserve behaviour are MATCHES. Converges act as harmless structural plumbing."
    },
