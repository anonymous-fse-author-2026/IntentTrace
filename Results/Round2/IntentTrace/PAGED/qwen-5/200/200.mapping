{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "Covers process initiation and the initial customer eligibility check. Re-typing and structural plumbing preserve the described behaviour."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Correctly models the negative eligibility condition and the corresponding inform action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Captures the explicit termination step following customer notification."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Models the positive eligibility branch and the ERP order creation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Open a new order in the ERP system and perform an availability check."
      ],
      "justification": "Continues the positive flow with the availability check action and introduces the subsequent decision gateway. Source overlap is handled as redundancy."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\". If it is not, start producing the missing parts."
      ],
      "justification": "Accurately captures the unavailability condition and the production trigger."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process. Prepare the products for shipment."
      ],
      "justification": "Models the availability continuation and preparation step. Duplicate action nodes (n8/n9) are redundant but do not alter behaviour."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "Correctly implements the parallel execution (AND split/join), shipping, invoicing, and payment status verification."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Models the payment receipt condition and the associated order closure action."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "and close the order, ending the process."
      ],
      "justification": "Aligns with the terminal closure step referenced in the source fragments."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Captures the non-receipt payment branch and the reminder dispatch action."
    },
    {
      "refs": [
        "action:n15",
        "action:n19"
      ],
      "verbatim_texts": [
        "send a reminder and close the order, ending the process."
      ],
      "justification": "Overlapping source fragment restating the reminder, closure, and termination behaviour already covered. Treated as a match due to behavioural preservation."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Models the reminder count check, the '< 3' threshold, process continuation, and loop convergence."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Correctly captures the '= 3' threshold, lawyer notification, final process termination, and structural convergence."
    }
  ],
