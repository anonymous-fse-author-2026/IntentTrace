{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "Initiates the process and captures the opening sequence of actions."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
      ],
      "justification": "Models the credit condition check, applies the correct guard, and executes the positive branch action. Re-typing the condition as a preceding action preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if the order exceeds the purchaser's credit allowance"
      ],
      "justification": "Guard correctly captures the threshold condition for the negative branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "there will be an Outstanding Balance."
      ],
      "justification": "Action reflects the resulting state when allowance is exceeded."
    },
    {
      "refs": [
        "action:n7",
        "action:n12"
      ],
      "verbatim_texts": [
        "In the case of an Outstanding Balance, a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "Sequentially places a new order and terminates the process path as specified."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If a new order is placed, it will be recorded in the Accounts Receivable."
      ],
      "justification": "Captures the accounting recording step following the new order placement."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If Payments are Received, the process continues."
      ],
      "justification": "Handles the positive payment outcome with correct guard and continuation action."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "However, if no payments are received, the order is dropped."
      ],
      "justification": "Handles the negative payment outcome, drops the order, and terminates this path."
    },
    {
      "refs": [
        "action:n13",
        "action:n14",
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "Next, identify the order for installation. If the installation needs to be scheduled,"
      ],
      "justification": "Identifies the order, evaluates the scheduling condition, and prepares the branch/guard for the installer assignment."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "an Installer will be assigned."
      ],
      "justification": "Executes the assignment step when the installation scheduling condition is met."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "On the other hand, if the order does not require installation, it will be packed for delivery."
      ],
      "justification": "Guards the false path, packs the order for delivery, and handles convergence/termination."
    }
  ],
