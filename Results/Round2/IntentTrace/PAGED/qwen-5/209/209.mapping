      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "the process begins with receiving an order request."
      ],
      "justification": "Captures the start event and the initial action of receiving the request."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, the order is registered and evaluated."
      ],
      "justification": "Splits the compound sentence into two sequential action steps without changing behaviour."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the evaluation result",
        "is \"NOK\""
      ],
      "justification": "Defines the first XOR decision point based on the evaluation outcome."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Captures the negative guard condition, the resulting termination action, and the end node."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the evaluation result is \"ok\", then the installation process takes place."
      ],
      "justification": "Captures the positive guard condition and the subsequent installation step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the installation",
        "is not successful"
      ],
      "justification": "Defines the second XOR decision point regarding installation success."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Captures the negative installation guard, the termination action, and links to the existing end node."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "if the installation is successful, the next step is to check the installation."
      ],
      "justification": "Captures the positive installation guard and the verification action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the installation is verified, the billing is prepared."
      ],
      "justification": "Directly models the billing preparation step after verification."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, if everything is in order, the order is marked as \"ok\" and the process is completed."
      ],
      "justification": "Models the final marking action, the explicit end-ok step, and the successful completion node."
    }
