branch(b3, AND)
defines(v1, "Inventory level at or below the minimum?", {"Yes", "No"})
defines(v2, "Purchase Order approved?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, e1, c2, n5, n6, b2, n7, n8, n9, n10, n11, n12, n13, n14, n15, e2, c1, b3])
