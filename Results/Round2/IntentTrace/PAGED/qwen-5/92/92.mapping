{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "Start node and initial action directly correspond to the opening instruction."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If there is no fee,"
      ],
      "justification": "First XOR gateway and guard correctly model the 'no fee' condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to register a post-seminar request."
      ],
      "justification": "Action on the 'no fee' branch matches the source step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if there is a fee,"
      ],
      "justification": "Guard correctly captures the alternative condition for the fee path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "create a purchase request."
      ],
      "justification": "Action on the 'fee' branch matches the source step."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Structural end node correctly terminates the 'no fee' path as explicitly stated."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Modeling the approval check as an action step preserves the required verification behaviour."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If it is approved,"
      ],
      "justification": "Second XOR gateway and guard correctly model the approval condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "you will receive an approved notification."
      ],
      "justification": "Action accurately reflects the positive outcome step."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "if the purchase request is rejected,"
      ],
      "justification": "Guard correctly captures the rejection condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "you will be notified of the rejection."
      ],
      "justification": "Action accurately reflects the negative outcome step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "you should then register a post-seminar request."
      ],
      "justification": "Final action step matches the instruction that follows an approved notification."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Structural end node correctly terminates the rejection path as explicitly stated."
    }
  ],
