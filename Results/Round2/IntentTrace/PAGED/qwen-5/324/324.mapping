        "action:n11"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required.",
        "If the answer is \"no,\" continue the process.",
        "If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Captures the first digitalization decision point, including the XOR gateway, correct yes/no guards, and corresponding continuation/digitalization actions."
    },
