init(i1)
action(n1, "Request to Purchase Motorcycle")
action(n2, "Production Order Received?")
action(n5, "Check Material Availability")
branch(b2, XOR)
action(n6, "Order Materials from Supplier")
action(n7, "Receive Materials from Supplier")
action(n8, "Issue Goods and Produce Motorcycles")
action(n9, "Update Stock Information")
branch(b3, XOR)
action(n10, "Dispatch Motorcycles")
action(n13, "Update Sales Information")
converge(c3)
action(n11, "End of Process")
end(e1)
converge(c2)
action(n12, "Place Manufacturing Order")
defines(v2, "Check Material Availability", {"Available", "Unavailable"})
defines(v3, "Post-Production Action", {"Dispatch", "Update Sales"})
actor(a_default, "Default", [i1, n1, n2, n5, b2, n6, n7, n8, n9, b3, n10, n13, c3, n11, e1, c2, n12])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n12)
precedence(n6, n7)
precedence(n7, c2)
precedence(n12, c2)
precedence(c2, n8)
precedence(n8, n9)
precedence(n9, b3)
precedence(b3, n10)
precedence(b3, n13)
precedence(n10, c3)
precedence(n13, c3)
precedence(c3, n11)
precedence(n11, e1)
guard(b2, n6, v2 = 'Unavailable')
guard(b2, n12, v2 = 'Available')
guard(b3, n10, v3 = 'Dispatch')
guard(b3, n13, v3 = 'Update Sales')