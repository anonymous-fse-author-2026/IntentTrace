  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "the process begins with a request to purchase a motorcycle."
      ],
      "justification": "Start event and initial request step directly correspond to the opening unit."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once the request is received, the next step is to either continue the process if a production order is received or update the sales information and proceed to order dispatch."
      ],
      "justification": "Models the initial routing decision. A condition/check modeled as an action step preserves behaviour per guidelines."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier."
      ],
      "justification": "Availability check, XOR split, unavailability guard, and ordering step align with the negative branch logic."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Alternatively, if there are available goods for production, a manufacturing order is placed."
      ],
      "justification": "Positive branch from the XOR split and corresponding manufacturing order action."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier, the goods are issued and the motorcycles are produced."
      ],
      "justification": "Receipt of materials and subsequent production/issuance steps are direct paraphrases."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "At the same time, the stock is updated and the motorcycles are dispatched."
      ],
      "justification": "Stock update and dispatch actions correspond to the simultaneous step described."
    },
    {
      "refs": [
        "action:n9",
        "action:n11"
      ],
      "verbatim_texts": [
        "After the goods are issued and the motorcycles are produced, the stock is updated and the process ends."
      ],
      "justification": "Convergence point, final stock update, termination action, and end event structurally preserve the flow."
    },
    {
      "refs": [
        "guard:b3->n10",
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, the stock is updated and the sales information is updated."
      ],
      "justification": "Models the concurrent update paths. Guards and branch abstract the split but preserve the described outcomes. Redundant stock update references are acceptable."
    }
  ],
