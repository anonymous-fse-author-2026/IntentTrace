{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "Covers the process start and the initial sequential actions."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "Models the condition as an action step followed by an XOR branch and correct guard leading to the creation step. Behaviour preserved."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Correctly captures the alternative branch condition, the ending step, and the terminal node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Direct paraphrase of the review step."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "Captures the second decision point, the rejected outcome guard, and the rework step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Captures the approved path condition (modeled as an action), guard, and fund reservation."
    },
    {
      "refs": [
        "action:n8",
        "action:n10"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Maps the continuation of the rejected path: rework followed by review."
    },
    {
      "refs": [
        "action:n9",
        "action:n11"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Covers the sequential fund reservation and supplier notification steps."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "AND gateway correctly models simultaneous execution, followed by the two receipt steps."
    },
    {
      "refs": [
        "action:n12",
        "action:n14"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Direct mapping of the slip receiving and recording sequence."
    },
    {
      "refs": [
        "action:n13",
        "action:n15"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Direct mapping of the invoice receiving and recording sequence."
    },
    {
      "refs": [
        "action:n14",
        "action:n16"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Captures the final recording step for the slip and the process termination."
    },
    {
      "refs": [
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Captures the final recording step for the invoice and the process termination."
    }
  ],
