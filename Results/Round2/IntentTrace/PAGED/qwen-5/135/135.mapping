{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with Low Inventory."
      ],
      "justification": "Maps the implicit process start and the initial inventory check action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, proceed to Create P.R.."
      ],
      "justification": "Directly corresponds to the first Purchase Request creation step."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "Then, move on to Create P.R., followed by Submit P.O.."
      ],
      "justification": "Covers the repeated P.R. step and the subsequent P.O. submission exactly as stated."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the P.O. is submitted, proceed to Ship Material."
      ],
      "justification": "Captures the structural convergence point and the material shipping action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "At this point, check if the shipment is okay."
      ],
      "justification": "Represents the verification action and the immediate XOR split it triggers."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed to Send Payment."
      ],
      "justification": "Models the positive condition (abstracted as 'Yes') and the resulting payment action."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if there are any problems with the shipment, communicate them accordingly."
      ],
      "justification": "Models the negative/problem condition (abstracted as 'No') and the communication action."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "After checking the shipment status again, if it is okay, proceed to Send Payment."
      ],
      "justification": "Combines the second status check, the branch node, the positive guard, and the payment action, all deriving from this single clause."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Otherwise, communicate any shipment problems."
      ],
      "justification": "Captures the fallback branch condition and the corresponding communication step."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, once the payment is sent, the process comes to an end."
      ],
      "justification": "Maps the termination description. The duplicate end nodes/actions are redundant structural plumbing that preserves behaviour and are treated as matches."
    }
  ],
