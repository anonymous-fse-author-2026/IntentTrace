{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "you should join the team and agree on the team's domain."
      ],
      "justification": "Initial start node and action capturing the opening requirement to join and agree on the domain."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model and check it."
      ],
      "justification": "Structural join followed by the modeling and checking step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\""
      ],
      "justification": "First evaluation step modeled as an action, immediately followed by the XOR branch."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\""
      ],
      "justification": "Guard captures the affirmative condition leading to penalty assignment."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then assign negative points."
      ],
      "justification": "Direct match for the consequence of the first failed check."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "However, if the process is okay"
      ],
      "justification": "Else-path guard corresponding to the model being acceptable."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\""
      ],
      "justification": "Re-evaluation steps and second branching point for repeated failure."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\""
      ],
      "justification": "Guard for the second failure path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "assign negative points again."
      ],
      "justification": "Consequence of the second failed check."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\""
      ],
      "justification": "Else-path guard from the second check converging forward."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "you can continue with it."
      ],
      "justification": "Structural convergence point for all acceptable model paths."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the process is okay",
        "if the process is okay",
        "you can continue with it."
      ],
      "justification": "Captures the redundant continuation instruction across multiple source fragments."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Direct paraphrase of issue resolution and level extension."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "Branch and guard for the first sub-task option."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "Action corresponding to the check-and-continue path."
    },
    {
      "refs": [
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Guard for the field-analysis option."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Action corresponding to role assignment based on analysis."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Join point and continuation step for executing assigned roles."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Join point and monitoring/consultation step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the project is accepted"
      ],
      "justification": "Project acceptance evaluation and subsequent branching."
    },
    {
      "refs": [
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If the project is accepted"
      ],
      "justification": "Guard for the accepted project path."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "present it."
      ],
      "justification": "Presentation step upon acceptance."
    },
    {
      "refs": [
        "guard:b4->n18"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Guard for the non-accepted/rework path."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Continuation action for unaccepted projects."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "present it again."
      ],
      "justification": "Second presentation attempt after rework."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Final presentation step and process termination."
    }
