{
  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start by claiming what is requested and then check the insured status of the claimant."
      ],
      "justification": "Covers process initialization and the first two sequential actions described in the opening unit."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claimant is insured, proceed to evaluate the claim."
      ],
      "justification": "Captures the XOR decision point, the positive guard condition (abstracted to 'Yes'), and the evaluation action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the claimant is not insured, reject the claim."
      ],
      "justification": "Captures the negative guard condition (abstracted to 'No') and the rejection action."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the claim is rejected, notify the claimant and the process comes to an end."
      ],
      "justification": "Models the notification step followed by an explicit termination action and the structural end node. Redundant termination action preserves behaviour."
    },
    {
      "refs": [
        "action:n_forms"
      ],
      "verbatim_texts": [
        "If the claim is a simple one or a complex one, send the relevant forms accordingly."
      ],
      "justification": "Conditional instruction modeled as a single action step with verbatim content. Re-typing a condition as an action is a behaviour-preserving match."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the forms are returned, check them for completeness."
      ],
      "justification": "Splits the single source unit into two sequential steps (receiving forms, then checking them). Order and behaviour are preserved."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided, proceed to register the claim."
      ],
      "justification": "Captures the second XOR decision, the positive guard (abstracted to 'Yes'), and the registration action."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "However, if not all the relevant details are provided, inform the claimant to complete them."
      ],
      "justification": "Captures the negative guard (abstracted to 'No') and the corresponding notification action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Once the claim is registered, the process comes to an end."
      ],
      "justification": "Models the final termination action and structural end node corresponding to the process conclusion."
    }
  ],
