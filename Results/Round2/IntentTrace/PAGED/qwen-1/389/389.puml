@startuml
!theme plain
|a_default| Default
|a_default|
start
:understand the BPMN Model;
:write a failing test;
:extend BPMN mocks to make the test pass;
:is the test green;
:v1: is the test green ({green, not green}); <<objectSignal>>
if () then ([v1 = 'green'])
:check if the level satisfies the project requirements;
:does the level satisfy the project requirements;
:v2: does the level satisfy the project requirements ({yes, no}); <<objectSignal>>
if () then ([v2 = 'yes'])
:end process;
stop
else ([v2 = 'no'])
:continue the process (loop back to write a failing test);
endif
else ([v1 = 'not green'])
:upgrade the test level;
:check if the level satisfies the project requirements;
:does the level satisfy the project requirements;
:v3: does the level satisfy the project requirements ({yes, no}); <<objectSignal>>
if () then ([v3 = 'yes'])
:end process;
stop
else ([v3 = 'no'])
:upgrade the test level once more;
endif
endif
@enduml