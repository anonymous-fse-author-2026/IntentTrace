{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order"
      ],
      "justification": "Init and opening action correctly capture the process trigger and first step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "then check the customer. If the customer is"
      ],
      "justification": "Models the eligibility verification and initiates the XOR decision point."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "not eligible to order"
      ],
      "justification": "Condition for the ineligible branch matches source exactly."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "eligible to order"
      ],
      "justification": "Condition for the eligible branch matches source exactly."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "inform them"
      ],
      "justification": "Executes the required action for ineligible customers."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "open a new order in the ERP system."
      ],
      "justification": "Executes the required action for eligible customers."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "perform an availability check."
      ],
      "justification": "Captures the stock verification step and its subsequent decision split."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Routes flow to production when product is unavailable."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "continue the process"
      ],
      "justification": "Routes flow past the branch when product is available and rejoins."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "start producing the missing parts."
      ],
      "justification": "Directly matches the production trigger for unavailable items."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Matches the pre-shipment preparation step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "ship the products"
      ],
      "justification": "Correctly models the simultaneous (AND) execution of shipping and invoicing tasks."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "while checking for payment."
      ],
      "justification": "Represents payment monitoring occurring alongside/convergently with other tasks."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "If the payment is received"
      ],
      "justification": "Condition for successful payment matches source."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "close the order"
      ],
      "justification": "Action taken upon confirmed payment."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "not received"
      ],
      "justification": "Condition for missing payment matches source."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "send a reminder"
      ],
      "justification": "Action taken when payment is pending."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3"
      ],
      "justification": "Rejoins flows, evaluates the reminder count, and splits based on the threshold."
    },
    {
      "refs": [
        "guard:b4->c3"
      ],
      "verbatim_texts": [
        "less than 3"
      ],
      "justification": "Loop-back condition for continuing process when under limit."
    },
    {
      "refs": [
        "guard:b4->n18"
      ],
      "verbatim_texts": [
        "equal to 3"
      ],
      "justification": "Threshold condition triggering escalation when limit is reached."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "inform the lawyer"
      ],
      "justification": "Escalation action matches the final step requirement."
    }
  ],
