      "verbatim_texts": [
        "the process begins with a request to purchase a motorcycle"
      ],
      "justification": "Initiates the process and captures the initial customer request action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "label:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "continue the process if a production order is received"
      ],
      "justification": "Models the conditional continuation path, including the implicit decision gateway and guard logic."
    },
    {
      "refs": [
        "guard:b1->n4",
        "label:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "update the sales information and proceed to order dispatch"
      ],
      "justification": "Covers the alternative branch that updates sales data and moves to dispatch."
    },
    {
      "refs": [
        "guard:b2->n6",
        "label:b2->n6",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier"
      ],
      "justification": "Captures the unavailability condition (modeled as an action/state step) and the resulting supplier order."
    },
    {
      "refs": [
        "guard:b2->n8",
        "label:b2->n8",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "if there are available goods for production, a manufacturing order is placed"
      ],
      "justification": "Captures the availability condition and the subsequent manufacturing order placement."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier, the goods are issued"
      ],
      "justification": "Directly models the material receipt condition and the goods issuance step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "and the motorcycles are produced"
      ],
      "justification": "Direct match for the production step."
    },
    {
      "refs": [
        "guard:b5->n13",
        "label:b5->n13",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "At the same time, the stock is updated and the motorcycles are dispatched"
      ],
      "justification": "Structural plumbing (split and guards) routes the flow to handle the simultaneous stock update and dispatch actions."
    },
    {
      "refs": [
        "guard:b5->n15",
        "label:b5->n15",
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "the stock is updated and the process ends"
      ],
      "justification": "Routes the flow to the second stock update and correctly terminates the process."
    },
    {
      "refs": [
        "guard:b5->n16",
        "label:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, the stock is updated and the sales information is updated"
      ],
      "justification": "Handles the simultaneous sales information update and rejoins the split flows via convergences."
    }
  ],
