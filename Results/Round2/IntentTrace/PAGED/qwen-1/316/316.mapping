{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "Init node starts the process; action models the explicit first step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "XOR gateway splits flow; guard captures positive condition; action performs the request."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "label:n4->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if an exception is not needed, the process can continue."
      ],
      "justification": "Guard captures negative condition; action and label model continuation; converge rejoins flow."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After the exception is approved"
      ],
      "justification": "Temporal condition modeled as an action step; preserves intended sequencing."
    },
    {
      "refs": [
        "action:n6",
        "action:n8"
      ],
      "verbatim_texts": [
        "the next step is course enrollment, followed by seminar group enrollment."
      ],
      "justification": "Two sequential actions correctly capture both enrollment steps."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the seminar group enrollment is completed, the homework assignment can be started."
      ],
      "justification": "Action directly models starting the homework."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After working on the homework, it should be turned in."
      ],
      "justification": "Action captures the submission step; prior work phase is implicitly handled without changing observable behaviour."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated, and the process can continue."
      ],
      "justification": "Direct match for the evaluation step."
    },
    {
      "refs": [
        "guard:b3->c3"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Negative guard and convergence point correctly model the loop-back for further assignments."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "However, if it was the last homework, the process can continue."
      ],
      "justification": "Decision gateway, positive guard, and action model exiting the homework loop."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "AND gateway splits into two parallel actions; converge rejoins them, preserving simultaneous execution."
    },
    {
      "refs": [
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "After signing up for the exam, it should be attended."
      ],
      "justification": "Sequential actions accurately model signing up and attending."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the exam is attended, it will be evaluated."
      ],
      "justification": "Direct match for exam evaluation."
    },
    {
      "refs": [
        "guard:b4->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue."
      ],
      "justification": "Gateway, positive guard, and action model successful completion; structural end node marks process termination."
    },
    {
      "refs": [
        "guard:b4->c4"
      ],
      "verbatim_texts": [
        "However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Negative guard and convergence model the retry loop for failed exams."
    }
  ],
