@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start User Task;
:v_task: Task Type ({Service Task 1, Service Task 2, Service Task 3}); <<objectSignal>>
switch ()
case ([v_task = "Service Task 1"])
:Continue Process after Service Task 1;
:Merge Continue Process after Service Task 1 and 2;
:Is there a Manual Task?;
:End Process if Manual Task Yes;
stop
case ([v_task = "Service Task 2"])
:Continue Process after Service Task 2;
case ([v_task = "Service Task 3"])
:End Process due to Service Task 3;
stop
endswitch
@enduml