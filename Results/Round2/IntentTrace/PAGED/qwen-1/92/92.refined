init(i0)
action(i1, "To start, please register your participation for the event.")
branch(b1, XOR)
action(n3, "Register post-seminar request")
action(n4, "Create purchase request")
action(n5, "Check purchase request approval status")
branch(b2, XOR)
action(n6, "Approved notification received")
end(e1)
action(n7, "Rejected notification received")
end(e2)
action(n8, "Register post-seminar request")
action(i4_a, "Once you have registered a post-seminar request, the process will come to an end.")
action(i4_b, "Once you have registered a post-seminar request, the process will come to an end.")
action(i9_a, "If you receive a rejection notification, the process will come to an end.")
defines(v1, "Is there a fee?", {"Yes", "No"})
defines(v2, "Check purchase request approval status", {"Approved", "Rejected"})
actor(a_default, "Default", [i0, i1, b1, n3, n4, n5, b2, n6, e1, n7, e2, n8, i4_a, i4_b, i9_a])
precedence(i0, i1)
precedence(i1, b1)
precedence(b1, n3)
precedence(n3, i4_a)
precedence(i4_a, e1)
precedence(b1, n4)
precedence(n4, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(n6, n8)
precedence(n8, i4_b)
precedence(i4_b, e2)
precedence(b2, n7)
precedence(n7, i9_a)
precedence(i9_a, e1)
guard(b1, n3, v1 = 'No')
guard(b1, n4, v1 = 'Yes')
guard(b2, n6, v2 = 'Approved')
guard(b2, n7, v2 = 'Rejected')