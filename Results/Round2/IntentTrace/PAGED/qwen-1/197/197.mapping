      ],
      "verbatim_texts": [
        "To start the process, the customer needs to gather the required items and then inquire about the availability of products."
      ],
      "justification": "Covers process initiation and the first two core steps. 'start process' is implicit structural framing, while gathering items and inquiring about availability directly paraphrase the unit."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "After sending the inquiry, they should wait for the invoice."
      ],
      "justification": "Maps the explicit handoff of the inquiry and the subsequent waiting step. The slight redundancy with the previous inquiry action does not alter process behaviour."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->c_wait_inv",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "Once the invoice is received"
      ],
      "justification": "Models the conditional check for invoice arrival. The XOR branch, generic Yes/No guards, and converge node form standard structural plumbing for a wait-until-true loop, fully preserving the intended behaviour."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "the customer should review the pricing and terms of the items and then send a purchase requisition"
      ],
      "justification": "Directly captures the two sequential actions described in this unit without alteration."
    },
    {
      "refs": [
        "action:n9",
        "action:n10",
        "guard:b2->c_wait_pinv",
        "guard:b2->c1",
        "action:n11",
        "action:n12",
        "guard:b3->c_wait_ship",
        "guard:b3->c1"
      ],
      "verbatim_texts": [
        "they need to wait for the purchase invoice and shipment"
      ],
      "justification": "Splits the combined wait requirement into two parallel synchronization branches. This correctly models awaiting both independent deliveries without changing the overall process flow. Guards and converges serve as harmless loop plumbing."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the purchase invoice and shipment are received, the customer can proceed to receive the invoice."
      ],
      "justification": "The AND gateway (b4) joins the two completed wait branches, accurately reflecting the 'once both are received' synchronization condition before proceeding to the final invoice receipt step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Upon receiving the invoice, they should make the payment."
      ],
      "justification": "Direct match for the payment action triggered upon invoice receipt."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once the payment is made, the transaction is complete and the process ends."
      ],
      "justification": "Captures the transaction finalisation step and explicitly marks the process termination point."
    }
  ],
