{
  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "start by placing an Order and then proceed to Check the Customer's Credit Limit."
      ],
      "justification": "The opening unit implicitly starts the process and describes the first two actions."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "Opens the XOR decision and captures the positive guard leading to the availability check."
    },
    {
      "refs": [
        "guard:b1->c_deny",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Captures the negative guard, denial action, and subsequent convergence/end."
    },
    {
      "refs": [
        "guard:b6->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "After checking the availability, if the response is \"Okay\", proceed to Check the Availability of the Article again."
      ],
      "justification": "Models the second check decision and the positive path to check again."
    },
    {
      "refs": [
        "guard:b6->c_deny",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Maps the negative path of the second check to the same denial and termination nodes, preserving behaviour."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Decision on availability and negative guard leading to production."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Positive guard for availability leading to collection, followed by convergence."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "AND gateway splits into parallel shipping and invoicing steps, then rejoins."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "Check the Payment status. If the payment has been received, close the Order and end the process."
      ],
      "justification": "Covers payment check, positive guard, closure action, and termination."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17",
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3. If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Negative payment path leads to reminder count check (modeled as action), then branches on threshold to write off the order. Condition-as-action and simplified guard values preserve behaviour."
    },
    {
      "refs": [
        "action:n20",
        "action:n21",
        "guard:b4->e3"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder. After writing off the Order, close the Order and end the process."
      ],
      "justification": "Covers sending reminder, closing order, and ending process. Implicit else guard routes to end, which is harmless structural plumbing."
    }
  ],
