init(i1)
action(n_cont, "continue process")
action(n_i3, "continue process")
action(n_pri1, "give priority")
action(n_lookup, "lookup Vendor on SAP")
branch(b2, XOR)
action(n_master, "need Vendor master record")
action(n_inv1, "enter invoice in SAP")
action(n_inv2, "enter invoice in SAP")
action(n_out, "place entered invoices in normal Outbox")
end(e1)
end(e2)
defines(v2, "vendor lookup result", {"Yes", "No"})
actor(a_default, "Default", [i1, n_cont, n_i3, n_pri1, n_lookup, b2, n_master, n_inv1, n_inv2, n_out, e1, e2])
precedence(i1, n_cont)
precedence(n_cont, n_i3)
precedence(n_i3, n_pri1)
precedence(n_pri1, n_lookup)
precedence(n_lookup, b2)
precedence(b2, n_master)
precedence(n_master, e1)
precedence(b2, n_inv1)
precedence(n_inv1, n_inv2)
precedence(n_inv2, n_out)
precedence(n_out, e2)
guard(b2, n_master, v2 = 'No')
guard(b2, n_inv1, v2 = 'Yes')