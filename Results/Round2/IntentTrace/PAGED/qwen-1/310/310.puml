@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start by receiving the invoice;
:Check the invoice for any mismatches;
:v1: Invoice Decision ({re-send, post, block}); <<objectSignal>>
switch ()
case ([v1 = 're-send'])
:re-send the invoice to the customer;
case ([v1 = 'post'])
:post the invoice;
case ([v1 = 'block'])
:block the invoice;
endswitch
:Park the invoice;
:End process;
stop
@enduml