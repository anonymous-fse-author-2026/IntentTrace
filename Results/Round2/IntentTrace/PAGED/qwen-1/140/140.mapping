{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "Initiates the process and covers the first two sequential actions."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "Captures the positive decision path and its guard correctly."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Captures the negative decision path leading to process termination."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Structural join followed by the review action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "Captures the rejection decision path and rework action."
    },
    {
      "refs": [
        "guard:b2->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Captures the approval decision path and fund reservation."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Second part of the compound sentence; funds reserved in previous step."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "AND gateway splits into parallel receipt steps."
    },
    {
      "refs": [
        "action:n16",
        "action:n18"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Sequential steps for packing slip handling."
    },
    {
      "refs": [
        "action:n17",
        "action:n19"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Sequential steps for invoice handling."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Records slip and terminates this parallel branch."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Records invoice and terminates this parallel branch."
    }
  ],
