{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "Establishes the start of the process and covers the initial identification step. n1 is a harmless structural restatement."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer, they should then check the availability of the parts."
      ],
      "justification": "Opens the XOR decision, applies the elicitation condition via guard, and performs the availability check action."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "if they already have the availability information, they can proceed with the process."
      ],
      "justification": "Captures the alternative condition where information is already available and correctly converges the flow back to the main sequence."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer, the team can also continue with the process."
      ],
      "justification": "Guard captures the supplied condition; action represents proceeding along this branch."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if they need to record the customer's details, they should order and receive the part from Disuki."
      ],
      "justification": "Guard captures the recording condition; action covers ordering and receiving the part from Disuki."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "Directly covers the contracting step that follows part receipt."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected, the team can proceed with the payment."
      ],
      "justification": "Directly covers proceeding to payment after collection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "Marks the termination point of the process after payment. n9 is a benign structural marker."
    }
  ],
