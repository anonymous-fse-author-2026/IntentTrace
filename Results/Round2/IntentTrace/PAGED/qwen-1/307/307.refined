init(i1)
action(n2, "check for errors")
branch(b1, XOR)
action(n4, "mark invoice entered correctly")
action(n5, "highlight errors on form and record DEO performance")
action(n7, "the invoice is checked")
end(e1)
defines(v1, "check for errors", {"Yes", "No"})
actor(a_default, "Default", [i1, n2, b1, n4, n5, n7, e1])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n5)
precedence(b1, n4)
precedence(n5, e1)
precedence(n4, n7)
precedence(n7, e1)
guard(b1, n5, v1 = 'Yes')
guard(b1, n4, v1 = 'No')