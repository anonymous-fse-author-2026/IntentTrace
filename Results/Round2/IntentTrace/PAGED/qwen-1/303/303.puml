@startuml
!theme plain
|a_default| Default
|a_default|
start
:start process;
:supply requirement;
:document requirement;
:v_receive: receive method ({fax, mail_or_phone}); <<objectSignal>>
if () then ([v_receive = 'fax'])
:input order into Excel file;
else ([v_receive = 'mail_or_phone'])
:input order into Excel file;
endif
:wait after a week;
:send Excel list to student;
:type orders into MS-Access database;
:ensure database typing is completed;
split
:control incoming order;
split again
:continue to do the check;
end split
:v_correct: order correctness ({correct, incorrect}); <<objectSignal>>
if () then ([v_correct = 'correct'])
:release order;
:send Excel list to student and continue;
else ([v_correct = 'incorrect'])
:contact selling agency;
endif
:v_amount: order amount ({less_5000, more_5000}); <<objectSignal>>
if () then ([v_amount = 'less_5000'])
:order worth less than 5000;
else ([v_amount = 'more_5000'])
:order worth more than 5000;
:contact selling agency and receive actual issue;
endif
:contact client and release order;
:PPC initiates production;
:v_solved: issue solved ({no, yes}); <<objectSignal>>
if () then ([v_solved = 'no'])
:cancel order;
else ([v_solved = 'yes'])
:release order;
:goods will be produced;
:v_cancel: cancel needed ({yes, no}); <<objectSignal>>
if () then ([v_cancel = 'yes'])
:order cancelled;
else ([v_cancel = 'no'])
:check quality of goods;
:create and send quality report;
:release order via memo and ensure warehouse;
:v_final: final task ({invoice, commission, logistics}); <<objectSignal>>
switch ()
case ([v_final = 'invoice'])
:send invoice and report to finance;
case ([v_final = 'commission'])
:commission goods and sign/send memo;
case ([v_final = 'logistics'])
:send goods and ensure logistic memo;
endswitch
:archive memo and close order;
stop
endif
endif
stop
@enduml