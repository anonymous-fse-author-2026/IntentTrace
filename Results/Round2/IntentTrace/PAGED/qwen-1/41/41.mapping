{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks"
      ],
      "justification": "The start node and initial actions directly correspond to the opening instruction. Splitting 'start the process' and 'undergo immigration checks' preserves the described sequence."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "they should select the method for exit control checks"
      ],
      "justification": "Direct paraphrase of the method selection step."
    },
    {
      "refs": [
        "guard:b5->n4",
        "action:n4",
        "guard:b5->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics, they should undergo a check using biometrics. However, if the passenger prefers to use ID documents, they should undergo checks using identity documents."
      ],
      "justification": "XOR split correctly models the choice between biometrics and ID documents. Boolean guards and subsequent actions preserve the described paths, with the convergence node representing the rejoined flow afterward."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission, they should leave the area."
      ],
      "justification": "Models the permission evaluation and the denied/leave branch. Condition modeled as an action step and boolean guard 'v1 = false' correctly capture the denied state without changing behaviour."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Captures the allowed/proceed branch. Guard 'v1 = true' aligns with being permitted to continue."
    },
    {
      "refs": [
        "action:n12",
        "guard:b3->n14",
        "action:n14",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends."
      ],
      "justification": "Models the unsuccessful outcome path, the departure action, and process termination. Guard 'v3 = false' matches the unsuccessful condition."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Models the successful outcome path, continuation, and termination. Guard 'v3 = true' matches success. Multiple end nodes are structural redundancy that does not alter process behaviour."
    }
  ],
