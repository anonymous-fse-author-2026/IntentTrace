{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "Implicitly starts the process and captures the initial registration step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no fee"
      ],
      "justification": "Opens the XOR decision and correctly encodes the 'no fee' path condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "you should proceed to register a post-seminar request"
      ],
      "justification": "Direct match for the action taken on the no-fee path."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "However, if there is a fee"
      ],
      "justification": "Correctly encodes the alternative path condition for when a fee applies."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "you need to create a purchase request."
      ],
      "justification": "Direct match for the fee-based branch action."
    },
    {
      "refs": [
        "action:n5",
        "action:n10"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Captures the termination condition after post-seminar registration. The model applies this closure at two different points in the flow, which is redundant but fully preserves the described behaviour."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Models the approval verification step and the subsequent XOR split."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Condition for the positive approval outcome."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "you will receive an approved notification."
      ],
      "justification": "Direct match for the approval notification step."
    },
    {
      "refs": [
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected"
      ],
      "justification": "Condition for the negative approval outcome."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "you will be notified of the rejection."
      ],
      "justification": "Direct match for the rejection notification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "The conditional trigger is handled by the preceding flow/guards, leaving the core action step. This re-typing preserves behaviour."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Captures the final termination condition following a rejection notification."
    }
  ],
