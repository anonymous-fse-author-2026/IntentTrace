{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start with Password Verification, followed by Verifiy Password."
      ],
      "justification": "Covers the process initiation and the two explicit verification steps. Redundant phrasing in n1 preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If you choose \"Select Cancel\", you will be directed to iforgot.apple.com."
      ],
      "justification": "Captures the first decision branch, its guarding condition, and the resulting navigation action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if you select \"Reset password\", you will be automatically directed to iforgot.apple.com."
      ],
      "justification": "Captures the second decision branch condition and the equivalent navigation action."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "In case you choose \"Retry\", you will need to re-enter your password."
      ],
      "justification": "Captures the third decision branch condition and the re-entry action."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, go to iforgot.apple.com and proceed with Reset Password."
      ],
      "justification": "Converges the prior branches and directly models the subsequent navigation and reset steps."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If you need to re-enter your password, do so and then verify it."
      ],
      "justification": "Models the verification step following re-entry. The re-entry itself is already covered by the Retry branch."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the password is reset, you can return to the iTunes purchases page."
      ],
      "justification": "Directly corresponds to returning to the purchases page after reset."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "From there, select the price of the item."
      ],
      "justification": "Direct match for selecting the item price."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If prompted to \"Enter Password\", verify the password."
      ],
      "justification": "Captures the first prompt condition and the verification action."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "Alternatively, if asked to \"Enter Apple ID\", enter the password."
      ],
      "justification": "Captures the alternative prompt condition and the password entry action."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Finally, enter the password and verify it."
      ],
      "justification": "Converges the prompt branches, executes the final combined step, and terminates the process."
    }
  ],
