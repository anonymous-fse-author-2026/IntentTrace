{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the process for ACME Company, the Resupply Cycle is triggered"
      ],
      "justification": "The initiation event and the first action directly correspond to triggering the resupply cycle."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level"
      ],
      "justification": "Direct paraphrase of the inventory check step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If the Inventory is greater than the Minimum Level"
      ],
      "justification": "Models the conditional check as an action node leading into an XOR branch with appropriate Yes/No guards."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then the process ends."
      ],
      "justification": "Captures the early termination path when the condition is met."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Otherwise, a Purchase Order is created."
      ],
      "justification": "Negative branch outcome correctly mapped to the creation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The Purchase Order is then reviewed."
      ],
      "justification": "Direct match to the review step."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->n9",
        "action:n9",
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected, it is reworked. However, if the Purchase Order is accepted, funds are reserved for payment."
      ],
      "justification": "Accurately models the review decision split, capturing both rejection/rework and acceptance/funds reservation outcomes. The subsequent i8 and i9 units are verbatim repetitions in the source that add no new behaviour, so they are safely absorbed here."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After reserving funds for payment, the Purchase Order is sent to the Supplier."
      ],
      "justification": "Direct match to the dispatch step."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: the Packing Slip is received and the Invoice is received."
      ],
      "justification": "The AND branch correctly models the simultaneous receipt of the slip and invoice."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Upon receiving the Packing Slip, it is recorded."
      ],
      "justification": "Direct match to recording the packing slip."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Similarly, upon receiving the Invoice, it is recorded."
      ],
      "justification": "Direct match to recording the invoice."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Once the funds are released for payment, the payment is issued to the Supplier."
      ],
      "justification": "Correctly sequences fund release and payment issuance."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Finally, the process ends with the issuance of payment to the Supplier."
      ],
      "justification": "Final termination step and associated structural plumbing preserve the described ending behaviour."
    }
  ],
