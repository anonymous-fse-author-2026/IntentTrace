  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start with Insurance \"emergency\" and then analyze the insurance agreement."
      ],
      "justification": "Captures the implicit process start and the two initial setup actions described in the opening unit."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there is coverage, offer immediate help."
      ],
      "justification": "Models the coverage check (condition re-typed as an action step), the decision split, the positive guard, and the corresponding outcome. Preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is no coverage, send out an offer for emergency help."
      ],
      "justification": "Captures the negative branch of the coverage decision and the subsequent action."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the offer is rejected, ask for a rejection notification."
      ],
      "justification": "Models the acceptance/rejection check, decision split, negative guard path, and notification request."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is accepted, proceed with internal accounting."
      ],
      "justification": "Captures the positive acceptance branch and the accounting action."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->c_start"
      ],
      "verbatim_texts": [
        "Repeat the same steps if necessary."
      ],
      "justification": "Implements the looping mechanism with a repetition action, decision point, and feedback connection. Structural elements act as valid plumbing for the described loop."
    },
    {
      "refs": [
        "guard:b3->e1"
      ],
      "verbatim_texts": [
        "The process concludes once all steps have been completed."
      ],
      "justification": "Captures the termination condition and process end node."
    }
  ],
