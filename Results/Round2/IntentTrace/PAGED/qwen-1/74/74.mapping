{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "Covers the implicit process start and the initial metadata entry steps described in the opening unit."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to the IN-Patient step"
      ],
      "justification": "Direct correspondence to the IN-Patient transition action."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: send data to suppliers and create a claim."
      ],
      "justification": "The AND gateway correctly models the simultaneous execution mentioned in the text, followed by the two stated actions."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the data is sent to suppliers, extract the data from the suppliers and transfer it to the doctor's phone."
      ],
      "justification": "Accurately captures the data extraction and transfer to the doctor."
    },
    {
      "refs": [
        "action:n7",
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "After that, confirm the GOP and the process will come to an end."
      ],
      "justification": "Models the GOP confirmation, the resulting decision branch, and the termination of this specific path."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Next, register the case and handle the claim."
      ],
      "justification": "Captures the continuation path when the process does not end, covering case registration and claim handling."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status."
      ],
      "justification": "Maps the secondary data extraction and the conditional record/status update."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Enter the data on the patient's record or confirm the IN-Patient status, and then send the data back to the suppliers."
      ],
      "justification": "Captures the final outbound data transmission step; the preceding conditional update is already accounted for in the previous match."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, receive the payment and conclude the process."
      ],
      "justification": "Converges the divergent paths, records the payment receipt, and terminates the overall process flow."
    }
  ],
