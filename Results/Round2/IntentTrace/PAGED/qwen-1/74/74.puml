!theme plain
|a_default| Default
|a_default|
start
:Start Process;
:Enter Metadata;
split
:IN-Patient Step;
split again
:Send Data to Suppliers;
split again
:Create Claim;
end split
:Extract and Transfer Data from Suppliers to Doctor;
:Confirm GOP;
:path_choice: Process Branch ({GOP_End, Payment_Path}); <<objectSignal>>
