init(i1)
action(n1, "start account check")
branch(b1, XOR)
action(n3, "approve expense report")
action(n4, "evaluate expense report")
branch(b2, XOR)
action(n6, "approve expense report")
action(n7, "end process")
end(e1)
action(n8, "end process")
end(e2)
defines(v1, "amount", {[0-]})
defines(v2, "expense report status", {'acceptable', 'not satisfactory'})
actor(a_default, "Default", [i1, n1, b1, n3, n4, b2, n6, n7, e1, n8, e2])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, e1)
precedence(n4, b2)
precedence(b2, n6)
precedence(b2, n8)
precedence(n6, n7)
precedence(n7, e1)
precedence(n8, e2)
guard(b1, n3, v1 < 200)
guard(b1, n4, v1 >= 200)
guard(b2, n6, v2 = 'acceptable')
guard(b2, n8, v2 = 'not satisfactory')