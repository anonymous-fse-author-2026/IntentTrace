      ],
      "verbatim_texts": [
        "To acquire a new client, the first step is to identify the need for a new client."
      ],
      "justification": "The opening unit implicitly starts the process and describes the first identification step."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "prepare a portfolio presentation and analyze the market"
      ],
      "justification": "The model splits the simultaneous tasks into two actions, preserving the parallel behaviour described in the source."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the next step is to send an offer to the potential client."
      ],
      "justification": "Directly maps to the next step after the initial parallel tasks."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "inform management about the potential client's responses."
      ],
      "justification": "Exact restatement of the management notification step."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "the responses need to be analyzed and negotiations can begin."
      ],
      "justification": "Split into two sequential actions, preserving the required analysis and negotiation start."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "detail the offer according to the client's preferences and receive their response."
      ],
      "justification": "Split into detailing and receiving actions, preserving behaviour."
    },
    {
      "refs": [
        "guard:b1->n11"
      ],
      "verbatim_texts": [
        "If the response is positive"
      ],
      "justification": "Opens the XOR branch and captures the positive condition; 'v1 = Yes' is a behaviour-preserving boolean mapping of 'positive'."
    },
    {
      "refs": [
        "guard:b1->n14"
      ],
      "verbatim_texts": [
        "However, if the response is negative"
      ],
      "justification": "Captures the negative branch condition; 'v1 = No' correctly mirrors 'negative'."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "prepare a contract for signing"
      ],
      "justification": "Direct match for the positive arm action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "analyze the reasons for the rejection and learn from the experience"
      ],
      "justification": "Direct match for the negative arm action."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the contract is prepared, it can be signed, and the process comes to an end."
      ],
      "justification": "Models the signing step, explicitly notes the process ending, and places the terminal node, fully preserving the final sequence."
    }
