init(i1)
action(n2, "provide userdata for flickr")
branch(b1, XOR)
action(n4, "end process successful login")
end(e1)
action(n5, "do you want to try again")
branch(b2, XOR)
action(n6, "provide userdata for flickr again after first failure")
action(n7, "abort process after first failure")
end(e2)
defines(d1, "login_status", {"success", "failure"})
defines(d2, "next_action", {"retry", "abort"})
actor(a_default, "Default", [i1, n2, b1, n4, e1, n5, b2, n6, n7, e2])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, e1)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n7)
precedence(n6, e2)
precedence(n7, e2)
guard(b1, n4, d1 = "success")
guard(b1, n5, d1 = "failure")
guard(b2, n6, d2 = "retry")
guard(b2, n7, d2 = "abort")