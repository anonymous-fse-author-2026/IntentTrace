@startuml
!theme plain
|a_default| Default
|a_default|
start
:start of process;
:is research schedule directly selected;
:v1: is research schedule directly selected ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Research schedule;
else ([v1 = 'No'])
:Provide indications;
:Research schedule;
endif
:Validate schedule;
:is schedule satisfactory first check;
:v2: is schedule satisfactory first check ({No, Yes}); <<objectSignal>>
if () then ([v2 = 'No'])
:Research schedule;
:is schedule satisfactory second check;
:Provide indications;
else ([v2 = 'Yes'])
:Write ticket order to SNCF;
endif
:Validate ticket order;
:is ticket order approved first check;
:Validate ticket order;
:is ticket order approved second check;
:Validate ticket order;
:is ticket order approved third check;
:End;
stop
@enduml