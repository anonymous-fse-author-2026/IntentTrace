      "justification": "Guard routing unsatisfactory schedules back for research."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "perform the action \"Research schedule\""
      ],
      "justification": "Action taken for unsatisfactory schedules."
    },
    {
      "refs": [
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "If it is"
      ],
      "justification": "Guard routing satisfactory schedules forward."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
