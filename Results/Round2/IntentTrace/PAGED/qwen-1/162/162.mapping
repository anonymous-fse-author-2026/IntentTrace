{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start"
      ],
      "justification": "Initiates the process and models the opening phrase as an action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "please provide the userdata for flickr."
      ],
      "justification": "Direct match for the first data input step."
    },
    {
      "refs": [
        "guard:b1->n_succ",
        "action:n_succ"
      ],
      "verbatim_texts": [
        "If the login is successful, the process will end."
      ],
      "justification": "Models the success decision, guard, resulting action, and process termination correctly."
    },
    {
      "refs": [
        "guard:b1->n_fail",
        "action:n_fail"
      ],
      "verbatim_texts": [
        "However, if the login fails, we will continue with the process."
      ],
      "justification": "Models the failure condition and continuation. Re-typing condition as action preserves behavior."
    },
    {
      "refs": [
        "guard:b2->n_r1",
        "action:n_r1"
      ],
      "verbatim_texts": [
        "If you want to try again"
      ],
      "justification": "Captures the first retry branch and corresponding step."
    },
    {
      "refs": [
        "guard:b2->n_a1",
        "action:n_a1"
      ],
      "verbatim_texts": [
        "if you choose to abort, the process will end."
      ],
      "justification": "Captures the first abort option and termination."
    },
    {
      "refs": [
        "guard:b2->n_r2",
        "action:n_r2"
      ],
      "verbatim_texts": [
        "If you still want to try again, please provide the userdata for flickr."
      ],
      "justification": "Captures the repeated retry instruction. Redundancy does not change behavior."
    },
    {
      "refs": [
        "guard:b2->n_a2",
        "action:n_a2"
      ],
      "verbatim_texts": [
        "Alternatively, if you decide to abort, the process will end."
      ],
      "justification": "Captures the repeated abort instruction. Equivalently terminates the process."
    }
  ],
