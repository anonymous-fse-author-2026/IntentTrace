  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "start the process at 8:00 am"
      ],
      "justification": "Structural start node and action directly capture the opening condition and first step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "empty the mailbox"
      ],
      "justification": "Direct match for the second step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty,"
      ],
      "justification": "Models the verification question and the resulting XOR split."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "if not, continue the process."
      ],
      "justification": "Guard captures the negative condition ('No') and action matches the continuation instruction."
    },
    {
      "refs": [
        "guard:b1->e1"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Guard captures the positive condition ('Yes') and structural end node aligns with the termination instruction."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7",
        "action:n7",
        "guard:b2->e2"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again,"
      ],
      "justification": "Captures the repeated check explicitly stated in the text. The added guards and end node flesh out the implied logic without altering behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Directly models the verification step and its decision point."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Positive guard ('Yes') and corresponding action faithfully restate the source."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Negative guard ('No') and action match the alternative path."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Action captures the post-call data completion; converge node correctly merges the conditional paths."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Temporal condition and physical action are split into two steps but preserve the original meaning perfectly."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member,"
      ],
      "justification": "Models the eligibility check and opens the next decision gateway."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Positive guard ('Yes') and action match the successful membership outcome."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Negative guard ('No'), rejection action, and terminal node correctly model the failure path."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Direct match for the subsequent data entry step."
    },
    {
      "refs": [
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles."
      ],
      "justification": "Parallel tasks modeled sequentially do not alter the required business outcome; both steps are preserved."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Explicit termination action matches the textual conclusion."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Hand the letter to Charles and add the new member to the register."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "Prepare an invoice for the new members and continue the process."
      ],
      "justification": "Action matches the invoicing step; structural end node aligns with the overall process completion."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "write the fee amount to the register."
      ],
      "justification": "Matches the final registration step (minor spelling variation in model does not change behaviour)."
    }
