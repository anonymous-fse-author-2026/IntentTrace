{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "In the beginning, if the answer is \"No\""
      ],
      "justification": "Captures process initiation and the opening condition context."
    },
    {
      "refs": [
        "action:n2",
        "label:n1->n2",
        "guard:b2->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "if the answer is \"No\", then we continue the process."
      ],
      "justification": "Models the initial \"No\" response and the resulting continuation step. Labels and guards align with the conditional flow."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"No\" again, we continue the process."
      ],
      "justification": "Directly represents the check for a second \"No\" answer and continued processing."
    },
    {
      "refs": [
        "guard:b2->n4",
        "action:n4",
        "guard:b4->n13",
        "action:n13",
        "guard:b7->n29",
        "action:n29"
      ],
      "verbatim_texts": [
        "However, if the answer is \"Yes\", then we give it priority."
      ],
      "justification": "Maps the positive branch condition to assigning priority. Duplicated across alternative paths preserves identical decision behavior."
    },
    {
      "refs": [
        "action:n5",
        "action:n21"
      ],
      "verbatim_texts": [
        "After that, we look up the Vendor on SAP."
      ],
      "justification": "Directly captures the vendor lookup step. Structural redundancy does not alter the underlying behavior."
    },
    {
      "refs": [
        "action:n6",
        "guard:b3->n7",
        "action:n7",
        "action:n8",
        "action:n22",
        "guard:b6->n23",
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "If the answer is \"No\", then we need a Vendor master record and the process ends."
      ],
      "justification": "Covers the negative branch requiring a master record and terminating the process. Parallel termination paths maintain the same end-state."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9",
        "action:n10",
        "guard:b4->n11",
        "action:n11",
        "action:n12",
        "action:n25",
        "action:n26",
        "guard:b7->n27",
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "But if the answer is \"Yes\", then we enter the invoice in SAP."
      ],
      "justification": "Models entering the invoice upon a positive response. Intermediate confirmation checks and repeated structures preserve the intended flow."
    },
    {
      "refs": [
        "action:n14",
        "guard:b5->n15",
        "action:n15",
        "action:n30",
        "guard:b8->n31",
        "action:n31"
      ],
      "verbatim_texts": [
        "And if the answer is \"Yes\" again, then we enter the invoice in SAP."
      ],
      "justification": "Captures the follow-up positive condition leading to invoice re-entry. Branching logic aligns with the source sequence."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n32",
        "action:n33"
      ],
      "verbatim_texts": [
        "Once the invoice is entered in SAP, we place the entered invoices in the normal Outbox and the process ends."
      ],
      "justification": "Directly models the final Outbox placement and process termination. Redundant actions maintain the correct end-state behavior."
    }
  ],
