@startuml
!theme plain
|a_default| Default
|a_default|
start
:Provide userdata for flickr;
:v_login: Login result ({Successful, Failed}); <<objectSignal>>
if () then ([v_login = 'Successful'])
:End process after successful login;
stop
else ([v_login = 'Failed'])
:Continue process after failed login;
:v_choice: User choice ({Try again, Abort}); <<objectSignal>>
if () then ([v_choice = 'Try again'])
:Try login again;
else ([v_choice = 'Abort'])
:End process after abort;
stop
endif
endif
@enduml