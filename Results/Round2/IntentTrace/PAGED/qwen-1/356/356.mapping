      ],
      "justification": "Direct paraphrase of the shipping step."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "deliver the freight and notify the delivery."
      ],
      "justification": "Captures both concurrent actions described in the unit."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the request for merchandise return is lodged, continue with the process."
      ],
      "justification": "Models the conditional check as an action step, preserving behaviour."
    },
    {
      "refs": [
        "guard:b1->n10",
        "label:b1->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it has been 5 days, invoice the customer."
      ],
      "justification": "Correctly models the time-based condition and the resulting invoice action."
    },
    {
      "refs": [
        "guard:b1->n7",
        "label:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the return is accepted, proceed with accepting the merchandise return."
      ],
      "justification": "Correctly models the acceptance condition and action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "label:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the return is rejected, reject the merchandise return."
      ],
      "justification": "Correctly models the rejection condition and action."
    },
    {
      "refs": [
        "label:n8->e1"
      ],
      "verbatim_texts": [
        "the process ends with the merchandise return request being rejected"
      ],
      "justification": "Captures the explicit process termination description on the rejection path."
    },
    {
      "refs": [
        "guard:b1->n11",
        "label:b1->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If a loss claim report is lodged, approve the loss claim and the process ends."
      ],
      "justification": "Captures loss claim condition and combined approval/end action."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
