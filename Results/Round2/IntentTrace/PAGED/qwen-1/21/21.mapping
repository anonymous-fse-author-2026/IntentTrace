{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process, begin by supplying the requirement and then documenting it."
      ],
      "justification": "Initiation node and three action steps faithfully capture the opening requirement supply and documentation."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the order is received via fax, input the order into an Excel file."
      ],
      "justification": "Models the XOR split, fax condition, and corresponding Excel input action."
    },
    {
      "refs": [
        "guard:b1->n5_1",
        "action:n5_1"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone, also input the order into an Excel file."
      ],
      "justification": "Models the mail/phone condition, duplicate Excel input action, and convergence point."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete after a week, send it to the student."
      ],
      "justification": "Action n6 models the completion condition; n7 models the sending step."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list, type the orders into the MS-Access database."
      ],
      "justification": "Splits the receipt event and database typing action while preserving behaviour."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed."
      ],
      "justification": "Direct match for the completion verification step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the database is completed, control the incoming order."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, continue to do the check."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n13",
        "guard:b2->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the order is correct, release it."
      ],
      "justification": "Captures the correctness decision node, positive guard, and release action."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Send the Excel list to the student and upon receiving it, continue with the process."
      ],
      "justification": "Models sending, reception, and process continuation."
    },
    {
      "refs": [
        "guard:b2->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Models the negative guard branch and contact action."
    },
    {
      "refs": [
        "action:n19",
        "guard:b3->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac, release it."
      ],
      "justification": "Captures the value threshold decision, guard, and release outcome."
    },
    {
      "refs": [
        "guard:b3->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "Captures the higher-value guard and sign-off/check action."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "upon receiving the actual issue"
      ],
      "justification": "Faithfully models the reception condition/event."
    },
    {
      "refs": [
        "action:n22",
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "Once the order is signed off, contact the client and release the order."
      ],
      "justification": "Models the signed-off state, client contact, and subsequent release."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "Models PPC receipt and production initiation."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order.",
        "If the issue can be solved, release the order."
      ],
      "justification": "Decision node and question action cover both solvability conditions."
    },
    {
      "refs": [
        "guard:b4->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "If the issue can be solved, release the order."
      ],
      "justification": "Positive solvability guard and release action."
    },
    {
      "refs": [
        "guard:b4->n29",
        "action:n29"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order."
      ],
      "justification": "Negative solvability guard and cancel action."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "After PPC initiates production, the goods will be produced."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b_cancel->e_cancel",
        "guard:b_cancel->n31"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends. If not,"
      ],
      "justification": "Models cancellation decision, termination path, continuation guard, and convergence."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "check the quality of the goods."
      ],
      "justification": "Direct match following the 'if not' path."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n33",
        "action:n34"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "justification": "Splits memo release and warehouse verification while preserving behaviour."
    },
    {
      "refs": [
        "action:n35",
        "action:n36"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "justification": "Models invoice sending and subsequent finance reporting."
    },
    {
      "refs": [
        "action:n37",
        "action:n38"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods and sign and send the memo."
      ],
      "justification": "AND gateway correctly models simultaneous commissioning and memo handling."
    },
    {
      "refs": [
        "action:n39",
        "action:n40"
      ],
      "verbatim_texts": [
        "Also, send the goods and ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "AND gateway correctly models concurrent goods sending and logistic memo verification."
    },
    {
      "refs": [
        "action:n41",
        "action:n42"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order."
      ],
      "justification": "Direct match for final archival and closure steps."
    },
    {
      "refs": [
        "action:n43",
        "action:n44"
      ],
      "verbatim_texts": [
        "This marks the end of the process."
      ],
      "justification": "Terminal actions, end nodes, and convergence points faithfully represent process conclusion."
    }
  ],
