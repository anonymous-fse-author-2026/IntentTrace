@startuml
!theme plain
|a_default| Default
|a_default|
start
:review the received application;
:load the case data;
:review the case;
:check if there are any new findings;
:v1: new findings ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:recalculate the refund;
else ([v1 = 'No'])
:send a letter of denial;
endif
:check again if there are any new findings;
:v2: new findings again ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:recalculate the refund;
else ([v2 = 'No'])
:send another letter of denial;
endif
:write back the case data;
stop
@enduml