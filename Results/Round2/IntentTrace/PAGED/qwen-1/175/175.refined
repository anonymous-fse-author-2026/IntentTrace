init(i_start)
action(a_return, "Rental Items are Returned to the Store")
branch(b_method, XOR)
action(a_cust_ret, "Customer returns the items to the store")
action(a_crew_pick, "Delivery Crew picks-up items at the event site")
converge(c_method)
action(a_compare, "items counted and compared to the original contract")
branch(b_status, XOR)
action(a_complete, "Order is complete and all items were returned")
action(a_incomplete, "Order is incomplete and items are missing")
action(a_damaged, "Order is complete but items are damaged")
branch(b_post_complete, XOR)
action(a_pack_cond, "Items are packed for an existing order")
action(a_store_cond, "Items are stored for future orders")
converge(c_post_complete)
action(a_pack_lastly, "Lastly, the items are packed for an existing order")
branch(b_final_cond, XOR)
action(a_pack_check, "If the 'Items are packed for an existing order,' we continue the process.")
action(a_store_check, "If the 'Items are stored for future orders,' we also continue the process.")
converge(c_final_cond)
end(e_process)
action(a_email_miss, "email customer to inform them of missing items and replacement charges")
branch(b_miss_ret, XOR)
action(a_miss_yes, "Customer returns the missing items")
action(a_miss_no, "Customer does not return the missing items")
converge(c_miss_ret)
action(a_take_inv, "temporarily take damaged items out of inventory")
branch(b_repair, XOR)
action(a_repaired, "Items are repaired and added into inventory")
action(a_discarded, "Items can't be repaired and are discarded")
action(a_email_rep, "email customer with replacement charges")
end(e_discard)
converge(c_merge)
defines(v_method, "return method", {"Customer", "Delivery"})
defines(v_status, "order status", {"Complete", "Incomplete", "Damaged"})
defines(v_comp_act, "complete action", {"Pack", "Store"})
defines(v_miss_ret, "missing item return", {"Returns", "NoReturn"})
defines(v_repair, "repair status", {"Repaired", "Discarded"})
defines(v_final_act, "final action", {"Pack", "Store"})
actor(a_handler, "ProcessHandler", [i_start, a_return, b_method, a_cust_ret, a_crew_pick, c_method, a_compare, b_status, a_complete, a_incomplete, a_damaged, b_post_complete, a_pack_cond, a_store_cond, c_post_complete, a_pack_lastly, b_final_cond, a_pack_check, a_store_check, c_final_cond, e_process, a_email_miss, b_miss_ret, a_miss_yes, a_miss_no, c_miss_ret, a_take_inv, b_repair, a_repaired, a_discarded, a_email_rep, e_discard, c_merge])
precedence(i_start, a_return)
precedence(a_return, b_method)
precedence(b_method, a_cust_ret)
precedence(b_method, a_crew_pick)
precedence(a_cust_ret, c_method)
precedence(a_crew_pick, c_method)
precedence(c_method, a_compare)
precedence(a_compare, b_status)
precedence(b_status, a_complete)
precedence(b_status, a_incomplete)
precedence(b_status, a_damaged)
precedence(a_complete, b_post_complete)
precedence(b_post_complete, a_pack_cond)
precedence(b_post_complete, a_store_cond)
precedence(a_pack_cond, c_post_complete)
precedence(a_store_cond, c_post_complete)
precedence(c_post_complete, c_merge)
precedence(a_incomplete, a_email_miss)
precedence(a_email_miss, b_miss_ret)
precedence(b_miss_ret, a_miss_yes)
precedence(b_miss_ret, a_miss_no)
precedence(a_miss_yes, c_miss_ret)
precedence(a_miss_no, c_miss_ret)
precedence(c_miss_ret, c_merge)
precedence(a_damaged, a_take_inv)
precedence(a_take_inv, b_repair)
precedence(b_repair, a_repaired)
precedence(b_repair, a_discarded)
precedence(a_repaired, c_merge)
precedence(a_discarded, a_email_rep)
precedence(a_email_rep, e_discard)
precedence(c_merge, a_pack_lastly)
precedence(a_pack_lastly, b_final_cond)
precedence(b_final_cond, a_pack_check)
precedence(b_final_cond, a_store_check)
precedence(a_pack_check, c_final_cond)
precedence(a_store_check, c_final_cond)
precedence(c_final_cond, e_process)
guard(b_method, a_cust_ret, v_method = "Customer")
guard(b_method, a_crew_pick, v_method = "Delivery")
guard(b_status, a_complete, v_status = "Complete")
guard(b_status, a_incomplete, v_status = "Incomplete")
guard(b_status, a_damaged, v_status = "Damaged")
guard(b_post_complete, a_pack_cond, v_comp_act = "Pack")
guard(b_post_complete, a_store_cond, v_comp_act = "Store")
guard(b_miss_ret, a_miss_yes, v_miss_ret = "Returns")
guard(b_miss_ret, a_miss_no, v_miss_ret = "NoReturn")
guard(b_repair, a_repaired, v_repair = "Repaired")
guard(b_repair, a_discarded, v_repair = "Discarded")
guard(b_final_cond, a_pack_check, v_final_act = "Pack")
guard(b_final_cond, a_store_check, v_final_act = "Store")