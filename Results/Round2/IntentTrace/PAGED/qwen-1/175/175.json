    {
      "id": "i_start",
      "type": "init"
    },
    {
      "id": "a_return",
      "type": "action",
      "content": "Rental Items are Returned to the Store"
    },
    {
      "id": "b_method",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "a_cust_ret",
      "type": "action",
      "content": "Customer returns the items to the store"
    },
    {
      "id": "a_crew_pick",
      "type": "action",
      "content": "Delivery Crew picks-up items at the event site"
    },
    {
      "id": "c_method",
      "type": "converge"
    },
    {
      "id": "a_compare",
      "type": "action",
      "content": "items counted and compared to the original contract"
    },
    {
      "id": "b_status",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "a_complete",
      "type": "action",
      "content": "Order is complete and all items were returned"
    },
    {
      "id": "a_incomplete",
      "type": "action",
      "content": "Order is incomplete and items are missing"
    },
    {
      "id": "a_damaged",
      "type": "action",
      "content": "Order is complete but items are damaged"
    },
    {
      "id": "b_post_complete",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "a_pack_cond",
      "type": "action",
      "content": "Items are packed for an existing order"
    },
    {
      "id": "a_store_cond",
      "type": "action",
      "content": "Items are stored for future orders"
    },
    {
      "id": "c_post_complete",
      "type": "converge"
    },
    {
      "id": "a_pack_lastly",
      "type": "action",
      "content": "Lastly, the items are packed for an existing order"
    },
    {
      "id": "b_final_cond",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "a_pack_check",
      "type": "action",
      "content": "If the 'Items are packed for an existing order,' we continue the process."
    },
    {
      "id": "a_store_check",
      "type": "action",
      "content": "If the 'Items are stored for future orders,' we also continue the process."
    },
    {
      "id": "c_final_cond",
      "type": "converge"
    },
    {
      "id": "e_process",
      "type": "end"
    },
    {
      "id": "a_email_miss",
      "type": "action",
      "content": "email customer to inform them of missing items and replacement charges"
    },
    {
      "id": "b_miss_ret",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "a_miss_yes",
      "type": "action",
      "content": "Customer returns the missing items"
    },
    {
      "id": "a_miss_no",
      "type": "action",
      "content": "Customer does not return the missing items"
    },
    {
      "id": "c_miss_ret",
      "type": "converge"
    },
    {
      "id": "a_take_inv",
      "type": "action",
      "content": "temporarily take damaged items out of inventory"
    },
    {
      "id": "b_repair",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "a_repaired",
      "type": "action",
      "content": "Items are repaired and added into inventory"
    },
    {
      "id": "a_discarded",
      "type": "action",
      "content": "Items can't be repaired and are discarded"
    },
    {
      "id": "a_email_rep",
      "type": "action",
      "content": "email customer with replacement charges"
    },
    {
      "id": "e_discard",
      "type": "end"
    },
    {
      "id": "c_merge",
      "type": "converge"
    }
  ],
