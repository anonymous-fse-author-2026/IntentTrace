{
  "matches": [
    {
      "refs": [
        "action:a_return"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Init and action cover the starting step."
    },
    {
      "refs": [
        "guard:b_method->a_cust_ret",
        "action:a_cust_ret"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process."
      ],
      "justification": "Covers the customer return path and associated guard/action."
    },
    {
      "refs": [
        "guard:b_method->a_crew_pick",
        "action:a_crew_pick"
      ],
      "verbatim_texts": [
        "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Covers the crew pickup path, guard/action, and convergence of the two methods."
    },
    {
      "refs": [
        "action:a_compare"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct match for counting/comparing items."
    },
    {
      "refs": [
        "guard:b_status->a_complete",
        "action:a_complete"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process."
      ],
      "justification": "Covers the complete order path."
    },
    {
      "refs": [
        "guard:b_status->a_incomplete",
        "action:a_incomplete"
      ],
      "verbatim_texts": [
        "However, if the \"Order is incomplete and items are missing,\" we still continue the process."
      ],
      "justification": "Covers the incomplete order path."
    },
    {
      "refs": [
        "guard:b_status->a_damaged",
        "action:a_damaged"
      ],
      "verbatim_texts": [
        "Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Covers the damaged order path. Email step is handled downstream; condition match preserves logic."
    },
    {
      "refs": [
        "guard:b_post_complete->a_pack_cond",
        "action:a_pack_cond"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Covers the pack decision path."
    },
    {
      "refs": [
        "guard:b_post_complete->a_store_cond",
        "action:a_store_cond"
      ],
      "verbatim_texts": [
        "Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Covers the store decision path and convergence."
    },
    {
      "refs": [
        "action:a_email_miss"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Direct match for notification step."
    },
    {
      "refs": [
        "guard:b_miss_ret->a_miss_yes",
        "action:a_miss_yes"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process."
      ],
      "justification": "Covers the positive missing-item return path."
    },
    {
      "refs": [
        "guard:b_miss_ret->a_miss_no",
        "action:a_miss_no"
      ],
      "verbatim_texts": [
        "However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Covers the negative return path and convergence."
    },
    {
      "refs": [
        "action:a_take_inv"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Direct match for inventory removal step."
    },
    {
      "refs": [
        "guard:b_repair->a_repaired",
        "action:a_repaired"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process."
      ],
      "justification": "Covers the repair path."
    },
    {
      "refs": [
        "guard:b_repair->a_discarded",
        "action:a_discarded",
        "action:a_email_rep"
      ],
      "verbatim_texts": [
        "On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Covers the discard path, associated email, and terminal node. Behaviour preserved."
    },
    {
      "refs": [
        "action:a_pack_lastly"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b_final_cond->a_pack_check",
        "action:a_pack_check"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Covers the final pack path."
    },
    {
      "refs": [
        "guard:b_final_cond->a_store_check",
        "action:a_store_check"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Covers the final store path and convergence."
    },
    {
      "refs": [
        "converge:c_merge"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Structural convergence covering the first completion statement."
    },
    {
      "refs": [
        "end:e_process"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges, and the process is complete."
      ],
      "justification": "Termination node covering final email and completion."
    }
  ],
