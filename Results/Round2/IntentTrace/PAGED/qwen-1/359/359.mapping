{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Marks the process start and captures the initial identification step."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "Represents the first decision condition. The check is re-typed as an action step (n2) and evaluated via a guard (v1=false), which preserves the branching behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then advertise the vacancy."
      ],
      "justification": "Directly models the action taken when the first condition holds."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "Captures the alternative branch condition and the merge point where the flow rejoins the main path ('continue')."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available"
      ],
      "justification": "Second decision condition, similarly re-typed as an action step and guard with identical logical meaning."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then advertise the vacancy again."
      ],
      "justification": "Directly models the repeated advertisement step triggered by the second condition."
    },
    {
      "refs": [
        "guard:b2->c1",
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Captures the positive outcome of the second check and immediately transitions to the selection step."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "Splits the terminal unit into appointment confirmation and explicit termination description, followed by the formal end node. Splitting does not alter process behaviour."
    }
  ],
