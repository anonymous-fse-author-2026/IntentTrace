{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by checking the customer's order."
      ],
      "justification": "Covers process initiation and the first operational step. Redundant/restated phrasing preserves behaviour."
    },
    {
      "refs": [
        "guard:b_cust->n_reg",
        "action:n_reg"
      ],
      "verbatim_texts": [
        "If the customer is a registered customer, then check their payment morale."
      ],
      "justification": "Models the XOR customer-type split and the registered-customer path correctly."
    },
    {
      "refs": [
        "guard:b_cust->n_new",
        "action:n_new",
        "guard:b_stat->c_avail"
      ],
      "verbatim_texts": [
        "If they are a new customer, then check their status."
      ],
      "justification": "Captures the new-customer branch, status-check action, and subsequent status routing."
    },
    {
      "refs": [
        "guard:b_morale->c_avail"
      ],
      "verbatim_texts": [
        "If their payment morale is good, continue with the process."
      ],
      "justification": "Models the morale decision gateway and the positive continuation path."
    },
    {
      "refs": [
        "guard:b_morale->c_rej",
        "guard:b_stat->c_rej",
        "action:n_rej"
      ],
      "verbatim_texts": [
        "If their payment morale is bad or if they are an end customer, reject the order and end the process."
      ],
      "justification": "Accurately routes both rejection conditions to a convergence point, rejection action, and explicit end."
    },
    {
      "refs": [
        "guard:b_cust->n_whol"
      ],
      "verbatim_texts": [
        "If the customer is a wholesaler,"
      ],
      "justification": "Branch guard for the wholesaler path."
    },
    {
      "refs": [
        "action:n_whol"
      ],
      "verbatim_texts": [
        "enter their data and take the order."
      ],
      "justification": "Direct match for the wholesaler processing step."
    },
    {
      "refs": [
        "action:n_avail"
      ],
      "verbatim_texts": [
        "check the availability of the items."
      ],
      "justification": "Joins prior paths and executes the availability check."
    },
    {
      "refs": [
        "action:n_stock_q",
        "guard:b_stock->n_outs",
        "action:n_outs"
      ],
      "verbatim_texts": [
        "If the items are out of stock, start production."
      ],
      "justification": "Condition re-typed as action+branch; correctly routes out-of-stock case to production start."
    },
    {
      "refs": [
        "guard:b_stock->n_ins",
        "action:n_ins"
      ],
      "verbatim_texts": [
        "If they are in stock, continue with the process."
      ],
      "justification": "Correctly routes in-stock case to process continuation."
    },
    {
      "refs": [
        "action:n_conf"
      ],
      "verbatim_texts": [
        "Once the availability is checked, send the order confirmation."
      ],
      "justification": "Direct match for confirmation dispatch after availability check."
    },
    {
      "refs": [
        "action:n_prod",
        "action:n_conf_p"
      ],
      "verbatim_texts": [
        "produce the article and send the order confirmation."
      ],
      "justification": "Captures production step, second confirmation action, and their convergence with the main confirmation path."
    },
    {
      "refs": [
        "action:n_inv"
      ],
      "verbatim_texts": [
        "send the invoice and deliver the product."
      ],
      "justification": "Direct match for parallel invoicing and delivery."
    },
    {
      "refs": [
        "action:n_pay_q"
      ],
      "verbatim_texts": [
        "Check the payment status."
      ],
      "justification": "Direct match for payment verification step."
    },
    {
      "refs": [
        "guard:b_pay->n_close",
        "action:n_close"
      ],
      "verbatim_texts": [
        "If payment is received, close the order."
      ],
      "justification": "Models payment decision, closure action, and implicit successful termination."
    },
    {
      "refs": [
        "guard:b_pay->n_rem_q",
        "action:n_rem_q"
      ],
      "verbatim_texts": [
        "If no payment is received, check the number of reminders."
      ],
      "justification": "Routes unpaid status to reminder-count verification."
    },
    {
      "refs": [
        "guard:b_rem->n_law",
        "action:n_law"
      ],
      "verbatim_texts": [
        "If there are more than three reminders, engage a lawyer."
      ],
      "justification": "Correctly applies the >3 threshold, engages legal action, and terminates this path."
    },
    {
      "refs": [
        "guard:b_rem->n_send_rem",
        "action:n_send_rem"
      ],
      "verbatim_texts": [
        "If there are three or fewer reminders, send a reminder."
      ],
      "justification": "Correctly applies the <=3 threshold, sends reminder, and terminates this path."
    }
  ],
