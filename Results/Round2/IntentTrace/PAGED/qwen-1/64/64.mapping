{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process for the election of a rector, it is necessary to begin with the rector's final year in their current position."
      ],
      "justification": "Implicitly starts the process and describes the initial triggering step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "the acceptance of proposals for candidates for the rector position should be launched."
      ],
      "justification": "Direct paraphrase of launching proposal acceptance."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the rector can nominate themselves as a candidate for the position."
      ],
      "justification": "Direct match for the self-nomination step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the acceptance of proposals should be stopped."
      ],
      "justification": "Direct match for halting proposal submission."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If a candidate meets the required criteria, they should be included in the list of candidates."
      ],
      "justification": "Correctly models the positive decision branch and its outcome. Abstract guard variable preserves the boolean condition."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "if a candidate does not meet the criteria, they should be informed of the refusal and the process will come to an end."
      ],
      "justification": "Correctly models the negative branch, refusal notification, and early process termination."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the list of candidates has been formed, it should be made public."
      ],
      "justification": "Direct match for publishing the candidate list."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Simultaneously, the candidates should promote their ideas to the public and organize a public meeting of the Academic Senate."
      ],
      "justification": "Correctly captures the parallel execution implied by 'simultaneously' using an AND gateway and two corresponding actions."
    },
    {
      "refs": [
        "action:n11",
        "action:n19"
      ],
      "verbatim_texts": [
        "The public meeting should then commence"
      ],
      "justification": "Both elements represent commencing the meeting (the second acts as loop-entry redundancy). Redundancy is behavior-preserving."
    },
    {
      "refs": [
        "action:n12",
        "action:n20"
      ],
      "verbatim_texts": [
        "an election should be conducted and the votes should be counted."
      ],
      "justification": "Both elements represent conducting the election and counting votes (the second handles the retry loop). Behavior is preserved."
    },
    {
      "refs": [
        "guard:b2->n18"
      ],
      "verbatim_texts": [
        "If the voting fails, another election should be conducted."
      ],
      "justification": "Opens the retry decision and sets the guard for failure condition."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "another election should be conducted."
      ],
      "justification": "Directly corresponds to the instruction to run the election again upon failure."
    },
    {
      "refs": [
        "guard:b2->n14",
        "action:n14",
        "action:n21"
      ],
      "verbatim_texts": [
        "if the voting is successful, the result of the election should be announced."
      ],
      "justification": "Captures the successful voting condition and announcement. 'Voting successful' action is a re-typed condition, which is explicitly permitted as a match."
    },
    {
      "refs": [
        "action:n15",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "the public meeting should be concluded and the candidate should be informed of the election results, marking the end of the process."
      ],
      "justification": "Accurately splits the concluding steps, models the process end, and uses a converge node for structural flow rejoinder without altering behavior."
    }
  ],
