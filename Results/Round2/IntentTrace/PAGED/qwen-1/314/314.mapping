{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Initiates the process and captures the opening step."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->c2",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "Models the first availability check, the negative decision path, and the corresponding advertising action."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "Captures the positive decision path and the flow convergence that represents continuing the process."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "Represents the second availability check, its negative condition, and the repeat advertising action."
    },
    {
      "refs": [
        "guard:b2->c1",
        "action:n3"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Covers the second positive condition and the subsequent applicant selection step."
    },
    {
      "refs": [
        "action:n9",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "Preserves the appointment condition, the termination action, and the final process endpoint."
    }
  ],
