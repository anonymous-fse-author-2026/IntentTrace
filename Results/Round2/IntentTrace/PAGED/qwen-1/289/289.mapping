{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Covers process initiation and the first explicit action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "Abstracts the threshold check to a variable condition and models the review step. Behaviour preserved."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Captures the alternative condition path and the subsequent check action."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Models the translation requirement branch and corresponding action."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Captures the fallback branch and confirmation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Structural convergence followed by the evaluation action."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Models the rejection path and edit action. State label n8 is redundant but harmless."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation.",
        "Once again, evaluate the review decision."
      ],
      "justification": "Combines the approval path and repeated evaluation/check steps into sequential actions."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation.",
        "Once again, evaluate the review decision."
      ],
      "justification": "Combines the approval path and repeated evaluation/check steps into sequential actions."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation.",
        "Once again, evaluate the review decision."
      ],
      "justification": "Combines the approval path and repeated evaluation/check steps into sequential actions."
    },
    {
      "refs": [
        "guard:b4->n15",
        "guard:b4->c2",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Captures the final approval-driven translation and confirmation flow, including structural plumbing."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Evaluation step leading to the final decision split."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Acceptance branch and subsequent processing action."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Rejection branch and edit action."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Final termination steps. Processing expense is already covered, so this maps to the end marker."
    }
  ],
