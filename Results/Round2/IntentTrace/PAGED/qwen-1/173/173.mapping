      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Start event and initial action step directly correspond to the opening instruction."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "Models the conditional check (re-typed as action n2), the XOR split, and both guarded outgoing paths for the first decision."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "Negative arm action matches the advertisement instruction."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "Structural join point corresponding to the 'continue' positive path."
    },
    {
      "refs": [
        "guard:b3->n6",
        "guard:b3->c1"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "Second split and guards matching the repeated availability check."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "Action for the negative outcome of the second check."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Action for the positive outcome matches the selection step."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "Final appointment step and process termination. Redundant 'process ends' action is harmless and preserves behaviour."
    }
  ],
