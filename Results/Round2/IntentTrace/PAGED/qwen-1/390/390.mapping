{
  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "Initiates the process and covers the first two sequential actions."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
      ],
      "justification": "Opens the XOR gateway and captures the positive branch leading to processing the order."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance."
      ],
      "justification": "Captures the negative branch resulting in an outstanding balance."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "In the case of an Outstanding Balance, a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "Models placing the new order and includes the corresponding termination point at the Warehouse."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If a new order is placed, it will be recorded in the Accounts Receivable."
      ],
      "justification": "Directly matches the recording step."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If Payments are Received, the process continues."
      ],
      "justification": "Represents the payment-received path that converges back to the main flow."
    },
    {
      "refs": [
        "guard:b2->e1"
      ],
      "verbatim_texts": [
        "However, if no payments are received, the order is dropped."
      ],
      "justification": "Captures the payment-check decision and its terminating negative branch."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Next, identify the order for installation."
      ],
      "justification": "Directly matches the installation identification step."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled, an Installer will be assigned."
      ],
      "justification": "Captures the positive branch assigning an installer."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "On the other hand, if the order does not require installation, it will be packed for delivery."
      ],
      "justification": "Captures the alternative branch, the packing action, and the final process termination."
    }
  ],
