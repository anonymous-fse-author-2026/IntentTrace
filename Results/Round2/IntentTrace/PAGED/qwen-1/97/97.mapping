{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To check the account, we start by verifying the amount."
      ],
      "justification": "Initiates the process and captures the first verification step."
    },
    {
      "refs": [
        "guard:b1->n2"
      ],
      "verbatim_texts": [
        "If the amount is less than 200 \u20ac,"
      ],
      "justification": "Opens the first decision split and routes the positive threshold branch via a boolean guard abstraction."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "we proceed to approve the expense report."
      ],
      "justification": "Executes the approval action and concludes this implicit process path."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "However, if the amount is 200 \u20ac or more,"
      ],
      "justification": "Routes the alternative threshold branch via a complementary boolean guard abstraction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "we evaluate the expense report."
      ],
      "justification": "Directly matches the evaluation step required for higher amounts."
    },
    {
      "refs": [
        "guard:b2->n4"
      ],
      "verbatim_texts": [
        "If the expense report is deemed acceptable,"
      ],
      "justification": "Opens the second decision split and routes the positive acceptance branch."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "it is approved"
      ],
      "justification": "Directly matches the final approval action for acceptable reports."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "and the process comes to an end."
      ],
      "justification": "Structural termination node mapped to the explicit end-of-process statement."
    },
    {
      "refs": [
        "guard:b2->e3"
      ],
      "verbatim_texts": [
        "On the other hand, if the expense report is not satisfactory, the process also ends."
      ],
      "justification": "Routes the negative evaluation outcome and terminates the process, preserving the described behavior."
    }
  ],
