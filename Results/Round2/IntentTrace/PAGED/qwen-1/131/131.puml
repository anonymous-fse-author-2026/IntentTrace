@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process;
:empty the mailbox;
:check if mailbox is empty;
:v1: is mailbox empty ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
->;
else ([v1 = 'No'])
:check if mailbox is empty again;
:v4: is mailbox empty again ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
->;
else ([v4 = 'No'])
:verify information completeness;
:v2: information completeness ({Complete, Not Complete}); <<objectSignal>>
if () then ([v2 = 'Complete'])
:add incoming mail number, date, and record in letter book;
else ([v2 = 'Not Complete'])
:make telephone call to sender;
:complete data by adding incoming mail number, date, and record in letter book;
endif
:take letter book and member register to Miranda every Wednesday evening;
:check if applicant becomes a member;
:v3: applicant becomes member ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:stamp 'new Member' on the letter and write date;
:write the data;
:v5: simultaneous task choice ({Calculate, Hand}); <<objectSignal>>
if () then ([v5 = 'Calculate'])
:calculate the fee;
else ([v5 = 'Hand'])
:hand the letter to Charles;
endif
:ask Charles to write the amount in the register;
:print membership card with all data and send to new member;
else ([v3 = 'No'])
:write to applicant and inform them of decision;
endif
stop
endif
endif
stop
