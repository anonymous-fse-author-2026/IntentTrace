{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, the customer needs to make a purchase and then connect to the website."
      ],
      "justification": "Start node and initial combined action correctly captured."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "they should search for an item"
      ],
      "justification": "Direct match for the search step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If they choose to \"Add item to cart\""
      ],
      "justification": "Branch, decision action, and positive guard align with the 'Add to cart' choice."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if they select \"Continue Shopping\""
      ],
      "justification": "Guard correctly captures the alternative choice condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "they can proceed to checkout"
      ],
      "justification": "Positive branch outcome action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should continue with the process"
      ],
      "justification": "Negative branch outcome action."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "they can proceed to checkout",
        "they should continue with the process"
      ],
      "justification": "Structural join merging the two choice paths."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they need to enter their address, shipping method, and payment information"
      ],
      "justification": "Checkout data entry step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "they should also authorize the credit card and check the inventory levels"
      ],
      "justification": "Verification step performed concurrently/subsequently."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "they need to enter their address, shipping method, and payment information",
        "they should also authorize the credit card and check the inventory levels"
      ],
      "justification": "Structural merge after data entry and verification."
    },
    {
      "refs": [
        "action:n10",
        "guard:b5->c3"
      ],
      "verbatim_texts": [
        "If the credit card is approved and there is inventory in stock"
      ],
      "justification": "AND gateway, conditional action, XOR branch, and guard collectively model the combined approval/inventory check. Re-typing condition as action preserves behaviour."
    },
    {
      "refs": [
        "converge:c3"
      ],
      "verbatim_texts": [
        "If the credit card is approved and there is inventory in stock",
        "However, if the credit card is denied or there is no inventory in stock, the transaction will end."
      ],
      "justification": "Merges the approval and denial outcomes back into a single flow for downstream steps."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the order confirmation number should be displayed"
      ],
      "justification": "Display confirmation number step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "the final order being shown to the customer"
      ],
      "justification": "Show final order step."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "the order should be confirmed and a confirmation notice should be emailed to the customer"
      ],
      "justification": "Split into two equivalent sequential steps: confirming order and emailing notice."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once the order entry is complete, the process will end."
      ],
      "justification": "Completion flag and process termination."
    }
  ],
