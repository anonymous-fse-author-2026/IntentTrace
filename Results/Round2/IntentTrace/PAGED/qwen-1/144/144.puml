@startuml
!theme plain
|a_default| Default
|a_default|
start
:Password Verification;
:Verify Password;
:Check selection;
:v1: Selection ({Select Cancel, Reset password, Retry}); <<objectSignal>>
switch ()
case ([v1 = 'Select Cancel'])
:Directed to iforgot.apple.com;
case ([v1 = 'Reset password'])
:Automatically directed to iforgot.apple.com;
case ([v1 = 'Retry'])
:Re-enter password;
endswitch
:Verify password;
:Reset Password;
:Return to iTunes purchases page;
:Select price of the item;
:Check prompt type;
:v2: Prompt ({Enter Password, Enter Apple ID}); <<objectSignal>>
if () then ([v2 = 'Enter Password'])
:Verify the password;
else ([v2 = 'Enter Apple ID'])
:Enter the password;
endif
:Enter the password and verify it;
stop
@enduml