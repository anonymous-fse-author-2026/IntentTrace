      "verbatim_texts": [
        "the first step is to look at the order."
      ],
      "justification": "The start node and the first action directly correspond to the opening instruction of the process."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the order is to be rejected, the process should continue. If the order is to be accepted, the process should also continue."
      ],
      "justification": "Re-types a conditional check into an action step. Since both acceptance and rejection simply lead to continuation, the behavioural outcome is fully preserved."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "preparing the assembling order"
      ],
      "justification": "The AND-gateway introduces the parallel split described in the source, and the action directly implements the first parallel task."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "checking availability"
      ],
      "justification": "Directly implements the second parallel task required to run simultaneously."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If there is a backorder"
      ],
      "justification": "Models the backorder condition as a preparatory action followed by an XOR split. The guard using an internal variable name ('Yes') faithfully represents the positive branch without altering decision logic."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "availability needs to be checked again"
      ],
      "justification": "Exact restatement of the step triggered when a backorder exists."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "The explicit 'end' action and the terminal node correctly implement the immediate process termination for the backorder path."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If the item can be reserved, the process should continue."
      ],
      "justification": "The negative guard ('No') captures the complementary condition where reservation succeeds and the flow proceeds to the next steps."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "assemble the bike"
      ],
      "justification": "Direct paraphrase of the next sequential step in the reservation-success path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "ship the product."
      ],
      "justification": "Direct paraphrase of the final operational step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "ship the product."
      ],
      "justification": "Structural convergence, redundant end action, and final end node provide necessary routing plumbing to close the process after shipping. This does not alter behaviour."
