      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks,"
      ],
      "justification": "The start event and first action directly correspond to the opening instruction."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "select the method for exit control checks"
      ],
      "justification": "Directly models the selection step described in the text."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics,"
      ],
      "justification": "Establishes the first XOR decision point and the guard condition for the biometric path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "they should undergo a check using biometrics"
      ],
      "justification": "Accurately represents the action taken on the biometric branch."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if the passenger prefers to use ID documents,"
      ],
      "justification": "Captures the alternative condition for the ID document path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should undergo checks using identity documents"
      ],
      "justification": "Directly corresponds to the action on the ID document branch."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After the exit control checks,"
      ],
      "justification": "Models the rejoining of the split flows before the next decision point."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "if the passenger is denied permission,"
      ],
      "justification": "Establishes the second XOR decision point and the guard condition for the denied path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should leave the area"
      ],
      "justification": "Directly models the action required when permission is denied."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "if the passenger is allowed to continue,"
      ],
      "justification": "Captures the positive condition for continuing the process."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they should proceed to the next step"
      ],
      "justification": "Directly corresponds to the action taken when allowed to continue."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Explicitly marks the termination of the workflow."
