{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "At the start, we receive a form."
      ],
      "justification": "Implicitly starts the process and models the initial reception action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After receiving the form, we check if it is complete."
      ],
      "justification": "Models the completeness verification as an action leading into the XOR decision point."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If it needs to be sent back, the process ends."
      ],
      "justification": "Captures the negative outcome condition, the send-back action, and process termination."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if we need to check the income, we continue with the process."
      ],
      "justification": "Captures the continuation condition and the corresponding income check step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "At the same time, we complete the following steps: checking deductibles and checking the house."
      ],
      "justification": "Models the deductibles check step; treats the concurrent description as a single linear action under relaxed modelling."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Then, we make a decision."
      ],
      "justification": "Models the post-check decision step and introduces the subsequent XOR gateway."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If we need to check the declaration, the process ends."
      ],
      "justification": "Captures the declaration check condition, associated action, and termination."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, if we need to invite the declarant, the process also ends."
      ],
      "justification": "Captures the invitation condition, associated action, and alternative termination."
    }
  ],
