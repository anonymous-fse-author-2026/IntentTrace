@startuml
!theme plain
|a_default| Default
|a_default|
start
:ask the 1st Level Support if there is an issue;
:v3: routing decision ({immediate_resolve, dev_assistance_needed, alternative_dev_flow}); <<objectSignal>>
switch ()
case ([v3 = 'immediate_resolve'])
:provide feedback for the account manager;
case ([v3 = 'dev_assistance_needed'])
:ask the developer for assistance;
:check result again is issue resolved;
:ask the developer for help;
:provide feedback for the account manager;
case ([v3 = 'alternative_dev_flow'])
:Ask the developer and then provide feedback for the 1st Level support;
:Finally, provide feedback for the 1st Level support and then provide feedback for the account manager;
endswitch
stop
@enduml