{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n_mt"
      ],
      "verbatim_texts": [
        "The process starts with an informational meeting that lasts half a day"
      ],
      "justification": "Covers the process initiation and the first action (informational meeting)."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the meeting is successful, the next step is to work on the storyboard, which takes a full day"
      ],
      "justification": "Models the meeting success check and the positive branch leading to storyboard creation."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "if the meeting is not successful, the process ends."
      ],
      "justification": "Models the negative branch for unsuccessful meeting, terminating the process."
    },
    {
      "refs": [
        "action:n5",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the storyboard is successful, the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "Captures the parallel split for site design and content preparation, their convergence, and implicit storyboard success condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After that, the site development takes 2 days"
      ],
      "justification": "Directly corresponds to the site development step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "review process that lasts 1 day"
      ],
      "justification": "Directly corresponds to the review step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the review is successful, it moves on to the approval stage, which takes half a day."
      ],
      "justification": "Models the review check (as an action step) and the subsequent approval stage."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the approval is complete, the process ends."
      ],
      "justification": "Captures the approval decision's positive path leading to process termination."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
      ],
      "justification": "Captures the approval decision's negative path leading to the rebuild step."
    },
    {
      "refs": [
        "action:n14",
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the rebuild is complete, the process ends."
      ],
      "justification": "Models the rebuild completion check and the resulting process end."
    },
    {
      "refs": [
        "guard:b3->n16"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days.",
        "the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Captures the rejection of the initial rebuild, triggering a second rebuild and final process end. Overlapping input units both support this behavior."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days.",
        "the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Captures the rejection of the initial rebuild, triggering a second rebuild and final process end. Overlapping input units both support this behavior."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days.",
        "the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Captures the rejection of the initial rebuild, triggering a second rebuild and final process end. Overlapping input units both support this behavior."
    }
