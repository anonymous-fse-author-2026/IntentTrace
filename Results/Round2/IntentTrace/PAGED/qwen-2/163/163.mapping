  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "Implicitly starts the process and captures the first action of entering metadata."
    },
    {
      "refs": [
        "guard:b1->n2",
        "action:n2"
      ],
      "verbatim_texts": [
        "After entering the metadata, proceed to the IN-Patient step."
      ],
      "justification": "Structural split routing flow to the IN-Patient step; guard values are synthetic placeholders for the branch, preserving behaviour."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: send data to suppliers and create a claim."
      ],
      "justification": "Routes and executes the secondary path involving supplier data and claim creation."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the data is sent to suppliers, extract the data from the suppliers and transfer it to the doctor's phone."
      ],
      "justification": "Direct paraphrase of the extraction and transfer step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After that, confirm the GOP and the process will come to an end."
      ],
      "justification": "Executes GOP confirmation and correctly places an end node for this path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Next, register the case and handle the claim."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Create a claim and handle the claim accordingly."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status."
      ],
      "justification": "Captures the data entry and alternative status confirmation exactly."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Register the case, handle the claim, and then receive the payment."
      ],
      "justification": "Combines the three sequential sub-steps into a single matched action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Enter the data on the patient's record or confirm the IN-Patient status, and then send the data back to the suppliers."
      ],
      "justification": "Direct match covering record update and returning data to suppliers."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Finally, receive the payment and conclude the process."
      ],
      "justification": "Executes final payment receipt and terminates the overall process."
    }
  ],
