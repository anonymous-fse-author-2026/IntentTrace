  "input_elements": [
    {
      "id": "i1",
      "content": "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
    },
    {
      "id": "i2",
      "content": "After entering the metadata, proceed to the IN-Patient step."
    },
    {
      "id": "i3",
      "content": "At the same time, complete the following steps: send data to suppliers and create a claim."
    },
    {
      "id": "i4",
      "content": "Once the data is sent to suppliers, extract the data from the suppliers and transfer it to the doctor's phone."
    },
    {
      "id": "i5",
      "content": "After that, confirm the GOP and the process will come to an end."
    },
    {
      "id": "i6",
      "content": "Next, register the case and handle the claim."
    },
    {
      "id": "i7",
      "content": "Create a claim and handle the claim accordingly."
    },
    {
      "id": "i8",
      "content": "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status."
    },
    {
      "id": "i9",
      "content": "Register the case, handle the claim, and then receive the payment."
    },
    {
      "id": "i10",
      "content": "Enter the data on the patient's record or confirm the IN-Patient status, and then send the data back to the suppliers."
    },
    {
      "id": "i11",
      "content": "Finally, receive the payment and conclude the process."
    }
  ]
