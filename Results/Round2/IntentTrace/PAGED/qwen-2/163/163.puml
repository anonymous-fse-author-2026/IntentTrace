@startuml
!theme plain
|a_default| Default
|a_default|
start
:start and enter metadata;
:v_route: route ({pathA, pathB}); <<objectSignal>>
if () then ([v_route = 'pathA'])
:proceed to IN-Patient step;
:register case and handle claim;
:create claim and handle claim accordingly;
:extract data from suppliers and enter on patient record or confirm IN-Patient;
:register case, handle claim, receive payment;
:enter data on patient record or confirm IN-Patient, send data back to suppliers;
:receive payment and conclude process;
stop
else ([v_route = 'pathB'])
:send data to suppliers and create a claim;
:extract data from suppliers and transfer to doctor's phone;
:confirm the GOP;
stop
endif
