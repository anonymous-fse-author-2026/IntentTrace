  "input_elements": [
    {
      "id": "i1",
      "content": "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
    },
    {
      "id": "i2",
      "content": "If the expense is greater than 1000"
    },
    {
      "id": "i3",
      "content": "the report should be reviewed"
    },
    {
      "id": "i4",
      "content": "However, if the expense is less than or equal to 1000"
    },
    {
      "id": "i5",
      "content": "you should proceed to check if there is a need for translation"
    },
    {
      "id": "i6",
      "content": "If translation is required"
    },
    {
      "id": "i7",
      "content": "proceed to translate the receipts"
    },
    {
      "id": "i8",
      "content": "If not"
    },
    {
      "id": "i9",
      "content": "confirm the receipts"
    },
    {
      "id": "i10",
      "content": "After this, evaluate the review decision."
    },
    {
      "id": "i11",
      "content": "If the report is rejected"
    },
    {
      "id": "i12",
      "content": "If the report is rejected, edit the report."
    },
    {
      "id": "i13",
      "content": "edit the report."
    },
    {
      "id": "i14",
      "content": "If it is approved"
    },
    {
      "id": "i15",
      "content": "continue to check if there is a need for translation."
    },
    {
      "id": "i16",
      "content": "Once again, evaluate the review decision."
    },
    {
      "id": "i17",
      "content": "translate the receipts and then confirm them."
    },
    {
      "id": "i18",
      "content": "Finally, evaluate the receipts decision."
    },
    {
      "id": "i19",
      "content": "If the receipts are accepted, proceed to process the expense."
    },
    {
      "id": "i20",
      "content": "If they are rejected, edit the report."
    },
    {
      "id": "i21",
      "content": "The process ends by processing the expense and then ending it."
    }
  ]
