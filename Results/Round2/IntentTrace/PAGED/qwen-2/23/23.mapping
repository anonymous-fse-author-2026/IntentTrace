{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the DMS Parts Provision Team, the first step is to gather information about the part from the customer, including the make, model, and year."
      ],
      "justification": "Initiates the process and captures the initial information gathering step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once this information is obtained, the team proceeds to check the availability of the part in the local inventory."
      ],
      "justification": "Captures the second step of checking local inventory availability."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the part is found to be available locally"
      ],
      "justification": "Creates the decision point and guards the positive branch; the boolean 'v1 = true' correctly abstracts 'available locally' without changing behaviour."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "it is retrieved from the inventory."
      ],
      "justification": "Action taken on the positive branch."
    },
    {
      "refs": [
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "However, if the part is not available locally"
      ],
      "justification": "Guards the negative branch; 'v1 = false' correctly abstracts 'not available locally'."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the team records the customer's details."
      ],
      "justification": "First step on the negative branch."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "and then orders the part from Disuki."
      ],
      "justification": "Second step on the negative branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After retrieving the part from the local inventory, the process comes to an end."
      ],
      "justification": "Models the termination of the positive path; treating the end-state description as an action plus structural end node preserves behaviour under relaxed re-typing rules."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the part is ordered from Disuki, the process comes to an end."
      ],
      "justification": "Models the termination of the negative path; consistent with the relaxed re-typing rule."
    }
  ],
