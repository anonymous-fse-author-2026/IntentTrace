{
  "matches": [
    {
      "refs": [
        "guard:b_opt->n_res_dir",
        "action:n_res_dir"
      ],
      "verbatim_texts": [
        "Initially, if the option \"research schedule directly\" is selected, then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Models the process start and the positive branch of the initial option decision."
    },
    {
      "refs": [
        "guard:b_opt->n_prov_ind",
        "action:n_prov_ind",
        "action:n_res_after"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Captures the negative branch of the initial option, including providing indications and researching, before converging."
    },
    {
      "refs": [
        "action:n_val_sched"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Validates the schedule and introduces the first satisfaction decision point."
    },
    {
      "refs": [
        "guard:b_sat1->n_res_again",
        "action:n_res_again"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Handles the first unsatisfactory outcome by triggering another research step."
    },
    {
      "refs": [
        "guard:b_sat1->c_pre_write"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Routes the first satisfactory outcome directly toward ticket creation."
    },
    {
      "refs": [
        "branch:b_sat2"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\"."
      ],
      "justification": "Represents the secondary satisfaction check implied by the text structure."
    },
    {
      "refs": [
        "guard:b_sat2->n_prov_ind2",
        "action:n_prov_ind2"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Captures the fallback action when the schedule remains unsatisfactory after the second check."
    },
    {
      "refs": [
        "guard:b_sat2->c_pre_write"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Converges the second satisfactory path with the first, leading to ticket writing."
    },
    {
      "refs": [
        "action:n_write_tkt",
        "action:n_val_tkt1"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Directly implements the ticket writing and initial validation steps."
    },
    {
      "refs": [
        "branch:b_app1"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Splits the flow based on the approval status check."
    },
    {
      "refs": [
        "guard:b_app1->e_end_no"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Terminates the process on the first negative approval check."
    },
    {
      "refs": [
        "guard:b_app1->n_val_tkt2",
        "action:n_val_tkt2"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Re-validates the ticket order upon a positive approval check."
    },
    {
      "refs": [
        "action:n_chk2"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Models the explicit secondary approval check as an action step, preserving sequence."
    },
    {
      "refs": [
        "action:n_chk3"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Models the explicit tertiary approval check as an action step, preserving sequence."
    },
    {
      "refs": [
        "end:e_end_yes"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Terminates the process after the final successful check."
    }
  ],
