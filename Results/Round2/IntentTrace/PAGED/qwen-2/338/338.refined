init(i1)
branch(b_opt, XOR)
action(n_res_dir, "Research schedule")
action(n_prov_ind, "Provide indications")
action(n_res_after, "Research schedule")
converge(c_pre_val)
action(n_val_sched, "Validate schedule")
branch(b_sat1, XOR)
action(n_res_again, "Research schedule")
branch(b_sat2, XOR)
action(n_prov_ind2, "Provide indications")
converge(c_pre_write)
action(n_write_tkt, "Write ticket order to SNCF")
action(n_val_tkt1, "Validate ticket order")
branch(b_app1, XOR)
end(e_end_no)
action(n_val_tkt2, "Validate ticket order")
action(n_chk2, "Check again if the ticket order is approved.")
action(n_chk3, "Check once more if the ticket order is approved.")
end(e_end_yes)
defines(v_opt, "research schedule directly selected", {"Yes", "No"})
defines(v_sat1, "schedule satisfactory", {"Yes", "No"})
defines(v_sat2, "schedule still satisfactory", {"Yes", "No"})
defines(v_app, "ticket order approved", {"Yes", "No"})
actor(a_default, "Default", [i1, b_opt, n_res_dir, n_prov_ind, n_res_after, c_pre_val, n_val_sched, b_sat1, n_res_again, b_sat2, n_prov_ind2, c_pre_write, n_write_tkt, n_val_tkt1, b_app1, e_end_no, n_val_tkt2, n_chk2, n_chk3, e_end_yes])
precedence(i1, b_opt)
precedence(b_opt, n_res_dir)
precedence(b_opt, n_prov_ind)
precedence(n_prov_ind, n_res_after)
precedence(n_res_dir, c_pre_val)
precedence(n_res_after, c_pre_val)
precedence(c_pre_val, n_val_sched)
precedence(n_val_sched, b_sat1)
precedence(b_sat1, n_res_again)
precedence(b_sat1, c_pre_write)
precedence(n_res_again, b_sat2)
precedence(b_sat2, n_prov_ind2)
precedence(b_sat2, c_pre_write)
precedence(n_prov_ind2, c_pre_write)
precedence(c_pre_write, n_write_tkt)
precedence(n_write_tkt, n_val_tkt1)
precedence(n_val_tkt1, b_app1)
precedence(b_app1, e_end_no)
precedence(b_app1, n_val_tkt2)
precedence(n_val_tkt2, n_chk2)
precedence(n_chk2, n_chk3)
precedence(n_chk3, e_end_yes)
guard(b_opt, n_res_dir, v_opt = 'Yes')
guard(b_opt, n_prov_ind, v_opt = 'No')
guard(b_sat1, n_res_again, v_sat1 = 'No')
guard(b_sat1, c_pre_write, v_sat1 = 'Yes')
guard(b_sat2, n_prov_ind2, v_sat2 = 'No')
guard(b_sat2, c_pre_write, v_sat2 = 'Yes')
guard(b_app1, e_end_no, v_app = 'No')
guard(b_app1, n_val_tkt2, v_app = 'Yes')