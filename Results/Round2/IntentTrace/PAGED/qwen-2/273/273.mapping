    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "further hardware repairs are required"
      ],
      "justification": "Represents the additional repair step taken when tests fail. Reusing the same action label as n2 is acceptable redundancy that does not alter process flow."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the hardware inspection process can be concluded"
      ],
      "justification": "Captures the process conclusion for the successful test path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once these additional repairs have been made, the hardware inspection process can be concluded."
      ],
      "justification": "Captures the process conclusion for the retry path. Structural endpoints covering both branches preserve the overall termination behaviour."
    }
