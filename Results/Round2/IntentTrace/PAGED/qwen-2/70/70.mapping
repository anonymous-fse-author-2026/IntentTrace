  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To acquire a new client, the first step is to identify the need for a new client."
      ],
      "justification": "The opening unit implicitly signals process initiation and describes the first concrete action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Simultaneously, it is important to complete the following tasks: prepare a portfolio presentation and analyze the market."
      ],
      "justification": "Combines the simultaneous subtasks into a single action node. Under relaxed comparison, merging parallel steps that don't alter downstream conditions is behaviour-preserving."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once these steps are done, the next step is to send an offer to the potential client."
      ],
      "justification": "Direct match for the offer-sending step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After sending the offer, it is necessary to inform management about the potential client's responses."
      ],
      "justification": "Direct match for notifying management."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Following this, the responses need to be analyzed and negotiations can begin."
      ],
      "justification": "Splits the combined source phrase into two sequential actions. Splitting equivalent steps preserves behaviour."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "During the negotiation process, it is important to detail the offer according to the client's preferences and receive their response."
      ],
      "justification": "Splits the combined source phrase into two sequential actions. Preserves behaviour."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the response is positive"
      ],
      "justification": "Opens the XOR gateway based on the client's feedback."
    },
    {
      "refs": [
        "guard:b1->n11"
      ],
      "verbatim_texts": [
        "positive"
      ],
      "justification": "Captures the positive outcome condition. Modeled as v1='Yes', which is a semantically equivalent guard value."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "prepare a contract for signing"
      ],
      "justification": "Direct match for the positive branch action."
    },
    {
      "refs": [
        "guard:b1->n14"
      ],
      "verbatim_texts": [
        "if the response is negative"
      ],
      "justification": "Captures the negative outcome condition. Modeled as v1='No', which is a semantically equivalent guard value."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "analyze the reasons for the rejection and learn from the experience"
      ],
      "justification": "Direct match for the negative branch action."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the contract is prepared, it can be signed, and the process comes to an end."
      ],
      "justification": "Covers signing the contract and process termination. The explicit 'end' action is structurally redundant with the end node but does not alter behaviour."
    }
  ],
