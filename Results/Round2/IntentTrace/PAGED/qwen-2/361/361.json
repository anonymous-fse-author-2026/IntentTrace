  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, trigger the resupply cycle."
    },
    {
      "id": "i2",
      "content": "After that, check the current inventory level."
    },
    {
      "id": "i3",
      "content": "If the inventory level is above the minimum, then the process ends."
    },
    {
      "id": "i4",
      "content": "However, if the inventory level is below the minimum, create a purchase order."
    },
    {
      "id": "i5",
      "content": "Once the purchase order is created, review it."
    },
    {
      "id": "i6",
      "content": "If the purchase order is rejected, rework the purchase order."
    },
    {
      "id": "i7",
      "content": "But if the purchase order is accepted, continue the process."
    },
    {
      "id": "i8",
      "content": "However, if the purchase order is accepted, continue the process."
    },
    {
      "id": "i9",
      "content": "After reworking the purchase order, review it again."
    },
    {
      "id": "i10",
      "content": "At the same time, complete the following steps: reserve funds for the purchase and send the purchase order to the supplier."
    },
    {
      "id": "i11",
      "content": "Once the packing slip is received, release the reserved funds and then the process ends."
    }
  ]
