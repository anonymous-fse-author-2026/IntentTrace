{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle."
      ],
      "justification": "The start node and the two actions capture the process initiation and the initial resupply trigger described in the opening statement."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, check the current inventory level."
      ],
      "justification": "Direct mapping to the inventory check step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is above the minimum, then the process ends."
      ],
      "justification": "Models the XOR split, the 'above minimum' guard condition, and the subsequent termination path."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the inventory level is below the minimum, create a purchase order."
      ],
      "justification": "Captures the complementary 'below minimum' guard and the purchase order creation action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the purchase order is created, review it."
      ],
      "justification": "Direct match for the initial purchase order review step."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order."
      ],
      "justification": "Models the rejection branch, the corresponding guard, and the rework action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "But if the purchase order is accepted, continue the process.",
        "However, if the purchase order is accepted, continue the process."
      ],
      "justification": "Handles the acceptance condition. The duplicated source phrasing (i7 and i8) is safely consolidated into the same guard and convergence without changing behaviour."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->c2",
        "guard:b3->c1"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, review it again."
      ],
      "justification": "Captures the second review step and the implicit decision gateway required to loop back on rejection or proceed on acceptance."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: reserve funds for the purchase and send the purchase order to the supplier."
      ],
      "justification": "Combines the two parallel steps into a single model action, preserving the required behaviour."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, release the reserved funds and then the process ends."
      ],
      "justification": "Covers the receipt of the slip, fund release, and final process termination."
    }
  ],
