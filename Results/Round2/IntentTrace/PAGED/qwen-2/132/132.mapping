    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, the customer makes an enquiry."
      ],
      "justification": "The opening unit implicitly starts the process and describes the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "we check if the article is in stock."
      ],
      "justification": "Models the stock check as an action step that feeds into an XOR decision gateway, preserving the intended control flow."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the article is available, we continue with the process."
      ],
      "justification": "Captures the positive branch condition and the continuation step. The variable-based guard correctly abstracts the 'available' state without changing decision logic."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "if the article is not available, we abort the enquiry and end the process."
      ],
      "justification": "Captures the negative branch condition, the abort action, and the corresponding early process termination."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "reserving the article"
      ],
      "justification": "Direct paraphrase of the reservation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "calculating the price."
      ],
      "justification": "Direct paraphrase of the price calculation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "we send the offer"
      ],
      "justification": "Direct match to the offer-sending step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "we wait for the customer to accept it."
      ],
      "justification": "Direct match to waiting for customer acceptance."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the customer accepts the offer, we dispatch the article."
      ],
      "justification": "Splits the conditional trigger and the resulting dispatch into two equivalent steps, which preserves the sequential behaviour described."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Models the final termination as both a concluding action and an end node. Redundant structural plumbing does not alter behaviour, so it is a match."
    }
