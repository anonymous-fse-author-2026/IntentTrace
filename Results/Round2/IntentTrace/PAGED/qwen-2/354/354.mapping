      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks"
      ],
      "justification": "Implicitly defines the process start and models the initial immigration check action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then they should select the method for exit control checks."
      ],
      "justification": "Directly models the sequential method-selection step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics, they should undergo a check using biometrics."
      ],
      "justification": "Opens the XOR split, sets the biometric condition guard, and executes the corresponding action. The guard abstracts the textual preference into a variable check without altering the decision logic."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the passenger prefers to use ID documents, they should undergo checks using identity documents."
      ],
      "justification": "Captures the alternative ID-document branch with the correct guard and action. Faithfully preserves the conditional split."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "if the passenger is denied permission"
      ],
      "justification": "Correctly models the denial condition on the second branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should leave the area."
      ],
      "justification": "Models the required action for the denied path."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue,"
      ],
      "justification": "Correctly models the allowance condition for the alternative branch."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they should proceed to the next step."
      ],
      "justification": "Models the required action for the allowed path."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "the passenger should leave the area and the process ends.",
        "the passenger should continue to the next step and the process ends."
      ],
      "justification": "Both terminal paths explicitly state termination. The structural end node correctly captures this finalisation behaviour across both outcomes."
    }
  ],
