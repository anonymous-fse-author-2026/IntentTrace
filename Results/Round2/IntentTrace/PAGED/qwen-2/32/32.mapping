    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "the process goes back to entering expenses."
      ],
      "justification": "Structural converge node handles the loopback flow for the disapproved path, preserving the cyclic behavior."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Accurately models the repeated verification step and its subsequent XOR split."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "But if it is approved"
      ],
      "justification": "Captures the positive condition for the second check."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is not approved"
      ],
      "justification": "Captures the negative condition for the second check, directing flow back to the converge node for looping."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "But if it is approved"
      ],
      "justification": "Text states expenses can be paid out upon this approval; the action step models this payout behavior faithfully."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
