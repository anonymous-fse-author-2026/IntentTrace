        "init:i1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Marks the process initiation. The implicit starting step is captured by the init node."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "Models the first XOR decision point and routes the negative condition using equivalent boolean logic."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then advertise the vacancy"
      ],
      "justification": "Directly corresponds to the advertisement step on the negative branch."
    },
    {
      "refs": [
        "guard:b1->c2"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "Routes the positive condition to convergence points representing process continuation. Structural joins preserve flow without changing behaviour."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available"
      ],
      "justification": "Models the second XOR decision point and routes the negative retry condition using equivalent boolean logic."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then advertise the vacancy again"
      ],
      "justification": "Directly corresponds to the repeated advertisement step."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Captures the second positive condition routing towards selection."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Corresponds to the applicant selection step described in the same unit."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "Correctly models the terminal condition and process completion."
    }
