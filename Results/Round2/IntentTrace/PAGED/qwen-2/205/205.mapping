      ],
      "justification": "Direct match to recording the invoice."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the funds are released for payment"
      ],
      "justification": "Condition modeled as an action step; preserves behaviour under relaxed comparison rules."
