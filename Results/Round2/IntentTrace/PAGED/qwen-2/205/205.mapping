    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, a Purchase Order is created."
      ],
      "justification": "Direct match to the fallback creation step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "The Purchase Order is then reviewed."
      ],
      "justification": "Direct match to the review step."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected, it is reworked."
      ],
      "justification": "Splits flow for the rejection case."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "if the Purchase Order is accepted, funds are reserved for payment."
      ],
      "justification": "Captures the acceptance condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected, it is reworked."
      ],
      "justification": "Action matches the rejection outcome. The repeated clause later in the raw text is redundant noise and does not require duplication."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "if the Purchase Order is accepted, funds are reserved for payment."
      ],
      "justification": "Action matches the acceptance outcome."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
