init(i1)
action(n1, "start with Resupply Cycle Triggered")
action(n2, "check Inventory Level")
branch(b1, XOR)
action(n4, "Create Purchase Order")
converge(c2)
action(n6, "Review Purchase Order")
branch(b2, XOR)
action(n8, "Reserve funds for purchase")
action(n9, "Rework the order")
action(n11, "Review Purchase Order")
action(n10, "Send Order to Suppliers")
branch(b3, AND)
action(n12, "Supplier sends packing slip")
action(n13, "Supplier sends invoice")
action(n14, "record packing slip")
action(n15, "record invoice")
converge(c1)
action(n16, "Release reserved funds and issue payment to supplier")
action(n17, "End process after payment is issued")
action(n5, "End process")
end(e1)
end(e2)
defines(v1, "Inventory level is at or below the minimum", {"below_or_at_minimum", "above_minimum"})
defines(v2, "Purchase Order is approved", {"approved", "rejected"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, c2, n6, b2, n8, n9, n11, n10, b3, n12, n13, n14, n15, c1, n16, n17, n5, e1, e2])
precedence(i1, n1)
precedence(n1, n2)
