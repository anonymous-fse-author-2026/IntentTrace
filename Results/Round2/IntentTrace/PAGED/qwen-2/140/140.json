  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, trigger the resupply cycle and then check the inventory level."
    },
    {
      "id": "i2",
      "content": "If the inventory level is at or below the minimum, create a purchase order."
    },
    {
      "id": "i3",
      "content": "Otherwise, if the inventory level is above the minimum, the process ends."
    },
    {
      "id": "i4",
      "content": "After creating the purchase order, review it."
    },
    {
      "id": "i5",
      "content": "If the purchase status is rejected, rework the purchase order."
    },
    {
      "id": "i6",
      "content": "However, if the purchase status is approved, reserve the funds."
    },
    {
      "id": "i7",
      "content": "and then review it."
    },
    {
      "id": "i8",
      "content": "send the order to the supplier"
    },
    {
      "id": "i9",
      "content": "At the same time, complete the following steps: receive the packing slip and receive the invoice."
    },
    {
      "id": "i10",
      "content": "record it"
    },
    {
      "id": "i11",
      "content": "Record the packing slip and the process ends."
    },
    {
      "id": "i12",
      "content": "Record the invoice and the process ends."
    }
  ]
