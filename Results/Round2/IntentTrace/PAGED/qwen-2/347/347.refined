init(i1)
action(n1, "start the process for ACME")
action(n2, "begin New Resupply Cycle")
action(n3, "Check Levels of Inventory")
branch(b1, XOR)
action(n4, "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report.")
action(n5, "If the inventory is greater than the minimum, generate an Above Minimum Report.")
end(e1)
action(n6, "create Purchase Orders (POs)")
action(n7, "it needs to be reviewed")
branch(b2, XOR)
action(n8, "If the PO is rejected, it needs to be reworked.")
action(n9, "it needs to be created again")
action(n10, "If the PO is approved, it is printed and released in the system.")
branch(b3, AND)
action(n11, "reserve funds for the released POs")
action(n12, "mail the POs to the supplier")
action(n12a, "receive the inventory")
converge(c_loop)
converge(c1)
action(n13, "receive the Packing Slip")
action(n14, "receive the Invoice")
action(n15, "proceed to the Three-way match")
action(n16, "release the funds")
action(n17, "issue the payment")
end(e2)
defines(v_inv_level, "Inventory Level Status", {"BelowOrEqual", "Above"})
defines(v_po_status, "PO Review Status", {"Rejected", "Approved"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, e1, n6, n7, b2, n8, n9, n10, b3, n11, n12, n12a, c_loop, c1, n13, n14, n15, n16, n17, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, e1)
precedence(n4, c_loop)
precedence(n9, c_loop)
precedence(c_loop, n6)
precedence(n6, n7)
precedence(n7, b2)
precedence(b2, n8)
precedence(b2, n10)
precedence(n8, n9)
precedence(n10, b3)
precedence(b3, n11)
precedence(b3, n12)
precedence(n11, c1)
precedence(n12, n12a)
precedence(n12a, c1)
precedence(c1, n13)
precedence(n13, n14)
precedence(n14, n15)
precedence(n15, n16)
precedence(n16, n17)
precedence(n17, e2)
guard(b1, n4, v_inv_level = 'BelowOrEqual')
guard(b1, n5, v_inv_level = 'Above')
guard(b2, n8, v_po_status = 'Rejected')
guard(b2, n10, v_po_status = 'Approved')