{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "Covers the process initiation and the first sequential actions described in the opening unit."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "Captures the XOR split point and the low/equal inventory condition guarding the positive branch."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum",
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
      ],
      "justification": "Models the conditional logic and the corresponding report generation as a single action step, preserving behaviour."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum"
      ],
      "justification": "Captures the alternative condition for the high-inventory branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum",
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Models the high-inventory condition and corresponding report generation."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Correctly places an early termination point for the above-minimum path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)"
      ],
      "justification": "Directly matches the PO creation step triggered when inventory is at/below minimum."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "it needs to be reviewed"
      ],
      "justification": "Matches the mandatory review step following PO creation."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Captures the approval decision point, the rejection guard, and the rework action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "it needs to be created again"
      ],
      "justification": "Models the recreation step after rework and converges the flow back into the creation loop."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Captures the approval guard and the subsequent print/release action."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Structural AND gateway aligns with the explicit simultaneity cue in the source."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "reserve funds for the released POs"
      ],
      "justification": "First parallel branch action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "mail the POs to the supplier"
      ],
      "justification": "Second parallel branch action."
    },
    {
      "refs": [
        "action:n12a"
      ],
      "verbatim_texts": [
        "receive the inventory"
      ],
      "justification": "Outcome of the mailing path."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "receive the Packing Slip"
      ],
      "justification": "Outcome of the fund reservation path."
    },
    {
