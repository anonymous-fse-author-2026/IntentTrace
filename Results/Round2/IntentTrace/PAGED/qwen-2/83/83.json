  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, Rental Items are Returned to the Store."
    },
    {
      "id": "i2",
      "content": "If the \"Customer returns the items to the store,\" then we can continue the process."
    },
    {
      "id": "i3",
      "content": "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
    },
    {
      "id": "i6",
      "content": "During this step, the items are counted and compared to the original contract."
    },
    {
      "id": "i7",
