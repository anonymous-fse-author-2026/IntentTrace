{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Captures the process initiation and the decomposed UI interaction steps. Splitting and redundancy do not change behaviour."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "Models the >1000 condition as a step and gateway, routing to the review action. Abstract guard value preserves the positive branch logic."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Negative branch of the expense condition correctly routes to checking translation need."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts.",
        "If not, confirm the receipts."
      ],
      "justification": "Correctly models the translation decision split and both resulting actions."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts.",
        "If not, confirm the receipts."
      ],
      "justification": "Correctly models the translation decision split and both resulting actions."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts.",
        "If not, confirm the receipts."
      ],
      "justification": "Correctly models the translation decision split and both resulting actions."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts.",
        "If not, confirm the receipts."
      ],
      "justification": "Correctly models the translation decision split and both resulting actions."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Direct paraphrase of the first review evaluation step."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report. If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Models the first review outcome decision with correct rejection/approval routing."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Exact match for the second review evaluation step."
    },
    {
      "refs": [
        "guard:b4->n10",
        "guard:b4->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report. If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Models the second review outcome decision. Reuses the edit action and splits the approval path into translate and confirm steps, preserving behaviour."
    },
    {
      "refs": [
        "action:n14",
        "guard:b5->n15",
        "action:n15",
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision. If the receipts are accepted, proceed to process the expense. If they are rejected, edit the report."
      ],
      "justification": "Accurately captures the final decision point, its evaluation step, and both outcome branches."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Covers the terminal processing step, redundant end actions, process termination node, and structural convergence points. All preserve the described completion behaviour."
    }
  ],
