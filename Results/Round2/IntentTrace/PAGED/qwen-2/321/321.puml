@startuml
!theme plain
|a_default| Default
|a_default|
start
:choose a book;
:v1: choose what to do after selecting book ({details, new, used}); <<objectSignal>>
switch ()
case ([v1 = 'details'])
:view book details;
:v2: choose what to do after viewing book details ({view_new, select_copy}); <<objectSignal>>
if () then ([v2 = 'view_new'])
:view a list of new copies;
else ([v2 = 'select_copy'])
:select a copy and complete process;
endif
case ([v1 = 'new'])
:see a list of new copies;
case ([v1 = 'used'])
:view a list of used copies;
:evaluate list of used copies;
:select preferred copy and complete process;
endswitch
stop
@enduml