@startuml
!theme plain
|a_default| Default
|a_default|
start
:wake up;
:v_hungry: Are you hungry? ({Yes, No}); <<objectSignal>>
if () then ([v_hungry = 'No'])
:take a shower;
else ([v_hungry = 'Yes'])
:have breakfast;
endif
:v_still_hungry: Are you still hungry? ({Yes, No}); <<objectSignal>>
if () then ([v_still_hungry = 'No'])
:take a shower;
else ([v_still_hungry = 'Yes'])
:have breakfast;
endif
:get on the bus;
stop
@enduml