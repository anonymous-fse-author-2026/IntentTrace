    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "In the beginning"
      ],
      "justification": "Implicitly marks the start of the process."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "if the answer is \"No\", then we continue the process."
      ],
      "justification": "Directly restates the first conditional continuation step."
    },
    {
      "refs": [
        "action:i3"
      ],
      "verbatim_texts": [
        "If the answer is \"No\" again, we continue the process."
      ],
      "justification": "Directly restates the second conditional continuation step."
    },
    {
      "refs": [
        "action:i4"
      ],
      "verbatim_texts": [
        "However, if the answer is \"Yes\", then we give it priority."
      ],
      "justification": "Directly restates the priority assignment step."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "After that, we look up the Vendor on SAP."
      ],
      "justification": "Directly restates the vendor lookup step."
    },
    {
      "refs": [
        "guard:b1->i6",
        "action:i6"
      ],
      "verbatim_texts": [
        "If the answer is \"No\", then we need a Vendor master record and the process ends."
      ],
      "justification": "Captures the decision split, the 'No' guard condition, the resulting action requiring a master record, and the explicit process termination."
    },
    {
      "refs": [
        "guard:b1->i7",
        "action:i7"
      ],
      "verbatim_texts": [
        "But if the answer is \"Yes\", then we enter the invoice in SAP."
      ],
      "justification": "Captures the 'Yes' guard condition and the corresponding invoice entry action."
    },
    {
      "refs": [
        "action:i8"
      ],
      "verbatim_texts": [
        "And if the answer is \"Yes\" again, then we enter the invoice in SAP."
      ],
      "justification": "Directly restates the subsequent confirmation/re-entry step."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "Once the invoice is entered in SAP, we place the entered invoices in the normal Outbox and the process ends."
      ],
      "justification": "Captures the final filing action to the Outbox and the second process termination point."
    }
  ],
