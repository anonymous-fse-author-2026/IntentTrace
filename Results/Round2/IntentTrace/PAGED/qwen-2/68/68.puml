@startuml
!theme plain
|a_default| Default
|a_default|
start
:Customer returns the items to the store or Delivery Crew picks-up items at the event site;
:Count and compare items to contract;
:v_order_status: Order status ({Complete returned, Incomplete missing, Damaged}); <<objectSignal>>
switch ()
case ([v_order_status = 'Complete returned'])
:Order is complete and all items were returned;
stop
case ([v_order_status = 'Incomplete missing'])
:Email customer missing items and replacement charges;
:v_missing_return: Missing items return ({Returns missing, Does not return missing}); <<objectSignal>>
if () then ([v_missing_return = 'Returns missing'])
:Customer returns the missing items;
else ([v_missing_return = 'Does not return missing'])
:Customer does not return the missing items;
endif
case ([v_order_status = 'Damaged'])
:Email customer damage and additional charges;
:Temporarily remove damaged items from inventory;
:v_repair_status: Repair status ({Repaired, Cannot repair}); <<objectSignal>>
if () then ([v_repair_status = 'Repaired'])
:Items are repaired and added into inventory;
:Lastly, the items are packed for an existing order;
:v_disposition: Item disposition ({Packed for existing, Stored for future}); <<objectSignal>>
if () then ([v_disposition = 'Packed for existing'])
:Items are packed for an existing order;
else ([v_disposition = 'Stored for future'])
:Items are stored for future orders;
endif
else ([v_repair_status = 'Cannot repair'])
:Items can't be repaired and are discarded;
:Email the customer with replacement charges;
endif
stop
endswitch
@enduml