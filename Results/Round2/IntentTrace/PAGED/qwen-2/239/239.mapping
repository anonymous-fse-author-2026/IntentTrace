      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the company, the first step is to look at the order."
      ],
      "justification": "Initiates the process and performs the initial order examination step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the order is to be rejected, the process should continue. If the order is to be accepted, the process should also continue."
      ],
      "justification": "Models the decision point where the flow splits based on order status. Modeling the decision as an action before the branch preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If the order is to be accepted"
      ],
      "justification": "Guard condition capturing the accepted order path."
    },
    {
      "refs": [
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the order is to be rejected"
      ],
      "justification": "Guard condition capturing the rejected order path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "preparing the assembling order"
      ],
      "justification": "Direct paraphrase of the first concurrent step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "checking availability"
      ],
      "justification": "Direct paraphrase of the second concurrent step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If there is a backorder"
      ],
      "justification": "Captures the secondary decision point regarding stock availability."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "availability needs to be checked again"
      ],
      "justification": "Maps the backorder guard and the corresponding re-check action."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "and the process ends"
      ],
      "justification": "Explicit termination point after handling a backorder."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If the item can be reserved"
      ],
      "justification": "Alternative condition guard leading to the production/shipping path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "assemble the bike"
      ],
      "justification": "Direct match for the assembly step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "then ship the product"
      ],
      "justification": "Final shipping step followed by implicit process completion."
    }
