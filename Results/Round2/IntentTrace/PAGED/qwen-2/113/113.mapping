{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by claiming what is requested"
      ],
      "justification": "Initiates the process and performs the initial claiming step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the insured status of the claimant"
      ],
      "justification": "Direct match for the status check step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the claimant is insured, proceed to evaluate the claim.",
        "However, if the claimant is not insured, reject the claim."
      ],
      "justification": "XOR gateway captures the insured vs. not-insured decision split."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the claimant is insured, proceed to evaluate the claim."
      ],
      "justification": "Guard routes the positive case to the evaluation action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the claimant is not insured, reject the claim."
      ],
      "justification": "Guard routes the negative case to the rejection action."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the claim is rejected, notify the claimant and the process comes to an end."
      ],
      "justification": "Notification, descriptive end action, and structural end node collectively preserve the termination behavior on this branch."
    },
    {
      "refs": [
        "guard:b2->n10",
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "If the claim is a simple one or a complex one, send the relevant forms accordingly."
      ],
      "justification": "XOR gateway and guards correctly model the simple vs. complex claim distinction."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the claim is a simple one or a complex one, send the relevant forms accordingly."
      ],
      "justification": "Splitting the single instruction into two specific actions preserves behavior."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the forms are returned, check them for completeness."
      ],
      "justification": "Direct match for the completeness check."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided, proceed to register the claim.",
        "However, if not all the relevant details are provided, inform the claimant to complete them."
      ],
      "justification": "XOR gateway captures the completeness decision split."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided, proceed to register the claim."
      ],
      "justification": "Guard routes positive case to registration, followed by structural end representing process completion."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "However, if not all the relevant details are provided, inform the claimant to complete them."
      ],
      "justification": "Guard routes negative case to informing action, with convergence node handling flow rejoinder."
    }
