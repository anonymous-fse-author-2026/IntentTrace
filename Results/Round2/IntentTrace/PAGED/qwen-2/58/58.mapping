{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "Initiates the process and models the initial prioritization step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information."
      ],
      "justification": "Directly models the customer information/existence check."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the customer exists"
      ],
      "justification": "Opens the existence decision branch with the correct guard condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "we move on to checking their payment history"
      ],
      "justification": "Models the payment history check on the positive branch."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if the customer does not exist"
      ],
      "justification": "Correctly routes the non-existence case to the appropriate branch."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "we need to verify their customer status"
      ],
      "justification": "Models the status verification step for new customers."
    },
    {
      "refs": [
        "action:n7",
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Condition modeled as an action step followed by a branch and guard preserves the private customer decline logic."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Correctly handles the wholesaler path with customer creation and availability check."
    },
    {
      "refs": [
        "action:n11",
        "guard:b4->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Captures unavailability check, production/decline actions, and explicit termination."
    },
    {
      "refs": [
        "guard:b4->c_merge",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Routes the available case to the confirmation step."
    },
    {
      "refs": [
        "guard:b_prod->n14",
        "guard:b_prod->n15",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "Structural split/join plumbing used to model simultaneous notifications; overall behaviour preserved."
    },
    {
      "refs": [
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Accurately splits packing, invoicing, and readiness states while preserving sequence."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Direct match for the final delivery step."
    },
    {
      "refs": [
        "action:n22",
        "guard:b5->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Payment receipt check and order closure correctly modeled."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Handles the outstanding payment branch and subsequent reminder count check."
    },
    {
      "refs": [
        "action:n25",
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Condition modeled as an action with correct <3 guard preserves the continuation logic."
    },
    {
      "refs": [
        "guard:b6->n27",
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Correctly captures >3 threshold, donning activation, and final termination endpoints."
    }
  ],
