    {
      "refs": [
        "init:n2"
      ],
      "verbatim_texts": [
        "The loan application process starts with receiving the loan application."
      ],
      "justification": "The opening statement defines the process trigger. Modeling it as an init node preserves the starting behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps should be completed: assessing the loan risk and checking the credit history."
      ],
      "justification": "Direct paraphrase combining the two simultaneous checks into a single action step. Behaviour is preserved."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, the eligibility of the applicant is assessed."
      ],
      "justification": "Frames the assessment as a question/action step preceding the decision gateway. Standard modeling choice that preserves flow."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the applicant is eligible, the acceptance pack is prepared."
      ],
      "justification": "Captures the XOR split point, the positive guard (mapped to v1='Yes'), and the corresponding preparation action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the applicant is not eligible, the application is rejected."
      ],
      "justification": "Captures the negative guard (mapped to v1='No') and the rejection action on the alternate branch."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the application is rejected, the loan application process ends."
      ],
      "justification": "Models the termination after rejection using a named end action followed by a formal end node. Structural redundancy does not alter behaviour."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The prepared acceptance pack is then sent."
      ],
      "justification": "Direct match for the sending step following preparation."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the acceptance pack is sent, the process ends."
      ],
      "justification": "Models the successful path termination using a named end action and formal end node. Preserves the finalisation behaviour."
    }
  ],
