init(i1)
action(n1, "start SSP process by receiving the invoice")
action(n2, "sort invoice per client")
action(n3, "sort invoice per vendor")
action(n4, "attach invoice entry form to invoice")
action(n5, "enter required information onto form")
action(n6, "check completeness of the invoice")
branch(b1, XOR)
action(n8, "invoice incomplete - end process")
end(e1)
action(n9, "enter information for SLA")
action(n10, "enter date for completion")
action(n11, "check priority")
branch(b2, XOR)
action(n14, "place red stamp on entry invoice")
action(n13, "priority is low")
converge(c1)
action(n15, "check invoice compliance")
branch(b3, XOR)
action(n17, "invoice compliance not complete - continue checking or act")
action(n16, "invoice compliance complete")
converge(c2)
branch(b4, XOR)
action(n22, "non-compliance invoice processed")
action(n23, "call client")
action(n25, "send postal mail requesting complete information and end process")
end(e3)
converge(c3)
action(n26, "call client and request information")
action(n27, "batch invoice and allocate to DEO")
end(e4)
defines(v1, "completeness", {"Complete", "Incomplete"})
defines(v2, "priority", {"High", "Low"})
defines(v3, "compliance", {"Complete", "Not Complete"})
defines(v4, "routing_condition", {"Experienced Staff", "Normal Case", "None"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, n6, b1, n8, e1, n9, n10, n11, b2, n14, n13, c1, n15, b3, n17, n16, c2, b4, n22, n23, n25, e3, c3, n26, n27, e4])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, n5)
precedence(n5, n6)
precedence(n6, b1)
precedence(b1, n8)
precedence(b1, n9)
precedence(n8, e1)
precedence(n9, n10)
precedence(n10, n11)
precedence(n11, b2)
precedence(b2, n14)
precedence(b2, n13)
precedence(n14, c1)
precedence(n13, c1)
precedence(c1, n15)
precedence(n15, b3)
precedence(b3, n17)
precedence(b3, n16)
precedence(n17, c2)
precedence(n16, c2)
precedence(c2, b4)
precedence(b4, n22)
precedence(b4, n23)
precedence(b4, n25)
precedence(n22, c3)
precedence(n23, c3)
precedence(c3, n26)
precedence(n26, n27)
precedence(n27, e4)
precedence(n25, e3)
guard(b1, n8, v1 = "Incomplete")
guard(b1, n9, v1 = "Complete")
guard(b2, n14, v2 = "High")
guard(b2, n13, v2 = "Low")
guard(b3, n17, v3 = "Not Complete")
guard(b3, n16, v3 = "Complete")
guard(b4, n22, v4 = "Experienced Staff")
guard(b4, n23, v4 = "Normal Case")
guard(b4, n25, v4 = "None")