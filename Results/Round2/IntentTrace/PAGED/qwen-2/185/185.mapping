{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "Structural start node and the first action directly correspond to the opening unit."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "it is sorted per client"
      ],
      "justification": "Direct behavioral match."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor"
      ],
      "justification": "Direct behavioral match."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice"
      ],
      "justification": "Direct behavioral match."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form"
      ],
      "justification": "Direct behavioral match."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked"
      ],
      "justification": "Direct behavioral match."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Captures the XOR split, the negative condition guard, the resulting termination action, and the end node."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered."
      ],
      "justification": "Captures the positive condition guard and the corresponding action."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "The date for completion is also entered and the priority is checked."
      ],
      "justification": "Unit split into two sequential action nodes without changing behavior."
    },
    {
      "refs": [
        "guard:b2->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "Opens the priority decision and models the high-priority arm."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Models the low-priority condition, a placeholder action for continuation, and convergence back to the main flow."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Direct behavioral match."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If it is not complete, the check continues."
      ],
      "justification": "Models the non-complete compliance branch and continuation action."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is complete, the process continues."
      ],
      "justification": "Models the complete compliance branch and convergence back to the main flow."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "First arm of the final routing decision."
    },
    {
      "refs": [
        "guard:b4->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Second arm of the final routing decision."
    },
    {
      "refs": [
        "guard:b4->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Third arm of the routing decision, capturing the condition, action, and process termination."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Converges the three routing paths and executes the stated post-routing step."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO, and the process ends."
      ],
      "justification": "Final processing step and terminal node matching the source conclusion."
    }
  ],
