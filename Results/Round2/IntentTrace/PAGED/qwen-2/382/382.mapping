{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "The init node and two action nodes collectively capture the process start and the arrival/initial handling of the gross pathology request."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed with the Registration gross pathology request."
      ],
      "justification": "Directly models the registration step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "assign a container to the gross pathology request."
      ],
      "justification": "Matches the container assignment step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "make sure to create a barcode scan at the start."
      ],
      "justification": "Captures the barcode creation requirement during registration."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "move on to the Specimen description."
      ],
      "justification": "Direct correspondence to the specimen description phase."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "pay attention to the scan start."
      ],
      "justification": "Maps to the first scan event."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "pay attention to the scan end."
      ],
      "justification": "Maps to the second scan event."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Accurately reflects the repeated scan step for registration continuation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "proceed with Macroscopic description writing."
      ],
      "justification": "Direct match for the macroscopic writing step."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "Tissue processing"
      ],
      "justification": "Models the tissue processing step. The branch and guard act as structural plumbing to route into this task within the concurrent block, preserving behaviour despite modeling the split as XOR."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12",
        "action:n13",
        "guard:b1->n13",
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required. If the answer is \"no,\" continue the process. If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Captures the decision, the yes/no routing, and the digitalization action. Guards correctly map 'yes' to proceeding and 'no' to continuing (convergence)."
    },
    {
      "refs": [
        "action:n14",
        "action:n15",
        "guard:b2->n15",
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "Next, check if \"Digitalization?\" is required again. If the answer is \"no,\" continue the process. If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Identical structure and logic applied to the second digitalization check. Guards and branches preserve the conditional flow."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "assign cases to the pathologist and then move on to Microscopic examination and diagnosis."
      ],
      "justification": "Both actions split from a single source span, preserving the sequential dependency."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "write the pathology report. After writing the report, confirm it."
      ],
      "justification": "Separates the writing and confirmation steps while maintaining their order and meaning."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "deliver it. Then, proceed with the post-report processing."
      ],
      "justification": "Covers delivery and subsequent processing steps accurately."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "To conclude the pathology procedure, close it."
      ],
      "justification": "Directly models the procedure closure step."
    },
    {
      "refs": [
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "Finally, deliver the pathology report and complete the post-report processing."
      ],
      "justification": "Combines the final delivery/completion actions with the process end marker, faithfully restating the concluding instruction."
    }
  ],
