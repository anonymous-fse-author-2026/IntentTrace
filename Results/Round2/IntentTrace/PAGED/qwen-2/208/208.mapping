{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department"
      ],
      "justification": "Process initiation mapped to the start node and an introductory action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin with the Gross pathology request that has arrived."
      ],
      "justification": "Direct paraphrase representing the receipt of the initial request."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed with the Registration gross pathology request."
      ],
      "justification": "Corresponds to completing the registration step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "assign a container to the gross pathology request."
      ],
      "justification": "Exact behavioural match."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "make sure to create a barcode scan at the start."
      ],
      "justification": "Direct match for the barcode creation requirement."
    },
    {
      "refs": [
        "action:n6",
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "For the \"Specimen description\" step, pay attention to the scan start. Then, pay attention to the scan end. Finally, pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Single descriptive unit explicitly split into three scan actions, preserving the intended scanning sequence."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "proceed with Macroscopic description writing."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n10",
        "action:n17"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Tissue processing"
      ],
      "justification": "Models the tissue processing step and its subsequent completion/convergence point."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required."
      ],
      "justification": "Condition modeled as an action step followed by a branch node; decision behaviour preserved."
    },
    {
      "refs": [
        "guard:b1->n12",
        "guard:b1->n13",
        "guard:b2->n15",
        "guard:b2->n16"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process. If the answer is \"yes\","
      ],
      "justification": "Guards capture the yes/no decision logic for both digitalization checks. Operators and values align with the source conditions."
    },
    {
      "refs": [
        "action:n13",
        "action:n16"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Models the negative branch outcome (skip/continue) for both decision points."
    },
    {
      "refs": [
        "action:n12",
        "action:n15"
      ],
      "verbatim_texts": [
        "proceed with Digitalization."
      ],
      "justification": "Models the positive branch outcome for both decision points."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Next, check if \"Digitalization?\" is required again."
      ],
      "justification": "Second condition modeled as action + branch; behaviour preserved."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After that, assign cases to the pathologist and then move on to Microscopic examination and diagnosis."
      ],
      "justification": "Split into two sequential steps, preserving the stated ordering."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the microscopic examination and diagnosis are complete, write the pathology report. After writing the report, confirm it."
      ],
      "justification": "Direct match, correctly split into writing and confirming actions."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "Once the pathology report is confirmed, deliver it. Then, proceed with the post-report processing."
      ],
      "justification": "Direct match, correctly split into delivery and post-processing steps."
    },
    {
      "refs": [
        "action:n24",
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "To conclude the pathology procedure, close it. Finally, deliver the pathology report and complete the post-report processing."
      ],
      "justification": "Closing actions, final delivery, process termination, and structural converges for parallel flows. Redundancy and added structural plumbing do not alter process behaviour."
    }
  ],
