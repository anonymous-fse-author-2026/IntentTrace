{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially, it is important to check the Referee Reports."
      ],
      "justification": "Marks the process start and executes the initial status check."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "continue to monitor if the Referee Reports have been completed."
      ],
      "justification": "Models the ongoing check and introduces the first decision gateway."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If they have been completed"
      ],
      "justification": "Captures the positive outcome condition for the first check."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if they have not been completed"
      ],
      "justification": "Captures the negative outcome condition for the first check."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "you should flag it and send a reminder."
      ],
      "justification": "Directly models the remediation action for incomplete reports."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, you should check again",
        "check again if the Referee Reports have been completed."
      ],
      "justification": "Combines adjacent source fragments describing the re-evaluation step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "check again if the Referee Reports have been completed."
      ],
      "justification": "Second decision gate following the re-check action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If they have, you can continue with the process."
      ],
      "justification": "Positive condition confirming completion on the second check."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "proceed with the process",
        "continue with the process"
      ],
      "justification": "Redundant but behaviour-preserving restatement of moving forward once reports are done."
    },
    {
      "refs": [
        "guard:b2->n4_2"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Negative condition indicating reports remain incomplete on the second check."
    },
    {
      "refs": [
        "action:n4_2"
      ],
      "verbatim_texts": [
        "you should flag it again and send another reminder."
      ],
      "justification": "Models the escalated reminder action for persistent incompletion."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "organizing interviews for the Selection Panel with the top candidates."
      ],
      "justification": "Direct match for the post-report interview organization step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "receive feedback from the interview candidates."
      ],
      "justification": "Direct match for the feedback collection step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "check if a Psychometric Test is required."
      ],
      "justification": "Initiates the testing requirement evaluation and its associated decision node."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "coordinate the second round of selection."
      ],
      "justification": "Covers the path when the test is unnecessary, aligning with the source instruction to continue and coordinate."
    },
    {
      "refs": [
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required"
      ],
      "justification": "Captures the sub-condition requiring external scheduling."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "schedule the test with a third party."
      ],
      "justification": "Direct match for the specialist-involved scheduling path."
    },
    {
      "refs": [
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "Otherwise"
      ],
      "justification": "Captures the default branch when no specialist is needed."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "complete the Psychometric Test."
      ],
      "justification": "Direct match for the standard test execution path."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "continue with the process"
      ],
      "justification": "Structural join that reunites the referee report branches without altering behaviour."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "coordinate the second round of selection."
      ],
      "justification": "Structural join that groups parallel psychometric test outcomes."
    },
    {
      "refs": [
        "label:n11->c2"
      ],
      "verbatim_texts": [
        "coordinate the second round of selection."
      ],
      "justification": "Non-behavioural edge label marking flow progression."
