    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "At the beginning, if someone \"Knows SLA\""
      ],
      "justification": "Captures the process start, the initial knowledge check action, and the XOR gateway that splits the flow based on this condition."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "they should \"continue the process\""
      ],
      "justification": "Models the positive branch outcome. The guard abstracts to v1=\"Yes\" and the action paraphrases the continuation, both preserving the original behaviour."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If they don't \"Know SLA\", they should \"Look up\""
      ],
      "justification": "Models the negative branch outcome. The guard uses v1=\"No\" and the action adds 'SLA' for clarity, which does not alter the process behaviour."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, they should enter the date."
      ],
      "justification": "Directly models the sequential step performed after the first decision block resolves."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the task is \"Urgent\""
      ],
      "justification": "Opens the second XOR decision point and captures the urgent-task condition via a variable guard."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they should \"Red Stamp\""
      ],
      "justification": "Corresponds directly to the action taken when the task is urgent."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is \"Non Urgent\", they should \"continue the process\""
      ],
      "justification": "Models the alternative branch for non-urgent tasks, using a variable guard and a descriptive action that preserves the intended flow."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Captures the process termination. Converges act as harmless structural plumbing rejoining split paths before the end, which is acceptable."
    }
  ],
