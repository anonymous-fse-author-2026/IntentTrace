init(start)
action(act1, "Start ExpenseReport process")
action(act2, "select Edit Report")
branch(br1, XOR)
action(act3, "review report")
action(act4, "check if translation required")
branch(br3, XOR)
action(act5, "translate receipts")
action(act6, "confirm receipts")
converge(j1)
action(act7, "evaluate review decision")
branch(br2, XOR)
action(act8, "edit report")
action(act9, "continue to check translation")
converge(j2)
action(act10, "evaluate review decision again")
branch(br4, XOR)
action(act11, "edit report")
action(act12, "translate and confirm receipts")
converge(j3)
action(act13, "evaluate receipts decision")
branch(br5, XOR)
action(act14, "process expense")
action(act15, "edit report")
converge(j4)
action(act16, "End process")
end(end1)
defines(v1, "expense greater than 1000?", {"Yes", "No"})
defines(v2, "review decision", {"Rejected", "Approved"})
defines(v3, "translation required?", {"Yes", "No"})
defines(v4, "evaluate review decision", {"Rejected", "Approved"})
defines(v5, "evaluate receipts decision", {"Accepted", "Rejected"})
actor(a_default, "Default", [start, act1, act2, br1, act3, act4, br3, act5, act6, j1, act7, br2, act8, act9, j2, act10, br4, act11, act12, j3, act13, br5, act14, act15, j4, act16, end1])
precedence(start, act1)
precedence(act1, act2)
precedence(act2, br1)
precedence(br1, act3)
precedence(br1, act4)
precedence(act3, j1)
precedence(act4, br3)
precedence(br3, act5)
precedence(br3, act6)
precedence(act5, j1)
precedence(act6, j1)
precedence(j1, act7)
precedence(act7, br2)
precedence(br2, act8)
precedence(br2, act9)
precedence(act8, j2)
precedence(act9, j2)
precedence(j2, act10)
precedence(act10, br4)
precedence(br4, act11)
precedence(br4, act12)
precedence(act11, j3)
precedence(act12, j3)
precedence(j3, act13)
precedence(act13, br5)
precedence(br5, act14)
precedence(br5, act15)
precedence(act14, j4)
precedence(act15, j4)
precedence(j4, act16)
precedence(act16, end1)
guard(br1, act3, v1 = 'Yes')
guard(br1, act4, v1 = 'No')
guard(br3, act5, v3 = 'Yes')
guard(br3, act6, v3 = 'No')
guard(br2, act8, v2 = 'Rejected')
guard(br2, act9, v2 = 'Approved')
guard(br4, act11, v4 = 'Rejected')
guard(br4, act12, v4 = 'Approved')
guard(br5, act14, v5 = 'Accepted')
guard(br5, act15, v5 = 'Rejected')