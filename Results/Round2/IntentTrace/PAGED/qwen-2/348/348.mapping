{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "The start node and initial action directly capture the opening billing and invoice receipt steps."
    },
    {
      "refs": [
        "action:n3",
        "guard:b2->n_ret1",
        "guard:b2->n4",
        "action:n_ret1"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned. However, if the invoice is complete, the process continues."
      ],
      "justification": "Completeness check (re-typed as action n3), XOR split b2, guards routing incomplete invoices to return/e1 and complete ones forward. Behaviour preserved."
    },
    {
      "refs": [
        "action:n4",
        "guard:b3->n5",
        "guard:b3->c1",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted. On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Compliance check action, split b3, guards directing non-compliant invoices to further checks and compliant ones to converge c1. Matches source logic."
    },
    {
      "refs": [
        "guard:b4->n5_phone",
        "guard:b4->n5_mail",
        "action:n5_phone",
        "action:n5_mail"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved. But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Split b4 and guards correctly separate phone resolution and mail return paths, matching the conditional outcomes."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Combined payment and resolution action accurately reflects the merged step in the source."
    },
    {
      "refs": [
        "guard:b1->n3",
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Parallel split b1 routes flow to the client billing action n7, preserving the simultaneous execution described."
    },
    {
      "refs": [
        "guard:b5->n8",
        "guard:b5->n10",
        "action:n8"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Split b5 guards on response status, sending 'no response' cases to the 10-day wait action. Behaviour matches."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the client is notified of the payment."
      ],
      "justification": "Direct paraphrase of the client notification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Action n9 and end node e3 directly implement the reminder and termination after the waiting period."
    },
    {
      "refs": [
        "guard:b6->n10_unsat",
        "guard:b6->n10_sat",
        "action:n10",
        "action:n10_unsat",
        "action:n10_sat"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved. However, if the client is satisfied, the process continues."
      ],
      "justification": "Satisfaction check, split b6, guards for both outcomes, discrepancy resolution, continuation action, and end node fully capture the final decision logic."
    }
  ],
