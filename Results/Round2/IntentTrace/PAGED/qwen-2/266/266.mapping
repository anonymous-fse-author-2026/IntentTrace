{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts with an informational meeting"
      ],
      "justification": "Initiates the process and models the starting meeting step."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the meeting is successful"
      ],
      "justification": "Models the positive decision path and gateway for meeting success."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "if the meeting is not successful"
      ],
      "justification": "Models the negative decision path for meeting failure."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Handles the termination path when the meeting is unsuccessful."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "work on the storyboard"
      ],
      "justification": "Direct paraphrase of the storyboard creation step. The implicit storyboard-success condition is absorbed into the flow, preserving behaviour."
    },
    {
      "refs": [
        "action:n6",
        "action:n5"
      ],
      "verbatim_texts": [
        "next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "Splits flow into parallel site design and content preparation, then rejoins, preserving the concurrent nature described."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After that, the site development takes 2 days"
      ],
      "justification": "Direct match for the sequential development step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "it goes through a review process that lasts 1 day"
      ],
      "justification": "Direct match for the review step."
    },
    {
      "refs": [
        "guard:b5->n10",
        "guard:b5->e6"
      ],
      "verbatim_texts": [
        "If the review is successful"
      ],
      "justification": "Models the review outcome decision. The added failure path to end is harmless structural plumbing that does not alter the described successful flow."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "approval stage, which takes half a day"
      ],
      "justification": "Direct match for the approval step."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If the approval is complete"
      ],
      "justification": "Models the positive decision path for approval completion."
    },
    {
      "refs": [
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "if the approval is rejected"
      ],
      "justification": "Models the negative decision path for approval rejection."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Handles termination upon successful approval."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "the site needs to be rebuilt"
      ],
      "justification": "Direct match for the rebuild step triggered by rejection."
    },
    {
      "refs": [
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If the rebuild is complete"
      ],
      "justification": "Models the positive decision path for rebuild completion."
    },
    {
      "refs": [
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again"
      ],
      "justification": "Models the negative decision path for rebuild rejection."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Handles termination upon successful rebuild. Extra end nodes serve as required structural sinks."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "the site needs to be rebuilt again"
      ],
      "justification": "Direct match for the second rebuild attempt."
    }
