{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, the customer should first request information about the organization and then schedule an appointment."
      ],
      "justification": "Captures the process trigger and splits the initial requirements into request and scheduling steps. 'start' is a benign structural placeholder."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the customer is in the \"Intake\" stage, they should proceed with \"Control and measurement\"."
      ],
      "justification": "Models the positive condition of the first decision point and its corresponding action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the customer is a \"Potential client\", the process will come to an end."
      ],
      "justification": "Models the alternative condition leading directly to process termination."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After the \"Control and measurement\" stage, the customer should revisit after two weeks."
      ],
      "justification": "Directly corresponds to the scheduled follow-up visit."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the target has been reached, the process will come to an end."
      ],
      "justification": "Models the successful outcome path terminating the process."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if the customer is dissatisfied or for any other reason, the process will also come to an end."
      ],
      "justification": "Models the unsuccessful outcome path terminating the process. Abstract guards ('Yes'/'No') faithfully represent the positive/negative decision logic."
    }
  ],
