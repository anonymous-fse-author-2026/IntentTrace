@startuml
!theme plain
|a_default| Default
|a_default|
start
:Check if applicant wishes to discuss terms and conditions;
:v1: Applicant wishes to discuss terms and conditions? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Discuss terms and conditions with candidate;
else ([v1 = 'No'])
:Continue with process;
endif
:Check if applicant wants to modify terms and conditions;
:v2: Applicant wants to modify terms and conditions? ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:Check if change is within set client limits;
:v3: Change is within set client limits? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'No'])
:Relay applicant's changes;
else ([v3 = 'Yes'])
:Continue with process;
endif
else ([v2 = 'No'])
->;
endif
:Relay applicant's changes and continue with process;
:Seek approval for the offer and continue with process;
:Modify the terms and conditions accordingly;
:Send the appointment approval and mandatory documentation to HR Services;
:Scan and upload the completed approval form to Cloud Source;
:Make a formal offer;
:Check if the changes are acceptable;
:v4: Changes acceptable? ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:Continue with the process;
else ([v4 = 'No'])
:Select a new applicant from the list;
endif
:Check if the client accepts the changes;
:v5: Client accepts the changes? ({Yes, No}); <<objectSignal>>
if () then ([v5 = 'Yes'])
:End;
stop
else ([v5 = 'No'])
:Select a new candidate from the list;
stop
endif
@enduml