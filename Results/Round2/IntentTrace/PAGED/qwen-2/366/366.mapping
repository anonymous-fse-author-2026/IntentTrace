{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by checking the order received"
      ],
      "justification": "Captures the implicit process start, the generic 'Start process' step, and the explicit order check. Structural/initiation overlap and harmless redundancy preserve behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to check the availability of the article."
      ],
      "justification": "Models the first availability check and correctly introduces the XOR gateway where the flow splits based on that check."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the article is not available, the next step is to initiate the procurement process."
      ],
      "justification": "Accurately captures the negative condition ('No' equivalent) and the corresponding procurement action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the article is available, proceed to ship it."
      ],
      "justification": "Accurately captures the positive condition ('Yes' equivalent) and the shipping action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After shipping the article, check its availability again."
      ],
      "justification": "Directly models the post-shipment re-evaluation step."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->n9",
        "action:n9",
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is still not available, initiate the procurement process. Otherwise, proceed to ship the article."
      ],
      "justification": "Models the second decision point. The condition is explicitly stated as an action/question before the branch, which is a permissible re-typing that preserves behaviour. Guards correctly route 'No' to procurement and 'Yes' to shipping."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the article is shipped, the next step is to complete the financial settlement."
      ],
      "justification": "Direct paraphrase of the settlement step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After the financial settlement is done, the process ends with the receipt of payment."
      ],
      "justification": "Captures the final payment step and correctly positions the process termination node."
    }
  ],
