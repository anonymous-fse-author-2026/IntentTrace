{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "Implicitly triggers the process start and describes the first concrete step; modeling 'start' and 'receive claim' as separate actions restates the opening unit without altering behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Direct paraphrase of the claim creation and recording step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "Models the decision-making step and introduces the subsequent XOR gateway for routing."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "Accurately captures the rejection condition and the corresponding rejection action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8",
        "action:n8_off"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "Models the acceptance condition as a guard and splits the outcome into explicit 'accept' and 'offer benefit' actions; re-typing a condition as an action preserves behaviour and is a match."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Direct match for the review step executed on the rejection path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Direct match for preparing the discharge in the acceptance path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Direct match for the payment recording step."
    },
    {
      "refs": [
        "converge:n7"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process.",
        "But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Both conditional paths lead to continuation regardless of outcome; collapsing trivial branching logic into a single convergence node preserves the intended flow."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicitly models the termination step and the process end marker."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "Correctly captures the parallel execution cue via an AND split, models the two concurrent steps, and includes a join node for flow reconstruction."
    }
  ],
