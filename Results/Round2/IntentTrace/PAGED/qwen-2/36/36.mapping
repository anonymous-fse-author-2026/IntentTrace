      "verbatim_texts": [
        "Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Process initiation and first check step. i1 is a title/announcer and omitted as noise per guidelines."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\"",
        "Otherwise,"
      ],
      "justification": "Decision point splitting the flow based on applicant response."
