{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "Initiates the process and models the initial registration step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "Models the decision condition and splits the flow based on exception requirement."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "True-path guard directing flow to handle the exception request."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "On the other hand, if an exception is not needed, the process can continue."
      ],
      "justification": "False-path guard bypassing exception handling."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "Executes the exception request on the positive branch."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After the exception is approved"
      ],
      "justification": "Waits for/receives exception approval before proceeding."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "On the other hand, if an exception is not needed, the process can continue."
      ],
      "justification": "Continues directly on the negative branch and begins rejoining the main flow."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "the process can continue."
      ],
      "justification": "Marks the convergence point where both exception paths reunite."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "the next step is course enrollment, followed by seminar group enrollment."
      ],
      "justification": "Sequentially performs course and seminar group enrollment."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the seminar group enrollment is completed, the homework assignment can be started."
      ],
      "justification": "Starts the homework assignment task."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After working on the homework, it should be turned in."
      ],
      "justification": "Submits the completed homework."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated"
      ],
      "justification": "Evaluates the submitted homework."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Checks whether more homework remains and branches accordingly."
    },
    {
      "refs": [
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Routes back to assign another homework when condition is false."
    },
    {
      "refs": [
        "guard:b3->b5"
      ],
      "verbatim_texts": [
        "if it was the last homework",
        "if it was the last homework, the process can continue."
      ],
      "justification": "Routes forward to the next phase when condition is true."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Assigns the next iteration of homework in the loop."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "Splits into parallel tasks via AND gateway, executes both, and merges flows."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After signing up for the exam, it should be attended."
      ],
      "justification": "Sequentially handles exam registration and attendance."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once the exam is attended, it will be evaluated."
      ],
      "justification": "Evaluates the exam results."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue. However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Checks pass/fail outcome and splits the final decision flow."
    },
    {
      "refs": [
        "guard:b4->n22"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue. However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "True-path guard for successfully passing the exam."
    },
    {
      "refs": [
        "guard:b4->n23"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue. However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "False-path guard for failing the exam."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue. However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Handles course completion state or loops back for re-registration; process terminates upon successful completion."
    }
  ],
