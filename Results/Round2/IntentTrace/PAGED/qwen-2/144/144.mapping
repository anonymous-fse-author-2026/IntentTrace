{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with Password Verification,"
      ],
      "justification": "The init node and first action correspond directly to the opening instruction."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by Verifiy Password."
      ],
      "justification": "Direct paraphrase of the second verification step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If you choose \"Select Cancel\""
      ],
      "justification": "The XOR branch and its first guarded path correctly capture the Cancel selection and the resulting navigation."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "you will be directed to iforgot.apple.com."
      ],
      "justification": "The XOR branch and its first guarded path correctly capture the Cancel selection and the resulting navigation."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if you select \"Reset password\", you will be automatically directed to iforgot.apple.com."
      ],
      "justification": "Second guarded path accurately reflects the Reset password selection and automatic redirection."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "In case you choose \"Retry\", you will need to re-enter your password."
      ],
      "justification": "Third guarded path correctly captures the Retry condition and the required re-entry action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "do so and then verify it."
      ],
      "justification": "Matches the instruction to verify the password immediately after re-entry."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed with Reset Password."
      ],
      "justification": "The convergence node merges the three alternative flows into the shared Reset Password step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the password is reset, you can return to the iTunes purchases page."
      ],
      "justification": "Directly matches the post-reset navigation instruction."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "From there, select the price of the item."
      ],
      "justification": "Directly matches the price selection step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If prompted to \"Enter Password\", verify the password.",
        "Alternatively, if asked to \"Enter Apple ID\", enter the password."
      ],
      "justification": "Action n11 serves as harmless structural plumbing to evaluate the prompt type, feeding into XOR branch b2. Together they cover the two prompt scenarios."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If prompted to \"Enter Password\", verify the password."
      ],
      "justification": "First branch of the prompt decision correctly pairs the Enter Password condition with the verification action."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Alternatively, if asked to \"Enter Apple ID\", enter the password."
      ],
      "justification": "Second branch correctly pairs the Enter Apple ID condition with the password entry action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, enter the password and verify it."
      ],
      "justification": "Final combined step faithfully restates the closing instruction."
    }
