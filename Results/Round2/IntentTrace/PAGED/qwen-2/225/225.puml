@startuml
!theme plain
|a_default| Default
|a_default|
start
:start acme process;
:receive customer request;
:check inventory level;
:v1: check inventory level ({Below Minimum, Above Minimum}); <<objectSignal>>
if () then ([v1 = 'Below Minimum'])
:accept request and create PO;
:review purchase order;
:v2: review purchase order ({Rejected, Approved}); <<objectSignal>>
if () then ([v2 = 'Rejected'])
:rework purchase order;
:review reworked purchase order;
else ([v2 = 'Approved'])
:approve purchase order and reserve funds;
:send purchase order;
split
:receive packing slip;
:record packing slip;
split again
:receive invoice;
:record invoice;
end split
:release reserved funds and issue payment;
:end process;
stop
endif
else ([v1 = 'Above Minimum'])
:reject request - end process;
stop
endif
@enduml