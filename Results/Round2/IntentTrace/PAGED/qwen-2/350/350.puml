!theme plain
|a_default| Default
|a_default|
start
:provide userdata for flickr;
:v1: login_status ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:login successful;
stop
else ([v1 = 'No'])
:login fails;
:v2: retry_choice ({Try Again, Abort}); <<objectSignal>>
if () then ([v2 = 'Try Again'])
:try again;
else ([v2 = 'Abort'])
:abort;
stop
endif
endif
