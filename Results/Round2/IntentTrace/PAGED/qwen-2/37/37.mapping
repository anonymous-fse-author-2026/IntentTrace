{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Start node and initial action directly correspond to the opening instruction."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "then proceed to Check the Customer's Credit Limit."
      ],
      "justification": "Direct paraphrase of the credit limit check step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "Condition and subsequent step captured via XOR gateway, guard, and action. Modeling the condition as an action step preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Negative branch guard and denial action correctly capture the alternative outcome."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "After checking the availability, if the response is \"Okay\", proceed to Check the Availability of the Article again."
      ],
      "justification": "Second availability check loop correctly modeled with branching logic."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Alternative denial path for the second availability check."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Decision on article availability and production step correctly aligned."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Alternative collection path correctly aligned. Use of Yes/No in guards is a compatible paraphrase of available/not available."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Convergence of produce/collect flows leading to the confirmation step."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "Parallel (AND) branching and convergence correctly capture the simultaneous shipping and invoicing."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Direct match for payment status verification."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n17",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "close the Order and end the process."
      ],
      "justification": "Payment received path, order closure, and process termination correctly modeled."
    },
    {
      "refs": [
        "guard:b4->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Reminder count evaluation step correctly captured as an action modelled condition."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Write-off step corresponding to the high reminder count threshold."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Direct match for sending a reminder. Relative ordering with write-off does not change overall behaviour."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Final closure and termination steps following the write-off correctly aligned."
    }
  ],
