{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "Initial unit triggers process start and describes the first two actions. 'start' is a valid paraphrase of 'start by placing an order'."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Captures the negative eligibility branch, guard condition, and resulting action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Captures the positive eligibility guard and the corresponding action."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Structural end node aligns with the explicit termination instruction after informing the ineligible customer."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "Open a new order in the ERP system and perform an availability check."
      ],
      "justification": "Redundant restatement of opening the order followed by the availability check step."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\". If it is not, start producing the missing parts."
      ],
      "justification": "Branch evaluates availability, guard and action handle the unavailability case, and convergence rejoins flow."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n8"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process. Prepare the products for shipment."
      ],
      "justification": "Guard handles the 'otherwise' (available) path to convergence, followed by the preparation action."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "AND gateway models simultaneous execution of shipping, invoicing, and payment check, followed by convergence."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Condition modeled as action precedes branch; guard and action capture the received payment path."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Guard and action capture the unpaid path. End node reflects the process-flow termination noted in the source repetition."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->b6"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Condition modeled as action precedes branch; guard captures the '< 3' threshold for continuing."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Guard captures the '= 3' threshold, action covers informing the lawyer, and end node marks process termination."
    }
  ],
