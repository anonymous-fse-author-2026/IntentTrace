      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "The start node and first two actions correctly capture the initiation trigger and the metadata entry instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to the IN-Patient step"
      ],
      "justification": "Directly models the transition to the IN-Patient step as instructed."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "complete the following steps: send data to suppliers and create a claim"
      ],
      "justification": "Splits the composite instruction into two distinct action steps, preserving both required behaviours."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "extract the data from the suppliers and transfer it to the doctor's phone"
      ],
      "justification": "Accurately captures the extraction and transfer operation in a single step."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "confirm the GOP and the process will come to an end"
      ],
      "justification": "Models the confirmation step followed by a terminal decision/end state, faithfully reflecting the source's termination condition."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Next, register the case and handle the claim"
      ],
      "justification": "Directly corresponds to the case registration and claim handling steps."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status"
      ],
      "justification": "Captures the secondary extraction, the XOR choice between recording or confirming status, and the subsequent flow convergence."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "confirm the IN-Patient status"
      ],
      "justification": "Handles the alternative branch outcome specified in the prior unit, preserving the decision logic."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "send the data back to the suppliers"
      ],
      "justification": "Direct match for the data return step."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, receive the payment and conclude the process"
      ],
      "justification": "Correctly models the final payment receipt and the concluding end node."
    }
