{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "The init node and action faithfully capture the starting step described in i1."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "create a process model"
      ],
      "justification": "Direct correspondence to i2."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\""
      ],
      "justification": "Condition modeled as an action step and XOR branch preserves the decision point in i3."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "\"NOT OK\", then assign negative points."
      ],
      "justification": "Guard represents the negative condition and action matches i4."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Positive branch guard and subsequent continuation actions (including harmless redundancy) preserve the flow in i7."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\""
      ],
      "justification": "Re-check condition modeled as action and branch matches i5."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "\"NOT OK\", assign negative points again."
      ],
      "justification": "Second negative condition and penalty action match i6."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Implicit positive outcome from the second check routes to continuation, preserving i7's alternative path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Action correctly paraphrases the issue-handling step in i8."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points",
        "If you need to analyze the field of study"
      ],
      "justification": "Combined conditional action and split branch cover the two alternatives described in i9 and i11."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "First alternative path matches i10."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Second alternative path matches i12."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the process is okay"
      ],
      "justification": "Condition re-typed as action matches i13."
    },
    {
      "refs": [
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Split actions preserve the combined continuation and role-based work described in i14."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct match to i15."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the project is accepted"
      ],
      "justification": "Condition modeled as action and XOR branch matches i16."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it."
      ],
      "justification": "Positive acceptance path matches i17."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Negative path matches i18."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Re-evaluation condition and branch match i19."
    },
    {
      "refs": [
        "guard:b6->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Second positive presentation matches i19."
    },
    {
      "refs": [
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Second negative loop matches i18."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Final presentation, process termination, and added structural convergence nodes (plumbing) collectively preserve the ending behaviour in i20."
    }
  ],
