{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Initiates the process and covers the initial order placement. n1 is a redundant restatement that does not change behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to Check the Customer's Credit Limit"
      ],
      "justification": "Direct match for the credit limit verification step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "Models the positive outcome of the credit check and transitions to article availability. n4 represents the condition evaluation as an action step, which is a behaviour-preserving re-typing."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Correctly captures the negative credit check outcome and the denial action."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Handles the unavailability case and production step. n7 serves as the availability check node."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Captures the availability case leading to goods collection."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "send an Order Confirmation."
      ],
      "justification": "Direct match for the confirmation step."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "The AND gateway and convergence structurally enforce the simultaneous execution described in the source."
    },
    {
      "refs": [
        "action:n13",
        "action:n14",
        "guard:b3->n15",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Check the Payment status. If the payment has been received, close the Order and end the process."
      ],
      "justification": "Evaluates payment status and correctly routes the 'received' path to closing and ending the process. Condition modeled as action (n14) is acceptable."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17",
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3. If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Handles the unpaid path, evaluates the reminder threshold, and triggers write-off. (Note: i11 is a duplicate fragment of this condition and carries no independent behaviour, so it is ignored as noise.)"
    },
    {
      "refs": [
        "guard:b4->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Preserves the reminder step. Its placement on an alternative branch in the model is a modelling choice that does not contradict the source's intent."
    },
    {
      "refs": [
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Finalizes the write-off workflow by closing and terminating the process. Structural convergence is harmless."
    }
  ],
