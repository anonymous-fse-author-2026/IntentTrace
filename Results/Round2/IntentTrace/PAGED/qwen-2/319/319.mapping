      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For buyers, the process begins by choosing a book."
      ],
      "justification": "Implicitly marks the process start and captures the initial action of choosing a book."
    },
    {
      "refs": [
        "guard:b2->n4",
        "guard:b2->n8",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "they can either view the book details or see a list of new copies. Alternatively, they can also view a list of used copies."
      ],
      "justification": "Models the initial XOR split and its three outgoing branches. Abstract guard values preserve the described branching logic without altering behaviour."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "view the book details"
      ],
      "justification": "Directly matches the first branch option."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "see a list of new copies"
      ],
      "justification": "Matches the second branch option; slight rewording ('view:') does not change behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "view a list of used copies"
      ],
      "justification": "Matches the third branch option."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "select a copy"
      ],
      "justification": "Covers the secondary decision point after viewing details and the action of selecting a copy."
    },
    {
      "refs": [
        "guard:b1->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "view a list of new copies"
      ],
      "justification": "Matches the alternative path where the user views new copies instead of selecting immediately."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "and end the process."
      ],
      "justification": "Captures the termination step for the main selection path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "evaluate the list and then select their preferred copy"
      ],
      "justification": "Merges evaluation and selection into a single step, preserving the required behaviour for the used copies path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "to complete the process."
      ],
      "justification": "Action and structural end nodes that finalize the used copies path. Multiple end nodes are acceptable as long as process termination behaviour is preserved."
    }
  ],
