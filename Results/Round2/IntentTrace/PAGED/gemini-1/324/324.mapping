{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "Initiates the process and captures the first request action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, proceed with the Registration gross pathology request."
      ],
      "justification": "Direct match for proceeding with the registration."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the registration is complete, assign a container to the gross pathology request."
      ],
      "justification": "Direct match for assigning a container."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During the \"Registration gross pathology request\" step, make sure to create a barcode scan at the start."
      ],
      "justification": "Direct match for the barcode scan step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After assigning a container, move on to the Specimen description."
      ],
      "justification": "Direct match for moving to specimen description."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "For the \"Specimen description\" step, pay attention to the scan start."
      ],
      "justification": "Direct match for scan start."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Then, pay attention to the scan end."
      ],
      "justification": "Direct match for scan end."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Finally, pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Direct match for the next scan start action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Following that, proceed with Macroscopic description writing."
      ],
      "justification": "Direct match for macroscopic description writing."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Tissue processing, check if \"Digitalization?\" is required."
      ],
      "justification": "Captures the parallel execution branch and both concurrent actions."
    },
    {
      "refs": [
        "action:n12",
        "guard:b1->n12"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process."
      ],
      "justification": "Captures the negative branch condition and the resulting action."
    },
    {
      "refs": [
        "action:n13",
        "guard:b1->n13"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Captures the positive branch condition and the resulting action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Next, check if \"Digitalization?\" is required again."
      ],
      "justification": "Direct match for the condition check and opens the XOR branch."
    },
    {
      "refs": [
        "action:n15",
        "guard:b2->n15"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process."
      ],
      "justification": "Captures the negative branch condition and the resulting action."
    },
    {
      "refs": [
        "action:n16",
        "guard:b2->n16"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Captures the positive branch condition and the resulting action."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "After that, assign cases to the pathologist and then move on to Microscopic examination and diagnosis."
      ],
      "justification": "Implicitly joins previously split flows and models the sequential case assignment and diagnosis."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the microscopic examination and diagnosis are complete, write the pathology report."
      ],
      "justification": "Direct match for writing the report."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "After writing the report, confirm it."
      ],
      "justification": "Direct match for confirmation."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the pathology report is confirmed, deliver it."
      ],
      "justification": "Direct match for report delivery."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Then, proceed with the post-report processing."
      ],
      "justification": "Direct match for processing step."
    },
    {
      "refs": [
        "action:n23",
        "action:n26"
      ],
      "verbatim_texts": [
        "To conclude the pathology procedure, close it."
      ],
      "justification": "Captures the process closure and process end."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Finally, deliver the pathology report and complete the post-report processing."
      ],
      "justification": "Direct match for the concluding redundant step."
    }
  ],
