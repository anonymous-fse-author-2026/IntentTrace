      "justification": "Correctly captures the negative branch condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "refuse to fulfill the order and end the process."
      ],
      "justification": "Captures both the action of refusing the order and the structural process end."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check if the item is in stock."
      ],
      "justification": "Direct match for the stock checking action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Captures the conclusion of the process, redundantly modeled as both an action and an end event."
    }
