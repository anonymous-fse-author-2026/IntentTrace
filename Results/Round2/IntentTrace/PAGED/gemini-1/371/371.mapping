{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\""
      ],
      "justification": "Captures the initialization of the process and the first explicit step."
    },
    {
      "refs": [
        "action:i2",
        "guard:b_expense->i2"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000"
      ],
      "justification": "Captures the decision branch and positive condition for the expense threshold."
    },
    {
      "refs": [
        "action:i3"
      ],
      "verbatim_texts": [
        "the report should be reviewed"
      ],
      "justification": "Captures the explicit review action."
    },
    {
      "refs": [
        "action:i4",
        "guard:b_expense->i4"
      ],
      "verbatim_texts": [
        "if the expense is less than or equal to 1000"
      ],
      "justification": "Captures the alternative expense condition."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "proceed to check if there is a need for translation"
      ],
      "justification": "Captures the first translation check action and its associated decision split."
    },
    {
      "refs": [
        "action:i6_1",
        "guard:b_trans1->i6_1"
      ],
      "verbatim_texts": [
        "If translation is required"
      ],
      "justification": "Captures the positive translation condition."
    },
    {
      "refs": [
        "action:i7_1"
      ],
      "verbatim_texts": [
        "translate the receipts"
      ],
      "justification": "Captures the translation step."
    },
    {
      "refs": [
        "action:i8_1",
        "guard:b_trans1->i8_1"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Captures the negative translation condition."
    },
    {
      "refs": [
        "action:i9_1"
      ],
      "verbatim_texts": [
        "confirm the receipts"
      ],
      "justification": "Captures the receipt confirmation action."
    },
    {
      "refs": [
        "action:i10"
      ],
      "verbatim_texts": [
        "evaluate the review decision"
      ],
      "justification": "Captures the review evaluation step and its corresponding branching point."
    },
    {
      "refs": [
        "action:i11",
        "guard:b_review->i11"
      ],
      "verbatim_texts": [
        "If the report is rejected"
      ],
      "justification": "Captures the condition for rejection."
    },
    {
      "refs": [
        "action:i12"
      ],
      "verbatim_texts": [
        "edit the report"
      ],
      "justification": "Captures the edit report action and the associated flow convergence."
    },
    {
      "refs": [
        "action:i13",
        "guard:b_review->i13"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Captures the condition for approval."
    },
    {
      "refs": [
        "action:i14"
      ],
      "verbatim_texts": [
        "continue to check if there is a need for translation"
      ],
      "justification": "Captures the second explicit check for translation and the branch it implies."
    },
    {
      "refs": [
        "action:i6_2",
        "guard:b_trans2->i6_2"
      ],
      "verbatim_texts": [
        "If translation is required"
      ],
      "justification": "Redundantly models the second branch's positive condition."
    },
    {
      "refs": [
        "action:i7_2"
      ],
      "verbatim_texts": [
        "translate the receipts"
      ],
      "justification": "Redundantly maps the second path's translation step to the source logic."
    },
    {
      "refs": [
        "action:i8_2",
        "guard:b_trans2->i8_2"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Redundantly models the second branch's negative condition."
    },
    {
      "refs": [
        "action:i9_2"
      ],
      "verbatim_texts": [
        "confirm the receipts"
      ],
      "justification": "Redundantly maps the second path's confirmation step."
    },
    {
      "refs": [
        "action:i15"
      ],
      "verbatim_texts": [
        "confirm them"
      ],
      "justification": "Captures the final confirmation step."
    },
    {
      "refs": [
        "action:i16"
      ],
      "verbatim_texts": [
        "evaluate the receipts decision"
      ],
      "justification": "Captures the receipt evaluation action and its corresponding decision branch."
    },
    {
      "refs": [
        "action:i17",
        "guard:b_receipts->i17"
      ],
      "verbatim_texts": [
        "If the receipts are accepted"
      ],
      "justification": "Captures the positive receipt acceptance condition."
    },
    {
      "refs": [
        "action:i18"
      ],
      "verbatim_texts": [
        "process the expense"
      ],
      "justification": "Captures the expense processing step."
    },
    {
      "refs": [
        "action:i19",
        "guard:b_receipts->i19"
      ],
      "verbatim_texts": [
        "If they are rejected"
      ],
      "justification": "Captures the negative receipt rejection condition."
    },
    {
      "refs": [
        "action:i20"
      ],
      "verbatim_texts": [
        "The process ends"
      ],
      "justification": "Properly captures the conclusion of the process."
    },
    {
      "refs": [
        "action:i21"
      ],
      "verbatim_texts": [
        "ending it"
      ],
      "justification": "Captures the explicit ending action."
    }
