      ],
      "verbatim_texts": [
        "In the beginning, the process starts with"
      ],
      "justification": "Starts the process and models the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Bill for Purchased Goods/Services"
      ],
      "justification": "Direct match for the billing step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Receive Invoice"
      ],
      "justification": "Direct match for receiving the invoice."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete,"
      ],
      "justification": "Opens the XOR split and captures the negative completeness check."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "it is returned."
      ],
      "justification": "Captures the return action and implicitly ends this branch of the process."
    },
    {
      "refs": [
        "guard:b1->b2"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Captures the positive completeness check."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant,"
      ],
      "justification": "Opens the compliance decision and captures the non-compliant check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "further checks are conducted."
      ],
      "justification": "Direct match for conducting further checks."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Captures the positive compliance check and converges the flow to continue."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call,"
      ],
      "justification": "Opens the resolution decision and captures the phone call check."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "non-compliance is resolved."
      ],
      "justification": "Direct match for resolving non-compliance."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back,"
      ],
      "justification": "Captures the alternative check for mail back."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the invoice is returned."
      ],
      "justification": "Direct match for returning the invoice."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the invoice is paid"
      ],
      "justification": "Direct match for the payment step."
    },
    {
      "refs": [
        "branch:b7"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed:"
      ],
      "justification": "Captures the parallel AND split."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Bill Client."
      ],
      "justification": "Direct match for billing the client."
    },
    {
      "refs": [
        "guard:b6->n20"
      ],
      "verbatim_texts": [
        "If there is no response,"
      ],
      "justification": "Opens the client response decision and captures the no response check."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "a period of 10 days is given."
      ],
      "justification": "Direct match for waiting 10 days."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "the client is notified of the payment."
      ],
      "justification": "Direct match for notifying the client."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "a reminder is sent"
      ],
      "justification": "Direct match for sending a reminder."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Explicit action stating the process ends."
    },
    {
      "refs": [
        "guard:b6->n24"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied,"
      ],
      "justification": "Captures the unsatisfied check."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "payment discrepancy is resolved."
      ],
      "justification": "Direct match for resolving the discrepancy."
    },
    {
      "refs": [
        "guard:b6->e4"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied,"
      ],
      "justification": "Captures the satisfied check and subsequently ends the flow as the process continues off the edge."
    }
