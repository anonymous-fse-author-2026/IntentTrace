@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:initiate new resupply cycle;
:check levels of inventory;
:v1: inventory_level ({above minimum, below or equal to minimum}); <<objectSignal>>
if () then ([v1 = "above minimum"])
:generate above minimum report;
:end process;
stop
else ([v1 = "below or equal to minimum"])
:generate equal to or below minimum report;
repeat :;
:create purchase orders (pos);
:review po;
:v2: po_status ({approved, rejected}); <<objectSignal>>
backward:rework po;
repeat while () is ([v2 = "rejected"]) not ([v2 = "approved"])
:approve, print and release po in the system;
split
:reserve funds for the released pos;
split again
:mail the pos to the supplier;
:receive the inventory;
end split
:receive the packing slip;
:receive the invoice;
:three-way match;
:release the funds;
:issue the payment;
:resupply cycle is complete;
stop
endif
@enduml