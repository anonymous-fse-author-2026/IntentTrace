@startuml
!theme plain
|a_default| Default
|a_default|
start
:start reviewing incoming CV;
:decide whether to send a negative email or invite candidate;
:v1: decide whether to send a negative email or invite candidate ({negative email, invite}); <<objectSignal>>
if () then ([v1 = "negative email"])
:send negative email and end process;
stop
else ([v1 = "invite"])
:schedule interview with candidate;
:conduct interview;
:the process comes to an end;
stop
endif
@enduml