  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, Rental Items are Returned to the Store."
    },
    {
      "id": "i2",
      "content": "If the \"Customer returns the items to the store,\""
    },
    {
      "id": "i3",
      "content": "then we can continue the process."
    },
    {
      "id": "i4",
      "content": "However, if the \"Delivery Crew picks-up items at the event site,\""
    },
    {
      "id": "i5",
      "content": "then we also continue the process."
    },
    {
      "id": "i7",
      "content": "During this step, the items are counted and compared to the original contract."
    },
    {
      "id": "i8",
      "content": "If the \"Order is complete and all items were returned,\""
    },
    {
      "id": "i10",
      "content": "then we proceed with the process."
    },
    {
      "id": "i11",
      "content": "However, if the \"Order is incomplete and items are missing,\""
    },
    {
      "id": "i13",
      "content": "we still continue the process."
    },
    {
      "id": "i14",
      "content": "Similarly, if the \"Order is complete but items are damaged,\""
    },
    {
      "id": "i16",
      "content": "we email the customer to inform them of the damage and additional charges."
    },
    {
      "id": "i17",
      "content": "After this, if the \"Items are packed for an existing order,\""
    },
    {
      "id": "i19",
      "content": "we continue the process."
    },
    {
      "id": "i20",
      "content": "Alternatively, if the \"Items are stored for future orders,\""
    },
    {
      "id": "i22",
      "content": "In case of missing items and replacement charges,"
    },
    {
      "id": "i23",
      "content": "we email the customer to inform them."
    },
    {
      "id": "i24",
      "content": "Additionally, if there are damaged items and additional charges,"
    },
    {
      "id": "i25",
      "content": "we temporarily take them out of inventory."
    },
    {
      "id": "i26",
      "content": "If the \"Customer returns the missing items,\""
    },
    {
      "id": "i27",
      "content": "However, if the \"Customer does not return the missing items,\" we still continue the process."
    },
    {
      "id": "i28",
      "content": "If the \"Items are repaired and added into inventory,\""
    },
    {
      "id": "i30",
      "content": "On the other hand, if the \"Items can't be repaired and are discarded,\""
    },
    {
      "id": "i32",
      "content": "we email the customer with replacement charges."
    },
    {
      "id": "i33",
      "content": "If the \"Items are packed for an existing order,\""
    },
    {
      "id": "i34",
      "content": "If the \"Items are stored for future orders,\""
    },
    {
      "id": "i35",
      "content": "The customer is then emailed with replacement charges"
    },
    {
      "id": "i36",
      "content": "and the process is complete."
    }
  ]
