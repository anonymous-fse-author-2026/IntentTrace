      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order"
      ],
      "justification": "Initiates the process and captures the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check the customer"
      ],
      "justification": "Direct action mapping."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\""
      ],
      "justification": "Models the XOR decision for customer eligibility."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "inform them"
      ],
      "justification": "Direct action mapping."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Maps to an end point of the process, represented redundantly as both an action and an end node (which is a match)."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "open a new order in the ERP system"
      ],
      "justification": "Direct action mapping."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "perform an availability check"
      ],
      "justification": "Direct action mapping."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\""
      ],
      "justification": "Models the XOR decision for product availability."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "start producing the missing parts"
      ],
      "justification": "Captures the production step and the structural convergence of the process paths."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment"
      ],
      "justification": "Direct action mapping."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "ship the products"
      ],
      "justification": "Models the start of the parallel (AND) split and the shipping action along with its path ending."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "send the invoice"
      ],
      "justification": "Captures the parallel invoicing step and its path ending."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "checking for payment"
      ],
      "justification": "Captures the synchronization of flows and the check payment step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the payment is received"
      ],
      "justification": "Models the XOR decision checking payment outcome."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "close the order"
      ],
      "justification": "Direct action mapping."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "send a reminder"
      ],
      "justification": "Direct action mapping."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "ending the process"
      ],
      "justification": "Models the conclusion of the process successfully."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3"
      ],
      "justification": "Models the XOR decision for checking reminder limits."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "inform the lawyer and end the process"
      ],
      "justification": "Captures the final action and the termination of this branch."
