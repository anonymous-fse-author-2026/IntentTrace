  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To check the account, we start by verifying the amount."
      ],
      "justification": "Captures the process start and the initial verification action."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the amount"
      ],
      "justification": "Opens the XOR decision based on the amount."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "is less than 200 \u20ac"
      ],
      "justification": "Captures the threshold condition for the positive approval branch."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "approve the expense report"
      ],
      "justification": "Captures the approval step and the implicit completion of this path."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "is 200 \u20ac or more"
      ],
      "justification": "Captures the threshold condition for the evaluation branch."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "evaluate the expense report"
      ],
      "justification": "Captures the manual evaluation step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the expense report"
      ],
      "justification": "Opens the second decision split based on the evaluation result."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "is deemed acceptable"
      ],
      "justification": "Captures the condition for the acceptable expense report."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "is approved"
      ],
      "justification": "Captures the subsequent approval and the end of the process on this branch."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "is not satisfactory"
      ],
      "justification": "Captures the condition for the unsatisfactory expense report."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the process also ends."
      ],
      "justification": "Models the process termination. Modeling a termination as an explicit action ('End process') alongside an end event is harmless redundancy and re-typing that preserves behaviour."
    }
  ],
