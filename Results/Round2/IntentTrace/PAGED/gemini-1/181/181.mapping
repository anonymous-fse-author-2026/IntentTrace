      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "Initializes the process and models the first action of sending the form."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Models the action of receiving approval."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
