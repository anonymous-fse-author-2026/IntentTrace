      ],
      "justification": "Models contact with TS."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "it is checked"
      ],
      "justification": "Models the checking step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized."
      ],
      "justification": "Opens the XOR branch and captures the internal resource condition and corresponding authorization step."
    },
    {
      "refs": [
        "action:n8",
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Captures the external resource condition and corresponding authorization step."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized.",
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Structurally converges the internal and external authorization paths."
    },
    {
      "refs": [
        "action:n14",
        "guard:b2->n14"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Opens the variations decision branch, modeling the negative branch condition and action."
    },
    {
      "refs": [
        "action:n15",
        "guard:b2->n15"
      ],
      "verbatim_texts": [
        "if there are variations, a business case is completed."
      ],
      "justification": "Models the positive branch condition and corresponding action for variations."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "if there are variations, a business case is completed and attached."
      ],
      "justification": "Captures the redundant phrasing of the variations business case step exactly as it appears in the text."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues.",
        "if there are variations, a business case is completed."
      ],
      "justification": "Structurally converges the paths following the variations checks."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the mandatory documentation along with the approval is sent to HR services"
      ],
      "justification": "Directly captures sending mandatory documentation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Directly captures scanning and recording."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Captures the redundant action of sending approval and docs to HR."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "HR services receive the documentations"
      ],
      "justification": "Captures the reception step."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "this marks the end of the process."
      ],
      "justification": "Explicitly models the conclusion of the process and introduces the structural end node."
