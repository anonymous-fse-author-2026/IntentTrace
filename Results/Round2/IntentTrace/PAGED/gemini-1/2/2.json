  "input_elements": [
    {
      "id": "i1",
      "content": "For TS recruitment, the first step is"
    },
    {
      "id": "i2",
      "content": "advise unsuccessful candidates"
    },
    {
      "id": "i3",
      "content": "If there are \"no more candidates\""
    },
    {
      "id": "i4",
      "content": "then the position should be re-advertised"
    },
    {
      "id": "i5",
      "content": "if the terms and conditions of the offer for a candidate need to be sorted out, it is necessary to check if the candidate has accepted a voluntary redundancy"
    },
    {
      "id": "i6",
      "content": "if the candidate has accepted"
    },
    {
      "id": "i7",
      "content": "If the candidate has not accepted"
    },
    {
      "id": "i8",
      "content": "If the candidate has not accepted, the process continues."
    },
    {
      "id": "i9",
      "content": "if the candidate has accepted, further investigation is required"
    },
    {
      "id": "i10",
      "content": "The recruitment manager sends an Appointment Approval form"
    },
    {
      "id": "i11",
      "content": "received by the next level manager"
    },
    {
      "id": "i12",
      "content": "If the manager is an external resource"
    },
    {
      "id": "i13",
      "content": "If the manager is an external resource, they may not authorize the form"
    },
    {
      "id": "i14",
      "content": "if the approver is an existing employee"
    },
    {
      "id": "i15",
      "content": "if the approver is an existing employee of the client, the process continues."
    },
    {
      "id": "i16",
      "content": "If the form is approved"
    },
    {
      "id": "i17",
      "content": "sends the form and other documentation"
    },
    {
      "id": "i18",
      "content": "received by the client HR"
    },
    {
      "id": "i19",
      "content": "The HR department scans the completed form and records the position against the stored position in GovSource."
    },
    {
      "id": "i20",
      "content": "If there are any variations"
    },
    {
      "id": "i21",
      "content": "a complete business case is required"
    },
    {
      "id": "i22",
      "content": "Otherwise, the process continues."
    },
    {
      "id": "i23",
      "content": "The Appointment Approval is carried forward."
    },
    {
      "id": "i24",
      "content": "If the position requires a medical assessment"
    },
    {
      "id": "i25",
      "content": "it is applicable for a 12% rate"
    },
    {
      "id": "i26",
      "content": "Otherwise, a medical assessment is not necessary"
    },
    {
      "id": "i27",
      "content": "it can take up to 21 days to arrange and complete."
    },
    {
      "id": "i28",
      "content": "The TS HR coordinator informs the recruitment manager"
    },
    {
      "id": "i29",
      "content": "liaises with the HR representative to confirm the offer to the candidate"
    },
    {
      "id": "i30",
      "content": "If the assessment is not satisfactory"
    },
    {
      "id": "i31",
      "content": "the next candidate on the shortlist should be contacted"
    },
    {
      "id": "i32",
      "content": "if the assessment is fine"
    },
    {
      "id": "i33",
      "content": "if the assessment is fine, the process continues."
    },
    {
      "id": "i34",
      "content": "makes a formal verbal offer of employment to the candidate"
    },
    {
      "id": "i35",
      "content": "If the candidate accepts"
    },
    {
      "id": "i36",
      "content": "If the candidate accepts, the recruitment manager creates a formal written offer"
    },
    {
      "id": "i37",
      "content": "If the candidate declines"
    },
    {
      "id": "i38",
      "content": "Simultaneously"
    },
    {
      "id": "i39",
      "content": "the commencement pack and letter of appointment are sent to the candidate"
    },
    {
      "id": "i40",
      "content": "Once the candidate receives these documents"
    },
    {
      "id": "i41",
      "content": "if there is a \"40%\" rate"
    },
    {
      "id": "i42",
      "content": "renegotiation is required"
    },
    {
      "id": "i43",
      "content": "Otherwise, if the candidate accepts, the process continues."
    },
    {
      "id": "i44",
      "content": "If the renegotiation is successful"
    },
    {
      "id": "i45",
      "content": "If the renegotiation is successful, the process continues."
    },
    {
      "id": "i46",
      "content": "if the renegotiation is unsuccessful"
    },
    {
      "id": "i47",
      "content": "if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified"
    }
  ]
}