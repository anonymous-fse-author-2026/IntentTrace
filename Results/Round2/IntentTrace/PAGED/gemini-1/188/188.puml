!theme plain
|a_default| Default
|a_default|
start
:start;
:Loan Application;
:Receive Loan Application;
:check the Banking Privilege Status;
:v1: Banking Privilege Status ({Construct Error Response, Retrieve Customer Information}); <<objectSignal>>
if () then ([v1 = 'Retrieve Customer Information'])
:Retrieve Customer Information;
:check the fulfillment of loan conditions;
:v2: fulfillment of loan conditions ({Construct Error Response, Calculate threshold amount}); <<objectSignal>>
if () then ([v2 = 'Calculate threshold amount'])
:Calculate threshold amount;
:Check Creditworthiness;
:Designate Status;
:Initialize Loan Form;
:v4: Response ({Construct Approve Response, Construct Reject Response}); <<objectSignal>>
if () then ([v4 = 'Construct Approve Response'])
:Construct Approve Response;
:the process ends;
:Approved Message;
stop
else ([v4 = 'Construct Reject Response'])
:Construct Reject Response;
:the process ends;
:Reject Message;
stop
endif
else ([v2 = 'Construct Error Response'])
:Construct Error Response;
:the process ends;
:Error Message;
stop
endif
else ([v1 = 'Construct Error Response'])
:Construct Error Response;
:the process ends;
:Error Message;
stop
endif
