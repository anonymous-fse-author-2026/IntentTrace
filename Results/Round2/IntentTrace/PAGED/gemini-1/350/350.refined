init(i1)
action(n1, "start the flickr login process")
action(n2, "provide userdata for flickr")
converge(c1)
branch(b1, XOR)
converge(c2)
action(n4, "end process successful login")
end(e1)
action(n5, "do you want to try again")
branch(b2, XOR)
action(n6, "provide userdata for flickr again after first failure")
branch(b3, XOR)
action(n7, "abort process after first failure")
end(e2)
branch(b4, XOR)
action(n11, "provide userdata for flickr again after second failure")
action(n12, "if you decide to abort")
end(e4)
defines(v1, "login status", {"Successful", "Fails"})
defines(v2, "try again", {"Yes", "No"})
defines(v4, "try again after second failure", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, c1, b1, c2, n4, e1, n5, b2, n6, b3, n7, e2, b4, n11, n12, e4])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, c1)
precedence(n11, c1)
precedence(c1, b1)
precedence(b1, c2)
precedence(b1, n5)
precedence(b3, c2)
precedence(b3, b4)
precedence(c2, n4)
precedence(n4, e1)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n7)
precedence(n7, e2)
precedence(n6, b3)
precedence(b4, n11)
precedence(b4, n12)
precedence(n12, e4)
guard(b1, c2, v1 = 'Successful')
guard(b1, n5, v1 = 'Fails')
guard(b2, n6, v2 = 'Yes')
guard(b2, n7, v2 = 'No')
guard(b3, c2, v1 = 'Successful')
guard(b3, b4, v1 = 'Fails')
guard(b4, n11, v4 = 'Yes')
guard(b4, n12, v4 = 'No')