      ],
      "verbatim_texts": [
        "To start, please provide the userdata for flickr."
      ],
      "justification": "Initializes the process and models the first step of providing user data."
    },
    {
      "refs": [
        "guard:b1->c2",
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "If the login is successful,"
      ],
      "justification": "Captures the decision branches and guards for a successful login, handling both the initial attempt and retries."
    },
    {
      "refs": [
        "guard:b1->n5",
        "guard:b3->b4"
      ],
      "verbatim_texts": [
        "if the login fails,"
      ],
      "justification": "Captures the guards for a failed login on the initial and retry attempts."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the process will end."
      ],
      "justification": "Models the end of the process upon a successful login."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If you want to try again,"
      ],
      "justification": "Captures the condition and branching for retrying the first time."
    },
    {
      "refs": [
        "action:n6",
        "action:n11"
      ],
      "verbatim_texts": [
        "please provide the userdata for flickr."
      ],
      "justification": "Models the action of providing user data during retries, and the structural convergence of these paths."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "if you choose to abort,"
      ],
      "justification": "Models the branch and end state when aborting after the first failure."
    },
    {
      "refs": [
        "guard:b4->n11"
      ],
      "verbatim_texts": [
        "If you still want to try again,"
      ],
      "justification": "Models the retry branch after a second failure."
    },
    {
      "refs": [
        "guard:b4->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "if you decide to abort,"
      ],
      "justification": "Models the abort branch, action, and end state after subsequent failures. Modelling a condition as an action is acceptable."
    }
  ],
