      ],
      "justification": "Captures the positive condition."
    },
    {
      "refs": [
        "action:i15"
      ],
      "verbatim_texts": [
        "then we enter the invoice in SAP"
      ],
      "justification": "Matches the action of entering the invoice."
    },
    {
      "refs": [
        "guard:b2->i6",
        "action:i6"
      ],
      "verbatim_texts": [
        "However, if the answer is \"Yes\""
      ],
      "justification": "Captures another positive condition path."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "then we give it priority"
      ],
      "justification": "Matches the priority action."
    },
    {
      "refs": [
        "guard:b2->i16",
        "action:i16"
      ],
      "verbatim_texts": [
        "And if the answer is \"Yes\" again"
      ],
      "justification": "Captures the repeated positive condition."
    },
    {
      "refs": [
        "action:i17"
      ],
      "verbatim_texts": [
        "we place the entered invoices in the normal Outbox"
      ],
      "justification": "Matches the final document placement step."
    },
    {
      "refs": [
        "action:i13"
      ],
      "verbatim_texts": [
        "and the process ends"
      ],
      "justification": "Matches the process termination step."
