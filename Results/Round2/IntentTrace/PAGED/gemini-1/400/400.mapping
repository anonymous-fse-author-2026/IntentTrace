        "guard:b1->i2",
        "action:i2"
      ],
      "verbatim_texts": [
        "if the answer is \"No\""
      ],
      "justification": "Captures the first branch, its negative condition, and represents the condition as an action step (which is acceptable re-typing)."
    },
    {
      "refs": [
        "guard:b1->i4",
        "action:i4"
      ],
      "verbatim_texts": [
        "If the answer is \"No\" again"
      ],
      "justification": "Captures the repeated negative condition."
    },
    {
      "refs": [
        "action:i3"
      ],
      "verbatim_texts": [
        "we continue the process"
      ],
      "justification": "Matches the continuation step."
    },
    {
      "refs": [
        "guard:b1->i7",
        "action:i7"
      ],
      "verbatim_texts": [
        "However, if the answer is \"Yes\", then we give it priority."
      ],
      "justification": "Captures the positive branch condition and its immediate action."
    },
    {
      "refs": [
        "action:i11"
      ],
      "verbatim_texts": [
        "we look up the Vendor on SAP"
      ],
      "justification": "Matches the vendor lookup step."
    },
    {
      "refs": [
        "guard:b2->i5",
        "action:i5"
      ],
      "verbatim_texts": [
        "If the answer is \"No\""
      ],
      "justification": "Captures the second decision branch and the negative condition."
    },
    {
      "refs": [
        "action:i12"
      ],
      "verbatim_texts": [
        "we need a Vendor master record"
      ],
      "justification": "Matches the action required when vendor is not found."
    },
    {
      "refs": [
        "guard:b2->i14",
        "action:i14"
      ],
      "verbatim_texts": [
