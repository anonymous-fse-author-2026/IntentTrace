@startuml
!theme plain
|a_default| Default
|a_default|
start
:v1: Answer 1 ({No, No again, Yes}); <<objectSignal>>
switch ()
case ([v1 = 'No'])
:if the answer is "No;
:we continue the process;
case ([v1 = 'No again'])
:If the answer is "No" again;
case ([v1 = 'Yes'])
:However, if the answer is "Yes", then we give it priority.;
endswitch
:we look up the Vendor on SAP;
:v2: Answer 2 ({No, Yes, Yes again}); <<objectSignal>>
fork
if () then ([v2 = 'No'])
:If the answer is "No;
:we need a Vendor master record;
endif
fork again
if () then ([v2 = 'Yes'])
:But if the answer is "Yes;
:then we enter the invoice in SAP;
:we place the entered invoices in the normal Outbox;
endif
fork again
if () then ([v2 = 'Yes again'])
:And if the answer is "Yes" again;
endif
fork again
if () then ([v2 = 'Yes'])
:However, if the answer is "Yes;
:then we give it priority;
endif
end fork
:and the process ends;
stop
