{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "the first step is to look at the order"
      ],
      "justification": "Starts the process and captures the initial action of looking at the order."
    },
    {
      "refs": [
        "guard:b1->i3"
      ],
      "verbatim_texts": [
        "If the order is to be rejected"
      ],
      "justification": "Opens an XOR branch and correctly assigns the 'Rejected' condition to one of the paths."
    },
    {
      "refs": [
        "action:i3"
      ],
      "verbatim_texts": [
        "the process should continue"
      ],
      "justification": "Models the outcome of the rejection path."
    },
    {
      "refs": [
        "guard:b1->i5"
      ],
      "verbatim_texts": [
        "If the order is to be accepted"
      ],
      "justification": "Captures the 'Accepted' condition on the XOR branch."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "the process should also continue"
      ],
      "justification": "Models the outcome of the accepted path."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "At the same time, two steps need to be completed:"
      ],
      "justification": "Captures the parallel (AND) split. Modeling the phrase itself as an action is harmless redundancy."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "preparing the assembling order"
      ],
      "justification": "First parallel step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "checking availability"
      ],
      "justification": "Second parallel step."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If there is a backorder"
      ],
      "justification": "Opens a decision branch for the availability check and routes the positive backorder case."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "availability needs to be checked again"
      ],
      "justification": "Action corresponding to the backorder path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Terminates the backorder path. The redundant action node preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "If the item can be reserved"
      ],
      "justification": "Captures the negative backorder case (item reserved) and converges to proceed."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "assemble the bike"
      ],
      "justification": "Subsequent step after the availability check."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "ship the product"
      ],
      "justification": "Final step and the overall end of the process."
    }
  ],
