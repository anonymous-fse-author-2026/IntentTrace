!theme plain
|a_default| Default
|a_default|
start
:start with Password Verification;
:followed by Verifiy Password.;
:v1: condition  Select Cancel / Reset password / Retry ({Select Cancel, Reset password, Retry}); <<objectSignal>>
switch ()
case ([v1 = 'Select Cancel'])
:If you choose "Select Cancel;
:directed to iforgot.apple.com;
:proceed with Reset Password;
case ([v1 = 'Reset password'])
:if you select "Reset password;
:automatically directed to iforgot.apple.com;
case ([v1 = 'Retry'])
:In case you choose "Retry;
:re-enter your password;
:and then verify it;
endswitch
:return to the iTunes purchases page;
:select the price of the item;
:v2: condition  Enter Password / Enter Apple ID ({Enter Password, Enter Apple ID}); <<objectSignal>>
if () then ([v2 = 'Enter Password'])
:If prompted to "Enter Password;
:verify the password;
else ([v2 = 'Enter Apple ID'])
:if asked to "Enter Apple ID;
:enter the password;
endif
:Finally, enter the password and verify it.;
