@startuml
!theme plain
|a_default| Default
|a_default|
start
:Resupply Cycle Triggered;
:Check Inventory Level;
:v1: Inventory Level ({at or below the minimum, above the minimum}); <<objectSignal>>
if () then ([v1 = 'at or below the minimum'])
:Create Purchase Order;
:Reviewing Purchase Order;
:v2: Purchase Order ({approved, rejected}); <<objectSignal>>
if () then ([v2 = 'approved'])
:Reserve Funds for Purchase;
:Send Order to Suppliers;
split
:Supplier sends packing slip;
:Record packing slip;
split again
:Supplier sends invoice;
:Record invoice;
end split
:Release reserved funds;
:Issue payment to supplier;
:End Process;
stop
else ([v2 = 'rejected'])
:Rework Order;
:review the Purchase Order again;
endif
else ([v1 = 'above the minimum'])
:End Process;
stop
endif
@enduml