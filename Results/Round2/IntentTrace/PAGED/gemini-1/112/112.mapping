      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "Starts the process and models the initial course registration step."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If an exception is needed"
      ],
      "justification": "Models the decision check for whether an exception is needed, and the positive branch."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "a Request for the exception should be made."
      ],
      "justification": "Action corresponding to requesting an exception."
    },
    {
      "refs": [
        "guard:b1->n25"
      ],
      "verbatim_texts": [
        "if an exception is not needed, the process can continue."
      ],
      "justification": "Negative branch where exception is not needed, so the process simply continues."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "the process can continue."
      ],
      "justification": "Negative branch where exception is not needed, so the process simply continues."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After the exception is approved"
      ],
      "justification": "Action reflecting the approval condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the next step is course enrollment"
      ],
      "justification": "Proceeds to course enrollment."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "followed by seminar group enrollment."
      ],
      "justification": "Enrollment in seminar group."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the homework assignment can be started."
      ],
      "justification": "Homework assignment starts, serving as the implicit loop join point for retakes."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "it should be turned in."
      ],
      "justification": "Turning in the homework."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated"
      ],
      "justification": "Homework evaluation step."
    },
    {
      "refs": [
        "action:n12",
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "If it was not the last homework"
      ],
      "justification": "Models the condition checking for the last homework and its negative loop branch."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "another homework assignment will be given."
      ],
      "justification": "Looping action to give another homework."
    },
    {
      "refs": [
        "action:n14",
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "Positive branch out of the homework loop, mapping to the parallel steps completion."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "granting accreditation"
      ],
      "justification": "Accreditation step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "announcing the date of the exam."
      ],
      "justification": "Exam date announcement step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "After signing up for the exam"
      ],
      "justification": "Signing up for the exam, along with the convergence point for exam retakes."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "it should be attended."
      ],
      "justification": "Attending the exam."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "it will be evaluated."
      ],
      "justification": "Exam evaluation step."
    },
    {
