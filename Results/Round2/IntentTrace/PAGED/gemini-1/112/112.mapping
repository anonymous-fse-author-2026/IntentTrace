        "action:n21",
        "guard:b4->n22"
      ],
      "verbatim_texts": [
        "If the exam is passed"
      ],
      "justification": "Decision step checking the exam outcome and branching positively."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "the course is considered passed"
      ],
      "justification": "Successful course completion and end point."
    },
    {
      "refs": [
        "action:n23",
        "guard:b4->n23"
      ],
      "verbatim_texts": [
