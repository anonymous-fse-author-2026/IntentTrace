@startuml
!theme plain
|a_default| Default
|a_default|
start
:Orders Required;
:place Bulk order;
:v1: credit allowance ({Order with prior internal credit allowance, order exceeds the purchaser's credit allowance}); <<objectSignal>>
if () then ([v1 = "Order with prior internal credit allowance"])
:process order for delivery;
else ([v1 = "order exceeds the purchaser's credit allowance"])
:Outstanding Balance;
:place new order;
split
:record in Accounts Receivable;
:v2: payment status ({Payments are Received, no payments are received}); <<objectSignal>>
if () then ([v2 = "no payments are received"])
:drop order;
:Order dropped;
stop
else ([v2 = "Payments are Received"])
:identify order for installation;
:v3: installation requirement ({installation needs to be scheduled, order does not require installation}); <<objectSignal>>
if () then ([v3 = "installation needs to be scheduled"])
:assign Installer;
:Installer assigned;
stop
else ([v3 = "order does not require installation"])
:pack for delivery;
:Packed for delivery;
stop
endif
endif
split again
:End at Warehouse;
stop
end split
endif
@enduml