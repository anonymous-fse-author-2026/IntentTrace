@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start ONS Bootstrapping process;
:Is input a URN?;
:v1: Is input a URN? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Resolve URN to domain-name;
:After this, we again check if the input is a "URN" or a "URL;
:Send DNS query for the domain-name;
:Get list of URLs from DNS query;
:Link to designated DS;
:Finally, we link to the designated DS;
:End of process;
stop
else ([v1 = 'No'])
:After this, we again check if the input is a "URN" or a "URL;
:Use to link to a designated DS;
:Link to designated DS;
:End of process;
stop
endif
@enduml