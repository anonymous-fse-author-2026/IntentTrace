init(i1)
action(n1, "Start")
branch(i2, XOR)
action(n3, "Work on storyboard (full day)")
branch(i5, XOR)
end(e_story)
action(n4, "End Process")
end(e1)
branch(b4, AND)
action(n5, "Site design (10 days)")
action(n6, "Content preparation")
converge(c1)
action(n8, "Site development (2 days)")
action(n9, "Review process (1 day)")
action(n10, "Is the review successful?")
branch(b2, XOR)
end(e_rev)
action(n11, "Approval stage (half a day)")
branch(i15, XOR)
action(n12, "End Process")
end(e2)
action(n13, "Rebuild site (3 days)")
branch(i17, XOR)
action(n15, "End Process")
end(e3)
action(n16, "Rebuild site again (3 days)")
end(e4)

defines(v1, "Is the informational meeting successful?", {"Yes", "No"})
defines(v_story, "Is the storyboard successful?", {"Yes", "No"})
defines(v2, "Is the review successful?", {"Yes", "No"})
defines(v_app, "Is the approval complete?", {"Yes", "No"})
defines(v3, "Is the rebuild approved?", {"Yes", "No"})

actor(a_default, "Default", [i1, n1, i2, n3, i5, e_story, n4, e1, b4, n5, n6, c1, n8, n9, n10, b2, e_rev, n11, i15, n12, e2, n13, i17, n15, e3, n16, e4])

precedence(i1, n1)
precedence(n1, i2)
precedence(i2, n3)
precedence(i2, n4)
guard(i2, n3, v1 = "Yes")
guard(i2, n4, v1 = "No")
precedence(n4, e1)

precedence(n3, i5)
precedence(i5, b4)
precedence(i5, e_story)
guard(i5, b4, v_story = "Yes")
guard(i5, e_story, v_story = "No")

precedence(b4, n5)
precedence(b4, n6)
precedence(n5, c1)
precedence(n6, c1)
precedence(c1, n8)
precedence(n8, n9)
precedence(n9, n10)
precedence(n10, b2)

precedence(b2, n11)
precedence(b2, e_rev)
guard(b2, n11, v2 = "Yes")
guard(b2, e_rev, v2 = "No")

precedence(n11, i15)
precedence(i15, n12)
precedence(i15, n13)
guard(i15, n12, v_app = "Yes")
guard(i15, n13, v_app = "No")
precedence(n12, e2)

precedence(n13, i17)
precedence(i17, n15)
precedence(i17, n16)
guard(i17, n15, v3 = "Yes")
guard(i17, n16, v3 = "No")
precedence(n15, e3)

precedence(n16, e4)