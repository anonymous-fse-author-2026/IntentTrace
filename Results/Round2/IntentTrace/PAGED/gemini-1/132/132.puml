@startuml
!theme plain
|a_default| Default
|a_default|
start
:customer makes an enquiry;
:is the article in stock;
:v1: is the article in stock ({yes, no}); <<objectSignal>>
if () then ([v1 = "yes"])
:continue with the process;
split
:reserve the article;
split again
:calculate the price;
end split
:send the offer;
:wait for the customer to accept the offer;
:has the customer accepted the offer;
:dispatch the article;
:end process;
stop
else ([v1 = "no"])
:abort the enquiry and end process;
stop
endif
