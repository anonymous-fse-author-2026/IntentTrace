@startuml
!theme plain
|a_default| Default
|a_default|
start
:Receive Ministerial enquiry;
:Assign enquiry to a minister;
:Investigate enquiry;
:Prepare ministerial response;
:Review ministerial response;
:v1: Is response approved? ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:Address ministerial correspondence;
:v2: End path? ({Path 1, Path 2}); <<objectSignal>>
if () then ([v2 = 'Path 1'])
:End process;
stop
else ([v2 = 'Path 2'])
:Process ends;
stop
endif
else ([v1 = 'Yes'])
:Continue process;
stop
endif
