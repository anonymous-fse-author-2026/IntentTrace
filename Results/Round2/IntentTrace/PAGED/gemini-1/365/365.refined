init(i1)
action(n1, "start")
action(n2, "Passengers undergo immigration checks")
action(n3, "Select method for exit control checks: Biometrics or ID documents?")
branch(b1, XOR)
action(n4, "Undergo biometric check")
action(n5, "Check using identity documents")
branch(b2, XOR)
action(n7, "If the passenger is denied permission, they should leave the area and end process")
end(e1)
action(n8, "Proceed to next step")
branch(b4, XOR)
action(a12_bio, "If the exit control check outcome is unsuccessful")
action(a13_bio, "the passenger should leave the area and the process ends")
end(e5)
action(a15_bio, "if the outcome is successful")
action(a16_bio, "the passenger should continue to the next step")
action(n9, "End of successful process")
end(e2)
branch(b5, XOR)
action(a8_id, "After the exit control checks, if the passenger is denied permission")
action(a9_id, "they should leave the area")
end(e6)
action(a10_id, "if the passenger is allowed to continue")
action(a11_id, "they should proceed to the next step")
branch(b3, XOR)
action(n11, "If the exit control check outcome is unsuccessful, the passenger should leave the area and end process")
end(e3)
action(n12, "Proceed to next step")
action(n13, "End of successful process")
end(e4)
defines(v1, "Select method for exit control checks: Biometrics or ID documents?", {"Biometrics", "ID documents"})
defines(v2, "Is permission denied after biometric check?", {"Yes", "No"})
defines(v3, "Is permission denied after ID document check?", {"Yes", "No"})
defines(v4, "Biometric check outcome", {"Unsuccessful", "Successful"})
defines(v5, "ID permission status", {"Denied", "Allowed"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, b2, n7, e1, n8, b4, a12_bio, a13_bio, e5, a15_bio, a16_bio, n9, e2, b5, a8_id, a9_id, e6, a10_id, a11_id, b3, n11, e3, n12, n13, e4])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, b2)
precedence(b2, n7)
precedence(n7, e1)
precedence(b2, n8)
precedence(n8, b4)
precedence(b4, a12_bio)
precedence(a12_bio, a13_bio)
precedence(a13_bio, e5)
precedence(b4, a15_bio)
precedence(a15_bio, a16_bio)
precedence(a16_bio, n9)
precedence(n9, e2)
precedence(n5, b5)
precedence(b5, a8_id)
precedence(a8_id, a9_id)
