precedence(b3, n11)
precedence(n11, e3)
precedence(b3, n12)
precedence(n12, n13)
precedence(n13, e4)
guard(b1, n4, v1 = 'Biometrics')
guard(b1, n5, v1 = 'ID documents')
guard(b2, n7, v2 = 'Yes')
guard(b2, n8, v2 = 'No')
guard(b4, a12_bio, v4 = 'Unsuccessful')
guard(b4, a15_bio, v4 = 'Successful')
guard(b5, a8_id, v5 = 'Denied')
guard(b5, a10_id, v5 = 'Allowed')
guard(b3, n11, v3 = 'Yes')
guard(b3, n12, v3 = 'No')