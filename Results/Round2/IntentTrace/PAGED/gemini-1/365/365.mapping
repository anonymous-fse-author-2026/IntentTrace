      "justification": "Matches the start of the process and the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "undergoing immigration checks"
      ],
      "justification": "Captures the immigration check action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "select the method for exit control checks"
      ],
      "justification": "Captures the selection action and sets up the corresponding branch for method choice."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics"
      ],
      "justification": "Condition for the biometric route."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "undergo a check using biometrics"
      ],
      "justification": "Action step for biometric check."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the passenger prefers to use ID documents"
      ],
      "justification": "Condition for the ID document route."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "undergo checks using identity documents"
      ],
      "justification": "Action step for the ID checks."
    },
    {
      "refs": [
        "guard:b2->n7",
        "guard:b5->a8_id",
        "action:a8_id"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission"
      ],
      "justification": "The model redundantly applies this condition to multiple pathways, which is behaviourally consistent with the text describing it generally."
    },
    {
      "refs": [
        "action:n7",
        "action:a9_id"
      ],
      "verbatim_texts": [
        "they should leave the area"
      ],
      "justification": "Matches the actions instructing the passenger to leave, and terminates the corresponding process paths."
    },
    {
      "refs": [
        "guard:b2->n8",
        "guard:b5->a10_id",
        "action:a10_id"
      ],
      "verbatim_texts": [
        "if the passenger is allowed to continue"
      ],
      "justification": "Condition for passengers who are allowed to proceed."
    },
    {
      "refs": [
        "action:n8",
        "action:a11_id"
      ],
      "verbatim_texts": [
        "they should proceed to the next step"
      ],
      "justification": "Action corresponding to being allowed to proceed."
    },
    {
      "refs": [
        "guard:b4->a12_bio",
        "action:a12_bio",
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful"
      ],
      "justification": "The text restates outcomes using different terminology, and the model handles this by generating redundant conditional checks, matching the text perfectly."
    },
    {
      "refs": [
        "action:a13_bio",
        "action:n11"
      ],
      "verbatim_texts": [
        "the passenger should leave the area and the process ends"
      ],
      "justification": "Captures the unsuccessful outcome action and correctly terminates the paths."
    },
    {
      "refs": [
        "action:n9",
        "action:n13"
      ],
      "verbatim_texts": [
        "and the process ends"
      ],
      "justification": "Matches the end of the successful pathways as explicitly specified in the text."
    },
    {
      "refs": [
        "guard:b4->a15_bio",
        "action:a15_bio"
      ],
      "verbatim_texts": [
        "if the outcome is successful"
      ],
      "justification": "Matches the explicit successful outcome condition."
    },
    {
      "refs": [
        "action:a16_bio",
        "action:n12",
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "the passenger should continue to the next step"
      ],
      "justification": "Matches the action associated with a successful outcome (including the negative guard to an unsuccessful check equating to success)."
    }
