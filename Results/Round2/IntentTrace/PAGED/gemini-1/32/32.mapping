      "justification": "Starts the process. The redundant 'start' action preserves the meaning of the process beginning."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "entering expenses",
        "goes back to entering expenses"
      ],
      "justification": "Captures the entering expenses step and the structural convergence node where the process loops back to this step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "generate a spreadsheet"
      ],
      "justification": "Direct match for generating the spreadsheet."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the request can be approved or disapproved"
      ],
      "justification": "Models the first decision point. Framing the condition as an action step (Approval Check 1) before the branch is a behaviour-preserving match."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If the request is not approved"
      ],
      "justification": "Negative arm of the first approval decision, leading back to the start."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the request is approved"
      ],
      "justification": "Positive arm of the first approval decision."
    },
    {
      "refs": [
        "action:n5",
        "action:n7"
      ],
      "verbatim_texts": [
        "the expenses can be paid out"
      ],
      "justification": "Matches the payout steps. The text mentions payouts occurring after both the first and second approval checks; both payout actions in the model map to this described behaviour."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "checks again if the request is approved or not"
      ],
      "justification": "Models the second decision point, again framing the check as an action leading into an XOR branch."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is not approved"
      ],
      "justification": "Negative arm of the second approval decision, correctly looping back."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "if it is approved"
      ],
      "justification": "Positive arm of the second approval decision."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "the process comes to an end"
      ],
      "justification": "Direct match for the termination of the process."
    }
