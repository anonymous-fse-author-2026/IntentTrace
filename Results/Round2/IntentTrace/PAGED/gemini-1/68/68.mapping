{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "Captures the initialization and start step of the process."
    },
    {
      "refs": [
        "action:n2_1",
        "guard:b1->n2_1"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\""
      ],
      "justification": "Captures the XOR branch opening and the positive condition for returning to store."
    },
    {
      "refs": [
        "action:n2_2",
        "guard:b1->n2_2"
      ],
      "verbatim_texts": [
        "if the \"Delivery Crew picks-up items at the event site,\""
      ],
      "justification": "Captures the alternate delivery crew pickup condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the items are counted and compared to the original contract"
      ],
      "justification": "Captures the step of counting and comparing items, as well as the implied convergence and subsequent split."
    },
    {
      "refs": [
        "guard:b2->b3"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\""
      ],
      "justification": "Captures the complete order condition and the nested branch."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "if the \"Order is incomplete and items are missing,\""
      ],
      "justification": "Captures the condition for missing items."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "if the \"Order is complete but items are damaged,\""
      ],
      "justification": "Captures the condition for damaged items."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Captures the action of emailing the customer about damage."
    },
    {
      "refs": [
        "action:n17",
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "if the \"Items are packed for an existing order,\""
      ],
      "justification": "Captures the packed for existing order condition and action."
    },
    {
      "refs": [
        "action:n18",
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "if the \"Items are stored for future orders,\""
      ],
      "justification": "Captures the stored for future orders condition and action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Captures emailing the customer for missing items."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "we temporarily take them out of inventory"
      ],
      "justification": "Captures the removal from inventory and the branch for repair."
    },
    {
      "refs": [
        "action:n7_1",
        "guard:b4->n7_1"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "Captures the XOR branch opening and the condition for returning missing items."
    },
    {
      "refs": [
        "action:n7_2",
        "guard:b4->n7_2"
      ],
      "verbatim_texts": [
        "if the \"Customer does not return the missing items,\""
      ],
      "justification": "Captures the negative condition for returning missing items."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Captures the completion of the first branch of the process."
    },
    {
      "refs": [
        "action:n12",
        "guard:b5->n12"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\""
      ],
      "justification": "Captures the repaired items condition, the repair action, and the subsequent split."
    },
    {
      "refs": [
        "action:n13",
        "guard:b5->n13"
      ],
      "verbatim_texts": [
        "if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Captures the discard condition and corresponding email action."
    },
    {
      "refs": [
        "action:n20",
        "guard:b6->n20"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\""
      ],
      "justification": "Captures the packed for existing order condition in the repair branch."
    },
    {
      "refs": [
        "action:n21",
        "guard:b6->n21"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\""
      ],
      "justification": "Captures the stored for future orders condition in the repair branch."
    },
    {
      "refs": [
        "action:n16",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Captures the convergence, end actions, and process termination."
    },
    {
      "refs": [
        "action:n31",
        "action:n31b"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges"
      ],
      "justification": "Captures the final redundant customer email actions on multiple paths."
    }
  ],
