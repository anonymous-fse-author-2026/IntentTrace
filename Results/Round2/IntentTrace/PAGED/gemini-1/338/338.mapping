{
  "matches": [
    {
      "refs": [
        "action:i1",
        "guard:b_start->i2"
      ],
      "verbatim_texts": [
        "Initially, if the option \"research schedule directly\" is selected"
      ],
      "justification": "Implicitly starts the process, captures the initial condition, sets up the decision split, and provides the positive guard."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "the action to be taken is \"Research schedule\""
      ],
      "justification": "Directly implements the scheduled research action."
    },
    {
      "refs": [
        "action:i3",
        "guard:b_start->i3"
      ],
      "verbatim_texts": [
        "If the option is not selected"
      ],
      "justification": "Captures the negative branch condition and its guard."
    },
    {
      "refs": [
        "action:i4"
      ],
      "verbatim_texts": [
        "then \"provide indications\""
      ],
      "justification": "Models the action to provide indications and the structural convergence that leads to it."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "proceed with the research schedule"
      ],
      "justification": "Direct paraphrase matching the action."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "After validating the schedule"
      ],
      "justification": "Models the validation step and handles structural convergence."
    },
    {
      "refs": [
        "action:i7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory"
      ],
      "justification": "Models the check and introduces the split for different satisfaction states."
    },
    {
      "refs": [
        "action:i8",
        "guard:b_i7->c_i8"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Captures the negative condition, its incoming routing, and a subsequent branch the model cleverly reuses to handle multiple 'not satisfactory' outcomes described in the text."
    },
    {
      "refs": [
        "action:i9",
        "guard:b_i7->c_i9"
      ],
      "verbatim_texts": [
        "If it is"
      ],
      "justification": "Captures the positive condition, incoming routing, and a branch reused to channel positive outcomes to their correct subsequent steps."
    },
    {
      "refs": [
        "action:i10",
        "guard:b_i8->i10"
      ],
      "verbatim_texts": [
        "perform the action \"Research schedule\""
      ],
      "justification": "Models the research action and the guard routing to it."
    },
    {
      "refs": [
        "action:i11",
        "guard:b_i9->i11"
      ],
      "verbatim_texts": [
        "proceed with writing a ticket order to SNCF"
      ],
      "justification": "Models the ticket order creation and its preceding guard."
    },
    {
      "refs": [
        "action:i12",
        "guard:b_i7->i12"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory"
      ],
      "justification": "Models the secondary negative condition and its guard."
    },
    {
      "refs": [
        "action:i13",
        "guard:b_i7->i13"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory"
      ],
      "justification": "Models the alternative positive condition and its guard."
    },
    {
      "refs": [
        "action:i14"
      ],
      "verbatim_texts": [
        "write a ticket order to SNCF"
      ],
      "justification": "Direct match for the writing action."
    },
    {
      "refs": [
        "action:i15"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it"
      ],
      "justification": "Models the validation step and structural convergence."
    },
    {
      "refs": [
        "action:i16",
        "guard:b_i16->c_i8"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved"
      ],
      "justification": "Models the first approval check and its split. It cleverly routes the negative case into an existing negative block to perfectly preserve the 'process ends' behaviour missing from the segmented units."
    },
    {
      "refs": [
        "action:i17",
        "guard:b_i8->c_i17",
        "guard:b_i9->c_i17"
      ],
      "verbatim_texts": [
        "then the process ends"
      ],
      "justification": "Models the process termination and captures the routing paths from reused blocks that correctly lead to the process end."
    },
    {
      "refs": [
        "action:i18",
        "guard:b_i16->c_i18",
        "guard:b_i20->c_i18"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Captures the positive approval conditions and correctly maps paths from multiple checks into it."
    },
    {
      "refs": [
        "action:i19"
      ],
      "verbatim_texts": [
        "validate the ticket order"
      ],
      "justification": "Matches the validation step and logically adds a structural split to route to the sequential checks."
    },
    {
      "refs": [
        "action:i20",
        "guard:b_i19->i20",
        "guard:b_i20->c_i8"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved"
      ],
      "justification": "Models the second check, its split, and successfully routes the negative outcome to the block handling end behaviour."
    },
    {
      "refs": [
        "action:i21",
        "guard:b_i19->i21",
        "guard:b_i21->c_i8",
        "guard:b_i21->c_i9"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved"
      ],
      "justification": "Models the final check, handles incoming path logic, and efficiently maps both remaining outcomes to termination branches as the text dictates."
    }
  ],
