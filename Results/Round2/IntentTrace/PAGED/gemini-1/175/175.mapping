{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Initiates the process according to the first step."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\""
      ],
      "justification": "Captures the start of a branching decision and its condition modeled as an action."
    },
    {
      "refs": [
        "action:i3"
      ],
      "verbatim_texts": [
        "if the \"Delivery Crew picks-up items at the event site,\""
      ],
      "justification": "Captures the alternative condition modeled as an action."
    },
    {
      "refs": [
        "action:i4"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Converges the initial paths and performs the counting action."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\""
      ],
      "justification": "Captures a branching condition modeled as an action."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "if the \"Order is incomplete and items are missing,\""
      ],
      "justification": "Captures a condition modeled as an action."
    },
    {
      "refs": [
        "action:i7"
      ],
      "verbatim_texts": [
        "Similarly, if the \"Order is complete but items are damaged,\""
      ],
      "justification": "Captures a condition modeled as an action."
    },
    {
      "refs": [
        "action:i8"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Captures the email action step."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "if the \"Items are packed for an existing order,\""
      ],
      "justification": "Captures a branch and its condition modeled as an action."
    },
    {
      "refs": [
        "action:i10"
      ],
      "verbatim_texts": [
        "if the \"Items are stored for future orders,\""
      ],
      "justification": "Captures a condition modeled as an action."
    },
    {
      "refs": [
        "action:i11"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Direct action step corresponding to the text."
    },
    {
      "refs": [
        "action:i12"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges,"
      ],
      "justification": "Condition modeled as an action."
    },
    {
      "refs": [
        "action:i13"
      ],
      "verbatim_texts": [
        "temporarily take them out of inventory."
      ],
      "justification": "Direct action step corresponding to the text."
    },
    {
      "refs": [
        "action:i14"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "Captures a branch and condition modeled as an action."
    },
    {
      "refs": [
        "action:i15"
      ],
      "verbatim_texts": [
        "if the \"Customer does not return the missing items,\""
      ],
      "justification": "Captures an alternative condition."
    },
    {
      "refs": [
        "action:i16"
      ],
      "verbatim_texts": [
        "when the process is complete, it ends."
      ],
      "justification": "Converges multiple paths and formally ends the process."
    },
    {
      "refs": [
        "action:i17"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\""
      ],
      "justification": "Captures a branch and condition modeled as an action."
    },
    {
      "refs": [
        "action:i18"
      ],
      "verbatim_texts": [
        "On the other hand, if the \"Items can't be repaired and are discarded,\""
      ],
      "justification": "Matches the conditional path, modeled as an action."
    },
    {
      "refs": [
        "action:i19"
      ],
      "verbatim_texts": [
        "we email the customer with replacement charges."
      ],
      "justification": "Direct action step corresponding to the text."
    },
    {
      "refs": [
        "action:i20"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order."
      ],
      "justification": "Converges the prior branch and performs the packing action."
    },
    {
      "refs": [
        "action:i21"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\""
      ],
      "justification": "Captures a branch and condition modeled as an action."
    },
    {
      "refs": [
        "action:i22"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\""
      ],
      "justification": "Captures an alternative condition modeled as an action."
    },
    {
      "refs": [
        "action:i23"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Converges the final branches and concludes the process."
    },
    {
      "refs": [
        "action:i24"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges"
      ],
      "justification": "Action step matched directly."
    },
    {
      "refs": [
        "action:i25"
      ],
      "verbatim_texts": [
        "and the process is complete."
      ],
      "justification": "Final step resulting in process termination."
    }
  ],
