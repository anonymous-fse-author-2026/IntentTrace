      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department"
      ],
      "justification": "Initializes the process and corresponds to the explicit initiation step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin with the Gross pathology request that has arrived"
      ],
      "justification": "Captures the arrival of the gross pathology request."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed with the Registration gross pathology request"
      ],
      "justification": "Direct match to the registration step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "create a barcode scan at the start"
      ],
      "justification": "Direct match to the barcode scan action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "assign a container to the gross pathology request"
      ],
      "justification": "Direct match to assigning a container."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "move on to the Specimen description"
      ],
      "justification": "Direct match to specimen description step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "pay attention to the scan start"
      ],
      "justification": "Direct match to the scan start."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "pay attention to the scan end"
      ],
      "justification": "Direct match to the scan end."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "pay attention to the scan start again for the Registration gross pathology request (cont.) step"
      ],
      "justification": "Direct match to the subsequent scan start step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "proceed with Macroscopic description writing"
      ],
      "justification": "Direct match to macroscopic description step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "AND gateway modeling the simultaneous steps."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Tissue processing"
      ],
      "justification": "Direct match to tissue processing step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required"
      ],
      "justification": "Models the check as an action and the XOR branch gateway."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process"
      ],
      "justification": "Captures the negative branch condition and the subsequent convergence."
    },
    {
      "refs": [
        "guard:b1->n13"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\""
      ],
      "justification": "Captures the positive branch condition."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "proceed with Digitalization"
      ],
      "justification": "Direct match to the digitalization step on the positive branch."
    },
    {
      "refs": [
        "action:n14",
        "guard:b2->n15",
        "action:n15",
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required again"
      ],
      "justification": "The source repeats the check and the model correctly expands this into a full decision branch mirroring the previous logic, preserving behavior."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
