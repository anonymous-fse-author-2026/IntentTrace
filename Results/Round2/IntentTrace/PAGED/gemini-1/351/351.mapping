{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For Talent Seek:"
      ],
      "justification": "Starts the process and models the announcer as the first initialization step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Direct match to the condition check step."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\""
      ],
      "justification": "Models the branch and positive condition correctly."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "discuss the terms and conditions with the candidate"
      ],
      "justification": "Direct match for the corresponding action."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "Otherwise"
      ],
      "justification": "Captures the negative path of the decision."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "continue with the process"
      ],
      "justification": "Direct match to the step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "check if the applicant wants to modify the terms and conditions"
      ],
      "justification": "Models the next check and uses a convergence gateway to bring prior branches together."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7",
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check"
      ],
      "justification": "Captures the branch, positive path, and action. It also introduces the implicit negative path (guard:b2->c2) safely as structural plumbing."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check if the change is within the set client limits"
      ],
      "justification": "Direct match to the condition check step."
    },
    {
      "refs": [
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Captures the branch and negative outcome."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "relay the applicant's changes"
      ],
      "justification": "Direct match for the corresponding action."
    },
    {
      "refs": [
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If it is within the limits"
      ],
      "justification": "Captures the positive conditional path."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "relay the applicant's changes and continue with the process"
      ],
      "justification": "These steps correctly represent the combined instructions given in the source text despite segmentation dropping a short redundant phrase."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process"
      ],
      "justification": "Direct match for the action and introduces structural convergence plumbing for the previous split."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly"
      ],
      "justification": "Direct match for the step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
