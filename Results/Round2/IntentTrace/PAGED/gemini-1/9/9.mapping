    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "further checks are conducted"
      ],
      "justification": "Action for further checks."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "if the invoice is compliant"
      ],
