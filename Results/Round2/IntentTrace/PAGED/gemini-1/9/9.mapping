  "mutations": [
    {
      "refs": [
        "guard:b14->n21"
      ],
      "verbatim_texts": [
        "if it is returned",
        "Bill Client"
      ],
      "reason": "The model incorrectly places 'Bill Client' and returning the invoice under an XOR branch, modeling them as mutually exclusive conditions instead of executing them in parallel as the raw source implies."
    }
  ],
