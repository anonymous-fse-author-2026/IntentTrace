      ],
      "justification": "Direct match for receiving invoice."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete"
      ],
      "justification": "Captures the decision check and branch for an incomplete invoice."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "it is returned"
      ],
      "justification": "Action to return the invoice."
    },
    {
      "refs": [
        "guard:b1->n_i6"
      ],
      "verbatim_texts": [
        "if the invoice is complete"
