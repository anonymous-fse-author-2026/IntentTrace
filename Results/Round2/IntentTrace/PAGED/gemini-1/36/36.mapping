    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "relay the applicant's changes."
      ],
      "justification": "Action corresponding to the negative limits branch."
    },
    {
      "refs": [
        "guard:b3->n7"
      ],
      "verbatim_texts": [
