{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially"
      ],
      "justification": "Starts the process and models the initial procedure step."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
      "justification": "Captures the decision check and opens the branches."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the action to be taken is \"Research schedule\""
      ],
      "justification": "Positive branch action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then \"provide indications\""
      ],
      "justification": "Negative branch action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed with the research schedule"
      ],
      "justification": "Subsequent step following the initial option evaluation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule"
      ],
      "justification": "Validation step and corresponding convergence point in the process flow."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory"
      ],
      "justification": "Models the condition as an action and opens the decision branch."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\""
      ],
      "justification": "First loop condition and action for an unsatisfactory schedule."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "proceed with writing a ticket order to SNCF"
      ],
      "justification": "Path and action for a satisfactory schedule."
    },
    {
      "refs": [
        "guard:b2->n8b",
        "action:n8b"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\""
      ],
      "justification": "Second loop check modeled accurately."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory"
      ],
      "justification": "Condition correctly extracted as a modeled step."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "write a ticket order to SNCF"
      ],
      "justification": "Final alternative branch mapping to writing the ticket order."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it"
      ],
      "justification": "Validation step and subsequent flow merge."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved"
      ],
      "justification": "Opens the ticket approval decision."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends"
      ],
      "justification": "Negative case ending the process."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order"
      ],
      "justification": "Positive case triggering a re-validation."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->n18",
        "action:n18",
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved"
      ],
      "justification": "Accurately models the second check, its subsequent branches, outcomes (end), and next steps as indicated by the raw text."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved"
      ],
      "justification": "Accurately models the third check."
    },
    {
      "refs": [
        "guard:b6->n21",
        "action:n21",
        "guard:b6->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If it is, then the process ends"
      ],
      "justification": "Captures the terminal paths of the final decision where both outcomes end the process."
    }
  ],
