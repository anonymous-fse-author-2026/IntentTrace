init(i1)
action(n1, "Start EC-Lille procedure")
action(n2, "Is 'research schedule directly' option selected")
branch(b1, XOR)
action(n3, "Research schedule")
action(n4, "Provide indications")
action(n5, "Proceed with research schedule")
action(n6, "Validate schedule")
action(n7, "Is schedule satisfactory")
branch(b2, XOR)
action(n8, "Research schedule")
action(n8b, "If the schedule is not satisfactory, perform the action 'Research schedule'")
action(n9, "Write ticket order to SNCF")
action(n11, "If it is still not satisfactory")
action(n12, "Proceed with writing ticket order to SNCF")
action(n13, "Validate ticket order")
action(n14, "Is ticket order approved")
branch(b4, XOR)
action(n15, "End process")
end(e1)
action(n16, "Validate ticket order again")
action(n17, "Is ticket order approved after second validation")
branch(b5, XOR)
action(n18, "End process")
end(e2)
action(n19, "Validate ticket order once more")
action(n20, "Is ticket order approved after third validation")
branch(b6, XOR)
action(n21, "End process")
end(e3)
action(n22, "End process")
end(e4)
end(e5)
converge(c1)
converge(c2)
defines(v1, "Is 'research schedule directly' option selected", {"Yes", "No"})
defines(v2, "Is schedule satisfactory", {"No", "No_alt", "Yes", "Yes_alt"})
defines(v3, "Is schedule still not satisfactory after researching again", {"Yes", "No"})
defines(v4, "Is ticket order approved", {"Yes", "No"})
defines(v5, "Is ticket order approved after second validation", {"Yes", "No"})
defines(v6, "Is ticket order approved after third validation", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, n6, n7, b2, n8, n8b, n9, n11, n12, n13, n14, b4, n15, e1, n16, n17, b5, n18, e2, n19, n20, b6, n21, e3, n22, e4, e5, c1, c2])
precedence(i1, n1)
precedence(n1, n2)
