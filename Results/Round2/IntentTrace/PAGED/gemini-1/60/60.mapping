{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process"
      ],
      "justification": "Initiates the process as described."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin by clicking on \"Start\""
      ],
      "justification": "First action step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "selecting \"Edit Report\""
      ],
      "justification": "Second action step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the expense is"
      ],
      "justification": "Evaluates the expense amount to determine routing."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "greater than 1000"
      ],
      "justification": "Decision branch condition for expense over 1000."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the report should be reviewed"
      ],
      "justification": "Action taken when expense is over 1000."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "is less than or equal to 1000"
      ],
      "justification": "Decision branch condition for expense up to 1000."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check if there is a need for translation"
      ],
      "justification": "Action and gateway evaluating translation requirement."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If translation is required"
      ],
      "justification": "Positive translation branch."
    },
    {
      "refs": [
        "action:n7",
        "action:n12"
      ],
      "verbatim_texts": [
        "translate the receipts"
      ],
      "justification": "Translation actions across both the initial track and the approved review track."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Negative translation branch."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "confirm the receipts"
      ],
      "justification": "Confirmation action when no initial translation is needed."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After this"
      ],
      "justification": "Structural convergence of the previous divergent paths."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "evaluate the review decision"
      ],
      "justification": "Step and gateway evaluating the outcome of the review."
    },
    {
      "refs": [
        "guard:b3->c_edit",
        "guard:b4->c_edit"
      ],
      "verbatim_texts": [
        "If the report is rejected"
      ],
      "justification": "Rejection conditions on review loops routing back to edit."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "edit the report"
      ],
      "justification": "Edit action that processes rejected reports."
    },
    {
      "refs": [
        "guard:b3->n18",
        "guard:b4->n12"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Approval conditions for review evaluations."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "continue to check if there is a need for translation."
      ],
      "justification": "Action following first review approval."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision"
      ],
      "justification": "Second evaluation cycle for review decisions."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "confirm them"
      ],
      "justification": "Confirmation action following the second approval and translation track."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "evaluate the receipts decision"
      ],
      "justification": "Final evaluation of the receipts."
    },
    {
      "refs": [
        "guard:b5->n15"
      ],
      "verbatim_texts": [
        "If the receipts are accepted"
      ],
      "justification": "Condition for accepted receipts."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "process the expense"
      ],
      "justification": "Action to process expenses."
    },
    {
      "refs": [
        "guard:b5->c_edit"
      ],
      "verbatim_texts": [
        "If they are rejected"
      ],
      "justification": "Condition for rejected receipts, routing back to edit."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "ending it"
      ],
      "justification": "Final termination of the process."
    }
  ],
