@startuml
!theme plain
|a_default| Default
|a_default|
start
:Resupply Cycle Triggered;
:Inventory level at or below the minimum?;
:v1: Inventory level at or below the minimum? ({At or below the minimum, Above the minimum}); <<objectSignal>>
if () then ([v1 = 'At or below the minimum'])
:Create Purchase Order;
:Review Purchase Order;
:v2: Purchase Order approved? ({Approved, Rejected}); <<objectSignal>>
if () then ([v2 = 'Approved'])
:Reserve funds for purchase;
:Send Order to Suppliers;
:Supplier sends packing slip and invoice;
split
-> Packing Slip Received;
:Receive and record packing slip;
split again
-> Invoice Received;
:Receive and record invoice;
end split
:Release reserved funds and issue payment to supplier;
else ([v2 = 'Rejected'])
:Rework the order;
:Review Purchase Order;
endif
else ([v1 = 'Above the minimum'])
:End;
endif
stop
@enduml