      "justification": "Models the decision to retry, converging back to the data input step."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "if you choose to abort"
      ],
      "justification": "Captures the abort decision and its resulting process termination."
