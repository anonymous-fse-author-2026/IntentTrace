  "mutations": [
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "wait for the purchase invoice and shipment"
      ],
      "reason": "The model explicitly drops 'and shipment', meaning the process would advance without waiting for the shipment. This is a behavior-changing omission of a required artifact."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the purchase invoice and shipment are received"
      ],
      "reason": "The model checks only if the invoice is received, completely missing the requirement to check for the shipment as well. This changes the decision boundary."
    }
  ],
