{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start"
      ],
      "justification": "Initiates the process and explicitly models the start step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "placing an order"
      ],
      "justification": "Direct match for the action of placing an order."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the customer"
      ],
      "justification": "Direct match for the action of checking the customer."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the customer"
      ],
      "justification": "Decision point for the customer check."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "is \"not eligible to order\""
      ],
      "justification": "Condition for an ineligible customer."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "inform them"
      ],
      "justification": "Action to inform an ineligible customer."
    },
    {
      "refs": [
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "is \"eligible to order\""
      ],
      "justification": "Condition for an eligible customer."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "open a new order in the ERP system"
      ],
      "justification": "Action to open an order for an eligible customer."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Termination step and structural end for the ineligible path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "perform an availability check"
      ],
      "justification": "Direct match for performing the availability check."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\""
      ],
      "justification": "Represents the check step, the decision branch, and the implicit positive condition for product availability."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Negative condition for when the product is not available."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "start producing the missing parts"
      ],
      "justification": "Action to produce parts if unavailable."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process."
      ],
      "justification": "Structural merge point for continuing the process after the availability check."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Direct match for preparing products."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Parallel gateway (AND) for concurrent tasks."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "ship the products"
      ],
      "justification": "Action to ship products."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "send the invoice"
      ],
      "justification": "Action to send the invoice."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "checking for payment"
      ],
      "justification": "Step and decision node for the payment check."
    },
    {
      "refs": [
        "guard:b3->n16"
      ],
      "verbatim_texts": [
        "is received"
      ],
      "justification": "Positive condition for the payment."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "close the order"
      ],
      "justification": "Action to close the order, acting as the end of this process path."
    },
    {
      "refs": [
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "is not received"
      ],
      "justification": "Negative condition for the payment."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "send a reminder"
      ],
      "justification": "Action to send a reminder for unreceived payment."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "ending the process"
      ],
      "justification": "Action and structural end mapped to the alternative ending."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the number of reminders"
      ],
      "justification": "Evaluates the condition regarding the count of reminders."
    },
    {
      "refs": [
        "guard:b4->c2"
      ],
      "verbatim_texts": [
        "is less than 3"
      ],
      "justification": "Condition for less than 3 reminders, merging back to continue checking."
    },
    {
      "refs": [
        "guard:b4->n20"
      ],
      "verbatim_texts": [
        "is equal to 3"
      ],
      "justification": "Condition for exactly 3 reminders."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "inform the lawyer"
      ],
      "justification": "Action taken when the reminder threshold is met."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "and end the process."
      ],
      "justification": "Action and structural point to terminate the process after informing the lawyer."
    }
  ],
