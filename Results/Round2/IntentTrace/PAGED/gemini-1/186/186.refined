init(i1)
action(n1, "Start ICT Logistics Process")
branch(b1, XOR)
action(n2, 'if the answer is "no"')
action(n3, "proceed with the acquisition of the pricing")
action(n4, 'If the answer is "no" again')
action(n5, "acquire the pricing")
converge(c1)
action(n6, "Calculate margin")
action(n7, "Prepare offer")
action(n8, "Calculate transport rate")
action(n9, "End Process")
end(e1)
defines(v1, "Answer", {"no", "no again", "yes"})
actor(a_default, "Default", [i1, n1, b1, n2, n3, n4, n5, c1, n6, n7, n8, n9, e1])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n2)
precedence(n2, n3)
precedence(n3, c1)
precedence(b1, n4)
precedence(n4, n5)
precedence(n5, c1)
precedence(b1, c1)
precedence(c1, n6)
precedence(n6, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, e1)
guard(b1, n2, v1 = 'no')
guard(b1, n4, v1 = 'no again')
guard(b1, c1, v1 = 'yes')