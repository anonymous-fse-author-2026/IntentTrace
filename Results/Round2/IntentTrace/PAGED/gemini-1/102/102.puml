@startuml
!theme plain
|a_default| Default
|a_default|
start
:Resupply Cycle Triggered;
:Check Inventory Level;
:v1: Check Inventory Level ({Inventory level is at or below the minimum, Inventory level is above the minimum}); <<objectSignal>>
if () then ([v1 = 'Inventory level is at or below the minimum'])
:Create Purchase Order;
:Review Purchase Order;
:v2: Purchase Order approved ({Purchase Order approved, Purchase Order rejected}); <<objectSignal>>
if () then ([v2 = 'Purchase Order approved'])
:Reserve funds for the purchase;
:Send Order to Suppliers;
split
:Supplier sends packing slip;
:Record packing slip;
split again
:Supplier sends invoice;
:Record invoice;
end split
:After recording the packing slip and invoice;
:Release reserved funds and issue payment to the supplier;
:End process after payment is issued to the supplier;
stop
else ([v2 = 'Purchase Order rejected'])
:Rework the order;
:In case the order needs to be reworked, review the Purchase Order again.;
endif
else ([v1 = 'Inventory level is above the minimum'])
:End process due to sufficient inventory;
stop
endif
@enduml