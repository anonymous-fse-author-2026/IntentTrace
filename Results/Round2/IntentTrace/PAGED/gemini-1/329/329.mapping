        "action:n18"
      ],
      "verbatim_texts": [
        "the order will need to be signed off by the board of directors."
      ],
      "justification": "Action required for larger orders."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "collect the order and start production."
      ],
