  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process, begin by processing incoming orders."
      ],
      "justification": "Initiates the process and performs the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once the order is received"
      ],
      "justification": "Direct match to receiving the order."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to send the collected order list"
      ],
      "justification": "Direct match to sending the list."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "implement it in the database."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "gather all the information in one excel-file."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check the order and customer details."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n7",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the \"permit data\" option is selected"
      ],
      "justification": "Captures the decision branch, positive condition, and its guard."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed with permitting the data."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n9",
        "guard:b1->n9"
      ],
      "verbatim_texts": [
        "However, if the \"not permit data\" option is chosen"
      ],
      "justification": "Captures the negative branch condition and guard."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "release the data if permitted"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "contact the selling agency if not permitted."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n12_1",
        "action:n12_2"
      ],
      "verbatim_texts": [
        "check the worth of the orders."
      ],
      "justification": "Converges the split paths and checks worth."
    },
    {
      "refs": [
        "action:n13",
        "guard:b2->n13"
      ],
      "verbatim_texts": [
        "If the orders are to be released"
      ],
      "justification": "Captures the decision branch and its condition."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n15",
        "guard:b2->n15"
      ],
      "verbatim_texts": [
        "if the order is to be canceled"
      ],
      "justification": "Alternative conditional path."
    },
    {
      "refs": [
        "action:n15b"
      ],
      "verbatim_texts": [
        "the process will end."
      ],
      "justification": "Ends the canceled path."
    },
