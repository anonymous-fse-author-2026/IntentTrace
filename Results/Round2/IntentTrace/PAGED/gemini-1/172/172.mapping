{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin with"
      ],
      "justification": "Starts the process and includes a redundant start action which preserves behaviour."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "choose your destination and calculate the distance"
      ],
      "justification": "Directly represents the step to choose destination and calculate distance."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check if you need to book a train or a flight"
      ],
      "justification": "Captures the step of checking the transport requirement."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the answer is \"no\""
      ],
      "justification": "Establishes the split for transport decision and correctly implements the negative guard."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to book a train"
      ],
      "justification": "Maps directly to the action of booking a train."
    },
    {
      "refs": [
        "guard:b1->n_flight"
      ],
      "verbatim_texts": [
        "if the answer is \"yes\""
      ],
      "justification": "Correctly implements the positive guard for the transport decision."
    },
    {
      "refs": [
        "action:n_flight"
      ],
      "verbatim_texts": [
        "then book a flight"
      ],
      "justification": "Maps directly to the action of booking a flight."
    },
    {
      "refs": [
        "action:n6",
        "action:n6_f",
        "guard:b2->n6",
        "guard:b2_f->n6_f"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours"
      ],
      "justification": "Captures the decision branch, condition checks, and positive guards for code availability. The duplication for train and flight paths is a behaviour-preserving redundancy."
    },
    {
      "refs": [
        "action:n7",
        "action:n7_f"
      ],
      "verbatim_texts": [
        "the process will end."
      ],
      "justification": "Captures the process termination for the early code availability scenario."
    },
    {
      "refs": [
        "guard:b2->n8",
        "guard:b2_f->n8_f"
      ],
      "verbatim_texts": [
        "Otherwise, if 24 hours have passed"
      ],
      "justification": "Captures the negative/timeout guard for the code availability decision."
    },
    {
      "refs": [
        "action:n8",
        "action:n8_f"
      ],
      "verbatim_texts": [
        "call a travel agency"
      ],
      "justification": "Matches the action required if the initial 24 hours have passed."
    },
    {
      "refs": [
        "guard:b3->n10",
        "guard:b3_f->n10_f"
      ],
      "verbatim_texts": [
        "If a code is available"
      ],
      "justification": "Establishes the subsequent split for the secondary code availability check and its positive guard."
    },
    {
      "refs": [
        "action:n10",
        "action:n10_f"
      ],
      "verbatim_texts": [
        "the process will end along with the hotel reservation"
      ],
      "justification": "Matches the resulting process termination and final state description."
    },
    {
      "refs": [
        "guard:b3->n11",
        "guard:b3_f->n11_f"
      ],
      "verbatim_texts": [
        "if a code is not available"
      ],
      "justification": "Establishes the negative guard for the secondary code availability check."
    },
    {
      "refs": [
        "action:n11",
        "action:n11_f"
      ],
      "verbatim_texts": [
        "cancel your journey"
      ],
      "justification": "Direct match to the cancellation action."
    },
    {
      "refs": [
        "action:n12",
        "action:n12_f"
      ],
      "verbatim_texts": [
        "the process will end as well"
      ],
      "justification": "Captures the final termination of the process."
    }
