{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Correctly starts the process and models the initial action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "Models the condition as an action step, opens the XOR branch, and captures the negative guard."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "advertise the vacancy."
      ],
      "justification": "Direct match for the advertising step."
    },
    {
      "refs": [
        "guard:b1->n_cont"
      ],
      "verbatim_texts": [
        "if there is a suitable candidate available"
      ],
      "justification": "Captures the positive guard for the initial candidate availability."
    },
    {
      "refs": [
        "action:n_cont"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Maps to the continuation action and the associated structural converge gateway."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available"
      ],
      "justification": "Models the second condition as an action, opens the XOR decision, and provides the negative guard."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "advertise the vacancy again."
      ],
      "justification": "Direct match for re-advertising the vacancy."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "proceed with selecting the appropriate applicant."
      ],
      "justification": "Captures the action to select the applicant, the implicit positive branch guard leading to it, and the converge gateway."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed"
      ],
      "justification": "Matches the appointment condition modeled as an action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Faithfully captures the process termination modeled redundantly as an action and an end event."
    }
  ],
