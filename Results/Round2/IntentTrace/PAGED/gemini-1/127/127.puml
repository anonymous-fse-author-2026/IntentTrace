@startuml
!theme plain
|a_default| Default
|a_default|
start
:Identify parts;
:v1: Availability info ({Need to elicit, Already have}); <<objectSignal>>
if () then ([v1 = 'Need to elicit'])
:Check availability of parts;
else ([v1 = 'Already have'])
:Proceed with process;
endif
:v2: Supply status ({Supplied to customer, Need to record details}); <<objectSignal>>
if () then ([v2 = 'Supplied to customer'])
:continue with the process;
else ([v2 = 'Need to record details'])
:Record customer details;
:Order and receive part from Disuki;
:Once the part is received;
:Contract customer;
endif
:Proceed with payment;
:End;
stop
@enduml