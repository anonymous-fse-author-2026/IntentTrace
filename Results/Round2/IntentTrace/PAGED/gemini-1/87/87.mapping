      "verbatim_texts": [
        "To begin the process in the Admin Office"
      ],
      "justification": "Initiates the process and models the first step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check if it has started"
      ],
      "justification": "Matches the action checking if the process started."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "verify the completeness of the invoices"
      ],
      "justification": "Matches the verification action."
    },
    {
      "refs": [
        "guard:b3->n5"
      ],
      "verbatim_texts": [
        "If they are marked as \"Uncompleted\""
      ],
      "justification": "Captures the decision branch and the negative condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "they should be returned to the client through postal mail"
      ],
      "justification": "Matches returning the uncompleted invoices."
    },
    {
      "refs": [
        "guard:b3->n9",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "if they are marked as \"Completed\""
      ],
      "justification": "Matches the positive condition for the decisions (applicable to both the first and second checks)."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the process should be continued"
      ],
      "justification": "Matches the continuation step."
    },
    {
      "refs": [
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "If the invoices are still marked as \"Uncompleted\""
      ],
      "justification": "Captures the subsequent decision point and its negative condition."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "they should be returned to the client via postal mail"
      ],
      "justification": "Matches the repeated action of returning the invoices."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "receive the completed ones"
      ],
      "justification": "Matches the step of receiving the completed invoices."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "mark the relevant box on the invoice entry form"
      ],
      "justification": "Matches marking the entry form."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "checking if the process has been completed"
      ],
      "justification": "Matches the final check step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Finally, the process ends"
      ],
      "justification": "Captures the explicit end state and its associated action."
    }
