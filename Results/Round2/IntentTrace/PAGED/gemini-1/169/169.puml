@startuml
!theme plain
|a_default| Default
|a_default|
start
:Receive and categorize the invoice;
:Instruction: Forward Invoice to Admin Officer or Reject invoice or Return invoice to client for completion or Process Invoice for SAP Entry?;
:v1: Instruction  Forward Invoice to Admin Officer or Reject invoice or Return invoice to client for completion or Process Invoice for SAP Entry? ({Forward Invoice to Admin Officer, Reject invoice, Return invoice to client for completion, Process Invoice for SAP Entry}); <<objectSignal>>
switch ()
case ([v1 = 'Forward Invoice to Admin Officer'])
:Sort the invoice;
stop
case ([v1 = 'Reject invoice'])
:End process;
stop
case ([v1 = 'Return invoice to client for completion'])
:If the instruction is to Return invoice to client for completion;
:Receive and categorize the invoice again;
case ([v1 = 'Process Invoice for SAP Entry'])
:Forward invoice for validation;
:Validate the invoice;
:End process;
stop
endswitch
@enduml