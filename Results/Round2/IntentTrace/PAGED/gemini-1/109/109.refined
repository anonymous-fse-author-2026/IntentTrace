init(i1)
action(n1, "start the process by acquiring a new customer")
action(n2, "take the contract to Ms Hannover")
action(n3, "input the contract into the database")
branch(b1, XOR)
action(n5, "organize a suitable team")
action(n6, "contact the customer directly")
action(n7, "end the process after organizing team")
end(e1)
action(n8, "end the process after contacting customer")
end(e2)
defines(v1, "contract status", {"okay", "missing details"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n5, n6, n7, e1, n8, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(b1, n6)
precedence(n5, n7)
precedence(n6, n8)
precedence(n7, e1)
precedence(n8, e2)
guard(b1, n5, v1 = "okay")
guard(b1, n6, v1 = "missing details")