{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially"
      ],
      "justification": "Starts the process and captures the initial context."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check the Referee Reports"
      ],
      "justification": "Captures the concurrent action of checking the reports and structurally closes its branch."
    },
    {
      "refs": [
        "branch:b_start"
      ],
      "verbatim_texts": [
        "At the same time"
      ],
      "justification": "Indicates concurrent execution mapped to an AND split."
    },
    {
      "refs": [
        "action:n_monitor"
      ],
      "verbatim_texts": [
        "monitor if the Referee Reports have been completed"
      ],
      "justification": "Direct match for the monitoring step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If they have been completed"
      ],
      "justification": "Opens the XOR gateway and captures the positive condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed with the process"
      ],
      "justification": "Action taken on the positive branch."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if they have not been completed"
      ],
      "justification": "Negative condition for the branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "flag it and send a reminder"
      ],
      "justification": "Direct match for the negative branch action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check again if the Referee Reports have been completed"
      ],
      "justification": "Converges flow back and performs the subsequent check."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If they have"
      ],
      "justification": "Decision gateway and the positive condition for the second check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "continue with the process"
      ],
      "justification": "Positive branch action."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Negative condition for the second check."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "flag it again and send another reminder"
      ],
      "justification": "Negative branch action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the Referee Reports have been completed, you can move on to organizing interviews for the Selection Panel with the top candidates"
      ],
      "justification": "Implicitly joins paths where the reports are completed and performs the next action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive feedback from the interview candidates"
      ],
      "justification": "Direct match for receiving feedback."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "check if a Psychometric Test is required"
      ],
      "justification": "Direct match for the evaluation action."
    },
    {
      "refs": [
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If it is"
      ],
      "justification": "Opens the decision gateway and captures the positive condition."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "check if an HR Specialist is required"
      ],
      "justification": "Direct match for checking the requirement."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "continue with the process and coordinate the second round of selection"
      ],
      "justification": "Captures the negative guard condition and its associated action."
    },
    {
      "refs": [
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required"
      ],
      "justification": "Opens the final gateway and models the positive condition."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "schedule the test with a third party"
      ],
      "justification": "Action for the positive case."
    },
    {
      "refs": [
        "guard:b5->n19"
      ],
      "verbatim_texts": [
        "Otherwise"
      ],
      "justification": "Negative condition mapped to the alternative branch."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "proceed to complete the Psychometric Test"
      ],
      "justification": "Action mapped to the 'Otherwise' branch."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Finally, you should request the final candidate ranking and continue with the process."
      ],
      "justification": "Converges previously split pathways, executes the final step, and resolves into the process end point."
    }
