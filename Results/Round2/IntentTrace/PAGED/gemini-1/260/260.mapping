{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "the process begins"
      ],
      "justification": "Correctly models the start of the process and the initial action."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "receiving the invoice"
      ],
      "justification": "Correctly models the invoice reception step."
    },
    {
      "refs": [
        "action:i3"
      ],
      "verbatim_texts": [
        "it is sorted per client"
      ],
      "justification": "Correctly models sorting per client."
    },
    {
      "refs": [
        "action:i4"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor"
      ],
      "justification": "Correctly models sorting per vendor."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice"
      ],
      "justification": "Correctly models the form attachment action."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form"
      ],
      "justification": "Correctly models the entry of required information."
    },
    {
      "refs": [
        "action:i7"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked"
      ],
      "justification": "Models the completeness check and establishes the decision split."
    },
    {
      "refs": [
        "action:i8",
        "guard:b1->i8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete"
      ],
      "justification": "Models the condition for handling incomplete invoices."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Correctly models the process termination when an invoice is incomplete."
    },
    {
      "refs": [
        "action:i10",
        "guard:b1->i10"
      ],
      "verbatim_texts": [
        "the information for the SLA is entered. The date for completion is also entered and the priority is checked."
      ],
      "justification": "Models the successful completeness path and associated data entry actions."
    },
    {
      "refs": [
        "action:i11"
      ],
      "verbatim_texts": [
        "the priority is checked"
      ],
      "justification": "Models the explicit priority check and its respective branch."
    },
    {
      "refs": [
        "action:i12",
        "guard:b2->i12"
      ],
      "verbatim_texts": [
        "If the priority is high"
      ],
      "justification": "Models the high priority condition path."
    },
    {
      "refs": [
        "action:i13"
      ],
      "verbatim_texts": [
        "a red stamp is placed on the entry invoice"
      ],
      "justification": "Models the red stamp action for high priority items."
    },
    {
      "refs": [
        "action:i14",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked"
      ],
      "justification": "Models the next action and compliance branch, serving as a structural convergence and default path for non-high priorities."
    },
    {
      "refs": [
        "action:i15",
        "guard:b_comp->i15"
      ],
      "verbatim_texts": [
        "If it is not complete, the check continues."
      ],
      "justification": "Models the condition for incomplete compliance."
    },
    {
      "refs": [
        "action:i16",
        "guard:b_comp->i16"
      ],
      "verbatim_texts": [
        "If it is complete, the process continues."
      ],
      "justification": "Models the condition for complete compliance."
    },
    {
      "refs": [
        "action:i17",
        "guard:b3->i17"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff"
      ],
      "justification": "Models the routing condition to experienced staff and corresponding split."
    },
    {
      "refs": [
        "action:i18"
      ],
      "verbatim_texts": [
        "the non-compliance invoice is processed"
      ],
      "justification": "Models the action taken by experienced staff."
    },
    {
      "refs": [
        "action:i19",
        "guard:b3->i19"
      ],
      "verbatim_texts": [
        "the client is called"
      ],
      "justification": "Models the condition and action for a normal case."
    },
    {
      "refs": [
        "action:i20",
        "guard:b3->i20"
      ],
      "verbatim_texts": [
        "a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Models the fallback path, related postal action, and end event."
    },
    {
      "refs": [
        "action:i22"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Models structural flow rejoining and the subsequent final call to the client."
    },
    {
      "refs": [
        "action:i23"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO"
      ],
      "justification": "Models the batching and allocation step."
    },
    {
      "refs": [
        "action:i21"
      ],
      "verbatim_texts": [
        "and the process ends"
      ],
      "justification": "Models the final termination of the successful path."
    }
  ],
