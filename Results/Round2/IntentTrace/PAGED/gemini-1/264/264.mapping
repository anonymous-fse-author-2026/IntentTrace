      ],
      "justification": "Direct match for scanning and recording the form."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The approval is checked"
      ],
      "justification": "Direct match for checking the approval again."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Direct match for the step of sending documentation again."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "HR services receive the documentations"
      ],
      "justification": "Direct match modeled as an action state."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "and this marks the end of the process."
      ],
      "justification": "Models the termination conceptually as an action and structurally as the end event."
    },
    {
      "refs": [
        "guard:b2->n15"
      ],
      "verbatim_texts": [
