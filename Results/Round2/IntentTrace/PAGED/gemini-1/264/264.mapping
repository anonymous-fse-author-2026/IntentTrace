      "justification": "Matches the authorization of the external appointment and correctly closes the decision gateway."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Direct match for sending documentation and approval to HR."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
