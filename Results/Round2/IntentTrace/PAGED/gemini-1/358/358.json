  "input_elements": [
    {
      "id": "i1",
      "content": "In the beginning,"
    },
    {
      "id": "i2",
      "content": "if the answer is \"No\", then we continue the process."
    },
    {
      "id": "i3",
      "content": "If the answer is \"No\" again, we continue the process."
    },
    {
      "id": "i4",
      "content": "However, if the answer is \"Yes\","
    },
    {
      "id": "i5",
      "content": "if the answer is \"Yes\""
    },
    {
      "id": "i6",
      "content": "then we give it priority."
    },
    {
      "id": "i7",
      "content": "we look up the Vendor on SAP."
    },
    {
      "id": "i8",
      "content": "If the answer is \"No\","
    },
    {
      "id": "i9",
      "content": "we need a Vendor master record"
    },
    {
      "id": "i10",
      "content": "and the process ends."
    },
    {
      "id": "i11",
      "content": "But if the answer is \"Yes\","
    },
    {
      "id": "i12",
      "content": "then we enter the invoice in SAP."
    },
    {
      "id": "i13",
      "content": "And if the answer is \"Yes\" again"
    },
    {
      "id": "i14",
      "content": "we place the entered invoices in the normal Outbox"
    }
