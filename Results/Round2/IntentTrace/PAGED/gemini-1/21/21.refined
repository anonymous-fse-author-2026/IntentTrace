init(start_node)
action(i1, "To start the process")
action(i2, "supplying the requirement")
action(i3, "documenting it")
branch(b1, XOR)
action(i4, "If the order is received via fax")
action(i6, "If the order is received via mail or phone")
converge(c_receive)
action(i5, "input the order into an Excel file")
action(i7, "Once the Excel list is complete")
action(i8, "send it to the student")
action(i9, "type the orders into the MS-Access database")
action(i10, "ensure that it is completed")
branch(b5, AND)
action(i11, "control the incoming order")
action(i12, "At the same time, continue to do the check")
converge(c1)
action(i13, "If the order is correct")
branch(b2, XOR)
action(i14, "If the order is correct, release it")
action(i15, "release it")
action(i16, "Send the Excel list to the student")
action(i17, "continue with the process")
action(i18, "if the order is incorrect, contact the selling agency")
branch(b3, XOR)
action(i19, "If the order is worth less than 5.000 €")
action(i15_2, "release it")
action(i20, "If the order is worth more than 5.000 €, send it for sign off and continue with the check.")
action(i21, "upon receiving the actual issue")
branch(b4, XOR)
action(i22, "Once the order is signed off")
action(i23, "contact the client")
action(i24, "release the order")
action(i27, "If the issue cannot be solved")
action(i28, "If the issue cannot be solved, cancel the order")
action(i29, "If the issue can be solved")
action(i30, "If the issue can be solved, release the order")
converge(c2)
action(i25, "Once the order is received by PPC")
action(i26, "they will initiate production")
action(i31, "the goods will be produced")
branch(b_cancel_check, XOR)
converge(c_cancel)
action(i32, "If the order needs to be cancelled")
action(i34, "If the order needs to be cancelled, the process ends")
action(i33, "If the order needs to be cancelled, the process ends. If not,")
action(i35, "If not, check the quality of the goods")
action(i36, "create and send a quality report to the finance department")
action(i37, "Release the order via memo")
action(i38, "ensure that the memo is achieved in the warehouse")
action(i39, "Send the invoice")
branch(b6, AND)
action(i40, "report the achievement to the finance department")
action(i41, "At the same time, commission the goods")
action(i42, "sign and send the memo")
action(i43, "send the goods")
action(i44, "ensure that the signed memo is achieved in the logistic department")
converge(c3)
action(i45, "archive the memo")
action(i46, "close the order")
converge(c_end)
action(i47, "This marks the end of the process.")
end(e1)
