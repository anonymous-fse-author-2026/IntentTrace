init(i1)
action(n1, "start Expense Report process")
action(n2, "Receive Expense Report")
action(n3, "Verify account and review report")
branch(b1, XOR)
action(n5, "Process reimbursement")
action(n6, "Proceed with payment")
action(n7, "End")
end(e1)
action(n8, "Send Expense Rejection Notification")
action(n9, "End")
end(e2)
defines(v1, "Is report accepted?", {"accepted", "rejected"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n5, n6, n7, e1, n8, n9, e2])
precedence(i1, n1)
precedence(n7, e1)
precedence(n9, e2)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, n7)
precedence(b1, n8)
precedence(n8, n9)
guard(b1, n5, v1 = 'accepted')
guard(b1, n8, v1 = 'rejected')