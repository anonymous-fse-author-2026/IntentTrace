    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "Initiates the process and performs the first registration step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b_exception->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "Models the decision point and the positive branch requiring an exception request."
    },
    {
      "refs": [
        "guard:b_exception->c_exception"
      ],
      "verbatim_texts": [
        "On the other hand, if an exception is not needed, the process can continue."
      ],
      "justification": "Models the negative branch where the flow bypasses the request and rejoins the main stream."
    },
    {
      "refs": [
        "action:n5",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After the exception is approved, the next step is course enrollment, followed by seminar group enrollment."
      ],
      "justification": "Sequentially captures the approval step, course enrollment, and seminar group enrollment."
    },
    {
      "refs": [
        "action:n8",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the seminar group enrollment is completed, the homework assignment can be started. After working on the homework, it should be turned in. The homework will then be evaluated, and the process can continue."
      ],
      "justification": "Captures the sequential homework workflow (start, turn in, evaluate) and its joining point."
    },
    {
      "refs": [
        "action:n11",
        "guard:b_homework->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Correctly models the loop condition and triggers another assignment when it is not the last."
    },
    {
      "refs": [
        "guard:b_homework->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if it was the last homework, the process can continue."
      ],
      "justification": "Models the exit path from the homework loop when the final assignment is reached."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "Uses an AND-split to correctly model the concurrent execution of both additional steps."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "After signing up for the exam, it should be attended. Once the exam is attended, it will be evaluated."
      ],
      "justification": "Sequentially models exam signup, attendance, and evaluation."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue.",
        "If the exam is passed, the course is considered passed. If the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Models the pass condition, course completion status, and process termination. The second span is a direct restatement covering the same positive outcome."
    },
    {
      "refs": [
        "guard:b_exam_result->n20"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue.",
        "If the exam is passed, the course is considered passed. If the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Models the pass condition, course completion status, and process termination. The second span is a direct restatement covering the same positive outcome."
    },
    {
      "refs": [
