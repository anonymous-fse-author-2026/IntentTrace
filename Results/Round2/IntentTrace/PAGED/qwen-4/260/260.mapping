{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "Initiates the process and captures the first receiving step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After receiving the invoice, it is sorted per client."
      ],
      "justification": "Directly matches the client sorting step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once sorted per client, it is then sorted per vendor."
      ],
      "justification": "Directly matches the vendor sorting step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "The next step is to attach the invoice entry form to the invoice."
      ],
      "justification": "Directly matches the form attachment step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After attaching the form, the required information is entered onto the form."
      ],
      "justification": "Directly matches the data entry step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Following that, the completeness of the invoice is checked."
      ],
      "justification": "Captures the completeness check and introduces the XOR branch for the outcome."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Models the incomplete condition, the corresponding end action, and the terminal node."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered. The date for completion is also entered and the priority is checked."
      ],
      "justification": "Covers the complete branch guard, combined SLA/date/priority entry actions, and the subsequent priority decision point. The redundant priority check (n10) preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "Correctly models the high-priority guard and the stamping action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Models the low-priority continuation guard and the structural join point."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Captures the compliance check action and opens the subsequent multi-way branch."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Matches the experienced staff condition and processing action."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Matches the normal case condition and client call action."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Models the fallback condition, mailing step, and process termination."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Direct paraphrase of the final client contact step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO, and the process ends."
      ],
      "justification": "Captures the batching/allocation step and the structural convergence before termination."
    }
  ],
