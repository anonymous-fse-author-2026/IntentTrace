    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The loan application process starts with receiving the loan application."
      ],
      "justification": "The init node marks the start, and the action captures receiving the application, directly aligning with the opening sentence."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps should be completed: assessing the loan risk and checking the credit history."
      ],
      "justification": "Merges the simultaneous risk assessment and credit check into a single action step, which preserves the intended behavior without changing flow."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, the eligibility of the applicant is assessed."
      ],
      "justification": "Directly corresponds to the eligibility assessment step following the prior tasks."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the applicant is eligible, the acceptance pack is prepared."
      ],
      "justification": "The XOR branch opens the decision, the guard models the positive eligibility condition using a boolean variable, and the action prepares the pack."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the applicant is not eligible, the application is rejected."
      ],
      "justification": "The guard models the negative condition, leading to the rejection action, correctly capturing the alternative branch."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the application is rejected, the loan application process ends."
      ],
      "justification": "Captures the explicit termination step and end node on the rejection path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "The prepared acceptance pack is then sent."
      ],
      "justification": "Direct match for the step of sending the acceptance pack."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the acceptance pack is sent, the process ends."
      ],
      "justification": "Captures the explicit termination step and second end node on the acceptance path."
    }
  ],
