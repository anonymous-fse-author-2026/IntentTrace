{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "Implicit process start and initial setup step align with the opening unit."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "create a process model"
      ],
      "justification": "Direct correspondence to the second step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check it"
      ],
      "justification": "Modeling the verification as an action node followed by a gateway preserves the required check and split."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\", then assign negative points."
      ],
      "justification": "Guard captures the negative condition and action node executes the stated penalty."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\", assign negative points again."
      ],
      "justification": "Re-evaluation step and conditional penalty correctly modeled with matching thresholds."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7",
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Positive paths from both evaluations converge into continuation. Redundant continuation nodes and structural plumbing do not alter behaviour."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Direct implementation of the issue-resolution and level-extension step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points",
        "check the process and assign points",
        "If you need to analyze the field of study",
        "analyze the field of study"
      ],
      "justification": "Single decision-action node faithfully merges four segmented units describing two alternative preparatory paths."
    },
    {
      "refs": [
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points"
      ],
      "justification": "Gateway and guard route the flow down the check-and-assign branch per the source condition."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Continuation step executed after the check/assign path resolves."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study"
      ],
      "justification": "Routes the alternate analysis condition to a merge point, preserving the branching logic."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "assign roles in the team."
      ],
      "justification": "Exact match for the role assignment step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process"
      ],
      "justification": "Condition modeled as an action step; behaviour-preserving re-typing."
    },
    {
      "refs": [
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "perform work according to your assigned role."
      ],
      "justification": "Split into two equivalent execution steps. Redundancy does not change process flow."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct alignment with the progress monitoring and consultation step."
    },
    {
      "refs": [
        "action:n19",
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it."
      ],
      "justification": "First acceptance check and corresponding presentation action correctly mapped."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Negative outcome path explicitly guarded and executed per source."
    },
    {
      "refs": [
        "action:n22",
        "guard:b6->n23",
        "action:n23",
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Second acceptance cycle modeled with parallel positive/negative arms. Adding explicit negative routing and re-typing conditions as actions preserves intended behaviour."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Final presentation and termination align with the closing unit. Convergence is harmless structural plumbing."
    }
  ],
