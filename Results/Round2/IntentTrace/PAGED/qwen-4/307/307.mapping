      "refs": [
        "action:n5b"
      ],
      "verbatim_texts": [
        "highlight any errors on the invoice entry form and keep a record of the DEO's performance."
      ],
      "justification": "Models the second simultaneous task (recording performance), preserving the overall parallel behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
