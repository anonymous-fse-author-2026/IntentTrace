      "verbatim_texts": [
        "To begin the validation process, start by checking the received invoice for any errors."
      ],
      "justification": "Covers the implicit process start, the explicit 'start' step, and the initial error-checking action."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If any errors are found"
      ],
      "justification": "Defines the XOR decision point and the guard for the error-true path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Direct paraphrase of the continuation step when errors exist."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If no errors are found"
      ],
      "justification": "Captures the negative branch condition using an equivalent variable assignment."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "mark the \"invoice entered correctly\" box."
      ],
      "justification": "Directly models the marking step for the no-error case."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Simultaneously, highlight any errors on the invoice entry form"
      ],
      "justification": "Models the first simultaneous task."
    },
