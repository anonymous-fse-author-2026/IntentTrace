      ],
      "justification": "Directly restates the final verification step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the \"invoice entered correctly\" box is ticked, the invoice is checked and the process ends. If an error exists, the process also ends."
      ],
      "justification": "Joins the split flows, performs the final check, and terminates the process as described. Structural elements preserve the branching/convergence behaviour."
    }
