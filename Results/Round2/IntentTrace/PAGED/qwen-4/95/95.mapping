{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Init marks process start; action:i1 captures the initial ordering step."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "Check the Customer's Credit Limit"
      ],
      "justification": "Directly corresponds to the credit limit verification step."
    },
    {
      "refs": [
        "guard:b1->i3",
        "action:i3"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "Branch opens decision; guard and action preserve the positive path behaviour."
    },
    {
      "refs": [
        "guard:b1->i4",
        "action:i4"
      ],
      "verbatim_texts": [
        "However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Preserves the negative path and its terminal outcome."
    },
    {
      "refs": [
        "guard:b2->i5",
        "action:i5"
      ],
      "verbatim_texts": [
        "if the response is \"Okay\", proceed to Check the Availability of the Article again."
      ],
      "justification": "Models the second availability check triggered by a positive response."
    },
    {
      "refs": [
        "guard:b2->i6",
        "action:i6"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Captures the rejection path for the second check."
    },
    {
      "refs": [
        "guard:b3->i7",
        "action:i7"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Branches on availability status; guard/action model the production route."
    },
    {
      "refs": [
        "guard:b3->i8",
        "action:i8"
      ],
      "verbatim_texts": [
        "However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Models the collection route and subsequent flow merge."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Direct step match for confirmation dispatch."
    },
    {
      "refs": [
        "action:i10a",
        "action:i10b"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "AND gateway correctly models parallel execution of shipping and invoicing."
    },
    {
      "refs": [
        "action:i11"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Structural merge precedes the payment status check action."
    },
    {
      "refs": [
        "guard:b5->i12",
        "action:i12"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "Captures the successful payment path leading to order closure and termination."
    },
    {
      "refs": [
        "guard:b5->i14",
        "action:i14"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Models the unpaid path directing flow to reminder threshold evaluation."
    },
    {
      "refs": [
        "guard:b6->i15",
        "action:i15"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Branches on the threshold condition; guard/action preserve the write-off behaviour."
    },
    {
      "refs": [
        "guard:b6->i16",
        "action:i16"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Models the reminder dispatch on the complementary branch. Acceptable behavioural split."
    },
    {
      "refs": [
        "action:i17"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Final order closure and process termination."
    }
  ],
