{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by checking the customer's order."
      ],
      "justification": "Covers the process initiation and the first action. action:n1 is a harmless redundant restatement of the start."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer is a registered customer, then check their payment morale."
      ],
      "justification": "Models the registered customer condition and the subsequent payment morale check."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they are a new customer, then check their status."
      ],
      "justification": "Models the new customer branch and the corresponding status check action."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->c_ms",
        "action:n10"
      ],
      "verbatim_texts": [
        "If their payment morale is good, continue with the process."
      ],
      "justification": "Captures the good morale condition and the continuation step. Re-typing the condition into an explicit node followed by a branch preserves behavior."
    },
    {
      "refs": [
        "guard:b2->c1",
        "action:n7",
        "guard:b3->c1",
        "action:n8"
      ],
      "verbatim_texts": [
        "If their payment morale is bad or if they are an end customer, reject the order and end the process."
      ],
      "justification": "Splits the compound OR condition into two parallel evaluations that converge on rejection. This restructuring preserves the exact decision logic and outcome."
    },
    {
      "refs": [
        "action:n_ww",
        "guard:b_ww->c_flow",
        "guard:b_ww->b1",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the customer is a wholesaler, enter their data and take the order."
      ],
      "justification": "Handles the wholesaler condition correctly. The 'No' guard provides necessary routing for the implicit else-case, which is standard structural plumbing."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, check the availability of the items."
      ],
      "justification": "Models the parallel branch introduced by 'At the same time' and performs the availability check."
    },
    {
      "refs": [
        "action:n13",
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the items are out of stock, start production."
      ],
      "justification": "Correctly captures the out-of-stock condition and triggers the production start action."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If they are in stock, continue with the process."
      ],
      "justification": "Correctly captures the in-stock condition and the continuation action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Once the availability is checked, send the order confirmation."
      ],
      "justification": "Converges the validated paths and executes the confirmation step as described."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If production is started, produce the article and send the order confirmation."
      ],
      "justification": "Covers the production phase and the subsequent confirmation step on that specific path."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Simultaneously, send the invoice and deliver the product."
      ],
      "justification": "Models the parallel execution via an AND gateway and performs the invoicing/delivery action."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check the payment status."
      ],
      "justification": "Structural converges merge parallel flows before checking payment. action:n20 serves as the check/decision point."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If payment is received, close the order."
      ],
      "justification": "Handles the positive payment branch, closing the order and ending that flow."
    },
    {
      "refs": [
        "guard:b5->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If no payment is received, check the number of reminders."
      ],
      "justification": "Handles the negative payment branch and transitions to evaluating reminder counts."
    },
    {
      "refs": [
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If there are more than three reminders, engage a lawyer."
      ],
      "justification": "Correctly models the '> 3' threshold and the lawyer engagement step."
    },
    {
      "refs": [
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are three or fewer reminders, send a reminder."
      ],
      "justification": "Correctly models the '\u2264 3' threshold and the reminder sending step."
    }
  ],
  "mutations": [],
  "omissions": [],
  "additions": [
