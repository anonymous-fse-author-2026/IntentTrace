init(i1)
action(n1, "wake up")
branch(b1, XOR)
action(n3, "take shower")
action(n4, "have breakfast")
branch(b2, XOR)
action(n6, "take shower again")
action(n7, "have breakfast again")
action(n8, "get on the bus")
action(n9, "You have completed this procedure")
end(e1)
defines(v1, "are you hungry", {"Yes", "No"})
defines(v2, "are you hungry again", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, b1, n3, n4, b2, n6, n7, n8, n9, e1])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, b2)
precedence(n4, b2)
precedence(b2, n6)
precedence(b2, n7)
precedence(n6, n8)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, e1)
guard(b1, n3, v1 = 'No')
guard(b1, n4, v1 = 'Yes')
guard(b2, n6, v2 = 'No')
guard(b2, n7, v2 = 'Yes')