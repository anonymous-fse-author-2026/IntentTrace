{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks, and then they should select the method for exit control checks."
      ],
      "justification": "Covers process initialization, the immigration check step, and the selection of the exit control method."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics"
      ],
      "justification": "Models the split and condition for the biometrics path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should undergo a check using biometrics"
      ],
      "justification": "Direct correspondence to the biometrics check action."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the passenger prefers to use ID documents"
      ],
      "justification": "Models the alternative condition for the ID documents path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "they should undergo checks using identity documents"
      ],
      "justification": "Direct correspondence to the ID document check action."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission, they should leave the area."
      ],
      "justification": "Captures the denied permission decision, the leaving action, and the resulting end point."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Captures the allowed continuation decision, proceeding action, and associated end marker."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission, they should leave the area."
      ],
      "justification": "Redundant modeling of the denied permission branch; preserves behaviour without introducing new logic."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Redundant modeling of the allowed continuation branch; preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends."
      ],
      "justification": "Corresponds to the alternative phrasing of an unsuccessful outcome; leaves area and terminates."
    },
    {
      "refs": [
        "guard:b2->n15",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Corresponds to the alternative phrasing of a successful outcome; continues and terminates."
    }
  ],
