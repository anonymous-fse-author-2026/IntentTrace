init(i1)
action(n_obt, "Obtain raw material from received list")
branch(b1, XOR)
action(n3, "Check raw material")
end(e1)
action(n6, "Select supplier")
action(n7, "Send material purchase order")
action(n8, "Check raw material after PO")
end(e2)
defines(v1, "Is raw material available in stock?", {"Available", "Not Available"})
actor(a_default, "Default", [i1, n_obt, b1, n3, e1, n6, n7, n8, e2])
precedence(i1, n_obt)
precedence(n_obt, b1)
precedence(b1, n3)
guard(b1, n3, v1 = 'Available')
precedence(n3, e1)
precedence(b1, n6)
guard(b1, n6, v1 = 'Not Available')
precedence(n6, n7)
precedence(n7, n8)
precedence(n8, e2)