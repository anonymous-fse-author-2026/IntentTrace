defines(v2, "review decision", {"Rejected", "Approved"})
defines(v3, "translation required?", {"Yes", "No"})
defines(v4, "evaluate review decision", {"Rejected", "Approved"})
defines(v5, "evaluate receipts decision", {"Accepted", "Rejected"})
