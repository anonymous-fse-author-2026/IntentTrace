  "input_elements": [
    {
      "id": "i2",
      "content": "you should choose your destination and calculate the distance"
    },
    {
      "id": "i3",
      "content": "While doing so, continue to check if you need to book a train or a flight."
    },
    {
      "id": "i4",
      "content": "If the answer is \"no\", then proceed to book a train."
    },
    {
      "id": "i5",
      "content": "However, if the answer is \"yes\", then book a flight."
    },
    {
      "id": "i6",
      "content": "If a code is available within 24 hours, the process will end."
    },
    {
      "id": "i7",
      "content": "Otherwise, if 24 hours have passed, you should call a travel agency."
    },
    {
      "id": "i8",
      "content": "If a code is available, the process will end along with the hotel reservation."
    },
    {
      "id": "i9",
      "content": "On the other hand, if a code is not available, you should cancel your journey."
    },
    {
      "id": "i10",
      "content": "In that case, the process will end as well."
    }
  ]
}