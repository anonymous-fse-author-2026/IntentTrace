      "justification": "Directly matches the second step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "verify the completeness of the invoices."
      ],
      "justification": "Directly matches the third step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they are marked as \"Uncompleted\", they should be returned to the client through postal mail."
      ],
      "justification": "Captures the decision point, the negative guard condition, and the corresponding return action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if they are marked as \"Completed\", the process should be continued."
      ],
      "justification": "Captures the positive guard condition and the continue action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoices are still marked as \"Uncompleted\", they should be returned to the client via postal mail."
      ],
      "justification": "Redundant restatement of the same condition and outcome in the source text; behaviour is already covered by the existing branch and action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if they are marked as \"Completed\", the process should be continued."
      ],
      "justification": "Redundant restatement of the same condition and outcome; behaviour is preserved."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the invoices are returned to the client, receive the completed ones."
      ],
      "justification": "Rejoins the split flows after the branch and describes the subsequent step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Then, mark the relevant box on the invoice entry form"
      ],
      "justification": "Directly matches the specified step."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "and proceed with checking if the process has been completed.",
        "Finally, the process ends."
      ],
      "justification": "Describes the finalization steps leading directly to process termination."
    }
