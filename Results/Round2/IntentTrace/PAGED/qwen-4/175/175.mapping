{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Models the process start and the initial return action."
    },
    {
      "refs": [
        "guard:b1->n3",
        "guard:b1->n4",
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process. However, if the \"Delivery Crew picks-up items at event site,\" then we also continue the process."
      ],
      "justification": "Captures the two possible return initiation paths and joins them. Guards abstract the actor type but preserve routing logic."
    },
    {
      "refs": [
        "action:n_check"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct match for the inspection/comparison step."
    },
    {
      "refs": [
        "guard:b2->n5",
        "guard:b2->n6",
        "guard:b2->n7",
        "action:n5",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Models the three-way decision on order status (complete, incomplete, damaged) and associated downstream actions. Variable-based guards preserve the branching logic."
    },
    {
      "refs": [
        "guard:b11->n8",
        "guard:b11->n9",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\" we continue the process. Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Captures the storage/packing decision point and both continuation paths."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Models the conditional removal of damaged items from inventory."
    },
    {
      "refs": [
        "guard:b5->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Routes to process termination. Modeling the end condition via a guard on the preceding branch preserves the flow to the end state."
    },
    {
      "refs": [
        "guard:b3->n15",
        "guard:b3->n16",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process. However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Captures the follow-up decision on missing item returns. Both paths lead to continuation, preserved by the XOR split and subsequent convergence."
    },
    {
      "refs": [
        "guard:b6->n11",
        "guard:b6->n12",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Models the repair vs discard decision and associated outcomes."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Final termination step and end node."
    }
  ],
  "mutations": [],
  "omissions": [
    {
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "reason": "Describes a distinct notification step for missing items that is not captured by any action or label in the model."
    }
  ],
