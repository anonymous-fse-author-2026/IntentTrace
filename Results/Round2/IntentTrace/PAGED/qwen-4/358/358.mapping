{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "In the beginning,"
      ],
      "justification": "Implicitly triggers process initiation and the first step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "if the answer is \"No\", then we continue the process."
      ],
      "justification": "Models the initial negative decision gate and the continuation action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the answer is \"No\" again, we continue the process."
      ],
      "justification": "Captures the secondary negative check and routes flow back to the main path via convergence."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3",
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the answer is \"Yes\", then we give it priority."
      ],
      "justification": "Correctly models both positive branches that assign priority, preserving conditional routing."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After that, we look up the Vendor on SAP."
      ],
      "justification": "Direct paraphrase of the vendor lookup step."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8",
        "action:n9",
        "guard:b4->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the answer is \"No\", then we need a Vendor master record and the process ends."
      ],
      "justification": "Covers the first and textually repeated negative vendor checks, triggering the requirement for a master record and terminating the flow."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10",
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "But if the answer is \"Yes\", then we enter the invoice in SAP."
      ],
      "justification": "Maps the positive vendor verification outcome to the invoice entry step, covering both textual instances."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "And if the answer is \"Yes\" again, then we enter the invoice in SAP."
      ],
      "justification": "Models the final affirmative confirmation and subsequent invoice entry."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the invoice is entered in SAP, we place the entered invoices in the normal Outbox and the process ends."
      ],
      "justification": "Captures the outbox placement step and the final process termination."
    }
  ],
