@startuml
!theme plain
|a_default| Default
|a_default|
start
:trigger resupply cycle;
:check inventory level;
:v1: inventory at or below minimum ({at_or_below_minimum, above_minimum}); <<objectSignal>>
if () then ([v1 = 'at_or_below_minimum'])
:create purchase order;
repeat :;
:review purchase order;
:purchase status approved;
:v2: purchase status approved ({rejected, approved}); <<objectSignal>>
backward:rework purchase order;
repeat while () is ([v2 = 'rejected']) not ([v2 = 'approved'])
:reserve funds;
:send order to supplier;
split
:receive packing slip;
:record packing slip;
:process ends;
stop
split again
:receive invoice;
:record invoice;
:process ends;
stop
end split
else ([v1 = 'above_minimum'])
:process ends;
stop
endif
@enduml