      "verbatim_texts": [
        "The process starts with an informational meeting that lasts half a day"
      ],
      "justification": "Captures the process start and the initial meeting step with the correct duration."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the meeting is successful"
      ],
      "justification": "Models the positive condition for the first decision gate."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "work on the storyboard, which takes a full day"
      ],
      "justification": "Directly corresponds to the storyboard creation step and its specified duration."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "However, if the meeting is not successful"
      ],
      "justification": "Correctly captures the negative branch outcome and the resulting process termination."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Correctly captures the negative branch outcome and the resulting process termination."
    },
    {
      "refs": [
        "guard:b5->b6"
      ],
      "verbatim_texts": [
        "If the storyboard is successful"
      ],
      "justification": "Models the positive condition for the storyboard decision point."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "Accurately splits the workflow into a parallel AND branch for site design and content preparation, both with correct durations."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After that, the site development takes 2 days"
      ],
      "justification": "Direct match for the development phase following the parallel convergence."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the site is built, it goes through a review process that lasts 1 day.",
        "If the review is successful"
      ],
      "justification": "The review action is captured. The review condition is structurally merged with the subsequent approval gateway, preserving the linear flow without altering behaviour."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "moves on to the approval stage, which takes half a day."
      ],
      "justification": "Direct match for the approval stage and its specified duration."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the approval is complete, the process ends."
      ],
      "justification": "Correctly models the positive approval outcome leading to process termination."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
      ],
      "justification": "Correctly models the rejection path and the associated rebuild step with accurate duration."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the rebuild is complete, the process ends."
      ],
      "justification": "Captures the second decision point and its successful completion path."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Accurately captures the repeated rejection condition and the corresponding rebuild step with correct duration."
    }
  ],
