init(i1)
action(n1, "start")
action(n2, "send: Course Packet Information Received")
action(n3, "send: Design to Faculty")
converge(c1)
action(n4, "choose: Faculty chooses the design")
converge(c2)
action(n5, "identify: Content requiring copyright clearance")
action(n6, "contact: Contact publisher for clearance")
branch(b1, XOR)
action(n8, "notify: Contact Faculty to inform of denial and ask if new content should be added")
action(n9, "calculate: Calculate the Course Packet Cost")
action(n10, "add: Add Bookstore margin to determine retail price")
branch(b2, XOR)
action(n12, "reconsider: Re-evaluate content after reconsideration")
action(n13, "notify: Notify bookstore of finalization")
action(n14, "end")
end(e1)
defines(v1, "is copyright cleared?", {"Yes", "No"})
defines(v2, "is price finalized?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, c1, n4, c2, n5, n6, b1, n8, n9, n10, b2, n12, n13, n14, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, c1)
precedence(c1, n4)
precedence(n4, c2)
precedence(c2, n5)
precedence(n5, n6)
precedence(n6, b1)
precedence(b1, n8)
precedence(b1, n9)
precedence(n8, c2)
precedence(n9, n10)
precedence(n10, b2)
precedence(b2, n12)
precedence(b2, n13)
precedence(n12, c1)
precedence(n13, n14)
precedence(n14, e1)
guard(b1, n8, v1 = 'No')
guard(b1, n9, v1 = 'Yes')
guard(b2, n12, v2 = 'No')
guard(b2, n13, v2 = 'Yes')