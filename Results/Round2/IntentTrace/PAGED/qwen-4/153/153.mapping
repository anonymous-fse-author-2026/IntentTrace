  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "Process start node and the two initial actions derived directly from the opening statement."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "First verification step modeled as an action, paired with its decision gateway."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if not"
      ],
      "justification": "Negative condition guarding the continuation path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "continue the process"
      ],
      "justification": "Explicit continuation action when the mailbox is not empty."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Positive condition, termination action, and end node align perfectly."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again"
      ],
      "justification": "Repeated verification step captured as an action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "continue the process"
      ],
      "justification": "Continuation step corresponding to the second check's negative outcome."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Completeness check modeled as an action step with its gateway."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If it is complete"
      ],
      "justification": "Positive guard for the completeness decision."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Direct match for the recording action when information is complete."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is not complete"
      ],
      "justification": "Negative guard for the completeness decision."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "make a telephone call to the sender."
      ],
      "justification": "Direct match for the fallback communication step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Data completion step followed by the convergence point merging the branches."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Every Wednesday evening,"
      ],
      "justification": "Temporal condition re-typed as a check step, preserving scheduling behaviour."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "take the letter book and member register to Miranda."
      ],
      "justification": "Direct match for document transport."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member,"
      ],
      "justification": "Status evaluation and its associated gateway."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Positive guard and corresponding stamping/dating action."
    },
    {
      "refs": [
        "guard:b5->n18"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member,"
      ],
      "justification": "Negative guard for the membership outcome."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "write to them and inform them of the decision."
      ],
      "justification": "Direct match for the rejection notification."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Sequential data-writing step preserved correctly."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Direct match for the registration instruction."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Direct match for card production and delivery."
