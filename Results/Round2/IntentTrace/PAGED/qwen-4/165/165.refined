init(i1)
action(n2, "gather information about the part from the customer (make model year)")
action(n3, "check availability of the part in local inventory")
branch(b1, XOR)
action(n4, "retrieve part from local inventory")
action(n5, "end process")
end(e1)
action(n6, "record customer details")
action(n7, "order part from Disuki")
action(n8, "end process")
end(e2)
defines(v1, "check availability of the part in local inventory", {"Available", "Not Available"})
actor(a_default, "Default", [i1, n2, n3, b1, n4, n5, e1, n6, n7, n8, e2])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, b1)
