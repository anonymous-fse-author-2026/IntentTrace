{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Initiates the process and captures the two opening sequential steps."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Models the condition check and the consequent return action for incomplete invoices."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Captures the complementary path where a complete invoice allows the process to proceed."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Correctly routes non-compliant invoices to the additional checks step."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Routes compliant invoices past the compliance check to continue the flow."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Models the phone-call resolution condition and the corresponding action."
    },
    {
      "refs": [
        "action:n10",
        "guard:b4->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Models the mail-back condition and the subsequent invoice return."
    },
    {
      "refs": [
        "action:n18",
        "action:n19",
        "guard:b8->n20",
        "action:n20",
        "guard:b8->n35",
        "action:n35"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Captures the payment step, evaluates whether the invoice was returned, and applies non-compliance resolution as specified."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Uses an AND gateway to represent parallel/simultaneous execution leading to client billing."
    },
    {
      "refs": [
        "action:n22",
        "guard:b9->n23",
        "action:n23",
        "action:n26",
        "guard:b11->n27",
        "action:n27"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Checks for client response and applies the 10-day wait period. Redundant duplication in the model does not alter the defined behaviour."
    },
    {
      "refs": [
        "action:n24",
        "guard:b10->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If the invoice is returned, non-compliance is resolved."
      ],
      "justification": "Evaluates invoice return status and triggers the resolution of non-compliance."
    },
    {
      "refs": [
        "guard:b9->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Models the successful response path where payment is processed and the client is notified."
    },
    {
      "refs": [
        "action:n29",
        "action:n30"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Captures the reminder dispatch, process termination description, and the corresponding end node."
    },
    {
      "refs": [
        "action:n31",
        "guard:b12->n32",
        "action:n32"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Checks client satisfaction and routes dissatisfaction to discrepancy resolution."
    },
    {
      "refs": [
        "guard:b12->n33",
        "action:n33"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Routes satisfied clients forward, preserving the continuation logic and reaching a terminal state."
    }
  ],
