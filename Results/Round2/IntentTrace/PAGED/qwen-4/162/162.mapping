      "verbatim_texts": [
        "To start, please provide the userdata for flickr."
      ],
      "justification": "Initiates the process and captures the opening action exactly."
    },
    {
      "refs": [
        "action:i2",
        "guard:b2->i2"
      ],
      "verbatim_texts": [
        "please provide the userdata for flickr."
      ],
      "justification": "Captures the first retry prompt and its corresponding decision guard. Modeling the condition as a guarded edge preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->i3",
        "action:i3"
      ],
      "verbatim_texts": [
        "If the login is successful, the process will end."
      ],
      "justification": "Models the positive login outcome, the XOR split, and the resulting termination. Guard value abstracts the success condition appropriately."
    },
    {
      "refs": [
        "guard:b1->i4",
        "action:i4"
      ],
      "verbatim_texts": [
        "However, if the login fails, we will continue with the process. If you want to try again"
      ],
      "justification": "Models the negative login outcome and continuation path. Guard correctly captures the failure branch."
    },
    {
      "refs": [
        "guard:b2->i5",
        "action:i5"
      ],
      "verbatim_texts": [
        "On the other hand, if you choose to abort, the process will end."
      ],
      "justification": "Captures the abort choice and subsequent termination. Guard aligns with the textual condition."
    },
    {
      "refs": [
        "guard:b2->i6",
        "action:i6"
      ],
      "verbatim_texts": [
        "If you still want to try again, please provide the userdata for flickr."
      ],
      "justification": "Opens the second decision point for another retry option and captures the repeated action. Preserves the source's explicit repetition."
    },
    {
      "refs": [
        "guard:b2->i7",
        "action:i7"
      ],
      "verbatim_texts": [
        "Alternatively, if you decide to abort, the process will end."
      ],
      "justification": "Captures the alternative abort condition and termination. Added structural end nodes do not alter behaviour, so they are treated as matches."
    }
