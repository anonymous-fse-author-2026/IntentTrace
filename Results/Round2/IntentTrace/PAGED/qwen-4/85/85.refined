init(i1)
action(n1, "start process for ACME Company")
action(n2, "receive customer request")
action(n3, "check current inventory level")
branch(b1, XOR)
action(n5, "accept customer request")
action(n6, "reject customer request")
action(n7, "end process for rejected request")
end(e1)
action(n8, "create purchase order")
action(n9, "review purchase order")
branch(b2, XOR)
action(n11, "reserve funds")
action(n12, "rework purchase order")
action(n13, "send purchase order")
action(n14, "receive packing slip")
action(n15, "receive invoice")
action(n16, "record packing slip")
action(n17, "record invoice")
action(n18, "release reserved funds and issue payment")
action(n19, "end process")
end(e2)
converge(c1)
branch(b3, AND)
converge(c2)
defines(v1, "inventory level condition", {"at or below minimum", "above minimum"})
defines(v2, "purchase order condition", {"approved", "rejected"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n5, n6, n7, e1, n8, n9, b2, n11, n12, n13, n14, n15, n16, n17, n18, n19, e2, c1, c2, b3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(b1, n6)
precedence(n6, n7)
precedence(n7, e1)
precedence(n5, n8)
precedence(n8, c2)
precedence(c2, n9)
precedence(n9, b2)
precedence(b2, n11)
precedence(b2, n12)
precedence(n12, c2)
precedence(n11, n13)
precedence(n13, b3)
precedence(b3, n14)
precedence(b3, n15)
precedence(n14, n16)
precedence(n15, n17)
precedence(n16, c1)
precedence(n17, c1)
precedence(c1, n18)
precedence(n18, n19)
precedence(n19, e2)
guard(b1, n5, v1 = 'at or below minimum')
guard(b1, n6, v1 = 'above minimum')
guard(b2, n11, v2 = 'approved')
guard(b2, n12, v2 = 'rejected')