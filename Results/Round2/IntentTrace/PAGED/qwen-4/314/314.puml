@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start;
:Identifying the vacancy;
:v1: Any candidates available? ({Yes, No}); <<objectSignal>>
if () then (["v1 = 'No'"])
:Advertise Vacancy;
else (["v1 = 'Yes'"])
:Suitable candidate available;
endif
:v2: Still no suitable candidate? ({Yes, No}); <<objectSignal>>
if () then (["v2 = 'No'"])
:Advertise Again;
else (["v2 = 'Yes'"])
:Select Applicant;
:Once the candidate is appointed;
endif
stop
@enduml