      ],
      "justification": "Models the XOR decision on insurance status with correct routing: yes leads to evaluation, no leads to rejection."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "notify the claimant"
      ],
      "justification": "Handles post-rejection notification and terminates the rejection path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the process comes to an end"
      ],
      "justification": "Handles post-rejection notification and terminates the rejection path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
