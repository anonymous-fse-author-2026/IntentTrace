      ],
      "verbatim_texts": [
        "To begin the process, start by claiming what is requested"
      ],
      "justification": "Captures process initiation, the initial claiming step, and the subsequent status check."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then check the insured status of the claimant"
      ],
      "justification": "Captures process initiation, the initial claiming step, and the subsequent status check."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the claimant is insured"
      ],
      "justification": "Models the XOR decision on insurance status with correct routing: yes leads to evaluation, no leads to rejection."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "proceed to evaluate the claim"
      ],
      "justification": "Models the XOR decision on insurance status with correct routing: yes leads to evaluation, no leads to rejection."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "if the claimant is not insured"
      ],
      "justification": "Models the XOR decision on insurance status with correct routing: yes leads to evaluation, no leads to rejection."
    },
