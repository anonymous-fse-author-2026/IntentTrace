      ],
      "verbatim_texts": [
        "To begin the process, start with Low Inventory."
      ],
      "justification": "Initiates the process and performs the first defined step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, proceed to Create P.R.."
      ],
      "justification": "Direct match to the first Create P.R. step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, move on to Create P.R.,"
      ],
      "justification": "Direct match to the redundant second Create P.R. step; duplication preserves source behaviour."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "followed by Submit P.O.."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the P.O. is submitted, proceed to Ship Material."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "At this point, check if the shipment is okay."
      ],
      "justification": "Models the shipment status check and the subsequent decision split."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed to Send Payment."
      ],
      "justification": "Captures the positive outcome condition and the payment action."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if there are any problems with the shipment, communicate them accordingly."
      ],
      "justification": "Captures the negative outcome condition and communication action."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "After checking the shipment status again, if it is okay, proceed to Send Payment."
      ],
      "justification": "Captures the repeated decision point and its positive outcome path."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Otherwise, communicate any shipment problems."
      ],
      "justification": "Captures the negative outcome path of the repeated check."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, once the payment is sent, the process comes to an end."
      ],
      "justification": "Marks the process termination as explicitly stated."
    }
