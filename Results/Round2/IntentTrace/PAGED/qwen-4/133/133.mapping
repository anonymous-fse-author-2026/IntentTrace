      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the Expense Report process, start by receiving the expense report."
      ],
      "justification": "Initiates the process and models the initial receipt step. Paraphrasing preserves behaviour."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "verify the account"
      ],
      "justification": "Directly models the account verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "review the report"
      ],
      "justification": "Directly models the report review step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the report is accepted"
      ],
      "justification": "Captures the decision split and the positive condition. Abstracting 'accepted' to v1=true preserves the branching logic."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed with processing the reimbursement"
      ],
      "justification": "Models the reimbursement processing action on the accepted path."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "However, if the report is rejected"
      ],
      "justification": "Captures the negative condition for the rejected path. Abstracting 'rejected' to v1=false preserves decision logic."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "send an Expense Rejection Notification"
      ],
      "justification": "Directly models the notification sending step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "and end the process."
      ],
      "justification": "Models termination after rejection. Phrasing the termination as an action alongside the structural end node is a harmless modeling choice that preserves behaviour."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the reimbursement is processed, proceed with the payment"
      ],
      "justification": "Handles the final payment step and subsequent process completion."
    }
  ],
