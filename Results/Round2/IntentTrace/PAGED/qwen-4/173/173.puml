@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process by identifying the vacancy;
:If there is no suitable candidate available;
:advertise the vacancy;
:If there is still no suitable candidate available;
:v1: Suitable Candidate Available ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:advertise the vacancy again;
else ([v1 = 'Yes'])
->;
endif
:select the appropriate applicant;
:appoint the candidate;
:process ends;
stop
@enduml