@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start process;
:Items returned by customer or picked up by delivery crew;
:v1: Items returned by customer or picked up by delivery crew ({Customer returns items to store, Delivery crew picks up items at event site}); <<objectSignal>>
if () then ([v1 = 'Customer returns items to store'])
:Customer returns the items to the store;
else ([v1 = 'Delivery crew picks up items at event site'])
:Delivery Crew picks-up items at the event site;
endif
:Count and compare items to contract;
:v2: Order status after count ({All items returned, Items missing, Items damaged}); <<objectSignal>>
switch ()
case ([v2 = 'All items returned'])
:Items disposition for returned items;
:v3: Items disposition for returned items ({Packed for existing order, Stored for future orders}); <<objectSignal>>
if () then ([v3 = 'Stored for future orders'])
:End process;
stop
else ([v3 = 'Packed for existing order'])
:Items are packed for an existing order;
stop
endif
case ([v2 = 'Items missing'])
:Email customer missing items and replacement charges;
:Customer returns missing items;
:v4: Customer returns missing items ({Customer returns missing items, Customer does not return missing items}); <<objectSignal>>
if () then ([v4 = 'Customer does not return missing items'])
:End process;
else ([v4 = 'Customer returns missing items'])
:Customer returns the missing items;
endif
case ([v2 = 'Items damaged'])
:Email customer damage and additional charges;
:Temporarily remove damaged items from inventory;
:Can damaged items be repaired;
:v5: Can damaged items be repaired ({Can be repaired, Cannot be repaired}); <<objectSignal>>
if () then ([v5 = 'Can be repaired'])
:Items are repaired and added into inventory;
else ([v5 = 'Cannot be repaired'])
:Discard items and email customer replacement charges;
endif
:v6: Items disposition after repair ({Packed for existing order, Stored for future orders}); <<objectSignal>>
if () then ([v6 = 'Stored for future orders'])
:End process;
else ([v6 = 'Packed for existing order'])
:Items are packed for an existing order;
endif
stop
endswitch
@enduml