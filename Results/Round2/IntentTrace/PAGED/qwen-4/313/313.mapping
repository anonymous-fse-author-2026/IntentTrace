{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "Initiates the process and captures the first required registration step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no fee"
      ],
      "justification": "Opens the XOR decision and correctly models the 'no fee' condition on the outgoing edge."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to register a post-seminar request"
      ],
      "justification": "Directly corresponds to the action taken when there is no fee."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if there is a fee"
      ],
      "justification": "Correctly models the alternative 'fee' condition on the other branch edge."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "you need to create a purchase request"
      ],
      "justification": "Direct paraphrase of the step required when a fee exists."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Structural plumbing (action+n end node) faithfully restates the termination condition for the no-fee path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the purchase request has been approved"
      ],
      "justification": "Decision condition modeled as an action step; preserves behaviour without changing logic."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Opens the second XOR split and captures the positive approval condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "you will receive an approved notification"
      ],
      "justification": "Direct match for the outcome of the approved branch."
    },
    {
      "refs": [
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "if the purchase request is rejected"
      ],
      "justification": "Correctly captures the rejection condition on the negative branch."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "you will be notified of the rejection"
      ],
      "justification": "Direct match for the outcome of the rejected branch."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Captures the subsequent registration step triggered by an approved notification."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Structural elements correctly model the process termination upon rejection."
    }
  ],
