  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with Insurance \"emergency\" and then analyze the insurance agreement."
      ],
      "justification": "Initiates the process and captures the first combined action exactly as described."
    },
    {
      "refs": [
        "guard:b1->n2",
        "action:n2"
      ],
      "verbatim_texts": [
        "If there is coverage, offer immediate help."
      ],
      "justification": "Models the positive branch of the coverage decision and the corresponding action."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no coverage, send out an offer for emergency help."
      ],
      "justification": "Models the negative branch of the coverage decision and the corresponding action."
    },
    {
      "refs": [
        "guard:b2->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the offer is rejected, ask for a rejection notification."
      ],
      "justification": "Models the rejection branch and its associated action correctly."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If it is accepted, proceed with internal accounting."
      ],
      "justification": "Models the acceptance branch and its associated action correctly."
    },
    {
      "refs": [
        "guard:b3->c2",
        "guard:b3->n6"
      ],
      "verbatim_texts": [
        "Repeat the same steps if necessary."
      ],
      "justification": "Structural control flow elements (converges, branch, and guards) faithfully capture the optional loop-back behaviour."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The process concludes once all steps have been completed."
      ],
      "justification": "Explicitly models the conclusion step and process termination point as stated in the final unit."
    }
  ],
