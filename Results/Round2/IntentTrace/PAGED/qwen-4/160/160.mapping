{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "Both the start node and the introductory action step correspond to the opening phrase. Redundant modeling of initiation does not change behaviour."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "claiming what is requested"
      ],
      "justification": "Direct match to the first procedural step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then check the insured status of the claimant"
      ],
      "justification": "Direct match to the second procedural step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the claimant",
        "is insured"
      ],
      "justification": "Models the decision point splitting the flow based on insurance status."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "is insured"
      ],
      "justification": "Positive guard condition. Uses variable equality to abstract the text, preserving the decision logic."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed to evaluate the claim"
      ],
      "justification": "Action taken on the positive insurance branch."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "is not insured"
      ],
      "justification": "Negative guard condition for the insurance check."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "reject the claim"
      ],
      "justification": "Action taken on the negative insurance branch."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "notify the claimant and the process comes to an end"
      ],
      "justification": "Covers post-rejection notification and termination. The extra end node is harmless structural plumbing."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the claim is a simple one",
        "or a complex one",
        "send the relevant forms accordingly"
      ],
      "justification": "Combines the conditional context into a single step because both cases lead to the identical action, preserving behaviour."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the forms are returned"
      ],
      "justification": "Models the external return event as an action step, which is a valid behavioural abstraction."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "check them for completeness"
      ],
      "justification": "Direct match to the verification step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided"
      ],
      "justification": "Models the decision point for the completeness check."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided"
      ],
      "justification": "Positive guard condition for completeness. Variable equality preserves the logic."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "proceed to register the claim"
      ],
      "justification": "Action taken when details are complete."
    },
    {
      "refs": [
        "guard:b3->n16"
      ],
      "verbatim_texts": [
        "if not all the relevant details are provided"
      ],
      "justification": "Negative guard condition for completeness."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "inform the claimant to complete them"
      ],
      "justification": "Action taken when details are incomplete."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Once the claim is registered, the process comes to an end"
      ],
      "justification": "Marks successful process termination after registration."
    }
  ],
