  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please provide the userdata for flickr."
      ],
      "justification": "Captures the process start and the initial data provision step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the login is successful, the process will end."
      ],
      "justification": "Models the success branch, guard condition, resulting action, and termination."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the login fails, we will continue with the process."
      ],
      "justification": "Captures the failure guard that routes the flow to continue."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "If you want to try again, please provide the userdata for flickr."
      ],
      "justification": "Models the retry choice and the corresponding userdata action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if you choose to abort, the process will end."
      ],
      "justification": "Models the abort action and process termination."
    },
    {
      "refs": [
        "guard:b4->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If you still want to try again, please provide the userdata for flickr."
      ],
      "justification": "Models the second retry split, guard, and associated action."
    },
    {
      "refs": [
        "guard:b4->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "Alternatively, if you decide to abort, the process will end."
      ],
      "justification": "Models the final abort guard, action, and end node."
    }
  ],
