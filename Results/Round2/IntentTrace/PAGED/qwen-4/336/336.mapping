      "verbatim_texts": [
        "At the start, we receive a form."
      ],
      "justification": "The initial node and first action directly correspond to the opening statement describing process initiation and form receipt."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "we check if it is complete"
