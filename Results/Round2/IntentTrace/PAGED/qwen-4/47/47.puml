@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start Bill for Purchased Goods or Services;
:Receive Invoice;
:Is the invoice complete;
:v1: Is the invoice complete ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:Return invoice;
else ([v1 = 'Yes'])
:Is the invoice compliant;
:v2: Is the invoice compliant ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:Continue process with compliant invoice;
else ([v2 = 'No'])
:Conduct further checks on non-compliant invoice;
:Can issue be resolved with phone call;
:v3: Can issue be resolved with phone call ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:Resolve non-compliance by phone call;
else ([v3 = 'No'])
:Issue requires mail back;
:Return invoice;
endif
endif
endif
:Pay invoice;
:Bill client;
:Did client respond;
:v8: Client status ({No response, Returned, Notified}); <<objectSignal>>
switch ()
case ([v8 = 'No response'])
:Wait period of 10 days;
case ([v8 = 'Returned'])
:Resolve non-compliance;
case ([v8 = 'Notified'])
:Notify client of payment;
:Is client satisfied;
:v9: Is client satisfied ({No, Yes}); <<objectSignal>>
if () then ([v9 = 'No'])
:Resolve payment discrepancy;
else ([v9 = 'Yes'])
:Continue process;
:Send reminder after 10 days;
:End process;
endif
stop
endswitch
@enduml