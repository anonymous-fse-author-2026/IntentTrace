{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "Covers process initiation, placing the order, and checking customer eligibility as described in the opening unit."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Models the XOR decision point, the negative eligibility guard, and the notification action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Captures the positive eligibility guard and the corresponding ERP order creation step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Explicitly models the termination of the ineligible customer path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "perform an availability check."
      ],
      "justification": "Direct match for the availability verification step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\"."
      ],
      "justification": "Represents the decision gateway following the availability check."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "Guard captures unavailability condition and triggers the production step."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process."
      ],
      "justification": "Captures the available path continuation and converges the split flows."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Direct paraphrase of the preparation step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "Correctly models the AND split, three parallel tasks (shipping, invoicing, payment check), and their convergence."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "If the payment is received"
      ],
      "justification": "Sets up the payment status decision and positive guard."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Executes order closure and terminates this successful payment path."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Negative payment guard triggers the reminder action."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Checks reminder count, applies the <3 threshold guard, and allows process continuation."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Guard uses >=3 which is behaviour-preserving for integer counts, informs the lawyer, and terminates the process."
    }
  ],
