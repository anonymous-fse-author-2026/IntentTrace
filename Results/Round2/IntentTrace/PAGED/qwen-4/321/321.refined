defines(v1, "choose what to do after selecting book", {"details", "new_copies", "used_copies"})
defines(v2, "choose what to do after viewing book details", {"new_copies", "select_copy"})
actor(a_default, "Default", [i1, n2, b1, n4, n5, n6, b2, n8, n9, n10, n11, n12, e1, c1])
