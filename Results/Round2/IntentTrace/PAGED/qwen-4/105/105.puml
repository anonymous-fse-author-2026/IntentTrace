@startuml
!theme plain
|a_default| Default
|a_default|
start
:make an appointment at the hairdresser's;
:go to the hairdresser's;
:v_service: service_type ({wash, dye, cut}); <<objectSignal>>
switch ()
case ([v_service = 'wash'])
:wash hair;
case ([v_service = 'dye'])
:dye hair;
case ([v_service = 'cut'])
:cut hair;
endswitch
:pay the hairdresser;
stop
@enduml