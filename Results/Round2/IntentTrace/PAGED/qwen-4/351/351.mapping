    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process."
      ],
      "justification": "Guard captures the positive condition and links to the continuation step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
