      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Implicitly starts the process and executes the affirmative step from the opening conditional."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
