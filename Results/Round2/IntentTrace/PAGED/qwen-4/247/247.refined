init(i1)
end(e1)
action(n1, "Start ONS Bootstrapping process")
action(n2, "Is input a URN?")
action(n3, "Resolve URN to domain-name")
action(n13, "If input is URL, continue")
action(n12, "Check input type again")
action(n4, "Once we have resolved the URN to a domain-name, we send a DNS query")
action(n5, "Get list of URLs from DNS query")
action(n6, "Link to designated DS")
action(n7, "End of process")
branch(b1, XOR)
branch(b2, XOR)
converge(c1)
converge(c2)
defines(v1, "Is input a URN?", {"Yes", "No"})
defines(v2, "Second check decision", {"Loop", "Proceed"})
actor(a_default, "Default", [i1, n1, c2, n2, b1, n3, n13, c1, n12, b2, n4, n5, n6, n7, e1])
precedence(i1, n1)
precedence(n1, c2)
precedence(b2, c2)
precedence(c2, n2)
