{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially, it is important to check the Referee Reports."
      ],
      "justification": "Starts the process and describes the initial check step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "continue to monitor if the Referee Reports have been completed."
      ],
      "justification": "Models the monitoring/checking requirement as an action step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If they have been completed"
      ],
      "justification": "Opens the XOR split and routes the positive condition."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if they have not been completed"
      ],
      "justification": "Routes the negative condition from the first decision."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed with the process."
      ],
      "justification": "Action taken when reports are initially completed."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "flag it and send a reminder."
      ],
      "justification": "Action taken when reports are not yet completed."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check again if the Referee Reports have been completed."
      ],
      "justification": "Second verification step after sending reminder."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If they have"
      ],
      "justification": "Second split and positive routing based on re-check."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Negative routing from the second check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Continuation path after successful re-check."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "flag it again and send another reminder."
      ],
      "justification": "Escalation step when re-check fails."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the Referee Reports have been completed, you can move on to organizing interviews for the Selection Panel with the top candidates."
      ],
      "justification": "Joins divergent flows and proceeds to interview organization."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive feedback from the interview candidates."
      ],
      "justification": "Direct match for post-interview feedback collection."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->n16",
        "action:n16",
        "guard:b5->n17",
        "guard:b5->n19"
      ],
      "verbatim_texts": [
        "check if a Psychometric Test is required. If it is, you should then check if an HR Specialist is required."
      ],
      "justification": "Captures both nested decisions, their checks, and correct Yes/No routing."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If not, you can continue with the process and coordinate the second round of selection."
      ],
      "justification": "Handles the test-not-required branch, coordinates selection, and concludes that path."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required, you should schedule the test with a third party."
      ],
      "justification": "Positive arm of the HR specialist decision."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Otherwise, you can proceed to complete the Psychometric Test."
      ],
      "justification": "Negative arm of the HR specialist decision, rejoins flow afterward."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "request the final candidate ranking"
      ],
      "justification": "Final process step and termination."
    }
  ],
