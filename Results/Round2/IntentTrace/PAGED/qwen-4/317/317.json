  "input_elements": [
    {
      "id": "i1",
      "content": "For Talent Seek: Initially, it is important to check the Referee Reports."
    },
    {
      "id": "i2",
      "content": "continue to monitor if the Referee Reports have been completed."
    },
    {
      "id": "i3",
      "content": "If they have been completed"
    },
    {
      "id": "i4",
      "content": "If they have"
    },
    {
      "id": "i5",
      "content": "proceed with the process."
    },
    {
      "id": "i6",
      "content": "if they have not been completed"
    },
    {
      "id": "i7",
      "content": "flag it and send a reminder."
    },
    {
      "id": "i8",
      "content": "check again if the Referee Reports have been completed."
    },
    {
      "id": "i9",
      "content": "continue with the process."
    },
    {
      "id": "i10",
      "content": "If not"
    },
    {
      "id": "i11",
      "content": "flag it again and send another reminder."
    },
    {
      "id": "i12",
      "content": "Once the Referee Reports have been completed, you can move on to organizing interviews for the Selection Panel with the top candidates."
    },
    {
      "id": "i13",
      "content": "receive feedback from the interview candidates."
    },
    {
      "id": "i14",
      "content": "check if a Psychometric Test is required. If it is, you should then check if an HR Specialist is required."
    },
    {
      "id": "i15",
      "content": "If not, you can continue with the process and coordinate the second round of selection."
    },
    {
      "id": "i16",
      "content": "If an HR Specialist is required, you should schedule the test with a third party."
    },
    {
      "id": "i17",
      "content": "Otherwise, you can proceed to complete the Psychometric Test."
    },
    {
      "id": "i18",
      "content": "request the final candidate ranking"
    }
  ]
