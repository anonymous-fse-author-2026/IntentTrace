@startuml
!theme plain
|a_default| Default
|a_default|
start
:wake up;
:v1: are you hungry? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'No'])
:take a shower;
else ([v1 = 'Yes'])
:have breakfast;
endif
:v2: are you still hungry after breakfast? ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'No'])
:take a shower;
else ([v2 = 'Yes'])
:have breakfast again;
endif
stop
@enduml