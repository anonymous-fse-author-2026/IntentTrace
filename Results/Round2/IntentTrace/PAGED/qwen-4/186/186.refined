init(i1)
action(n1, "Start ICT Logistics Process")
action(n2, "Is initial answer yes")
branch(b1, XOR)
action(n3, "Acquire pricing")
action(n4, "Is second answer yes")
branch(b2, XOR)
action(n5, "Acquire pricing")
action(n6, "Calculate margin")
action(n7, "Prepare offer")
action(n8, "Calculate transport rate")
action(n9, "End Process")
end(e1)
converge(c1)
converge(c2)
defines(v1, "Is initial answer yes", {"yes", "no"})
defines(v2, "Is second answer yes", {"yes", "no"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, b2, n5, n6, n7, n8, n9, e1, c1, c2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c2)
precedence(n4, c2)
precedence(c2, b2)
precedence(b2, n5)
precedence(b2, c1)
precedence(n5, c1)
precedence(c1, n6)
precedence(n6, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, e1)
guard(b1, n3, v1 = 'no')
guard(b1, n4, v1 = 'yes')
guard(b2, n5, v2 = 'no')
guard(b2, c1, v2 = 'yes')