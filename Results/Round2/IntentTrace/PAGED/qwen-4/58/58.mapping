{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "The init node marks the process start, and action n1 faithfully paraphrases the prioritization step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information."
      ],
      "justification": "Direct paraphrase of the customer information check step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer exists, we move on to checking their payment history."
      ],
      "justification": "Captures the decision split, the positive routing condition, and the subsequent payment history check."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "if the customer does not exist, we need to verify their customer status."
      ],
      "justification": "Captures the negative routing condition and the verification step."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->c_merge"
      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process."
      ],
      "justification": "Condition modeled as an action step followed by a branch; the true guard routes to continuation, preserving behaviour."
    },
    {
      "refs": [
        "action:n7",
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Private customer condition modeled as an action/branch pair with correct routing and decline message."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "False branch from previous decision covers the wholesaler case, followed by creation and availability checks."
    },
    {
      "refs": [
        "action:n11",
        "guard:b4->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Availability check, negative routing, production/decline action, and process termination all aligned."
    },
    {
      "refs": [
        "guard:b4->c_merge",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Positive routing for availability combined with the confirmation step."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "AND gateway correctly models simultaneous parallel notification of both departments."
    },
    {
      "refs": [
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Splits the compound step into packing, invoicing, and readiness/sending, preserving sequence and meaning."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Maps order closure and subsequent delivery/invoicing to the corresponding actions."
    },
    {
      "refs": [
        "action:n22",
        "guard:b5->c_remind",
        "action:n23"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Payment receipt condition modeled as action/branch, with true path leading to order closure."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "False path from payment check routes to reminder quantity inspection."
    },
    {
      "refs": [
        "action:n25",
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Threshold check modeled as action/branch, with true path continuing the process."
    },
    {
      "refs": [
        "guard:b6->n27",
        "action:n27"
      ],
      "verbatim_texts": [
        "if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "False path handles the >3 reminders case, triggers donning process, and terminates correctly."
    }
  ],
  "mutations": [],
  "omissions": [],
