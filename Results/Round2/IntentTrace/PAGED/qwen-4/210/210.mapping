{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For the customer, the process begins with a request to purchase a motorcycle."
      ],
      "justification": "Implicitly starts the process and captures the initial purchase request action."
    },
    {
      "refs": [
        "guard:b1->n3",
        "guard:b1->n4",
        "action:n2",
        "action:n3",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the request is received, the next step is to either continue the process if a production order is received or update the sales information and proceed to order dispatch."
      ],
      "justification": "Captures the XOR decision regarding the production order. Modeling conditions as actions or abstract boolean guards preserves the branching behaviour."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier."
      ],
      "justification": "Correctly models the unavailability condition and the subsequent supplier ordering step."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Alternatively, if there are available goods for production, a manufacturing order is placed."
      ],
      "justification": "Captures the alternative availability condition and the manufacturing order placement."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier, the goods are issued and the motorcycles are produced."
      ],
      "justification": "Direct mapping of material receipt, goods issuance, and motorcycle production steps."
    },
    {
      "refs": [
        "guard:b5->n13",
        "guard:b5->n14",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "At the same time, the stock is updated and the motorcycles are dispatched."
      ],
      "justification": "Models simultaneous operations using a split/join structure. Structural re-typing does not alter the described behaviour."
    },
    {
      "refs": [
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "After the goods are issued and the motorcycles are produced, the stock is updated and the process ends."
      ],
      "justification": "Captures the final stock update step and process termination."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, the stock is updated and the sales information is updated."
      ],
      "justification": "Captures the sales information update. The redundant stock update mentioned in the source is already covered earlier in the process and its omission here does not change behaviour."
    }
  ],
