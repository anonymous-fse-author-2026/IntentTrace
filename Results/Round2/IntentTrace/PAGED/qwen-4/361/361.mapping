{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle."
      ],
      "justification": "Captures the process initialization and the first operational step. 'start' is a harmless structural restatement."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, check the current inventory level."
      ],
      "justification": "Direct match for the inventory verification step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "label:b1->n4",
        "action:n4",
        "guard:b1->n5",
        "label:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory level is above the minimum, then the process ends. However, if the inventory level is below the minimum, create a purchase order."
      ],
      "justification": "Accurately models the XOR split, both conditional branches with their guards/labels, the corresponding actions, and the early termination path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the purchase order is created, review it."
      ],
      "justification": "Direct match for the initial purchase order review."
    },
    {
      "refs": [
        "guard:b2->n7",
        "label:b2->n7",
        "action:n7",
        "guard:b2->c1",
        "label:b2->c1"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order. But if the purchase order is accepted, continue the process."
      ],
      "justification": "Correctly captures the approval split, the rework path on rejection, the continuation path on acceptance, and the subsequent join."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, review it again."
      ],
      "justification": "Direct match for the second review step following rework."
    },
    {
      "refs": [
        "label:b3->n9",
        "action:n9",
        "label:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: reserve funds for the purchase and send the purchase order to the supplier."
      ],
      "justification": "Models the parallel AND gateway for concurrent steps. Actions n9 and n12 redundantly split/restated the tasks, which preserves behaviour without introducing defects."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, release the reserved funds and then the process ends."
      ],
      "justification": "Covers the receipt of the slip, fund release, and final process termination."
    }
  ],
