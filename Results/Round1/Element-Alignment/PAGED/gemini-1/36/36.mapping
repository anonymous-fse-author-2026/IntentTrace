    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check if the applicant wishes to discuss the terms and conditions"
      ],
      "justification": "Matches the action step evaluating the condition and the implied XOR decision branch."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\""
      ],
      "justification": "Directly maps to the positive condition path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to discuss the terms and conditions with the candidate"
      ],
      "justification": "Direct paraphrase of the action step."
    },
    {
      "refs": [
        "guard:b1->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Matches the negative condition path and the corresponding continuation action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "continue with the process"
      ],
      "justification": "Exact match for the continuation action step on the positive path of the acceptable changes check."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "check if the applicant wants to modify the terms and conditions"
      ],
      "justification": "Direct paraphrase of the action step evaluating the modification condition, and implies paths rejoining before this check."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "check if the change is within the set client limits"
      ],
      "justification": "Matches the evaluation step and its corresponding decision branch."
    },
    {
      "refs": [
        "guard:b3->n6"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Direct match for the negative guard condition."
    },
    {
      "refs": [
        "guard:b3->n7"
      ],
      "verbatim_texts": [
        "If it is within the limits"
      ],
      "justification": "Direct match for the positive guard condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
