@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:Examine Order;
:Is Order Rejected?;
:v1: Is Order Rejected? ({Yes, No}); <<objectSignal>>
if () then ([v1=="Yes"])
:Reject Order;
else ([v1=="No"])
:Accept Order;
endif
split
:Prepare Assembling Order;
split again
:Check Availability;
end split
:Is Backorder Required?;
:v2: Is Backorder Required? ({Yes, No}); <<objectSignal>>
if () then ([v2=="Yes"])
:Check Availability Again;
:End;
stop
else ([v2=="No"])
:Reserve Item;
:Assemble Bike;
:Ship Product;
stop
endif
@enduml