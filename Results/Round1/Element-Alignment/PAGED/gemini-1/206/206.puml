@startuml
!theme plain
|a_default| Default
|a_default|
start
:start reviewing incoming CV;
:decide whether to send a negative email or invite candidate;
:v1: decide whether to send a negative email or invite candidate ({negative, invite}); <<objectSignal>>
if () then ([v1 = "negative"])
:send negative email and end process;
else ([v1 = "invite"])
:schedule interview with candidate;
:conduct interview;
endif
:Process ends after interview;
stop
@enduml