@startuml
!theme plain
|a_default| Default
|a_default|
start
:start process;
:Select filter;
:Apply filter;
:Click Submit button;
:Is submit option false;
:v1: Is submit option false ({false, true}); <<objectSignal>>
if () then ([v1 = 'false'])
:Apply another filter;
else ([v1 = 'true'])
->;
endif
:Is there another filter to apply;
:v2: Is there another filter to apply ({yes, no}); <<objectSignal>>
if () then ([v2 = 'yes'])
:continue with the process;
else ([v2 = 'no'])
->;
endif
:Is submit option true;
:v3: Is submit option true ({true, false}); <<objectSignal>>
if () then ([v3 = 'true'])
:continue with the process;
else ([v3 = 'false'])
->;
endif
:End;
stop
@enduml