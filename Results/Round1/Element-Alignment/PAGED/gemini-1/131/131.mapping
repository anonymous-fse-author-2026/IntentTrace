      "verbatim_texts": [
        "Check if the mailbox is empty again, if not, continue the process. If it is empty, the process ends."
      ],
      "justification": "Captures the repeated check, its conditions, and the termination on the positive path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Captures the completeness check and its corresponding split."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If it is complete,"
      ],
      "justification": "Captures the complete condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Direct paraphrase of adding the mail details."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If it is not complete,"
      ],
      "justification": "Captures the incomplete condition."
    },
    {
