{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process, start by receiving the order."
      ],
      "justification": "Implicitly starts the process and describes the receiving action."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: check the order and check the customer."
      ],
      "justification": "Describes the parallel split and the two concurrent check actions."
    },
    {
      "refs": [
        "guard:b1->c1",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the order is okay"
      ],
      "justification": "Initiates the branch, provides the positive guard, and maps to the condition check action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the customer is not permitted"
      ],
      "justification": "Initiates the XOR branch, provides the negative guard, and maps to the condition check action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "send a refusal"
      ],
      "justification": "Direct paraphrase of the refusal step."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "However, if the customer is permitted",
        "If the customer is permitted"
      ],
      "justification": "Provides the positive condition guard for a permitted customer."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "send a refusal and end the process."
      ],
      "justification": "Perfectly covers the refusal action, the explicit end action, and the structural end node."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the order is not okay"
      ],
      "justification": "Provides the negative guard for the order check."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Release the order and then transfer the data in the database."
      ],
      "justification": "Directly maps to the release and transfer actions."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n12"
      ],
      "verbatim_texts": [
        "If it is greater than 10.000 \u20ac"
      ],
      "justification": "Initiates the branch, provides the positive guard, and maps the threshold to the condition action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "sign off on the order."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Maps to the negative guard and the continuation action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Sign off on the order and forward it to production."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: check the product quality, start production, and produce the product."
      ],
      "justification": "Maps to the parallel split and the three concurrent production steps."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "create a material report."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "send it to the warehouse."
      ],
      "justification": "Direct paraphrase resolving the pronoun to the material report."
    },
    {
      "refs": [
        "action:n22",
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "At the same time, create a quality report, send the product to shipment, and send the order to accounting."
      ],
      "justification": "Maps to the parallel split and the three concurrent reporting and dispatch actions."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Maps to the end action and the corresponding structural end node."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "send it to Finance."
      ],
      "justification": "Direct paraphrase resolving the pronoun to the quality report."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Ship the product and send the invoice."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "Archive the report"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "Check the payment."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "guard:b4->n31",
        "action:n30"
      ],
      "verbatim_texts": [
        "If the payment is received"
      ],
      "justification": "Initiates the branch, provides the positive guard, and maps to the conditional check action."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "close the order."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "guard:b4->n32",
        "action:n32"
      ],
      "verbatim_texts": [
        "If the payment is not received, check if a reminder has been sent more than three times."
      ],
      "justification": "Provides the negative guard for payment, initiates the reminder branch, and maps to the reminder condition action."
    },
    {
      "refs": [
        "guard:b5->n33",
        "action:n33"
      ],
      "verbatim_texts": [
        "If a reminder has been sent more than three times, acquire a lawyer."
      ],
      "justification": "Provides the positive guard and maps to the acquire lawyer action."
    },
    {
      "refs": [
        "guard:b5->n34",
        "action:n34"
      ],
      "verbatim_texts": [
        "Otherwise, send a reminder."
      ],
      "justification": "Provides the negative guard and maps to the reminder action."
    }
  ],
  "mutations": [
    {
      "refs": [
        "action:n35"
      ],
      "verbatim_texts": [
        "Acquire a lawyer and complete the court proceedings."
      ],
      "reason": "The element implements only the 'complete the court proceedings' portion, dropping the 'Acquire a lawyer' instruction stated in this unit."
    },
    {
      "refs": [
        "action:n36"
      ],
      "verbatim_texts": [
        "Send a reminder and then send the reminder."
      ],
      "reason": "The element implements only a single 'send a reminder' action, explicitly dropping the second reminder step mandated by the source text."
    },
    {
      "refs": [
        "action:n37"
      ],
      "verbatim_texts": [
        "Close the order and end the process."
      ],
      "reason": "The element implements only the 'end process' portion, entirely dropping the 'Close the order' instruction from this segment."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "In this case, send a refusal and end the process."
      ],
      "reason": "The model completely omits this refusal and termination path for a permitted customer, moving straight to releasing the order instead."
    },
    {
      "verbatim_texts": [
        "end the process."
      ],
      "reason": "This standalone termination step is not faithfully implemented by any action element."
    },
    {
      "verbatim_texts": [
        "check the worth of the order"
      ],
      "reason": "While the threshold condition is modeled, the explicit action to 'check the worth' is missing."
    }
  ],
  "additions": [
    {
      "refs": [
        "action:n9"
      ],
      "reason": "This 'end process' action is placed on the negative customer path, but the source explicitly limits that path to 'send a refusal' without an end instruction."
    },
    {
      "refs": [
        "action:n28"
      ],
      "reason": "There is no supporting input text element for an explicit 'end process' action following the report archiving step."
    }
  ],
