@startuml
!theme plain
|a_default| Default
|a_default|
start
:start WIGGO process;
:Place Order;
:Check Customers Credit Limit;
:Credit Limit Okay;
:v1: Credit Limit Okay ({No, Okay}); <<objectSignal>>
if () then ([v1 = 'No'])
:Send Denial To Customer;
stop
else ([v1 = 'Okay'])
:Check Availability Of Article;
:v5: First Availability ({Okay, No}); <<objectSignal>>
if () then ([v5 = 'Okay'])
:Check Availability Of Article;
:Article Available;
:v2: Article Available ({No, Yes}); <<objectSignal>>
if () then ([v2 = 'No'])
:Produce the Goods;
else ([v2 = 'Yes'])
:Collect the Goods;
endif
:Send Order Confirmation;
split
:Ship the Goods;
split again
:Send Invoice;
end split
:Check Payment Status;
:Payment Received;
:v3: Payment Received ({has been received, has not been received}); <<objectSignal>>
if () then ([v3 = 'has been received'])
:Close the Order;
:End;
stop
else ([v3 = 'has not been received'])
:Reminder Count Ge 3;
:v4: Reminder Count ({[0-]}); <<objectSignal>>
if () then ([v4 >= 3])
:Write Off the Order;
else ([v4 < 3])
->;
endif
:Send Reminder;
:Close the Order;
:End;
stop
endif
else ([v5 = 'No'])
:Send Denial To Customer;
stop
endif
endif
@enduml