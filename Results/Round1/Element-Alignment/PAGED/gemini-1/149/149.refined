init(i1)
action(n1, "Request to Purchase Motorcycle")
action(n2, "Production Order Received?")
branch(b1, XOR)
action(n3, "Continue with Production Order")
action(n4, "Update Sales Information and Proceed to Dispatch")
action(n5, "Check Material Availability")
branch(b2, XOR)
action(n6, "Order Materials from Supplier")
action(n_mfg, "Place Manufacturing Order")
action(n7, "Receive Materials from Supplier")
action(n8, "Issue Goods and Produce Motorcycles")
branch(b3, AND)
action(n9, "Update Stock Information")
action(n10, "Dispatch Motorcycles")
action(n12, "Update Sales Information")
action(n11, "End of Process")
end(e1)
converge(c1)
converge(c2)
converge(c3)
defines(v1, "Production Order Received?", {"Yes", "No"})
defines(v2, "Check Material Availability", {"Unavailable", "Available"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, b2, n6, n_mfg, n7, n8, b3, n9, n10, n12, n11, e1, c1, c2, c3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, c1)
precedence(c1, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n_mfg)
precedence(n6, n7)
precedence(n7, c2)
precedence(n_mfg, c2)
precedence(c2, n8)
precedence(n8, b3)
precedence(b3, n9)
precedence(b3, n10)
precedence(b3, n12)
precedence(n9, c3)
precedence(n10, c3)
precedence(n12, c3)
precedence(c3, n11)
precedence(n11, e1)
guard(b1, n3, v1 == "Yes")
guard(b1, n4, v1 == "No")
guard(b2, n6, v2 == "Unavailable")
guard(b2, n_mfg, v2 == "Available")