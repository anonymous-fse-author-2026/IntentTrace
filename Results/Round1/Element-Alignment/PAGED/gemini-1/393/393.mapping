    {
      "refs": [
        "action:n9",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "they may not authorize the form"
      ],
      "reason": "The source text states the external manager 'may not authorize' the form, indicating a possibility of failure, but the model incorrectly mutates this into an unconditional 'approve form' action on the true branch of the external resource condition."
    }
  ],
