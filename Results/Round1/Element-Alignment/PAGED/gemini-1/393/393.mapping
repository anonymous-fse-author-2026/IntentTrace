      "refs": [
        "action:n1"
      ],
      "reason": "The source text announces the process starts but does not describe an explicit action step to 'start', which the model incorrectly requires."
    },
    {
      "refs": [
        "guard:b8->c4"
      ],
      "reason": "The model invents an 'abort' option on candidate acceptance, which is entirely unsupported by the source text."
    }
  ],
