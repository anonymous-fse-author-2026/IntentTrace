@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process by sending appointment approval form;
:receive the approval;
split
:contact TS to clarify the timing;
split again
:check the approval;
:is resource internal or external;
:v1: is resource internal or external ({Internal, External}); <<objectSignal>>
if () then ([v1 == "Internal"])
:authorize appointment for internal resource;
else ([v1 == "External"])
:authorize appointment for external resource;
endif
end split
:send mandatory documentation and approval to HR services;
:scan form and record into GovSource system;
:check the approval again before sending to HR services;
:send approval and mandatory documentation to HR services;
:does HR services receive the documentation;
:v2: does HR services receive the documentation ({Yes, No}); <<objectSignal>>
if () then ([v2 == "Yes"])
:no variations present;
:process continues;
:is there any variation again;
:v5: is there any variation again ({Yes, No}); <<objectSignal>>
if () then ([v5 == "No"])
:continue process if no variation;
else ([v5 == "Yes"])
:complete business case and attach;
endif
else ([v2 == "No"])
:variations present;
:complete business case;
endif
:end of process;
stop
@enduml