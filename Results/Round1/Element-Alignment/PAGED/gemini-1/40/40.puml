@startuml
!theme plain
|a_default| Default
|a_default|
start
:receive the invoice;
:check for mismatches;
:does the invoice need to be re-sent  posted  or blocked?;
:v1: does the invoice need to be re-sent  posted  or blocked? ({re-send, post, block}); <<objectSignal>>
switch ()
case ([v1 == "re-send"])
:re-send the invoice;
case ([v1 == "post"])
:post the invoice;
case ([v1 == "block"])
:block the invoice;
endswitch
:park the invoice;
stop
@enduml