    {
      "id": "i1",
      "content": "To start the ExpenseReport process"
    },
    {
      "id": "i2",
      "content": "begin by clicking on \"Start\""
    },
    {
      "id": "i3",
      "content": "and then selecting \"Edit Report\""
    },
    {
      "id": "i4",
      "content": "If the expense is greater than 1000"
    },
    {
      "id": "i5",
      "content": "the report should be reviewed"
    },
    {
      "id": "i6",
      "content": "if the expense is less than or equal to 1000"
    },
    {
      "id": "i7",
      "content": "check if there is a need for translation"
    },
    {
      "id": "i8",
      "content": "If translation is required"
    },
    {
      "id": "i9",
      "content": "translate the receipts"
    },
    {
      "id": "i10",
      "content": "If not"
    },
    {
      "id": "i11",
      "content": "confirm the receipts"
    },
    {
      "id": "i12",
      "content": "evaluate the review decision"
    },
    {
      "id": "i13",
      "content": "If the report is rejected"
    },
    {
      "id": "i14",
      "content": "edit the report"
    },
    {
      "id": "i15",
      "content": "If it is approved"
    },
    {
      "id": "i16",
      "content": "Once again, evaluate the review decision. If the report is rejected, edit the report. If it is approved,"
    },
    {
      "id": "i17",
      "content": "and then confirm them"
    },
    {
      "id": "i18",
      "content": "evaluate the receipts decision"
    },
    {
      "id": "i19",
      "content": "If the receipts are accepted"
    },
    {
      "id": "i20",
      "content": "process the expense"
    },
    {
      "id": "i21",
      "content": "If they are rejected"
    },
    {
      "id": "i22",
      "content": "ending it"
    }
