init(i1)
action(n1, "Start process")
action(n2, "Items returned by customer or picked up by delivery crew")
branch(b1, XOR)
action(n_b1_1, "Customer returns the items to the store")
action(n_b1_2, "Delivery crew picks up items at event site")
converge(c_b1)
action(n3, "Count and compare items to contract")
action(n4, "Order status after count")
branch(b2, XOR)
action(n5, "Items disposition for returned items")
branch(b3, XOR)
action(n_b3_1, "Items are packed for an existing order")
action(n_b3_2, "Stored for future orders")
converge(c_b3)
action(n15, "End process")
end(e2)
action(n6, "Email customer missing items and replacement charges")
action(n7, "Customer returns missing items")
branch(b4, XOR)
action(n_b4_1, "Customer returns the missing items")
action(n_b4_2, "Customer does not return missing items")
converge(c_b4)
action(n8, "End process")
end(e1)
action(n9, "Email customer damage and additional charges")
action(n10, "Temporarily remove damaged items from inventory")
action(n11, "Can damaged items be repaired")
branch(b5, XOR)
action(n12, "Repair items and add to inventory")
action(n13, "Discard items and email customer replacement charges")
converge(c1)
action(n14, "Items disposition after repair")
branch(b6, XOR)
action(n_b6_1, "Items are packed for an existing order")
action(n_b6_2, "Stored for future orders")
converge(c_b6)
action(n16, "End process")
action(n17, "The customer is then emailed with replacement charges")
end(e3)
