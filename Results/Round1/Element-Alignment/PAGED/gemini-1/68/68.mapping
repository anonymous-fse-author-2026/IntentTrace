{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "The text explicitly states the start of the process, justifying both the init node and the start action."
    },
    {
      "refs": [
        "action:n_b1_1",
        "guard:b1->n_b1_1"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\""
      ],
      "justification": "Establishes the XOR branch, the action, and the condition guard directly mirroring the text."
    },
    {
      "refs": [
        "action:n_b1_2",
        "guard:b1->n_b1_2"
      ],
      "verbatim_texts": [
        "However, if the \"Delivery Crew picks-up items at the event site,\""
      ],
      "justification": "Matches the negative arm's condition and action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "items are counted and compared to the original contract"
      ],
      "justification": "The counting step explicitly follows the initial conditions, implying convergence and matching the counting action."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\""
      ],
      "justification": "Establishes the branch for checking the order status."
    },
    {
      "refs": [
        "action:n_b3_1",
        "guard:b3->n_b3_1"
      ],
      "verbatim_texts": [
        "if the \"Items are packed for an existing order,\""
      ],
      "justification": "Matches the branch, guard, and action for the packed items condition."
    },
    {
      "refs": [
        "action:n_b3_2",
        "guard:b3->n_b3_2"
      ],
      "verbatim_texts": [
        "Alternatively, if the \"Items are stored for future orders,\""
      ],
      "justification": "Matches the stored condition and action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Matches the explicit ending of the process and implicit convergence."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "missing items and replacement charges, we email the customer to inform them"
      ],
      "justification": "Matches the action of emailing about missing items and charges."
    },
    {
      "refs": [
        "action:n_b4_1",
        "guard:b4->n_b4_1"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "Matches the branch, action, and guard for returning missing items."
    },
    {
      "refs": [
        "action:n_b4_2",
        "guard:b4->n_b4_2"
      ],
      "verbatim_texts": [
        "However, if the \"Customer does not return the missing items,\""
      ],
      "justification": "Matches the negative condition and action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Matches the explicit process end and implicit convergence."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Matches the action to email regarding damages."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "we temporarily take them out of inventory"
      ],
      "justification": "Matches taking items out of inventory temporarily."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\""
      ],
      "justification": "Establishes the branch for repairing items."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Items are repaired and added into inventory"
      ],
      "justification": "Matches the repair action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Items can't be repaired and are discarded,\" we email the customer with replacement charges"
      ],
      "justification": "Matches discarding and emailing charges."
    },
    {
      "refs": [
        "action:n_b6_1",
        "guard:b6->n_b6_1"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\""
      ],
      "justification": "Establishes convergence of the previous branch, the new XOR branch, the action, and the condition guard."
    },
    {
      "refs": [
        "action:n_b6_2",
        "guard:b6->n_b6_2"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\""
      ],
      "justification": "Matches the negative arm's condition and action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "the process is complete."
      ],
      "justification": "Matches the explicit end of the process and convergence."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges"
      ],
      "justification": "Matches the emailing of replacement charges."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\""
      ],
      "reason": "The model's guard condition 'All items returned' drops the 'Order is complete' qualifier present in the text."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "However, if the \"Order is incomplete and items are missing,\""
      ],
      "reason": "The model's guard condition 'Items missing' omits the 'Order is incomplete' clause present in the text."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "Similarly, if the \"Order is complete but items are damaged,\""
      ],
      "reason": "The model's guard condition 'Items damaged' omits the 'Order is complete' clause from the source."
    },
    {
      "refs": [
        "guard:b5->n12"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\""
      ],
      "reason": "The guard logic 'Can be repaired' shifts the meaning from an accomplished state ('are repaired') to a possibility, and drops the 'added into inventory' condition."
    },
    {
      "refs": [
        "guard:b5->n13"
      ],
      "verbatim_texts": [
        "On the other hand, if the \"Items can't be repaired and are discarded,\""
      ],
      "reason": "The guard condition 'Cannot be repaired' drops the 'and are discarded' outcome present in the text."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "Rental Items are Returned to the Store"
      ],
      "reason": "No element faithfully implements this specific task; the model instead invents a separate combined node for receiving items."
    }
  ],
  "additions": [
