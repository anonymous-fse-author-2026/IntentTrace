      "verbatim_texts": [
        "Initially, there is a User Task."
      ],
      "justification": "Implicitly starts the process and explicitly describes the initial user task action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the task is \"Service Task 1\","
      ],
      "justification": "Captures the XOR branch, the condition evaluated as an action step, and its positive logic guard."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the process should continue."
      ],
      "justification": "Direct paraphrase of the process continuation step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4",
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If it is \"Service Task 2\","
      ],
      "justification": "Captures the XOR branch, the condition modeled as an action, the incoming negative path from the previous check, and the positive guard."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the process should also continue."
      ],
      "justification": "Direct paraphrase of the continuation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if it is \"Service Task 3\", then the process will come to an end."
      ],
      "justification": "The action and end node faithfully represent the ending outcome described for the third service task."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After that,"
      ],
      "justification": "Implies the reconvening of the continuation paths before moving to the final checks."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n9",
        "guard:b3->e3"
      ],
      "verbatim_texts": [
        "if there is a Manual Task,"
      ],
      "justification": "Describes the XOR decision, the condition action, and both the positive and implicit negative guards."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the process will end."
      ],
      "justification": "Direct paraphrase of the ending steps for both the positive and negative outcomes of the final condition."
    }
  ],
