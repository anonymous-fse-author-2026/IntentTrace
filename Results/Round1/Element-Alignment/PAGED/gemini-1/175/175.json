  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process,"
    },
    {
      "id": "i2",
      "content": "Rental Items are Returned to the Store."
    },
    {
      "id": "i3",
      "content": "If the \"Customer returns the items to the store,\""
    },
    {
      "id": "i4",
      "content": "Delivery Crew picks-up items at the event site,"
    },
    {
      "id": "i5",
      "content": "During this step, the items are counted and compared to the original contract."
    },
    {
      "id": "i6",
      "content": "If the \"Order is complete and all items were returned,\""
    },
    {
      "id": "i7",
      "content": "if the \"Order is incomplete and items are missing,\""
    },
    {
      "id": "i8",
      "content": "email the customer to inform them of the damage and additional charges"
    },
    {
      "id": "i9",
      "content": "if the \"Items are packed for an existing order,\""
    },
    {
      "id": "i10",
      "content": "if the \"Items are stored for future orders,\""
    },
    {
      "id": "i11",
      "content": "In case of missing items and replacement charges, we email the customer to inform them."
    },
    {
      "id": "i12",
      "content": "temporarily take them out of inventory."
    },
    {
      "id": "i13",
      "content": "If the \"Customer returns the missing items,\""
    },
    {
      "id": "i14",
      "content": "if the \"Customer does not return the missing items,\""
    },
    {
      "id": "i15",
      "content": "when the process is complete, it ends."
    },
    {
      "id": "i16",
      "content": "If the \"Items are repaired and added into inventory,\""
    },
    {
      "id": "i17",
      "content": "if the \"Items can't be repaired and are discarded,\""
    },
    {
      "id": "i18",
      "content": "we email the customer with replacement charges."
    },
    {
      "id": "i19",
      "content": "Lastly, the items are packed for an existing order. If the \"Items are packed for an existing order,\""
    },
    {
      "id": "i20",
      "content": "If the \"Items are stored for future orders,\""
    },
    {
      "id": "i21",
      "content": "Once again, when the process is complete, it ends."
    },
    {
      "id": "i22",
      "content": "and the process is complete."
    }
  ]
