  "mutations": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check the customer"
      ],
      "reason": "The model changes 'check the customer' to 'check customer eligibility', adding an unsupported qualifier."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "inform them"
      ],
      "reason": "The model alters 'inform them' to 'inform customer not eligible', introducing invented qualifiers."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "send a reminder"
      ],
      "reason": "The model adds the word 'payment' which is not present in the source text."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3"
      ],
      "reason": "The model converts the condition into an action step but improperly alters 'number of reminders' to 'reminders sent count'."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Otherwise, if the payment is not received, send a reminder"
      ],
      "reason": "The model adds the qualifiers 'another payment' to the reminder, improperly expanding the instruction."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "check the customer"
      ],
      "reason": "The action to check the customer was modeled with an added, invented qualifier, leaving the original step faithfully unfulfilled."
    },
    {
      "verbatim_texts": [
        "inform them"
      ],
      "reason": "The instruction to inform them was altered with invented qualifiers, failing to exactly reproduce the source."
    },
    {
      "verbatim_texts": [
        "send a reminder"
      ],
      "reason": "The step is only implemented with an unsupported 'payment' qualifier, meaning the exact literal step is missing."
    },
    {
      "verbatim_texts": [
        "Otherwise, if the payment is not received, send a reminder"
      ],
      "reason": "While the condition is modeled correctly, the actual action to send a reminder is mutated with 'another payment', leaving the action behavior faithfully uncovered."
    }
  ],
  "additions": [
    {
      "refs": [
        "guard:b1->n5"
      ],
      "reason": "The positive guard condition 'eligible to order' lacks text support in the provided segmented source units."
    },
    {
      "refs": [
        "guard:b4->c6"
      ],
      "reason": "The guard condition 'equal to 3' has no corresponding text in the segmented source units."
    }
  ],
