@startuml
!theme plain
|a_default| Default
|a_default|
start
:start procedure;
:choose a book;
:do you want to view book details;
:v2: do you want to view book details ({yes, no}); <<objectSignal>>
if () then ([v2 == "yes"])
:view: book details;
:do you want to select a copy or view new copies?;
:v1: do you want to select a copy or view new copies? ({select, new}); <<objectSignal>>
if () then ([v1 == "select"])
:select a copy;
:end procedure;
stop
else ([v1 == "new"])
:view: new copies;
endif
else ([v2 == "no"])
:view: used copies;
endif
:evaluate and select a copy from the list;
:end procedure;
stop
@enduml