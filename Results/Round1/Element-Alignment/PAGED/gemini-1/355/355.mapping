  "mutations": [
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If they are a new customer,"
      ],
      "reason": "The source specifies explicitly checking if they are a 'new customer', but the model implements this as a generic negative branch ('v1 = No') mapping back to the 'is customer registered' decision, altering the explicit semantic value evaluated."
    },
    {
      "refs": [
        "guard:b4->n15"
      ],
      "verbatim_texts": [
        "If the items are out of stock,"
      ],
      "reason": "The source explicitly states to check if items are 'out of stock', but the model implements this as a negative branch ('v4 = No') derived from an 'are items in stock' decision, altering the explicit condition logic."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "Check the payment status."
      ],
      "reason": "The explicit action instructing to check the payment status is missing. The model jumps straight to the subsequent condition evaluation without performing the instructed check step."
    },
    {
      "verbatim_texts": [
        "check the number of reminders."
      ],
      "reason": "The explicit action instructing to check the number of reminders is completely omitted. Only the subsequent evaluation conditional was modeled."
    }
  ],
  "additions": [
    {
      "refs": [
        "action:n1"
      ],
      "reason": "The action 'start process' is an invented execution step; the source uses an introductory dependent clause 'To begin the process' but does not instruct a distinct action step for starting."
    },
    {
      "refs": [
        "action:n7"
      ],
      "reason": "The explicit condition-evaluating action 'check customer type' is an invented step; the source natively evaluates the conditional clauses without a preceding generalized checking step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "reason": "The action 'continue with process' lacks corresponding source text in the provided input segments for the positive path regarding stock availability."
    },
    {
      "refs": [
        "guard:b10->c5"
      ],
      "reason": "The negative guard for when production is not started ('v7 = No') is invented and lacks any textual support; the text only addresses the positive path."
    }
  ],
