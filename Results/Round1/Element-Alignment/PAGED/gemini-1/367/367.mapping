{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME,"
      ],
      "justification": "The opening clause implicitly starts the process and explicitly matches the start action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin with the New Resupply Cycle"
      ],
      "justification": "Direct paraphrase of initiating the new resupply cycle."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then Check Levels of Inventory."
      ],
      "justification": "Direct paraphrase of the inventory check action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "The conditional clause opens the XOR branch, and the action faithfully models the condition checking step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "Captures the action to create purchase orders."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Matches the explicit end process action and the structural end node."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "The conditional captures the XOR split and directly justifies the rework action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Direct paraphrase of the approval sequence."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed. If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "The first sentence directly justifies the action to review the PO."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "The word 'Simultaneously' justifies the AND branch, and the text describes the two parallel actions."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n17",
        "action:n18",
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match. If the Three-way match is successful, release the funds. Once the funds are released, issue the payment. After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "This multi-step sequence maps perfectly to the corresponding final actions and the final process end node."
    }
  ],
