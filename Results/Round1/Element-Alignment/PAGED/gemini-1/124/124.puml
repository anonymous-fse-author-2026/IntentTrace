!theme plain
|a_default| Default
|a_default|
start
:look at the order;
:order rejected?;
:v1: order rejected? ({Accepted, Rejected}); <<objectSignal>>
if () then ([v1 = 'Rejected'])
:the process should continue;
else ([v1 = 'Accepted'])
->;
endif
split
:prepare assembling order;
split again
:check availability;
end split
:backorder?;
:v2: backorder? ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:check availability again;
:end;
stop
else ([v2 = 'No'])
:assemble bike;
:ship product;
stop
endif
