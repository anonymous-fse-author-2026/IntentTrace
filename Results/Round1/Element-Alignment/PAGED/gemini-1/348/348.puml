@startuml
!theme plain
|a_default| Default
|a_default|
start
:Bill for Purchased Goods/Services;
:Bill Client;
split
:Receive Invoice;
split
:Is Invoice Complete?;
:v1: Is Invoice Complete? ({Incomplete, Complete}); <<objectSignal>>
if () then ([v1 = 'Incomplete'])
:Return Invoice: Incomplete;
stop
else ([v1 = 'Complete'])
:Is Invoice Compliant?;
:Further checks are conducted;
:v2: Issue Resolution ({Phone Call, Mail Back}); <<objectSignal>>
if () then ([v2 = 'Phone Call'])
:Resolve Non-Compliance via Phone;
:Resolve Compliance Issue;
:Pay Invoice;
stop
else ([v2 = 'Mail Back'])
:Return Invoice via Mail;
stop
endif
endif
split again
:Wait for 10 Days;
:Send Reminder;
:Client Notified of Payment;
split
stop
split again
:Check Client Satisfaction;
:v3: Check Client Satisfaction ({Unsatisfied, Satisfied}); <<objectSignal>>
if () then ([v3 = 'Unsatisfied'])
:Resolve Payment Discrepancy;
stop
else ([v3 = 'Satisfied'])
:Continue Process;
stop
endif
end split
end split
split again
stop
end split
@enduml