{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "The opening clause initiates the workflow and describes the first operational step. The model correctly decomposes this into an implicit start node and two sequential actions that together cover the full span."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then Check Levels of Inventory."
      ],
      "justification": "Directly mirrors the instruction to check inventory levels immediately after initialization."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum,"
      ],
      "justification": "The conditional phrase establishes an exclusive decision point. The model captures the condition text in an action node and routes it through an XOR branch."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report."
      ],
      "justification": "Corresponds to the positive outcome of the condition. The guard v1=true aligns with the 'below or equal' threshold, and the action matches the report generation."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report."
      ],
      "justification": "Corresponds to the negative outcome. The guard v1=false aligns with the 'above minimum' case, and the action matches the alternative report."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "The branching report paths merge here before procurement. The converge node handles the merge, and the action faithfully implements the PO creation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Explicit termination directive mapped to a concluding action node and the structural end marker."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Captures the rejection contingency. The XOR branch evaluates PO status, the guard matches 'Rejected', and the action executes the required rework."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Captures the approval contingency. The guard matches 'Approved' and the action covers the combined print-and-release instruction."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Directly implements the mandatory review step triggered upon PO creation."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "The keyword 'Simultaneously' explicitly dictates parallel execution, correctly mapped to an AND gateway splitting into two concurrent actions."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "Parallel execution mandated by the source inherently requires a synchronization point where both funding and mailing paths complete before downstream steps proceed."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive the Packing Slip."
      ],
      "justification": "Faithfully restates the packing slip receipt step following the funding branch."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "receive the inventory."
      ],
      "justification": "Faithfully restates the inventory receipt step following the mailing branch."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "proceed to receive the Invoice."
      ],
      "justification": "Directly maps to the invoice receipt step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match."
      ],
      "justification": "Directly maps to the reconciliation/match step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "release the funds."
      ],
      "justification": "Directly maps to the fund release action contingent on a successful match."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "issue the payment."
      ],
      "justification": "Directly maps to the final payment issuance step."
    }
