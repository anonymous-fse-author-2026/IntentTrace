    {
      "id": "i1",
      "content": "To begin the process for the company, start by receiving the invoice."
    },
    {
      "id": "i2",
      "content": "ask the client to confirm it"
    },
    {
      "id": "i3",
      "content": "Once the invoice is confirmed by the client, proceed to confirm the service information with the client."
    },
    {
      "id": "i4",
      "content": "Once the client has confirmed the service information, categorize the invoices."
    },
    {
      "id": "i5",
      "content": "forward them to the admin officers"
    },
    {
      "id": "i6",
      "content": "Finally, the process ends."
    }
