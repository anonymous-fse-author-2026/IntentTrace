init(i1)
action(n1, "start receiving the invoice")
action(n2, "ask client to confirm the invoice")
action(n3, "check if client confirmed the invoice")
branch(b1, XOR)
action(n4, "confirm service information with client")
action(n5, "check if client confirmed the service information")
branch(b2, XOR)
action(n6, "categorize the invoices")
action(n7, "forward invoices to admin officers")
action(n8, "End process")
end(e1)
defines(v1, "check if client confirmed the invoice", {"Yes", "No"})
defines(v2, "check if client confirmed the service information", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, b2, n6, n7, n8, e1])
precedence(i1, n1)
precedence(n3, b1)
precedence(n5, b2)
precedence(n8, e1)
precedence(n1, n2)
precedence(n2, n3)
precedence(b1, n4)
precedence(n4, n5)
precedence(b2, n6)
precedence(n6, n7)
precedence(n7, n8)
guard(b1, n4, v1 = 'Yes')
guard(b2, n6, v2 = 'Yes')