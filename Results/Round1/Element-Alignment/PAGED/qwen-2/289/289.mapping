{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Accurately captures the process initiation and the first navigation action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "Decomposes the condition into a check action, XOR branch, positive guard, and review action. Threshold and logic preserved."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Negative guard path correctly routes to the translation-need check action and subsequent branch."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5",
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts. If not, confirm the receipts."
      ],
      "justification": "Both translation decision arms are faithfully modeled with corresponding guards and actions."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Directly implements the review evaluation step and its decision split."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8",
        "guard:b4->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Traces the rejection path through guards, question action, branch, and edit action. Meaning preserved."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10",
        "guard:b5->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Traces the approval path through guards, question action, branch, and translation-check action. Meaning preserved."
    },
    {
      "refs": [
        "guard:b6->n12",
        "action:n12",
        "guard:b7->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision. If the report is rejected, edit the report."
      ],
      "justification": "Models the re-evaluation and rejection check via nested branches/actions/guards. Core instruction preserved."
    },
    {
      "refs": [
        "guard:b6->n14",
        "action:n14",
        "guard:b8->n15",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Models the second approval path leading to sequential translation and confirmation actions. Logic preserved."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Directly implements the final receipts evaluation step and its decision split."
    },
    {
      "refs": [
        "guard:b9->n18",
        "action:n18",
        "guard:b10->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Maps the acceptance decision path through guards, question action, branch, and expense processing action."
    },
    {
      "refs": [
        "guard:b10->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Correctly implements the receipt rejection path leading to the edit report action."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Covers the final termination instruction and structural end node. Expense processing was handled in the preceding acceptance path."
    }
  ],
