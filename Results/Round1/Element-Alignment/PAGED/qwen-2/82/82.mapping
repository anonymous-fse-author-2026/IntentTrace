      ],
      "justification": "Exact match for the rejection step."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if the purchase order is good"
      ],
      "justification": "Captures the positive branch condition routing to approval."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "we approve it"
      ],
      "justification": "Direct paraphrase of the approval step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "In case the purchase order is rejected, we rework it."
      ],
      "justification": "Accurately reflects the rework action triggered by rejection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase order is approved, we reserve funds for the purchase."
      ],
      "justification": "Directly matches the fund reservation step on the approval path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, we review it again."
      ],
      "justification": "Faithfully captures the post-rework review step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, we send the purchase order to the supplier."
      ],
      "justification": "Direct match for sending the PO to the supplier."
    },
    {
      "refs": [
        "action:n11",
        "action:n13",
        "label:b2->n11",
        "label:b2->n13"
      ],
      "verbatim_texts": [
        "Simultaneously, we complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "The AND gateway captures the concurrency marker. The two actions and their labels accurately decompose and label the two simultaneous receive steps."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After receiving the packing slip, we record it."
      ],
      "justification": "Directly maps to the recording of the packing slip."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Similarly, after receiving the invoice, we record it as well."
      ],
      "justification": "Directly maps to the recording of the invoice."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, we send the purchase order to the supplier."
      ],
      "justification": "Structural converge representing the implicit rejoining of the approval and rework paths before proceeding to supplier dispatch."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "Similarly, after receiving the invoice, we record it as well."
      ],
      "justification": "Structural converge representing the implicit rejoining of the two parallel recording paths before fund release."
    },
    {
