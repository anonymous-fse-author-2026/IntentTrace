{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by checking if the order has been received."
      ],
      "justification": "Opening clause implicitly starts the process and describes the initial receipt verification step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->n5",
        "action:n5",
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If the sum of the order is less than 500, then continue with the process."
      ],
      "justification": "First threshold decision modeled as action-step plus XOR branch. Guard captures <500 condition and continuation path; complementary guard routes higher values forward."
    },
    {
      "refs": [
        "action:n6",
        "guard:b3->n7",
        "action:n7",
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "However, if the sum of the order is greater than 2000, compute a discount of 4%."
      ],
      "justification": "Second threshold decision. Guard captures >2000 condition and 4% discount computation; complementary guard routes values \u22642000 to next range."
    },
    {
      "refs": [
        "action:n8",
        "guard:b4->n9",
        "action:n9",
        "guard:b4->n10"
      ],
      "verbatim_texts": [
        "If the sum of the order falls between 1000 and 1500, compute a discount of 3%."
      ],
      "justification": "Range decision for 1000\u20131500. Guard captures lower bound \u22651000 and 3% discount; upper bound complement (<1000) routes to next check."
    },
    {
      "refs": [
        "action:n10",
        "guard:b5->n11",
        "action:n11",
        "guard:b5->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Similarly, if the sum of the order falls between 500 and 999, compute a discount of 2%."
      ],
      "justification": "Range decision for 500\u2013999. Guard captures \u2265500 and 2% discount; fallback <500 guard reverts to continuation path aligned with earlier logic."
    },
    {
      "refs": [
        "action:n13",
        "guard:b6->n14",
        "action:n14",
        "guard:b6->n15"
      ],
      "verbatim_texts": [
        "After checking the sum of the order, if it is still less than 500, continue with the process."
      ],
      "justification": "Explicit repetition of the <500 check and continuation step. Complementary guard routes forward."
    },
    {
      "refs": [
        "action:n15",
        "guard:b7->n16",
        "action:n16",
        "guard:b7->n17"
      ],
      "verbatim_texts": [
        "If the sum of the order is greater than 2000, compute a discount of 4%."
      ],
      "justification": "Explicit repetition of the >2000 check and 4% discount computation. Complementary guard routes forward."
    },
    {
      "refs": [
        "action:n17",
        "guard:b8->n18",
        "action:n18",
        "guard:b8->n19"
      ],
      "verbatim_texts": [
        "Once again, check the sum of the order. If it is less than 500, continue with the process."
      ],
      "justification": "Third repetition of the <500 check and continuation. Complementary guard routes to subsequent range checks."
    },
    {
      "refs": [
        "action:n19",
        "guard:b9->n20",
        "action:n20",
        "guard:b9->n21"
      ],
      "verbatim_texts": [
        "If the sum of the order falls between 1000 and 1500, compute a discount of 3%."
      ],
      "justification": "Redundant repetition of the 1000\u20131500 range and 3% discount. Logic and thresholds remain identical to source."
    },
    {
      "refs": [
        "action:n21",
        "guard:b10->n22",
        "action:n22",
        "guard:b10->c1"
      ],
      "verbatim_texts": [
        "Likewise, if the sum of the order falls between 500 and 999, compute a discount of 2%."
      ],
      "justification": "Final repetition of the 500\u2013999 range and 2% discount. Fallback <500 guard routes flows to convergence."
    },
    {
      "refs": [
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "Finally, create the bill and the process will come to an end."
      ],
      "justification": "Implicit convergence joins all repeated paths before the explicit billing action. Final action and structural end node map directly to the closing clause."
    }
  ],
