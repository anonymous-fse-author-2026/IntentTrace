{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "Explicit opening phrase signals the process initiation point."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "start with Password Verification, followed by Verifiy Password."
      ],
      "justification": "Directly captures the two sequential initial actions. Minor typo correction in the model is acceptable."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If you choose \"Select Cancel\", you will be directed to iforgot.apple.com."
      ],
      "justification": "Captures the first XOR arm: the conditional decision, its specific gate value, and the resulting navigation action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if you select \"Reset password\", you will be automatically directed to iforgot.apple.com."
      ],
      "justification": "Captures the second XOR arm condition and the corresponding navigation action."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "In case you choose \"Retry\", you will need to re-enter your password."
      ],
      "justification": "Captures the third XOR arm condition and the required password re-entry action."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, go to iforgot.apple.com and proceed with Reset Password."
      ],
      "justification": "Faithfully splits the sequential post-retry instructions into distinct navigation and reset actions."
    },
    {
      "refs": [
        "action:n10",
        "guard:b2->n11",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "If you need to re-enter your password, do so and then verify it."
      ],
      "justification": "Accurately models the conditional requirement as a check node, XOR branch, positive guard, re-entry step, verification step, and subsequent flow convergence."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the password is reset, you can return to the iTunes purchases page."
      ],
      "justification": "The reset completion triggers implicit flow convergence and the explicit action to return to the purchases page."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "From there, select the price of the item."
      ],
      "justification": "Direct match to the price selection step."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16",
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If prompted to \"Enter Password\", verify the password. Alternatively, if asked to \"Enter Apple ID\", enter the password."
      ],
      "justification": "Correctly captures the XOR decision point, both distinct prompt conditions, and their respective verification/entry actions."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Finally, enter the password and verify it."
      ],
      "justification": "Models the final combined action, implicit flow convergence from prior branches, and process termination."
    }
