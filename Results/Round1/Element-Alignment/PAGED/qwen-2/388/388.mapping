      "verbatim_texts": [
        "i1: To start the process, begin by selecting a filter"
      ],
      "justification": "Covers the implicit process start, the introductory action step, and the first concrete task of selecting a filter. Redundant start action is permitted per redundancy rules."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "i2: and then applying it."
      ],
      "justification": "Directly implements the sequential application of the selected filter."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "i3: After applying the filter, click on the Submit button."
      ],
      "justification": "Faithfully captures the submission action following filter application."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "i4: Next, check if the option to submit is set to \"false\".",
        "i5: is set to \"false\""
      ],
      "justification": "Models the conditional check as an action step preceding an XOR branch, consistent with standard modeling practice for embedded conditions."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "i6: If it is, then apply another filter."
      ],
      "justification": "Accurately maps the affirmative ('false') condition path and the corresponding fallback action."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "i7: If the option to submit is set to \"true\", then continue with the process."
      ],
      "justification": "Captures the alternative ('true') condition path directing flow to the convergence point for subsequent steps."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "i8: Additionally, check if there is another filter to apply."
      ],
      "justification": "Faithfully models the secondary conditional evaluation as an action and branching point."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "i9: If there is, continue with the process."
      ],
      "justification": "Correctly represents the affirmative branch routing back to the convergence/join path."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "i10: If not,"
      ],
      "justification": "Represents the negative branch condition directing flow to the final evaluation step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "i11: Finally, if the option to submit is set to \"true\", continue with the process."
      ],
      "justification": "Precisely models the final conditional check and its positive outcome path leading to completion."
    },
    {
      "refs": [
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "i12: if the option to submit is set to \"true\""
      ],
      "justification": "Precisely models the final conditional check and its positive outcome path leading to completion."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->e1"
      ],
      "verbatim_texts": [
        "i13: The process ends when all steps have been completed."
      ],
      "justification": "Captures the explicit termination step, the structural end node, and the implicit else-path that fulfills process completion."
    }
