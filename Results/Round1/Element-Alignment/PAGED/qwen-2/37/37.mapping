      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Faithfully captures the initiation and first order placement step without alteration."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed to Check the Customer's Credit Limit"
      ],
      "justification": "Direct restatement of the credit limit check instruction."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the response is",
        "\"Okay\""
      ],
      "justification": "Branch and guard accurately model the initial positive response condition."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "\"No\""
      ],
      "justification": "Guard correctly captures the negative response value."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "After checking the availability, if the response is"
      ],
      "justification": "Structural branch aligns with the secondary decision point."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article again"
      ],
      "justification": "Paraphrases 'again' to 'second time' without altering core meaning or execution order."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If the Article is not available"
      ],
      "justification": "Branch and guard model the unavailability condition."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods"
      ],
      "justification": "Exact match for the production step."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "if the Article is available"
      ],
      "justification": "Guard value 'Yes' faithfully represents the availability condition."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "if the Article is available, proceed to Collect the Goods"
      ],
      "justification": "Exact match for the collection step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "send an Order Confirmation"
      ],
      "justification": "Direct copy of the confirmation action."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "AND gateway correctly models simultaneous execution."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Ship the Goods and Send the Invoice"
      ],
      "justification": "Correctly splits the compound step into two parallel actions."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Check the Payment status"
      ],
      "justification": "Exact match."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "If the payment has been received"
      ],
      "justification": "Accurately models the payment receipt check and positive path."
    },
    {
      "refs": [
        "guard:b4->n19"
      ],
      "verbatim_texts": [
        "has not been received"
      ],
      "justification": "Guard correctly captures the negative payment outcome."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "check if the Reminder count is greater than or equal to 3"
      ],
      "justification": "Faithfully represents the reminder threshold evaluation."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder"
      ],
      "justification": "Exact match for the reminder action."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
