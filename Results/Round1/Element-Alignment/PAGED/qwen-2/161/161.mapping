{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "i1 implicitly initiates the process and describes the initial joining and agreement steps."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "create a process model and check it."
      ],
      "justification": "Direct match to the creation and verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\""
      ],
      "justification": "i3 establishes the first conditional decision point, modeled as an action node and XOR branch."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\"",
        "is \"NOT OK\""
      ],
      "justification": "i3 and i4 provide the exact condition payload for the positive guard arm."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then assign negative points."
      ],
      "justification": "Direct match to the penalty action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\""
      ],
      "justification": "i6 establishes the second conditional decision point."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\"",
        "still \"NOT OK\""
      ],
      "justification": "i6 and i7 provide the exact condition payload for the second guard arm."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "assign negative points again."
      ],
      "justification": "Direct match to the repeated penalty action."
    },
    {
      "refs": [
        "guard:b1->c1",
        "guard:b2->c1",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "i9 provides the positive outcome for both prior checks, justifies the merge into converge:c1, and describes continuing."
    },
    {
      "refs": [
        "label:b6->n10"
      ],
      "verbatim_texts": [
        "If there are any issues"
      ],
      "justification": "i10 directly labels the issue-handling path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "i11 describes fixing and extending, triggered by the gateway."
    },
    {
      "refs": [
        "label:b6->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process. If you need to analyze the field of study"
      ],
      "justification": "i13 announces the dual evaluation paths combined into the label and preparatory action."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points",
        "check the process and assign points",
        "If you need to analyze the field of study"
      ],
      "justification": "i12, i14, and i15 collectively define the two alternative routes split at b3."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points",
        "check the process and assign points"
      ],
      "justification": "i12 and i14 specify the condition for routing back to convergence."
    },
    {
      "refs": [
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study"
      ],
      "justification": "i15 specifies the condition for the analysis route."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "analyze the field of study",
        "assign roles in the team."
      ],
      "justification": "i16 and i17 describe the analysis task and subsequent role assignment."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "i18 implies rejoining flows and describes continuing work per role."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct match to the monitoring step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the project is accepted"
      ],
      "justification": "i20 establishes the first project acceptance decision."
    },
    {
      "refs": [
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If the project is accepted"
      ],
      "justification": "i20 provides the positive condition for presentation."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "present it."
      ],
      "justification": "i21 matches the presentation action; end:e1 structurally closes this success branch."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18",
        "guard:b5->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "i22 applies identically to both rejection paths in the model."
    },
    {
      "refs": [
        "action:n20",
        "action:n19",
        "guard:b5->n21"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "i23 describes the second acceptance check and repeated presentation, modeled across nodes and guards."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "i24 matches the final presentation action and explicitly signals process termination."
    }
  ],
