      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The initiation clause implicitly justifies the structural start node, while the explicit phrasing supports the 'start' and 'receive claim' action steps."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Exact wording match for the creation and recording step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "The explicit decision instruction maps to the action node, and inherently implies the subsequent XOR branch structure."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "The conditional operator/value maps to the guard, and the consequent step maps to the action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "The acceptance condition is captured by the guard and modeled as an intervening action step, preserving the source logic."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "offer the benefit"
      ],
      "justification": "Direct reproduction of the benefit-offering instruction."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Faithful restatement of the review step following rejection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Direct match for the discharge preparation step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Exact alignment with the payment recording instruction."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15",
        "guard:b4->n16",
        "action:n16",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process. But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Captures the dual conditional paths on rejection status, their convergence, and the unified continuation step exactly as described."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicit termination statement faithfully mapped to both the descriptive action and the structural end node."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "The concurrent marker justifies the AND branch and converge, while the listed tasks match the two action nodes exactly."
    }
