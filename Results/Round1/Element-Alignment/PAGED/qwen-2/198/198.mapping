    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "The opening sentence implicitly triggers the process start and explicitly defines the initial identification action."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer"
      ],
      "justification": "The conditional clause is captured as a decision action, a structural XOR branch, and a positive guard representing the true path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should then check the availability of the parts."
      ],
      "justification": "Directly matches the prescribed action taken when the condition is met."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if they already have the availability information, they can proceed with the process."
      ],
      "justification": "The alternative path guard and subsequent converge node faithfully represent the conditional bypass and flow resumption."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer"
      ],
      "justification": "The second conditional is modeled as a decision action leading into a structural XOR branch."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "the team can also continue with the process."
      ],
      "justification": "The positive outcome guard and converge node correctly capture the continuation flow described."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if they need to record the customer's details, they should order and receive the part from Disuki."
      ],
      "justification": "The alternative guard and the ordering/receiving action accurately reflect the conditional requirement and its fulfillment step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "The action step directly reproduces the contracting instruction, with the temporal context handled by process sequencing."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected, the team can proceed with the payment."
      ],
      "justification": "Faithfully restates the payment progression step with equivalent wording."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "The explicit termination action and structural end node together fully cover the closing statement."
    }
  ],
