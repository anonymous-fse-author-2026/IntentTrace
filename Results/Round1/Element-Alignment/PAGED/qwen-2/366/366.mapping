  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by checking the order received"
      ],
      "justification": "Structural start aligns with process initiation phrase; action faithfully captures the first verification instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to check the availability of the article."
      ],
      "justification": "Direct implementation of the initial availability check step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the article is not available,"
      ],
      "justification": "Exclusive gateway and its corresponding action step model the availability decision point."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the article is not available,"
      ],
      "justification": "Guard condition precisely captures the negative availability branch logic."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the next step is to initiate the procurement process."
      ],
      "justification": "Action exactly reproduces the procurement trigger for the unavailable path."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "However, if the article is available,"
      ],
      "justification": "Guard condition precisely captures the positive availability branch logic."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "proceed to ship it."
      ],
      "justification": "Faithfully executes the shipping instruction upon confirmed availability."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After shipping the article, check its availability again."
      ],
      "justification": "Preserves the exact post-shipment re-evaluation instruction."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is still not available,"
      ],
      "justification": "Second exclusive gateway and action model the follow-up availability decision."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If it is still not available,"
      ],
      "justification": "Guard correctly gates the fallback procurement path on continued unavailability."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "initiate the procurement process."
      ],
      "justification": "Repeats the procurement action as mandated by the second unavailability condition."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n10"
      ],
      "verbatim_texts": [
        "Otherwise, proceed to ship the article."
      ],
      "justification": "Combines the positive guard outcome with the corresponding shipping step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the article is shipped, the next step is to complete the financial settlement."
      ],
      "justification": "Accurately sequences the financial settlement step after shipping."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After the financial settlement is done, the process ends with the receipt of payment."
      ],
      "justification": "Covers the final payment receipt action and explicitly terminates the process as stated."
    }
  ],
