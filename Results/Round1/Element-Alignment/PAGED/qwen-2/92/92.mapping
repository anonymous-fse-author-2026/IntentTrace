    },
    {
      "refs": [
        "action:n0"
      ],
      "verbatim_texts": [
        "please register your participation for the event."
      ],
      "justification": "Faithful paraphrase of the initial registration task."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request. However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "The full conditional sentence establishes the XOR split, the decision question, and both guarded outcomes (No fee / Yes fee)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to register a post-seminar request"
      ],
      "justification": "Directly corresponds to the no-fee action path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "create a purchase request"
      ],
      "justification": "Directly corresponds to the fee action path."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Explicit termination statement immediately following the first post-seminar registration."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Exact restatement of the approval verification step."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Captures the approval branch, the approval guard condition, and the resulting notification action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Captures the rejection guard condition and the corresponding rejection notification action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Direct match for the secondary post-seminar registration triggered by the approval notification."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Explicit termination statement for the rejection path."
    }
