    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts with the Request for Quotation,"
      ],
      "justification": "The opening clause implicitly signals the process initiation and defines the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by the Customer submitting the RFQ."
      ],
      "justification": "Directly corresponds to the RFQ submission step; actor omission is outside evaluation scope per instructions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After the RFQ is submitted, the Quotation is also submitted."
      ],
      "justification": "Faithfully captures the core instruction to submit the quotation."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the Quotation is submitted, we receive it."
      ],
      "justification": "Accurately reflects the reception of the quotation."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Upon receiving the Quotation, we then submit the Purchase Order."
      ],
      "justification": "Directly maps to the purchase order submission action."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Simultaneously, we complete two steps: sending the Goods and sending the Invoice."
      ],
      "justification": "'Simultaneously' dictates a parallel execution path modeled as an AND branch splitting into the two corresponding send actions."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the Goods are sent, we mark them as sent."
      ],
      "justification": "Precisely matches the post-transmission status update for the goods."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Similarly, after the Invoice is sent, we mark it as sent."
      ],
      "justification": "Precisely matches the post-transmission status update for the invoice."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "The process ends when the Goods are sent or when the Invoice is sent."
      ],
      "justification": "The paired action and structural end nodes correspond to the dual termination conditions stated in the source. Redundant termination modeling is acceptable per guidelines."
    }
  ],
