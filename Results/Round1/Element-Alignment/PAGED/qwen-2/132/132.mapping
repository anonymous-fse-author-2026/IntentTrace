    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "we send the offer, and once the offer is sent, we wait for the customer to accept it."
      ],
      "justification": "action:n7 sends the offer and action:n8 waits for acceptance, faithfully following the sequential description."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "Once the customer accepts the offer"
      ],
      "justification": "action:n9 checks for acceptance, branch:b2 splits the flow, and guard:b2->n10 routes the positive acceptance outcome forward."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "we dispatch the article"
      ],
      "justification": "Direct implementation of the dispatch step triggered by acceptance."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Finally, once the article is dispatched, the process comes to an end."
      ],
      "justification": "action:n12 concludes the workflow activity, and end:e3 marks the final process termination."
    }
