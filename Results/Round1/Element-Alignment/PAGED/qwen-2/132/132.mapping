      "verbatim_texts": [
        "To begin the process, the customer makes an enquiry."
      ],
      "justification": "init:i1 captures the explicit process start, and action:n1 directly implements the stated first step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "we check if the article is in stock"
      ],
      "justification": "action:n2 performs the inventory check, and branch:b1 models the implicit decision node resulting from that check."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the article is available, we continue with the process."
      ],
      "justification": "guard:b1->n3 encodes the availability condition as true, and action:n3 executes the continuation instruction."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the article is not available, we abort the enquiry and end the process."
      ],
      "justification": "guard:b1->n4 encodes unavailability as false, action:n4 aborts and terminates, and end:e1 marks the described termination point."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "reserving the article and calculating the price."
      ],
