  "input_elements": [
    {
      "id": "i1",
      "content": "the process begins with receiving an order request."
    },
    {
      "id": "i2",
      "content": "the order is registered and evaluated."
    },
    {
      "id": "i3",
      "content": "If the evaluation result is \"NOK\""
    },
    {
      "id": "i4",
      "content": "the order is considered as \"NOK\" and the process comes to an end."
    },
    {
      "id": "i5",
      "content": "if the evaluation result is \"ok\""
    },
    {
      "id": "i6",
      "content": "then the installation process takes place."
    },
    {
      "id": "i7",
      "content": "If the installation is not successful"
    },
    {
      "id": "i8",
      "content": "the order is considered as \"NOK\" and the process ends."
    },
    {
      "id": "i9",
      "content": "if the installation is successful"
    },
    {
      "id": "i10",
      "content": "the next step is to check the installation."
    },
    {
      "id": "i11",
      "content": "Once the installation is verified, the billing is prepared."
    },
    {
      "id": "i12",
      "content": "Finally, if everything is in order, the order is marked as \"ok\" and the process is completed."
    }
  ]
