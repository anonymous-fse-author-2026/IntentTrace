@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process and enter the metadata;
:proceed to IN-Patient step;
split
:parallel start: send data to suppliers;
:extract data from suppliers;
:transfer data to doctor's phone;
:confirm the GOP;
:end after confirming GOP;
stop
split again
:parallel start: create a claim;
:handle create a claim after initial create claim;
:handle the claim accordingly after creation;
:receive the payment after claim creation handling;
stop
split again
:parallel start: register the case;
:handle the claim;
split
:create a claim within handling;
:handle the claim accordingly;
:receive the payment after handling claim;
:end process after handling claim;
stop
split again
:extract data from suppliers after claim handling;
:enter data on patient's record or confirm IN-Patient status from extraction;
split
:parallel start: send data back to suppliers;
:send data to suppliers after patient record entry;
:register the case after sending data back;
:handle the claim after registering case;
:receive the payment after handling claim post registering case;
:end process after payment received post registering case;
stop
split again
:parallel start: register the case after patient record entry;
:handle the claim after case registration;
:receive the payment after handling claim post registration;
:end process after payment received post registration;
stop
end split
split again
:enter data on patient's record or confirm IN-Patient status directly after handling claim;
:receive the payment after direct patient record entry;
:end process after direct payment;
stop
end split
end split
@enduml