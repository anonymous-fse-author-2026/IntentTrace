  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, trigger the resupply cycle."
    },
    {
      "id": "i2",
      "content": "After that, check the current inventory level."
    },
    {
      "id": "i3",
      "content": "If the inventory level is above the minimum"
    },
    {
      "id": "i4",
      "content": "then the process ends"
    },
    {
      "id": "i5",
      "content": "However, if the inventory level is below the minimum"
    },
    {
      "id": "i6",
      "content": "create a purchase order"
    },
    {
      "id": "i7",
      "content": "Once the purchase order is created, review it."
    },
    {
      "id": "i8",
      "content": "If the purchase order is rejected"
    },
    {
      "id": "i9",
      "content": "rework the purchase order"
    },
    {
      "id": "i10",
      "content": "if the purchase order is accepted"
    },
    {
      "id": "i11",
      "content": "After reworking the purchase order, review it again."
    },
    {
      "id": "i12",
      "content": "At the same time, complete the following steps:"
    },
    {
      "id": "i13",
      "content": "reserve funds for the purchase and send the purchase order to the supplier"
    },
    {
      "id": "i14",
      "content": "Once the packing slip is received, release the reserved funds"
    },
    {
      "id": "i15",
      "content": "and then the process ends"
    }
  ]
}