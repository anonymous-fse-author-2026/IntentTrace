  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "The init node marks the process start, and n2 faithfully executes the first described step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Directly implements the approval reception step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Faithfully captures the coordination action with TS."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Directly implements the initial verification step."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized."
      ],
      "justification": "Models the condition as an action-step feeding an XOR branch and internal guard, then executes the matching authorization. Faithful to source granularity."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Captures the external resource guard and corresponding authorization action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Directly implements the document submission step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Faithfully reproduces the scanning and system recording step."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Correctly decomposes the compound source step into sequential checking and sending actions without altering meaning."
    },
    {
      "refs": [
        "action:n13",
        "action:n20"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Maps the reception event, terminal state, and redundant end-step to the closing source clause. Redundancy is acceptable and does not change behaviour."
    },
    {
      "refs": [
        "action:n14",
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Models the no-variations condition as an action-step feeding an XOR branch and negative guard, proceeding to continuation."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed."
      ],
      "justification": "Implements the business case completion for the variations path."
    },
    {
      "refs": [
        "guard:b2->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed and attached."
      ],
      "justification": "Captures the positive variations guard and the combined completion-plus-attachment action."
    }
  ],
