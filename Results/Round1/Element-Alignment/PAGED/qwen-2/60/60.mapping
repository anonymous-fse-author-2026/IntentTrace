{
  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "The init node anchors the process start, while n2 and n3 faithfully capture the exact UI interactions described."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "n4 captures the explicit threshold condition, b1 models the resulting XOR split, and n5 matches the review action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "n6 accurately reflects the translation-check instruction triggered by the negative expense branch."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "b2 models the translation requirement split, and n7 faithfully restates the translate-receipts action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "n8 directly matches the confirmation action on the negative translation branch."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "n9 reproduces the evaluation step exactly."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "b3 handles the review-decision split, and n10 matches the rejection-edit action."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "n19 is a verbatim copy of the second review-evaluation instruction."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "n14 faithfully captures the final receipts-decision evaluation step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "b5 models the acceptance/rejection split, and n15 matches the expense-processing action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "n16 directly matches the rejection-edit fallback action."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "The terminal actions and end nodes collectively cover the closing termination sequence; redundancy is permitted as it does not alter behavior."
    }
  ],
