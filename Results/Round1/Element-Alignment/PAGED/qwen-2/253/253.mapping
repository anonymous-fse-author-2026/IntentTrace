{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "The opening clause implicitly signals the process initiation and explicitly defines the first action step with identical wording."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\", then proceed to Create Purchase Order."
      ],
      "justification": "The conditional structure implies the XOR branch, and the consequent clause directly names the Create Purchase Order action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "The explicit termination statement supports both the End action node and the structural end node."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Direct paraphrase of the sequential step to review the order."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved, then reserve the funds for the purchase."
      ],
      "justification": "The conditional opens the second XOR branch, models the approval check as an action step (permitted), and specifies the fund reservation action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the Purchase Order is rejected, then rework the order."
      ],
      "justification": "Direct restatement of the fallback action for rejected orders."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Exact match for the subsequent routing step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Faithfully captures the loop-back action for reworked orders."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: the Supplier sends a packing slip and an invoice."
      ],
      "justification": "The concurrency keyword justifies the AND branch, and the clause explicitly describes the supplier action."
    },
    {
      "refs": [
        "label:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it."
      ],
      "justification": "The reception condition justifies the label on the branch arm, and the instruction matches the record action."
    },
    {
      "refs": [
        "label:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Similarly, when the invoice is received, record it as well."
      ],
      "justification": "Parallels the previous arm; the label captures the receipt trigger and the action captures the recording step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice, release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "The completion of both parallel recording tasks implies the converge node, and the remainder of the clause specifies the payment/fund release action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Explicit closure statement supports the final End action and structural end node."
    }
  ],
