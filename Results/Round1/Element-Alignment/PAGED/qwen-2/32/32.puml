@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
repeat :Enter Expenses;
:Generate Spreadsheet;
:Approval Check 1;
:v1: Approval Check 1 ({Approved, Disapproved}); <<objectSignal>>
repeat while () is (["v1 = 'Disapproved'"]) not (["v1 = 'Approved'"])
:Payout;
:Approval Check 2;
:v2: Approval Check 2 ({Approved, Disapproved}); <<objectSignal>>
if () then (["v2 = 'Approved'"])
:End Process;
stop
else (["v2 = 'Disapproved'"])
endif
@enduml