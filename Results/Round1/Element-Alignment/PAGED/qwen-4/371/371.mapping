{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Covers process initialization and the explicit UI navigation steps."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000"
      ],
      "justification": "Models the conditional check for the expense threshold."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "is greater than 1000"
      ],
      "justification": "Models the conditional check for the expense threshold."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the report should be reviewed."
      ],
      "justification": "Direct mapping to the review action on the high-expense path."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "is less than or equal to 1000"
      ],
      "justification": "Captures the alternative threshold condition directing flow to the low-expense path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "check if there is a need for translation. If translation is required,"
      ],
      "justification": "Represents the translation requirement check and subsequent decision split."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "proceed to translate the receipts."
      ],
      "justification": "Maps to the positive translation outcome and its execution."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Maps to the negative translation outcome and receipt confirmation."
    },
    {
      "refs": [
        "action:n11",
        "action:n6"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Both elements represent the post-confirmation review evaluation step."
    },
    {
      "refs": [
        "action:n12",
        "action:n7",
        "guard:b4->n12",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Multiple redundant elements faithfully capture the rejection handling and edit action."
    },
    {
      "refs": [
        "action:n13",
        "action:n14",
        "guard:b4->n13",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Models the approved path leading to translation and subsequent confirmation steps."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision. If the receipts are accepted,"
      ],
      "justification": "Represents the final decision evaluation and the acceptance condition gateway."
    },
    {
      "refs": [
        "action:n16",
        "guard:b5->n16"
      ],
      "verbatim_texts": [
        "proceed to process the expense."
      ],
      "justification": "Direct mapping for the expense processing step on acceptance."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Direct mapping for the receipt rejection handling and edit action."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Redundant end steps collectively cover the process termination description."
    }
  ],
  "mutations": [],
  "omissions": [
    {
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "reason": "The model skips the secondary translation check described in the approved path."
    },
    {
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "reason": "The model omits the repeated review decision evaluation mandated by the text."
    }
  ],
