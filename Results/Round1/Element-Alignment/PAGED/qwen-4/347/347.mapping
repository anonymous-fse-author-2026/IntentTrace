{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "Initiates process and models the first two sequential actions exactly as described."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
      ],
      "justification": "Branch captures the inventory decision point; guard and action faithfully reproduce the threshold condition and report generation."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "inventory is below or equal to the minimum"
      ],
      "justification": "Branch captures the inventory decision point; guard and action faithfully reproduce the threshold condition and report generation."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Guard and action align exactly with the alternative inventory condition and corresponding report generation."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "inventory is greater than the minimum"
      ],
      "justification": "Guard and action align exactly with the alternative inventory condition and corresponding report generation."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs).",
        "report indicates that the inventory is equal to or below the minimum"
      ],
      "justification": "Action content directly restates creating POs when the report indicates low inventory."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends.",
        "report indicates that the inventory is above the minimum"
      ],
      "justification": "Structural end node correctly positioned for the high-inventory termination path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed. If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Captures the PO review requirement stated in the source."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Guard and action precisely model the rejection condition and mandatory rework step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "PO is rejected"
      ],
      "justification": "Guard and action precisely model the rejection condition and mandatory rework step."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Guard and action precisely model the approval condition and print/release step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "PO is approved"
      ],
      "justification": "Guard and action precisely model the approval condition and print/release step."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "AND branch correctly splits the simultaneous funding reservation and mailing actions."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Action directly matches receiving inventory following the mailing step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip.",
        "funds are reserved for the released POs",
        "If the inventory is received, proceed to receive the Packing Slip.",
        "inventory is received"
      ],
      "justification": "Converge rejoins the parallel fund-reservation and inventory-receipt paths; action matches receiving the packing slip after both conditions are met."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice.",
        "Packing Slip is received"
      ],
      "justification": "Action matches receiving the invoice immediately after packing slip arrival."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Action matches proceeding to the three-way match step."
    },
    {
      "refs": [
        "guard:b4->n15"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Branch, guard, and action faithfully model the successful match condition and subsequent fund release."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Three-way match is successful"
      ],
      "justification": "Branch, guard, and action faithfully model the successful match condition and subsequent fund release."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Action exactly matches issuing payment after fund release."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Structural end node correctly marks completion of the resupply cycle."
    }
  ],
