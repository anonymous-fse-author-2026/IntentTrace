  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
    },
    {
      "id": "i2",
      "content": "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
    },
    {
      "id": "i3",
      "content": "inventory is below or equal to the minimum"
    },
    {
      "id": "i4",
      "content": "If the inventory is greater than the minimum, generate an Above Minimum Report."
    },
    {
      "id": "i5",
      "content": "inventory is greater than the minimum"
    },
    {
      "id": "i6",
      "content": "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
    },
    {
      "id": "i7",
      "content": "report indicates that the inventory is equal to or below the minimum"
    },
    {
      "id": "i8",
      "content": "If the report indicates that the inventory is above the minimum, the process ends."
    },
    {
      "id": "i9",
      "content": "report indicates that the inventory is above the minimum"
    },
    {
      "id": "i10",
      "content": "If the PO is rejected, it needs to be reworked."
    },
    {
      "id": "i11",
      "content": "PO is rejected"
    },
    {
      "id": "i12",
      "content": "If the PO is approved, it is printed and released in the system."
    },
    {
      "id": "i13",
      "content": "PO is approved"
    },
    {
      "id": "i14",
      "content": "If the PO is created, it needs to be reviewed. If the PO needs to be reworked, it needs to be created again."
    },
    {
      "id": "i15",
      "content": "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
    },
    {
      "id": "i16",
      "content": "If funds are reserved for the released POs, receive the Packing Slip."
    },
    {
      "id": "i17",
      "content": "funds are reserved for the released POs"
    },
    {
      "id": "i18",
      "content": "If the POs are mailed to the supplier, receive the inventory."
    },
    {
      "id": "i19",
      "content": "If the Packing Slip is received, proceed to receive the Invoice."
    },
    {
      "id": "i20",
      "content": "Packing Slip is received"
    },
    {
      "id": "i21",
      "content": "If the inventory is received, proceed to receive the Packing Slip."
    },
    {
      "id": "i22",
      "content": "inventory is received"
    },
    {
      "id": "i23",
      "content": "If the Invoice is received, proceed to the Three-way match."
    },
    {
      "id": "i24",
      "content": "Invoice is received"
    },
    {
      "id": "i25",
      "content": "If the Three-way match is successful, release the funds."
    },
    {
      "id": "i26",
      "content": "Three-way match is successful"
    },
    {
      "id": "i27",
      "content": "Once the funds are released, issue the payment."
    },
    {
      "id": "i28",
      "content": "After the payment is issued, the Resupply Cycle is complete and the process ends."
    }
  ]
