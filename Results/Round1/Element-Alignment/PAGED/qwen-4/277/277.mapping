{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME Company, we first trigger the Resupply Cycle."
      ],
      "justification": "Covers process initialization and the explicit trigger action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, we check the inventory level."
      ],
      "justification": "Directly and faithfully captures the inventory check step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once the inventory level is checked, we proceed to create a purchase order."
      ],
      "justification": "Accurately models the purchase order creation step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the purchase order is not good",
        "if the purchase order is good"
      ],
      "justification": "Structural XOR branch correctly models the exclusive conditional split described in the source."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "we reject it"
      ],
      "justification": "Faithfully represents the rejection path action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "we approve it"
      ],
      "justification": "Faithfully represents the approval path action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "In case the purchase order is rejected, we rework it."
      ],
      "justification": "Correctly models the rework step following rejection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "if the purchase order is approved, we reserve funds for the purchase."
      ],
      "justification": "Faithfully captures the fund reservation step triggered by approval."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, we send the purchase order to the supplier."
      ],
      "justification": "Directly matches the dispatch step to the supplier."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, we complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "AND branch and both receive actions faithfully model the simultaneous parallel tasks."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After receiving the packing slip, we record it."
      ],
      "justification": "Correctly models recording the packing slip."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Similarly, after receiving the invoice, we record it as well."
      ],
      "justification": "Correctly models recording the invoice."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Next, we release funds for payment and issue the payment."
      ],
      "justification": "Convergence node and subsequent payment actions accurately reflect the post-parallel sequence."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued."
      ],
      "justification": "Action and end node correctly capture process termination."
    }
  ],
