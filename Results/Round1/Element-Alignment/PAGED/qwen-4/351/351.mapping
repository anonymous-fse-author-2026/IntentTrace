{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Captures the process initiation, the contextual header translated to a start step, and the first conditional check."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Maps the affirmative decision path, its guard value, and the resulting discussion action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Captures the negative/otherwise branch guard and the continuation step."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Covers the decision node, the check action, and the implicit negative path guard inherent to the binary decision."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits."
      ],
      "justification": "Aligns the affirmative guard, the subsequent check action, and the following decision node."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "Matches the condition for exceeding limits and the corresponding relay action."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process."
      ],
      "justification": "Matches the condition for staying within limits and the continuation step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Verbatim reproduction of the combined relay and continuation step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Verbatim reproduction of the approval request and continuation."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Verbatim reproduction of the modification step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Verbatim reproduction of the documentation transfer step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Verbatim reproduction of the scanning and uploading step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Verbatim reproduction of the formal offer step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Maps the acceptability check action and its corresponding decision node."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they are, continue with the process."
      ],
      "justification": "Captures the acceptance condition guard and the continuation action."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If not, select a new applicant from the list."
      ],
      "justification": "Captures the rejection condition guard and the new applicant selection action."
    },
    {
      "refs": [
        "action:n19",
        "action:n22"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Covers the repeated client acceptance checks described in the source text."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20",
        "guard:b6->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Maps the repeated affirmative guards, termination actions, and structural end nodes upon client acceptance."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21",
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Maps the repeated negative guards, fallback selection actions, and the final structural end node."
    }
  ],
