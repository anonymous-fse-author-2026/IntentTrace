  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by claiming what is requested"
      ],
      "justification": "The opening clause implicitly triggers the process start (init) and describes the initial claim action. 'start the process' and 'claim what is requested' faithfully cover this span."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "claiming what is requested and then check the insured status of the claimant."
      ],
      "justification": "Directly implements the second part of the sequential instruction to check insured status."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claimant is insured, proceed to evaluate the claim."
      ],
      "justification": "Covers the conditional check (modeled as action), the XOR branch, the positive guard, and the subsequent evaluation step. Core meaning and flow are preserved."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the claimant is not insured, reject the claim."
      ],
      "justification": "Negative guard and rejection action directly implement the alternative branch path."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the claim is rejected, notify the claimant and the process comes to an end."
      ],
      "justification": "Notification action, terminal action step, and structural end node collectively capture the post-rejection workflow and termination."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n10",
        "action:n10",
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the claim is a simple one or a complex one, send the relevant forms accordingly."
      ],
      "justification": "Decision action, branch, guards for both simple/complex cases, and respective form-sending actions faithfully decompose the conditional routing instruction."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the forms are returned, check them for completeness."
      ],
      "justification": "Sequential receipt and verification actions directly map to the stated requirement."
    },
    {
      "refs": [
        "action:n14",
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided, proceed to register the claim."
      ],
      "justification": "Check action, branch, positive guard, and registration action accurately reflect the success path."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "However, if not all the relevant details are provided, inform the claimant to complete them."
      ],
      "justification": "Negative guard and notification action correctly model the failure/incomplete path."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "Once the claim is registered, the process comes to an end."
      ],
      "justification": "Registers the terminal state following successful registration. Redundant end actions and structural nodes are included as they repeat the same termination logic without altering process behavior."
    }
  ],
