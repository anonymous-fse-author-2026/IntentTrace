  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step,"
      ],
      "justification": "The opening clause implicitly defines the process start and explicitly describes the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "checking the Inventory Level."
      ],
      "justification": "Direct paraphrase preserving the action and target variable."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\", then proceed to Create Purchase Order."
      ],
      "justification": "The conditional implies the XOR branch. The guard captures the exact threshold condition. The condition itself is redundantly captured as an action node (acceptable per guidelines). The consequent action matches the source instruction."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "The alternative condition is captured by the guard. The resulting termination action and structural end node align with the explicit termination statement."
    },
    {
      "refs": [
        "label:n2->n3"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\", then proceed to Create Purchase Order.",
        "However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "The label consolidates both branching conditions described across the two source units."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Faithfully restates the review step triggered after purchase order creation."
    },
    {
      "refs": [
        "guard:b2->n8",
        "guard:b2->n9",
        "action:n7",
        "action:n8",
        "action:n9",
        "label:n6->n7"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved, then reserve the funds for the purchase. On the other hand, if the Purchase Order is rejected, then rework the order."
      ],
      "justification": "The XOR branch and guards correctly split the approval/rejection paths. The condition is redundantly captured as an action node. The consequent actions (reserve funds, rework) and the transition label accurately reflect the two outcomes."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Direct mapping of the post-reservation shipping action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Matches the re-review step; the retry nature is implied by the process flow returning to review."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: the Supplier sends a packing slip and an invoice."
      ],
      "justification": "The AND gateway correctly models simultaneous execution. The two child actions faithfully split the compound source instruction."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it."
      ],
      "justification": "Exact match for the packing slip recording step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Similarly, when the invoice is received, record it as well."
      ],
      "justification": "Exact match for the invoice recording step."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice,"
      ],
      "justification": "The synchronization phrase after the parallel tasks implies the convergence point where paths rejoin."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "Direct paraphrase preserving both financial actions and their target."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "The terminal action and structural end node align perfectly with the final closing statement."
    }
