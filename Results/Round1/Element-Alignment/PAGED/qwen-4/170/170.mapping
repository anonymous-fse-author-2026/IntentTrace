{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, go to the Amazon homepage."
      ],
      "justification": "The opening unit implicitly initiates the process and specifies the first navigation step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, search for a book."
      ],
      "justification": "Directly captures the search instruction without altering scope or target."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once you've found the book, click on the link that says \"22 used\" to see the used books available."
      ],
      "justification": "Faithfully restates the exact link label and its intended outcome."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "From there, click on the \"Add to Cart\" button for the second book on the list."
      ],
      "justification": "Preserves the precise button label and the specific positional target (second book)."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After adding it to your cart, click on the \"Proceed to Checkout\" button."
      ],
      "justification": "Exact match for the cart-to-checkout transition action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "On the checkout page, enter your email address and select the option that says \"I am a new customer\"."
      ],
      "justification": "Captures both the data entry requirement and the exact selection option text."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Next, click on the \"Sign in using our secure server\" button."
      ],
      "justification": "Button label and action are reproduced exactly."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once you've signed in, enter your customer details and click on the \"Create account\" button."
      ],
      "justification": "Combines the detail entry and account creation click accurately per the source unit."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After creating your account, enter your shipping details and click on the \"Continue\" button."
      ],
      "justification": "Matches the shipping input requirement and the immediate continuation step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "On the next page, select your preferred shipping options and click on \"Continue\" again."
      ],
      "justification": "Accurately reflects shipping preference selection and the follow-up click action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Then, choose your payment method and enter your credit card details."
      ],
      "justification": "Directly mirrors the payment method selection and associated data entry."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Click on the \"Add your card\" button to save your card information."
      ],
      "justification": "Core button action matches precisely; the explanatory suffix in the source does not introduce a separate executable step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After that, click on \"Continue\" to proceed."
      ],
      "justification": "Faithfully reproduces the continuation action without adding or removing operational details."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Next, choose your billing address and select the option to use the address you've chosen."
      ],
      "justification": "Paraphrase preserves both the address selection and the confirmation choice exactly as structured in the source."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, click on \"Place your order in AUD\" to complete the process."
      ],
      "justification": "The final unit triggers the last action and explicitly signals process completion, supporting both the action and the structural end node."
    }
