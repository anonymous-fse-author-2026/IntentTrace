{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Implicit start, process initiation label, and order placement action collectively cover the opening instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to Check the Customer's Credit Limit."
      ],
      "justification": "Direct match to the credit limit verification step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\""
      ],
      "justification": "Action and guard jointly capture the positive credit response condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article."
      ],
      "justification": "Direct match to the initial availability check."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Guard captures the negative condition; action captures the customer denial step."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "if the response is \"Okay\""
      ],
      "justification": "Action and guard jointly capture the positive condition preceding the second check."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article again."
      ],
      "justification": "Direct match to the repeated availability verification."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Guard captures the negative condition; action matches the denial step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If the Article is not available",
        "proceed to Produce the Goods."
      ],
      "justification": "Action states the condition, guard formalizes it, and action executes production."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "If the Article is not available",
        "proceed to Produce the Goods."
      ],
      "justification": "Action states the condition, guard formalizes it, and action executes production."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the Article is not available",
        "proceed to Produce the Goods."
      ],
      "justification": "Action states the condition, guard formalizes it, and action executes production."
    },
    {
      "refs": [
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "if the Article is available"
      ],
      "justification": "Guard captures availability condition; action matches collection step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "proceed to Collect the Goods."
      ],
      "justification": "Guard captures availability condition; action matches collection step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "send an Order Confirmation."
      ],
      "justification": "Direct match to the confirmation notification step."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "AND gateway and parallel actions correctly model concurrent shipping and invoicing."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Direct match to the payment verification step."
    },
    {
      "refs": [
        "action:n19",
        "guard:b4->n20"
      ],
      "verbatim_texts": [
        "If the payment has been received"
      ],
      "justification": "Action and guard jointly capture the successful payment condition."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "close the Order and end the process."
      ],
      "justification": "Sequential actions and terminal node faithfully implement order closure and process termination."
    },
    {
      "refs": [
        "guard:b4->n22"
      ],
      "verbatim_texts": [
        "If the payment has not been received"
      ],
      "justification": "Guard accurately captures the payment failure condition routing to follow-up logic."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Action describes the check, and XOR branch structurally models the resulting decision point."
    },
    {
      "refs": [
        "guard:b5->n23"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3"
      ],
      "justification": "Guard captures the numeric threshold; action matches the financial write-off step."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Write off the Order."
      ],
      "justification": "Guard captures the numeric threshold; action matches the financial write-off step."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Direct match to the reminder notification step."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Actions and terminal node accurately reflect post-write-off closure and process termination."
    }
