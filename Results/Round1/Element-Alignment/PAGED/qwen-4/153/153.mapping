      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "The opening clause implicitly triggers the start node and explicitly defines the first two sequential actions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "Directly maps to the verification step and the subsequent XOR decision point."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "if not, continue the process."
      ],
      "justification": "The false guard captures the negative condition, and the action faithfully reproduces the instruction."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "True guard, termination action, and end node collectively implement the positive condition and process halt."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again"
      ],
      "justification": "Replicates the second verification step and its associated decision gateway."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->n10",
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Action poses the verification, branch splits the flow, and guards assign the true/false outcomes implied by the check."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Action content faithfully reproduces the recording instruction for the complete-information path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "make a telephone call to the sender."
      ],
      "justification": "Exact match for the fallback action when information is incomplete."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Every Wednesday evening,"
      ],
      "justification": "Temporal condition converted to a verification action and XOR branch, preserving scheduling logic."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "take the letter book and member register to Miranda."
      ],
      "justification": "Guard activates on the affirmative condition; action precisely matches the delivery instruction."
    },
    {
      "refs": [
        "action:n16",
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member,"
      ],
      "justification": "Verification action, decision gateway, and positive guard accurately model the membership outcome check."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Action content directly implements the stamping and dating instruction for approved applicants."
    },
    {
      "refs": [
        "guard:b5->n18"
      ],
      "verbatim_texts": [
