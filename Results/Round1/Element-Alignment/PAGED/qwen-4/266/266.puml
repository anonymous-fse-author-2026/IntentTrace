@startuml
!theme plain
|a_default| Default
|a_default|
start
:Informational meeting (lasts half a day);
:Is meeting successful?;
:v1: Is meeting successful? ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:End process;
stop
else ([v1 = 'Yes'])
:Create storyboard (takes a full day);
split
:Prepare content;
split again
:Design site (takes 10 days);
end split
:Develop site (takes 2 days);
:Review site (lasts 1 day);
:v2: Review site ({Not successful, Successful}); <<objectSignal>>
if () then ([v2 = 'Not successful'])
stop
else ([v2 = 'Successful'])
:Approve site (takes half a day);
:v3: Approve site ({Approved, Rejected}); <<objectSignal>>
if () then ([v3 = 'Approved'])
:End process;
stop
else ([v3 = 'Rejected'])
:Rebuild site (takes 3 days);
:v4: Rebuild site outcome ({Complete, Rejected}); <<objectSignal>>
if () then ([v4 = 'Complete'])
stop
else ([v4 = 'Rejected'])
:Rebuild site again (also takes 3 days);
stop
endif
endif
endif
endif
@enduml