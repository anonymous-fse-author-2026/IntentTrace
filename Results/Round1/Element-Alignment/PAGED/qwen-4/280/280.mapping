{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "The structural init and the opening action both derive from the explicit starting instruction."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "then Check Levels of Inventory"
      ],
      "justification": "Direct correspondence to the second sequential step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the inventory"
      ],
      "justification": "Marks the beginning of the exclusive choice on inventory status."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "is below or equal to the minimum"
      ],
      "justification": "Faithfully captures the threshold operator and value for the lower bound."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report"
      ],
      "justification": "Exact alignment with the prescribed output for the lower bound condition."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "is greater than the minimum"
      ],
      "justification": "Faithfully captures the threshold operator and value for the upper bound."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report"
      ],
      "justification": "Exact alignment with the prescribed output for the upper bound condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)"
      ],
      "justification": "Models the procurement trigger conditioned on the low-inventory report."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "The action restates the termination condition, paired with the structural end node."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If the PO is rejected"
      ],
      "justification": "Captures the negative outcome condition for the PO decision."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "it needs to be reworked."
      ],
      "justification": "Directly implements the mandated rework step upon rejection."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the PO is approved"
      ],
      "justification": "The XOR branch and its positive guard jointly represent the approval decision path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "it is printed and released in the system."
      ],
      "justification": "Accurately models the combined print-and-release action following approval."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Directly implements the mandatory review step for created POs."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs"
      ],
      "justification": "The timing keyword explicitly triggers an AND-split for concurrent execution."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs"
      ],
      "justification": "Implements the first concurrent task from the simultaneous instruction."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "and mail the POs to the supplier."
      ],
      "justification": "Implements the second concurrent task joined by 'and'."
    },
    {
      "refs": [
        "label:n10->n12"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Label extracts the precondition governing the transition to packing slip receipt."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Action implements the downstream receipt step enabled by the reservation."
    },
    {
      "refs": [
        "label:n11->n13"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Label extracts the mailing precondition for the inventory receipt path."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Action implements the downstream inventory receipt step."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Both the guard and action faithfully model the conditional progression to invoice receipt."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Both the guard and action faithfully model the conditional progression to packing slip receipt."
    },
    {
      "refs": [
        "label:n15->n17"
      ],
      "verbatim_texts": [
        "If the Invoice is received"
      ],
      "justification": "Label captures the state transition required before matching."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match."
      ],
      "justification": "Action executes the matching procedure specified in the sequence."
    },
    {
      "refs": [
        "guard:b5->n18"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful"
      ],
      "justification": "Guard accurately reflects the success condition for fund release."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "release the funds."
      ],
      "justification": "Action directly implements the financial clearance step."
    },
    {
      "refs": [
        "label:n18->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Label and action jointly capture the temporal condition and the payment issuance."
    },
    {
      "refs": [
        "label:n19->n20"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete"
      ],
      "justification": "Label tracks the completion state following payment."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete"
      ],
      "justification": "Action marks the cyclical completion milestone."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Structural end node anchors the explicit termination statement."
    }
  ],
