init(i1)
action(n1, "start process")
action(n2, "receive form")
action(n3, "is form complete")
branch(b1, XOR)
action(n4, "send back form")
action(n5, "end process")
end(e1)
action(n6, "check income")
action(n7, "check deductibles")
action(n8, "check house")
action(n9, "is declaration needed")
branch(b2, XOR)
action(n10, "end process")
end(e2)
action(n11, "invite declarant")
action(n12, "end process")
end(e3)
converge(c1)
branch(b3, AND)
defines(v1, "next step after form check", {'needs to be sent back', 'need to check the income'})
defines(v2, "next step after parallel checks", {'need to check the declaration', 'need to invite the declarant'})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, e1, n6, n7, n8, n9, b2, n10, e2, n11, n12, e3, c1, b3])
precedence(i1, n1)
precedence(n3, b1)
precedence(n5, e1)
precedence(n9, b2)
precedence(n10, e2)
precedence(n12, e3)
precedence(c1, n9)
precedence(n6, b3)
precedence(n1, n2)
precedence(n2, n3)
precedence(b1, n4)
precedence(n4, n5)
precedence(b1, n6)
precedence(b3, n7)
precedence(b3, n8)
precedence(n7, c1)
precedence(n8, c1)
precedence(b2, n10)
precedence(b2, n11)
precedence(n11, n12)
guard(b1, n4, v1 = 'needs to be sent back')
guard(b1, n6, v1 = 'need to check the income')
guard(b2, n10, v2 = 'need to check the declaration')
guard(b2, n11, v2 = 'need to invite the declarant')