  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "The opening clause implicitly starts the process and explicitly describes the two sequential UI interactions modeled as action steps."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000,"
      ],
      "justification": "The conditional clause opens the XOR decision and is captured as an action-style check node per modeling convention."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the report should be reviewed."
      ],
      "justification": "Direct paraphrase of the positive arm action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Captures the fallback path instruction to check for translation needs."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "The conditional opens a split for translation requirements and directly describes the translate action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Direct paraphrase of the negative translation path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Exact match for the first review evaluation step."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "The branch splits on review outcome; the guard preserves the 'Rejected' value and targets the correct edit action."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Guard correctly carries the 'Approved' outcome leading to the translation check."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Faithful reproduction of the final decision evaluation step (minor plural/singular variation is acceptable)."
    },
    {
      "refs": [
        "guard:b5->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Branch, guard, and action jointly preserve the accepted outcome and target process step."
    },
    {
      "refs": [
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Guard and action correctly preserve the rejected outcome and loop back to editing."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Closing sentence maps to the terminal action and structural end node."
    }
