{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "The span initiates the process and specifies two sequential steps. init:i1 handles the process start, action:n2 captures 'Orders Required', action:n3 captures 'place a Bulk order', and action:n1 is tolerated as redundant restatement of the start."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
      ],
      "justification": "Defines the positive conditional path. action:n4 holds the condition text, branch:b1 splits the flow, guard:b1->n5 routes the true path, and action:n5 executes the delivery processing."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance."
      ],
      "justification": "Directly captures the resulting state/action described in the span."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "In the case of an Outstanding Balance, a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "Accurately reflects the step to place a new order upon outstanding balance."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If a new order is placed, it will be recorded in the Accounts Receivable."
      ],
      "justification": "Directly matches the recording step for new orders."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If Payments are Received, the process continues."
      ],
      "justification": "Models the positive payment condition continuing the workflow. action:n9 holds the condition, branch:b2 splits, guard routes true, action:n10 continues."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "However, if no payments are received, the order is dropped."
      ],
      "justification": "Accurately captures the action taken when payments fail."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Next, identify the order for installation."
      ],
      "justification": "Exact match for the installation identification step."
    },
    {
      "refs": [
        "action:n14",
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled, an Installer will be assigned."
      ],
      "justification": "Models the positive scheduling condition. action:n14 paraphrases the need to schedule, branch splits, guard routes true, action:n15 assigns the installer."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "On the other hand, if the order does not require installation, it will be packed for delivery."
      ],
      "justification": "Directly matches the packing step when installation is unnecessary."
    }
  ],
