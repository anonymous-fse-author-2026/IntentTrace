      "verbatim_texts": [
        "To begin the process in the Admin Office, first check if it has started."
      ],
      "justification": "The opening span implicitly triggers the process start (init), contains the explicit launch instruction (n1), and specifies the preliminary status verification (n2)."
    },
    {
