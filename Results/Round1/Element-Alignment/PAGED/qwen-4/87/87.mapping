    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If the invoices are still marked as \"Uncompleted\", they should be returned to the client via postal mail."
      ],
      "justification": "Matches the repeated directive for returning uncompleted invoices."
    },
    {
