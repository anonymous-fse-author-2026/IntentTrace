  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "The init and action elements collectively capture the explicit starting signal and the two initial procedural steps described in the opening clause."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Models the conditional check, the XOR decision gate, the positive guard, and the corresponding return action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "The false guard and subsequent action faithfully represent the continuation path when completeness is confirmed."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Captures the secondary decision point and branching logic for compliance verification."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Directly maps the phone-resolution condition and the resulting remediation action."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Accurately reflects the alternative condition and the mail-back return action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "the following steps are completed: Bill Client."
      ],
      "justification": "Faithfully extracts and implements the core instructional step after filtering out the announcing phrasing."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Models the no-response check, the decision split, and the explicit 10-day waiting period action."
    },
    {
      "refs": [
        "guard:b3->c1",
        "action:n11"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Routes the alternative path (response received) to the convergence point and executes the combined payment/notification step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Exact reproduction of the time-bound reminder and explicit process termination."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->c1"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Combines the conditional trigger, decision node, and discrepancy resolution action as specified."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Matches the satisfaction condition and the explicit continuation directive."
    }
  ],
