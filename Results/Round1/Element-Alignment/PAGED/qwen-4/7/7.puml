!theme plain
|a_default| Default
|a_default|
start
:wake up;
:are you hungry?;
:v1: are you hungry? ({hungry, not_hungry}); <<objectSignal>>
if () then ([v1 = 'not_hungry'])
:take a shower;
else ([v1 = 'hungry'])
:have breakfast;
split
:are you still hungry after breakfast?;
:v2: are you still hungry after breakfast? ({hungry, not_hungry}); <<objectSignal>>
if () then ([v2 = 'not_hungry'])
:take a shower;
else ([v2 = 'hungry'])
:have breakfast again;
endif
:get on the bus;
split again
:get on the bus;
end split
:end process;
stop
endif
