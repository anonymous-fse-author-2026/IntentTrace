      ],
      "verbatim_texts": [
        "i11: At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "All four elements reproduce the concurrent final tasks exactly. Duplicate implementation does not alter behavior and remains a match."
    }
