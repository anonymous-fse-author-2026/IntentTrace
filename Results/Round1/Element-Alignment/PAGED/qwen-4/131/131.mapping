    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "The opening phrase implies the process start (init) and explicitly commands the first physical action (empty the mailbox)."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n19",
        "action:n4"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty, if not, continue the process. If it is empty, the process ends."
      ],
      "justification": "Models the check action, the XOR split, both conditional guards (positive/negative), the termination action, and the structural end node corresponding to the full clause."
    },
    {
      "refs": [
        "action:n19",
        "guard:b5->e1",
        "guard:b5->n5"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again, if not, continue the process. If it is empty, the process ends."
      ],
      "justification": "Captures the second verification check, the XOR split, the two outcome guards, and the shared structural end node for the positive path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Directly models the verification step and the implicit decision point that follows."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Guard represents the positive condition; action faithfully captures the recording instruction."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Guard represents the negative condition; action directly matches the phone call instruction."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Action accurately restates the post-call data completion step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Exact alignment with the scheduled transport task."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Models the membership condition check as an action step (permitted), splits via XOR, applies the positive guard, and executes the stamping/dating action."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Guard captures the negative condition; action performs the notification; subsequent action and end node handle the implicit termination of this decision branch."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Directly matches the follow-up data writing step."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles. Ask Charles to write the amount in the register."
      ],
      "justification": "AND branch and convergence nodes correctly model the simultaneous tasks; actions cover fee calculation and the combined hand-off/register request."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Exact match for the card printing and dispatch step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Explicitly states process termination, mapped to the final action and structural end node."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Hand the letter to Charles and add the new member to the register."
      ],
      "justification": "Faithfully combines the hand-off and registration update steps."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Prepare an invoice for the new members and continue the process."
      ],
      "justification": "Directly captures the invoice preparation step; continuation is implicit flow."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register and write the fee amount to the register."
      ],
      "justification": "Action captures the second clause of the dual instruction; convergence node handles the rejoined flow after prior parallel/steps."
    }
