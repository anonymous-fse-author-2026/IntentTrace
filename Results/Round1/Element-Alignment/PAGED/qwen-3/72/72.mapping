      ],
      "reason": "Invents a standalone 'start' step. The source only indicates the process begins with the billing/receiving actions (i1)."
    },
    {
      "refs": [
        "action:n5"
      ],
      "reason": "Adds 'End of process:' terminology to the incompleteness return. The source (i2) only specifies the invoice is returned, with no mention of terminating the overall process."
    },
    {
      "refs": [
        "action:n10"
      ],
      "reason": "Adds 'End of process:' terminology to the mail-back return. The source (i6) only specifies the invoice is returned, without signaling process termination."
    },
    {
      "refs": [
        "action:n18"
      ],
      "reason": "Duplicates the payment/notification content of i9 but appends 'End of process:', inventing a terminal step not present in the source."
    }
  ],
