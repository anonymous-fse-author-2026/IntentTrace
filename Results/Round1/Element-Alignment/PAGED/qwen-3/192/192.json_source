  "input_elements": [
    {
      "id": "i1",
      "content": "For the DMS Parts Provision Team, the first step is to gather information about the part from the customer, including the make, model, and year."
    },
    {
      "id": "i2",
      "content": "the team proceeds to check the availability of the part in the local inventory."
    },
    {
      "id": "i3",
      "content": "If the part is found to be available locally"
    },
    {
      "id": "i4",
      "content": "is found to be available locally"
    },
    {
      "id": "i5",
      "content": "it is retrieved from the inventory"
    },
    {
      "id": "i6",
      "content": "However, if the part is not available locally"
    },
    {
      "id": "i7",
      "content": "is not available locally"
    },
    {
      "id": "i8",
      "content": "the team records the customer's details"
    },
    {
      "id": "i9",
      "content": "After retrieving the part from the local inventory, the process comes to an end."
    },
    {
      "id": "i10",
      "content": "and then orders the part from Disuki"
    },
    {
      "id": "i11",
      "content": "Once the part is ordered from Disuki, the process comes to an end."
    }
  ]
}