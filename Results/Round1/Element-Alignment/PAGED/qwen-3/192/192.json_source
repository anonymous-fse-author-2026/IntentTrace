      "id": "n1",
      "type": "action",
      "content": "start"
    },
    {
      "id": "n2",
      "type": "action",
      "content": "gather information about part from customer (make  model  year)"
    },
    {
      "id": "n3",
      "type": "action",
      "content": "check availability of part in local inventory"
    },
    {
      "id": "b1",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "n4",
      "type": "action",
      "content": "retrieve part from local inventory"
    },
    {
      "id": "n5",
      "type": "action",
      "content": "end procedure"
    },
    {
      "id": "e1",
      "type": "end"
    },
    {
      "id": "n6",
      "type": "action",
      "content": "record customer details"
    },
    {
      "id": "n7",
      "type": "action",
      "content": "order part from Disuki"
    },
    {
      "id": "n8",
      "type": "action",
      "content": "end procedure"
    },
    {
      "id": "e2",
      "type": "end"
    }
  ],
  "variable_definitions": [
