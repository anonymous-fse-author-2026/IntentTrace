|a_default|
start
:start;
:initiate new resupply cycle;
:check levels of inventory;
:is inventory below or equal to minimum?;
:v1: inventory status ({Below or Equal, Above}); <<objectSignal>>
if () then ([v1 = 'Above'])
:generate above minimum report;
:end process;
else ([v1 = 'Below or Equal'])
:generate equal to or below minimum report;
repeat :;
:create Purchase Orders (POs);
:review PO;
:v2: PO review status ({Rejected, Approved}); <<objectSignal>>
backward:rework PO;
repeat while () is ([v2 = 'Rejected']) not ([v2 = 'Approved'])
:print and release PO;
split
:reserve funds for released POs;
split again
:mail POs to supplier;
:receive inventory;
end split
:receive Packing Slip;
:receive Invoice;
:Three-way match;
:release funds;
:issue payment;
:Resupply Cycle complete;
endif
