{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially"
      ],
      "justification": "The init node marks the process start, and action n1 restates the initial trigger/setup described in i1."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Action n2 captures the verification step described in i2, omitting only the leading imperative 'you should check if', which is structurally handled by the subsequent branch."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Branch b1 creates the decision point, guard v1='Yes' matches the condition, and action n3 executes the specified discussion step."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Guard v1='No' represents the 'Otherwise' path, and converge c1 merges it back to the main flow as instructed."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Action n4 models the check from i5. Converge c2 handles the implicit rejoin if the answer is 'No', aligning with standard XOR behavior."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits."
      ],
      "justification": "Branch b2 splits on the 'Yes' answer, guard v2='Yes' enforces it, and action n5 performs the limit check described in i6."
    },
    {
      "refs": [
        "guard:b3->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "Branch b3 evaluates the limit check. Guard v3='No' matches 'If it is not', and action n6 relays changes, adding contextual phrasing that preserves core meaning."
    },
    {
      "refs": [
        "guard:b3->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process. After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Guard v3='Yes' matches the positive limit condition, and action n7 condenses the two sequential instructions from i8 while retaining both operations."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Exact verbal match to i9."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Exact verbal match to i10."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Exact verbal match to i11."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Exact verbal match to i12."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Exact verbal match to i13."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Action n13 models the check from i14, and branch b4 provides the explicit decision gateway."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If they are, continue with the process."
      ],
      "justification": "Guard v4='Yes' and action n14 directly implement the positive outcome of i15."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If not, select a new applicant from the list."
      ],
      "justification": "Guard v4='No' and action n15 directly implement the negative outcome of i16."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Action n16 models the check from i17, and branch b5 provides the decision gateway."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Guard v5='Yes', action n17 ('End'), and terminal e1 collectively realize the process termination described in i18."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Guard v5='No' and action n18 directly implement the fallback selection from i20."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Mirrors i17 exactly as the source text duplicates this check."
    },
    {
      "refs": [
        "guard:b6->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Guard v6='Yes', action n20 ('End'), and terminal e2 realize the second duplicated termination step from i19."
    },
    {
      "refs": [
        "guard:b6->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Guard v6='No' and action n21 implement the duplicated fallback from i20."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Redundant terminal action and node mirroring the final duplicated ending in the source text (i19)."
    }
