@startuml
!theme plain
|a_default| Default
|a_default|
start
:start WIGGO process;
:Place Order;
:Check Customers Credit Limit;
:v1: Credit Limit Okay ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:Send Denial To Customer;
else ([v1 = 'Yes'])
:Check Availability Of Article;
:Article Available;
:v2: Article Available ({No, Yes}); <<objectSignal>>
if () then ([v2 = 'No'])
:Produce the Goods;
else ([v2 = 'Yes'])
:Collect the Goods;
endif
:Send Order Confirmation;
split
:Ship the Goods;
split again
:Send Invoice;
end split
:Check Payment Status;
:Payment Received;
:v3: Payment Received ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:Close the Order;
:End;
else ([v3 = 'No'])
:Reminder Count Ge 3;
:v4: Reminder Count Ge 3 ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:Write Off the Order;
:Send Reminder;
:Close the Order;
:End;
stop
else ([v4 = 'No'])
stop
endif
endif
endif
stop
@enduml