      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the interviews, it is necessary to receive feedback from the interview candidates."
      ],
      "justification": "Direct match for the feedback collection step with unchanged wording and scope."
    },
    {
      "refs": [
        "action:n9",
