  "input_elements": [
    {
      "id": "i1",
      "content": "Initially, there is a User Task."
    },
    {
      "id": "i2",
      "content": "If the task is \"Service Task 1\""
    },
    {
      "id": "i3",
      "content": "then the process should continue."
    },
    {
      "id": "i4",
      "content": "If it is \"Service Task 2\""
    },
    {
      "id": "i5",
      "content": "the process should also continue."
    },
    {
      "id": "i6",
      "content": "However, if it is \"Service Task 3\", then the process will come to an end."
    },
    {
      "id": "i7",
      "content": "After that, if there is a Manual Task"
    },
    {
      "id": "i8",
      "content": "the process will end."
    }
  ]
