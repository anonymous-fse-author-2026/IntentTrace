init(i1)
action(n1, "Start User Task")
action(n2, "Is User Task Service Task 1?")
branch(b1, XOR)
action(n3, "Continue Process after Service Task 1")
action(n4, "Is User Task Service Task 2?")
branch(b2, XOR)
action(n5, "Continue Process after Service Task 2")
action(n6, "End Process due to Service Task 3")
end(e1)
action(n8, "Is there a Manual Task?")
branch(b3, XOR)
action(n9, "End Process if Manual Task Yes")
end(e2)
end(e4)
converge(c1)
defines(v1, "Is User Task Service Task 1?", {true, false})
defines(v2, "Is User Task Service Task 2?", {true, false})
defines(v3, "Is there a Manual Task?", {true, false})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, b2, n5, n6, e1, n8, b3, n9, e2, e4, c1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, b2)
precedence(b2, n5)
precedence(b2, n6)
precedence(n5, c1)
precedence(n6, e1)
precedence(c1, n8)
precedence(n8, b3)
precedence(b3, n9)
precedence(b3, e4)
precedence(n9, e2)
guard(b1, n3, v1 = true)
guard(b1, n4, v1 = false)
guard(b2, n5, v2 = true)
guard(b2, n6, v2 = false)
guard(b3, n9, v3 = true)
guard(b3, e4, v3 = false)