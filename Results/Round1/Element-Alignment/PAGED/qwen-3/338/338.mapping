  "matches": [
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "is selected"
      ],
      "justification": "Boolean guard v1 = 'Yes' faithfully represents the positive selection condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\""
      ],
      "justification": "Direct extraction of the prescribed action."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the option is not selected"
      ],
      "justification": "Boolean guard v1 = 'No' faithfully represents the negative condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then \"provide indications\""
      ],
      "justification": "Exact action content matches the source phrase."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "and proceed with the research schedule."
      ],
      "justification": "The conjunctive 'and proceed with...' implies a flow merge (converge) followed by the research schedule action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule,"
      ],
      "justification": "Temporal marker aligns with the validation step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory."
      ],
      "justification": "Explicitly describes the second decision gateway."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If it is not,"
      ],
      "justification": "Guard v2 = 'No' matches the unsatisfactory branch condition."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "then perform the action \"Research schedule\"."
      ],
      "justification": "Exact match for the retry action on unsatisfactory result."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "If it is,"
      ],
      "justification": "Guard v2 = 'Yes' matches the satisfactory branch condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Action content is a direct noun-verb paraphrase of the source instruction."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\". If it is still not satisfactory, then \"provide indications\". Alternatively, if the schedule is satisfactory,"
      ],
      "justification": "Captures the contextual setup for the second scheduling review decision."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory,"
      ],
      "justification": "Guard v3 = 'No' aligns with the repeated failure condition."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "then \"provide indications\"."
      ],
      "justification": "Exact match for the fallback instruction."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory,"
      ],
      "justification": "Guard v3 = 'Yes' and structural converge capture the successful path merging back to ticket creation."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Direct match for the first ticket validation step."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "First approval verification decision."
    },
    {
      "refs": [
        "guard:b4->e2"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Negative approval condition correctly routes to a termination node."
    },
    {
      "refs": [
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If it is approved, then"
      ],
      "justification": "Positive condition guard for proceeding to next validation."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "validate the ticket order."
      ],
      "justification": "Exact match for the second validation instruction."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Second approval verification decision."
    },
    {
      "refs": [
        "guard:b5->e3"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Negative approval condition correctly routes to a termination node."
    },
    {
      "refs": [
        "guard:b5->n19"
      ],
      "verbatim_texts": [
        "If it is approved, then"
      ],
      "justification": "Positive condition guard for proceeding to final validation."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "validate the ticket order."
      ],
      "justification": "Exact match for the third validation instruction."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Final approval verification decision."
    },
    {
      "refs": [
        "guard:b6->e4"
      ],
      "verbatim_texts": [
