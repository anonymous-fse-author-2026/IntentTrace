@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:trigger: resupply cycle;
:check: inventory level;
:v1: check  inventory level ({above_min, below_min}); <<objectSignal>>
if () then ([v1 = 'above_min'])
:end process: above minimum;
stop
else ([v1 = 'below_min'])
:create: purchase order;
:review: purchase order;
:v2: review  purchase order ({rejected, accepted}); <<objectSignal>>
switch ()
case ([v2 = 'rejected'])
:rework: purchase order;
:review: purchase order;
:v3: review  purchase order ({rejected, accepted}); <<objectSignal>>
if () then ([v3 = 'rejected'])
stop
else ([v3 = 'accepted'])
stop
endif
case ([v2 = 'accepted'])
:reserve funds and send PO;
:receive packing slip and release funds;
:end process: completed;
case ([v2 = 'accepted'])
:send to supplier;
:receive packing slip and release funds;
:end process: completed;
endswitch
endif
@enduml