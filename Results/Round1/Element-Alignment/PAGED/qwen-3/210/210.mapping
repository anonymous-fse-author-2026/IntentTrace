      ],
      "verbatim_texts": [
        "Once the request is received, the next step is to either continue the process if a production order is received or update the sales information and proceed to order dispatch."
      ],
      "justification": "Captures the condition check (modeled as action per permitted typing), the XOR split, and both resulting sequential action paths."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier."
      ],
      "justification": "Condition check, structural split, and ordering action align exactly with the source clause."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Alternatively, if there are available goods for production, a manufacturing order is placed."
      ],
      "justification": "Alternative condition, branch structure, and manufacturing order action are faithfully represented."
    },
    {
      "refs": [
        "action:n10",
