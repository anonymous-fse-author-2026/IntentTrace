    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Models the compliance check and routes the negative outcome to the further checks action."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if the invoice is compliant, the process continues."
      ],
      "justification": "Positive guard directs flow to the explicit continue action, preserving the source logic."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n9",
        "action:n9",
        "action:n14",
        "guard:b6->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Source repeats this clause. Both model paths capture the phone-call condition and the resolution action."
    },
    {
      "refs": [
        "action:n10",
