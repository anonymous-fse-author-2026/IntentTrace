      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Covers the explicit start node and the first two sequential actions described in the opening unit."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4",
        "action:n12",
        "guard:b5->n13",
        "action:n13"
      ],
      "verbatim_texts": [
