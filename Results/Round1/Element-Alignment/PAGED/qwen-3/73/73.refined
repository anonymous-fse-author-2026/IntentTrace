init(i1)
action(n1, "Begin process for Wiggo Company")
action(n2, "Check authority to make a purchase")
action(n3, "Is purchase authority granted?")
branch(b1, XOR)
action(n4, "Refuse to fulfill the order and end the process")
end(e1)
action(n5, "Verify availability")
action(n6, "Is item in stock?")
branch(b2, XOR)
action(n7, "End process")
end(e2)
defines(v1, "Is purchase authority granted?", {"no", "okay"})
defines(v2, "Is item in stock?", {"yes", "no"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, e1, n5, n6, b2, n7, e2])
precedence(i1, n1)
precedence(n3, b1)
precedence(n4, e1)
precedence(n6, b2)
precedence(n7, e2)
precedence(n1, n2)
precedence(n2, n3)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, n6)
precedence(b2, n7)
guard(b1, n4, v1 = 'no')
guard(b1, n5, v1 = 'okay')
guard(b2, n7, v2 = 'yes')