    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should leave the area."
      ],
      "justification": "Maps directly to the required departure action upon denial."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "The positive permission outcome and subsequent progression step are faithfully represented."
    },
    {
      "refs": [
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful"
      ],
      "justification": "Establishes the third decision point based on check outcome, routing via the 'Unsuccessful' guard."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the passenger should leave the area and the process ends."
      ],
      "justification": "Accurately captures the departure instruction and explicit process termination for the failure case."
    },
    {
