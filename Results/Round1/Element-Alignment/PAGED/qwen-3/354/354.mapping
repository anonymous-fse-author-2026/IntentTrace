    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics, they should undergo a check using biometrics."
      ],
      "justification": "The conditional trigger justifies the XOR branch and guard, while the consequent maps precisely to the biometrics check action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "if the passenger prefers to use ID documents, they should undergo checks using identity documents."
      ],
      "justification": "The alternative choice and its corresponding verification step are accurately captured by the second guard and action on the same branch."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
