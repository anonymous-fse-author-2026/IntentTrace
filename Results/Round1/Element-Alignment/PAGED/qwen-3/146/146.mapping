        "label:n7->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "After that, we send the offer, and once the offer is sent, we wait for the customer to accept it."
      ],
      "justification": "Actions match the send and wait steps; label faithfully reflects the 'offer sent' state transition."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the customer accepts the offer, we dispatch the article."
      ],
      "justification": "Action content directly matches the dispatch instruction."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Finally, once the article is dispatched, the process comes to an end."
      ],
      "justification": "Action and end node jointly capture the final termination step and closing signal."
    }
