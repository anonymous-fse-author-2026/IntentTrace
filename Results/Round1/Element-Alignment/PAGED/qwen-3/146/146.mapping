    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if the article is not available, we abort the enquiry and end the process."
      ],
      "justification": "Guard captures the negative availability condition; end node correctly models the process termination signal."
    },
    {
      "refs": [
        "action:n5",
