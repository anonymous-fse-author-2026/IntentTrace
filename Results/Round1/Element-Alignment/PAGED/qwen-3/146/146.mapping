        "action:n6"
      ],
      "verbatim_texts": [
        "First, we reserve the article, and once it is reserved, we calculate the price."
      ],
      "justification": "Actions match the reserve and calculate steps; label accurately captures the 'once reserved' transition condition."
    },
    {
