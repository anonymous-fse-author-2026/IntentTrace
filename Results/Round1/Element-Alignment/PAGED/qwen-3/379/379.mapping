{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "The opening clause implicitly initiates the process and explicitly describes the first two sequential actions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report. If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "The conditional clause establishes the XOR decision point, with the action modeling the condition check itself."
    },
    {
      "refs": [
        "guard:b1->n4",
        "guard:b1->n5",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report. If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "The guards capture the split conditions and the actions execute the respective report generation instructions."
    },
    {
      "refs": [
        "action:n7",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs). If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Covers the positive arm (creating POs), the negative arm termination, and the implicit end node."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Directly implements the review requirement for newly created POs."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked. If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Establishes the XOR gateway for approval status, with the action modeling the status check."
    },
    {
      "refs": [
        "guard:b2->n10",
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked. If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Guards accurately reflect the approved and rejected decision branches."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "it needs to be reworked."
      ],
      "justification": "Maps directly to the rejection outcome instruction."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "it is printed and released in the system."
      ],
      "justification": "Maps directly to the approval outcome instruction."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "The AND gateway captures the simultaneous execution, followed by the two parallel actions."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive the Packing Slip."
      ],
      "justification": "Exact implementation of the packing slip receipt step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "receive the inventory."
      ],
      "justification": "Exact implementation of the inventory receipt step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "proceed to receive the Invoice."
      ],
      "justification": "Directly matches the invoice receipt progression."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Faithfully restates the transition to the matching phase."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful",
        "release the funds."
      ],
      "justification": "Combines the success condition and the subsequent fund release into a single faithful action."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment. After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Covers the payment issuance, cycle completion statement, and process termination."
    }
  ],
