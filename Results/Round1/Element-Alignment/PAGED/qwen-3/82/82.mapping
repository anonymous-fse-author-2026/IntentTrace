      ],
      "justification": "AND branch and labels correctly model concurrent execution of receiving the slip and invoice."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After receiving the packing slip, we record it."
      ],
      "justification": "Explicit match for recording the packing slip."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Similarly, after receiving the invoice, we record it as well."
      ],
      "justification": "Explicit match for recording the invoice."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
