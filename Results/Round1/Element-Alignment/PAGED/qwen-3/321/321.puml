@startuml
!theme plain
|a_default| Default
|a_default|
start
:start buyer process;
:choose a book;
:choose what to do after selecting book;
:v1: choose what to do after selecting book ({view details, new copies, used copies}); <<objectSignal>>
switch ()
case ([v1 = 'view details'])
:view book details;
:choose what to do after viewing book details;
:v2: choose what to do after viewing book details ({new copies, select copy}); <<objectSignal>>
if () then ([v2 = 'new copies'])
:view list of new copies from book details;
-> After selecting preferred copy;
else ([v2 = 'select copy'])
:select a copy and complete process;
-> After selecting preferred copy;
endif
case ([v1 = 'new copies'])
:view list of new copies;
-> After selecting preferred copy;
case ([v1 = 'used copies'])
:view list of used copies;
:evaluate list of used copies;
:select preferred copy and complete process;
-> After selecting preferred copy;
endswitch
:End;
stop
@enduml