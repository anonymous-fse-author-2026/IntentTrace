      ],
      "justification": "Direct mapping to the inventory check action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\","
      ],
      "justification": "Conditional text supports both the condition-modeled-as-action node and the XOR branch gateway."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
