      ],
      "justification": "Exact match for the positive-arm action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "Covers the negative-arm termination action and the explicit process end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
