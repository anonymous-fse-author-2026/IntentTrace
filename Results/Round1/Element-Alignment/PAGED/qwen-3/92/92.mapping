      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "Structural init node implicitly marks the process commencement signaled by the opening clause."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request. However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "Action n2 models the condition as a step (permitted), while branch b1 structurally represents the XOR split implied by the fee-based decision."
    },
    {
