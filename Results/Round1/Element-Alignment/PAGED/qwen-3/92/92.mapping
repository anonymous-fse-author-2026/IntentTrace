      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "you need to create a purchase request."
      ],
      "justification": "Direct, faithful extraction of the fee path action."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Structural end node precisely captures the explicit termination signal in this branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Faithfully restates the approval verification step."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
