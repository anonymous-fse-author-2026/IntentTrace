    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the User Create Account is followed by Enter Country."
      ],
      "justification": "Faithfully captures the sequential transition and the exact next step described."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the country is entered, the next step is to Enter Credit Card and Bank Details."
      ],
      "justification": "Matches the conditional timing and the exact subsequent action payload."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the Credit Card and Bank Details are entered, the next step is to Enter Personal Details."
      ],
      "justification": "Exact replication of the sequential step and its triggering context."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After entering the Personal Details, the next step is to Verify Personal Account."
      ],
      "justification": "Direct alignment with the final preparatory action before branching."
    },
    {
      "refs": [
        "guard:b1->n7",
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the account is not verified, then the Account Creation is rejected. However, if the account is verified, then the Account Creation is confirmed."
      ],
      "justification": "The compound conditional fully justifies the XOR branch node and both outgoing guards. The guard payloads accurately translate the verification states into discrete conditions."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "In case of Account Creation Rejection, the process ends with the Account Creation being rejected."
      ],
      "justification": "The rejection outcome action and the explicit process termination are both directly sourced from this unit."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the Account Creation is confirmed, the process ends with the Account Successfully Created."
      ],
      "justification": "The confirmation outcome action and the corresponding terminal state are faithfully extracted from this closing clause."
    }
