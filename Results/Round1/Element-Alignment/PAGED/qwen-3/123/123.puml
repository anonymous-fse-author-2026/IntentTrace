@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start Metal Works Process;
:Obtain raw material from received list;
:Is raw material available in stock?;
:v1: Is raw material available in stock? ({Available, Not Available}); <<objectSignal>>
if () then ([v1 = 'Available'])
:Check raw material;
:Conclude process with available stock;
:End;
stop
else ([v1 = 'Not Available'])
:Select supplier;
:Send material purchase order;
:Check raw material after PO;
:Conclude process with purchased stock;
:End;
stop
endif
@enduml