{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "The opening clause implicitly triggers the process start and explicitly describes the initial prioritization action."
    },
    {
      "refs": [
        "action:n2",
        "action:n3",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the customer exists, we move on to checking their payment history."
      ],
      "justification": "The conditional opens the XOR branch. Action n2 captures the existence check, action n3 captures checking payment history, and the guard routes the positive case."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "On the other hand, if the customer does not exist, we need to verify their customer status."
      ],
      "justification": "Directly matches the negative arm of the customer existence check and the subsequent status verification step."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process."
      ],
      "justification": "Action n5 evaluates the payment history condition, b2 represents the decision point, and the guard routes the positive outcome forward."
    },
    {
      "refs": [
        "action:n7",
        "action:n8",
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Faithfully reproduces the private customer condition, the XOR split, and the corresponding decline message action."
    },
    {
      "refs": [
        "action:n9",
        "action:n10",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Matches the alternative branch outcome: creating a new customer and checking availability, routed by the negative guard of the previous split."
    },
    {
      "refs": [
        "action:n11",
        "action:n12",
        "action:n13",
        "guard:b4->n12"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Captures the availability check condition, the production/decline action, the explicit process termination step, and the end node signaled by the text."
    },
    {
      "refs": [
        "action:n14",
        "guard:b4->c2"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Directly matches the positive availability branch leading to continuation and confirmation."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "The timing word 'simultaneously' correctly maps to an AND parallel split, followed by the two distinct notification actions."
    },
    {
      "refs": [
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Accurately segments the compound preparation step into packing, invoicing, and the resulting ready state."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Models the closure precondition and the subsequent delivery action as sequential steps, preserving the original meaning."
    },
    {
      "refs": [
        "action:n22",
        "action:n23",
        "guard:b5->n23"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Faithfully reproduces the payment receipt check, the decision gateway, and the resulting order closure action."
    },
    {
      "refs": [
        "action:n24",
        "guard:b5->n24"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Correctly maps the negative payment branch to the reminder quantity check step."
    },
    {
      "refs": [
        "action:n25",
        "action:n26",
        "guard:b6->n26"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Preserves the exact threshold condition (<3), the decision split, and the continuation action."
    },
    {
      "refs": [
        "action:n27",
        "action:n28",
        "guard:b6->n27"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Accurately captures the high-reminder threshold outcome, the donning activation, and the explicitly stated process termination."
    }
  ],
  "mutations": [],
  "omissions": [
    {
      "verbatim_texts": [
        "Then, we proceed to check the customer's information."
      ],
      "reason": "The source explicitly defines a preliminary step to check general customer information, but the model skips directly to evaluating customer existence without implementing this distinct instructional step."
    }
  ],
  "additions": [
    {
      "refs": [
        "action:n6"
      ],
      "reason": "These elements route an immediate declining message when payment history is not good. The source text specifies checking customer type (private/wholesaler) instead, providing no support for an automatic decline at this junction."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "reason": "These elements route an immediate declining message when payment history is not good. The source text specifies checking customer type (private/wholesaler) instead, providing no support for an automatic decline at this junction."
    },
    {
      "refs": [
        "action:n29"
      ],
      "reason": "Explicitly models 'End process after closing order'. The source text indicates order closure leads to delivery (i12) or follows payment receipt (i13), but never signals process termination here."
    },
    {
      "refs": [
        "action:n30"
      ],
      "reason": "Explicitly models 'End process after continuing process'. The source repeatedly uses 'continue with the process' to indicate ongoing flow, not termination."
    },
    {
      "refs": [
        "action:n31"
      ],
      "reason": "Explicitly models 'End process after sending declining message to private customer'. The source text describes sending the message but does not state that the overall process ends at this point."
    }
  ],
