@startuml
!theme plain
|a_default| Default
|a_default|
start
:choose a book;
:do you want to view book details;
split
:view: book details;
:do you want to select a copy or view new copies?;
:v1: do you want to select a copy or view new copies? ({Select copy, View new copies}); <<objectSignal>>
if () then (["v1 = 'Select copy'"])
:select a copy;
:end procedure;
stop
else (["v1 = 'View new copies'"])
:view: new copies;
endif
split again
:view: used copies;
end split
:evaluate and select a copy from the list;
:end procedure;
stop
