{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process for the election of a rector, it is necessary to begin with the rector's final year in their current position."
      ],
      "justification": "The opening clause implicitly triggers the process start node and defines the initial setup action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "the acceptance of proposals for candidates for the rector position should be launched"
      ],
      "justification": "Directly maps to launching the proposal acceptance phase."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the rector can nominate themselves as a candidate for the position"
      ],
      "justification": "Faithfully captures the self-nomination step for the incumbent rector."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the acceptance of proposals should be stopped"
      ],
      "justification": "Exactly matches the closure of the nomination window."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n5"
      ],
      "verbatim_texts": [
        "If a candidate meets the required criteria"
      ],
      "justification": "The conditional clause establishes the XOR decision point, the positive guard path, and the explicit criteria-checking step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "meets the required criteria, they should be included in the list of candidates"
      ],
      "justification": "Captures the positive outcome action of adding eligible candidates to the official list."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "if a candidate does not meet the criteria, they should be informed of the refusal and the process will come to an end"
      ],
      "justification": "Maps the negative guard condition, the refusal notification action, and the terminating end node."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the list of candidates has been formed, it should be made public"
      ],
      "justification": "Covers both the formation and publication steps of the candidate list; redundancy is permitted and behaviorally equivalent."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, the candidates should promote their ideas to the public and organize a public meeting of the Academic Senate"
      ],
      "justification": "The concurrency marker justifies the AND gateway split into two parallel promotional and organizational tasks."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The public meeting should then commence"
      ],
      "justification": "Implies the rejoining of parallel streams via the converge node, followed by the meeting commencement action."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "an election should be conducted and the votes should be counted"
      ],
      "justification": "Accurately splits the combined source instruction into conducting the election and counting the votes."
    },
    {
      "refs": [
        "guard:b2->n18"
      ],
      "verbatim_texts": [
        "If the voting fails"
      ],
      "justification": "Establishes the second XOR decision point and the negative guard path for failed voting rounds."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the voting fails, another election should be conducted"
      ],
      "justification": "Directly implements the retry loop action for unsuccessful elections."
    },
    {
      "refs": [
        "guard:b2->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "if the voting is successful, the result of the election should be announced"
      ],
      "justification": "Maps the positive guard condition to the announcement action."
    },
    {
      "refs": [
        "action:n17",
        "action:n19"
      ],
      "verbatim_texts": [
        "the public meeting should be concluded and the candidate should be informed of the election results, marking the end of the process"
      ],
      "justification": "Covers the dual conclusion/information actions and the process termination nodes; duplicate elements are redundant but behaviorally harmless and fully supported by the source."
    }
  ],
