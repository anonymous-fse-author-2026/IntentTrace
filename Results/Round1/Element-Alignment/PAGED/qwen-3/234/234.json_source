  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process"
    },
    {
      "id": "i2",
      "content": "begin by supplying the requirement and then documenting it."
    },
    {
      "id": "i3",
      "content": "If the order is received via fax,"
    },
    {
      "id": "i4",
      "content": "via fax"
    },
    {
      "id": "i5",
      "content": "input the order into an Excel file."
    },
    {
      "id": "i6",
      "content": "If the order is received via mail or phone,"
    },
    {
      "id": "i7",
      "content": "via mail or phone"
    },
    {
      "id": "i8",
      "content": "also input the order into an Excel file."
    },
    {
      "id": "i9",
      "content": "after a week"
    },
    {
      "id": "i10",
      "content": "send it to the student."
    },
    {
      "id": "i11",
      "content": "Upon receiving the Excel list, type the orders into the MS-Access database."
    },
    {
      "id": "i12",
      "content": "After typing the orders into the database, ensure that it is completed. Once the database is completed,"
    },
    {
      "id": "i13",
      "content": "control the incoming order."
    },
    {
      "id": "i14",
      "content": "At the same time, continue to do the check."
    },
    {
      "id": "i15",
      "content": "If the order is correct,"
    },
    {
      "id": "i16",
      "content": "is correct"
    },
    {
      "id": "i17",
      "content": "release it."
    },
    {
      "id": "i18",
      "content": "However, if the order is incorrect,"
    },
    {
      "id": "i19",
      "content": "is incorrect"
    },
    {
      "id": "i20",
      "content": "contact the selling agency."
    },
    {
      "id": "i21",
      "content": "If the order is worth less than 5.000 \u20ac,"
    },
    {
      "id": "i22",
      "content": "less than 5.000 \u20ac"
    },
    {
      "id": "i23",
      "content": "worth more than 5.000 \u20ac,"
    },
    {
      "id": "i24",
      "content": "more than 5.000 \u20ac"
    },
    {
      "id": "i25",
      "content": "send it for sign off"
    },
    {
      "id": "i26",
      "content": "Once the order is signed off, contact the client and release the order."
    },
    {
      "id": "i27",
      "content": "release the order."
    },
    {
      "id": "i28",
      "content": "Once the order is received by PPC, they will initiate production."
    },
    {
      "id": "i29",
      "content": "If the issue cannot be solved,"
    },
    {
      "id": "i30",
      "content": "cannot be solved"
    },
    {
      "id": "i31",
      "content": "not"
    },
    {
      "id": "i32",
      "content": "cancel the order."
    },
    {
      "id": "i33",
      "content": "If the issue can be solved,"
    },
    {
      "id": "i34",
      "content": "can be solved"
    },
    {
      "id": "i35",
      "content": "After PPC initiates production, the goods will be produced."
    },
    {
      "id": "i36",
      "content": "If the order needs to be cancelled,"
    },
    {
      "id": "i37",
      "content": "needs to be cancelled"
    },
    {
      "id": "i38",
      "content": "the process ends."
    },
    {
      "id": "i39",
      "content": "If not,"
    },
    {
      "id": "i40",
      "content": "check the quality of the goods."
    },
    {
      "id": "i41",
      "content": "Once the quality is checked, create and send a quality report to the finance department."
    },
    {
      "id": "i42",
      "content": "Release the order via memo and ensure that the memo is achieved in the warehouse."
    },
    {
      "id": "i43",
      "content": "Send the invoice and once it is sent, report the achievement to the finance department."
    },
    {
      "id": "i44",
      "content": "At the same time, commission the goods and sign and send the memo."
    },
    {
      "id": "i45",
      "content": "Also, send the goods"
    },
    {
      "id": "i46",
      "content": "ensure that the signed memo is achieved in the logistic department."
    },
    {
      "id": "i47",
      "content": "Finally, archive the memo and close the order. This marks the end of the process."
    }
  ]
}