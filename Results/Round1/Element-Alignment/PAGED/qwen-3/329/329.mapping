{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process, begin by processing incoming orders."
      ],
      "justification": "The opening clause implicitly triggers the process start and directly describes the first action."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "Once the order is received, proceed to send the collected order list."
      ],
      "justification": "The condition 'order received' and subsequent action 'send the collected order list' are faithfully captured."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After collecting the order list, implement it in the database."
      ],
      "justification": "Direct paraphrase preserving the database implementation step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the data is implemented, gather all the information in one excel-file."
      ],
      "justification": "Exact correspondence to the Excel file gathering step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Subsequently, check the order and customer details."
      ],
      "justification": "Direct match to the verification step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b1->n8",
        "guard:b1->n9"
      ],
      "verbatim_texts": [
        "If the \"permit data\" option is selected, proceed with permitting the data. However, if the \"not permit data\" option is chosen, the data will not be permitted."
      ],
      "justification": "The conditional statement establishes the XOR branch, guards map to the binary option selection, and the action captures the decision prompt."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed with permitting the data."
      ],
      "justification": "Direct match to the positive arm outcome."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the data will not be permitted."
      ],
      "justification": "Direct match to the negative arm outcome."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "After implementing the data in the database, release the data if permitted or contact the selling agency if not permitted."
      ],
      "justification": "Both conditional outcomes are accurately segmented into distinct actions."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the agency is contacted, check the worth of the orders."
      ],
      "justification": "Direct match to the worth-checking step."
    },
    {
      "refs": [
        "action:n13",
        "guard:b2->n14",
        "guard:b2->n15"
      ],
      "verbatim_texts": [
        "If the orders are to be released, continue with the process. However, if the order is to be canceled, the process will end."
      ],
      "justification": "Captures the release/cancel decision point, XOR branch structure, and corresponding guards."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Matches the positive flow continuation."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "the process will end."
      ],
      "justification": "Explicitly states process termination, supporting both the end action and structural end node."
    },
    {
      "refs": [
        "action:n16",
        "guard:b3->n17",
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "After checking the worth of the orders, if the value is less than 5000, continue with the process. However, if the value is greater than or equal to 5000, the order will need to be signed off by the board of directors."
      ],
      "justification": "Accurately models the threshold decision (<5000 vs >=5000), branch, and guards."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "the order will need to be signed off by the board of directors."
      ],
      "justification": "Direct match to the high-value escalation step."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the order is signed off, collect the order and start production."
      ],
      "justification": "Faithfully combines collection and production start."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Send the memorandum and invoice, followed by the quality report."
      ],
      "justification": "Correctly splits the compound instruction into sequential actions."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "Check the quality of the production and send the quality report."
      ],
      "justification": "Accurately reflects the quality check and reporting steps; 'again' is a harmless contextual paraphrase."
    },
    {
      "refs": [
        "action:n24",
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "Once production has started, send the memorandum and collect the goods. Sign off on the memo and pick the goods."
      ],
      "justification": "Properly segments the goods handling and memo sign-off instructions."
    },
    {
      "refs": [
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "After the goods are picked, send them to complete the process."
      ],
      "justification": "Captures the final shipping step and process completion/end node."
    }
  ],
