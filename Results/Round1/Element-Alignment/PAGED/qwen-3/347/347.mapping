{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "The opening clause implicitly starts the process and directly describes the initialization and first three sequential actions."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
      ],
      "justification": "Captures the conditional check, the XOR split, and the positive-arm action generating the specified report."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Directly matches the negative-arm action for the inventory threshold decision."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "Maps the report verification step, the subsequent decision node, and the PO creation action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "The action restates the termination condition, and the structural end node captures the process conclusion."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Faithfully captures the rejection check, the branching logic, and the rework action."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Matches the approval verification, the branch, and the print/release execution step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Directly corresponds to the review requirement following PO creation."
    },
    {
      "refs": [
        "action:n14",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Covers the rework loop condition and the repeat creation step; redundant elements are permitted."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "The AND gateway correctly models the simultaneous parallel execution described, along with both actions."
    },
    {
      "refs": [
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Maps the fund reservation check and the subsequent packing slip reception."
    },
    {
      "refs": [
        "action:n36"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Covers the inventory receipt action and implies the structural convergence of the parallel path."
    },
    {
      "refs": [
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Accurately models the sequence of verifying the slip and proceeding to invoice reception."
    },
    {
      "refs": [
        "action:n38"
      ],
      "verbatim_texts": [
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Directly matches the conditional progression toward packing slip receipt from the inventory path."
    },
    {
      "refs": [
        "action:n31",
        "action:n32"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Covers the invoice verification, the transition to matching, and the implied convergence point before matching."
    },
    {
      "refs": [
        "action:n42",
        "action:n43"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Faithfully reproduces the success validation and the corresponding fund release action."
    },
    {
      "refs": [
        "action:n44"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Directly matches the payment issuance step following fund release."
    },
    {
      "refs": [
        "action:n45"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Restates the cycle completion and aligns with the final end node."
    }
  ],
