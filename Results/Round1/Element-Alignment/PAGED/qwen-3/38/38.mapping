      ],
      "verbatim_texts": [
        "After that, go to iforgot.apple.com and proceed with Reset Password."
      ],
      "justification": "Actions n8 and n9 sequentially map to the navigation and reset proceeding steps described."
    },
    {
      "refs": [
        "action:n10",
