      ],
      "verbatim_texts": [
        "However, if you select \"Reset password\", you will be automatically directed to iforgot.apple.com."
      ],
      "justification": "Guard preserves the 'Reset password' selection text. Action n6 matches the automatic navigation directive."
    },
    {
      "refs": [
