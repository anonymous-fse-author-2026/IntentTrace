{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Implicitly marks the process initiation point described in the opening clause."
    },
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Redundant restatement of the initial return step; permitted under redundancy rules."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process. However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Captures the exclusive choice between customer return and crew pickup."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process. However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process.",
        "\"Delivery Crew picks-up items at the event site\""
      ],
      "justification": "Both guard instances cover the two mutually exclusive return methods defined in the source."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the items are counted and compared to the original contract"
      ],
      "justification": "Directly implements the counting and comparison step without alteration."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Models the three-way decision point regarding order completion status."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Captures the positive completion branch routing toward the join point."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "\"Order is incomplete and items are missing\""
      ],
      "justification": "Exact alignment with the missing items condition unit."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "\"Order is complete but items are damaged\""
      ],
      "justification": "Exact alignment with the damaged items condition unit."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Faithfully implements the notification step for missing items."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Direct implementation of the damage notification step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Implements the inventory removal step; the conditional context is satisfied by the upstream guard."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process. However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Captures the binary decision regarding missing item resolution."
    },
    {
      "refs": [
        "guard:b3->c1"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process. However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Both guard instances cover the return and non-return outcomes routing to the converge point."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Models the repair outcome decision point."
    },
    {
      "refs": [
        "guard:b4->n10"
      ],
      "verbatim_texts": [
        "\"Items are repaired and added into inventory\""
      ],
      "justification": "Exact match for the successful repair condition."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "\"Items are repaired and added into inventory\""
      ],
      "justification": "Restates the successful repair and inventory addition state."
    },
    {
      "refs": [
        "guard:b4->n11"
      ],
      "verbatim_texts": [
        "\"Items can't be repaired and are discarded\""
      ],
      "justification": "Exact match for the discard condition."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "\"Items can't be repaired and are discarded\""
      ],
      "justification": "Restates the unrepairable/discard state."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "we email the customer with replacement charges"
      ],
      "justification": "Implements the email notification for unrepairable items."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\" we continue the process. If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Captures the final disposition choice between immediate packing and future storage."
    },
    {
      "refs": [
        "guard:b5->n14"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\" we continue the process. If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Both guard instances cover the pack and store paths."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges, and the process is complete."
      ],
      "justification": "Implements the final email notification step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "when the process is complete, it ends."
      ],
      "justification": "Both the structural end node and the labeled action node capture the explicit process termination statement."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Structural converge aligns with the point where all conditional branches from b2 and b3 rejoin the main flow."
    }
