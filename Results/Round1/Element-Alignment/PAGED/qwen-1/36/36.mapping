      ],
      "verbatim_texts": [
        "For Talent Seek:"
      ],
      "justification": "The header establishes scope; init and n1 model the process commencement."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Action n2 captures the check; branch b1 models the ensuing decision point."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Guard specifies the positive condition; action n3 executes the discussion."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Guard captures the implicit negative/fallback path continuing the flow."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Action n4 performs the modification check; branch b2 handles the resulting split."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits.",
        "then continue to check if the change is within the set client limits."
      ],
      "justification": "Action n5 represents executing the limit check described across these units."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits."
      ],
      "justification": "Structural branch modeling the outcome split of the limit check."
    },
    {
      "refs": [
        "guard:b3->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "Guard v3='No' aligns with 'not within limits'; action n6 executes the relay."
    },
    {
      "refs": [
        "guard:b3->n7"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process."
      ],
      "justification": "Guard v3='Yes' aligns with passing limits; action n7 covers the subsequent relay and continuation."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
