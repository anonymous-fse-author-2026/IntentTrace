    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we receive the contract for the marketing campaign."
      ],
      "justification": "The opening clause explicitly triggers the process start and defines the first action verbatim."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once we have the contract, we take it to the department."
      ],
      "justification": "Direct restatement of the second step with identical target and object."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "In the next step, we input the customer's details into NKE."
      ],
      "justification": "Exact match of the third procedural step, preserving system name and action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer's details are missing, we contact the customers.",
        "However, if the customer's details are ready, we create a suitable team."
      ],
