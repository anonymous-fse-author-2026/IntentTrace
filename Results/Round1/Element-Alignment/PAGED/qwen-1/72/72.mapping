{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Opening phrase implicitly initiates the process and explicitly names the first two sequential actions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete"
      ],
      "justification": "Introduces the XOR decision point regarding invoice completeness."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete"
      ],
      "justification": "Positive condition triggering the return path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "it is returned."
      ],
      "justification": "Direct consequence stated for the incomplete invoice condition."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete"
      ],
      "justification": "Negative condition routing the flow to continuation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Exact phrasing for the continuation step when the invoice is complete."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant"
      ],
      "justification": "Establishes the compliance verification decision node."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Faithfully reproduces the phone-based resolution step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Direct match for the mail-back return scenario."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Exact match for the combined payment and notification action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Bill Client."
      ],
      "justification": "Directly extracted procedural step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If there is no response"
      ],
      "justification": "Defines the client response evaluation decision."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "If there is no response"
      ],
      "justification": "Condition correctly mapped to trigger the waiting period."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "a period of 10 days is given."
      ],
      "justification": "Exact duration constraint preserved."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Captures the reminder action and the explicit terminal state."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Accurately models the dissatisfaction check and subsequent resolution action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Exact match for the satisfaction continuation pathway."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant"
      ],
      "reason": "Maps the 'non-compliant=true' outcome directly to phone resolution. The source introduces an intermediate conditional ('If the issue can be resolved with a phone call') before resolution occurs; skipping this alters the control flow logic."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back"
      ],
      "reason": "Maps the 'non-compliant=false' outcome to the mail-back return. The source ties the mail-back requirement to unresolved issues, not to compliant invoices. This reverses/misaligns the intended routing logic."
    },
    {
      "refs": [
        "guard:b3->e3"
      ],
      "verbatim_texts": [
        "If there is no response"
      ],
      "reason": "Invents a termination route for when a response IS received (v3='No'). The source text exclusively describes the no-response branch and provides no logic or endpoint for the positive response case."
    },
    {
      "refs": [
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied"
      ],
      "reason": "Routes the 'unsatisfied=true' outcome to a node labeled 'Continue process if client is satisfied'. The guard condition and target action payload are logically contradictory."
    },
    {
      "refs": [
        "guard:b4->e4"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied"
      ],
      "reason": "Routes the 'satisfied' outcome to a process end node. The source explicitly states the process continues upon satisfaction, directly contradicting the modeled termination."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "reason": "Explicit action describing intermediate verification steps is absent from the model; it was incorrectly collapsed directly into routing guards."
    },
    {
      "verbatim_texts": [
        "if it is returned, non-compliance is resolved."
      ],
      "reason": "Recurring conditional trigger for resolution is not implemented as a distinct guard or action; the model assumes resolution flows automatically without this explicit check."
    },
    {
      "verbatim_texts": [
        "After that, the invoice is paid"
      ],
      "reason": "Initial payment step mentioned prior to the simultaneous billing phase is missing; the model only captures the later combined payment/notification step."
    }
  ],
  "additions": [
    {
      "refs": [
        "action:n1"
      ],
      "reason": "Content 'start' redundantly duplicates the implicit function of the init node and lacks a distinct supporting source span."
    },
    {
      "refs": [
        "action:n5"
      ],
      "reason": "Claims the process terminates upon incomplete return. Source only states 'it is returned,' with no indication of process termination at this stage."
    },
    {
      "refs": [
        "action:n10"
      ],
      "reason": "Claims the process terminates upon mail-back return. Source only states 'the invoice is returned,' lacking any end-of-process signal here."
    },
    {
      "refs": [
        "action:n18"
      ],
      "reason": "Asserts process termination after payment completion/notification. Source indicates workflow continuation elsewhere, and this specific end-state label has no textual basis."
    }
  ],
