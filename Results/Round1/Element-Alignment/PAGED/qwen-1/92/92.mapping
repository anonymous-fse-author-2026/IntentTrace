      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To start,"
      ],
      "justification": "Implicit process initiation signaled by the opening phrase."
    },
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "please register your participation for the event."
      ],
      "justification": "Faithfully reproduces the first instructional step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request."
      ],
      "justification": "Many elements to one span: models the XOR split, applies the negative condition guard, and executes the specified registration action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "Many elements to one span: applies the positive condition guard and executes the specified creation action."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Structural termination point for the no-fee path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Directly implements the verification step."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Many elements to one span: models the approval split, sets the guard, and executes the notification receipt action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Sets the rejection guard and executes the corresponding notification action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Executes the subsequent registration step triggered by the approved notification path."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Structural termination point for the rejection path."
    }
