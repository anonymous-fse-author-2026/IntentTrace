{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by supplying the requirement and then documenting it."
      ],
      "justification": "The opening clause implies process start and explicitly describes the supply/documentation action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the order is received via fax, input the order into an Excel file."
      ],
      "justification": "Captures the XOR split, the fax condition guard, and the corresponding input action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone, also input the order into an Excel file."
      ],
      "justification": "Accurately maps the alternative mail/phone condition and its matching action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete after a week, send it to the student."
      ],
      "justification": "Faithfully reproduces the core instruction to send the list to the student."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list, type the orders into the MS-Access database."
      ],
      "justification": "n7 covers receipt, n8 covers the database typing action."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the order is correct, release it."
      ],
      "justification": "Exact alignment of the correctness check split, guard, and release action."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Directly captures the incorrect branch guard and the agency contact action."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac, release it."
      ],
      "justification": "Correctly models the threshold split, value guard, and release action for low-value orders."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "less than 5.000 \u20ac"
      ],
      "justification": "Correctly models the threshold split, value guard, and release action for low-value orders."
    },
    {
      "refs": [
        "guard:b3->c5",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "Matches the high-value threshold guard and the sign-off dispatch action."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "Once the order is signed off, contact the client and release the order."
      ],
      "justification": "Faithfully splits the post-sign-off steps into client contact and order release."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "Direct paraphrase of the production initiation step."
    },
    {
      "refs": [
        "guard:b4->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order."
      ],
      "justification": "Accurately models the unsolvable issue split, guard, and cancellation action."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the issue can be solved, release the order."
      ],
      "justification": "Directly aligns with the solvable issue guard and release action."
    },
    {
      "refs": [
        "action:n34"
      ],
      "verbatim_texts": [
        "After PPC initiates production, the goods will be produced."
      ],
      "justification": "Faithfully captures the goods production step."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends."
      ],
      "justification": "Correctly models the cancellation decision, guard, terminal action, and process end."
    },
    {
      "refs": [
        "guard:b5->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If not, check the quality of the goods."
      ],
      "justification": "Matches the non-cancellation guard and the quality check action."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods",
        "sign and send the memo.",
        "ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "The AND branches and converges correctly model the concurrent execution implied by 'At the same time' and 'Also', while n29/n30 cover the commissioning and memo handling steps."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods",
        "sign and send the memo.",
        "ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "The AND branches and converges correctly model the concurrent execution implied by 'At the same time' and 'Also', while n29/n30 cover the commissioning and memo handling steps."
    },
    {
      "refs": [
        "action:n31",
        "action:n32"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order. This marks the end of the process."
      ],
      "justification": "Accurately maps the final archiving/closing actions and the explicit process termination."
    }
  ],
  "mutations": [
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed. Once the database is completed, control the incoming order."
      ],
      "reason": "The element content adds 'checked', altering the source which only requires ensuring completion before controlling the order."
    },
    {
      "refs": [
        "action:n33"
      ],
      "verbatim_texts": [
        "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
      ],
      "reason": "Omits the mandatory step to contact the selling agency, jumping directly to receiving/signing."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "reason": "Drops the critical destination 'to the finance department', changing the routing/target of the report."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "reason": "Omits the required verification step that the memo is achieved in the warehouse."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "reason": "Conflates two distinct steps and misattributes the finance department as the invoice recipient rather than the target of the achievement report."
    }
  ],
