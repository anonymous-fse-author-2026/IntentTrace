{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME"
      ],
      "justification": "Opening clause implicitly initiates the process and explicitly describes the first action."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "begin with the New Resupply Cycle and then Check Levels of Inventory"
      ],
      "justification": "Sequential action nodes faithfully capture the full initial setup and inspection step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "Action node evaluates the condition while the XOR branch represents the decision split."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report"
      ],
      "justification": "Directly restates the positive-arm reporting action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report"
      ],
      "justification": "Directly restates the negative-arm reporting action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum"
      ],
      "justification": "Action evaluates the report condition; branch handles the subsequent routing."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)"
      ],
      "justification": "Faithfully captures the positive-arm PO creation action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Action states termination, structurally supported by the end node."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked"
      ],
      "justification": "Elements split the rejection check, decision split, and rework action faithfully."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system"
      ],
      "justification": "Elements capture the approval check, decision split, and printing/release action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Captures the mandatory review step triggered by PO creation."
    },
    {
      "refs": [
        "action:n14",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Elements split the rework trigger and regeneration action; duplication handles source repetition without altering behavior."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "Actions perform the concurrent tasks, while AND branches correctly model the simultaneous split."
    },
    {
      "refs": [
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Elements faithfully model the reservation check, decision, and packing slip receipt."
    },
    {
      "refs": [
        "action:n36"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Captures the core inventory receipt action following the mailing step."
    },
    {
      "refs": [
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Elements capture the slip receipt check, routing, and invoice acquisition."
    },
    {
      "refs": [
        "action:n38",
        "action:n39"
      ],
      "verbatim_texts": [
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Elements capture the inventory receipt check, routing, and packing slip acquisition."
    },
    {
      "refs": [
        "action:n31",
        "action:n32"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Elements capture the invoice receipt check, routing, and progression to matching."
    },
    {
      "refs": [
        "action:n42",
        "action:n43"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Elements capture the success evaluation, decision split, and fund release."
    },
    {
      "refs": [
        "action:n44"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Directly matches the payment issuance step following fund release."
    },
    {
      "refs": [
        "action:n45"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Action declares cycle completion, aligned with the terminal end node."
    }
  ],
