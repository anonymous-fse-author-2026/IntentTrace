    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "The implicit process start and the explicit registration action are directly supported by the opening clause."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no fee"
      ],
      "justification": "The conditional state is captured as an action check, the XOR branch structure, and the corresponding guard for the zero-fee path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "register a post-seminar request"
      ],
      "justification": "Exact match of the action content without modification."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if there is a fee, you need to create a purchase request"
      ],
      "justification": "Guard captures the fee condition; action captures the required purchase request creation step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Both the termination action and structural end node faithfully reflect the explicit end-of-process statement for this path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Verification step modeled as an action preceding the decision branch, preserving the exact checking intent."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Guard reflects the approval condition; action reflects receiving the notification."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Guard reflects the rejection condition; action reflects receiving the notification."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Direct match of the follow-up registration action described in the clause."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Termination action and structural end node capture the explicit end upon rejection."
    }
  ],
