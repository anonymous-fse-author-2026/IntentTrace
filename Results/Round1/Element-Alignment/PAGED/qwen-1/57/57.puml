@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:make purchase and connect to website;
:search for item;
:add item to cart / continue shopping;
:v1: add item to cart / continue shopping ({Add Item to Cart, Continue Shopping}); <<objectSignal>>
if () then ([v1 = 'Add Item to Cart'])
:proceed to checkout;
split
:enter address shipping method and payment information;
split again
:authorize credit card and check inventory levels;
end split
else ([v1 = 'Continue Shopping'])
:continue shopping;
endif
:checkout tasks completed?;
:v2: credit card and inventory status ({Approved and In Stock, Denied or Out of Stock}); <<objectSignal>>
if () then ([v2 = 'Approved and In Stock'])
:credit card approved and inventory in stock?;
:v3: credit card approved and inventory in stock? ({Approved, Denied}); <<objectSignal>>
if () then ([v3 = 'Approved'])
:display order confirmation number;
:show final order to customer;
:confirm the order;
:send confirmation notice via email;
:order entry complete;
stop
else ([v3 = 'Denied'])
:transaction ended;
stop
endif
else ([v2 = 'Denied or Out of Stock'])
:checkout tasks not completed;
stop
endif
@enduml