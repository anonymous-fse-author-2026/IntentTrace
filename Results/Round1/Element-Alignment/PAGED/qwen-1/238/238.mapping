  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order and then proceed to Check the Customer's Credit Limit."
      ],
      "justification": "The opening clause establishes the process start, the initial ordering action, and the credit limit check."
    },
    {
      "refs": [
        "guard:b1->c4"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article.",
        "If the response is \"Okay\""
      ],
      "justification": "The XOR branch and 'Okay' guard capture the positive credit limit response, leading to the article availability check and its associated state node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article.",
        "If the response is \"Okay\""
      ],
      "justification": "The XOR branch and 'Okay' guard capture the positive credit limit response, leading to the article availability check and its associated state node."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article.",
        "If the response is \"Okay\""
      ],
      "justification": "The XOR branch and 'Okay' guard capture the positive credit limit response, leading to the article availability check and its associated state node."
    },
    {
      "refs": [
        "guard:b1->c3",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "The 'No' guard and subsequent action faithfully implement the negative credit limit path."
    },
    {
      "refs": [
        "guard:b_loop->c4",
        "guard:b_loop->b2"
      ],
      "verbatim_texts": [
        "After checking the availability, if the response is \"Okay\", proceed to Check the Availability of the Article again. If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "The loop branch and its guards correctly model the re-check conditions described in the text."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8",
        "guard:b2->n9",
        "action:n9",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods. However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "The branch, guards, and actions accurately reflect the production vs collection decision based on availability."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Direct match for the confirmation dispatch step."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "The AND branch, parallel shipping/invoicing actions, and convergence node correctly model the concurrent tasks."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Models the payment verification step and its resulting state."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If the payment has been received",
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "The branch, 'Yes' guard, closing action, end action, and terminal node cover the successful payment flow."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment has been received",
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "The branch, 'Yes' guard, closing action, end action, and terminal node cover the successful payment flow."
    },
    {
      "refs": [
