      ],
      "verbatim_texts": [
        "If the payment has been received",
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "The branch, 'Yes' guard, closing action, end action, and terminal node cover the successful payment flow."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "The 'No' guard routes to the action that performs the reminder count threshold check."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "The branch and 'Yes' guard trigger the write-off action when the threshold is met."
    },
    {
      "refs": [
        "guard:b4->c2",
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "The 'No' guard path and convergence lead to the reminder dispatch action."
    },
    {
      "refs": [
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Faithfully implements the post-write-off closure and termination steps."
    }
