@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start reviewing the incoming CV;
:Decision to send a negative email;
:v1: Decision to send a negative email ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Send negative email and end process;
stop
else ([v1 = 'No'])
:Schedule an interview with the candidate;
:Conduct the interview;
:End process after interview;
stop
endif
