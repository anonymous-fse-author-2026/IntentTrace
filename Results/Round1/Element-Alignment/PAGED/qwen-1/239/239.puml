@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:Examine Order;
:Is Order Rejected?;
:v1: Is Order Rejected? ({Rejected, Accepted}); <<objectSignal>>
if () then ([v1 = 'Accepted'])
:Prepare Assembling Order;
else ([v1 = 'Rejected'])
:Check Availability;
endif
:Is Backorder Required?;
:v2: Is Backorder Required? ({Backorder, Reserved}); <<objectSignal>>
if () then ([v2 = 'Backorder'])
:Check Availability Again;
stop
else ([v2 = 'Reserved'])
:Assemble Bike;
:Ship Product;
:End;
stop
endif
@enduml