{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts when the customer enters the website"
      ],
      "justification": "The init node captures the process trigger; the action node faithfully represents the customer entering the website."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then searches for the desired item."
      ],
      "justification": "Action content directly mirrors the search step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "they click on it"
      ],
      "justification": "Action content directly mirrors the click step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "From there, they choose an action."
      ],
      "justification": "Action describes the choice step; structural branch captures the implicit XOR decision point introduced by this choice."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they choose to view the quantity amount, they can see the quantity amount."
      ],
      "justification": "Guard abstracts the 'view' condition faithfully; action restates seeing/viewing the quantity amount."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "Alternatively, if they choose to enter a quantity amount, they can input it."
      ],
      "justification": "Guard abstracts the 'enter' condition faithfully; action restates inputting the quantity amount."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the quantity amount is viewed or entered, they return to the desired item page."
      ],
      "justification": "Converge node captures the rejoining of the two quantity paths; action matches returning to the page."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "From there, they add the item to their cart"
      ],
      "justification": "Action content matches adding to cart exactly."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "and once it's added, they choose another action."
      ],
      "justification": "Action matches the post-add choice; structural branch captures the subsequent decision split."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If they choose to continue shopping, they return to the desired item page."
      ],
      "justification": "Guard and two actions faithfully segment the conditional clause into the condition, the continue step, and the return step."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if they choose to check out the current item, they proceed to check out."
      ],
      "justification": "Guard and two actions faithfully segment the alternative conditional clause."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "After checking out the item, they confirm it"
      ],
      "justification": "Action content matches the confirmation step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "and once it's confirmed, they choose another action."
      ],
      "justification": "Action matches the post-confirmation choice; structural branch captures the subsequent decision split."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If they choose to proceed to check out, they go to the check-out page."
      ],
      "justification": "Guard and action faithfully capture proceeding to and entering the checkout page."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "Alternatively, if they choose to recalculate the shipping, they can do so."
      ],
      "justification": "Guard and action faithfully capture the recalculation option."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Lastly, if they choose to enter a coupon code, they can enter it."
      ],
      "justification": "Guard and action faithfully capture the coupon code entry option."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once they proceed to check out, recalculate the shipping, or enter a coupon code, they enter the check-out page."
      ],
      "justification": "Converge node captures the rejoining of the three paths; action matches entering the checkout page."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "From there, they enter their billing information"
      ],
      "justification": "Action content matches entering billing information exactly."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Action and end node correspond directly to the stated process termination."
    }
  ],
