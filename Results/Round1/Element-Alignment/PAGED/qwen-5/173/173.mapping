  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "init:i1 marks the implicit process start, and action:n1 faithfully restates the first instructed step without altering scope or target."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "action:n2 and branch:b1 model the conditional check. guard:b1->n3 captures the negative outcome routing to action:n3, which executes the advertisement exactly as stated."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "The positive guard and subsequent check/branch represent the continuation path described for the available candidate case."
    },
    {
      "refs": [
        "guard:b2->n6",
        "guard:b3->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "Negative guards route to action:n6, which repeats the advertisement step with the 'again' qualifier as specified. Multiple guards reflecting the same condition are redundant but behaviorally equivalent."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->c1",
        "guard:b3->c1",
        "action:n7"
      ],
      "verbatim_texts": [
        "proceed with selecting the appropriate applicant"
      ],
      "justification": "Positive guards from the decision points merge at converge:c1 into action:n7. action:n5 and branch:b3 provide a redundant but logically consistent re-evaluation of candidate availability before selection."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed"
      ],
      "justification": "Models the temporal/conditional clause as an explicit action step; the core instruction, subject, and outcome remain identical to the source."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Multiple redundant end actions and structural nodes collectively mark process termination as described. Redundancy does not alter execution paths or ordering."
    }
  ],
