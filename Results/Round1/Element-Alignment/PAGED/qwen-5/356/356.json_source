  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process, make sure the Freights are ready to be shipped and then ship the freight."
    },
    {
      "id": "i2",
      "content": "At the same time, complete the following steps: deliver the freight and notify the delivery."
    },
    {
      "id": "i3",
      "content": "If the request for merchandise return is lodged"
    },
    {
      "id": "i4",
      "content": "If the return is accepted, proceed with accepting the merchandise return. If the return is rejected, reject the merchandise return."
    },
    {
      "id": "i5",
      "content": "If a loss claim report is lodged, approve the loss claim and the process ends."
    },
    {
      "id": "i6",
      "content": "Reject the merchandise return and the process ends with the merchandise return request being rejected."
    },
    {
      "id": "i7",
      "content": "If it has been 5 days, invoice the customer. Invoice the customer and the process ends with the customer being invoiced."
    },
    {
      "id": "i8",
      "content": "Accept the merchandise return and proceed with returning the merchandise. Return the merchandise and the process ends with the merchandise being returned."
    }
  ]
}