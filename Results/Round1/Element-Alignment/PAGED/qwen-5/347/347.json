  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process for ACME,"
    },
    {
      "id": "i2",
      "content": "begin with the New Resupply Cycle"
    },
    {
      "id": "i3",
      "content": "and then Check Levels of Inventory."
    },
    {
      "id": "i4",
      "content": "If the inventory is below or equal to the minimum,"
    },
    {
      "id": "i5",
      "content": "If the inventory is below or equal to the minimum"
    },
    {
      "id": "i6",
      "content": "generate an Equal to or below minimum Report."
    },
    {
      "id": "i7",
      "content": "If the inventory is greater than the minimum, generate an Above Minimum Report."
    },
    {
      "id": "i8",
      "content": "If the report indicates that the inventory is equal to or below the minimum,"
    },
    {
      "id": "i9",
      "content": "create Purchase Orders (POs)."
    },
    {
      "id": "i10",
      "content": "the process ends."
    },
    {
      "id": "i11",
      "content": "If the PO is rejected,"
    },
    {
      "id": "i12",
      "content": "it needs to be reworked."
    },
    {
      "id": "i13",
      "content": "If the PO is approved,"
    },
    {
      "id": "i14",
      "content": "it is printed and released in the system."
    },
    {
      "id": "i15",
      "content": "If the PO is created, it needs to be reviewed."
    },
    {
      "id": "i16",
      "content": "If the PO needs to be reworked, it needs to be created again."
    },
    {
      "id": "i17",
      "content": "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
    },
    {
      "id": "i18",
      "content": "If funds are reserved for the released POs,"
    },
    {
      "id": "i19",
      "content": "receive the Packing Slip."
    },
    {
      "id": "i20",
      "content": "receive the inventory."
    },
    {
      "id": "i21",
      "content": "If the Packing Slip is received,"
    },
    {
      "id": "i22",
      "content": "proceed to receive the Invoice."
    },
    {
      "id": "i23",
      "content": "If the inventory is received,"
    },
    {
      "id": "i24",
      "content": "proceed to receive the Packing Slip."
    },
    {
      "id": "i25",
      "content": "If the Invoice is received,"
    },
    {
      "id": "i26",
      "content": "proceed to the Three-way match."
    },
    {
      "id": "i27",
      "content": "If the Three-way match is successful,"
    },
    {
      "id": "i28",
      "content": "release the funds."
    },
    {
      "id": "i29",
      "content": "Once the funds are released, issue the payment."
    },
    {
      "id": "i30",
      "content": "After the payment is issued, the Resupply Cycle is complete and the process ends."
    }
  ]
