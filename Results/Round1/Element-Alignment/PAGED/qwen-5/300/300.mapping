  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts with the Request for Quotation,"
      ],
      "justification": "The opening clause implicitly establishes the process start and explicitly describes the initial quotation request step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by the Customer submitting the RFQ."
      ],
      "justification": "Direct correspondence to the customer submission action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After the RFQ is submitted, the Quotation is also submitted."
      ],
      "justification": "Faithfully captures the sequential quotation submission step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the Quotation is submitted, we receive it."
      ],
      "justification": "Direct match for the quotation reception step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Upon receiving the Quotation, we then submit the Purchase Order."
      ],
      "justification": "Accurately reflects the purchase order submission triggered by receipt."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "Simultaneously, we complete two steps:"
      ],
      "justification": "The simultaneity keyword explicitly signals concurrent execution, correctly mapped to an AND gateway split."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "sending the Goods and sending the Invoice."
      ],
      "justification": "Both parallel tasks are directly and completely captured by these two action nodes."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the Goods are sent, we mark them as sent."
      ],
      "justification": "Exact reproduction of the goods tracking step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Similarly, after the Invoice is sent, we mark it as sent."
      ],
      "justification": "Exact reproduction of the invoice tracking step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The process ends when the Goods are sent or when the Invoice is sent."
      ],
      "justification": "The converge node rejoins the parallel branches, the action denotes termination, and the end node marks completion; together they faithfully implement the closing conditional termination clause."
    }
  ],
