{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process,"
      ],
      "justification": "The opening phrase implicitly initiates the process flow and explicitly describes the starting action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Course Packet Information Received should be sent,"
      ],
      "justification": "Directly corresponds to the first transmission step described in the source."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "followed by sending the Design to Faculty."
      ],
      "justification": "Faithfully captures the sequential handoff of the design document."
    },
    {
      "refs": [
        "action:n_fchoose"
      ],
      "verbatim_texts": [
        "the Faculty will choose the design."
      ],
      "justification": "Exact restatement of the faculty selection step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Next, identify the content that requires copyright clearance and contact the publisher to obtain clearance."
      ],
      "justification": "Accurately combines the identification and outreach steps into a single action as presented."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is a need to \"Contact Faculty to inform of denial and ask if new content should be added\","
      ],
      "justification": "The conditional clause establishes the XOR decision point and is faithfully captured by both the condition-carrying action and the branch node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "\"Contact Faculty to inform of denial and ask if new content should be added\""
      ],
      "justification": "Maps to the positive branch outcome and the explicit instruction to continue the process flow."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "then the process should be continued."
      ],
      "justification": "Maps to the positive branch outcome and the explicit instruction to continue the process flow."
    },
    {
      "refs": [
        "action:n7",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "However, if the \"Entire Course Packet Copyright Cleared\", then the MPC should Calculate the Course Packet Cost."
      ],
      "justification": "Covers the alternative condition and the associated cost calculation step routed by the corresponding guard."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After calculating the Course Packet Cost, the MPC should add the Bookstore margin to determine the retail price."
      ],
      "justification": "Directly matches the retail price determination step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Alternatively, if the Price of the Course Packet is finalized,"
      ],
      "justification": "Correctly identifies the second exclusive decision point regarding price status."
    },
    {
      "refs": [
        "action:n12",
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "If the Faculty needs to reconsider the course packet content to decrease the price,"
      ],
      "justification": "Corresponds to the fallback branch requiring content revision for price reduction."
    },
    {
      "refs": [
        "action:n10",
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "then the MPC should notify the Bookstore of the Course packet, Course number, Faculty name, and sections."
      ],
      "justification": "Matches the positive branch action and lists all specified notification details."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the MPC notifies the Bookstore, the Packet information should be notified to the Bookstore, and the process will end."
      ],
      "justification": "Captures the final notification action and the explicit termination of the process."
    }
  ],
