init(i1)
action(n1, "start")
action(n2, "book a bus")
action(n3, "check availability")
action(n_recept, "receive the necessary information")
branch(b1, XOR)
action(n4, "end - nok")
end(e1)
action(n5, "proceed to book the bus")
action(n6, "end - ok")
end(e2)
defines(v1, "check availability", {"ok", "nok"})
actor(a_default, "Default", [i1, n1, n2, n3, n_recept, b1, n4, e1, n5, n6, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n_recept)
precedence(n_recept, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, e1)
precedence(n5, n6)
precedence(n6, e2)
guard(b1, n4, v1 = "nok")
guard(b1, n5, v1 = "ok")