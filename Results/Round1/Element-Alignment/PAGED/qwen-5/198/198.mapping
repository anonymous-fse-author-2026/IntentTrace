{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "The opening clause establishes the process start and defines the initial identification action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer"
      ],
      "justification": "Models the initial decision point. Phrased as an interrogative action but preserves the exact conditional intent and splits the flow."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "they should then check the availability of the parts."
      ],
      "justification": "Captures the positive-branch action. The guard abstracts the affirmative condition to trigger this step."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if they already have the availability information, they can proceed with the process."
      ],
      "justification": "Models the alternative path where existing information allows the process to skip checking availability and rejoin the main flow."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer"
      ],
      "justification": "Models the second decision point regarding supply status."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "the team can also continue with the process."
      ],
      "justification": "Captures the path where supply confirmation allows the process to continue and converge."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should order and receive the part from Disuki."
      ],
      "justification": "Directly implements the sourcing action described in the text."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "Faithfully captures the customer contracting step following receipt."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected, the team can proceed with the payment."
      ],
      "justification": "Accurately represents the payment initiation step after collection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "Models the terminal action and process completion state."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "However, if they need to record the customer's details"
      ],
      "reason": "The guard uses a generic 'v2 = Yes' label to route to the 'order and receive' action, but the source explicitly ties this action to a different condition: recording customer details. The guard misassigns the triggering logic and incorrectly binds it to the prior supply-check branch instead of its true antecedent."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "However, if they need to record the customer's details"
      ],
      "reason": "This specific conditional requirement is completely absent from the model. The model fails to create a dedicated guard or decision node for it, incorrectly merging it into the unrelated supply-status branch logic."
    }
  ],
