init(i1)
action(n1, "start providing requested shipping information")
action(n2, "determine shipping details")
action(n3, "is Saved shipping address selected")
branch(b1, XOR)
action(n4, "continue with process for Saved shipping address")
action(n5, "is New shipping address entered")
branch(b2, XOR)
action(n6, "continue with process for New shipping address")
end(e2)
action(n8, "confirm shipping address is correct")
action(n9, "select desired shipping speed")
action(n10, "process ends after selecting shipping speed")
converge(c1)
defines(v1, "is Saved shipping address selected", {true, false})
defines(v2, "is New shipping address entered", {true, false})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, b2, n6, n8, n9, n10, e2, c1])
precedence(i1, n1)
precedence(n3, b1)
precedence(n5, b2)
precedence(n10, e2)
precedence(c1, n8)
precedence(n1, n2)
precedence(n2, n3)
precedence(b1, n4)
precedence(b1, n5)
precedence(b2, n6)
precedence(b2, c1)
precedence(n4, c1)
precedence(n6, c1)
precedence(n8, n9)
precedence(n9, n10)
guard(b1, n4, v1 = true)
guard(b1, n5, v1 = false)
guard(b2, n6, v2 = true)
guard(b2, c1, v2 = false)