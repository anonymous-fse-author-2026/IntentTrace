      ],
      "justification": "Guard accurately models the routing condition for experienced staff."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the non-compliance invoice is processed."
      ],
      "justification": "Action matches the processing instruction, with context provided by the guard."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "If it is a normal case"
      ],
      "justification": "Guard correctly captures the normal case condition."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "the client is called."
      ],
      "justification": "Action directly matches the calling instruction."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If none of these conditions apply"
      ],
      "justification": "Guard correctly models the fallback/else condition."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Action and end node faithfully capture the mailing and termination steps."
    },
    {
