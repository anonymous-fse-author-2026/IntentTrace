@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start ONS Bootstrapping process;
:Is input a URN?;
:v1: Is input a URN? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Resolve URN to domain-name;
:Re-check input type;
:v1: Is input a URN? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Send DNS query for the domain-name;
:Get list of URLs from DNS query;
:Link to designated DS;
:End of process;
stop
else ([v1 = 'No'])
:Handle alternative input;
stop
endif
else ([v1 = 'No'])
:Simply continue with process;
:Get list of URLs from DNS query;
:Link to designated DS;
:End of process;
stop
endif
@enduml