  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "The opening clause explicitly triggers the process start and defines the initial sending action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Directly corresponds to the receipt step following the initial send."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Exact match for the clarification step with TS."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Faithfully restates the first approval verification step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized.",
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Collectively models the exclusive choice between internal and external resources and their identical authorization outcomes."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized.",
