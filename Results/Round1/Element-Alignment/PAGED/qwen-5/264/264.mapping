    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Directly captures the submission of documentation and approval to HR."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Exact match for the scanning and recording step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Structural nodes handle implicit flow synchronization around the re-check and re-sending steps described in the source."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Correctly identifies the termination point of the workflow."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues.",
        "However, if there are variations, a business case is completed.",
        "However, if there are variations, a business case is completed and attached."
      ],
      "justification": "The model decomposes the source's repeated conditional clauses into multiple branches and guards that faithfully preserve the continuation path and the business case completion/attachment paths."
    },
