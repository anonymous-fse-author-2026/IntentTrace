  "mutations": [
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "reason": "The source states receipt as a definitive fact concluding the process, but the model reframes it as an interrogative condition ('does HR services receive...'), altering the deterministic nature of the step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed and attached."
      ],
      "reason": "Introduces interrogative phrasing and the concept of repetition ('again') not present in the corresponding source unit, drifting from the declarative conditional structure of the text."
    }
  ],
