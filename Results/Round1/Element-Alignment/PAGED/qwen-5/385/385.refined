init(i1)
action(n1, "Start the Casual Admin Assistant hiring process")
action(n2, "Commence reference check")
action(n3, "Check applicants referees")
action(n4, "Is referee report complete")
branch(b1, XOR)
action(n5, "Received Incomplete Referee Report process ends")
end(e1)
action(n6, "Send Complete Referee Report to archive applications")
action(n7, "Evaluate and rank candidates")
action(n8, "Process concludes")
end(e2)
defines(v1, "Is referee report complete", {"Complete", "Incomplete"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, e1, n6, n7, n8, e2])
precedence(i1, n1)
precedence(n4, b1)
precedence(n5, e1)
precedence(n8, e2)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(b1, n5)
precedence(b1, n6)
precedence(n6, n7)
precedence(n7, n8)
guard(b1, n5, v1 = 'Incomplete')
guard(b1, n6, v1 = 'Complete')