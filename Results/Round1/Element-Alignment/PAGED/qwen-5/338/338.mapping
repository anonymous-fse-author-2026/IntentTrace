  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, if the option \"research schedule directly\" is selected"
      ],
      "justification": "The opening conditional clause establishes the process start, the selection check action, and the primary XOR branching point."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Directly implements the positive-branch action specified in the source."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the option is not selected"
      ],
      "justification": "Captures the negative condition routing to the alternative path."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Maps the two sequential actions and the implicit convergence of the initial divergent paths."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Covers the validation step, the satisfaction check modeled as an action node, and the resulting XOR decision gateway."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Matches the negative satisfaction outcome and the mandated research action."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Captures the positive satisfaction outcome, the guard routing forward, and the structural merge before ticket creation."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory"
      ],
      "justification": "Represents the secondary decision point triggered when the schedule remains unsatisfactory."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Aligns with the fallback action and its guarding condition after repeated checks."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Routes the alternative satisfactory path back to the ticket-ordering flow."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Directly implements the post-writing validation step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Models the approval verification check and its associated decision gateway."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->n15"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Matches the rejection termination path, including the terminal action and end node."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Captures the approval-based validation step and its routing condition."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Implements the iterative re-check step and its decision split."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Implements the final re-check step and its decision split."
    },
    {
      "refs": [
        "action:n21",
        "guard:b6->n21"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Matches the final positive termination condition and end node."
    }
