      ],
      "justification": "Branch splits the flow. Guard captures the unavailability condition. Action performs the production step."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "if the Article is available, proceed to Collect the Goods"
      ],
      "justification": "Guard captures the availability condition. Action performs the collection step."
    },
    {
