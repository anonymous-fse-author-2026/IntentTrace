{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "The opening clause implicitly starts the process and describes the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "then Check Levels of Inventory"
      ],
      "justification": "Direct paraphrase of the inventory checking step."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "The conditional triggers the XOR split and sets the guard condition for the lower branch."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "below or equal to the minimum, generate an Equal to or below minimum Report"
      ],
      "justification": "Faithfully restates the action taken when the lower threshold condition is met."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report"
      ],
      "justification": "Captures the higher threshold guard and the corresponding reporting action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)"
      ],
      "justification": "Direct match for the purchase order creation step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Describes the termination path for the above-minimum case and implicitly signals the process end node."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Defines the rejection branch, its guard condition, and the rework action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Defines the approval guard and the subsequent print/release action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Direct match for the PO review step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "The keyword 'Simultaneously' triggers an AND split, defines both parallel actions, and implies their subsequent convergence."
    },
    {
      "refs": [
        "label:n10->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "The condition becomes the label on the connection, and the consequent becomes the action."
    },
    {
      "refs": [
        "label:n11->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "The condition becomes the label on the connection, and the consequent becomes the action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Direct match for the transition toward invoice receipt."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Direct match for the transition toward packing slip receipt."
    },
    {
      "refs": [
        "label:c1->n17",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the Invoice is received"
      ],
      "justification": "Marks the point where parallel tracking paths rejoin, sets the label for the next transition, and defines the invoice receipt action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match."
      ],
      "justification": "Direct match for the three-way matching step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Direct match for the fund release action contingent on the match."
    },
    {
      "refs": [
        "label:n18->n19"
      ],
      "verbatim_texts": [
        "Once the funds are released"
      ],
      "justification": "Temporal condition correctly captured as a connection label."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "issue the payment."
      ],
      "justification": "Direct match for the payment issuance step."
    },
    {
      "refs": [
        "label:n19->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Captures the post-condition label, the completion action, and the final process end node."
    }
  ],
