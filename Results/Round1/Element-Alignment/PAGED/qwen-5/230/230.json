    {
      "id": "i1",
      "content": "The loan application process starts with receiving the loan application."
    },
    {
      "id": "i2",
      "content": "Simultaneously,"
    },
    {
      "id": "i3",
      "content": "assessing the loan risk"
    },
    {
      "id": "i4",
      "content": "checking the credit history."
    },
    {
      "id": "i5",
      "content": "After that,"
    },
    {
      "id": "i6",
      "content": "the eligibility of the applicant is assessed."
    },
    {
      "id": "i7",
      "content": "If the applicant is eligible,"
    },
    {
      "id": "i8",
      "content": "the acceptance pack is prepared."
    },
    {
      "id": "i9",
      "content": "If the applicant is not eligible, the application is rejected."
    },
    {
      "id": "i10",
      "content": "If the application is rejected, the loan application process ends."
    },
    {
      "id": "i11",
      "content": "On the other hand, if the applicant is eligible, the acceptance pack is prepared."
    },
    {
      "id": "i12",
      "content": "The prepared acceptance pack is then sent."
    },
    {
      "id": "i13",
      "content": "Once the acceptance pack is sent, the process ends."
    }
