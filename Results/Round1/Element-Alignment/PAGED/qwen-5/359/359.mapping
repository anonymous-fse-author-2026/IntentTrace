{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "init:i1 captures the implicit process start. action:n1 faithfully restates the initial instructional step without altering meaning or granularity."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "guard:b1->c1",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "action:n2 and branch:b1 model the conditional check. guard:b1->n3 (v1=false) maps precisely to 'no suitable candidate', routing to action:n3 ('Advertise the vacancy'). guard:b1->c1 (v1=true) correctly implements the implicit XOR alternative path required by the conditional structure."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->n5",
        "guard:b2->c1",
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "action:n4 and branch:b2 model the secondary check. guard:b2->n5 (v2=false) maps precisely to 'still no suitable candidate', routing to action:n5 ('Advertise the vacancy again'). guard:b2->c1 (v2=true) correctly implements the implicit positive alternative path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "action:n6 directly implements the selection instruction. The conditional preamble is captured structurally by the preceding branching and convergence flow."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "action:n7 captures the appointment state/event. action:n8 and end:e1 jointly capture the termination instruction and the explicit structural endpoint."
    }
  ],
