@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:click: Start;
:select: Edit Report;
:is expense > 1000?;
:v1: expense ({[0-]}); <<objectSignal>>
if () then ([v1 > 1000])
:review report;
:evaluate review decision;
:v3: evaluate review decision ({Rejected, Approved}); <<objectSignal>>
if () then ([v3 = 'Rejected'])
:edit report;
else ([v3 = 'Approved'])
:check translation need again;
:evaluate review decision again;
:v3: evaluate review decision ({Rejected, Approved}); <<objectSignal>>
if () then ([v3 = 'Rejected'])
:edit report;
else ([v3 = 'Approved'])
:translate receipts again;
:confirm receipts again;
endif
endif
else ([v1 <= 1000])
:check translation need;
:v2: translation need ({Required, Not Required}); <<objectSignal>>
if () then ([v2 = 'Required'])
:translate receipts;
else ([v2 = 'Not Required'])
:confirm receipts;
endif
endif
:evaluate receipt decision;
:v5: evaluate receipt decision ({Accepted, Rejected}); <<objectSignal>>
if () then ([v5 = 'Accepted'])
:process expense;
:end;
stop
else ([v5 = 'Rejected'])
:edit report;
:end;
stop
endif
@enduml