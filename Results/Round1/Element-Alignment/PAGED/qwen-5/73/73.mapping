    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the response is \"no\", refuse to fulfill the order and end the process."
      ],
      "justification": "Maps the negative guard, the combined refusal-and-termination action, and the structural end node to the fallback path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After confirming the availability, check if the item is in stock."
      ],
      "justification": "Directly corresponds to the stock-check step, faithfully restated as a question in the model."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is, the process ends."
      ],
      "justification": "Aligns with the terminal action and the closing structural node for the successful path."
    }
