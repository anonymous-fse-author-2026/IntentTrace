      "verbatim_texts": [
        "To begin the process for Wiggo Company, first check the authority to make a purchase."
      ],
      "justification": "Covers process initiation and the initial verification step described in the opening clause."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the response is \"okay\", proceed to verify the availability."
      ],
