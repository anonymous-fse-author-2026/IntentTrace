{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "Opening clause implicitly starts the process; n1 and n2 directly implement the two sequential actions described."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "Condition captured as action n3, XOR split b1 opens the decision, guard encodes the threshold value, and n4 executes the consequent step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Guard handles the alternative branch condition; n5 explicitly states termination, aligned with structural end node e1."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Direct paraphrase of the review step immediately following purchase order creation."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "XOR decision point b2 splits based on status; guard captures rejection value; n8 performs the rework action."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Guard captures approval status; n9 executes the corresponding fund reservation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Converge node rejoins the conditional paths; n10 implements the required review step following the status-handling branch."
    },
    {
      "refs": [
        "action:n9",
        "action:n11"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "n9 covers the reservation step referenced here; n11 implements the subsequent supplier dispatch."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time"
      ],
      "justification": "Concurrency keyword triggers AND gateway b3 for parallel execution; n12 and n13 perform the two simultaneous receipt tasks."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Concurrency keyword triggers AND gateway b3 for parallel execution; n12 and n13 perform the two simultaneous receipt tasks."
    },
    {
      "refs": [
        "action:n12",
        "action:n14"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Sequential receive (n12) and record (n14) actions for the packing slip match the source order."
    },
    {
      "refs": [
        "action:n13",
        "action:n15"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Sequential receive (n13) and record (n15) actions for the invoice match the source order."
    },
    {
      "refs": [
        "action:n14",
        "action:n16"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Recording action n14, explicit termination action n16, and end node e2 faithfully reproduce the closing clause."
    },
    {
      "refs": [
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Recording action n15, explicit termination action n17, and end node e3 faithfully reproduce the closing clause."
