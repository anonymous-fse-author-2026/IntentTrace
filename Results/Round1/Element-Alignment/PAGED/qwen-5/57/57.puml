@startuml
!theme plain
|a_default| Default
|a_default|
start
:make purchase and connect to website;
repeat :search for item;
:add item to cart / continue shopping;
:v1: add item to cart / continue shopping ({Add to Cart, Continue Shopping}); <<objectSignal>>
backward:continue shopping;
repeat while () is ([v1 = 'Continue Shopping']) not ([v1 = 'Add to Cart'])
:proceed to checkout;
split
:enter address shipping method and payment information;
split again
:authorize credit card and check inventory levels;
end split
:checkout tasks completed?;
:v2: checkout tasks completed? ({Approved and In Stock, Denied or Out of Stock}); <<objectSignal>>
if () then ([v2 = 'Approved and In Stock'])
:credit card approved and inventory in stock?;
:v3: credit card approved and inventory in stock? ({Proceed to Confirmation, Terminate Transaction}); <<objectSignal>>
if () then ([v3 = 'Proceed to Confirmation'])
:display order confirmation number;
:show final order to customer;
:confirm the order;
:send confirmation notice via email;
:order entry complete;
stop
else ([v3 = 'Terminate Transaction'])
:transaction ended;
stop
endif
else ([v2 = 'Denied or Out of Stock'])
:the transaction will end;
stop
endif
@enduml