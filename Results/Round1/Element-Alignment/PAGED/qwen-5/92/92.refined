init(i1)
action(n0, "Register participation for the event")
action(n1, "start")
action(n2, "Is there a fee?")
branch(b1, XOR)
action(n3, "Register post-seminar request")
action(n4, "Create purchase request")
action(n5, "Check purchase request approval status")
branch(b2, XOR)
action(n6, "Approved notification received")
end(e1)
action(n7, "Rejected notification received")
end(e2)
action(n8, "Register post-seminar request")
defines(v1, "Is there a fee?", {"Yes", "No"})
defines(v2, "Check purchase request approval status", {"Approved", "Rejected"})
actor(a_default, "Default", [i1, n0, n1, n2, b1, n3, n4, n5, b2, n6, e1, n7, e2, n8])
precedence(i1, n0)
precedence(n0, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n4, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n7)
precedence(n3, e1)
precedence(n6, n8)
precedence(n8, e1)
precedence(n7, e2)
guard(b1, n3, v1 = 'No')
guard(b1, n4, v1 = 'Yes')
guard(b2, n6, v2 = 'Approved')
guard(b2, n7, v2 = 'Rejected')