defines(v2, "Is purchase status rejected", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, e1, n5, n6, n7, b2, n8, n9, n23, n24, b8, n16, n17, n18, n19, n20, e2, n21, e3])
