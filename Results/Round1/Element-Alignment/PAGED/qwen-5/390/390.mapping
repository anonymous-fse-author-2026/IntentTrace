  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "The initiation node and the first three actions faithfully decompose the opening unit, covering the start signal, the ordering requirement, and the bulk order placement."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
      ],
      "justification": "Captures the explicit credit allowance condition, models the implied decision split, and executes the stated delivery processing step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance."
      ],
      "justification": "Directly maps to the stated consequence (state/outcome) of exceeding the credit limit."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "In the case of an Outstanding Balance, a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "Faithfully reproduces the conditional action of placing a new order."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If a new order is placed, it will be recorded in the Accounts Receivable."
      ],
      "justification": "Exact match for the accounts receivable recording step."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "If Payments are Received, the process continues."
      ],
      "justification": "Preserves the payment condition, models the resulting control flow decision, and reflects the continuation step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "However, if no payments are received, the order is dropped."
      ],
      "justification": "Directly matches the action taken when payments are absent."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Next, identify the order for installation."
      ],
      "justification": "Verbatim match for the installation identification step."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled, an Installer will be assigned."
      ],
      "justification": "Covers the installation requirement condition, models the decision gateway, and assigns the installer as instructed."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "On the other hand, if the order does not require installation, it will be packed for delivery."
      ],
      "justification": "Exact match for the packing step triggered when installation is not required."
    }
  ],
