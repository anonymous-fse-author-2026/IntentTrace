init(i1)
action(n1, "start selling cars")
action(n2, "did you get a bonus")
branch(b1, XOR)
action(n3, "Yes continue process after bonus")
action(n5, "did you get a paycheck")
branch(b2, XOR)
action(n6, "Yes continue process after paycheck")
action(n8, "pay the bill")
action(n9, "process ends")
end(e2)
converge(c1)
defines(v1, "did you get a bonus", {"Yes", "No"})
defines(v2, "did you get a paycheck", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n5, b2, n6, n8, n9, e2, c1])
precedence(i1, n1)
precedence(n2, b1)
precedence(n5, b2)
precedence(n9, e2)
precedence(c1, n8)
precedence(n1, n2)
precedence(b1, n3)
precedence(b1, n5)
precedence(b2, n6)
precedence(b2, c1)
precedence(n3, c1)
precedence(n6, c1)
precedence(n8, n9)
guard(b1, n3, v1 = 'Yes')
guard(b1, n5, v1 = 'No')
guard(b2, n6, v2 = 'Yes')
guard(b2, c1, v2 = 'No')