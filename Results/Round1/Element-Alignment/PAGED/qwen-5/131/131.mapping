      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "Init captures the process trigger implicitly; n2 faithfully executes the mailbox emptying instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "n3 performs the verification step; b1 structurally represents the ensuing decision gateway."
    },
    {
      "refs": [
        "guard:b1->n19"
      ],
      "verbatim_texts": [
        "if not, continue the process."
      ],
      "justification": "Guard correctly captures the negative outcome condition leading to process continuation."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Guard, action, and end node collectively implement the positive condition and termination flow."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again, if not, continue the process. If it is empty, the process ends."
      ],
      "justification": "n19 captures the repeated verification step; subsequent branching and ending logic reuse prior structural nodes."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "n5 accurately paraphrases the completeness verification; b2 marks the resulting exclusive choice."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Guard and action preserve the completeness condition and the exact recording instructions."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Correctly models the incomplete condition and the required follow-up call."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Captures the data completion and recording step; sequencing marker is implicit in flow order."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Preserves all actors, items, destination, and timing constraints despite minor clause reordering."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Faithfully implements the membership approval condition and the stamping/dating actions."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Accurately reflects the rejection condition and the notification action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
