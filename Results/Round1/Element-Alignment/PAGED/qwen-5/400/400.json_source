  "input_elements": [
    {
      "id": "i1",
      "content": "In the beginning, if the answer is \"No\", then we continue the process."
    },
    {
      "id": "i2",
      "content": "If the answer is \"No\" again, we continue the process."
    },
    {
      "id": "i3",
      "content": "However, if the answer is \"Yes\", then we give it priority."
    },
    {
      "id": "i4",
      "content": "After that, we look up the Vendor on SAP."
    },
    {
      "id": "i5",
      "content": "If the answer is \"No\", then we need a Vendor master record and the process ends."
    },
    {
      "id": "i6",
      "content": "But if the answer is \"Yes\", then we enter the invoice in SAP."
    },
    {
      "id": "i7",
      "content": "And if the answer is \"Yes\" again, then we enter the invoice in SAP."
    },
    {
      "id": "i8",
      "content": "Once the invoice is entered in SAP, we place the entered invoices in the normal Outbox and the process ends."
    }
  ]
