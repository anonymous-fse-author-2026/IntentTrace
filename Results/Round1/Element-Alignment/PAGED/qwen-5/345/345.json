  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process for ACME, begin with the New Resupply Cycle and then proceed to Check Levels of Inventory."
    },
    {
      "id": "i2",
      "content": "If the inventory is \"greater than\" the minimum, generate an \"Above Minimum Report\"."
    },
    {
      "id": "i3",
      "content": "If it is \"below or equal to\" the minimum, generate an \"Equal to or below minimum Report\"."
    },
    {
      "id": "i4",
      "content": "If an \"Above Minimum Report\" is generated, then the process ends with the End Resupply Cycle."
    },
    {
      "id": "i5",
      "content": "If an \"Equal to or below minimum Report\" is generated, then POs are Created."
    },
    {
      "id": "i6",
      "content": "Once the POs are Created, they are subject to POs Review."
    },
    {
      "id": "i7",
      "content": "If the POs are \"rejected\", they need to be \"reworked\"."
    },
    {
      "id": "i8",
      "content": "If they are \"approved\", they are \"Printed and released in the system\" and the process ends."
    },
    {
      "id": "i9",
      "content": "If the POs are \"reworked\", then POs are Created again."
    }
  ]
}