{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "The opening unit explicitly triggers the process start (init:i1) and details the first three sequential actions (n1, n2, n3)."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "The unit poses the conditional threshold evaluated by action n4 and the XOR decision node b1."
    },
    {
      "refs": [
        "action:n7",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report."
      ],
      "justification": "Unit i3 specifies the positive-arm outcome. Guard b1->n7 (v1='True') correctly captures the satisfied condition leading to action n7."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report."
      ],
      "justification": "Unit i4 specifies the negative-arm outcome. Guard b1->n5 (v1='False') correctly captures the unsatisfied condition leading to action n5."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)"
      ],
      "justification": "Direct match to the purchase order creation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Unit i6 describes the termination point for the above-minimum branch, captured by action n6 and structural end node e1."
    },
    {
      "refs": [
        "guard:b2->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Unit i7 defines the rejection branch. Structural branch b2 evaluates it, guard b2->n20 filters for 'Rejected', and action n20 performs the rework."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Unit i8 defines the approval branch. Guard b2->n10 filters for 'Approved', and action n10 executes the print/release step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Unit i9 mandates the review step, faithfully reproduced in action n9."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Unit i10 specifies the recreation loop for reworked POs, directly mapped to action n21."
    },
    {
      "refs": [
        "action:n12",
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "Unit i11 dictates concurrent execution via the AND gateway b3, splitting into fund reservation (n12) and mailing POs (n14)."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "receive the Packing Slip."
      ],
      "justification": "Exact match for the packing slip reception step following fund reservation."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "receive the inventory."
      ],
      "justification": "Exact match for the inventory reception step following PO mailing."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "proceed to receive the Invoice."
      ],
      "justification": "Unit i14 directs invoice receipt, captured identically in action n16."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match."
      ],
      "justification": "Unit i15 specifies the three-way matching procedure, faithfully reproduced in action n17."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "release the funds."
      ],
      "justification": "Unit i16 commands fund release upon successful matching, exactly modeled in action n18."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "issue the payment."
      ],
      "justification": "Unit i17 specifies the final payment action (n19) and implies process completion, covered by structural end node e2."
    }
