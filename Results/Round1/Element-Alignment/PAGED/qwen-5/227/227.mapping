        "action:n17"
      ],
      "verbatim_texts": [
        "To begin the process, start with Insurance \"emergency\" and then analyze the insurance agreement."
      ],
      "justification": "Covers the implicit process start, the two initial sequential steps, and the loop-back repetitions of the analysis step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there is coverage, offer immediate help."
      ],
      "justification": "Models the positive coverage condition check, the XOR decision gateway, the true guard, and the corresponding help action."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is no coverage, send out an offer for emergency help."
      ],
      "justification": "Models the negative coverage condition check, the XOR decision gateway, the false guard, and the corresponding offer action."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the offer is rejected, ask for a rejection notification."
      ],
      "justification": "Models the rejection decision check, the XOR gateway, the false guard, and the notification request action."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is accepted, proceed with internal accounting."
      ],
      "justification": "Models the acceptance decision check, the XOR gateway, the true guard, and the accounting action."
    },
    {
      "refs": [
        "action:n9",
        "action:n10",
        "action:n11",
        "guard:b3->n12",
        "guard:b3->n13",
        "guard:b4->n14",
        "guard:b4->n15",
        "guard:b5->n16",
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "Repeat the same steps if necessary."
      ],
      "justification": "Captures the repetition instruction and all associated branching/guard logic. Redundant nodes restating the same step are permitted and correctly mapped."
    },
    {
      "refs": [
        "action:n12",
        "action:n14",
        "action:n16"
      ],
      "verbatim_texts": [
        "The process concludes once all steps have been completed."
      ],
      "justification": "Maps the concluding instruction to the termination actions and structural end nodes."
    }
  ],
