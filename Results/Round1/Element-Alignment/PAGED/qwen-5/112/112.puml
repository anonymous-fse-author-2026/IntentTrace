!theme plain
|a_default| Default
|a_default|
start
:start course registration procedure;
:is exception needed;
:v1: is exception needed ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:make request for exception;
:is exception approved;
else ([v1 = 'No'])
:continue process without exception;
endif
:proceed to course enrollment;
:enroll in seminar group;
:start homework assignment;
:turn in homework;
:homework evaluation;
:is last homework;
:v3: is last homework ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'No'])
:give another homework assignment;
else ([v3 = 'Yes'])
:complete additional steps for accreditation and exam date announcement;
split
:grant accreditation;
split again
:announce exam date;
end split
:merge after granting accreditation and announcing exam date;
:sign up for exam;
:attend exam;
:exam evaluation;
:did pass exam;
:v4: did pass exam ({Pass, Fail}); <<objectSignal>>
if () then ([v4 = 'Pass'])
:course considered passed;
else ([v4 = 'Fail'])
:sign up again for exam;
endif
:merge course pass and exam re-sign up;
endif
:continue process;
:End;
stop
