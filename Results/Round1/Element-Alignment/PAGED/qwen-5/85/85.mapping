      ],
      "verbatim_texts": [
        "To begin the process for ACME Company, start by receiving the customer request and then check the current inventory level."
      ],
      "justification": "Faithfully captures process initiation and the first three sequential steps described in the opening clause."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum"
      ],
      "justification": "Accurately models the inventory verification condition and establishes the exclusive decision gateway."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "is at or below the minimum",
        "accept the customer request"
      ],
      "justification": "Directly executes the acceptance action on the positive inventory branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "is above the minimum",
        "reject the customer request"
      ],
      "justification": "Directly executes the rejection action on the negative inventory branch."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the customer request is rejected, the process ends.",
        "is rejected"
      ],
      "justification": "Correctly implements the termination workflow specifically for rejected customer requests."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "create a purchase order"
      ],
      "justification": "Exact implementation of the purchase order creation step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the purchase order is created, review it."
      ],
      "justification": "Exact implementation of the review step following creation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "if the purchase order is approved"
      ],
      "justification": "Accurately models the approval status check and establishes the second exclusive decision gateway."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "is approved",
        "reserve the funds"
      ],
      "justification": "Directly executes the fund reservation action on the approved branch."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "rework the purchase order"
      ],
      "justification": "Directly executes the rework action on the unapproved branch."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "send the purchase order"
      ],
      "justification": "Exact implementation of the purchase order sending step."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Correctly triggers an AND split to handle both document receipts in parallel."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Upon receiving the packing slip, record it."
      ],
      "justification": "Exact implementation of the packing slip recording step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "upon receiving the invoice, record it as well."
      ],
      "justification": "Exact implementation of the invoice recording step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Release the reserved funds and issue the payment."
      ],
      "justification": "Converges properly rejoin the parallel recording flows, leading directly into the exact combined release-and-payment step."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Finally, issue the payment and the process ends."
      ],
      "justification": "Faithfully captures the final payment confirmation and explicit process termination."
    }
