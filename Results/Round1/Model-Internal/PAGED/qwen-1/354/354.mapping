{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks"
      ],
      "justification": "The opening clause implicitly triggers the start node and describes the initial immigration check action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then they should select the method for exit control checks."
      ],
      "justification": "Directly corresponds to the second sequential step described in the text."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics"
      ],
      "justification": "The conditional clause initiates the XOR branch and defines the guard condition for the biometric path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "they should undergo a check using biometrics."
      ],
      "justification": "Faithfully reproduces the action taken on the positive biometric branch."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if the passenger prefers to use ID documents"
      ],
      "justification": "Defines the alternative guard condition for the ID document path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should undergo checks using identity documents."
      ],
      "justification": "Faithfully reproduces the action taken on the ID document branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After the exit control checks,"
      ],
      "justification": "The completion of the parallel exit control methods implies a converge point, followed by the implicit evaluation step modeled as an action."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "if the passenger is denied permission"
      ],
      "justification": "Captures the negative permission condition on the connection."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should leave the area"
      ],
      "justification": "Directly states the action following denial of permission."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "if the passenger is allowed to continue"
      ],
      "justification": "Captures the positive permission condition on the connection."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they should proceed to the next step"
      ],
      "justification": "Directly states the action following allowed continuation."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful"
      ],
      "justification": "The conditional statement drives the evaluation action, the XOR branch split, and the unsuccessful outcome guard."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the passenger should leave the area and the process ends."
      ],
      "justification": "Accurately reflects the combined departure and termination instruction for the unsuccessful path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Explicitly signals the termination of the workflow, supporting both the end action step and the structural end node."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "if the outcome is successful"
      ],
      "justification": "Captures the positive outcome condition on the connection."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the passenger should continue to the next step and the process ends."
      ],
      "justification": "Accurately reflects the combined continuation and termination instruction for the successful path."
    }
