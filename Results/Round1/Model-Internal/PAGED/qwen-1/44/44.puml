@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:select a filter;
:apply the selected filter;
:click on Submit button;
:is option to submit false;
:v1: is option to submit false ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:apply another filter;
:click on Submit button again;
else ([v1 = 'No'])
:continue with process after submit false;
endif
:is there another filter to apply;
:v2: is there another filter to apply ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:continue with process if another filter to apply;
else ([v2 = 'No'])
:continue with process if no more filters;
endif
:is option to submit true;
:v3: is option to submit true ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:continue with process if option submit true;
else ([v3 = 'No'])
:end process;
endif
stop
@enduml