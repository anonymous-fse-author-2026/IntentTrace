  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "The opening clause implicitly starts the process and explicitly defines the initial UI interactions. All three action nodes and the init node faithfully reproduce the instruction and sequence."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "The conditional structure and subsequent review action are captured exactly by the branch, query action, and review action nodes."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "The lower-expense path rejoins at the converge node, immediately followed by the translation-check action. Both align with the source instruction."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts. If not, confirm the receipts."
      ],
      "justification": "The branch and both resulting action nodes directly mirror the conditional translation workflow described."
    },
    {
      "refs": [
        "action:n11",
        "action:n6"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Both action nodes faithfully restate the review-evaluation instruction. Redundancy in modeling is acceptable and does not alter behaviour."
    },
    {
      "refs": [
        "action:n11",
        "action:n6"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "The repeated evaluation instruction is covered by the same action nodes, consistent with the iterative flow in the source."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n7",
        "action:n12",
        "guard:b4->n12"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "The rejection condition and subsequent editing action appear twice in the process flow. Both branch-action-guard triplets and the duplicate action node accurately capture this repeated step."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "continue to check if there is a need for translation."
      ],
      "justification": "The guard representing the approval route directly enables the continuation to the translation check, matching the conditional flow."
    },
    {
      "refs": [
        "guard:b4->n13",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "The approval guard and the sequential translate/confirm actions exactly reproduce the source instruction."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Direct paraphrase of the final evaluation step."
    },
    {
      "refs": [
        "action:n16",
        "guard:b5->n16"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "The acceptance condition and processing action are mapped precisely."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "The rejection guard and editing action align exactly with the source text."
    },
    {
      "refs": [
        "action:n16",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "The terminal processing step and the explicit termination actions/nodes faithfully reproduce the closing instruction. Structural converges and redundant end nodes correctly reflect process completion without altering behaviour."
    }
