{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "The opening clause explicitly initiates the process and describes the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model"
      ],
      "justification": "Direct instruction to create the model follows initialization."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "and check it. If the process model is \"NOT OK\","
      ],
      "justification": "The check and conditional split map to the action node, XOR branch, and corresponding OK/NOT OK guards."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then assign negative points."
      ],
      "justification": "Exact match for the penalty step on the negative branch."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\","
      ],
      "justification": "The second conditional check maps to the action node, XOR branch, and guards for remaining status."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "assign negative points again."
      ],
      "justification": "Exact match for the repeated penalty step."
    },
    {
      "refs": [
        "action:n7",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Multiple continuation steps faithfully restate the source instruction to proceed when conditions are met."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Action content directly paraphrases the issue resolution and extension instruction."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "The first conditional path and its continuation are accurately captured by the referenced nodes and guard."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "The second conditional path and role assignment are accurately captured by the shared decision node and distinct guard/action."
    },
    {
      "refs": [
        "action:n14",
        "guard:b4->n15",
        "guard:b4->n16",
        "action:n15",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "The conditional check, branch, guards, and subsequent action nodes fully implement the approval and role-based work instruction."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct match for the monitoring and consultation step."
    },
    {
      "refs": [
        "action:n19",
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it."
      ],
      "justification": "The positive acceptance condition and presentation step are correctly modeled."
    },
    {
      "refs": [
        "action:n19",
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "The negative acceptance condition and continued work step are correctly modeled."
    },
    {
      "refs": [
        "action:n22",
        "guard:b6->n23",
        "guard:b6->n24",
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again. If not, continue working according to your role."
      ],
      "justification": "Repeats the acceptance logic with accurate guards and actions for the second iteration."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "The final presentation action and explicit end node perfectly align with the closing statement."
    }
  ],
