@startuml
!theme plain
|a_default| Default
|a_default|
start
:start buyer process;
:choose a book;
:choose what to do after selecting book;
:v1: choose what to do after selecting book ({view details, view new copies, view used copies}); <<objectSignal>>
switch ()
case ([v1 = "view details"])
:view book details;
:choose what to do after viewing book details;
:v2: choose what to do after viewing book details ({view new copies, select copy}); <<objectSignal>>
if () then ([v2 = "view new copies"])
:view list of new copies from book details;
-> After selecting preferred copy;
else ([v2 = "select copy"])
:select a copy and complete process;
-> After selecting preferred copy;
endif
case ([v1 = "view new copies"])
:view list of new copies;
-> After selecting preferred copy;
case ([v1 = "view used copies"])
:view list of used copies;
:evaluate list of used copies;
:select preferred copy and complete process;
-> After selecting preferred copy;
endswitch
:End;
stop
@enduml