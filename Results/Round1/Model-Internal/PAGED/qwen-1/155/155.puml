@startuml
!theme plain
|a_default| Default
|a_default|
start
:Resupply Cycle Triggered;
:Check Inventory Level;
:Inventory Level at or below minimum;
:v1: Inventory Level at or below minimum ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Create Purchase Order;
:Reviewing Purchase Order;
:Purchase Order Approved;
:v2: Purchase Order Approved ({Approved, Rejected}); <<objectSignal>>
if () then ([v2 = 'Approved'])
:Reserve Funds for Purchase;
:Send Order to Suppliers;
split
:Supplier sends packing slip;
:Record packing slip;
split again
:Supplier sends invoice;
:Record invoice;
end split
:Release reserved funds;
:Issue payment to supplier;
:End Process;
stop
else ([v2 = 'Rejected'])
:Rework Order;
:Reviewing Purchase Order;
endif
else ([v1 = 'No'])
:End Process;
stop
endif
@enduml