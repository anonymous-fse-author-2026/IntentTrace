{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially,",
        "if the option \"research schedule directly\" is selected,"
      ],
      "justification": "The process start and initial XOR decision are directly triggered by the opening conditional clause."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "is selected"
      ],
      "justification": "The positive guard value matches the selection condition, leading directly to the specified action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "The positive guard value matches the selection condition, leading directly to the specified action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "The negative guard and subsequent action nodes faithfully implement both parts of the alternative path."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Covers the validation step, the satisfactory-state check, and the resulting decision branch."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Correctly maps the negative outcome of the satisfaction check to the repeat research action."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "If it is,"
      ],
      "justification": "Represents the positive branch outcome converging toward the next stage."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory,"
      ],
      "justification": "Models the condition for the secondary negative path."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Links the persistent dissatisfaction condition to the indication provision action."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory,"
      ],
      "justification": "Captures the alternative positive convergence condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "write a ticket order to SNCF."
      ],
      "justification": "Parallel/split paths rejoin before executing the ticket ordering step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Exact match for the post-writing validation instruction."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Directly implements the first approval verification and branching."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Faithfully models the first rejection path terminating the process."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Explicitly models the standalone termination statement."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Accurately links the approval condition to the re-validation step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Represents the second iterative approval check and branch."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Redundant validation step within the approval loop, consistent with source instruction patterns."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Represents the third iterative approval check and branch."
    },
    {
      "refs": [
        "guard:b6->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Correctly implements the final successful approval leading to termination."
    }
  ],
