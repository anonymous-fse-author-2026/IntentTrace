@startuml
!theme plain
|a_default| Default
|a_default|
start
:trigger resupply cycle;
:check inventory level;
:inventory at or below minimum;
:v1: inventory at or below minimum ({true, false}); <<objectSignal>>
if () then (["v1 = true"])
:create purchase order;
:review purchase order;
:v2: purchase status approved ({true, false}); <<objectSignal>>
if () then (["v2 = false"])
