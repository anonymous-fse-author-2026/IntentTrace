:review purchase order;
else (["v2 = true"])
:reserve funds;
:send order to supplier;
split
:receive packing slip;
:record packing slip;
:process ends;
stop
split again
:receive invoice;
:record invoice;
:process ends;
stop
end split
endif
else (["v1 = false"])
:process ends;
stop
endif
