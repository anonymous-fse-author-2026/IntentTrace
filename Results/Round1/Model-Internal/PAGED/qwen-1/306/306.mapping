      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "The opening clause implicitly defines the process start and contains the exact first two sequential steps."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "The conditional triggers the XOR branch, the condition itself is captured as an action step per modeling choice, and the consequent action matches exactly."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "The negative arm action 'process ends' and the structural end node align with the closing clause of this branch path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Directly corresponds to the review step following purchase order creation."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "The conditional introduces the second XOR gateway and specifies the rework action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Faithfully restates the alternative approval path action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Corresponds to the review step in the rework loop; rework action is redundantly captured in n8, which is permitted."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Matches the supplier dispatch step; fund reservation is redundantly captured in n9."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "The concurrency marker 'At the same time' justifies the AND gateway, splitting into the two simultaneous receipt actions."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Captures the recording step immediately following packing slip receipt."
    },
    {
