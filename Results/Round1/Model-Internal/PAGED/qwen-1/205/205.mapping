      ],
      "verbatim_texts": [
        "To initiate the process for ACME Company, the Resupply Cycle is triggered"
      ],
      "justification": "The opening clause implicitly triggers the process start (init) and explicitly defines the first operational step (action)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level."
      ],
      "justification": "Direct instruction mapped to the inventory verification step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the Inventory is greater than the Minimum Level"
      ],
      "justification": "The conditional clause establishes the exclusive decision point."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "then the process ends."
      ],
      "justification": "Explicit termination signal for the high-inventory path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, a Purchase Order is created."
      ],
      "justification": "Direct action mapping for the insufficient inventory path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "The Purchase Order is then reviewed."
      ],
      "justification": "Sequential review step matches exactly."
    },
