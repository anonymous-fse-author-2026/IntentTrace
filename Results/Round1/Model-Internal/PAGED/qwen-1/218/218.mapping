      ],
      "verbatim_texts": [
        "For MyCorp, the process begins by entering expenses."
      ],
      "justification": "The opening sentence establishes the process start context for MyCorp and defines the initial action of entering expenses, which are distributed across the init node and two action nodes in the model."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After entering expenses, the next step is to generate a spreadsheet."
      ],
      "justification": "Directly captures the sequential step of generating the spreadsheet."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the spreadsheet is generated, the request can be approved or disapproved."
      ],
      "justification": "Models the approval decision point using an action node paired with an XOR branch, faithfully representing the conditional logic."
    },
    {
      "refs": [
        "guard:b1->c1",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the request is not approved, the process goes back to entering expenses."
      ],
      "justification": "The guard correctly captures the negative condition ('Disapproved' aligns with 'not approved') and the action models the loop back to entering expenses."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the request is approved, the expenses can be paid out."
      ],
      "justification": "The guard captures the positive condition ('Approved') and the action faithfully represents the payout step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Correctly models the second decision/checkpoint using an action node and an XOR branch."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is not approved, the process goes back to entering expenses."
      ],
      "justification": "Matches the second negative condition and the corresponding loop-back action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if it is approved, the expenses can be paid out."
      ],
      "justification": "Matches the second positive condition and the corresponding payout action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Finally, after the expenses are paid out, the process comes to an end."
      ],
      "justification": "Accurately reflects the final termination step and the process end node."
    }
  ],
