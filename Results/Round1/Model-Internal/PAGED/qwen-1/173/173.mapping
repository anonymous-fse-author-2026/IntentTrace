      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Init node and action step jointly capture the opening instruction to identify the vacancy."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "Branch and check action model the decision point; guard captures the negative condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then advertise the vacancy."
      ],
      "justification": "Directly implements the advertised action upon the negative check."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "if there is a suitable candidate available,"
      ],
      "justification": "Guard captures the positive condition; action restates the availability check."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available,"
      ],
      "justification": "Branch and repeated check action model the second evaluation; guards cover both the 'No' path to re-advertising and the implicit 'Yes' path forward."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then advertise the vacancy again."
      ],
      "justification": "Faithfully restates the re-advertising step."
    },
    {
      "refs": [
        "guard:b3->c1",
        "action:n7"
      ],
      "verbatim_texts": [
        "then proceed with selecting the appropriate applicant."
      ],
      "justification": "Branch and positive guard handle the conditional gate; action captures the selection instruction."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed,"
      ],
      "justification": "Directly models the appointment step."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Termination action and end nodes capture process closure; convergence and redundant end node reflect path rejoining and final stop implied by the text."
    }
  ],
