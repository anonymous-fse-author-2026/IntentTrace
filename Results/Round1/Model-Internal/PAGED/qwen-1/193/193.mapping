{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "The opening clause implicitly starts the process and directly describes the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, proceed with the Registration gross pathology request."
      ],
      "justification": "Direct paraphrase of the registration step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the registration is complete, assign a container to the gross pathology request."
      ],
      "justification": "Faithfully restates the container assignment instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During the \"Registration gross pathology request\" step, make sure to create a barcode scan at the start."
      ],
      "justification": "Matches the barcode creation requirement and its placement."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After assigning a container, move on to the Specimen description."
      ],
      "justification": "Directly maps to the specimen description step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "For the \"Specimen description\" step, pay attention to the scan start."
      ],
      "justification": "Exact correspondence to the scan start instruction."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Then, pay attention to the scan end."
      ],
      "justification": "Exact correspondence to the scan end instruction."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Finally, pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Faithfully captures the repeated scan start for the continuation step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Following that, proceed with Macroscopic description writing."
      ],
      "justification": "Direct match to the macroscopic description step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Tissue processing, check if \"Digitalization?\" is required."
      ],
      "justification": "Captures the concurrent execution trigger (AND gateway) and the first parallel task."
    },
    {
      "refs": [
        "guard:b1->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Accurately models the positive condition and resulting digitalization action."
    },
    {
      "refs": [
        "guard:b1->n13"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process."
      ],
      "justification": "The guard correctly extracts the negative conditional value."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Next, check if \"Digitalization?\" is required again."
      ],
      "justification": "Directly maps to the second digitalization decision point."
    },
    {
      "refs": [
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Replicates the positive branch logic for the second check."
    },
    {
      "refs": [
        "guard:b2->n16"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process."
      ],
      "justification": "The guard correctly extracts the second negative conditional value."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "After that, assign cases to the pathologist and then move on to Microscopic examination and diagnosis."
      ],
      "justification": "The compound sentence is correctly split into two sequential action steps."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the microscopic examination and diagnosis are complete, write the pathology report."
      ],
      "justification": "Direct match to the report writing step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "After writing the report, confirm it."
      ],
      "justification": "Exact correspondence to the confirmation step."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the pathology report is confirmed, deliver it."
      ],
      "justification": "Exact correspondence to the delivery step."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Then, proceed with the post-report processing."
      ],
      "justification": "Direct match to post-report processing initiation."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "To conclude the pathology procedure, close it."
      ],
      "justification": "Direct match to the procedure closure step."
    },
    {
      "refs": [
        "action:n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, deliver the pathology report and complete the post-report processing."
      ],
      "justification": "Faithfully splits the final compound instruction into two distinct steps."
    }
