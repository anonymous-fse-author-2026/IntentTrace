{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "Initially"
      ],
      "justification": "Structural start node aligns with the initial temporal marker signaling process onset."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "the appointment approval form is sent."
      ],
      "justification": "Directly captures the instruction to send the form."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Faithfully restates the receipt of approval."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Accurately preserves the actor (TS), action (contact), and purpose (clarify timing)."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Direct match for the first approval verification step."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized."
      ],
      "justification": "Combines the conditional check, the split decision node, and the positive-arm action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Matches the negative-arm authorization instruction."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Precisely captures sending both approval and mandatory docs to HR."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Exact correspondence to the scanning and recording step."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Correctly implements the repeated check-and-send sequence described in the text."
    },
    {
      "refs": [
        "action:n13",
        "action:n20"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Aligns reception action, closing action, and structural end node with the final clause."
    },
    {
      "refs": [
        "action:n14",
        "action:n15",
        "action:n16",
        "action:n19"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Covers both textual repetitions of the no-variations continuation path and the associated decision points."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed."
      ],
      "justification": "Matches the first variation branch and its completion action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed and attached."
      ],
      "justification": "Corresponds to the second variation branch with attachment, including implicit flow rejoin points."
    }
  ],
