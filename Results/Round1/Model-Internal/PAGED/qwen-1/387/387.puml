@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process;
:trigger the resupply cycle;
:check the inventory level;
:is inventory level at or below minimum;
:v1: is inventory level at or below minimum ({At_Or_Below_Minimum, Above_Minimum}); <<objectSignal>>
if () then ([v1 = "At_Or_Below_Minimum"])
:create a purchase order;
:review the purchase order;
:is purchase status rejected;
:v2: is purchase status rejected ({Rejected, Approved}); <<objectSignal>>
if () then ([v2 = "Rejected"])
:rework the purchase order;
:is purchase status rejected after rework;
:v3: is purchase status rejected after rework ({Rejected, Approved}); <<objectSignal>>
if () then ([v3 = "Rejected"])
:rework the purchase order again;
else ([v3 = "Approved"])
->;
endif
:review the purchase order after rework;
else ([v2 = "Approved"])
->;
endif
:reserve the funds;
:send order to supplier;
split
:receive the packing slip;
:record the packing slip;
:process ends after recording packing slip;
stop
split again
:receive the invoice;
:record the invoice;
:process ends after recording invoice;
stop
end split
else ([v1 = "Above_Minimum"])
:process ends because inventory above minimum;
stop
endif
@enduml