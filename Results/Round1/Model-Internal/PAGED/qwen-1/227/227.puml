@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process with Insurance emergency;
:analyze the insurance agreement;
:is there coverage;
:v1: is there coverage ({true, false}); <<objectSignal>>
if () then ([v1 = true])
:offer immediate help;
:repeat the same steps if necessary;
:v4: repeat the same steps if necessary ({true, false}); <<objectSignal>>
if () then ([v4 = false])
:conclude the process;
stop
else ([v4 = true])
:analyze the insurance agreement;
endif
else ([v1 = false])
:send out an offer for emergency help;
:has the offer been accepted;
:v2: has the offer been accepted ({true, false}); <<objectSignal>>
if () then ([v2 = false])
:ask for a rejection notification;
:repeat the same steps if necessary;
:v5: repeat the same steps if necessary ({true, false}); <<objectSignal>>
if () then ([v5 = false])
:conclude the process;
stop
else ([v5 = true])
:analyze the insurance agreement;
endif
else ([v2 = true])
:proceed with internal accounting;
:repeat the same steps if necessary;
:v3: repeat the same steps if necessary ({true, false}); <<objectSignal>>
if () then ([v3 = false])
:conclude the process;
else ([v3 = true])
:analyze the insurance agreement;
endif
endif
endif
stop
