  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "The opening clause implicitly initiates the process (init) and directly describes the start action followed by the billing and receiving steps."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "The conditional question, XOR gateway, affirmative guard, and return action collectively implement this clause."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "The negative guard and proceeding action model the continuation path when the invoice is not incomplete."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "The compliance check action and subsequent XOR branch capture the start of the non-compliance evaluation."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "The affirmative guard and resolution action directly paraphrase the phone-call resolution path."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "The negative guard and return action accurately reflect the mail-back resolution path."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "The AND gateways and converge node model the simultaneous execution signaled by 'Simultaneously', and the action captures the billing step."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n14",
        "guard:b3->c1",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "The response check, branch, guards for waiting/converging, and 10-day action fully implement this conditional wait."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Action content is a direct restatement of the payment and notification step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "The action and end node precisely capture the reminder dispatch and explicit process termination."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Action content faithfully restates the unsatisfied client resolution step."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17",
        "guard:b4->e4"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "The satisfaction branch, guards, and continuation action model the final conditional flow described."
    }
