  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, the customer should first request information about the organization and then schedule an appointment."
    },
    {
      "id": "i2",
      "content": "If the customer is in the \"Intake\" stage, they should proceed with \"Control and measurement\"."
    },
    {
      "id": "i3",
      "content": "if the customer is a \"Potential client\", the process will come to an end."
    },
    {
      "id": "i4",
      "content": "After the \"Control and measurement\" stage, the customer should revisit after two weeks."
    },
    {
      "id": "i5",
      "content": "If the target has been reached, the process will come to an end."
    },
    {
      "id": "i6",
      "content": "if the customer is dissatisfied or for any other reason, the process will also come to an end."
    }
