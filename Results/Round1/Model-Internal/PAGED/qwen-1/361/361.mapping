        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order."
      ],
      "justification": "The conditional implies the XOR branch, the guard captures the rejection status, and the action performs the required rework."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, review it again."
      ],
      "justification": "Direct match of the secondary review step."
