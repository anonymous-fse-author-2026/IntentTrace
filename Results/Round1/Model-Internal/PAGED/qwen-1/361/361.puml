@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:trigger: resupply cycle;
:check: inventory level;
:v1: check  inventory level ({above, below}); <<objectSignal>>
if () then (["v1 = 'above'"])
:end process: above minimum;
stop
else (["v1 = 'below'"])
:create: purchase order;
:review: purchase order;
:v2: review  purchase order ({rejected, accepted, parallel}); <<objectSignal>>
switch ()
case (["v2 = 'rejected'"])
:rework: purchase order;
:review: purchase order;
:v3: review  purchase order ({accepted, rejected}); <<objectSignal>>
if () then (["v3 = 'accepted'"])
stop
else (["v3 = 'rejected'"])
stop
endif
case (["v2 = 'accepted'"])
:reserve funds and send PO;
:receive packing slip and release funds;
:end process: completed;
case (["v2 = 'parallel'"])
:send to supplier;
:receive packing slip and release funds;
:end process: completed;
endswitch
endif
@enduml