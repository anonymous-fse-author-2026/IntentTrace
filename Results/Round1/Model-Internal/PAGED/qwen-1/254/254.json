  "input_elements": [
    {
      "id": "i1",
      "content": "To initiate the process for the election of a rector"
    },
    {
      "id": "i2",
      "content": "the acceptance of proposals for candidates for the rector position should be launched"
    },
    {
      "id": "i3",
      "content": "the rector can nominate themselves as a candidate for the position"
    },
    {
      "id": "i4",
      "content": "the acceptance of proposals should be stopped"
    },
    {
      "id": "i5",
      "content": "If a candidate meets the required criteria"
    },
    {
      "id": "i6",
      "content": "they should be included in the list of candidates"
    },
    {
      "id": "i7",
      "content": "they should be informed of the refusal and the process will come to an end"
    },
    {
      "id": "i8",
      "content": "Once the list of candidates has been formed, it should be made public."
    },
    {
      "id": "i9",
      "content": "Simultaneously, the candidates should promote their ideas to the public and organize a public meeting of the Academic Senate."
    },
    {
      "id": "i10",
      "content": "The public meeting should then commence, ensuring that all members are able to vote for a new rector."
    },
    {
      "id": "i11",
      "content": "Following the meeting, an election should be conducted and the votes should be counted."
    },
    {
      "id": "i12",
      "content": "If the voting fails"
    },
    {
      "id": "i13",
      "content": "another election should be conducted"
    },
    {
      "id": "i14",
      "content": "On the other hand, if the voting is successful"
    },
    {
      "id": "i15",
      "content": "the result of the election should be announced"
    },
    {
      "id": "i16",
      "content": "After announcing the result, the public meeting should be concluded and the candidate should be informed of the election results, marking the end of the process."
    }
  ]
}