{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "The opening clause establishes the process start (init) and describes the first concrete action (receiving the invoice)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is sorted per client."
      ],
      "justification": "Direct correspondence to the sorting step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor."
      ],
      "justification": "Direct correspondence to the secondary sorting step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice."
      ],
      "justification": "Faithful restatement of the attachment action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form."
      ],
      "justification": "Exact match for the data entry step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked."
      ],
      "justification": "Direct match for the validation check."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "The conditional, guard, termination action, and structural end node all align with the incomplete-invoice path."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered. The date for completion is also entered and the priority is checked."
      ],
      "justification": "The guard captures the complete condition; actions cover SLA entry, date entry, and priority checking. Redundant repetition of the priority check is permissible."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "Branch, guard, and action correctly model the high-priority stamping step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Direct match for the compliance check step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the non-compliance invoice is processed."
      ],
      "justification": "Matches the processing action for non-compliant invoices destined for experienced staff."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "the client is called."
      ],
      "justification": "Direct match for the client notification step in normal cases."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Action and structural end accurately reflect the postal mail fallback and termination."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Structural end node aligns with the concluding phrase."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO"
      ],
      "justification": "Direct match for the batching and allocation step."
    },
    {
      "refs": [
        "guard:b3->n13",
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff... If it is a normal case... If none of these conditions apply..."
      ],
      "justification": "Branch and two guards correctly map to the explicit conditions for experienced staff routing and normal case handling."
    }
  ],
