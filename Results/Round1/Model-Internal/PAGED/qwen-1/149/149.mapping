{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For the customer, the process begins with a request to purchase a motorcycle."
      ],
      "justification": "Directly covers the explicit process start and the initial customer request action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once the request is received, the next step is to either continue the process if a production order is received"
      ],
      "justification": "Captures the implicit readiness check and the exclusive split triggered by the production order condition."
    },
    {
      "refs": [
        "guard:b1->n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "Once the request is received, the next step is to either continue the process if a production order is received"
      ],
      "justification": "Represents the positive and negative outcomes of the production order decision gate."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "continue the process if a production order is received"
      ],
      "justification": "Faithfully executes the positive arm of the conditional branch."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "update the sales information and proceed to order dispatch"
      ],
      "justification": "Exact match for the alternative path action following the negative decision outcome."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If there are unavailable materials"
      ],
      "justification": "Models the material availability verification and the subsequent exclusive routing point."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If there are unavailable materials"
      ],
      "justification": "Carries the logical conditions for both arms of the material availability split."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "Alternatively, if there are available goods for production"
      ],
      "justification": "Carries the logical conditions for both arms of the material availability split."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they are ordered from the supplier"
      ],
      "justification": "Directly implements the procurement step for missing materials."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier"
      ],
      "justification": "Precisely captures the material receipt milestone."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the goods are issued and the motorcycles are produced"
      ],
      "justification": "Accurately combines the issuance and manufacturing steps as described."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the stock is updated"
      ],
      "justification": "Exact match for the inventory adjustment step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the motorcycles are dispatched"
      ],
      "justification": "Directly corresponds to the delivery/distribution step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Explicitly marks the workflow termination as stated in the source."
    }
  ],
