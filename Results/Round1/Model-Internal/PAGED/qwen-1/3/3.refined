init(i1)
action(n1, "Receive Ministerial enquiry")
action(n2, "Assign enquiry to minister")
action(n3, "Investigate enquiry")
action(n4, "Prepare ministerial response")
action(n5, "Review response")
branch(b1, XOR)
action(n6, "Address Ministerial correspondence")
action(n7, "End")
end(e1)
action(n8, "End")
end(e2)
defines(v1, "Review response", {"Not approved", "Approved"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, b1, n6, n7, e1, n8, e2])
precedence(i1, n1)
precedence(n5, b1)
precedence(n7, e1)
precedence(n8, e2)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, n5)
precedence(b1, n6)
precedence(n6, n7)
precedence(b1, n8)
guard(b1, n6, v1 = 'Not approved')
guard(b1, n8, v1 = 'Approved')