  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, the customer needs to make a purchase and then connect to the website."
    },
    {
      "id": "i2",
      "content": "After that, they should search for an item."
    },
    {
      "id": "i3",
      "content": "If they choose to \"Add item to cart\", they can proceed to checkout. However, if they select \"Continue Shopping\", they should continue with the process."
    },
    {
      "id": "i4",
      "content": "proceed to checkout"
    },
    {
      "id": "i5",
      "content": "continue with the process"
    },
    {
      "id": "i6",
      "content": "enter their address, shipping method, and payment information"
    },
    {
      "id": "i7",
      "content": "At the same time, they should also authorize the credit card and check the inventory levels."
    },
    {
      "id": "i8",
      "content": "If the credit card is approved and there is inventory in stock,"
    },
    {
      "id": "i9",
      "content": "there is inventory in stock, they can continue with the process."
    },
    {
      "id": "i10",
      "content": "if the credit card is denied or there is no inventory in stock"
    },
    {
      "id": "i11",
      "content": "the transaction will end."
    },
    {
      "id": "i12",
      "content": "the order confirmation number should be displayed,"
    },
    {
      "id": "i13",
      "content": "followed by the final order being shown to the customer."
    },
    {
      "id": "i14",
      "content": "the order should be confirmed"
    },
    {
      "id": "i15",
      "content": "a confirmation notice should be emailed to the customer."
    },
    {
      "id": "i16",
      "content": "Once the order entry is complete, the process will end."
    }
  ]
}