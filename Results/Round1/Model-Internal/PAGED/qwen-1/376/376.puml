:v3: Choose to abort after retry option ({End, Continue}); <<objectSignal>>
if () then ([v3 = 'End'])
:End process after abort;
stop
else ([v3 = 'Continue'])
:Choose to try login again after aborted retry;
:v4: Choose to try login again after aborted retry ({RetryFinal, AbortFinal}); <<objectSignal>>
if () then ([v4 = 'RetryFinal'])
:Provide userdata for flickr login;
else ([v4 = 'AbortFinal'])
:End process after abort;
stop
