    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the IDES process, begin by receiving the customer request."
      ],
      "justification": "The opening clause implicitly triggers the process start (init) and explicitly describes the first operational step (action)."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, proceed to enter the sales order."
      ],
      "justification": "Direct verbalization of the second sequential step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once the sales order has been entered, check the item availability."
      ],
      "justification": "Exact match for the third step instruction."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Following the item availability check, confirm the sales order."
      ],
      "justification": "Exact match for the fourth step instruction."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the sales order has been confirmed, move on to outbound delivery."
      ],
      "justification": "Noun/verb paraphrase that preserves the exact operational target and sequence."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After the outbound delivery, proceed to picking."
      ],
      "justification": "Direct match for the sixth step instruction."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the picking is complete, move on to packing."
      ],
      "justification": "Direct match for the seventh step instruction."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the packing is done, post the goods issue."
      ],
      "justification": "Direct match for the eighth step instruction."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "This will update the inventory."
      ],
      "justification": "Direct match for the inventory update step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Following the inventory update, proceed to update the G/L accounts.",
        "It is important to note that for the step \"Update G/L accounts,\" pay attention to the cost of goods sold and inventory."
      ],
      "justification": "Faithfully consolidates the action instruction with its explicit contextual qualifier and data focus into a single step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the G/L accounts have been updated, move on to billing."
      ],
      "justification": "Direct match for the billing step instruction."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After the billing process, update the customer account."
      ],
      "justification": "Direct match for the customer account update instruction."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the customer account has been updated, proceed to update the G/L accounts again.",
        "It is important to note that for the step \"Update G/L accounts,\" pay attention to revenue, discounts, etc."
      ],
      "justification": "Faithfully consolidates the repeated action instruction with its explicit contextual qualifier and data focus into a single step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "After updating the G/L accounts, move on to posting the payment receipt."
      ],
      "justification": "Direct match for the payment receipt posting instruction."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicitly denotes workflow termination; both the labeled step and the structural end node map directly to this closing statement without altering logic or flow."
    }
