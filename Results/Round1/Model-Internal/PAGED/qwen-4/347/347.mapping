{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "i1: To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "The opening clause explicitly initializes the process and sequences the first three actions."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "i2: If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
      ],
      "justification": "Models the conditional check, XOR split, and consequent report generation action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "i4: If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Faithfully captures the alternative arm's action."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "i6: If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "Matches the secondary decision check and PO creation step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "i8: If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Captures the early termination condition and explicit end node."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "i10: If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Correctly models rejection check and rework action."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "i12: If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Accurately reflects approval check and printing/releasing action."
    },
    {
      "refs": [
        "action:n17",
        "action:n15",
        "action:n16",
        "action:n47",
        "action:n48"
      ],
      "verbatim_texts": [
        "i14: If the PO is created, it needs to be reviewed. If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Covers both review and recreate requirements; redundant duplicate nodes are permitted under parity rules."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "i15: Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "Directly implements the two concurrent tasks described."
    },
    {
      "refs": [
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "i16: If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Models the fund reservation condition and subsequent packing slip receipt."
    },
    {
      "refs": [
        "action:n36"
      ],
      "verbatim_texts": [
        "i18: If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Matches the inventory receipt action."
    },
    {
      "refs": [
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "i19: If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Correctly sequences packing slip verification and invoice receipt."
    },
    {
      "refs": [
        "action:n38",
        "action:n39"
      ],
      "verbatim_texts": [
        "i21: If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Matches the inventory-triggered packing slip step."
    },
    {
      "refs": [
        "action:n31",
        "action:n32"
      ],
      "verbatim_texts": [
        "i23: If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Accurately links invoice receipt to the three-way match transition."
    },
    {
      "refs": [
        "action:n42",
        "action:n43"
      ],
      "verbatim_texts": [
        "i25: If the Three-way match is successful, release the funds."
      ],
      "justification": "Faithfully reproduces the success condition and fund release action."
    },
    {
      "refs": [
        "action:n44"
      ],
      "verbatim_texts": [
        "i27: Once the funds are released, issue the payment."
      ],
      "justification": "Direct paraphrase of the payment issuance step."
    },
    {
      "refs": [
        "action:n45"
      ],
      "verbatim_texts": [
        "i28: After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Captures the final completion state and terminal node."
    }
  ],
