        "action:n1"
      ],
      "verbatim_texts": [
        "The loan application process starts with receiving the loan application."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial reception action."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Simultaneously,",
        "steps should be completed:"
      ],
      "justification": "The concurrent execution marker and plural steps imply an AND parallel split."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "assessing the loan risk"
      ],
      "justification": "Direct mapping to the first parallel assessment task."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "checking the credit history"
      ],
      "justification": "Direct mapping to the second parallel assessment task."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the eligibility of the applicant is assessed."
      ],
      "justification": "Parallel paths rejoin before the eligibility assessment is performed."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the applicant is eligible,"
      ],
      "justification": "Captures the exclusive decision point, the action modeling the check, and the positive guard condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the acceptance pack is prepared."
      ],
      "justification": "Faithfully restates the preparation step on the eligible path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the application is rejected."
      ],
      "justification": "Directly maps to the rejection step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the application is rejected, the loan application process ends."
      ],
      "justification": "Covers the conditional termination of the process upon rejection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "The prepared acceptance pack is then sent."
      ],
      "justification": "Directly maps to sending the acceptance pack."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the acceptance pack is sent, the process ends."
      ],
      "justification": "Covers the final termination step after sending the pack."
    }
