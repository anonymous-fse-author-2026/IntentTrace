    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the DMS Parts Provision Team, the first step is to gather information about the part from the customer, including the make, model, and year."
      ],
      "justification": "The implicit process start and the first action faithfully reproduce the initial instruction and required data fields."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once this information is obtained, the team proceeds to check the availability of the part in the local inventory."
      ],
      "justification": "Direct paraphrase of the second procedural step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the part is found to be available locally, it is retrieved from the inventory."
      ],
      "justification": "The XOR branch, positive guard, and retrieval action jointly implement the conditional path and its immediate outcome."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After retrieving the part from the local inventory, the process comes to an end."
      ],
      "justification": "The action step and structural end node together capture the termination clause for the local inventory path."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the part is not available locally, the team proceeds to record the customer's details and then orders the part from Disuki."
      ],
      "justification": "The negative guard and two sequential actions faithfully implement the alternative conditional path and its two required sub-steps."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the part is ordered from Disuki, the process comes to an end."
      ],
      "justification": "The action step and structural end node together capture the termination clause for the external order path."
    }
  ],
