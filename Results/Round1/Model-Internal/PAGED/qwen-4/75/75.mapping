    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted"
      ],
      "justification": "Faithfully captures the alternative branch condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
