{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For TS recruitment, the first step is to advise unsuccessful candidates."
      ],
      "justification": "The opening clause implicitly triggers the process start and directly defines the first advisory action."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\""
      ],
      "justification": "The question phrasing and XOR branch with boolean guards structurally implement the candidate availability check."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the position should be re-advertised."
      ],
      "justification": "Direct paraphrase of the negative outcome action."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "guard:b2->n13"
      ],
      "verbatim_texts": [
        "if the terms and conditions of the offer for a candidate need to be sorted out"
      ],
      "justification": "Action phrasing and XOR branch correctly model the conditional requirement check."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form"
      ],
      "justification": "Faithfully reproduces the form submission step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b3->n8",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If the manager is an external resource"
      ],
      "justification": "Question phrasing and branch accurately capture the resource type evaluation."
    },
    {
      "refs": [
        "action:n9",
        "guard:b4->n11",
        "guard:b4->n12"
      ],
      "verbatim_texts": [
        "If the form is approved"
      ],
      "justification": "Action and branch correctly implement the approval status decision point."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "the process continues."
      ],
      "justification": "Structural rejoin aligns with the post-decision continuation implied by the text."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "the process continues."
      ],
      "justification": "Structural rejoin aligns with the post-condition continuation."
    },
    {
      "refs": [
        "action:n15",
        "guard:b5->n16",
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "If there are any variations"
      ],
      "justification": "Question phrasing and XOR branch correctly model the variation check."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "a complete business case is required."
      ],
      "justification": "Directly implements the required documentation step."
    },
    {
      "refs": [
        "action:n18",
        "guard:b6->n19",
        "guard:b6->c2"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate."
      ],
      "justification": "Action and branch preserve the conditional trigger and associated rate threshold."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "it can take up to 21 days to arrange and complete."
      ],
      "justification": "Action content faithfully retains the duration constraint."
    },
    {
      "refs": [
        "action:n14",
        "action:n20"
      ],
      "verbatim_texts": [
        "The TS HR coordinator informs the recruitment manager, who then liaises with the HR representative"
      ],
      "justification": "Redundant but identical actions precisely reproduce the coordination step."
    },
    {
      "refs": [
        "action:n21",
        "guard:b7->n22",
        "guard:b7->n23"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory"
      ],
      "justification": "Question phrasing and branch accurately model the satisfaction check."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "the next candidate on the shortlist should be contacted."
      ],
      "justification": "Direct implementation of the fallback contact step."
    },
    {
      "refs": [
        "converge:c3"
      ],
      "verbatim_texts": [
        "if the assessment is fine"
      ],
      "justification": "Structural rejoin aligns with the positive assessment path reunion."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "The recruitment manager makes a formal verbal offer of employment to the candidate."
      ],
      "justification": "Exact reproduction of the verbal offer action."
    },
    {
      "refs": [
        "action:n25",
        "guard:b8->n26",
        "guard:b8->n27",
        "guard:b8->c4"
      ],
      "verbatim_texts": [
        "If the candidate accepts"
      ],
      "justification": "Question phrasing and branch correctly implement the acceptance decision."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "the recruitment manager creates a formal written offer."
      ],
      "justification": "Faithfully captures the written offer creation."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Simultaneously, the commencement pack and letter of appointment are sent to the candidate."
      ],
      "justification": "Action and AND gateway jointly capture the concurrent dispatch requirement."
    },
    {
      "refs": [
        "converge:c4"
      ],
      "verbatim_texts": [
        "Once the candidate receives these documents,"
      ],
      "justification": "Structural rejoin aligns with the post-receipt temporal synchronization."
    },
    {
      "refs": [
        "action:n29",
        "guard:b9->n30",
        "guard:b9->c4"
      ],
      "verbatim_texts": [
        "if there is a \"40%\" rate"
      ],
      "justification": "Question phrasing and branch accurately model the rate threshold check."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "renegotiation is required."
      ],
      "justification": "Direct implementation of the renegotiation step."
    },
    {
      "refs": [
        "action:n31",
        "guard:b10->n32",
        "guard:b10->n33"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful"
      ],
      "justification": "Question phrasing and branch correctly implement the success evaluation."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "the next candidate on the shortlist should be identified."
      ],
      "justification": "Exact reproduction of the final fallback identification step."
    },
    {
      "refs": [
        "action:n34"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Action phrasing and end node faithfully mark the process termination."
    }
  ],
  "mutations": [
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "reason": "Drops the explicit acting party ('HR department') and omits the precise recording target ('against the stored position in GovSource'), violating the strict granularity requirement."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "they may not authorize the form."
      ],
      "reason": "Distorts a tentative possibility/metric ('may not authorize') into a rigid binary decision/check step, altering the conditional logic."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "it is necessary to check if the candidate has accepted a voluntary redundancy."
      ],
      "reason": "No model element implements this mandatory verification step."
    },
    {
      "verbatim_texts": [
        "if the candidate has accepted, further investigation is required."
      ],
      "reason": "The mandated follow-up investigation step is completely absent."
    },
    {
      "verbatim_texts": [
        "which is then received by the next level manager."
      ],
      "reason": "The explicit handoff/receipt event is unimplemented in the flow."
    },
    {
      "verbatim_texts": [
        "they may not authorize the form."
      ],
      "reason": "Uncovered because its only candidate (action:n10) was flagged as a mutation."
    },
    {
      "verbatim_texts": [
        "if the approver is an existing employee of the client"
      ],
      "reason": "The positive condition branch for internal employees lacks a corresponding guard or action element."
    },
    {
      "verbatim_texts": [
        "which is received by the client HR."
      ],
      "reason": "The client HR receipt event is missing from the process model."
    }
  ],
  "additions": [
    {
      "refs": [
        "action:n1"
      ],
      "reason": "Generic 'start' action is purely redundant with the init node and introduces no distinct process step."
    },
    {
