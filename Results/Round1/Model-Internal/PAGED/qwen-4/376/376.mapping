    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the process will end"
      ],
      "justification": "Directly captures the termination upon successful login."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the login fails, we will continue with the process."
      ],
      "justification": "Correctly models the failure path leading to continuation."
    },
    {
