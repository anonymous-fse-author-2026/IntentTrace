{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "Covers the initiation, starting phrase, and the explicit instruction to join and agree on the domain."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model and check it."
      ],
      "justification": "Exact match for creating and checking the model."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5",
        "label:n3->n4"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\", then assign negative points."
      ],
      "justification": "Captures the condition, branch decision, guard value 'NOT OK', consequence action, and edge label."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7",
        "action:n7",
        "label:n5->n6"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\", assign negative points again."
      ],
      "justification": "Captures the repeated condition, second branch, guard value, repeated consequence, and edge label."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9",
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Maps the positive 'OK' path from both initial branches to the continuation action."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "label:n8->n10"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Captures the issue check question, branch node, the fix/extend action, and connecting label."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "Captures the condition question, branch node, and continuation action."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Captures the analysis condition, branch node, and role assignment action."
    },
    {
      "refs": [
        "action:n16",
        "guard:b6->n17",
        "action:n17",
        "action:n18",
        "guard:b6->n18"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Captures the okay condition, branch, Yes/No guards, and both resulting actions."
    },
    {
      "refs": [
        "action:n19",
        "label:n19->n20"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Exact match for the progress check step and its transitional label."
    },
    {
      "refs": [
        "action:n20",
        "guard:b7->n21",
        "action:n21",
        "guard:b7->n22",
        "action:n22",
        "label:n22->n23"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it. If not, continue working according to your role."
      ],
      "justification": "Fully captures the acceptance check, branch, Yes/No guards, presentation action, fallback work action, and label."
    },
    {
      "refs": [
        "action:n23",
        "guard:b8->n24",
        "guard:b8->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again. If not, continue working according to your role."
      ],
      "justification": "Captures the repeated acceptance check, branch, guards, and fallback work."
    },
    {
      "refs": [
        "action:n26",
        "action:n27",
        "action:n28",
        "action:n29"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Covers the final presentation and the multiple structural/action nodes denoting process termination."
    }
  ],
