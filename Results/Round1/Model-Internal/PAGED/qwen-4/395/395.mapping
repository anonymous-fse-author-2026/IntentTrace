{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, it is important to check the Referee Reports."
      ],
      "justification": "The opening clause implicitly starts the process and specifies the initial verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "At the same time, you should continue to monitor if the Referee Reports have been completed."
      ],
      "justification": "Describes the monitoring check that triggers the first decision gateway."
    },
    {
      "refs": [
        "guard:b1->c1",
        "action:n7"
      ],
      "verbatim_texts": [
        "you can proceed with the process."
      ],
      "justification": "Captures the positive completion condition and the subsequent continuation action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if they have not been completed, you should flag it and send a reminder."
      ],
      "justification": "Maps the negative condition directly to the flagging and reminding action."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "you should check again if the Referee Reports have been completed."
      ],
      "justification": "Represents the secondary verification step and its associated decision point."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "you can continue with the process."
      ],
      "justification": "Reflects the success condition routing flow back to the main path."
    },
    {
      "refs": [
        "guard:b2->n4b",
        "action:n4b"
      ],
      "verbatim_texts": [
        "If not, you should flag it again and send another reminder."
      ],
      "justification": "Covers the fallback condition and the repeated escalation action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the Referee Reports have been completed, you can move on to organizing interviews for the Selection Panel with the top candidates."
      ],
      "justification": "Directly implements the interview organization step following report completion."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the interviews, it is necessary to receive feedback from the interview candidates."
      ],
      "justification": "Faithfully restates the feedback collection requirement."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Next, you need to check if a Psychometric Test is required."
      ],
      "justification": "Models the requirement evaluation and its branching logic."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If not, you can continue with the process and coordinate the second round of selection."
      ],
      "justification": "Captures the non-required outcome and the corresponding coordination action."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required, you should schedule the test with a third party."
      ],
      "justification": "Maps the specialist condition precisely to the external scheduling action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Otherwise, you can proceed to complete the Psychometric Test."
      ],
      "justification": "Corresponds to the default path for completing the test."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, you should request the final candidate ranking and continue with the process."
      ],
      "justification": "Directly implements the final ranking request and process continuation."
    }
  ],
