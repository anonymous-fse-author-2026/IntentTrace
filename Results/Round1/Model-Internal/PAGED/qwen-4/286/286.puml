@startuml
!theme plain
|a_default| Default
|a_default|
start
:start review process;
:review received application;
:load case data;
:review case;
:are there any new findings;
:v1: are there any new findings ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:recalculate the refund;
else ([v1 = 'No'])
:send letter of denial;
endif
:are there any new findings again;
:v2: are there any new findings again ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:recalculate the refund;
else ([v2 = 'No'])
:send another letter of denial;
endif
:write back the case data;
:end;
stop
@enduml