  "input_elements": [
    {
      "id": "i1",
      "content": "At the start, we receive a form."
    },
    {
      "id": "i2",
      "content": "After receiving the form, we check if it is complete."
    },
    {
      "id": "i3",
      "content": "If it needs to be sent back, the process ends."
    },
    {
      "id": "i4",
      "content": "However, if we need to check the income, we continue with the process."
    },
    {
      "id": "i5",
      "content": "At the same time, we complete the following steps: checking deductibles and checking the house."
    },
    {
      "id": "i6",
      "content": "Then, we make a decision."
    },
    {
      "id": "i7",
      "content": "If we need to check the declaration, the process ends."
    },
    {
      "id": "i8",
      "content": "Otherwise, if we need to invite the declarant, the process also ends."
    }
