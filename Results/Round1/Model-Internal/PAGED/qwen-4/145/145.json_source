  "input_elements": [
    {
      "id": "i1",
      "content": "To start, go to the Amazon homepage."
    },
    {
      "id": "i2",
      "content": "After that, search for a book."
    },
    {
      "id": "i3",
      "content": "Once you've found the book, click on the link that says \"22 used\" to see the used books available."
    },
    {
      "id": "i4",
      "content": "From there, click on the \"Add to Cart\" button for the second book on the list."
    },
    {
      "id": "i5",
      "content": "After adding it to your cart, click on the \"Proceed to Checkout\" button."
    },
    {
      "id": "i6",
      "content": "On the checkout page, enter your email address and select the option that says \"I am a new customer\"."
    },
    {
      "id": "i7",
      "content": "Next, click on the \"Sign in using our secure server\" button."
    },
    {
      "id": "i8",
      "content": "Once you've signed in, enter your customer details and click on the \"Create account\" button."
    },
    {
      "id": "i9",
      "content": "After creating your account, enter your shipping details and click on the \"Continue\" button."
    },
    {
      "id": "i10",
      "content": "On the next page, select your preferred shipping options and click on \"Continue\" again."
    },
    {
      "id": "i11",
      "content": "Then, choose your payment method and enter your credit card details."
    },
    {
      "id": "i12",
      "content": "Click on the \"Add your card\" button to save your card information."
    },
    {
      "id": "i13",
      "content": "After that, click on \"Continue\" to proceed."
    },
    {
      "id": "i14",
      "content": "Next, choose your billing address and select the option to use the address you've chosen."
    },
    {
      "id": "i15",
      "content": "Finally, click on \"Place your order in AUD\" to complete the process."
    }
  ]
}