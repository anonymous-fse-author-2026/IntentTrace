{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME Company, we first trigger the Resupply Cycle."
      ],
      "justification": "Init marks the process start; action faithfully restates the initial trigger step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, we check the inventory level."
      ],
      "justification": "Direct correspondence to the inventory verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once the inventory level is checked, we proceed to create a purchase order."
      ],
      "justification": "Action accurately captures the purchase order creation step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "we reject it"
      ],
      "justification": "XOR branch models the decision point; action matches the rejection step described in the negative arm."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "we approve it"
      ],
      "justification": "Action directly corresponds to the approval step in the positive arm."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "In case the purchase order is rejected, we rework it."
      ],
      "justification": "Action faithfully captures the rework instruction."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "if the purchase order is approved, we reserve funds for the purchase."
      ],
      "justification": "Action matches the fund reservation step tied to approval."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, we review it again."
      ],
      "justification": "Convergence is implied by the rework loop closing; action matches the subsequent review step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, we send the purchase order to the supplier."
      ],
      "justification": "Action directly corresponds to the supplier dispatch step."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, we complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "AND branch correctly models simultaneity; both actions faithfully capture the two parallel receipt steps."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After receiving the packing slip, we record it."
      ],
      "justification": "Action matches the packing slip recording step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Similarly, after receiving the invoice, we record it as well."
      ],
      "justification": "Convergence implied by parallel track completion; action matches the invoice recording step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Next, we release funds for payment and issue the payment."
      ],
      "justification": "Both actions faithfully decompose and implement the combined fund release and payment issuance instruction."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "release funds for payment and issue the payment."
      ],
      "justification": "Both actions faithfully decompose and implement the combined fund release and payment issuance instruction."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued."
      ],
      "justification": "Action and structural end node both capture the explicit process termination condition."
    }
