  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "The loan application process starts with receiving the loan application."
      ],
      "justification": "i1 implicitly triggers the process start (init:i1) and explicitly describes the receiving step. action:n1 and action:n2 split this opening clause into its structural and operational components, faithfully preserving the meaning."
    },
    {
      "refs": [
        "action:n3",
        "label:b2->n3",
        "action:n4",
        "label:b2->n4"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps should be completed: assessing the loan risk and checking the credit history."
      ],
      "justification": "The concurrency marker 'Simultaneously' justifies the AND gateway (b2). The two concurrent tasks and their connection labels directly correspond to the actions and labels in the model."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, the eligibility of the applicant is assessed."
      ],
      "justification": "i3 describes the eligibility evaluation, which structurally introduces the exclusive decision point (b1) and is modeled as the assessment action (n5)."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the applicant is eligible, the acceptance pack is prepared."
      ],
      "justification": "The conditional 'eligible' maps to the positive guard, and the consequent preparation step maps directly to action n6."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the applicant is not eligible, the application is rejected."
      ],
      "justification": "The negative condition maps to the 'No' guard, and the rejection action maps directly to action n8."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the application is rejected, the loan application process ends."
      ],
      "justification": "i6 describes the termination path following rejection, mapping to the terminal action n10 and the structural end node e2."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The prepared acceptance pack is then sent."
      ],
      "justification": "Direct correspondence to the sending step following preparation."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the acceptance pack is sent, the process ends."
      ],
      "justification": "i8 describes the completion condition following the send step, mapping to the terminal action n9 and the structural end node e1."
    }
  ],
