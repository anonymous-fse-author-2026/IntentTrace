{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "For Talent Seek:"
      ],
      "justification": "Process title implicitly signals the start node."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Action models the initial check step, branch captures the implicit XOR decision point."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Guard represents the affirmative condition, action models the discussion step."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Negative guard and convergence node model the fallback path and flow rejoin."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Action models the second check, branch captures the XOR split, converge handles the structural rejoin."
    },
    {
      "refs": [
        "guard:b2->n5",
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Guards model the implicit Yes/No routing outcomes of the modification check."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "continue to check if the change is within the set client limits."
      ],
      "justification": "Action faithfully restates the third verification step."
    },
    {
      "refs": [
        "guard:b3->n6"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "Guard accurately captures the negative limit condition."
    },
    {
      "refs": [
        "guard:b3->n7"
      ],
      "verbatim_texts": [
        "If it is within the limits"
      ],
      "justification": "Guard captures the affirmative limit condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Action precisely matches the combined relay and continuation instruction."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Exact textual match."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Exact textual match."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Exact textual match."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Exact textual match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Exact textual match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Action models the acceptability check, branch captures the XOR decision."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If they are, continue with the process."
      ],
      "justification": "Guard and action model the affirmative continuation path."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If not, select a new applicant from the list."
      ],
      "justification": "Guard and action model the negative selection path."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Action models the client acceptance check, branch captures the XOR decision."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Guard, terminal action, and end node collectively implement the process termination."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Guard and action model the alternative candidate selection."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Correctly duplicates the client acceptance check as repeated in the source."
    },
    {
      "refs": [
        "guard:b6->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Correctly duplicates the termination path as repeated in the source."
    },
    {
      "refs": [
        "guard:b6->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Correctly duplicates the alternative selection path as repeated in the source."
    }
  ],
