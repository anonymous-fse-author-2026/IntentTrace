{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "For MyCorp, the process begins"
      ],
      "justification": "Explicitly signals the start of the workflow."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "by entering expenses"
      ],
      "justification": "Direct correspondence to the initial data entry step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After entering expenses, the next step is to generate a spreadsheet."
      ],
      "justification": "Exact match for the spreadsheet generation action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the spreadsheet is generated, the request can be approved or disapproved."
      ],
      "justification": "Introduces the approval decision point; the action faithfully restates the check as permitted by modeling rules."
    },
    {
      "refs": [
        "guard:b1->c1",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the request is not approved, the process goes back to entering expenses."
      ],
      "justification": "Covers the negative branch condition, the loop-back action, and the implicit join/rejoin point."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the request is approved, the expenses can be paid out."
      ],
      "justification": "Covers the positive branch condition and the corresponding payout action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Second approval verification step and associated decision gateway."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is not approved, the process goes back to entering expenses."
      ],
      "justification": "Covers the second negative condition, loop-back action, and merge point."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if it is approved, the expenses can be paid out."
      ],
      "justification": "Covers the second positive condition and payout action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Finally, after the expenses are paid out, the process comes to an end."
      ],
      "justification": "Closing clause justifies both the termination action and the structural end node."
    }
  ],
