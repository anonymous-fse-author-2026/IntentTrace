{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial receiving action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After receiving the invoice, it is sorted per client."
      ],
      "justification": "Directly corresponds to the sorting step per client."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once sorted per client, it is then sorted per vendor."
      ],
      "justification": "Directly corresponds to the subsequent sorting step per vendor."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "The next step is to attach the invoice entry form to the invoice."
      ],
      "justification": "Faithfully captures the form attachment step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After attaching the form, the required information is entered onto the form."
      ],
      "justification": "Exact match for entering information onto the form."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Following that, the completeness of the invoice is checked."
      ],
      "justification": "The check action leads directly into the XOR branch for the completeness decision."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "The guard captures the negative condition, the action states the outcome, and the end node marks termination."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered."
      ],
      "justification": "The guard captures the positive condition, n7 acknowledges it, and n9 performs the SLA entry."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "The date for completion is also entered and the priority is checked."
      ],
      "justification": "Covers both the date entry and the priority check that triggers the next branch."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "Accurately models the high-priority condition and the stamping action."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Correctly captures the low-priority condition and continuation."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Matches the compliance check action and the subsequent decision point."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If it is not complete, the check continues."
      ],
      "justification": "Aligns with the incomplete compliance condition leading to continuation."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is complete, the process continues."
      ],
      "justification": "Matches the complete compliance condition and continuation."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n19",
        "action:n20",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Comprehensively covers the staff-sending condition check, state acknowledgment, and processing action."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21",
        "action:n23"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Faithfully models the normal case condition and the client call action."
    },
    {
      "refs": [
        "guard:b6->n25",
        "action:n24",
        "action:n25",
        "action:n18"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Captures the fallback condition, the mailing action, and the process termination. Includes redundant n18 as permitted."
    },
    {
      "refs": [
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Directly matches the final client contact and information request step."
    },
    {
      "refs": [
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO, and the process ends."
      ],
      "justification": "Accurately reflects the batching/allocation action, the explicit end step, and the terminal node."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b4->n18",
        "guard:b4->n19"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "reason": "Introduces an artificial XOR branch and guards using invented variables (v4=\"mail\", v4=\"continue\") that distort the original logical fallback into unsupported conditional routing."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If it is not complete, the check continues."
      ],
      "reason": "Appends '- or act' to the step content, introducing behavior not described in the source text."
    }
  ],
  "omissions": [],
  "additions": [],
