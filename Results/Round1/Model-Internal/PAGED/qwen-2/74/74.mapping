      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "Initiates the process and captures the starting and metadata entry actions described in the opening clause."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to the IN-Patient step. At the same time, complete the following steps:"
      ],
      "justification": "Captures the IN-Patient step action and implies parallel execution via the AND branch for the simultaneous steps."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "send data to suppliers and create a claim."
      ],
      "justification": "Directly maps to the two concurrent/successive actions listed in the parallel block."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "extract the data from the suppliers and transfer it to the doctor's phone."
      ],
      "justification": "Faithfully reproduces the extraction and transfer step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "confirm the GOP"
      ],
      "justification": "Exact match for the confirmation step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the process will come to an end."
      ],
      "justification": "Maps the termination action and corresponding end node to the explicit ending statement."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Next, register the case and handle the claim."
      ],
      "justification": "Covers both the registration and claim handling steps sequentially."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status."
      ],
      "justification": "Maps the extraction action, the subsequent exclusive choice (XOR branch) between recording or confirming, and the corresponding action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Enter the data on the patient's record or confirm the IN-Patient status, and then send the data back to the suppliers."
      ],
      "justification": "Corresponds to the data return step following the conditional choices."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, receive the payment and conclude the process."
      ],
      "justification": "Captures the final payment reception, process conclusion action, and terminal end node."
    }
