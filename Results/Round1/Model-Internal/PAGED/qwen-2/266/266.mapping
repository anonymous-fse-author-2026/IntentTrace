      ],
      "verbatim_texts": [
        "The process starts with an informational meeting that lasts half a day, involving the customer and the web design team."
      ],
      "justification": "Implicitly marks the initiation of the process described in the opening clause."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If the meeting is successful, the next step is to work on the storyboard",
        "However, if the meeting is not successful, the process ends."
      ],
      "justification": "Captures the XOR decision on meeting success, both conditional outcomes, the subsequent storyboard action, and the terminal end for the failure path."
    },
