    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "Models the parallel execution of site design and content preparation using an AND gateway and correctly merges them via a converge node."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the site is built, it goes through a review process that lasts 1 day."
      ],
      "justification": "Corresponds to the completion of construction/development and the immediately following review step."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the review is successful, it moves on to the approval stage, which takes half a day."
      ],
      "justification": "Accurately models the positive-path condition and transitions to the approval action."
    },
    {
      "refs": [
        "guard:b3->n11",
        "guard:b3->n12",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the approval is complete, the process ends. However, if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
      ],
      "justification": "Faithfully represents both approval outcomes, the terminal end for completion, and the rebuild action for rejection."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the rebuild is complete, the process ends."
      ],
      "justification": "Maps the final termination state and the secondary rebuild iteration to their respective source units."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Maps the final termination state and the secondary rebuild iteration to their respective source units."
    }
