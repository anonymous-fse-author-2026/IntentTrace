@startuml
!theme plain
|a_default| Default
|a_default|
start
:receive the invoice;
:check for mismatches;
:does the invoice need to be re-sent  posted  or blocked?;
:v1: does the invoice need to be re-sent  posted  or blocked? ({re-send the invoice, post the invoice, block the invoice}); <<objectSignal>>
switch ()
case ([v1 = "re-send the invoice"])
:re-send the invoice;
case ([v1 = "post the invoice"])
:post the invoice;
case ([v1 = "block the invoice"])
:block the invoice;
endswitch
:park the invoice;
:You have completed this procedure;
stop
