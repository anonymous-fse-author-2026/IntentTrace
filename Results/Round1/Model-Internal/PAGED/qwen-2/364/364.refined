end(e3)
converge(c1)
defines(v1, "check if form is complete", {"send back", "check income", "check deductibles", "check house"})
defines(v2, "make decision", {"check declaration", "invite declarant"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, e1, n5, n6, n7, n8, b2, n9, e2, n10, e3, c1])
precedence(i1, n1)
precedence(n3, b1)
precedence(n4, e1)
precedence(n8, b2)
precedence(n9, e2)
precedence(n10, e3)
precedence(c1, n8)
precedence(n1, n2)
