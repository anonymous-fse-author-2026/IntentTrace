{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially, if the option \"research schedule directly\" is selected, then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Covers process initiation, condition evaluation node, positive branch guard, and the corresponding research action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Maps the negative branch guard, indication action, subsequent research step, and implicit path convergence."
    },
    {
      "refs": [
        "action:n6",
        "action:n7",
        "guard:b2->n9",
        "action:n9",
        "guard:b2->c2",
        "action:n8"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory. If it is not, then perform the action \"Research schedule\". If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Captures schedule validation, satisfaction check branch, negative path action, positive path guard, convergence, and ticket writing action."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11",
        "action:n12",
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\". If it is still not satisfactory, then \"provide indications\". Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Models the secondary satisfaction check, indication provision on failure with branch termination, and the alternative satisfactory path merging forward."
    },
    {
      "refs": [
        "action:n13",
        "action:n14",
        "guard:b4->n15",
        "action:n15",
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it. Check if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
      ],
      "justification": "Faithfully represents ticket validation, approval check branch, termination on rejection, and re-validation step on approval."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->n18",
        "action:n18",
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
      ],
      "justification": "Matches the repeated approval check, end on rejection, and validation action on approval."
    },
    {
      "refs": [
        "action:n20",
        "guard:b6->n21",
        "action:n21",
        "guard:b6->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved. If it is, then the process ends. If it is not, then the process ends."
      ],
      "justification": "Captures final approval verification and branching to terminal nodes on either outcome, consistent with source logic."
    }
  ],
