  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process for a Casual Admin Assistant, start by commencing the reference check and then proceed to check the applicants' referees."
    },
    {
      "id": "i2",
      "content": "If an \"Incomplete Referee Report\" is received, the process ends due to the report not being finished on time."
    },
    {
      "id": "i3",
      "content": "if a \"Complete Referee Report\" is obtained, send it to archive applications"
    },
    {
      "id": "i4",
      "content": "proceed to evaluate and rank the candidates"
    },
    {
      "id": "i5",
      "content": "and then the process concludes"
    },
    {
      "id": "i6",
      "content": "If an \"Incomplete Referee Report\" is received... However, if a \"Complete Referee Report\" is obtained"
    }
  ]
