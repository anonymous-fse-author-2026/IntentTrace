      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Captures the process initiation and the explicit order placement step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to Check the Customer's Credit Limit."
      ],
      "justification": "Direct implementation of the credit limit verification step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article.",
        "However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Models the XOR decision point triggered by the credit limit response."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Faithfully restates the negative branch condition and its corresponding action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "Implements the subsequent article availability verification."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "However, if the Article is available, proceed to Collect the Goods.",
        "if the Article is available",
        "If the response is \"No\"... If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Models the XOR decision point regarding article availability."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the response is \"No\"... If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Direct implementation of the goods production step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the Article is available, proceed to Collect the Goods.",
        "if the Article is available"
      ],
      "justification": "Direct implementation of the goods collection step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "The converge node handles the implicit path rejoinder, immediately followed by the confirmation action."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "Correctly models the AND-split gateway and both concurrent downstream tasks."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "Implicitly joins the parallel shipping and invoicing flows before the next stage."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Exact match for the payment status verification step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process.",
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Models the XOR decision point based on payment receipt."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "Implements the order closure step upon successful payment."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "Redundantly but correctly models the process termination instruction."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3.",
