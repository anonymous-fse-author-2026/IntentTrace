      ],
      "justification": "Faithfully restates the concurrent evaluation step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "guard:b1->n5",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the answer is \"no\", then proceed to book a train. However, if the answer is \"yes\", then book a flight."
      ],
      "justification": "Accurately captures the exclusive split, both guard values, and the resulting booking actions without alteration."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "the process will end"
      ],
      "justification": "Structural endpoint correctly aligned with the explicit termination statement."
    },
    {
