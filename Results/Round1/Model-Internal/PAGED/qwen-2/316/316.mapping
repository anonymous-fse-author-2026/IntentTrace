{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "The init node implicitly marks the process start; action n1 faithfully restates the initial registration step."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "Branch b1 and action n2 model the decision point; guard and action n3 implement the positive 'needed' path and the request step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "label:n4->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if an exception is not needed, the process can continue."
      ],
      "justification": "Guard and action capture the 'not needed' condition and continuation; the label explicitly carries the 'continue' directive."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After the exception is approved"
      ],
      "justification": "Action n5 and branch b2 model the approval condition; the guard directs flow forward upon approval."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "After the exception is approved, the next step is course enrollment, followed by seminar group enrollment."
      ],
      "justification": "Action n5 and branch b2 model the approval condition; the guard directs flow forward upon approval."
    },
    {
      "refs": [
        "action:n6",
        "action:n8"
      ],
      "verbatim_texts": [
        "After the exception is approved, the next step is course enrollment, followed by seminar group enrollment."
      ],
      "justification": "Actions n6 and n8 execute the enrollment steps; converge c1 structurally rejoins the parallel paths before these steps."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the seminar group enrollment is completed, the homework assignment can be started."
      ],
      "justification": "Action directly matches the initiation of the homework assignment phase."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After working on the homework, it should be turned in."
      ],
      "justification": "Action captures the core submission step described in the source."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated, and the process can continue."
      ],
      "justification": "Action faithfully restates the homework evaluation step."
    },
    {
      "refs": [
        "action:n12",
        "guard:b3->n13",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Condition is modeled as action/branch/guard; actions n13 and n14 implement the reassignment loop. Redundant start action is permitted."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "However, if it was the last homework, the process can continue."
      ],
      "justification": "Guard and action capture the terminal homework condition and downstream continuation."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "AND branch splits concurrent tasks; actions perform them; converge merges them. Action n18 is a redundant merge node, which is acceptable."
    },
    {
      "refs": [
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "After signing up for the exam, it should be attended."
      ],
      "justification": "Two sequential actions accurately split the signup and attendance steps."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the exam is attended, it will be evaluated."
      ],
      "justification": "Action directly matches the exam evaluation step."
    },
    {
      "refs": [
        "action:n22",
        "guard:b4->n23",
        "action:n23",
        "action:n26"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue."
      ],
      "justification": "Condition/branch/guard handle the pass check; action n23 confirms course status; n26 and e1 terminate the successful path as implied by completion."
    },
    {
      "refs": [
        "guard:b4->n24",
        "action:n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Guard and action n24 handle the fail/retry directive; action n25 implements the implicit loop back to the exam stage."
    }
  ],
