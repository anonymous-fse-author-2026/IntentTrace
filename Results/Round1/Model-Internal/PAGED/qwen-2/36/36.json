  "input_elements": [
    {
      "id": "i1",
      "content": "For Talent Seek:"
    },
    {
      "id": "i2",
      "content": "Initially, you should check if the applicant wishes to discuss the terms and conditions."
    },
    {
      "id": "i3",
      "content": "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
    },
    {
      "id": "i4",
      "content": "Next, check if the applicant wants to modify the terms and conditions."
    },
    {
      "id": "i5",
      "content": "then continue to check if the change is within the set client limits."
    },
    {
      "id": "i6",
      "content": "If it is not, relay the applicant's changes."
    },
    {
      "id": "i7",
      "content": "If it is within the limits, continue with the process."
    },
    {
      "id": "i8",
      "content": "Seek approval for the offer and continue with the process."
    },
    {
      "id": "i9",
      "content": "Modify the terms and conditions accordingly."
    },
    {
      "id": "i10",
      "content": "Send the appointment approval and mandatory documentation to HR Services."
    },
    {
      "id": "i11",
      "content": "Scan and upload the completed approval form to Cloud Source."
    },
    {
      "id": "i12",
      "content": "Make a formal offer."
    },
    {
      "id": "i13",
      "content": "Check if the changes are acceptable."
    },
    {
      "id": "i14",
      "content": "If they are, continue with the process."
    },
    {
      "id": "i15",
      "content": "If not, select a new applicant from the list."
    },
    {
      "id": "i16",
      "content": "Check if the client accepts the changes."
    },
    {
      "id": "i17",
      "content": "If they do, the process ends."
    },
    {
      "id": "i18",
      "content": "Otherwise, select a new candidate from the list."
    }
  ]
}