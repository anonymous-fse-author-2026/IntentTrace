      "refs": [
        "action:n4",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum,"
      ],
      "justification": "The branch node models the decision point, action n4 captures the conditional check as an operational step, and guard b1->n7 represents the affirmative path triggered by this condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report."
      ],
      "justification": "Exact reproduction of the required output action for the low-inventory branch."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report."
      ],
      "justification": "Action n5 accurately states the alternative report generation, supported by guard b1->n5 modeling the negative conditional path."
    }
