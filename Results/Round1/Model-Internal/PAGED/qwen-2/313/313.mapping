{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "init:i1 structurally marks process commencement; action:n1 redundantly captures the 'To start' lead-in; action:n2 faithfully restates the registration step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no fee"
      ],
      "justification": "action:n3 and branch:b1 model the decision point; guard:b1->n4 explicitly encodes the 'No fee' condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to register a post-seminar request"
      ],
      "justification": "Direct one-to-one correspondence with the specified action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if there is a fee, you need to create a purchase request"
      ],
      "justification": "guard:b1->n6 captures the positive fee condition; action:n6 exactly matches the purchase request creation step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "action:n5 explicitly denotes termination; end:e1 provides the structural closing node."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved"
      ],
      "justification": "action:n7 models the verification step; branch:b2 handles the subsequent exclusive split."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification"
      ],
      "justification": "guard:b2->n8 encodes the approval condition; action:n8 faithfully restates the notification step."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection"
      ],
      "justification": "guard:b2->n11 encodes the rejection condition; action:n11 faithfully restates the rejection notification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "you should then register a post-seminar request"
      ],
      "justification": "Exact match to the conditional follow-up action."
    },
    {
      "refs": [
        "action:n10",
        "action:n12"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Redundant pairing of end actions and structural end nodes collectively implement the final termination clause without altering behavior."
    }
  ],
