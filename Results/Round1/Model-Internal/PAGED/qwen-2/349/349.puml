@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start computer repair process;
:Examine the hardware;
:Identify hardware issues;
:v1: Identify hardware issues ({Yes, No}); <<objectSignal>>
if () then ([v1 = "Yes"])
:Repair identified hardware issues;
:Conclude hardware inspection after repair;
else ([v1 = "No"])
:No hardware issues found;
:Conclude hardware inspection without repair;
endif
:Test system functionality;
:Are system tests successful;
:v2: Are system tests successful ({Yes, No}); <<objectSignal>>
if () then ([v2 = "Yes"])
:Conclude hardware inspection - process complete;
stop
else ([v2 = "No"])
:Repair further hardware issues;
:Conclude hardware inspection after additional repair;
stop
endif
@enduml