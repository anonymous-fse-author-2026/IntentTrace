      ],
      "verbatim_texts": [
        "For Talent Seek:"
      ],
      "justification": "Contextual opening phrase implicitly establishes the process initiation point."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check the Referee Reports"
      ],
      "justification": "Direct restatement of the initial verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "monitor if the Referee Reports have been completed"
      ],
      "justification": "Models the monitoring/checking state as a decision-prefacing action."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If they have been completed"
      ],
      "justification": "Explicit conditional triggers the XOR split."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If they have"
      ],
      "justification": "Positive branch condition aligns with source phrasing."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "you can proceed with the process"
      ],
      "justification": "Exact match for the positive arm continuation."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if they have not been completed"
      ],
      "justification": "Negative branch condition matches source."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "flag it and send a reminder"
      ],
      "justification": "Direct paraphrase of the remediation step."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "check again if the Referee Reports have been completed"
      ],
      "justification": "Supports the re-check action, its redundant confirmation step, and the subsequent split."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If they have"
      ],
      "justification": "Second positive condition matches source repeat."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "continue with the process"
      ],
      "justification": "Direct match for successful re-check outcome."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Second negative condition matches source."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "flag it again and send another reminder"
      ],
      "justification": "Direct match for escalated remediation."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Once the Referee Reports have been completed, you can move on to organizing interviews for the Selection Panel with the top candidates."
      ],
      "justification": "Temporal phrase signals path rejoining before the next phase."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive feedback from the interview candidates"
      ],
      "justification": "Exact instruction preserved."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "check if a Psychometric Test is required"
      ],
      "justification": "Supports both the checking action and the resulting decision node."
    },
    {
      "refs": [
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If it is"
      ],
      "justification": "Positive condition for test requirement."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "check if an HR Specialist is required"
      ],
      "justification": "Supports the nested check action and its gateway."
    },
    {
      "refs": [
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required"
      ],
      "justification": "Exact conditional phrasing preserved."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "schedule the test with a third party"
      ],
      "justification": "Direct instruction match."
    },
    {
      "refs": [
        "guard:b5->n18"
      ],
      "verbatim_texts": [
        "Otherwise"
      ],
      "justification": "Fallback condition matches source."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Otherwise, you can proceed to complete the Psychometric Test."
