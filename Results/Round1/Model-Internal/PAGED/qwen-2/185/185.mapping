{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "The opening clause implicitly starts the process (init) and directly describes the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "it is sorted per client."
      ],
      "justification": "Direct paraphrase preserving the sorting target and dimension."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor."
      ],
      "justification": "Direct paraphrase preserving the second sorting dimension and sequential ordering."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice."
      ],
      "justification": "Exact reproduction of the attachment instruction."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form."
      ],
      "justification": "Exact reproduction of the data entry instruction."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked."
      ],
      "justification": "Exact reproduction of the completeness verification step."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered."
      ],
      "justification": "The branch and positive guard capture the complete-condition logic, while the actions faithfully execute the stated SLA entry."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "The branch and negative guard capture the incomplete-condition logic, routing to the termination action and end node."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "The date for completion is also entered and the priority is checked."
      ],
      "justification": "Two distinct actions faithfully split the conjunction into its two component steps."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "Branch/guard capture the high-priority condition; action executes the exact stamping instruction."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Guard and action label capture the low-priority continuation path."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Exact reproduction of the compliance verification step."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is complete, the process continues."
      ],
      "justification": "Positive compliance path correctly models the continuation logic."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Branch/guard capture the referral condition; action executes the stated processing step."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21",
        "action:n23"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Default branch path correctly captures the normal-case classification and subsequent client call."
    },
    {
      "refs": [
        "action:n18",
        "action:n25"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Actions and end nodes faithfully implement the mail-sending and termination steps. Structural branches handle the routing. The redundant duplicate (n25/e3/b6) is permissible per redundancy rules."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Direct paraphrase preserving both calling and information-requesting instructions."
    },
    {
      "refs": [
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO, and the process ends."
      ],
      "justification": "Actions and end node precisely match the batching, allocation, and termination instructions."
    }
  ],
