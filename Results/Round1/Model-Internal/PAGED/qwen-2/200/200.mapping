{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "init:i1 captures the process start signal; action:n2 faithfully reproduces checking the customer."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "branch:b1 models the XOR decision; guard captures the negative eligibility condition; action:n3 matches informing the customer."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Guard models the positive eligibility branch; action:n5 matches opening the order."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "action:n4 captures the termination instruction following the ineligible path; end:e1 marks the structural finish."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "Open a new order in the ERP system and perform an availability check."
      ],
      "justification": "action:n5 restates opening the order; action:n6 faithfully reproduces performing the availability check."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\"."
      ],
      "justification": "branch:b2 represents the decision point; guard:b2->n9 models the positive outcome path implied by the check."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "Guard models the unavailable condition; action:n7 matches starting production."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Both action nodes faithfully reproduce the preparation step; redundancy is permitted and behaviorally neutral."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "ship the products and send the invoice while checking for payment"
      ],
      "justification": "AND branches and converges model the simultaneous execution; actions n10-n13 faithfully split and reproduce shipping, invoicing, and payment checking."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Branch models the payment decision; guard captures the received condition; action:n14 matches closing the order."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Guard captures the non-receipt condition; action:n15 matches sending the reminder."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "ending the process"
      ],
      "justification": "Structural end node aligns with the explicit closure phrase."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->c5",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Action n16 and branch b4 model the reminder count check; guard captures the threshold; action:n17 matches continuing; converge:c5 handles path rejoining."
    },
    {
      "refs": [
        "guard:b4->c6",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Guard captures the threshold equality; action:n18 matches informing the lawyer; end:e3 and converge:c6 handle the final termination and path merge."
    }
  ],
