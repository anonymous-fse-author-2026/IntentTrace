{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "Captures process initiation and the first two sequential steps. Action n1 abstracts the opening directive."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Branch and guard correctly model the negative eligibility condition, leading to the notification action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Positive eligibility path correctly guarded and executed via ERP order creation."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Explicit termination step following the notification branch."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "Open a new order in the ERP system and perform an availability check."
      ],
      "justification": "Continues from the eligible path with ERP order opening (reused ref) followed by the availability check."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\". If it is not, start producing the missing parts."
      ],
      "justification": "Availability decision point with negative guard correctly routing to production start."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process. Prepare the products for shipment."
      ],
      "justification": "Positive availability guard routes to shipment preparation. n8 and n9 are redundant duplicates, both faithfully representing the source step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "Parallel AND branches model 'simultaneously', followed by shipping, invoicing, and payment check actions."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Payment receipt condition modeled as an action step branching to a true guard and order closure action. Node type difference is permissible per rules."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "Otherwise, if the payment is not received, send a reminder and close the order, ending the process."
      ],
      "justification": "False payment guard routes to reminder action and process end. Covers the non-received payment path."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->c5"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Reminder threshold check modeled as action/branch combo with true guard for continuation loop."
    },
    {
      "refs": [
        "guard:b4->c6",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Threshold met (false guard) routes to lawyer notification and final process termination."
    }
  ],
