{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "Structural start and the second concrete action align directly with the opening clause."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "Direct mapping of the first verification step and its decision gateway."
    },
    {
      "refs": [
        "action:n5",
        "action:n8",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if not, continue the process."
      ],
      "justification": "Captures the negative condition and the continuation instruction, with redundant continuation step accepted."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Matches the positive condition leading to process termination."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7",
        "guard:b2->n8",
        "action:n7"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again"
      ],
      "justification": "Models the repeated check and its implicit branching outcomes."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Direct mapping of the completeness verification and decision point."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Accurately captures the complete path action and its triggering condition."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Correctly models the incomplete path action and condition."
    },
    {
      "refs": [
        "label:n11->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Label captures the temporal link, and the action faithfully restates the data completion step."
    },
    {
      "refs": [
        "action:n14",
        "action:n15",
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Models the approval condition and the associated stamping and dating steps."
    },
    {
      "refs": [
        "action:n23",
        "action:n24",
        "guard:b4->n23",
        "action:n25",
        "guard:b6->n24",
        "guard:b6->e4"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Models the rejection condition, notification action, and implicit termination path."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Faithfully restates the data recording step following the stamping action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee"
      ],
      "justification": "Action and AND gateway correctly model the concurrent fee calculation requirement."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "hand the letter to Charles.",
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Combined action faithfully preserves both sequential instructions without loss of meaning."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Exact paraphrase of the printing and dispatch step."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Direct mapping of the primary termination statement."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "add the new member to the register."
      ],
      "justification": "Exact match for the registration update step."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Prepare an invoice for the new members"
      ],
      "justification": "Exact match for the final invoicing step."
    }
  ],
