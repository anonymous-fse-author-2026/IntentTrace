{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, go to the Amazon homepage."
      ],
      "justification": "The opening phrase implicitly triggers the process start (init) and explicitly describes the first navigation action (n1). Minor article drop ('the') preserves full instructional meaning."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, search for a book."
      ],
      "justification": "Direct alignment with the search step. Temporal lead-in omitted per announcer rules, leaving exact action payload."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once you've found the book, click on the link that says \"22 used\" to see the used books available."
      ],
      "justification": "Faithful reproduction of the target link identifier ('22 used') and purpose ('view available used books'). Granularity and core data preserved."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "From there, click on the \"Add to Cart\" button for the second book on the list."
      ],
      "justification": "Exact match for the button label and target position ('second book'). Contextual phrase 'on the list' is safely condensed without altering execution logic."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After adding it to your cart, click on the \"Proceed to Checkout\" button."
      ],
      "justification": "Direct correspondence to the checkout transition action. Temporal dependency handled implicitly by sequence."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "On the checkout page, enter your email address and select the option that says \"I am a new customer\"."
      ],
      "justification": "Captures both required inputs (email and new customer selection) with identical granularity."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Next, click on the \"Sign in using our secure server\" button."
      ],
      "justification": "Exact button label replication. Sequential flow maintained."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once you've signed in, enter your customer details and click on the \"Create account\" button."
      ],
      "justification": "Accurately combines the data entry step and the subsequent account creation click as modeled."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After creating your account, enter your shipping details and click on the \"Continue\" button."
      ],
      "justification": "Matches the compound step of entering shipping info and advancing via the continue action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "On the next page, select your preferred shipping options and click on \"Continue\" again."
      ],
      "justification": "Core instruction (select options + continue) faithfully retained. Descriptive adverbs ('preferred', 'again') are safely abstracted without changing behavior."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Then, choose your payment method and enter your credit card details."
      ],
      "justification": "Direct mapping of the two-part payment setup instruction."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Click on the \"Add your card\" button to save your card information."
      ],
      "justification": "Button label exactly matched. Purpose clause omitted as it restates standard system behavior already implied."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After that, click on \"Continue\" to proceed."
      ],
      "justification": "Exact alignment with the progression step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Next, choose your billing address and select the option to use the address you've chosen."
      ],
      "justification": "Both sub-actions (address choice and confirmation selection) are present and semantically identical to the source."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Finally, click on \"Place your order in AUD\" to complete the process."
      ],
      "justification": "n15 captures the final currency-specific order placement. n16 ('End') and e1 structurally mark process termination, directly supported by the closing phrase 'to complete the process'. Redundancy between n16 and e1 is permitted as it alters no behavior."
    }
  ],
