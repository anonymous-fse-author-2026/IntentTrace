init(i1)
action(n1, "Start the invoice processing")
action(n2, "Receive and categorize the invoice")
action(n3, "Instruction: Forward Invoice to Admin Officer or Reject invoice or Return invoice to client for completion or Process Invoice for SAP Entry?")
branch(b1, XOR)
action(n4, "Sort the invoice")
action(n5, "End process")
end(e1)
action(n6, "Receive and categorize the invoice again")
action(n7, "Forward invoice for validation")
action(n8, "Validate the invoice")
action(n9, "End process")
end(e2)
defines(v1, "Instruction: Forward Invoice to Admin Officer or Reject invoice or Return invoice to client for completion or Process Invoice for SAP Entry?", {"Reject invoice", "Return invoice to client for completion", "Process Invoice for SAP Entry"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, e1, n6, n7, n8, n9, e2])
precedence(i1, n1)
precedence(n3, b1)
precedence(n5, e1)
precedence(n9, e2)
precedence(n1, n2)
precedence(n2, n3)
precedence(b1, n4)
precedence(b1, n5)
precedence(b1, n6)
precedence(b1, n7)
precedence(n7, n8)
precedence(n8, n9)
guard(b1, n5, v1 = 'Reject invoice')
guard(b1, n6, v1 = 'Return invoice to client for completion')
guard(b1, n7, v1 = 'Process Invoice for SAP Entry')
guard(b1, n4, v1 = 'Forward Invoice to Admin Officer')
precedence(n4, n5)
precedence(n6, n2)