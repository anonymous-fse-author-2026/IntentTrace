{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "The opening clause explicitly starts the process and describes the prioritization step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information. If the customer exists,"
      ],
      "justification": "Describes checking customer existence, which triggers the XOR decision."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "we move on to checking their payment history."
      ],
      "justification": "Matches the positive outcome of the customer existence check leading to payment history verification."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "On the other hand, if the customer does not exist, we need to verify their customer status."
      ],
      "justification": "Matches the negative outcome of the existence check leading to status verification."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process."
      ],
      "justification": "Captures the condition on payment history and the resulting XOR split."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "we can continue with the process."
      ],
      "justification": "Routes the positive payment history outcome forward."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Identifies the private customer condition and establishes the next XOR split."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "we send them a declining message."
      ],
      "justification": "Directly matches the action taken for private customers."
    },
    {
      "refs": [
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Routes the non-private (wholesaler) case to customer creation."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Faithfully restates the two steps for wholesalers."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process.",
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Captures the product availability condition and the subsequent exclusive split."
    },
    {
      "refs": [
        "action:n12",
        "guard:b4->n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Covers the unavailability branch, the production/decline action, and the explicit process termination."
    },
    {
      "refs": [
        "guard:b4->c2"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Routes the availability case forward."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Directly matches the continuation and confirmation steps."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "The 'simultaneously' keyword justifies the parallel AND splits and subsequent converges, while the actions match the notification targets."
    },
    {
      "refs": [
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Accurately segments the packing, invoicing, and readiness state into three faithful actions."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once the order is closed",
        "we close the order."
      ],
      "justification": "Matches the order closure step mentioned in the flow."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "we deliver the goods and invoice to the customer."
      ],
      "justification": "Direct paraphrase of the delivery action."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Captures the payment receipt condition and the resulting XOR decision."
    },
    {
      "refs": [
        "action:n23",
        "guard:b5->n23"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Matches the positive payment path and the close-order action."
    },
    {
      "refs": [
        "guard:b5->n24"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Routes the outstanding payment case to reminder checking."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Directly matches the reminder quantity check."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Identifies the reminder threshold condition and the exclusive split."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Matches the continuation path for fewer than three reminders."
    },
    {
      "refs": [
        "guard:b6->n26"
      ],
      "verbatim_texts": [
        "we continue with the process."
      ],
      "justification": "Matches the continuation path for fewer than three reminders."
    },
    {
      "refs": [
        "guard:b6->n27"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Routes the high-reminder case to the donning process."
    },
    {
      "refs": [
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Faithfully captures the donning activation and the explicit process termination."
    }
  ],
