  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we receive the contract for the marketing campaign."
      ],
      "justification": "The opening clause implicitly initializes the process and describes the first receipt action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once we have the contract, we take it to the department."
      ],
      "justification": "Direct paraphrase of the transfer step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "In the next step, we input the customer's details into NKE."
      ],
      "justification": "Exact restatement of the data entry step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer's details are missing, we contact the customers. However, if the customer's details are ready, we create a suitable team."
      ],
      "justification": "The conditional sentence establishes the decision point (branch) and is faithfully restated as a checking action (n4)."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the customer's details are missing, we contact the customers."
      ],
      "justification": "The guard encodes the negative condition ('No'/missing) and the action captures the corresponding task."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After contacting the customers, we receive additional customer details."
      ],
      "justification": "Direct restatement of the follow-up reception step."
    },
    {
      "refs": [
        "label:n6->c1"
      ],
      "verbatim_texts": [
        "After contacting the customers, we receive additional customer details."
      ],
      "justification": "The label captures the temporal/state transition described in the sentence."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Then, we create the team and check previous campaigns for reusable material."
      ],
      "justification": "The procedural 'then' indicates that divergent paths rejoin before executing the subsequent joint steps."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Then, we create the team and check previous campaigns for reusable material."
      ],
      "justification": "The compound sentence is correctly split into two sequential action elements."
    },
    {
