{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, for CAB, the first step is to assess the change request."
      ],
      "justification": "The opening clause establishes the process initiation and explicitly defines the first assessment step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the affected systems for any impacts on the business unit"
      ],
      "justification": "Directly corresponds to the system impact verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "determine whether the change request should be approved or not"
      ],
      "justification": "Describes the core decision point that triggers the subsequent approval or non-approval paths."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the change request should be approved in its current state, then it is approved."
      ],
      "justification": "Captures the conditional guard and the immediate approval action for the current state."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the change request should not be approved in its current state, further evaluation is needed to determine if the change will be acceptable with more information provided."
      ],
      "justification": "Maps the negative condition and the required further evaluation step accurately."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the change request is ultimately approved, the change is implemented."
      ],
      "justification": "Corresponds directly to the implementation step following approval."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "if the change is deemed unacceptable, it is rejected."
      ],
      "justification": "Models the rejection decision gateway and the corresponding rejection action."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "a request for more information is made to the Change Coordinator."
      ],
      "justification": "Represents the positive evaluation outcome leading to requesting information from the coordinator."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The request is then followed by an email enquiry to the Change Coordinator."
      ],
      "justification": "Directly matches the step of sending the email enquiry."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the approval register is updated within a timeframe of 3 business days."
      ],
      "justification": "Accurately reflects the register update step with the correct timeframe constraint."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The email enquiry is also forwarded to the Change Requester."
      ],
      "justification": "Faithfully reproduces the forwarding action to the requester."
    },
    {
      "refs": [
        "action:n15",
        "guard:b3->n16",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If there are no further inquiries or issues, the process concludes after 3 business days."
      ],
      "justification": "Captures the inquiry check, the branching logic, the negative outcome, and the concluding step with the correct duration."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "if there are inquiries from the CAB, a response is expected within 1-3 business days."
      ],
      "justification": "Models the inquiry branch condition and the receipt of the response within the specified window."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the response is received from the requester, it is forwarded to the CAB for further evaluation."
      ],
      "justification": "Directly matches forwarding the received response back to the CAB for evaluation."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Based on the response, a final determination is made regarding the approval of the change request."
      ],
      "justification": "Represents the final determination step and the resulting decision gateway."
    }
  ],
