      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "Directly captures the process initiation and the first two sequential actions."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "Branch models the decision point; action faithfully restates the positive outcome."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Action and end node accurately capture the termination path for high inventory."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Exact match for the review step following order creation."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order. However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Branch correctly splits the flow; actions match both approval and rejection outcomes."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it. Reserve the funds and send the order to the supplier."
      ],
      "justification": "Actions correspond to the follow-up steps on both the rework and reserve paths."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "AND gateway and actions correctly model the concurrent receipt tasks."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Direct match for the packing slip recording action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Direct match for the invoice recording action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Action and end node cover the process termination after recording the slip."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Action and end node cover the process termination after recording the invoice."
    }
