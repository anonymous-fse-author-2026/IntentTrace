  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process for the Ground Floor, we start when the invoice arrives."
    },
    {
      "id": "i2",
      "content": "The client is then asked to confirm if payment is possible."
    },
    {
      "id": "i3",
      "content": "If the answer is \"yes\""
    },
    {
      "id": "i4",
      "content": "we add the relevant costs center to the invoice"
    },
    {
      "id": "i5",
      "content": "and the process is complete."
    },
    {
      "id": "i6",
      "content": "However, if the answer is \"no\""
    },
    {
      "id": "i7",
      "content": "we reject the invoice. If the invoice is rejected, we return it to the client"
    },
    {
      "id": "i8",
      "content": "and the process ends."
    }
  ]
