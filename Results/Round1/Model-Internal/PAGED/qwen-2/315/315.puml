@startuml
!theme plain
|a_default| Default
|a_default|
start
:make appointment at hairdresser's;
:go to hairdresser;
:need hair washed?;
:v1: need hair washed? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:wash hair;
else ([v1 = 'No'])
->;
endif
:want hair dyed?;
:v2: want hair dyed? ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:dye hair;
else ([v2 = 'No'])
->;
endif
:need haircut?;
:v3: need haircut? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:cut hair;
else ([v3 = 'No'])
->;
endif
:pay hairdresser;
:end process;
stop
@enduml