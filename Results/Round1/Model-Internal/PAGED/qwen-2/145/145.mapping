{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, go to the Amazon homepage."
      ],
      "justification": "The opening clause implicitly signals process initiation (init) and explicitly describes the first navigational action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, search for a book."
      ],
      "justification": "Directly corresponds to the search step with identical core meaning."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once you've found the book, click on the link that says \"22 used\" to see the used books available."
      ],
      "justification": "Faithfully captures the conditional context and the precise link-click instruction."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "From there, click on the \"Add to Cart\" button for the second book on the list."
      ],
      "justification": "Accurately reflects selecting and adding the specific second book to the cart."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After adding it to your cart, click on the \"Proceed to Checkout\" button."
      ],
      "justification": "Exact match for transitioning to the checkout phase."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "On the checkout page, enter your email address and select the option that says \"I am a new customer\"."
      ],
      "justification": "Preserves both required sub-steps: email entry and new-customer selection."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Next, click on the \"Sign in using our secure server\" button."
      ],
      "justification": "Direct correspondence to the authentication step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once you've signed in, enter your customer details and click on the \"Create account\" button."
      ],
      "justification": "Captures the sequence of entering personal details followed by account creation."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After creating your account, enter your shipping details and click on the \"Continue\" button."
      ],
      "justification": "Matches the shipping information entry and progression action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "On the next page, select your preferred shipping options and click on \"Continue\" again."
      ],
      "justification": "Accurately reflects shipping option selection and subsequent continuation."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Then, choose your payment method and enter your credit card details."
      ],
      "justification": "Directly matches payment method selection and card detail entry."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Click on the \"Add your card\" button to save your card information."
      ],
      "justification": "Exactly captures the card-saving action and its purpose."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After that, click on \"Continue\" to proceed."
      ],
      "justification": "Matches the explicit instruction to advance the flow via the Continue button."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Next, choose your billing address and select the option to use the address you've chosen."
      ],
      "justification": "Faithfully represents billing address selection and confirmation."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, click on \"Place your order in AUD\" to complete the process."
      ],
      "justification": "Action n15 captures the final transaction step; end:e1 correctly marks process termination as explicitly stated in the closing clause."
    }
  ],
