init(i1)
action(n1, "Start loan application process by receiving the loan application")
action(n2, "Assess loan risk")
action(n3, "Check credit history")
action(n4, "All assessments completed")
action(n5, "Assess eligibility of applicant")
action(n6, "Is applicant eligible")
branch(b1, XOR)
action(n7, "Prepare acceptance pack")
action(n8, "Reject application")
action(n9, "Send acceptance pack")
action(n10, "End process after rejection")
end(e1)
action(n11, "End process after acceptance pack sent")
end(e2)
converge(c1)
branch(b2, AND)
defines(v1, "Is applicant eligible", {"eligible", "not eligible"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, n6, b1, n7, n8, n9, n10, e1, n11, e2, c1, b2])
precedence(i1, n1)
precedence(n6, b1)
precedence(n10, e1)
precedence(n11, e2)
precedence(c1, n4)
precedence(n1, b2)
precedence(b2, n2)
precedence(b2, n3)
precedence(n2, c1)
precedence(n3, c1)
precedence(n4, n5)
precedence(n5, n6)
precedence(b1, n7)
precedence(b1, n8)
precedence(n7, n9)
precedence(n8, n10)
precedence(n9, n11)
guard(b1, n7, v1 = "eligible")
guard(b1, n8, v1 = "not eligible")