Addition
- [N1] Added trace (model 2): init(i1) -> action(n1,"enter the Italian restaurant and ask for the menu") -> action(n2,"check the offers") -> branch(b2,AND) -> action(n4,"order a salad") -> converge(c1) -> action(n5,"wait for the red wine and salad to arrive") -> action(n6,"enjoy the salad and wine") -> action(n7,"would you like a dessert") -> branch(b1,XOR) -> action(n8,"order tiramisu") -> action(n10,"wait for tiramisu to be served") -> action(n11,"enjoy the tiramisu") -> converge(c2) -> action(n12,"ask for the bill") -> action(n13,"pay the bill") -> action(n14,"leave the restaurant") -> action(n15,"process complete") -> end(e1)
- [N2] Added trace (model 3): init(i1) -> action(n1,"enter the Italian restaurant and ask for the menu") -> action(n2,"check the offers") -> branch(b2,AND) -> action(n4,"order a salad") -> converge(c1) -> action(n5,"wait for the red wine and salad to arrive") -> action(n6,"enjoy the salad and wine") -> action(n7,"would you like a dessert") -> branch(b1,XOR) -> action(n9,"decline any dessert") -> converge(c2) -> action(n12,"ask for the bill") -> action(n13,"pay the bill") -> action(n14,"leave the restaurant") -> action(n15,"process complete") -> end(e1)
