  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, you should choose your destination and calculate the distance."
      ],
      "justification": "The opening sentence implicitly starts the process and describes the first required action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "continue to check if you need to book a train or a flight."
      ],
      "justification": "The check introduces the decision point modeled as an action and the subsequent XOR branch."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the answer is \"no\", then proceed to book a train."
      ],
      "justification": "Direct mapping of the negative condition and the resulting booking action."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "However, if the answer is \"yes\""
      ],
      "justification": "Captures the positive branch condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours"
      ],
      "justification": "Models the second decision point and its triggering condition."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours, the process will end."
      ],
      "justification": "Correctly captures the positive condition leading to process termination."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "Otherwise, if 24 hours have passed, you should call a travel agency."
      ],
      "justification": "Matches the negative condition and the subsequent phone call action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If a code is available"
      ],
      "justification": "Models the third decision point triggered after contacting the agency."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "the process will end along with the hotel reservation."
      ],
      "justification": "Faithfully restates the positive outcome including the hotel reservation qualifier."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if a code is not available, you should cancel your journey."
      ],
      "justification": "Accurately maps the negative condition and the cancellation action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "In that case, the process will end as well."
      ],
      "justification": "Directly supports the final termination action and structural end node."
    }
  ],
