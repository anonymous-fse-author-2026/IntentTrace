{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To start the process for ACME,"
      ],
      "justification": "Opening clause implicitly defines the process initiation point."
    },
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "begin with the New Resupply Cycle and then proceed to Check Levels of Inventory."
      ],
      "justification": "Sequential steps directly paraphrased from the source instruction."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the inventory is \"greater than\" the minimum,"
      ],
      "justification": "XOR gateway and outgoing guard jointly capture the threshold decision point."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "generate an \"Above Minimum Report\"."
      ],
      "justification": "Exact match for the action triggered by the positive condition."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If it is \"below or equal to\" the minimum,"
      ],
      "justification": "Guard accurately reflects the alternative threshold condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an \"Equal to or below minimum Report\"."
      ],
      "justification": "Exact match for the action triggered by the negative condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process ends with the End Resupply Cycle."
      ],
      "justification": "Action node and terminal event together implement the closing step for this branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then POs are Created."
      ],
      "justification": "Direct active-voice conversion of the passive source instruction."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they are subject to POs Review."
      ],
      "justification": "Faithful restatement of the mandatory review step."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the POs are \"rejected\", they need to be \"reworked\"."
      ],
      "justification": "Gateway, guard, and task collectively model the rejection condition and required rework action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If they are \"approved\", they are \"Printed and released in the system\" and the process ends."
      ],
      "justification": "Guard, sequential actions, and terminal event fully implement the approval outcome and finalization."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the POs are \"reworked\", then POs are Created again."
      ],
      "justification": "Action node implements the recreation step described in the feedback loop."
    }
  ],
