end(e1)
action(n7, "repair: fix identified hardware issues")
defines(v1, "condition: are test results satisfactory?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, b1, n6, e1, n7])
