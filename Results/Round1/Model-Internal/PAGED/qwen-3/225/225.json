  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process for ACME Company, start by receiving the customer request"
    },
    {
      "id": "i2",
      "content": "and then check the current inventory level."
    },
    {
      "id": "i3",
      "content": "If the inventory level is at or below the minimum"
    },
    {
      "id": "i4",
      "content": "accept the customer request."
    },
    {
      "id": "i5",
      "content": "However, if the inventory level is above the minimum, reject the customer request."
    },
    {
      "id": "i6",
      "content": "After accepting the customer request, create a purchase order."
    },
    {
      "id": "i7",
      "content": "If the customer request is rejected, the process ends."
    },
    {
      "id": "i8",
      "content": "the process ends."
    },
    {
      "id": "i9",
      "content": "Once the purchase order is created, review it."
    },
    {
      "id": "i10",
      "content": "If the purchase order is rejected"
    },
    {
      "id": "i11",
      "content": "rework the purchase order."
    },
    {
      "id": "i12",
      "content": "However, if the purchase order is approved, reserve the funds."
    },
    {
      "id": "i13",
      "content": "In case the purchase order needs to be reworked, review it again."
    },
    {
      "id": "i14",
      "content": "After reserving the funds, send the purchase order."
    },
    {
      "id": "i15",
      "content": "Simultaneously, complete the following steps: receive the packing slip and receive the invoice."
    },
    {
      "id": "i16",
      "content": "Upon receiving the packing slip, record it."
    },
    {
      "id": "i17",
      "content": "Similarly, upon receiving the invoice, record it as well."
    },
    {
      "id": "i18",
      "content": "Release the reserved funds and issue the payment."
    },
    {
      "id": "i19",
      "content": "Finally, issue the payment and the process ends."
    }
  ]
