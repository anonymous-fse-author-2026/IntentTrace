init(i1)
action(n1, "Start loan application process")
action(n2, "Is loan application rejected")
branch(b1, XOR)
action(n3, "End process due to rejection")
end(e1)
action(n4, "Are special terms agreed upon")
branch(b2, XOR)
action(n5, "Disburse funds")
action(n6, "End process after disbursal")
end(e2)
action(n7, "End process without disbursal")
end(e3)
defines(v1, "Is loan application rejected", {"Yes", "No"})
defines(v2, "Are special terms agreed upon", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, e1, n4, b2, n5, n6, e2, n7, e3])
precedence(i1, n1)
precedence(n2, b1)
precedence(n3, e1)
precedence(n4, b2)
precedence(n6, e2)
precedence(n7, e3)
precedence(n1, n2)
precedence(b1, n3)
precedence(b1, n4)
precedence(b2, n5)
precedence(n5, n6)
precedence(b2, n7)
guard(b1, n3, v1 = 'Yes')
guard(b1, n4, v1 = 'No')
guard(b2, n5, v2 = 'Yes')
guard(b2, n7, v2 = 'No')