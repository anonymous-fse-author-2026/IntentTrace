{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by claiming what is requested"
      ],
      "justification": "The opening clause implicitly triggers the process (init), contains the explicit first instruction (action:n2), and provides the contextual setup for the generic start node (action:n1)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then check the insured status of the claimant."
      ],
      "justification": "Directly corresponds to the next sequential step checking the claimant's status."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the claimant is insured,"
      ],
      "justification": "The conditional phrase establishes the XOR split point, the positive guard condition, and the decision-check action step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed to evaluate the claim."
      ],
      "justification": "Faithfully captures the action taken on the insured path."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the claimant is not insured,"
      ],
      "justification": "Directly maps to the negative guard condition exiting the branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "reject the claim."
      ],
      "justification": "Exact match for the action following the uninsured condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the claim is rejected, notify the claimant"
      ],
      "justification": "Precisely captures the notification step triggered by rejection."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "and the process comes to an end."
      ],
      "justification": "The termination statement justifies both the explicit end node and the terminal action step describing the closure of this branch."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n10",
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "If the claim is a simple one or a complex one,"
      ],
      "justification": "The disjunctive condition defines the XOR split, the evaluation action, and both resulting guard values (simple/complex)."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "send the relevant forms accordingly."
      ],
      "justification": "The single source instruction is correctly expanded into two parallel path actions matching the branch outcomes."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Once the forms are returned,"
      ],
      "justification": "The temporal transition implies rejoining the parallel/simple-complex paths into a single flow before the next check."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "check them for completeness."
      ],
      "justification": "Direct correspondence to the post-convergence validation step."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided,"
      ],
      "justification": "Establishes the second XOR split, the completeness verification action, and the positive guard condition."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "proceed to register the claim."
      ],
      "justification": "Exact match for the action on the successful completion path."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "However, if not all the relevant details are provided,"
      ],
      "justification": "Directly maps to the negative guard condition indicating incomplete information."
    },
    {
      "refs": [
        "action:n14",
        "label:n14->c1"
      ],
      "verbatim_texts": [
        "inform the claimant to complete them."
      ],
      "justification": "Captures the notification action and the implicit loop-back condition (details completed) that returns flow to the completeness check."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Once the claim is registered, the process comes to an end."
      ],
      "justification": "The final sentence simultaneously justifies the closing action step and the process termination node."
    }
  ],
