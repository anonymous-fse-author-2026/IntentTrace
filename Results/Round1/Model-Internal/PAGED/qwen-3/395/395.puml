:check referee reports status;
:are referee reports completed?;
:v1: are referee reports completed? ({Completed, Not completed}); <<objectSignal>>
if () then ([v1 = 'Not completed'])
:flag and send reminder;
-> Referee Reports still not completed;
:check again if referee reports are completed;
-> Referee Reports still not completed after second check;
:are referee reports completed after reminder?;
:v2: are referee reports completed after reminder? ({Completed, Not completed}); <<objectSignal>>
if () then ([v2 = 'Completed'])
->;
endif
else ([v1 = 'Completed'])
->;
endif
:proceed with process;
:organize interviews for selection panel with top candidates;
:receive feedback from interview candidates;
:is psychometric test required?;
:v3: is psychometric test required? ({Not required, HR Specialist required, Direct}); <<objectSignal>>
switch ()
case ([v3 = 'Not required'])
:coordinate second round of selection;
-> Finalize process;
case ([v3 = 'HR Specialist required'])
:schedule psychometric test with third party;
-> Finalize process;
case ([v3 = 'Direct'])
:complete psychometric test;
-> Finalize process;
endswitch
:request final candidate ranking and continue process;
