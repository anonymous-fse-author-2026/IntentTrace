      ],
      "verbatim_texts": [
        "To begin the process for IT Infrastructure, start with the Loan Application and then proceed to Receive Loan Application."
      ],
      "justification": "The opening sentence establishes the process start and explicitly lists the initial sequence of steps."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is a \"Construct Error Response\", then the process ends with an \"Error Message\"."
      ],
      "justification": "The conditional structure and its terminating outcome are directly captured by the XOR branch, the error action, and the end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Otherwise, if there is a \"Retrieve Customer Information\""
      ],
      "justification": "Direct extraction of the alternative path action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, if there is a \"Calculate threshold amount\", continue with the process."
      ],
      "justification": "Accurately reflects the continuation step after threshold calculation."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If there is a \"Check Creditworthiness\", designate the Status."
      ],
      "justification": "Faithfully reproduces the instruction to check creditworthiness and assign the status."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the Status is designated, initialize the Loan Form."
      ],
      "justification": "Correctly implements the form initialization triggered by the prior status designation."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is a \"Construct Approve Response\", then the process ends with an \"Approved Message\"."
      ],
      "justification": "Matches the approval condition, the resulting message action, and the process termination."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Otherwise, if there is a \"Construct Reject Response\", then the process ends with a \"Reject Message\"."
      ],
      "justification": "Aligns exactly with the rejection condition, associated message, and final end point."
    }
  ],
