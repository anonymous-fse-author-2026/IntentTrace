{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "The opening clause implicitly starts the process and directly describes the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed with the Registration gross pathology request."
      ],
      "justification": "Direct correspondence to the registration step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the registration is complete, assign a container to the gross pathology request."
      ],
      "justification": "Faithfully captures the container assignment instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During the \"Registration gross pathology request\" step, make sure to create a barcode scan at the start."
      ],
      "justification": "Accurately reflects the barcode creation requirement during registration."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After assigning a container, move on to the Specimen description."
      ],
      "justification": "Maps directly to the specimen description transition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "For the \"Specimen description\" step, pay attention to the scan start."
      ],
      "justification": "Preserves the scan start instruction for specimen description."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Then, pay attention to the scan end."
      ],
      "justification": "Captures the subsequent scan end instruction."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Finally, pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Matches the repeated scan start instruction for the continued registration step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Following that, proceed with Macroscopic description writing."
      ],
      "justification": "Directly corresponds to the macroscopic writing step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "The concurrency keyword explicitly triggers an AND split for parallel execution."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Tissue processing"
      ],
      "justification": "Exact match for the first parallel task."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required."
      ],
      "justification": "The conditional check introduces the XOR branch and is modeled as an action node."
    },
    {
      "refs": [
        "guard:b1->n13"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\""
      ],
      "justification": "Guard correctly captures the negative condition value."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Matches the instruction for the negative branch outcome."
    },
    {
      "refs": [
        "guard:b1->n12"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\""
      ],
      "justification": "Guard correctly captures the positive condition value."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "proceed with Digitalization."
      ],
      "justification": "Direct paraphrase of the positive branch action."
    },
    {
      "refs": [
        "action:n14",
        "guard:b2->n15",
        "guard:b2->n16"
      ],
      "verbatim_texts": [
        "Next, check if \"Digitalization?\" is required again."
      ],
      "justification": "The word 'again' implies repeating the exact same conditional logic, branch structure, and outcomes."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "After that, assign cases to the pathologist and then move on to Microscopic examination and diagnosis."
      ],
      "justification": "Two sequential actions faithfully extracted from the joined clause."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the microscopic examination and diagnosis are complete, write the pathology report."
      ],
      "justification": "Captures the report writing step triggered by completion."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "After writing the report, confirm it."
      ],
      "justification": "Direct match for the confirmation step."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the pathology report is confirmed, deliver it."
      ],
      "justification": "Matches the first delivery instruction."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Then, proceed with the post-report processing."
      ],
      "justification": "Direct correspondence to initiating post-report processing."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "To conclude the pathology procedure, close it."
      ],
      "justification": "Faithfully restates the closure instruction."
    },
    {
      "refs": [
        "action:n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, deliver the pathology report and complete the post-report processing."
      ],
      "justification": "Both concluding actions are accurately split and mapped."
    }
  ],
