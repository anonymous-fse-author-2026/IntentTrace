{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially,"
      ],
      "justification": "The opening context implicitly triggers the process start; the action name is a direct paraphrase of initiating the procedure."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
      "justification": "Models the initial conditional check, the XOR decision point, and the positive branch guard."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Directly implements the prescribed action for the positive branch."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Captures the negative branch guard and its two sequential actions."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Sequentially models the validation step, the satisfaction check, and the resulting decision gateway."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Implements the negative outcome guard and the corresponding research action."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Implements the positive outcome guard and the ticket order creation action."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory"
      ],
      "justification": "Models the re-evaluation check and the gateway leading to the fallback path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "then \"provide indications\"."
      ],
      "justification": "Directly implements the indicated fallback action."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Models the alternative positive path guard and its associated action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Directly matches the ticket order validation step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Models the approval verification step and its decision point."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Implements the rejection guard, termination action, and structural end node."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Implements the approval continuation guard and re-validation action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Models the second approval check and its decision gateway."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Models the third approval check and its decision gateway."
    },
    {
      "refs": [
        "guard:b6->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Implements the final approval termination guard, action, and end node."
    }
  ],
  "mutations": [],
  "omissions": [
    {
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\"."
      ],
      "reason": "The source explicitly requires performing the 'Research schedule' action upon dissatisfaction before proceeding, but the model skips directly to the next satisfaction check without this step."
    }
  ],
