      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "The opening sentence explicitly triggers the process start and details the two sequential UI interactions, all faithfully reproduced across the init node and three action nodes."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000,",
        "greater than 1000"
      ],
      "justification": "The conditional clause and its numeric threshold are directly mapped to the action step and XOR gateway structure."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the report should be reviewed."
      ],
      "justification": "Direct imperative-to-infinitive paraphrase preserving exact meaning."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed to check if there is a need for translation."
      ],
      "justification": "Faithful restatement of the translation requirement check."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "proceed to translate the receipts."
      ],
      "justification": "Direct correspondence to the positive translation path."
    },
    {
