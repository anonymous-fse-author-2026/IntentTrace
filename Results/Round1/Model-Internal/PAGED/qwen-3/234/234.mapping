  "mutations": [
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "less than 5.000 \u20ac"
      ],
      "reason": "The source specifies a strict inequality ('less than'), but the guard uses '<=', altering the financial threshold logic."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed. Once the database is completed,"
      ],
      "reason": "Distorts the source by replacing the explicit database completion verification with a generic 'orders input completed and checked' statement, changing the subject and scope."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "reason": "Drops the critical delivery destination 'to the finance department', altering the report's routing requirement."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "reason": "Only captures sending the invoice, completely omitting the mandatory follow-up to report the achievement to finance."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "sign and send the memo",
        "ensure that the signed memo is achieved in the logistic department."
      ],
      "reason": "Conflates the memo signing/sending with logistics delivery, dropping the explicit instruction to verify the memo's arrival in the logistics department."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "ensure that the memo is achieved in the warehouse.",
        "archive the memo"
      ],
      "reason": "Changes the specific warehouse tracking requirement into vague 'archiving', merging distinct logistical tracking and administrative filing steps."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "after a week"
      ],
      "reason": "Critical timing constraint governing when the Excel list is dispatched is entirely absent."
    },
    {
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed. Once the database is completed,"
      ],
      "reason": "Database completion verification is not faithfully implemented; the closest model element distorts its scope and subject."
    },
    {
      "verbatim_texts": [
        "After PPC initiates production, the goods will be produced."
      ],
      "reason": "The actual production step following PPC initialization is completely skipped."
    },
    {
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "reason": "Quality report creation and routing are not faithfully implemented due to dropped destination details."
    },
    {
      "verbatim_texts": [
        "ensure that the memo is achieved in the warehouse."
      ],
      "reason": "Warehouse-specific memo tracking step is missing from the model."
    },
    {
      "verbatim_texts": [
        "report the achievement to the finance department."
      ],
      "reason": "Finance reporting step following invoice dispatch is missing."
    },
    {
      "verbatim_texts": [
        "sign and send the memo"
      ],
      "reason": "Memo handling step is not faithfully implemented due to conflation with logistics tracking."
    },
    {
      "verbatim_texts": [
        "Also, send the goods"
      ],
      "reason": "Physical goods dispatch step is completely omitted."
    },
    {
      "verbatim_texts": [
        "ensure that the signed memo is achieved in the logistic department."
      ],
      "reason": "Logistics department memo verification is missing."
    },
    {
      "verbatim_texts": [
        "archive the memo"
      ],
      "reason": "Archiving instruction is not faithfully implemented due to merging with warehouse tracking."
    }
  ],
