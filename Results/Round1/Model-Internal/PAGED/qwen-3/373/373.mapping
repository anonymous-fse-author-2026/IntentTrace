{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The opening clause implicitly initiates the process and explicitly describes the first receiving action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Direct one-to-one correspondence with the creation and recording step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "Describes the decision-making step and implicitly introduces the XOR branch point."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "The conditional maps to the guard, and the consequent maps to the rejection action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted,"
      ],
      "justification": "The acceptance condition is captured by the positive guard, with the condition logically restated in the target action node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Faithfully captures the review action; the preceding condition is structurally implied by the rejection path flow."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Directly matches the discharge preparation step following the acceptance branch."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Exact match for the benefit payment recording step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process."
      ],
      "justification": "Condition modeled as action n7, followed by branch b2, positive guard, and continuation action n15, preserving the full logical chain."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Negative guard ('No') and continuation action align precisely with the rejection-review negative outcome."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicit termination statement supports both the final end action and the structural end node."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "Concurrency marker justifies the AND branch, the two parallel actions, and their required convergence points."
    }
  ],
