      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "The structural start node and the mailbox-emptying action directly align with the opening instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "The check action and XOR split node faithfully implement the first verification step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if not, continue the process"
      ],
      "justification": "The negative guard condition maps to the 'if not' continuation clause."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "The positive guard, termination action, and end node collectively model the conditional process stop."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "The verification action and subsequent XOR gateway match the completeness check."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "The positive guard and recording action accurately capture the complete-data path."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "The negative guard and call action accurately capture the incomplete-data path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "The action faithfully restates the post-call data completion instruction."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "The action preserves the frequency, objects, and destination exactly."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member"
      ],
      "justification": "The check action and XOR split node implement the membership decision point."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "The positive guard and stamping/dating action match the successful membership workflow."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "The negative guard and notification action match the rejection workflow."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "The action captures the immediate subsequent data-writing step."
    },
    {
      "refs": [
