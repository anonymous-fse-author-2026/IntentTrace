@startuml
!theme plain
|a_default| Default
|a_default|
start
:start process;
:look at the order;
:order rejected?;
:v1: order rejected? ({Accepted, Rejected}); <<objectSignal>>
if () then ([v1 = 'Accepted'])
:prepare assembling order;
else ([v1 = 'Rejected'])
:check availability;
endif
:backorder?;
:v2: backorder? ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:check availability again;
:end;
stop
else ([v2 = 'No'])
:assemble bike;
:ship product;
:end;
stop
endif
@enduml