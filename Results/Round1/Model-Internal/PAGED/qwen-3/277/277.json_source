  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process for ACME Company, we first trigger the Resupply Cycle."
    },
    {
      "id": "i2",
      "content": "After that, we check the inventory level."
    },
    {
      "id": "i3",
      "content": "Once the inventory level is checked, we proceed to create a purchase order."
    },
    {
      "id": "i4",
      "content": "If the purchase order is not good"
    },
    {
      "id": "i5",
      "content": "If the purchase order is not good, we reject it."
    },
    {
      "id": "i6",
      "content": "However, if the purchase order is good, we approve it."
    },
    {
      "id": "i7",
      "content": "In case the purchase order is rejected, we rework it."
    },
    {
      "id": "i8",
      "content": "On the other hand, if the purchase order is approved, we reserve funds for the purchase."
    },
    {
      "id": "i9",
      "content": "After reworking the purchase order, we review it again."
    },
    {
      "id": "i10",
      "content": "Once the funds are reserved, we send the purchase order to the supplier."
    },
    {
      "id": "i11",
      "content": "Simultaneously, we complete the following steps: receive the packing slip and receive the invoice."
    },
    {
      "id": "i12",
      "content": "After receiving the packing slip, we record it."
    },
    {
      "id": "i13",
      "content": "Similarly, after receiving the invoice, we record it as well."
    },
    {
      "id": "i14",
      "content": "Next, we release funds for payment and issue the payment."
    },
    {
      "id": "i15",
      "content": "Finally, the process ends after the payment is issued."
    }
  ]
}