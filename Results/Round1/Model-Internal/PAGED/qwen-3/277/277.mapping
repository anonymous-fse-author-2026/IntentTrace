{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME Company, we first trigger the Resupply Cycle."
      ],
      "justification": "The opening clause implicitly defines the process start and explicitly states the first action, which matches the content exactly."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, we check the inventory level."
      ],
      "justification": "Direct mapping of the sequential inventory check step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once the inventory level is checked, we proceed to create a purchase order."
      ],
      "justification": "Faithfully captures the next sequential action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the purchase order is not good"
      ],
      "justification": "The condition fragment introduces the decision point. The action node acts as a check step leading directly into the XOR branch, preserving the logical flow."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the purchase order is not good"
      ],
      "justification": "The guard evaluates the negative condition. The boolean 'v1 = No' is a standard modeling abstraction that faithfully represents the 'not good' path without altering logic."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "However, if the purchase order is good, we approve it."
      ],
      "justification": "The guard evaluates the positive condition. The boolean 'v1 = Yes' accurately maps to the 'good' branch outcome."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the purchase order is not good, we reject it."
      ],
      "justification": "Directly implements the rejection action specified for the negative condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the purchase order is good, we approve it."
      ],
      "justification": "Directly implements the approval action specified for the positive condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "In case the purchase order is rejected, we rework it."
      ],
      "justification": "Exact match for the rework step following rejection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase order is approved, we reserve funds for the purchase."
      ],
      "justification": "Faithfully restates the fund reservation action triggered upon approval."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, we review it again."
      ],
      "justification": "Direct mapping of the post-rework review step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, we send the purchase order to the supplier."
      ],
      "justification": "Exact match for the dispatch step following fund reservation."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, we complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "The timing word 'Simultaneously' justifies the AND gateway, which splits into the two parallel receipt actions described."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After receiving the packing slip, we record it."
      ],
      "justification": "Matches the recording action. The converge node structurally marks the termination of this parallel branch before the flows rejoin."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Similarly, after receiving the invoice, we record it as well."
      ],
      "justification": "Matches the invoice recording action. The converge node structurally marks the termination of this second parallel branch."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Next, we release funds for payment and issue the payment."
      ],
      "justification": "The single source unit correctly segments into the two distinct financial actions modeled."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued."
      ],
      "justification": "Explicitly signals process termination, supporting both the final action node and the structural end marker."
    }
  ],
