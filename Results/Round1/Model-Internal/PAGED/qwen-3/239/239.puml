@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:Examine Order;
:Is Order Rejected?;
:v1: Is Order Rejected? ({Rejected, Prepare, Check}); <<objectSignal>>
switch ()
case ([v1 = 'Rejected'])
:Reject Order;
:End;
stop
case ([v1 = 'Prepare'])
:Prepare Assembling Order;
:Is Backorder Required?;
:v2: Is Backorder Required? ({Backorder, Reserved}); <<objectSignal>>
if () then ([v2 = 'Backorder'])
:End;
stop
else ([v2 = 'Reserved'])
:Assemble Bike;
-> 12;
:Ship Product;
:End;
stop
endif
case ([v1 = 'Check'])
:Check Availability;
endswitch
@enduml