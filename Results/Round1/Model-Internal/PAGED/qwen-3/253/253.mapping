{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "The init node marks the process start, and the action step directly implements the first instructed task."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level. If the \"Inventory level is at or below the minimum\""
      ],
      "justification": "The action node models the inventory check step, while the XOR branch captures the decision point introduced by the conditional clause."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then proceed to Create Purchase Order"
      ],
      "justification": "Faithfully represents the positive-path action to generate the purchase order."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process ends."
      ],
      "justification": "Both the action step and structural end node correctly terminate the negative path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Directly matches the sequential review step following order creation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved"
      ],
      "justification": "The action phrases the approval check as a question, and the branch handles the resulting exclusive split."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "then reserve the funds for the purchase."
      ],
      "justification": "Accurately captures the funding reservation step on the approval branch."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then rework the order."
      ],
      "justification": "Matches the rework instruction on the rejection branch."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Directly corresponds to transmitting the order to suppliers after funding."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Correctly implements the feedback loop to review rejected orders."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: the Supplier sends a packing slip and an invoice."
      ],
      "justification": "The action models the supplier's delivery task, and the AND branch reflects the concurrent execution of subsequent tracking steps."
    },
    {
      "refs": [
        "label:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it."
      ],
      "justification": "The edge label denotes the receipt trigger, and the action captures the recording task."
    },
    {
      "refs": [
        "label:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Similarly, when the invoice is received, record it as well."
      ],
      "justification": "Parallel counterpart: label marks invoice arrival, action marks its recording."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice, release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "The converge node logically rejoins the two parallel documentation paths, and the action executes the combined settlement tasks."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Both elements properly terminate the main workflow upon payment completion."
    }
  ],
