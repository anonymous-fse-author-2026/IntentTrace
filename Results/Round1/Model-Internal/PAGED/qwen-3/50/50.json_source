  "input_elements": [
    {
      "id": "i1",
      "content": "At first, the doctor receives a request."
    },
    {
      "id": "i2",
      "content": "After receiving the request, the doctor sends an appointment."
    },
    {
      "id": "i3",
      "content": "Once the appointment is sent, the doctor receives the symptoms."
    },
    {
      "id": "i4",
      "content": "Following the receipt of symptoms, the doctor sends a prescription pickup."
    },
    {
      "id": "i5",
      "content": "After sending the prescription pickup, the doctor receives a medicine request."
    },
    {
      "id": "i6",
      "content": "Upon receiving the medicine request, the doctor sends the medicine."
    },
    {
      "id": "i7",
      "content": "Finally, the process ends."
    }
  ]
