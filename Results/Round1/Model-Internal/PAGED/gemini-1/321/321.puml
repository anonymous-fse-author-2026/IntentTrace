@startuml
!theme plain
|a_default| Default
|a_default|
start
:start buyer process;
:choose a book;
:choose what to do after selecting book;
:v1: choose what to do after selecting book ({n4, n5, n6}); <<objectSignal>>
switch ()
case ([v1 == "n4"])
:view book details;
:choose what to do after viewing book details;
:v2: choose what to do after viewing book details ({n8, n9}); <<objectSignal>>
if () then ([v2 == "n8"])
:view list of new copies from book details;
-> After selecting preferred copy;
else ([v2 == "n9"])
:select a copy and complete process;
-> After selecting preferred copy;
endif
case ([v1 == "n5"])
:view list of new copies;
-> After selecting preferred copy;
case ([v1 == "n6"])
:view list of used copies;
:evaluate list of used copies;
:select preferred copy and complete process;
-> After selecting preferred copy;
endswitch
:End;
stop
@enduml