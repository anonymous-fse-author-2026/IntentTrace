init(i1)
action(n1, "Start by receiving the invoice")
action(n2, "Check the invoice for any mismatches")
branch(b1, XOR)
action(n3, "Is re-send the invoice to the customer needed")
branch(b2, XOR)
action(n4, "Continue process after re-sending invoice")
action(n5, "End process due to no action needed")
end(e1)
action(n6, "Is option to post the invoice")
branch(b3, XOR)
action(n7, "Continue process after posting invoice")
action(n8, "Is option to block the invoice")
branch(b4, XOR)
action(n9, "Continue process after blocking invoice")
action(n10, "Park the invoice")
action(n11, "End process")
end(e2)
converge(c1)
converge(c2)
defines(v1, "Check the invoice for any mismatches", {"Proceed to re-send check", "Proceed to post check", "Proceed to block check"})
defines(v2, "Is re-send the invoice to the customer needed", {"Yes", "No"})
defines(v3, "Is option to post the invoice", {"Yes", "No"})
defines(v4, "Is option to block the invoice", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, b2, n4, n5, e1, n6, b3, n7, n8, b4, n9, n10, n11, e2, c1, c2])
precedence(i1, n1)
precedence(n2, b1)
precedence(n3, b2)
precedence(n5, e1)
precedence(n6, b3)
precedence(n8, b4)
precedence(n11, e2)
precedence(c1, n5)
precedence(c2, n10)
precedence(n1, n2)
precedence(b1, n3)
precedence(b2, n4)
precedence(b2, c1)
precedence(b1, n6)
precedence(b3, n7)
precedence(b3, c1)
precedence(b1, n8)
precedence(b4, n9)
precedence(b4, c1)
precedence(n4, c2)
precedence(n7, c2)
precedence(n9, c2)
precedence(n10, n11)
guard(b1, n3, v1 = 'Proceed to re-send check')
guard(b2, n4, v2 = 'Yes')
guard(b2, c1, v2 = 'No')
guard(b1, n6, v1 = 'Proceed to post check')
guard(b3, n7, v3 = 'Yes')
guard(b3, c1, v3 = 'No')
guard(b1, n8, v1 = 'Proceed to block check')
guard(b4, n9, v4 = 'Yes')
guard(b4, c1, v4 = 'No')