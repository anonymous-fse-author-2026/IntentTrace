@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process;
:undergo immigration checks;
:select method for exit control checks;
split
:use biometrics for exit control checks;
:is permission granted after exit control checks;
:v1: is permission granted after exit control checks ({allowed, denied}); <<objectSignal>>
if () then ([v1 = 'denied'])
:leave the area;
:process ends;
stop
else ([v1 = 'allowed'])
:proceed to the next step;
:is the exit control check outcome successful;
:v3: is the exit control check outcome successful ({successful, unsuccessful}); <<objectSignal>>
if () then ([v3 = 'unsuccessful'])
:leave the area;
:process ends;
stop
else ([v3 = 'successful'])
:continue process;
:process ends;
stop
endif
endif
split again
:use ID documents for exit control checks;
:is permission granted after exit control checks;
:v2: is permission granted after exit control checks ({allowed, denied}); <<objectSignal>>
if () then ([v2 = 'denied'])
:leave the area;
:process ends;
stop
else ([v2 = 'allowed'])
:proceed to the next step;
:is the exit control check outcome successful;
:v4: is the exit control check outcome successful ({successful, unsuccessful}); <<objectSignal>>
if () then ([v4 = 'unsuccessful'])
:leave the area;
:process ends;
stop
else ([v4 = 'successful'])
:continue process;
:process ends;
stop
endif
endif
end split
@enduml