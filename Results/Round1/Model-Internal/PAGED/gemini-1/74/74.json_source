  "input_elements": [
    {
      "id": "i1",
      "content": "To initiate the process"
    },
    {
      "id": "i2",
      "content": "starting and entering the metadata"
    },
    {
      "id": "i3",
      "content": "proceed to the IN-Patient step"
    },
    {
      "id": "i4",
      "content": "At the same time, complete the following steps:"
    },
    {
      "id": "i5",
      "content": "send data to suppliers"
    },
    {
      "id": "i6",
      "content": "create a claim"
    },
    {
      "id": "i7",
      "content": "extract the data from the suppliers and transfer it to the doctor's phone"
    },
    {
      "id": "i8",
      "content": "confirm the GOP"
    },
    {
      "id": "i9",
      "content": "the process will come to an end"
    },
    {
      "id": "i10",
      "content": "register the case"
    },
    {
      "id": "i11",
      "content": "handle the claim"
    },
    {
      "id": "i12",
      "content": "Extract the data from the suppliers"
    },
    {
      "id": "i13",
      "content": "enter it on the patient's record or confirm the IN-Patient status"
    },
    {
      "id": "i14",
      "content": "receive the payment"
    },
    {
      "id": "i15",
      "content": "send the data back to the suppliers"
    },
    {
      "id": "i16",
      "content": "conclude the process"
    }
  ]
}