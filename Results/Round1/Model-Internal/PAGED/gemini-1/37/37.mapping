{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Faithfully reproduces the initiation and order placement action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Check the Customer's Credit Limit"
      ],
      "justification": "Exact match for the checking action."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article"
      ],
      "justification": "Faithfully maps the positive response condition to a branch and guard."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the response is \"No\", send a Denial to the Customer"
      ],
      "justification": "Faithfully maps the negative response condition to a guard."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "if the response is \"Okay\", proceed to Check the Availability of the Article again"
      ],
      "justification": "Faithfully maps the second positive response condition."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer"
      ],
      "justification": "Faithfully maps the second negative response condition."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods"
      ],
      "justification": "Implies the decision branch for availability and perfectly matches the producing action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "if the Article is available, proceed to Collect the Goods"
      ],
      "justification": "Exact match for collecting goods."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "send an Order Confirmation"
      ],
      "justification": "Exact match for order confirmation."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "Maps the concurrency keyword to an AND branch."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Ship the Goods"
      ],
      "justification": "Exact match for shipping goods."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Send the Invoice"
      ],
      "justification": "Exact match for sending invoice."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Check the Payment status"
      ],
      "justification": "Exact match for checking payment."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process"
      ],
      "justification": "Implies the branch for payment receipt and faithfully matches the end instruction structurally and as an action."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order"
      ],
      "justification": "Implies the branch for the reminder limit and faithfully matches the write-off action."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder.",
        "send a Reminder"
      ],
      "justification": "Exact match for the redundant reminder actions."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process"
      ],
      "justification": "Structurally maps the closing of the process."
    }
  ],
  "mutations": [
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article"
      ],
      "reason": "Adds the invented qualifier 'first time' to the checking action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "if the response is \"No\", send a Denial to the Customer"
      ],
      "reason": "Adds the invented qualifier 'due to Credit Limit' to the denial action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "if the response is \"Okay\", proceed to Check the Availability of the Article again"
      ],
      "reason": "Replaces the word 'again' with the invented qualifier 'second time'."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer"
      ],
      "reason": "Adds the invented qualifier 'due to Article Unavailability' to the denial action."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods"
      ],
      "reason": "Replaces the explicit text 'not available' with an abstracted 'v3 = 'No'' value."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "if the Article is available, proceed to Collect the Goods"
      ],
      "reason": "Replaces the explicit text 'is available' with an abstracted 'v3 = 'Yes'' value."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process"
      ],
      "reason": "The guard replaces the explicit 'has been received' condition with an abstracted 'v4 = 'Yes'' value, and the action adds the invented qualifier 'due to Payment received'."
    },
    {
      "refs": [
        "guard:b4->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3"
      ],
      "reason": "The guard abstracts 'has not been received' into 'v4 = 'No'', and the action drops the explicit instruction 'check if' to reformat it as a question."
    },
    {
      "refs": [
        "guard:b5->n21"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order"
      ],
      "reason": "Replaces the numerical condition 'greater than or equal to 3' with an abstracted 'v5 = 'Yes'' value."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process"
      ],
      "reason": "Adds the invented qualifiers 'after Write off' and 'after Closing Order' to the closing actions."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3"
      ],
      "reason": "Because its only candidate elements (the guard and check action) distorted the text and were recorded as mutations, this required step is not faithfully implemented by any element."
    }
  ],
  "additions": [
