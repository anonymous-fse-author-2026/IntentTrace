{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process,"
      ],
      "justification": "The opening phrase implicitly initiates the process and is also modeled as a starting action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Rental Items are Returned to the Store."
      ],
      "justification": "Direct paraphrase of the action of returning items."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\""
      ],
      "justification": "Opens an XOR decision and captures the specific condition as an action step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Delivery Crew picks-up items at the event site,"
      ],
      "justification": "Direct paraphrase of the alternative delivery action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\""
      ],
      "justification": "Initiates a decision branch and models the condition effectively as an action step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "if the \"Order is incomplete and items are missing,\""
      ],
      "justification": "Faithfully models the conditional branch as an action step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Direct paraphrase of the emailing action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "if the \"Items are packed for an existing order,\""
      ],
      "justification": "Accurately represents the packing condition as an action step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "if the \"Items are stored for future orders,\""
      ],
      "justification": "Accurately represents the storage condition as an action step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Direct paraphrase of the customer notification action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "temporarily take them out of inventory."
      ],
      "justification": "Direct paraphrase of the inventory removal step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "Opens a decision branch and captures the specific condition correctly as an action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "if the \"Customer does not return the missing items,\""
      ],
      "justification": "Models the negative condition faithfully as an action step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "when the process is complete, it ends."
      ],
      "justification": "Captures the termination of the process structurally and as an ending action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\""
      ],
      "justification": "Opens an XOR decision and represents the condition precisely as an action step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "if the \"Items can't be repaired and are discarded,\""
      ],
      "justification": "Accurately captures the discard condition as an action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "we email the customer with replacement charges."
      ],
      "justification": "Direct paraphrase of the step to email replacement charges."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order. If the \"Items are packed for an existing order,\""
      ],
      "justification": "Direct paraphrase of the second packing condition modeled as an action."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\""
      ],
      "justification": "Models the second storage condition as an action step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Captures the alternative process conclusion structurally and as an action."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "and the process is complete."
      ],
      "justification": "Redundant closure phrase that maps faithfully to the end action."
    }
