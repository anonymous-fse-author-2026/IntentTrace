@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:receive form;
:check if form is complete;
:v1: check if form is complete ({send back, check income, check deductibles, check house}); <<objectSignal>>
switch ()
case ([v1 == "send back"])
:end process: form needs to be sent back;
stop
case ([v1 == "check income"])
:check income;
:make decision;
:v2: make decision ({check declaration, invite declarant}); <<objectSignal>>
if () then ([v2 == "check declaration"])
:end process: check declaration;
stop
else ([v2 == "invite declarant"])
:invite declarant;
stop
endif
case ([v1 == "check deductibles"])
:check deductibles;
case ([v1 == "check house"])
:check house;
endswitch
@enduml