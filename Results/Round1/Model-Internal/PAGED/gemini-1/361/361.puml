@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:trigger: resupply cycle;
:check: inventory level;
:v1: check  inventory level ({above minimum, below minimum}); <<objectSignal>>
if () then ([v1 == "above minimum"])
:end process: above minimum;
stop
else ([v1 == "below minimum"])
:create: purchase order;
:review: purchase order;
switch ()
case (case 1)
:rework: purchase order;
:review: purchase order;
:v3: review  purchase order ({rejected, accepted}); <<objectSignal>>
if () then ([v3 == "accepted"])
:reserve funds and send PO;
:receive packing slip and release funds;
:end process: completed;
stop
endif
case (case 2)
case (else)
:send to supplier;
:receive packing slip and release funds;
:end process: completed;
stop
endswitch
endif
@enduml