@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:Examine Order;
:Is Order Rejected?;
:v1: Is Order Rejected? ({Rejected, Accepted_1, Accepted_2}); <<objectSignal>>
switch ()
case ([v1 = "Rejected"])
:Reject Order;
:End;
stop
case ([v1 = "Accepted_1"])
:Prepare Assembling Order;
:Is Backorder Required?;
:v2: Is Backorder Required? ({Yes, No}); <<objectSignal>>
if () then ([v2 = "Yes"])
:End;
stop
else ([v2 = "No"])
:Assemble Bike;
-> 12;
:Ship Product;
:End;
stop
endif
case ([v1 = "Accepted_2"])
:Check Availability;
endswitch
@enduml