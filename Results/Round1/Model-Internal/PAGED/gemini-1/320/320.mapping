      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\"."
      ],
      "justification": "These segments justify the negative guard and the resulting research schedule action. Both redundant text statements map correctly to this single implemented path."
    },
    {
