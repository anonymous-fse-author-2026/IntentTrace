@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:make purchase and connect to website;
repeat :search for item;
:add item to cart / continue shopping;
:v1: add item to cart / continue shopping ({Add item to cart, Continue Shopping}); <<objectSignal>>
backward:continue shopping;
repeat while () is ([v1 = 'Continue Shopping']) not ([v1 = 'Add item to cart'])
:proceed to checkout;
split
:enter address shipping method and payment information;
split again
:authorize credit card and check inventory levels;
end split
:checkout tasks completed?;
:v2: checkout tasks completed? ({Completed, Checkout Tasks Not Completed}); <<objectSignal>>
if () then ([v2 = 'Completed'])
:credit card approved and inventory in stock?;
:v3: credit card approved and inventory in stock? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:display order confirmation number;
:show final order to customer;
:confirm the order;
:send confirmation notice via email;
:order entry complete;
stop
else ([v3 = 'No'])
:transaction ended;
stop
endif
else ([v2 = 'Checkout Tasks Not Completed'])
:checkout tasks not completed;
stop
endif
@enduml