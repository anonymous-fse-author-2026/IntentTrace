@startuml
!theme plain
|a_default| Default
|a_default|
start
:start registration for event participation;
:check if there is a fee;
:v1: check if there is a fee ({yes, no}); <<objectSignal>>
if () then ([v1 == "no"])
:register a post-seminar request;
:End process after post-seminar request registration;
stop
else ([v1 == "yes"])
:create a purchase request;
:check if purchase request is approved;
:v2: check if purchase request is approved ({yes, no}); <<objectSignal>>
if () then ([v2 == "yes"])
:receive an approved notification;
:register a post-seminar request after approval;
else ([v2 == "no"])
:receive a rejection notification;
endif
:End process after rejection notification or post-seminar registration;
stop
endif
@enduml