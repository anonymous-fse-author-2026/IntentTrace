    {
      "id": "i1",
      "content": "To start,"
    },
    {
      "id": "i2",
      "content": "join the team and agree on the team's domain."
    },
    {
      "id": "i3",
      "content": "create a process model and check it."
    },
    {
      "id": "i4",
      "content": "If the process model is \"NOT OK\""
    },
    {
      "id": "i5",
      "content": "then assign negative points."
    },
    {
      "id": "i6",
      "content": "If it is still \"NOT OK\""
    },
    {
      "id": "i7",
      "content": "assign negative points again."
    },
    {
      "id": "i8",
      "content": "you can continue with it."
    },
    {
      "id": "i9",
      "content": "If there are any issues,"
    },
    {
      "id": "i10",
      "content": "fix them in the next session and extend the process to levels 2 and 3."
    },
    {
      "id": "i11",
      "content": "If you need to check the process and assign points,"
    },
    {
      "id": "i12",
      "content": "continue with the process."
    },
    {
      "id": "i13",
      "content": "If you need to analyze the field of study,"
    },
    {
      "id": "i14",
      "content": "assign roles in the team."
    },
    {
      "id": "i15",
      "content": "If the process is okay, continue with the process"
    },
    {
      "id": "i16",
      "content": "perform work according to your assigned role."
    },
    {
      "id": "i17",
      "content": "Check the progress and consult any problems that arise."
    },
    {
      "id": "i18",
      "content": "If the project is accepted,"
    },
    {
      "id": "i19",
      "content": "present it."
    },
    {
      "id": "i20",
      "content": "continue working according to your role."
    },
    {
      "id": "i21",
      "content": "present it again."
    },
    {
      "id": "i22",
      "content": "Finally, present the project"
    },
    {
      "id": "i23",
      "content": "the process will come to an end."
