{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "The opening clause establishes the process start and the initial registration action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If an exception is needed,",
        "then a Request for the exception should be made."
      ],
      "justification": "Models the conditional check, the decision split, the positive guard, and the resulting request action faithfully."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If an exception is needed,",
        "then a Request for the exception should be made."
      ],
      "justification": "Models the conditional check, the decision split, the positive guard, and the resulting request action faithfully."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If an exception is needed,",
        "then a Request for the exception should be made."
      ],
      "justification": "Models the conditional check, the decision split, the positive guard, and the resulting request action faithfully."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "On the other hand, if an exception is not needed, the process can continue."
      ],
      "justification": "Captures the negative guard path and the explicit continuation instruction."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "After the exception is approved,"
      ],
      "justification": "Models the approval wait/check as an action, the subsequent XOR split, the positive approval guard, and the structural reconvergence point."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "the next step is course enrollment, followed by seminar group enrollment."
      ],
      "justification": "Directly maps the sequential enrollment steps described in the source."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the seminar group enrollment is completed, the homework assignment can be started."
      ],
      "justification": "Captures the initiation of the homework assignment following enrollment completion."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After working on the homework, it should be turned in."
      ],
      "justification": "Faithfully represents the submission step described in the segment."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated,"
      ],
      "justification": "Directly corresponds to the homework evaluation step."
    },
    {
      "refs": [
        "action:n12",
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Models the loop condition check, the decision gateway, the false-path guard (not last), and the reassignment action."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "However, if it was the last homework, the process can continue."
      ],
      "justification": "Captures the true-path guard exiting the homework loop and the structural join point."
    },
    {
      "refs": [
        "action:n15",
        "action:n16",
        "action:n14",
        "action:n17"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "Correctly models the AND split for concurrent steps, the specific accreditation and announcement actions, plus redundant summary/merge descriptors that preserve flow without altering behavior."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After signing up for the exam, it should be attended."
      ],
      "justification": "Accurately sequences the exam sign-up and attendance steps."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once the exam is attended, it will be evaluated."
      ],
      "justification": "Directly maps to the exam evaluation step."
    },
    {
      "refs": [
        "action:n21",
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue."
      ],
      "justification": "Models the pass-check action, the decision gateway, the true guard, and the course-pass outcome action."
    },
    {
      "refs": [
        "guard:b4->n23",
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Captures the fail-path guard, the re-signup action, and the structural/conceptual merge back into the exam cycle."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "the process can continue."
      ],
      "justification": "Handles the final continuation instruction, explicit end action, structural end node, and final convergence point."
    }
  ],
  "mutations": [],
  "omissions": [
    {
      "verbatim_texts": [
        "After working on the homework,"
      ],
      "reason": "The source explicitly describes a 'working on the homework' phase before submission, but the model jumps directly to the 'turn in homework' action without modeling the work step."
    }
  ],
  "additions": [
    {
      "refs": [
        "guard:b2->n6"
      ],
      "reason": "The source provides no instructions for what occurs when an exception is not approved. The guard leading to 'contact support or terminate process' invents an unhandled rejection path and termination logic absent from the text."
    },
