  "input_elements": [
    {
      "id": "i1",
      "content": "To begin with, the first step is Course registration."
    },
    {
      "id": "i2",
      "content": "If an exception is needed,"
    },
    {
      "id": "i3",
      "content": "then a Request for the exception should be made."
    },
    {
      "id": "i4",
      "content": "On the other hand, if an exception is not needed, the process can continue."
    },
    {
      "id": "i5",
      "content": "the process can continue."
    },
    {
      "id": "i6",
      "content": "After the exception is approved,"
    },
    {
      "id": "i7",
      "content": "the next step is course enrollment, followed by seminar group enrollment."
    },
    {
      "id": "i8",
      "content": "Once the seminar group enrollment is completed, the homework assignment can be started."
    },
    {
      "id": "i9",
      "content": "After working on the homework, it should be turned in."
    },
    {
      "id": "i10",
      "content": "The homework will then be evaluated,"
    },
    {
      "id": "i11",
      "content": "If it was not the last homework, another homework assignment will be given."
    },
    {
      "id": "i12",
      "content": "However, if it was the last homework, the process can continue."
    },
    {
      "id": "i13",
      "content": "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
    },
    {
      "id": "i14",
      "content": "After signing up for the exam, it should be attended."
    },
    {
      "id": "i15",
      "content": "Once the exam is attended, it will be evaluated."
    },
    {
      "id": "i16",
      "content": "If the exam is passed, the course is considered passed and the process can continue."
    },
    {
      "id": "i17",
      "content": "However, if the exam is failed, another sign-up for the exam is required."
    }
  ]
}