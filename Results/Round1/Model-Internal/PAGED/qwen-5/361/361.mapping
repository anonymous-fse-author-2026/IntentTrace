      ],
      "justification": "Directly implements the inventory level check step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the inventory level is above the minimum, then the process ends.",
        "However, if the inventory level is below the minimum, create a purchase order."
      ],
      "justification": "Captures the XOR decision point implied by the contrasting inventory conditions."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is above the minimum, then the process ends."
      ],
      "justification": "Guard captures the positive condition, action and end node implement the termination branch."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the inventory level is below the minimum, create a purchase order."
