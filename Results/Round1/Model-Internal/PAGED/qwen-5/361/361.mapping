      ],
      "justification": "Faithfully restates the review step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order."
      ],
      "justification": "Implicitly models the decision point before the rejection/rerework path."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order."
      ],
      "justification": "Guard and action precisely match the rejection condition and rerework instruction."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
