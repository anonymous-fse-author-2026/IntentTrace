init(i1)
action(n1, "Start AMAG process")
action(n2, "run: IDIS continuously calculates needs")
action(n3, "Is calculation done?")
branch(b1, XOR)
action(n4, "run: SAP ET 2000 orders spare parts")
action(n5, "End of AMAG process")
end(e1)
converge(c1)
defines(v1, "Is calculation done?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, e1, c1])
precedence(i1, n1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, c1)
precedence(n4, n5)
precedence(n5, e1)
guard(b1, n4, v1 = 'Yes')
guard(b1, c1, v1 = 'No')
label(n1, c1, "Start process")