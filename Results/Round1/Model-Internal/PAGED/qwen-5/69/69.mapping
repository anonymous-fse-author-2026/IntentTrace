{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process for ACME Company, we first trigger the Resupply Cycle."
      ],
      "justification": "The opening clause implicitly defines the process start (init) and explicitly describes the first concrete action (trigger resupply cycle)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, we check the inventory level."
      ],
      "justification": "Directly captures the second sequential step with identical meaning and scope."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the inventory level is checked, we proceed to create a purchase order."
      ],
      "justification": "Faithfully reproduces the creation step and its temporal dependency."
    },
    {
      "refs": [
        "action:n5",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the purchase order is not good, we reject it. However, if the purchase order is good, we approve it."
      ],
      "justification": "Collectively models the exclusive decision point, the condition check, and both resulting action paths exactly as described."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, we review it again."
      ],
      "justification": "The loop-back to review implies the rejected path rejoins the main flow at this point."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "In case the purchase order is rejected, we rework it."
      ],
      "justification": "Direct match to the rejection handling step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase order is approved, we reserve funds for the purchase."
      ],
      "justification": "Accurately reflects the fund reservation triggered by approval."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, we review it again."
      ],
      "justification": "Exact restatement of the post-rework review step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, we send the purchase order to the supplier."
      ],
      "justification": "Faithfully captures the dispatch action and its prerequisite."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "Simultaneously, we complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "The directive to perform steps simultaneously implies an AND-split and a subsequent converge point to synchronize flows."
    },
    {
      "refs": [
        "action:n12",
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, we complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Models the parallel gateway and the two concurrent receiving tasks exactly as specified."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After receiving the packing slip, we record it."
      ],
      "justification": "Direct match to the packing slip recording step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Similarly, after receiving the invoice, we record it as well."
      ],
      "justification": "Direct match to the invoice recording step."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Next, we release funds for payment and issue the payment."
      ],
      "justification": "Splits the conjunctive sentence into two faithful sequential actions preserving exact semantics."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued."
      ],
      "justification": "Explicitly states process termination and captures the final closing state."
    }
