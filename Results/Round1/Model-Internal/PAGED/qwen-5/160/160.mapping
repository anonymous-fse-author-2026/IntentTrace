      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the claimant is not insured, reject the claim."
      ],
      "justification": "Matches the negative guard condition and the rejection action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the claim is rejected, notify the claimant"
      ],
      "justification": "Faithfully reproduces the notification instruction."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "and the process comes to an end."
      ],
      "justification": "The terminal clause for the rejection branch justifies both the action and the structural end node."
    },
    {
      "refs": [
        "action:n9",
