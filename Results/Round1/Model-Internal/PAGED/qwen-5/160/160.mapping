      "verbatim_texts": [
        "To begin the process, start by claiming what is requested"
      ],
      "justification": "The opening clause implicitly triggers the process start and describes the two initial sequential actions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then check the insured status of the claimant."
      ],
      "justification": "Directly restates the verification step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the claimant is insured,"
