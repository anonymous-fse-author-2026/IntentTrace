  "input_elements": [
    {
      "id": "i1",
      "content": "the first step is to advise unsuccessful candidates"
    },
    {
      "id": "i2",
      "content": "If there are \"no more candidates\", then the position should be re-advertised."
    },
    {
      "id": "i3",
      "content": "if the terms and conditions of the offer for a candidate need to be sorted out"
    },
    {
      "id": "i4",
      "content": "it is necessary to check if the candidate has accepted a voluntary redundancy."
    },
    {
      "id": "i5",
      "content": "If the candidate has not accepted, the process continues."
    },
    {
      "id": "i6",
      "content": "The recruitment manager sends an Appointment Approval form"
    },
    {
      "id": "i7",
      "content": "If the manager is an external resource"
    },
    {
      "id": "i8",
      "content": "they may not authorize the form"
    },
    {
      "id": "i9",
      "content": "If the form is approved"
    },
    {
      "id": "i10",
      "content": "The HR department scans the completed form and records the position against the stored position in GovSource."
    },
    {
      "id": "i11",
      "content": "If there are any variations, a complete business case is required."
    },
    {
      "id": "i12",
      "content": "Otherwise, the process continues."
    },
    {
      "id": "i13",
      "content": "If the position requires a medical assessment, it is applicable for a 12% rate."
    },
    {
      "id": "i14",
      "content": "it can take up to 21 days to arrange and complete."
    },
    {
      "id": "i15",
      "content": "The TS HR coordinator informs the recruitment manager, who then liaises with the HR representative to confirm the offer to the candidate."
    },
    {
      "id": "i16",
      "content": "If the assessment is not satisfactory, the next candidate on the shortlist should be contacted."
    },
    {
      "id": "i17",
      "content": "if the assessment is fine, the process continues."
    },
    {
      "id": "i18",
      "content": "The recruitment manager makes a formal verbal offer of employment to the candidate."
    },
    {
      "id": "i19",
      "content": "If the candidate accepts, the recruitment manager creates a formal written offer."
    },
    {
      "id": "i20",
      "content": "If the candidate declines, the process continues."
    },
    {
      "id": "i21",
      "content": "Simultaneously, the commencement pack and letter of appointment are sent to the candidate."
    },
    {
      "id": "i22",
      "content": "if there is a \"40%\" rate, renegotiation is required."
    },
    {
      "id": "i23",
      "content": "If the renegotiation is successful, the process continues."
    },
    {
      "id": "i24",
      "content": "if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified."
    },
    {
      "id": "i25",
      "content": "Finally, the process ends."
    }
  ]
}