{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "init:i1 anchors the process start; action:n1 and action:n2 faithfully cover the initiation and customer checking steps described in the opening clause."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "branch:b1 structures the decision; guard:b1->n3 and action:n3 preserve the exact eligibility condition and the corresponding inform action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "The guard and action accurately reflect the alternative eligibility state and the subsequent ERP system order creation."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "action:n4 and end:e1 directly implement the termination step following the ineligible customer path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Open a new order in the ERP system and perform an availability check."
      ],
      "justification": "action:n6 captures the availability check instruction; the ERP opening step is repeated from i3 and already covered by action:n5."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\""
      ],
      "justification": "The XOR branch structurally implements the product availability evaluation step."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "guard:b2->n7 correctly resolves 'it is not' to 'not available' based on prior context; action:n7 matches the production trigger."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process. Prepare the products for shipment."
      ],
      "justification": "guard:b2->n9 routes the available case; action:n8 and its redundant duplicate action:n9 faithfully cover preparing products for shipment."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "The AND branches and converges model the concurrent execution structure; action:n10-n13 cover shipping, invoicing, and payment verification. Duplicate nodes (n9/n13 and extra converges) are structurally redundant but do not alter behaviour."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "branch:b3 splits on payment status; guard:b3->n14, action:n14, and end:e2 correctly implement the received-payment closure path."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "guard:b3->n15 and action:n15 precisely match the non-received payment condition and the reminder dispatch step."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->c5",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "action:n16 initiates the count evaluation; branch:b4 and guard:b4->c5 route based on the '< 3' threshold; action:n17 continues the workflow as specified."
    },
    {
      "refs": [
        "guard:b4->c6",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "guard:b4->c6, action:n18, and end:e3 exactly implement the threshold match, lawyer notification, and final process termination."
    }
  ],
