        "action:n16"
      ],
      "verbatim_texts": [
        "Next, check if \"Digitalization?\" is required again."
      ],
      "justification": "Models the repeated digitalization check and its logically implied yes/no branches with implicit convergence, consistent with the established pattern."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After that, assign cases to the pathologist and then move on to Microscopic examination and diagnosis."
      ],
      "justification": "Splits the sequential instructions into two distinct actions exactly as ordered in the text."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the microscopic examination and diagnosis are complete, write the pathology report. After writing the report, confirm it."
      ],
      "justification": "Covers report writing and confirmation steps in the correct sequence."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "Once the pathology report is confirmed, deliver it. Then, proceed with the post-report processing."
      ],
      "justification": "Maps report delivery and subsequent post-report processing exactly."
    },
    {
      "refs": [
        "action:n24",
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "To conclude the pathology procedure, close it. Finally, deliver the pathology report and complete the post-report processing."
      ],
      "justification": "Covers procedure closure, final delivery/processing consolidation, and explicit process termination."
    }
