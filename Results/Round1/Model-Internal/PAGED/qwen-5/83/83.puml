if () then ([v3 = 'Yes'])
:Proceed with process for complete order;
else ([v3 = 'No'])
:Is the Order incomplete and items missing;
:v4: Is the Order incomplete and items missing ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:Proceed with process for incomplete order;
else ([v4 = 'No'])
:Is Order complete but items damaged;
:v5: Is Order complete but items damaged ({Yes, No}); <<objectSignal>>
if () then ([v5 = 'Yes'])
:Email customer informing about damage and additional charges;
else ([v5 = 'No'])
->;
endif
endif
endif
repeat :;
:Do items get packed for existing order;
:v6: Do items get packed for existing order ({Yes, No}); <<objectSignal>>
backward:Continue process for items packed for existing order;
repeat while () is ([v6 = 'Yes']) not ([v6 = 'No'])
:Do items get stored for future orders;
:v7: Do items get stored for future orders ({Yes, No}); <<objectSignal>>
if () then ([v7 = 'Yes'])
:Continue process for items stored for future orders;
