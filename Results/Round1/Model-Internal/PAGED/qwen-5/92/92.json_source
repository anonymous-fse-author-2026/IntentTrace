  "input_elements": [
    {
      "id": "i1",
      "content": "To start,"
    },
    {
      "id": "i2",
      "content": "please register your participation for the event."
    },
    {
      "id": "i3",
      "content": "If there is no fee"
    },
    {
      "id": "i4",
      "content": "proceed to register a post-seminar request"
    },
    {
      "id": "i5",
      "content": "register a post-seminar request"
    },
    {
      "id": "i6",
      "content": "if there is a fee"
    },
    {
      "id": "i7",
      "content": "create a purchase request"
    },
    {
      "id": "i8",
      "content": "Once you have registered a post-seminar request, the process will come to an end."
    },
    {
      "id": "i9",
      "content": "check if the purchase request has been approved"
    },
    {
      "id": "i10",
      "content": "If it is approved"
    },
    {
      "id": "i11",
      "content": "you will receive an approved notification"
    },
    {
      "id": "i12",
      "content": "On the other hand, if the purchase request is rejected"
    },
    {
      "id": "i13",
      "content": "you will be notified of the rejection"
    },
    {
      "id": "i14",
      "content": "If you receive a rejection notification, the process will come to an end."
    }
  ]
