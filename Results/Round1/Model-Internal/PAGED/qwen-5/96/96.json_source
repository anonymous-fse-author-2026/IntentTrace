  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process, the customer needs to gather the required items"
    },
    {
      "id": "i2",
      "content": "inquire about the availability of products"
    },
    {
      "id": "i3",
      "content": "After sending the inquiry, they should wait for the invoice."
    },
    {
      "id": "i4",
      "content": "Once the invoice is received,"
    },
    {
      "id": "i5",
      "content": "the customer should review the pricing and terms of the items"
    },
    {
      "id": "i6",
      "content": "send a purchase requisition"
    },
    {
      "id": "i7",
      "content": "After sending the requisition, they need to wait for the purchase invoice and shipment."
    },
    {
      "id": "i8",
      "content": "Once the purchase invoice and shipment are received,"
    },
    {
      "id": "i9",
      "content": "the customer can proceed to receive the invoice."
    },
    {
      "id": "i10",
      "content": "they should make the payment."
    },
    {
      "id": "i11",
      "content": "Once the payment is made, the transaction is complete and the process ends."
    }
  ]
}