@startuml
!theme plain
|a_default| Default
|a_default|
start
:start reviewing incoming CV;
:decide whether to send a negative email or invite candidate;
:v1: decide whether to send a negative email or invite candidate ({NegativeEmail, InviteCandidate}); <<objectSignal>>
if () then ([v1 = 'NegativeEmail'])
:send negative email and end process;
else ([v1 = 'InviteCandidate'])
:schedule interview with candidate;
:conduct interview;
endif
:Process ends after interview;
stop
@enduml