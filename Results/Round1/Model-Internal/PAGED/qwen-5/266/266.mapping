  "mutations": [
    {
      "refs": [
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If the rebuild is complete"
      ],
      "reason": "Guard specifies 'Not successful' but source states that completion leads to the process ending. The logic and value are reversed."
    },
    {
      "refs": [
        "guard:b4->n15"
      ],
      "verbatim_texts": [
        "If the rebuild is complete, the process ends. If the rebuild is rejected again, the site needs to be rebuilt again"
      ],
      "reason": "Guards invent an intermediate approval/rejection cycle not present in the source. The direct transition from rebuild rejection to rebuilding again is distorted by inserted branches and steps."
    },
    {
      "refs": [
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again"
      ],
      "reason": "Guards invent an intermediate approval/rejection cycle not present in the source. The direct transition from rebuild rejection to rebuilding again is distorted by inserted branches and steps."
    }
