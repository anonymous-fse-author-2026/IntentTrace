init(i1)
action(n1, "start")
action(n2, "Enter Expenses")
action(n3, "Generate Spreadsheet")
action(n4, "Approval Check 1")
branch(b1, XOR)
action(n5, "Payout")
action(n6, "Approval Check 2")
branch(b2, XOR)
action(n7, "End Process")
end(e1)
converge(c1)
defines(v1, "Approval Check 1", {"Approved", "Disapproved"})
defines(v2, "Approval Check 2", {"Approved", "Disapproved"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, n6, b2, n7, e1, c1])
precedence(i1, n1)
precedence(n4, b1)
precedence(n6, b2)
precedence(n7, e1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(b1, n5)
precedence(n5, n6)
precedence(b2, n7)
precedence(b1, c1)
precedence(b2, c1)
guard(b1, n5, v1 = "Approved")
guard(b1, c1, v1 = "Disapproved")
guard(b2, n7, v2 = "Approved")
guard(b2, c1, v2 = "Disapproved")