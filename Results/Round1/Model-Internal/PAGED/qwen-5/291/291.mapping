  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "The opening clause implicitly triggers the process start and directly specifies the first action of starting and entering metadata."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed to the IN-Patient step."
      ],
      "justification": "Exact verbatim match for proceeding to the IN-Patient step."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: send data to suppliers and create a claim."
      ],
      "justification": "The concurrency marker 'At the same time' justifies the AND branch, while the two enumerated tasks map directly to their respective action elements."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the data is sent to suppliers, extract the data from the suppliers and transfer it to the doctor's phone."
      ],
      "justification": "Directly maps to the sequential actions of extracting supplier data and transferring it to the doctor's phone."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "confirm the GOP and the process will come to an end."
      ],
      "justification": "Faithfully captures the confirmation action, the explicit termination description, and the corresponding end node."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "register the case and handle the claim."
      ],
      "justification": "Directly maps to the paired actions of registering the case and handling the claim."
    },
    {
      "refs": [
        "action:n11",
        "guard:b1->n13",
        "guard:b1->n14",
        "action:n13",
        "action:n14",
        "action:n12"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status."
      ],
      "justification": "Covers the data extraction step, the exclusive choice branch with its logical guards and outcome actions, plus the redundantly combined action element."
    },
    {
      "refs": [
        "action:n15",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Register the case, handle the claim, and then receive the payment."
      ],
      "justification": "Sequentially maps to registering the case, handling the claim, and receiving payment."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "send the data back to the suppliers."
      ],
      "justification": "Exact match for sending data back to suppliers."
    },
    {
      "refs": [
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "Finally, receive the payment and conclude the process."
      ],
      "justification": "Maps to receiving payment, the concluding action description, and the final process end node."
    }
  ],
