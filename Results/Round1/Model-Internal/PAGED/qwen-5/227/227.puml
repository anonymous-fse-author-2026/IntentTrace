@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process with Insurance emergency;
:analyze the insurance agreement;
:is there coverage;
:v1: is there coverage ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:offer immediate help;
:repeat the same steps if necessary;
:v4: repeat the same steps if necessary ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'No'])
:conclude the process;
stop
else ([v4 = 'Yes'])
:analyze the insurance agreement;
endif
else ([v1 = 'No'])
:send out an offer for emergency help;
:has the offer been accepted;
:v2: has the offer been accepted ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'No'])
:ask for a rejection notification;
:repeat the same steps if necessary;
:v5: repeat the same steps if necessary ({Yes, No}); <<objectSignal>>
if () then ([v5 = 'No'])
:conclude the process;
stop
else ([v5 = 'Yes'])
:analyze the insurance agreement;
endif
else ([v2 = 'Yes'])
:proceed with internal accounting;
:repeat the same steps if necessary;
:v3: repeat the same steps if necessary ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'No'])
:conclude the process;
else ([v3 = 'Yes'])
:analyze the insurance agreement;
endif
endif
endif
stop
@enduml