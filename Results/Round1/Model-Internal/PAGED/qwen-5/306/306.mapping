      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "The opening clause explicitly triggers the process start, followed by the two initial sequential actions."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "Branch captures the XOR decision point, n3 preserves the condition text as an action node, and n4 executes the consequent step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "The negative arm action and structural end node both correspond to the termination clause."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Direct alignment with the review step following order creation."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "Branch marks the status check, while n8 performs the rework action on the negative branch."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Faithfully captures the fund reservation step tied to approval."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Captures the supplier dispatch action paired with fund reservation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Converge node models the flow merging back from rework, and n10 executes the subsequent review."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "At the same time"
      ],
      "justification": "The concurrency keyword directly implies an AND gateway for parallel execution."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Both receiving actions are explicitly listed in this compound instruction."
    },
    {
      "refs": [
