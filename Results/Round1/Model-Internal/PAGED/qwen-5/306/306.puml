@startuml
!theme plain
|a_default| Default
|a_default|
start
:trigger resupply cycle;
:check inventory level;
:inventory at or below minimum;
:v1: inventory at or below minimum ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:create purchase order;
:review purchase order;
:v2: purchase status approved ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'No'])
:rework purchase order;
:review purchase order;
else ([v2 = 'Yes'])
:reserve funds;
:send order to supplier;
split
:receive packing slip;
:record packing slip;
:process ends;
stop
split again
:receive invoice;
:record invoice;
:process ends;
stop
end split
endif
else ([v1 = 'No'])
:process ends;
stop
endif
@enduml