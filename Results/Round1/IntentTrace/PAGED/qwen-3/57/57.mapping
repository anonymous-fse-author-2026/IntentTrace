      ],
      "justification": "Exact match for the subsequent search step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "guard:b1->n6",
        "action:n4"
      ],
      "verbatim_texts": [
        "If they choose to \"Add item to cart\", they can proceed to checkout. However, if they select \"Continue Shopping\", they should continue with the process."
      ],
      "justification": "The conditional phrasing establishes the XOR decision point, defines the two outgoing guards, and describes the selection step itself."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed to checkout"
      ],
      "justification": "Directly matches the positive branch outcome."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "continue with the process"
      ],
      "justification": "Matches the negative branch loopback instruction."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "enter their address, shipping method, and payment information"
      ],
      "justification": "Faithfully captures the data entry step post-checkout initiation."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "At the same time, they should also authorize the credit card and check the inventory levels."
      ],
      "justification": "The concurrency marker 'At the same time' justifies the AND split and join, while the clause itself describes the parallel action."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "In either case"
      ],
      "justification": "Signals the rejoining of the two divergent paths into a common flow."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the order confirmation number should be displayed"
      ],
      "justification": "Exact match for the post-convergence display step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "the final order being shown to the customer"
      ],
      "justification": "Direct paraphrase of the subsequent display step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the order should be confirmed"
      ],
      "justification": "Matches the system confirmation step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "a confirmation notice should be emailed to the customer"
      ],
      "justification": "Direct match for the notification step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once the order entry is complete"
      ],
      "justification": "Captures the completion check preceding termination."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "the process will end"
      ],
      "justification": "Explicitly states the workflow termination."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "the transaction will end"
      ],
      "justification": "Matches the early termination condition on the negative branch."
    }
