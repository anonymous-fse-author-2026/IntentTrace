  "mutations": [
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If the credit card is approved and there is inventory in stock"
      ],
      "reason": "The model guard only evaluates credit card approval ('v3 = Approved') but omits the mandatory concurrent condition that inventory must be in stock."
    },
    {
      "refs": [
        "guard:b3->n16"
      ],
      "verbatim_texts": [
        "if the credit card is denied or there is no inventory in stock"
      ],
      "reason": "The model guard only evaluates credit card denial ('v3 = Denied') but drops the alternative failure condition regarding missing inventory, altering the original disjunctive logic."
    }
  ],
