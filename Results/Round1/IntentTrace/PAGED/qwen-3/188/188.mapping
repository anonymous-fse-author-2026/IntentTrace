      "verbatim_texts": [
        "To begin the process for IT Infrastructure, start with the Loan Application and then proceed to Receive Loan Application."
      ],
      "justification": "The opening clause implicitly starts the process and directly describes the first three sequential actions."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If there is a \"Construct Error Response\""
      ],
      "justification": "The conditional statement implies the XOR branch decision point."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
