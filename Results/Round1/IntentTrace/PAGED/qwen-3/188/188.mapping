    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the Status is designated, initialize the Loan Form."
      ],
      "justification": "Direct match for the loan form initialization step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If there is a \"Construct Approve Response\""
      ],
      "justification": "The conditional introduces the final decision branch."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "then the process ends with an \"Approved Message\"."
      ],
      "justification": "Maps the approval outcome action and process end."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
