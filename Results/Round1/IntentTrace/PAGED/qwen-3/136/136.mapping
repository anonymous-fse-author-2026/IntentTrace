{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "The opening clause implicitly triggers the process (init), describes the initial start step, and specifies checking the customer."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Conditional triggers the XOR branch, guard captures the not-eligible condition, and action matches informing them."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Guard captures the eligible condition and action matches opening the ERP order."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Action and structural end node both correspond to the explicit termination statement."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "perform an availability check."
      ],
      "justification": "Direct match for the availability verification step."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\". If it is not, start producing the missing parts."
      ],
      "justification": "Branch handles the availability check, guard models the negative/unavailable outcome, and action matches producing parts."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process. Prepare the products for shipment."
      ],
      "justification": "Guard models the positive/available outcome leading to shipment preparation; duplicated actions n8/n9 cover the same source instruction."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "AND branch captures the concurrency keyword, actions match shipping, invoicing, and payment checking."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Condition modeled as an action step precedes the XOR branch; guard and subsequent action faithfully restate the received-payment path."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Guard captures the non-receipt condition and action matches sending the reminder."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "ending the process."
      ],
      "justification": "Structural end node maps to the explicit termination phrase within the payment reminder clause."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->c5"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Condition modeled as action, followed by branch and guard for the <3 threshold, all align with the source."
    },
    {
      "refs": [
        "guard:b4->c6",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Guard captures the =3 threshold, action matches informing the lawyer, and end node marks process completion."
    }
  ],
