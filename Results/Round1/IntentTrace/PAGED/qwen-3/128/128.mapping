{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "The opening clause explicitly marks the process start and describes the initial rental return action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process. However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "The conditional phrasing introduces the decision point regarding how items were returned, establishing the XOR branch."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "\"Customer returns the items to the store\""
      ],
      "justification": "Exact condition value for the positive delivery branch."
    },
    {
      "refs": [
        "guard:b1->n16"
      ],
      "verbatim_texts": [
        "\"Delivery Crew picks-up items at the event site\""
      ],
      "justification": "Exact condition value for the alternative delivery branch."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Directly describes the inventory counting and verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Establishes the order status evaluation and routes to three distinct outcomes."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "\"Order is complete and all items were returned\""
      ],
      "justification": "Condition for the fully complete order path."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "\"Order is incomplete and items are missing\""
      ],
      "justification": "Condition for the missing items path."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "\"Order is complete but items are damaged\""
      ],
      "justification": "Condition for the damaged items path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Faithfully restates the notification step for damaged items."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Directly matches the inventory removal instruction for damaged goods."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Matches the customer notification step for missing items."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process. However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Sets up the exclusive choice regarding customer compliance with missing item returns."
    },
    {
      "refs": [
        "guard:b3->c1"
      ],
      "verbatim_texts": [
        "\"Customer returns the missing items\""
      ],
      "justification": "Exact condition for the compliant return path."
    },
    {
      "refs": [
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "\"Customer does not return the missing items\""
      ],
      "justification": "Exact condition for the non-compliant path."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After this,"
      ],
      "justification": "Signals the rejoining of previously split flows before the next process phase."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Introduces the repair outcome decision point."
    },
    {
      "refs": [
        "guard:b4->n10"
      ],
      "verbatim_texts": [
        "\"Items are repaired and added into inventory\""
      ],
      "justification": "Exact condition for successful repair path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "\"Items are repaired and added into inventory\""
      ],
      "justification": "Models the condition as an action step; content faithfully restates the source."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "\"Items can't be repaired and are discarded\""
      ],
      "justification": "Models the discard condition as an action step; matches source text."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "we email the customer with replacement charges"
      ],
      "justification": "Directly corresponds to the notification action for unrepairable items."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order. If the \"Items are packed for an existing order,\" we continue the process. If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Establishes the final routing decision for processed items."
    },
    {
      "refs": [
        "guard:b5->n14"
      ],
      "verbatim_texts": [
        "\"Items are packed for an existing order\""
      ],
      "justification": "Exact condition for immediate packing route."
    },
    {
      "refs": [
        "guard:b5->n18"
      ],
      "verbatim_texts": [
        "\"Items are stored for future orders\""
      ],
      "justification": "Exact condition for warehouse storage route."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges, and the process is complete."
      ],
      "justification": "Matches the final customer notification step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends.",
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Explicit closing statements that justify both the terminal action and the structural end node."
    }
  ],
