{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "The opening clause initiates the process and describes the first two steps."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request."
      ],
      "justification": "The conditional clause implies the XOR branch, the guard captures the condition, and the action captures the resulting step."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "The guard captures the alternative condition, and the action matches the corresponding task."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Describes the termination of the first path after registration."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Checking approval status implies the second XOR decision branch."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Guard matches the approval condition, action matches the notification step."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Guard matches the rejection condition, action matches the notification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Direct mapping of the post-approval registration step."
    },
    {
      "refs": [
        "action:n10",
        "action:n12"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Maps to the final termination step. Multiple redundant end nodes are acceptable and fully covered by this concluding phrase."
    }
  ],
