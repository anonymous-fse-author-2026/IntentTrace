init(i1)
action(n1, "start the process for ACME")
action(n2, "begin New Resupply Cycle")
action(n3, "Check Levels of Inventory")
action(n4, "Is inventory below or equal to minimum")
branch(b1, XOR)
action(n5, "generate Equal to or below minimum Report")
action(n6, "generate Above Minimum Report")
action(n7, "Does report indicate inventory equal or below minimum")
branch(b2, XOR)
action(n8, "create Purchase Orders POs")
action(n9, "process ends")
end(e1)
action(n10, "Is PO rejected")
branch(b3, XOR)
action(n11, "rework PO")
action(n12, "Is PO approved")
branch(b4, XOR)
action(n13, "print and release PO in system")
action(n14, "handle disapproval")
action(n17, "PO needs to be reviewed")
branch(b_sync, AND)
action(n20, "reserve funds for released POs")
action(n21, "Mail POs to supplier")
converge(c1)
action(n22, "Receive Packing Slip")
action(n23, "Receive Inventory")
action(n24, "Receive Invoice")
action(n25, "Proceed to Three way match")
branch(b_match, XOR)
action(n26, "Release funds")
action(n27, "Handle mismatch")
action(n28, "Issue payment")
action(n29, "Resupply Cycle is complete process ends")
end(e2)
converge(c_loop)
converge(c_end_path)
defines(v1, "Is inventory below or equal to minimum", {"BelowOrEqual", "Above"})
defines(v2, "Does report indicate inventory equal or below minimum", {"Yes", "No"})
defines(v3, "PO status", {"Reject", "Approve"})
defines(v4, "Approval status", {"Approved", "NotApproved"})
defines(v5, "Match result", {"Successful", "Failed"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, n6, n7, b2, n8, n9, e1, n10, b3, n11, n12, b4, n13, n14, n17, b_sync, n20, n21, c1, n22, n23, n24, n25, b_match, n26, n27, n28, n29, e2, c_loop, c_end_path])
precedence(i1, n1)
