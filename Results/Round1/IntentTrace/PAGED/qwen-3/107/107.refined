init(i1)
action(n1, "start parts provision process")
action(n2, "request authorisation for extra Parts")
action(n3, "authorisation given")
branch(b1, XOR)
action(n4, "obtain requested Parts from stock")
action(n5, "stop work and wait for parts")
action(n6, "have parts arrived")
branch(b2, XOR)
action(n7, "resume work")
action(n8, "end process")
end(e1)
converge(c1)
converge(c_w)
defines(v1, "authorisation given", {"Yes", "No"})
defines(v2, "have parts arrived", {"No", "Yes"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, n6, b2, n7, n8, e1, c1, c_w])
precedence(i1, n1)
precedence(n3, b1)
precedence(n6, b2)
precedence(n8, e1)
precedence(c1, n8)
precedence(n1, n2)
precedence(n2, n3)
precedence(b1, n4)
precedence(b1, c_w)
precedence(b2, c_w)
precedence(c_w, n5)
precedence(n5, n6)
precedence(b2, n7)
precedence(n4, c1)
precedence(n7, c1)
guard(b1, n4, v1 = 'Yes')
guard(b1, c_w, v1 = 'No')
guard(b2, c_w, v2 = 'No')
guard(b2, n7, v2 = 'Yes')