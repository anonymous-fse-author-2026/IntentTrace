{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start with Password Verification"
      ],
      "justification": "Opening clause implicitly starts the process and explicitly names the first two actions."
    },
    {
      "refs": [
        "action:nv"
      ],
      "verbatim_texts": [
        "followed by Verifiy Password."
      ],
      "justification": "Direct match for the verification step; minor source typo does not affect alignment."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If you choose \"Select Cancel\", you will be directed to iforgot.apple.com. However, if you select \"Reset password\", you will be automatically directed to iforgot.apple.com. In case you choose \"Retry\", you will need to re-enter your password."
      ],
      "justification": "The three conditional clauses establish the XOR decision point and are captured collectively in the condition-action node."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If you choose \"Select Cancel\", you will be directed to iforgot.apple.com."
      ],
      "justification": "Guard captures the selection condition; action captures the resulting navigation."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if you select \"Reset password\", you will be automatically directed to iforgot.apple.com."
      ],
      "justification": "Guard captures the selection condition; action captures the resulting navigation."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "In case you choose \"Retry\", you will need to re-enter your password."
      ],
      "justification": "Guard captures the retry condition; action captures the re-entry step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If you need to re-enter your password, do so and then verify it."
      ],
      "justification": "Covers the verification step following password re-entry."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed with Reset Password."
      ],
      "justification": "Direct match for the password reset action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the password is reset, you can return to the iTunes purchases page."
      ],
      "justification": "Implies parallel/branch paths merging back to the main flow before the return action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "From there, select the price of the item."
      ],
      "justification": "Direct match for the pricing selection step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If prompted to \"Enter Password\", verify the password. Alternatively, if asked to \"Enter Apple ID\", enter the password."
      ],
      "justification": "The two alternative prompts establish the second XOR decision point and are captured in the condition node."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If prompted to \"Enter Password\", verify the password."
      ],
      "justification": "Guard captures the prompt condition; action faithfully restates the verification step."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "if asked to \"Enter Apple ID\", enter the password."
      ],
      "justification": "Guard captures the prompt condition; action faithfully restates the password entry step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, enter the password and verify it."
      ],
      "justification": "Final step implies convergence of the second branch's paths and marks process completion."
    }
