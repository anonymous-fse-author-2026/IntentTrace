  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start with Password Verification"
    },
    {
      "id": "i2",
      "content": "followed by Verifiy Password."
    },
    {
      "id": "i3",
      "content": "If you choose \"Select Cancel\", you will be directed to iforgot.apple.com. However, if you select \"Reset password\", you will be automatically directed to iforgot.apple.com. In case you choose \"Retry\", you will need to re-enter your password."
    },
    {
      "id": "i4",
      "content": "If you choose \"Select Cancel\", you will be directed to iforgot.apple.com."
    },
    {
      "id": "i5",
      "content": "if you select \"Reset password\", you will be automatically directed to iforgot.apple.com."
    },
    {
      "id": "i6",
      "content": "In case you choose \"Retry\", you will need to re-enter your password."
    },
    {
      "id": "i7",
      "content": "proceed with Reset Password."
    },
    {
      "id": "i8",
      "content": "If you need to re-enter your password, do so and then verify it."
    },
    {
      "id": "i9",
      "content": "Once the password is reset, you can return to the iTunes purchases page."
    },
    {
      "id": "i10",
      "content": "From there, select the price of the item."
    },
    {
      "id": "i11",
      "content": "If prompted to \"Enter Password\", verify the password. Alternatively, if asked to \"Enter Apple ID\", enter the password."
    },
    {
      "id": "i12",
      "content": "If prompted to \"Enter Password\", verify the password."
    },
    {
      "id": "i13",
      "content": "if asked to \"Enter Apple ID\", enter the password."
    },
    {
      "id": "i14",
      "content": "Finally, enter the password and verify it."
    }
  ]
