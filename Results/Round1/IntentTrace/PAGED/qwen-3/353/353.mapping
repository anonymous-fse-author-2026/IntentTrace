{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "guard:b1->n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "To start the process, begin by checking if the order has been received."
      ],
      "justification": "Initializes the process, describes the first verification step, and establishes the initial decision point with its routing guards."
    },
    {
      "refs": [
        "action:n3",
        "action:n5",
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If the sum of the order is less than 500, then continue with the process."
      ],
      "justification": "Covers the first threshold check, the decision split, the affirmative continuation action, and its routing guard."
    },
    {
      "refs": [
        "action:n4",
        "action:n6",
        "guard:b3->n6",
        "guard:b3->n7"
      ],
      "verbatim_texts": [
        "However, if the sum of the order is greater than 2000, compute a discount of 4%."
      ],
      "justification": "Maps the >2000 condition, the discount calculation, and the guards routing to subsequent steps."
    },
    {
      "refs": [
        "action:n7",
        "action:n8",
        "guard:b4->n8",
        "guard:b4->n9"
      ],
      "verbatim_texts": [
        "If the sum of the order falls between 1000 and 1500, compute a discount of 3%."
      ],
      "justification": "Matches the 1000-1500 range condition, discount action, and associated guards."
    },
    {
      "refs": [
        "action:n9",
        "action:n10",
        "guard:b5->n10",
        "guard:b5->c1"
      ],
      "verbatim_texts": [
        "Similarly, if the sum of the order falls between 500 and 999, compute a discount of 2%."
      ],
      "justification": "Maps the 500-999 range condition, discount action, and guards including the merge path."
    },
    {
      "refs": [
        "action:n11",
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "After checking the sum of the order, if it is still less than 500, continue with the process."
      ],
      "justification": "Corresponds to the repeated continuation step and its associated routing guard."
    },
    {
      "refs": [
        "action:n12",
        "action:n13",
        "guard:b6->n13",
        "guard:b6->n14"
      ],
      "verbatim_texts": [
        "If the sum of the order is greater than 2000, compute a discount of 4%."
      ],
      "justification": "Repeats the >2000 condition, discount computation, and its routing guards."
    },
    {
      "refs": [
        "action:n14",
        "action:n15",
        "guard:b7->n15",
        "guard:b7->n16"
      ],
      "verbatim_texts": [
        "If it is less than 500, continue with the process."
      ],
      "justification": "Repeats the <500 condition, continuation action, and guards."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "guard:b8->n17",
        "guard:b8->n18"
      ],
      "verbatim_texts": [
        "If the sum of the order falls between 1000 and 1500, compute a discount of 3%."
      ],
      "justification": "Repeats the 1000-1500 range condition and discount action with guards."
    },
    {
      "refs": [
        "action:n18",
        "action:n19",
        "guard:b9->n19",
        "guard:b9->c1"
      ],
      "verbatim_texts": [
        "Likewise, if the sum of the order falls between 500 and 999, compute a discount of 2%."
      ],
      "justification": "Repeats the 500-999 range condition, discount action, and guards converging back."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Finally, create the bill and the process will come to an end."
      ],
      "justification": "Describes the final billing action, explicit process end statement, and the terminal node."
    }
  ],
