{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial two actions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed with the Registration gross pathology request."
      ],
      "justification": "Direct paraphrase of the registration step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "During the \"Registration gross pathology request\" step, make sure to create a barcode scan at the start."
      ],
      "justification": "Captures the instruction to create a barcode scan at the beginning of registration."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the registration is complete, assign a container to the gross pathology request."
      ],
      "justification": "Direct match for the container assignment step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After assigning a container, move on to the Specimen description."
      ],
      "justification": "Direct match for transitioning to the specimen description step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "For the \"Specimen description\" step, pay attention to the scan start."
      ],
      "justification": "Direct match for the scan start action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Then, pay attention to the scan end."
      ],
      "justification": "Direct match for the scan end action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Finally, pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Direct match for the subsequent registration scan start."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Following that, proceed with Macroscopic description writing."
      ],
      "justification": "Direct match for the macroscopic description step."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Tissue processing, check if \"Digitalization?\" is required."
      ],
      "justification": "\"Simultaneously\" triggers the AND gateway branch, which spawns the tissue processing action and the digitalization check action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process. If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Captures the conditional logic and the positive branch action."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Next, check if \"Digitalization?\" is required again. If the answer is \"no,\" continue the process. If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Covers the second digitalization check and its corresponding positive action."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "After that, assign cases to the pathologist and then move on to Microscopic examination and diagnosis."
      ],
      "justification": "\"After that\" signals the convergence of prior parallel/branching flows, followed immediately by the case assignment and examination steps."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Once the microscopic examination and diagnosis are complete, write the pathology report."
      ],
      "justification": "Direct match for report writing."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "After writing the report, confirm it."
      ],
      "justification": "Direct match for report confirmation."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once the pathology report is confirmed, deliver it."
      ],
      "justification": "Direct match for delivering the report."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Then, proceed with the post-report processing."
      ],
      "justification": "Direct match for post-report processing."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "To conclude the pathology procedure, close it."
      ],
      "justification": "Direct match for closing the procedure."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Finally, deliver the pathology report and complete the post-report processing."
      ],
      "justification": "Captures the final delivery/processing action and implicitly marks the process end."
    }
  ],
