{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by"
      ],
      "justification": "Implicit start node and initialization action align with the opening clause."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check the customer"
      ],
      "justification": "Direct correspondence to the initial eligibility verification step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Branch introduces the decision, guard captures the negative condition, and action matches the notification step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Guard reflects the eligible path condition, action exactly restates the ERP order creation."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Action covers the termination flow for ineligible customers, culminating at the end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "perform an availability check."
      ],
      "justification": "Direct match for the product availability verification."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\". If it is not, start producing the missing parts."
      ],
      "justification": "Branch sets up the check, guard captures the unavailability condition, and action matches the production trigger."
    },
    {
      "refs": [
        "guard:b2->c1",
        "action:n8"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process."
      ],
      "justification": "Guard handles the available/positive case leading to flow convergence and continuation."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Exact textual alignment for the preparation step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "AND gateway correctly models simultaneous execution; three actions map precisely to shipping, invoicing, and payment checking."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Branch splits on payment outcome; guard and action faithfully capture the successful receipt path."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Guard and action accurately represent the handling of unpaid invoices."
    },
    {
      "refs": [
        "action:n16",
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Action and branch establish the reminder counter check; guard and action correctly handle the <3 scenario."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Guard captures the =3 threshold, action matches legal escalation, and end node marks definitive termination."
    }
  ],
