  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process for WIGGO, start by placing an Order"
    },
    {
      "id": "i2",
      "content": "proceed to Check the Customer's Credit Limit."
    },
    {
      "id": "i3",
      "content": "If the response is \"Okay\", proceed to Check the Availability of the Article. However, if the response is \"No\", send a Denial to the Customer."
    },
    {
      "id": "i4",
      "content": "If the response is \"Okay\""
    },
    {
      "id": "i5",
      "content": "Check the Availability of the Article"
    },
    {
      "id": "i6",
      "content": "if the response is \"No\""
    },
    {
      "id": "i7",
      "content": "\"No\""
    },
    {
      "id": "i8",
      "content": "send a Denial to the Customer."
    },
    {
      "id": "i9",
      "content": "If the response is \"No\", send a Denial to the Customer."
    },
    {
      "id": "i10",
      "content": "If the Article is not available, proceed to Produce the Goods."
    },
    {
      "id": "i11",
      "content": "if the Article is available, proceed to Collect the Goods."
    },
    {
      "id": "i12",
      "content": "send an Order Confirmation."
    },
    {
      "id": "i13",
      "content": "Simultaneously"
    },
    {
      "id": "i14",
      "content": "Ship the Goods and Send the Invoice."
    },
    {
      "id": "i15",
      "content": "Check the Payment status."
    },
    {
      "id": "i16",
      "content": "If the payment has been received, close the Order and end the process. If the payment has not been received, check if the Reminder count is greater than or equal to 3."
    },
    {
      "id": "i17",
      "content": "If the payment has been received"
    },
    {
      "id": "i18",
      "content": "close the Order and end the process."
    },
    {
      "id": "i19",
      "content": "If the payment has not been received"
    },
    {
      "id": "i20",
      "content": "check if the Reminder count is greater than or equal to 3."
    },
    {
      "id": "i21",
      "content": "If the Reminder count is greater than or equal to 3, Write off the Order."
    },
    {
      "id": "i22",
      "content": "Additionally, send a Reminder."
    },
    {
      "id": "i23",
      "content": "After writing off the Order, close the Order and end the process."
    }
  ]
