{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "The opening clause implicitly triggers the start event and describes the initial placement action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed to Check the Customer's Credit Limit."
      ],
      "justification": "Direct mapping to the credit limit verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article. However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "The conditional evaluation is modeled as an action step leading into an XOR branch, capturing the decision point implied by the text."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\""
      ],
      "justification": "Guard captures the positive credit limit response condition."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the response is \"No\""
      ],
      "justification": "Guard captures the negative credit limit response condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Check the Availability of the Article"
      ],
      "justification": "Faithfully restates the article availability check step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "send a Denial to the Customer."
      ],
      "justification": "Matches the denial action on the negative credit path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Second conditional block opens a new XOR branch and executes the corresponding denial action."
    },
    {
      "refs": [
        "action:n10",
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Maps the unavailability condition guard directly to the production action."
    },
    {
      "refs": [
        "action:n11",
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Maps the availability condition guard directly to the collection action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "send an Order Confirmation."
      ],
      "justification": "Direct match to the confirmation step."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Temporal keyword explicitly signals parallel execution, matched to the AND gateway."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Ship the Goods and Send the Invoice."
      ],
      "justification": "Both concurrent tasks are captured faithfully."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Direct match to the payment verification step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process. If the payment has not been received, check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Models the payment check condition and splits into two distinct branches."
    },
    {
      "refs": [
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "If the payment has been received"
      ],
      "justification": "Positive payment guard accurately reflects the source condition."
    },
    {
      "refs": [
        "guard:b4->n19"
      ],
      "verbatim_texts": [
        "If the payment has not been received"
      ],
      "justification": "Negative payment guard accurately reflects the source condition."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "close the Order and end the process."
      ],
      "justification": "Covers the closure action and the explicit termination of the happy path."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Models the reminder threshold evaluation as an action feeding a branch."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Guards and action correctly capture the write-off trigger and task."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Captures the alternative path (count < 3) where a reminder is sent instead."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Correctly sequences the post-writeoff closure and process termination."
    }
  ],
  "mutations": [
