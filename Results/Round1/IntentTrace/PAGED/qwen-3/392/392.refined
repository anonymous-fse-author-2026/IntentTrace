init(i1)
action(n1, "Start User Task")
branch(b_start, XOR)
action(n3, "Continue Process after Service Task 1")
action(n4, "Is User Task Service Task 2?")
action(n5, "Continue Process after Service Task 2")
action(n6, "End Process due to Service Task 3")
action(n8, "Is there a Manual Task?")
action(n9, "End Process if Manual Task Yes")
converge(c_merge)
end(e_end)
defines(v1, "Is User Task Service Task 1?", {"Yes", "No"})
defines(v2, "Is User Task Service Task 2?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, b_start, n3, n4, n5, n6, n8, n9, c_merge, e_end])
precedence(i1, n1)
precedence(n1, b_start)
precedence(b_start, n3)
precedence(b_start, n4)
precedence(b_start, n6)
precedence(n3, c_merge)
precedence(n4, n5)
precedence(n5, c_merge)
precedence(c_merge, n8)
precedence(n6, e_end)
precedence(n8, n9)
precedence(n9, e_end)
guard(b_start, n3, "v1 = 'Yes'")
guard(b_start, n4, "v1 = 'No' and v2 = 'Yes'")
guard(b_start, n6, "v1 = 'No' and v2 = 'No'")