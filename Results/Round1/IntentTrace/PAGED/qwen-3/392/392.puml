@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start User Task;
:v1: Is User Task Service Task 1? ({Yes, No})
v2: Is User Task Service Task 2? ({Yes, No}); <<objectSignal>>
switch ()
case (["v1 = 'Yes'"])
:Continue Process after Service Task 1;
:Is there a Manual Task?;
:End Process if Manual Task Yes;
case (["v1 = 'No' and v2 = 'Yes'"])
:Is User Task Service Task 2?;
:Continue Process after Service Task 2;
case (["v1 = 'No' and v2 = 'No'"])
:End Process due to Service Task 3;
endswitch
stop
@enduml