@startuml
!theme plain
|a_default| Default
|a_default|
start
:start process;
:Orders Required;
:place Bulk order;
:v1: Order with prior internal credit allowance ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Order with prior internal credit allowance;
:process order for delivery;
:record in Accounts Receivable;
:Payments Received;
:v2: Payments Received ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:continue process;
else ([v2 = 'No'])
:drop order;
:end process;
endif
:identify order for installation;
:installation required;
:v3: installation required ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:assign Installer;
:end process;
stop
else ([v3 = 'No'])
:pack for delivery;
:end process;
stop
endif
else ([v1 = 'No'])
:Outstanding Balance;
:place new order;
stop
endif
@enduml