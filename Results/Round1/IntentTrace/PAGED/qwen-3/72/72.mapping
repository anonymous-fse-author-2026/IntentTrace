{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Implicit process initialization followed by exact extraction of the first sequential actions."
    },
    {
      "refs": [
        "guard:b1->n4",
        "guard:b1->n6",
        "action:n4",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned. However, if the invoice is complete, the process continues."
      ],
      "justification": "Captures the completeness decision point, both outcome guards, and the corresponding return or continuation actions."
    },
    {
      "refs": [
        "guard:b2->n8",
        "guard:b2->n12",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted. On the other hand, if the invoice is compliant, the process continues. If the issue can be resolved with a phone call, non-compliance is resolved. But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Maps the compliance decision, resolution methods, and associated guards/actions. Core meanings and conditional outcomes are preserved."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Direct extraction of the parallel billing step."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Accurately models the waiting period condition and its corresponding action."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Represents the implicit positive path and exact extraction of the payment/notification step."
    },
    {
      "refs": [
        "guard:b4->n16",
        "guard:b4->n17",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved. However, if the client is satisfied, the process continues."
      ],
      "justification": "Precisely models the client satisfaction check, both outcome guards, and their respective resolution or continuation actions."
    }
  ],
