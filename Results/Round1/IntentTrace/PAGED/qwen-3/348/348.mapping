      "justification": "Direct match to the sequential receiving step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete",
        "if the invoice is complete"
      ],
      "justification": "The action models the completeness verification as a discrete step, while the branch captures the implicit decision point."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "The guard represents the negative condition ('No'/'incomplete') and the action matches the return instruction."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "The guard reflects the positive condition ('Yes'/'complete'), and the action serves as the bridge to subsequent compliance checking."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant",
        "if the invoice is compliant"
      ],
      "justification": "XOR branch splits the flow based on the compliance status described in the text."
    },
    {
      "refs": [
        "guard:b2->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Exact wording alignment for the non-compliant guard condition and the corresponding action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "The compliant guard route feeds directly into the convergence node where split paths rejoin."
    },
    {
      "refs": [
        "branch:b7"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call",
        "if the issue requires mail back"
      ],
      "justification": "Branch captures the exclusive choice between phone and mail resolution methods."
    },
    {
      "refs": [
        "guard:b7->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Guard value 'Phone' and action content faithfully restate the source clause."
    },
    {
      "refs": [
        "guard:b7->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Guard value 'Mail' and return action align precisely with the source."
    },
    {
      "refs": [
        "action:n10",
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Covers both the payment execution and the subsequent resolution of compliance issues upon return."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Explicitly named action backed by the concurrency marker and direct naming."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Models the waiting period triggered by the lack-of-response condition."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Direct correspondence to the client notification step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Action matches the reminder dispatch, and the end node aligns with the explicit termination statement."
    },
    {
      "refs": [
        "action:n18"
      ],
