{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start"
      ],
      "justification": "The opening phrase initiates the process and corresponds to the start action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If there is no fee"
      ],
      "justification": "The conditional premise sets up the decision point and the associated checking step."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "is no fee"
      ],
      "justification": "Captures the negative condition on the first branch arm."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "is a fee"
      ],
      "justification": "Captures the positive condition on the second branch arm."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to register a post-seminar request"
      ],
      "justification": "Direct paraphrase of the action taken when no fee applies."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "you need to create a purchase request"
      ],
      "justification": "Direct match for the action required when a fee exists."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Describes both the verification step and the implicit exclusive choice that follows."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "is approved"
      ],
      "justification": "Extracts the operator and value for the positive approval path."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "is rejected"
      ],
      "justification": "Extracts the operator and value for the negative rejection path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "you will receive an approved notification"
      ],
      "justification": "Faithfully restates the outcome of the approved path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "you will be notified of the rejection"
      ],
      "justification": "Faithfully restates the outcome of the rejected path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "you should then register a post-seminar request"
      ],
      "justification": "Matches the follow-up action triggered by an approved notification."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Explicitly signals termination following the initial registration path."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Explicitly signals termination following the rejection path."
    }
  ],
