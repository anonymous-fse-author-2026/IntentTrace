{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME Company, we first trigger the Resupply Cycle."
      ],
      "justification": "Opening clause signals process initialization and describes the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, we check the inventory level."
      ],
      "justification": "Directly describes the inventory check step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once the inventory level is checked, we proceed to create a purchase order."
      ],
      "justification": "Describes the sequential creation of the purchase order."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the purchase order is not good, we reject it."
      ],
      "justification": "Conditional establishes the XOR branch; guard captures the negative condition ('No'/'not good'); action captures the rejection."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the purchase order is good, we approve it."
      ],
      "justification": "Guard captures the positive condition ('Yes'/'good'); action captures the approval step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "In case the purchase order is rejected, we rework it."
      ],
      "justification": "Directly maps to the rework step on the negative path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, we review it again."
      ],
      "justification": "Directly maps to the subsequent review step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase order is approved, we reserve funds for the purchase."
      ],
      "justification": "Directly maps to the fund reservation step on the positive path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, we send the purchase order to the supplier."
      ],
      "justification": "Parallel conditional paths rejoin at converge:c2 before proceeding to send the PO."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, we complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Timing word triggers AND split; lists the two concurrent receiving actions."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After receiving the packing slip, we record it."
      ],
      "justification": "Maps to the recording action for the packing slip."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Similarly, after receiving the invoice, we record it as well."
      ],
      "justification": "Maps to the recording action for the invoice."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Next, we release funds for payment and issue the payment."
      ],
      "justification": "Parallel recording paths rejoin at converge:c1 before executing the final financial steps."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued."
      ],
      "justification": "Closing action and explicit termination signal match the final sentence."
    }
  ],
