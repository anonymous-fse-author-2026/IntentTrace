  "input_elements": [
    {
      "id": "i1",
      "content": "For developers practicing BPMN execution TDD, the first step is to understand the BPMN Model."
    },
    {
      "id": "i2",
      "content": "After that, they should write a failing test."
    },
    {
      "id": "i3",
      "content": "To make the test pass, they need to extend BPMN/mocks."
    },
    {
      "id": "i4",
      "content": "Once the test is green"
    },
    {
      "id": "i5",
      "content": "they should check if the level satisfies the project requirements."
    },
    {
      "id": "i6",
      "content": "If it does, the process ends."
    },
    {
      "id": "i7",
      "content": "If not, they should continue the process."
    },
    {
      "id": "i8",
      "content": "If the test is not green"
    },
    {
      "id": "i9",
      "content": "they should upgrade the test level."
    },
    {
      "id": "i10",
      "content": "they need to check if the level satisfies the project requirements again."
    },
    {
      "id": "i11",
      "content": "If not, they should upgrade the test level once more."
    }
  ]
}