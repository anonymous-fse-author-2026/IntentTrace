{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For TS recruitment"
      ],
      "justification": "Implicitly starts the process and defines the recruitment domain."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "the first step is to advise unsuccessful candidates."
      ],
      "justification": "Direct mapping of the initial action."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\", then the position should be re-advertised."
      ],
      "justification": "Captures the condition, decision split, positive guard, and resulting action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the terms and conditions of the offer for a candidate need to be sorted out"
      ],
      "justification": "Negative guard route opens the subsequent conditional branch and check."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "it is necessary to check if the candidate has accepted a voluntary redundancy."
      ],
      "justification": "Routes to the next conditional check regarding voluntary redundancy."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the candidate has accepted, further investigation is required."
      ],
      "justification": "Positive guard and action for the acceptance path."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the candidate has not accepted, the process continues."
      ],
      "justification": "Negative guard and action for the non-acceptance path."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "Otherwise, the process continues."
      ],
      "justification": "Paraphrased continuation when T&C do not require sorting."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "which is then received by the next level manager."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the manager is an external resource... However, if the approver is an existing employee of the client"
      ],
      "justification": "Conditional question and XOR split for approver status."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "they may not authorize the form."
      ],
      "justification": "Negative guard route and action for external resource."
    },
    {
      "refs": [
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "the process continues."
      ],
      "justification": "Positive guard route for existing employee leads to next check."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the form is approved"
      ],
      "justification": "Conditional check following the positive employee route."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "the recruitment manager sends the form and other documentation"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "which is received by the client HR."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "justification": "Exact textual match."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "If there are any variations"
      ],
      "justification": "Conditional question and XOR split for variations."
    },
    {
      "refs": [
        "guard:b6->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "a complete business case is required."
      ],
      "justification": "Positive guard and action for variations path."
    },
    {
      "refs": [
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "Otherwise, the process continues."
      ],
      "justification": "Negative guard and action for no-variations path."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "The Appointment Approval is carried forward."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment"
      ],
      "justification": "Conditional question and XOR split for medical assessment."
    },
    {
      "refs": [
        "guard:b7->n27",
        "action:n27"
      ],
      "verbatim_texts": [
        "it is applicable for a 12% rate."
      ],
      "justification": "Positive guard and action; '12 percent' is a valid paraphrase of '12%'."
    },
    {
      "refs": [
        "guard:b7->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "Otherwise, a medical assessment is not necessary."
      ],
      "justification": "Negative guard and action for non-required path."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "it can take up to 21 days to arrange and complete."
      ],
      "justification": "Direct match regarding timeline."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "The TS HR coordinator informs the recruitment manager"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "who then liaises with the HR representative to confirm the offer to the candidate."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory... However, if the assessment is fine"
      ],
      "justification": "Conditional question and XOR split for assessment results."
    },
    {
      "refs": [
        "guard:b8->n33",
        "action:n33"
      ],
      "verbatim_texts": [
        "the next candidate on the shortlist should be contacted."
      ],
      "justification": "Negative guard route and action for unsatisfactory assessment."
    },
    {
      "refs": [
        "guard:b8->n35"
      ],
      "verbatim_texts": [
        "the process continues."
      ],
      "justification": "Positive guard route for satisfactory assessment."
    },
    {
      "refs": [
        "action:n35"
      ],
      "verbatim_texts": [
        "The recruitment manager makes a formal verbal offer of employment to the candidate."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n36"
      ],
      "verbatim_texts": [
        "If the candidate accepts... If the candidate declines"
      ],
      "justification": "Conditional question and XOR split for candidate response."
    },
    {
      "refs": [
        "guard:b9->n37",
        "action:n37"
      ],
      "verbatim_texts": [
        "the recruitment manager creates a formal written offer."
      ],
      "justification": "Positive guard and action for acceptance."
    },
    {
      "refs": [
        "guard:b9->n38",
        "action:n38"
      ],
      "verbatim_texts": [
        "If the candidate declines, the process continues."
      ],
      "justification": "Negative guard and action for decline."
    },
    {
      "refs": [
        "action:n39"
      ],
      "verbatim_texts": [
        "Simultaneously, the commencement pack and letter of appointment are sent to the candidate."
      ],
      "justification": "Direct match including concurrency marker."
    },
    {
      "refs": [
        "action:n40"
      ],
      "verbatim_texts": [
        "Once the candidate receives these documents"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n41"
      ],
      "verbatim_texts": [
        "if there is a \"40%\" rate"
      ],
      "justification": "Conditional question and XOR split for rate."
    },
    {
      "refs": [
        "guard:b10->n42",
        "action:n42"
      ],
      "verbatim_texts": [
        "renegotiation is required."
      ],
      "justification": "Positive guard and action for 40% rate path."
    },
    {
      "refs": [
        "guard:b10->n47"
      ],
      "verbatim_texts": [
        "Otherwise, if the candidate accepts, the process continues."
      ],
      "justification": "Negative guard route; content models process termination per redundancy rules."
    },
    {
      "refs": [
        "action:n43"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful... However, if the renegotiation is unsuccessful"
      ],
      "justification": "Conditional question and XOR split for renegotiation outcome."
    },
    {
      "refs": [
        "guard:b11->n44",
        "action:n44"
      ],
      "verbatim_texts": [
        "the next candidate on the shortlist should be identified."
      ],
      "justification": "Negative guard and action for unsuccessful renegotiation."
    },
    {
      "refs": [
        "guard:b11->n46"
      ],
      "verbatim_texts": [
        "the process continues."
      ],
      "justification": "Positive guard route; content models process termination per redundancy rules."
    },
    {
      "refs": [
        "action:n5",
        "action:n15",
        "action:n34",
        "action:n45",
        "action:n46",
        "action:n47"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Multiple redundant end nodes and actions faithfully restate the closing sentence."
    }
  ],
