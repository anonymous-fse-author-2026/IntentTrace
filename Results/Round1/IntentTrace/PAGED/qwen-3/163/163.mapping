      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "The opening clause implicitly starts the process and directly specifies the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed to the IN-Patient step."
      ],
      "justification": "Direct copy of the target step description following metadata entry."
    },
    {
      "refs": [
        "guard:b1->n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps:"
      ],
      "justification": "This phrasing signals a split in the workflow, justifying the branch node and its outgoing routing guards."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "send data to suppliers and create a claim."
      ],
      "justification": "Exact match for the action on the supplier/claim path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "extract the data from the suppliers and transfer it to the doctor's phone."
      ],
      "justification": "Directly restates the extraction and transfer step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "confirm the GOP and the process will come to an end."
      ],
      "justification": "The clause describes the confirmation action and explicitly signals process termination."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "register the case and handle the claim."
      ],
      "justification": "Exact match for the case registration and handling step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Create a claim and handle the claim accordingly."
      ],
      "justification": "Direct copy of the claim creation and handling instruction."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status."
      ],
      "justification": "Exact match including the alternative conditional outcome for record/status."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Register the case, handle the claim, and then receive the payment."
      ],
      "justification": "Directly matches the sequence of case handling and payment receipt."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Enter the data on the patient's record or confirm the IN-Patient status, and then send the data back to the suppliers."
      ],
      "justification": "Exact match for the record update/confirmation and return transmission step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "receive the payment and conclude the process."
      ],
      "justification": "Directly matches the final payment and conclusion step."
    }
