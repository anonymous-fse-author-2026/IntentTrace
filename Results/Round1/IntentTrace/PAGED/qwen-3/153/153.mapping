{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "The opening clause implicitly starts the process and describes the first two sequential actions."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty, if not, continue the process."
      ],
      "justification": "Describes the check action, the XOR branch, the negative guard condition ('if not'), and the resulting continuation action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Maps the positive guard condition, the end-process action, and the implicit termination of this path."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again, if not, continue the process."
      ],
      "justification": "Repeated check logic mirrored in the second branch, guard, and continuation action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Positive outcome for the second check, leading to the terminal action and end node."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Frames the verification step and introduces the subsequent exclusive choice."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Positive guard condition paired with the recording action."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Negative guard condition paired with the phone call action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Sequential action following the incomplete-information branch."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "The timing condition is modeled as a preliminary action step, followed by the physical transfer action."
    },
    {
      "refs": [
        "action:n16",
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Conditions the branching decision, positive guard, and the stamping/dating action."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Negative guard condition leading to the rejection notification action."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Explicit post-stamping data entry step."
    },
    {
      "refs": [
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles."
      ],
      "justification": "The word 'Simultaneously' triggers the AND split into two parallel actions."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Directly matches the instruction given after the parallel tasks."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Matches the card printing and dispatch step."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Explicit termination statement mapped to the end action and structural end node."
    },
    {
      "refs": [
        "action:n26",
        "action:n27"
      ],
      "verbatim_texts": [
        "Hand the letter to Charles and add the new member to the register."
      ],
      "justification": "Two administrative actions described in a single conjunctive clause."
    },
    {
      "refs": [
        "action:n28",
        "action:n27c"
      ],
      "verbatim_texts": [
        "Prepare an invoice for the new members and continue the process."
      ],
      "justification": "Invoice preparation followed by an explicit loop/continuation command."
    },
    {
      "refs": [
        "action:n29",
        "action:n30"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register and write the fee amount to the register."
      ],
      "justification": "Final registration steps matching the trailing sentence exactly."
    }
  ],
