{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "The opening clause implicitly starts the process and explicitly describes the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "it is sorted per client."
      ],
      "justification": "Direct paraphrase of the sorting step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor."
      ],
      "justification": "Direct paraphrase of the second sorting step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice."
      ],
      "justification": "Direct match of the attachment step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form."
      ],
      "justification": "Direct match of the data entry step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked."
      ],
      "justification": "Action describes the check; branch implicitly models the subsequent decision point."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is complete"
      ],
      "justification": "Guard captures the condition value; action restates the completed state."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Guard captures the negative condition; action represents the incomplete state; end marks the termination path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the information for the SLA is entered."
      ],
      "justification": "Direct paraphrase of the SLA data entry step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "The date for completion is also entered and the priority is checked."
      ],
      "justification": "Actions describe date entry and priority checking; branch models the ensuing priority decision."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "Guard/action capture the high-priority condition; action captures the stamping step."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Guard/action capture the low-priority condition; converge models the flow continuation/join."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Action describes the compliance check; branch models the compliance decision."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If it is not complete, the check continues."
      ],
      "justification": "Guard captures the incomplete condition; action represents this path's state/continuation note."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is complete, the process continues."
      ],
      "justification": "Guard captures the complete condition; action represents this path's state/continuation."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff",
        "If it is a normal case",
        "If none of these conditions apply"
      ],
      "justification": "Single XOR branch correctly models the three-way decision spanning these conditional clauses."
    },
    {
      "refs": [
        "guard:b4->n20",
        "action:n20",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Guard/action capture the staff-routing condition; action captures the processing step."
    },
    {
      "refs": [
        "guard:b4->n21",
        "action:n21",
        "action:n23"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Guard/action capture the normal-case condition; action captures the client call."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Guard captures the fallback condition; action captures the mailing step; end marks termination."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Converge models paths rejoining before the final sequence; action describes the call and request."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO, and the process ends."
      ],
      "justification": "Action describes batching and allocation; end marks the final process termination."
    }
  ],
