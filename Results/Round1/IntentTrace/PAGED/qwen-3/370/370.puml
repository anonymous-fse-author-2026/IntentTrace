@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the procedure;
:do you desire new hair;
:v1: do you desire new hair ({1, 2, 3, 4}); <<objectSignal>>
switch ()
case (["v1 = 1"])
:visit the hairdresser;
case (["v1 = 2"])
:do you want your hair washed;
:v2: do you want your hair washed ({true, false}); <<objectSignal>>
if () then (["v2 = true"])
:have your hair washed;
else (["v2 = false"])
->;
endif
case (["v1 = 3"])
:do you want your hair cut;
:v3: do you want your hair cut ({true, false}); <<objectSignal>>
if () then (["v3 = true"])
:have your hair cut;
else (["v3 = false"])
->;
endif
case (["v1 = 4"])
:do you want your hair dried;
:v4: do you want your hair dried ({true, false}); <<objectSignal>>
if () then (["v4 = true"])
:have your hair dried;
else (["v4 = false"])
->;
endif
endswitch
:process complete you have obtained new hair;
stop
@enduml