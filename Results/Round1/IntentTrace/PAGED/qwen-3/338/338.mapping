{
  "matches": [
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially, if the option \"research schedule directly\" is selected"
      ],
      "justification": "The opening clause establishes the start of the process, introduces the option-selection context, triggers the XOR decision, and sets the positive condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Direct match for the action on the positive branch."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Covers the negative condition and the two sequential steps it triggers."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Maps the validation step, the satisfaction check, and the implicit decision split that follows."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9",
        "guard:b2->c2",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\". If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Aligns the negative/positive guards, their corresponding actions, and the structural convergence point before ticket ordering."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11",
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\". If it is still not satisfactory, then \"provide indications\". Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Captures the redundant second satisfaction check, its branching logic, and the alternative satisfactory path routing back to convergence."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Exact match for the ticket validation step."
    },
    {
      "refs": [
        "action:n14",
        "guard:b4->n15",
        "action:n15",
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
      ],
      "justification": "Covers the first approval verification, both outcome paths (termination or re-validation), and the associated end node."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->n18",
        "action:n18",
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
      ],
      "justification": "Matches the second iterative approval check and its branching outcomes."
    },
    {
      "refs": [
        "action:n20",
        "guard:b6->n21",
        "action:n21",
        "guard:b6->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved. If it is, then the process ends. If it is not, then the process ends."
      ],
      "justification": "Corresponds to the final check where both conditions lead to termination, including the mapped end nodes."
    }
  ],
