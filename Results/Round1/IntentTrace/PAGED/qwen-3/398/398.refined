init(i1)
action(n1, "provide userdata for flickr")
branch(b1, XOR)
end(e2)
action(n3, "login fails, continue with process")
branch(b2, XOR)
action(n4, "provide userdata for flickr")
branch(b3, XOR)
action(n6, "still want to try again, please provide the userdata for flickr")
end(e6)
action(n7, "decide to abort, the process will end")
end(e7)
action(n5, "choose to abort, the process will end")
end(e5)
defines(v1, "login_successful", {"Yes", "No"})
defines(v2, "want_to_try_again", {"Yes", "No"})
defines(v3, "still_want_to_try_again", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, b1, e2, n3, b2, n4, b3, n6, e6, n7, e7, n5, e5])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, e2)
precedence(b1, n3)
precedence(n3, b2)
precedence(b2, n4)
precedence(b2, n5)
precedence(n4, b3)
precedence(b3, n6)
precedence(b3, n7)
precedence(n6, e6)
precedence(n5, e5)
precedence(n7, e7)
guard(b1, e2, v1 = 'Yes')
guard(b1, n3, v1 = 'No')
guard(b2, n4, v2 = 'Yes')
guard(b2, n5, v2 = 'No')
guard(b3, n6, v3 = 'Yes')
guard(b3, n7, v3 = 'No')