{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Covers process initiation and the initial sequential UI interactions. Redundant start elements are acceptable."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "The conditional clause justifies the XOR branch and guard threshold. The condition is also modeled as an action step, which is permitted per modeling conventions, alongside the review action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Matches the alternative branch condition and the subsequent checking step."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Captures the translation check branch, its positive guard, and the translation action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "\"If not\" in context means translation is not required, accurately matching the guard and confirm action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Paths rejoin after the translation/confirmation split before evaluating the review decision, justifying the converge and action."
    },
    {
      "refs": [
        "guard:b3->c2",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "First rejection path leading to report editing and the associated convergence point."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Approval path looping back to re-check translation needs."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Directly models the repeated evaluation step described in the text."
    },
    {
      "refs": [
        "guard:b4->c2",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Second rejection path leading to report editing, merging into the same converge point."
    },
    {
      "refs": [
        "guard:b4->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Second approval path triggering translation followed by confirmation sequentially."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Evaluation step introduces the final decision gateway."
    },
    {
      "refs": [
        "guard:b5->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Positive arm of the receipts decision leading to expense processing."
    },
    {
      "refs": [
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Negative arm of the receipts decision looping back to editing."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Structural convergence of rejection paths and explicit termination steps are all justified by the closing sentence. Redundant end nodes are permitted."
    }
  ],
