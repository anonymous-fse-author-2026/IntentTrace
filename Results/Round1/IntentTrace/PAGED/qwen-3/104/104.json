{
  "elements": [
    {
      "id": "start",
      "type": "init"
    },
    {
      "id": "i1",
      "type": "action",
      "content": "For EC-Lille: Initially, if the option \"research schedule directly\" is selected, then the action to be taken is \"Research schedule\""
    },
    {
      "id": "i2",
      "type": "action",
      "content": "If the option is not selected, then \"provide indications\" and proceed with the research schedule"
    },
    {
      "id": "i3",
      "type": "action",
      "content": "After validating the schedule, check if the schedule is satisfactory"
    },
    {
      "id": "b_sat",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i5",
      "type": "action",
      "content": "If it is, then proceed with writing a ticket order to SNCF"
    },
    {
      "id": "i4",
      "type": "action",
      "content": "If it is not, then perform the action \"Research schedule\""
    },
    {
      "id": "i6",
      "type": "action",
      "content": "If the schedule is not satisfactory, perform the action \"Research schedule\""
    },
    {
      "id": "i7",
      "type": "action",
      "content": "If it is still not satisfactory, then \"provide indications\""
    },
    {
      "id": "i8",
      "type": "action",
      "content": "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF"
    },
    {
      "id": "c_merge",
      "type": "converge"
    },
    {
      "id": "i9",
      "type": "action",
      "content": "After writing the ticket order, validate it"
    },
    {
      "id": "i10",
      "type": "action",
      "content": "Check if the ticket order is approved"
    },
    {
      "id": "b_appr",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i11",
      "type": "action",
      "content": "If it is not, then the process ends"
    },
    {
      "id": "e_no",
      "type": "end"
    },
    {
      "id": "i12",
      "type": "action",
      "content": "If it is approved, then validate the ticket order"
    },
    {
      "id": "i13",
      "type": "action",
      "content": "Check again if the ticket order is approved"
    },
    {
      "id": "i14",
      "type": "action",
      "content": "Check once more if the ticket order is approved"
    },
    {
      "id": "i15",
      "type": "action",
      "content": "If it is, then the process ends"
    },
    {
      "id": "e_yes",
      "type": "end"
    }
  ],
