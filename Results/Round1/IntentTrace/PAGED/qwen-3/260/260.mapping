    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Branch handles the routing decision, guard matches the staff referral condition, and action matches the processing step."
    },
    {
      "refs": [
