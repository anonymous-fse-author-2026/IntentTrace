    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "The date for completion is also entered"
      ],
      "justification": "Guard captures the completeness condition; action consolidates entering SLA data and the completion date."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the priority is checked"
      ],
      "justification": "Direct extraction from the compound sentence describing subsequent steps."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "Branch initiates the priority evaluation, guard matches the high condition, and action matches the stamping instruction."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Guard captures the low-priority fallback, while the converge node represents the flow rejoining for continuation."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
