    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Guard represents the fallback condition, action covers mailing and termination, and end node marks the final halt."
    },
    {
      "refs": [
        "action:n18"
      ],
