{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "The opening clause implicitly initiates the process and describes the first concrete action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000"
      ],
      "justification": "Describes the first conditional check that structurally creates an XOR branch."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "greater than 1000"
      ],
      "justification": "Extracts the comparison operator and threshold for the positive outcome path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the report should be reviewed"
      ],
      "justification": "Direct paraphrase of the action taken when the expense exceeds the threshold."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "less than or equal to 1000"
      ],
      "justification": "Extracts the condition for the alternative outcome path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to check if there is a need for translation"
      ],
      "justification": "Direct paraphrase of the step following the alternative condition."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If translation is required... If not"
      ],
      "justification": "Implies a second XOR split based on whether translation is necessary."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If translation is required"
      ],
      "justification": "Maps to the true condition for needing translation."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed to translate the receipts"
      ],
      "justification": "Direct paraphrase of the translation step."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Maps to the false/negative condition for translation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "confirm the receipts"
      ],
      "justification": "Direct paraphrase of the step when translation is not needed."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "The completion of the preceding alternative paths implies a converge node, immediately followed by the evaluation action."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "The conditional sentence introduces an XOR split and defines the guard and action for the rejection path."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Defines the guard and subsequent action for the approval path."
    },
    {
      "refs": [
        "guard:b6->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Repeated conditional introduces another XOR split and maps to the rejection guard and action."
    },
    {
      "refs": [
        "guard:b6->n15",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Approval guard leads to two sequential actions described in the same clause."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Direct paraphrase of the final evaluation step."
    },
    {
      "refs": [
        "guard:b9->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Conditional introduces the final XOR split and maps to the acceptance guard and action."
    },
    {
      "refs": [
        "guard:b9->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Maps the rejection guard and corresponding action."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Closing sentence supports both a final processing action and the structural end node."
    }
  ],
