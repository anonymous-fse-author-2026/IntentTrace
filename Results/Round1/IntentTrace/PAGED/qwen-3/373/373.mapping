{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The opening clause implicitly initiates the process and explicitly describes the first reception step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Directly maps to the claim creation and recording step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "Directly maps to the decision-making step preceding the conditional split."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "The conditional introduces the XOR branch, the guard captures the rejection condition, and the action executes the rejection."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "The guard captures the acceptance condition on the alternate branch, and the action performs the benefit offering."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Directly maps to the review step taken on the rejection path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Directly maps to the discharge preparation step on the acceptance path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Temporal phrasing correctly sequences the recording step after discharge preparation."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process.",
        "But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Both divergent outcomes from the sub-decision converge on the identical continuation step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "The closing statement explicitly terminates the workflow, supporting both the terminal action and the structural end node."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "The concurrency marker 'At the same time' correctly triggers an AND gateway splitting into the two specified parallel steps."
    }
  ],
