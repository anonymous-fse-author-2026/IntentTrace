{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "The implicit start node and explicit start action align directly with the opening phrase."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Rental Items are Returned to the Store."
      ],
      "justification": "Captures the initial item-handling step before the first conditional split."
    },
    {
      "refs": [
        "guard:b1->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process."
      ],
      "justification": "XOR branch, condition guard, and continuation action map directly to this clause."
    },
    {
      "refs": [
        "guard:b1->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Alternative guard and action match the pickup clause; convergence is implied by both paths continuing forward."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Both actions capture the counting step and the resulting order status evaluation."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process."
      ],
      "justification": "Branch and positive arm match the complete-order condition and its continuation."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "However, if the \"Order is incomplete and items are missing,\" we still continue the process."
      ],
      "justification": "Guard accurately captures the missing-items condition."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Guard and action match the damaged-items condition and corresponding notification step."
    },
    {
      "refs": [
        "guard:b3->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Direct match for the packing branch and its procedural continuation marker."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Direct match for the storage alternative and its continuation marker."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Exact match for the missing-items notification step."
    },
    {
      "refs": [
        "guard:b4->n19",
        "action:n19",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process."
      ],
      "justification": "Branch, guard, and continuation/status actions align with this return clause."
    },
    {
      "refs": [
        "guard:b4->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Matches the negative return condition and its stated continuation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Exact match for the inventory removal step on the damaged path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Represents the implicit repair-decision checkpoint that structures the upcoming split."
    },
    {
      "refs": [
        "guard:b5->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process."
      ],
      "justification": "Direct match for the successful repair path and its continuation."
    },
    {
      "refs": [
        "guard:b5->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Direct match for the discard path and the associated charge notification."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order."
      ],
      "justification": "Captures the final disposition action preceding the last branching phase."
    },
    {
      "refs": [
        "guard:b6->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Matches the repeated packing condition and its continuation marker."
    },
    {
      "refs": [
        "guard:b6->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Matches the storage alternative; convergence is implied by the rejoining of paths before termination."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Structural end node maps to the first explicit completion statement."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Structural end node maps to the second explicit completion statement."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges, and the process is complete."
      ],
      "justification": "Structural end node maps to the final completion phrase closing the process."
    }
  ],
