branch(b1, XOR)
action(n9, "Take batch to outbox")
action(n10, "Clear outbox every hour until completely cleared")
action(n11, "Outbox completely cleared?")
branch(b2, XOR)
action(n12, "End of process")
end(e1)
converge(c1)
converge(c2)
defines(v1, "More batches to process?", {"Yes", "No"})
defines(v2, "Outbox completely cleared?", {"Yes", "No"})
actor(a_default, "Default", [n1, n2, n3, n4, n5, n6, c1, n7, n8, b1, n9, c2, n10, n11, b2, n12, e1])
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, n5)
precedence(n5, n6)
precedence(n6, c1)
precedence(b1, c1)
