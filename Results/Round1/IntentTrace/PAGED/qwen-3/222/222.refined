precedence(c2, n10)
precedence(n10, n11)
precedence(n11, b2)
precedence(b2, n12)
precedence(n12, e1)
guard(b1, c1, v1 = 'Yes')
guard(b1, n9, v1 = 'No')
guard(b2, c2, v2 = 'No')
guard(b2, n12, v2 = 'Yes')
label(n1, n2, "Yes")
label(n2, n3, "Yes")
