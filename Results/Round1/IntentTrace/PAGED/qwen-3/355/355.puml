@startuml
!theme plain
|a_default| Default
|a_default|
start
:start process;
:check customer order;
:is customer registered;
:v7: customer type ({Registered, New, Wholesaler}); <<objectSignal>>
switch ()
case ([v7 = 'Registered'])
:check payment morale;
:is payment morale good;
:v2: is payment morale good ({Bad, Good}); <<objectSignal>>
if () then ([v2 = 'Good'])
:continue with process;
else ([v2 = 'Bad'])
:reject order;
:end process;
stop
endif
case ([v7 = 'New'])
:check customer status;
:is end customer;
:v3: is end customer ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'No'])
else ([v3 = 'Yes'])
endif
case ([v7 = 'Wholesaler'])
:is customer wholesaler;
:enter data and take order;
endswitch
:check item availability;
:are items in stock;
:v4: are items in stock ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:continue with process;
else ([v4 = 'No'])
:start production;
:produce article;
split
:send order confirmation;
:send order confirmation;
split again
:send invoice and deliver product;
end split
:check payment status;
:is payment received;
:v5: is payment received ({Yes, No}); <<objectSignal>>
if () then ([v5 = 'Yes'])
:close order;
:end process;
stop
else ([v5 = 'No'])
:are reminders more than 3;
:v6: are reminders more than 3 ({More than 3, 3 or fewer}); <<objectSignal>>
if () then ([v6 = 'More than 3'])
:engage lawyer;
:end process;
stop
else ([v6 = '3 or fewer'])
:send reminder;
:end process;
stop
endif
endif
endif
@enduml