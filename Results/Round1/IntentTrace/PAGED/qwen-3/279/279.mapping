    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "At the beginning,"
      ],
      "justification": "The opening phrase implicitly triggers the process start node and justifies the explicit start action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "if someone \"Knows SLA\","
      ],
      "justification": "Describes the condition that initiates the first XOR decision point; modeling the condition as an action step is permitted when content aligns."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "they should \"continue the process\"."
      ],
      "justification": "Captures the positive outcome of the first decision; the guard abstracts to 'Yes' while the action faithfully restates the continuation step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If they don't \"Know SLA\", they should \"Look up\"."
      ],
      "justification": "Captures the negative outcome of the first decision; the guard abstracts to 'No' while the action matches the lookup requirement."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, they should enter the date."
      ],
      "justification": "The sequential phrasing implies the rejoining of the previous split paths (converge) before executing the date entry action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the task is \"Urgent\","
      ],
      "justification": "Describes the condition that initiates the second XOR decision point."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "they should \"Red Stamp\"."
      ],
      "justification": "Captures the urgent outcome; the guard assigns the 'Urgent' label to the outgoing edge while the action matches the stamping step."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is \"Non Urgent\", they should \"continue the process\"."
      ],
      "justification": "Captures the non-urgent outcome; the guard assigns the 'Non Urgent' label while the action matches the continuation step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicitly signals the rejoining of the second decision paths, the final action, and the termination of the workflow."
    }
  ],
