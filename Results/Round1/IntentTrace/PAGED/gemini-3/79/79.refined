init(i1)
action(n1, "start the purchase process")
action(n2, "make a purchase")
action(n3, "connect to the website")
converge(c1)
action(n4, "search for course books")
action(n5, "add items to cart?")
branch(b1, XOR)
action(n6, "go to check out")
action(n7, "End of process")
end(e1)
action(n8, "continue shopping")
defines(v1, "add items to cart?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, c1, n4, n5, b1, n6, n7, e1, n8])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, c1)
precedence(n8, c1)
precedence(c1, n4)
precedence(n4, n5)
precedence(n5, b1)
precedence(b1, n6)
guard(b1, n6, v1=="Yes")
precedence(n6, n7)
precedence(n7, e1)
precedence(b1, n8)
guard(b1, n8, v1=="No")