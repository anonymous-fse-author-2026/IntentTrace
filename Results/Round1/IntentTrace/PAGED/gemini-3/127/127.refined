init(i1)
action(n2, "Identify parts")
branch(b1, XOR)
action(n4, "Check availability of parts")
action(n5, "Proceed with process")
converge(c1)
branch(b2, XOR)
action(n12, "Proceed with process")
action(n9, "Order and receive part from Disuki")
action(n7, "Contract customer")
converge(c2)
action(n10, "Proceed with payment")
action(n11, "End")
end(e1)
defines(v1, "Need to elicit information from customer", {"Yes", "No"})
defines(v2, "Are parts supplied to customer", {"Yes", "No"})
actor(a_default, "Default", [i1, n2, b1, n4, n5, c1, b2, n12, n9, n7, c2, n10, n11, e1])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, c1)
precedence(n5, c1)
precedence(c1, b2)
precedence(b2, n12)
precedence(b2, n9)
precedence(n9, n7)
precedence(n7, c2)
precedence(n12, c2)
precedence(c2, n10)
precedence(n10, n11)
precedence(n11, e1)
guard(b1, n4, v1 = 'Yes')
guard(b1, n5, v1 = 'No')
guard(b2, n12, v2 = 'Yes')
guard(b2, n9, v2 = 'No')