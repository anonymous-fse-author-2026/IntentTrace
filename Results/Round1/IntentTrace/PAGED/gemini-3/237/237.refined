init(i1)
action(n1, "start")
action(n2, "Is x greater than 2?")
branch(b1, XOR)
action(n3, "Continue the process")
action(n4, "Continue the process")
converge(c1)
action(n6, 'Similarly, if the value of "x" is greater than 2, the process should be continued. On the other hand, if the value of "x" is less than 2, the process should still be continued.')
end(e1)
defines(v1, "x", {"> 2", "< 2"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, c1, n6, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, c1)
precedence(c1, n6)
precedence(n6, e1)
guard(b1, n3, v1 == "> 2")
guard(b1, n4, v1 == "< 2")