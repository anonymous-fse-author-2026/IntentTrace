defines(v1, "are you hungry?", {"yes", "no"})
defines(v2, "are you still hungry after breakfast?", {"yes", "no"})
actor(a_default, "Default", [i1, n1, b1, n3, n4, n5, b2, n7, n8, e1, c1])
precedence(i1, n1)
precedence(n1, b1)
