init(i1)
action(n1, "Start rental items return process")
action(n2, "How were the items returned?")
branch(b1, XOR)
action(n2_5, "Delivery Crew picks-up items at the event site")
converge(c_b1)
action(n3, "Count items and compare to original contract")
action(n4, "Order status?")
branch(b2, XOR)
action(n_i6, "Order is incomplete and items are missing")
action(n_i7, "we still continue the process")
action(n5, "Email customer to inform of missing items and replacement charges")
action(n6, "Customer returns the missing items?")
branch(b3, XOR)
action(n_b3_1, "Customer returns the missing items")
action(n_b3_2, "Customer does not return the missing items")
converge(c_b3)
action(n7, "Email customer to inform of damage and additional charges")
action(n8, "Temporarily take damaged items out of inventory")
action(n9, "Items repair status?")
branch(b4, XOR)
action(n10, "Items are repaired and added into inventory")
action(n11, "Items can't be repaired and are discarded")
action(n12, "Email customer with replacement charges")
action(n14, "Email customer with replacement charges")
converge(c1)
action(n13, "Items packed for an existing order?")
branch(b5, XOR)
action(n_b5_1, "Items are packed for an existing order")
action(n_b5_2, "Items are stored for future orders")
converge(c_b5)
action(n15, "End")
end(e1)

defines(v1, "How were the items returned?", {"Delivery Crew picks-up items at the event site", "Customer returns the items to the store"})
defines(v2, "Order status?", {"Incomplete and items are missing", "Complete but items are damaged", "Complete and all items were returned"})
defines(v3, "Customer returns the missing items?", {"Customer returns the missing items", "Customer does not return the missing items"})
defines(v4, "Items repair status?", {"Items are repaired and added into inventory", "Items can't be repaired and are discarded"})
defines(v5, "Items packed for an existing order?", {"Items are packed for an existing order", "Items are stored for future orders"})

actor(a_default, "Default", [i1, n1, n2, b1, n2_5, c_b1, n3, n4, b2, n_i6, n_i7, n5, n6, b3, n_b3_1, n_b3_2, c_b3, n7, n8, n9, b4, n10, n11, n12, n14, c1, n13, b5, n_b5_1, n_b5_2, c_b5, n15, e1])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n2_5)
precedence(b1, c_b1)
precedence(n2_5, c_b1)
precedence(c_b1, n3)
precedence(n3, n4)
precedence(n4, b2)
precedence(b2, n_i6)
precedence(n_i6, n_i7)
precedence(n_i7, n5)
precedence(n5, n6)
precedence(n6, b3)
precedence(b3, n_b3_1)
precedence(b3, n_b3_2)
precedence(n_b3_1, c_b3)
precedence(n_b3_2, c_b3)
precedence(c_b3, c1)
precedence(b2, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, b4)
precedence(b4, n10)
precedence(b4, n11)
precedence(n11, n12)
precedence(n12, n14)
precedence(n14, c1)
precedence(b2, c1)
precedence(n10, c1)
precedence(c1, n13)
precedence(n13, b5)
precedence(b5, n_b5_1)
precedence(b5, n_b5_2)
precedence(n_b5_1, c_b5)
precedence(n_b5_2, c_b5)
precedence(c_b5, n15)
precedence(n15, e1)

guard(b1, n2_5, v1 = 'Delivery Crew picks-up items at the event site')
guard(b1, c_b1, v1 = 'Customer returns the items to the store')
guard(b2, n_i6, v2 = 'Incomplete and items are missing')
guard(b2, n7, v2 = 'Complete but items are damaged')
guard(b2, c1, v2 = 'Complete and all items were returned')
guard(b3, n_b3_1, v3 = 'Customer returns the missing items')
guard(b3, n_b3_2, v3 = 'Customer does not return the missing items')
guard(b4, n10, v4 = 'Items are repaired and added into inventory')
guard(b4, n11, v4 = "Items can't be repaired and are discarded")
guard(b5, n_b5_1, v5 = 'Items are packed for an existing order')
guard(b5, n_b5_2, v5 = 'Items are stored for future orders')