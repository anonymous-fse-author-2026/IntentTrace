init(start)
action(i1, "Initially, the appointment approval form is sent.")
action(i2, "the approval is received.")
action(i3, "contact with TS to clarify the timing.")
action(i4, "it is checked.")
branch(b1, XOR)
action(i5, "If the resource is internal")
action(i6, "the appointment is authorized.")
action(i7, "the appointment is also authorized.")
converge(c1)
branch(b2, XOR)
action(i13, "If there are no variations")
action(i14, "the process continues.")
action(i15, "a business case is completed.")
action(i16, "a business case is completed and attached.")
converge(c2)
action(i8, "the mandatory documentation along with the approval is sent to HR services.")
action(i9, "The form is then scanned and recorded into the GovSource system.")
action(i10, "sent along with the mandatory documentation to HR services.")
action(i11, "HR services receive the documentations")
action(i12, "this marks the end of the process.")
end(e1)
defines(v1, "resource", {"internal", "external"})
defines(v2, "variations", {"yes", "no"})
actor(a_default, "Default", [start, i1, i2, i3, i4, b1, i5, i6, i7, c1, b2, i13, i14, i15, i16, c2, i8, i9, i10, i11, i12, e1])
precedence(start, i1)
precedence(i1, i2)
precedence(i2, i3)
precedence(i3, i4)
precedence(i4, b1)
precedence(b1, i5)
precedence(b1, i7)
precedence(i5, i6)
precedence(i6, c1)
precedence(i7, c1)
precedence(c1, b2)
precedence(b2, i13)
precedence(b2, i15)
precedence(i13, i14)
precedence(i14, c2)
precedence(i15, i16)
precedence(i16, c2)
precedence(c2, i8)
precedence(i8, i9)
precedence(i9, i10)
precedence(i10, i11)
precedence(i11, i12)
precedence(i12, e1)
guard(b1, i5, v1 == "internal")
guard(b1, i7, v1 == "external")
guard(b2, i13, v2 == "no")
guard(b2, i15, v2 == "yes")