init(i1)
action(n1, "Start EC-Lille procedure")
action(n2, "Is 'research schedule directly' option selected")
branch(b1, XOR)
action(n3, "Research schedule")
action(n4, "Provide indications")
action(n5, "Proceed with research schedule")
converge(c1)
action(n6, "Validate schedule")
action(n7, "Is schedule satisfactory")
branch(b2, XOR)
action(n8, "Research schedule")
action(n9, "Write ticket order to SNCF")
action(n10, "Is schedule still not satisfactory after researching again")
action(n13, "Validate ticket order")
action(n14, "Is ticket order approved")
branch(b4, XOR)
action(n15, "End process")
end(e1)
action(n16, "Validate ticket order again")
action(n17, "Is ticket order approved after second validation")
branch(b5, XOR)
action(n18, "End process")
end(e2)
action(n19, "Validate ticket order once more")
action(n20, "Is ticket order approved after third validation")
branch(b6, XOR)
action(n21, "End process")
end(e3)
action(n22, "End process")
end(e4)
converge(c3)

defines(v1, "Is 'research schedule directly' option selected", {"Yes", "No"})
defines(v2, "Is schedule satisfactory", {"Satisfactory", "Not satisfactory", "Still not satisfactory"})
defines(v4, "Is ticket order approved", {"Yes", "No"})
defines(v5, "Is ticket order approved after second validation", {"Yes", "No"})
defines(v6, "Is ticket order approved after third validation", {"Yes", "No"})

actor(a_default, "Default", [i1, n1, n2, b1, c3, n3, n4, n5, c1, n6, n7, b2, n8, n9, n10, n13, n14, b4, n15, e1, n16, n17, b5, n18, e2, n19, n20, b6, n21, e3, n22, e4])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)

precedence(b1, n3)
precedence(b1, c3)

precedence(c3, n4)
precedence(n4, n5)

precedence(n3, c1)
precedence(n5, c1)
precedence(n8, c1)

precedence(c1, n6)
precedence(n6, n7)
precedence(n7, b2)

precedence(b2, n9)
precedence(b2, n8)
precedence(b2, n10)
precedence(n10, c3)

precedence(n9, n13)
precedence(n13, n14)
precedence(n14, b4)

precedence(b4, n15)
precedence(n15, e1)

precedence(b4, n16)
precedence(n16, n17)
precedence(n17, b5)

precedence(b5, n18)
precedence(n18, e2)

precedence(b5, n19)
precedence(n19, n20)
precedence(n20, b6)

precedence(b6, n21)
precedence(n21, e3)

precedence(b6, n22)
precedence(n22, e4)

guard(b1, n3, v1 == "Yes")
guard(b1, c3, v1 == "No")

guard(b2, n9, v2 == "Satisfactory")
guard(b2, n8, v2 == "Not satisfactory")
guard(b2, n10, v2 == "Still not satisfactory")

guard(b4, n16, v4 == "Yes")
guard(b4, n15, v4 == "No")

guard(b5, n19, v5 == "Yes")
guard(b5, n18, v5 == "No")

guard(b6, n22, v6 == "Yes")
guard(b6, n21, v6 == "No")