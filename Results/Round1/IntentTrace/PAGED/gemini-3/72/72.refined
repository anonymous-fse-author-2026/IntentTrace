init(i1)
action(n1, "start")
action(n2, "Bill for Purchased Goods/Services and then Receive Invoice")
action(n3, "Is the invoice incomplete?")
branch(b1, XOR)
action(n4, "Return invoice due to incompleteness")
end(e1)
action(n6, "Proceed with compliant or non-compliant check")
action(n7, "Is the invoice non-compliant?")
branch(b2, XOR)
action(n_i7, "further checks are conducted.")
branch(b_resolve, XOR)
action(n8, "Resolve non-compliance via phone call")
action(n9, "Return invoice due to mail back requirement")
converge(c1)
converge(c2)
action(n_i10, "After that, the invoice is paid and if it is returned, non-compliance is resolved.")
action(n12, "Bill Client")
action(n13, "Is there no response from client?")
branch(b3, XOR)
action(n14, "Give 10 days waiting period")
action(n15, "End of process: Reminder sent after 10 days")
end(e3)
action(n11, "Pay the invoice and notify client of payment")
branch(b4, XOR)
action(n16, "Resolve payment discrepancy if client is unsatisfied")
end(e_unsatisfied)
action(n17, "Continue process if client is satisfied")
end(e4)

defines(v1, "Is the invoice incomplete?", {"yes", "no"})
defines(v2, "Is the invoice non-compliant?", {"yes", "no"})
defines(v_resolve, "Resolution method", {"phone", "mail"})
defines(v3, "Is there no response from client?", {"yes", "no"})
defines(v4, "Resolve payment discrepancy if client is unsatisfied", {"unsatisfied", "satisfied"})

actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, e1, n6, n7, b2, n_i7, b_resolve, n8, n9, c1, c2, n_i10, n12, n13, b3, n14, n15, e3, n11, b4, n16, e_unsatisfied, n17, e4])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(n4, e1)
precedence(b1, n6)
precedence(n6, n7)
precedence(n7, b2)
precedence(b2, n_i7)
precedence(b2, c2)
precedence(n_i7, b_resolve)
precedence(b_resolve, n8)
precedence(b_resolve, n9)
precedence(n8, c1)
precedence(n9, c1)
precedence(c1, c2)
precedence(c2, n_i10)
precedence(n_i10, n12)
precedence(n12, n13)
precedence(n13, b3)
precedence(b3, n14)
precedence(n14, n15)
precedence(n15, e3)
precedence(b3, n11)
precedence(n11, b4)
precedence(b4, n16)
precedence(n16, e_unsatisfied)
precedence(b4, n17)
precedence(n17, e4)

guard(b1, n4, v1=="yes")
guard(b1, n6, v1=="no")
guard(b2, n_i7, v2=="yes")
guard(b2, c2, v2=="no")
guard(b_resolve, n8, v_resolve=="phone")
guard(b_resolve, n9, v_resolve=="mail")
guard(b3, n14, v3=="yes")
guard(b3, n11, v3=="no")
guard(b4, n16, v4=="unsatisfied")
guard(b4, n17, v4=="satisfied")