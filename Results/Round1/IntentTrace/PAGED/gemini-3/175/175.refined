init(i1)
action(n1, "start")
action(n2, "items returned to store")
branch(b1, XOR)
action(n3, "customer returns items to store")
action(n4, "delivery crew picks up items at event site")
converge(c1)
action(n_count, "the items are counted and compared to the original contract")
branch(b2, XOR)
action(n5, "order is complete and all items were returned")
action(n6, "order is incomplete and items are missing")
action(n_damaged, "order is complete but items are damaged")

branch(b11, XOR)
action(n8, "items packed for existing order")
action(n9, "items stored for future orders")
converge(c2)

action(n_email_missing, "email the customer to inform them")
branch(b3, XOR)
action(n15, "customer returns missing items")
action(n16, "customer does not return missing items")
converge(c4)

converge(c6)
action(n20, "end process")
end(e3)

action(n7, "email customer to inform of damage and additional charges")
action(n17, "temporarily take damaged items out of inventory")
branch(b6, XOR)
action(n11, "items are repaired and added into inventory")
action(n12, "items can't be repaired and are discarded")

branch(b12, XOR)
action(n18, "items packed for existing order")
action(n19, "items stored for future orders")
converge(c5)

action(n13, "email customer with replacement charges")
converge(c3)
action(n14, "end process")
end(e2)

defines(v1, "return method", {"customer", "delivery"})
defines(v2, "order status", {"complete", "incomplete", "damaged"})
defines(v4, "complete items pack store", {"packed", "stored"})
defines(v7, "missing return", {"yes", "no"})
defines(v6, "repair condition", {"repaired", "discarded"})
defines(v9, "repaired items pack store", {"packed", "stored"})

actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, c1, n_count, b2, n5, n6, n_damaged, b11, n8, n9, c2, n_email_missing, b3, n15, n16, c4, c6, n20, e3, n7, n17, b6, n11, n12, b12, n18, n19, c5, n13, c3, n14, e2])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, c1)
precedence(c1, n_count)
precedence(n_count, b2)

precedence(b2, n5)
precedence(b2, n6)
precedence(b2, n_damaged)

precedence(n5, b11)
precedence(b11, n8)
precedence(b11, n9)
precedence(n8, c2)
precedence(n9, c2)

precedence(n6, n_email_missing)
precedence(n_email_missing, b3)
precedence(b3, n15)
precedence(b3, n16)
precedence(n15, c4)
precedence(n16, c4)

precedence(c2, c6)
precedence(c4, c6)
precedence(c6, n20)
precedence(n20, e3)

precedence(n_damaged, n7)
precedence(n7, n17)
precedence(n17, b6)
precedence(b6, n11)
precedence(b6, n12)

precedence(n11, b12)
precedence(b12, n18)
precedence(b12, n19)
precedence(n18, c5)
precedence(n19, c5)

precedence(n12, n13)
precedence(n13, c3)
precedence(c5, c3)
precedence(c3, n14)
precedence(n14, e2)

guard(b1, n3, v1 == "customer")
guard(b1, n4, v1 == "delivery")
guard(b2, n5, v2 == "complete")
guard(b2, n6, v2 == "incomplete")
guard(b2, n_damaged, v2 == "damaged")
guard(b11, n8, v4 == "packed")
guard(b11, n9, v4 == "stored")
guard(b3, n15, v7 == "yes")
guard(b3, n16, v7 == "no")
guard(b6, n11, v6 == "repaired")
guard(b6, n12, v6 == "discarded")
guard(b12, n18, v9 == "packed")
guard(b12, n19, v9 == "stored")