init(i1)
action(n1, "Start process for flickr login")
converge(c1)
action(n2, "Provide userdata for flickr login")
branch(b1, XOR)
action(n4, "End process after successful login")
end(e1)
action(n_continue, "We will continue with the process")
branch(b2, XOR)
action(n5, "Choose to try login again")
action(n7, "Choose to abort after retry option")
action(n8, "End process after abort")
end(e2)
action(n9, "Choose to try login again after aborted retry")
action(n_alt_abort, "Alternatively, if you decide to abort")
action(n11, "End process after abort")
end(e3)
defines(v1, "Is login successful", {"Successful", "Fails"})
defines(v2, "Retry choice", {"Try again", "Abort", "Still try again", "Alternatively abort"})
actor(a_default, "Default", [i1, n1, c1, n2, b1, n4, e1, n_continue, b2, n5, n7, n8, e2, n9, n_alt_abort, n11, e3])
precedence(i1, n1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n_continue)
precedence(n4, e1)
precedence(n_continue, b2)
precedence(b2, n5)
precedence(b2, n7)
precedence(b2, n9)
precedence(b2, n_alt_abort)
precedence(n5, c1)
precedence(n7, n8)
precedence(n8, e2)
precedence(n9, c1)
precedence(n_alt_abort, n11)
precedence(n11, e3)
guard(b1, n4, v1 = 'Successful')
guard(b1, n_continue, v1 = 'Fails')
guard(b2, n5, v2 = 'Try again')
guard(b2, n7, v2 = 'Abort')
guard(b2, n9, v2 = 'Still try again')
guard(b2, n_alt_abort, v2 = 'Alternatively abort')