init(i1)
action(n1, "To start")
action(n2, "please provide the userdata for flickr")
branch(b1, XOR)
action(n4, "the process will end")
end(e1)
action(n5, "if the login fails")
branch(b2, XOR)
action(n6, "If you want to try again")
action(n6_usr, "please provide the userdata for flickr")
end(e2)
action(n10, "if you choose to abort")
action(n10_end, "the process will end")
end(e3)
action(n9, "If you still want to try again")
action(n11, "please provide the userdata for flickr")
end(e4)
action(n14, "if you decide to abort")
action(n14_end, "the process will end")
end(e5)
defines(v1, "login successful", {"Yes", "No"})
defines(v2, "after fail choice", {"try again", "abort", "still try again", "decide to abort"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, e1, n5, b2, n6, n6_usr, e2, n10, n10_end, e3, n9, n11, e4, n14, n14_end, e5])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(n4, e1)
precedence(b1, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(n6, n6_usr)
precedence(n6_usr, e2)
precedence(b2, n10)
precedence(n10, n10_end)
precedence(n10_end, e3)
precedence(b2, n9)
precedence(n9, n11)
precedence(n11, e4)
precedence(b2, n14)
precedence(n14, n14_end)
precedence(n14_end, e5)
guard(b1, n4, v1 = 'Yes')
guard(b1, n5, v1 = 'No')
guard(b2, n6, v2 = 'try again')
guard(b2, n10, v2 = 'abort')
guard(b2, n9, v2 = 'still try again')
guard(b2, n14, v2 = 'decide to abort')