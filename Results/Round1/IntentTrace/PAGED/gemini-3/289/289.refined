init(i1)
action(n1, "To start the ExpenseReport process, begin by clicking on 'Start' and then selecting 'Edit Report'")
action(n2, "If the expense is greater than 1000")
branch(b1, XOR)
action(n3, "the report should be reviewed")
action(n7, "evaluate the review decision")
branch(b3, XOR)
action(n4, "check if there is a need for translation")
branch(b2, XOR)
action(n5, "translate the receipts")
action(n6, "confirm the receipts")
action(n17, "evaluate the receipts decision")
branch(b9, XOR)
action(n9, "edit the report")
action(n19, "process the expense")
action(n21, "ending it")
end(e1)
converge(c1)
converge(c2)
converge(c3)
converge(c4)
defines(v1, "Expense", {"Greater", "LessOrEqual"})
defines(v2, "Translation", {"Required", "NotRequired"})
defines(v3, "ReviewDecision", {"Approved", "Rejected"})
defines(v4, "ReceiptsDecision", {"Accepted", "Rejected"})
actor(a_default, "Default", [i1, c4, n1, n2, b1, n3, n7, b3, c1, n4, b2, n5, c2, n6, n17, b9, c3, n9, n19, n21, e1])
precedence(i1, c4)
precedence(c3, n9)
precedence(n9, c4)
precedence(c4, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, c1)
precedence(n3, n7)
precedence(n7, b3)
precedence(b3, c1)
precedence(b3, c3)
precedence(c1, n4)
precedence(n4, b2)
precedence(b2, n5)
precedence(b2, c2)
precedence(n5, c2)
precedence(c2, n6)
precedence(n6, n17)
precedence(n17, b9)
precedence(b9, n19)
precedence(b9, c3)
precedence(n19, n21)
precedence(n21, e1)
guard(b1, n3, v1=="Greater")
guard(b1, c1, v1=="LessOrEqual")
guard(b3, c1, v3=="Approved")
guard(b3, c3, v3=="Rejected")
guard(b2, n5, v2=="Required")
guard(b2, c2, v2=="NotRequired")
guard(b9, n19, v4=="Accepted")
guard(b9, c3, v4=="Rejected")