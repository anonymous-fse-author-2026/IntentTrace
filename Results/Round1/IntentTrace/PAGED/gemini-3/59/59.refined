init(i1)
action(n1, "Orders Required")
action(n2, "place Bulk order")
branch(b1, XOR)
action(n4, "process order for delivery")
action(n5, "Outstanding Balance")
action(n6, "place new order")
action(n7, "record in Accounts Receivable")
action(n8, "End at Warehouse")
end(e1)
branch(b2, XOR)
action(n10, "drop order")
end(e2)
action(n12, "identify order for installation")
branch(b3, XOR)
action(n14, "assign Installer")
end(e3)
action(n16, "pack for delivery")
end(e4)
converge(c1)
branch(b4, AND)
defines(v1, "credit allowance condition", {"Order with prior internal credit allowance", "order exceeds the purchaser's credit allowance"})
defines(v2, "payment status", {"Payments are Received", "no payments are received"})
defines(v3, "installation requirement", {"installation needs to be scheduled", "order does not require installation"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, n5, n6, n7, n8, e1, b2, n10, e2, n12, b3, n14, e3, n16, e4, c1, b4])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, b4)
precedence(b4, n7)
precedence(b4, n8)
precedence(n8, e1)
precedence(n7, b2)
precedence(b2, n10)
precedence(n10, e2)
precedence(n4, c1)
precedence(b2, c1)
precedence(c1, n12)
precedence(n12, b3)
precedence(b3, n14)
precedence(n14, e3)
precedence(b3, n16)
precedence(n16, e4)
guard(b1, n4, v1 = "Order with prior internal credit allowance")
guard(b1, n5, v1 = "order exceeds the purchaser's credit allowance")
guard(b2, c1, v2 = "Payments are Received")
guard(b2, n10, v2 = "no payments are received")
guard(b3, n14, v3 = "installation needs to be scheduled")
guard(b3, n16, v3 = "order does not require installation")