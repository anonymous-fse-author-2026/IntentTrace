init(i1)
branch(b_and, AND)
action(n2, "check the Referee Reports")
action(n3, "monitor if the Referee Reports have been completed")
branch(b1, XOR)
action(n4, "flag it and send a reminder")
converge(c_loop)
action(n5, "check again if the Referee Reports have been completed")
branch(b2, XOR)
action(n11_rem, "flag it again and send another reminder")
converge(c1)
action(n7, "organize interviews for the Selection Panel with the top candidates")
action(n8, "receive feedback from the interview candidates")
action(n9, "check if a Psychometric Test is required")
branch(b3, XOR)
action(n10, "check if an HR Specialist is required")
branch(b4, XOR)
action(n11, "schedule the test with a third party")
converge(c2)
action(n21, "complete the Psychometric Test")
action(n13, "coordinate the second round of selection")
converge(c3)
action(n14, "request the final candidate ranking and continue with the process")
end(e1)

defines(v1, "are referee reports completed?", {"yes", "no"})
defines(v2, "are referee reports completed after re-check?", {"yes", "no"})
defines(v3, "is psychometric test required?", {"yes", "no"})
defines(v4, "is hr specialist required?", {"yes", "no"})

actor(a_default, "Default", [i1, b_and, n2, n3, b1, n4, c_loop, n5, b2, n11_rem, c1, n7, n8, n9, b3, n10, b4, n11, c2, n21, n13, c3, n14, e1])

precedence(i1, b_and)
precedence(b_and, n2)
precedence(b_and, n3)
precedence(n2, c1)
precedence(n3, b1)
precedence(b1, c1)
precedence(b1, n4)
precedence(n4, c_loop)
precedence(n11_rem, c_loop)
precedence(c_loop, n5)
precedence(n5, b2)
precedence(b2, c1)
precedence(b2, n11_rem)
precedence(c1, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, b3)
precedence(b3, n10)
precedence(b3, n13)
precedence(n10, b4)
precedence(b4, n11)
precedence(b4, c2)
precedence(n11, c2)
precedence(c2, n21)
precedence(n21, c3)
precedence(n13, c3)
precedence(c3, n14)
precedence(n14, e1)

guard(b1, c1, v1 == "yes")
guard(b1, n4, v1 == "no")
guard(b2, c1, v2 == "yes")
guard(b2, n11_rem, v2 == "no")
guard(b3, n10, v3 == "yes")
guard(b3, n13, v3 == "no")
guard(b4, n11, v4 == "yes")
guard(b4, c2, v4 == "no")