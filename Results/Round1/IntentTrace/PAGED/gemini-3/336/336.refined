init(i1)
action(n1, "Receive form")
action(n2, "Is form complete")
branch(b1, XOR)
action(n3, "Send form back and end process")
end(e1)
action(n4, "Is income check needed")
branch(b2, AND)
action(n5, "Complete check deductibles")
action(n6, "Complete check house")
converge(c1)
action(n7, "Make decision after completing checks")
branch(b3, XOR)
action(n8, "End process as declaration check needed")
end(e2)
action(n9, "End process as invitation needed")
end(e3)
defines(v1, "Form status", {"Send back", "Check income"})
defines(v2, "Decision", {"Check declaration", "Invite declarant"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, e1, n4, b2, n5, n6, c1, n7, b3, n8, e2, n9, e3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, e1)
precedence(n4, b2)
precedence(b2, n5)
precedence(b2, n6)
precedence(n5, c1)
precedence(n6, c1)
precedence(c1, n7)
precedence(n7, b3)
precedence(b3, n8)
precedence(b3, n9)
precedence(n8, e2)
precedence(n9, e3)
guard(b1, n3, v1 = 'Send back')
guard(b1, n4, v1 = 'Check income')
guard(b3, n8, v2 = 'Check declaration')
guard(b3, n9, v2 = 'Invite declarant')