converge(c1)
branch(b3, AND)
defines(v1, "Inventory greater than Minimum Level?", {"Yes", "No"})
defines(v2, "Purchase Order accepted?", {"Rejected", "Accepted"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n5, e1, n6, c2, n7, b2, n9, n10, n11, n12, n13, n14, n15, n16, n17, n18, e2, c1, b3])
