init(i1)
action(n1, "start")
action(n2, "initiate new resupply cycle")
action(n3, "check levels of inventory")
action(n4, "is inventory below or equal to minimum?")
branch(b1, XOR)
action(n5, "generate above minimum report")
action(n6, "end process")
end(e1)
action(n7, "generate equal to or below minimum report")
converge(c1)
action(n8, "create Purchase Orders (POs)")
action(n9, "review PO")
branch(b2, XOR)
action(n10, "rework PO")
action(n11, "print and release PO in the system")
branch(b3, AND)
action(n12, "reserve funds for the released POs")
action(n13, "mail the POs to the supplier")
action(n15, "receive the inventory")
converge(c2)
action(n14, "receive the Packing Slip")
action(n16, "receive the Invoice")
action(n17, "Three-way match")
action(n18, "release the funds")
action(n19, "issue the payment")
action(n20, "Resupply Cycle is complete and the process ends")
end(e2)

defines(v1, "is inventory below or equal to minimum?", {"below or equal", "above"})
defines(v2, "PO review result", {"rejected", "approved"})

actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, n6, e1, n7, c1, n8, n9, b2, n10, n11, b3, n12, n13, n15, c2, n14, n16, n17, n18, n19, n20, e2])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)

precedence(b1, n5)
guard(b1, n5, v1 == "above")
precedence(n5, n6)
precedence(n6, e1)

precedence(b1, n7)
guard(b1, n7, v1 == "below or equal")
precedence(n7, c1)

precedence(c1, n8)
precedence(n8, n9)
precedence(n9, b2)

precedence(b2, n10)
guard(b2, n10, v2 == "rejected")
precedence(n10, c1)

precedence(b2, n11)
guard(b2, n11, v2 == "approved")
precedence(n11, b3)

precedence(b3, n12)
precedence(b3, n13)

precedence(n12, c2)
precedence(n13, n15)
precedence(n15, c2)

precedence(c2, n14)
precedence(n14, n16)
precedence(n16, n17)
precedence(n17, n18)
precedence(n18, n19)
precedence(n19, n20)
precedence(n20, e2)