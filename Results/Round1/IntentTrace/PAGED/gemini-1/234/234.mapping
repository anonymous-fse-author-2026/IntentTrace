{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process"
      ],
      "justification": "Matches the start of the process."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin by supplying the requirement and then documenting it"
      ],
      "justification": "Direct paraphrase of supplying and documenting the requirement."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the order is received"
      ],
      "justification": "Implies checking the reception method and branching based on it."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "via fax, input the order into an Excel file"
      ],
      "justification": "Captures the condition for fax and the corresponding action."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone, also input the order into an Excel file"
      ],
      "justification": "Captures the condition for mail/phone and the corresponding action."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete"
      ],
      "justification": "Implies the paths have rejoined and the list is complete."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "send it to the student."
      ],
      "justification": "Direct action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list"
      ],
      "justification": "Matches receiving the list."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "type the orders into the MS-Access database."
      ],
      "justification": "Direct action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "ensure that it is completed"
      ],
      "justification": "Matches the completion check."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "control the incoming order",
        "continue to do the check"
      ],
      "justification": "Captures the controlling and checking actions."
    },
    {
      "refs": [
        "action:n11",
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "If the order is correct"
      ],
      "justification": "Sets up the decision based on correctness."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "release it"
      ],
      "justification": "Action for the correct order."
    },
    {
      "refs": [
        "action:n33"
      ],
      "verbatim_texts": [
        "Send the Excel list to the student and upon receiving it, continue with the process."
      ],
      "justification": "Exact verbatim match."
    },
    {
      "refs": [
        "guard:b2->n13"
      ],
      "verbatim_texts": [
        "if the order is incorrect"
      ],
      "justification": "Condition for the negative path."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "contact the selling agency."
      ],
      "justification": "Action for the incorrect order."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the order is worth"
      ],
      "justification": "Sets up the decision based on order value."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "less than 5.000 \u20ac"
      ],
      "justification": "Condition value."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "release it"
      ],
      "justification": "Action for the < 5k path."
    },
    {
      "refs": [
        "guard:b3->n16"
      ],
      "verbatim_texts": [
        "more than 5.000 \u20ac"
      ],
      "justification": "Condition value."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "send it for sign off"
      ],
      "justification": "Action for the > 5k path."
    },
    {
      "refs": [
        "action:n34"
      ],
      "verbatim_texts": [
        "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
      ],
      "justification": "Exact verbatim match."
    },
    {
      "refs": [
        "action:n20",
        "guard:b4->n21"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved"
      ],
      "justification": "Sets up the decision and guard for unsolvable issues."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "cancel the order."
      ],
      "justification": "Action for unsolvable issue."
    },
    {
      "refs": [
        "guard:b4->n22"
      ],
      "verbatim_texts": [
        "If the issue can be solved"
      ],
      "justification": "Guard for solvable issue."
    },
    {
      "refs": [
        "action:n22",
        "action:n18"
      ],
      "verbatim_texts": [
        "release the order"
      ],
      "justification": "Actions to release."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "contact the client"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n35"
      ],
      "verbatim_texts": [
        "After PPC initiates production, the goods will be produced."
      ],
      "justification": "Exact match."
    },
    {
      "refs": [
        "action:n23",
        "guard:b5->n24"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled"
      ],
      "justification": "Decision setup and guard for cancellation."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "End of process following cancellation."
    },
    {
      "refs": [
        "guard:b5->n25"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Guard for the alternative."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "check the quality of the goods."
      ],
      "justification": "Direct action."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "create and send a quality report to the finance department."
      ],
      "justification": "Direct action."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Send the invoice"
      ],
      "justification": "Direct action."
    },
    {
      "refs": [
        "action:n36"
      ],
      "verbatim_texts": [
