      ],
      "verbatim_texts": [
        "Also, send the goods"
      ],
      "justification": "Exact verbatim match."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "sign and send the memo"
      ],
      "justification": "Direct action."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
