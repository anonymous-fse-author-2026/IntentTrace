end(e1)
converge(c1)
defines(v1, "are you hungry?", {"true", "false"})
defines(v2, "are you still hungry after breakfast?", {"true", "false"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, c2, n4, n5, n6, b2, n7, e1, c1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
