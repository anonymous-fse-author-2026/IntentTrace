    {
      "id": "i2",
      "type": "action",
      "content": "If the 'Customer returns the items to the store,' then we can continue the process. However, if the 'Delivery Crew picks-up items at the event site,'"
    },
    {
      "id": "i3",
      "type": "action",
      "content": "Delivery Crew picks-up items at the event site"
    },
    {
      "id": "i4",
      "type": "action",
      "content": "the items are counted and compared to the original contract"
    },
    {
      "id": "i5",
      "type": "action",
      "content": "If the 'Order is complete and all items were returned,' then we proceed with the process. However, if the 'Order is incomplete and items are missing,' we still continue the process. Similarly, if the 'Order is complete but items are damaged,'"
    },
    {
      "id": "i6",
      "type": "action",
      "content": "Order is incomplete and items are missing"
    },
    {
      "id": "i7",
      "type": "action",
      "content": "we still continue the process."
    },
    {
      "id": "i8",
      "type": "action",
      "content": "Order is complete but items are damaged"
    },
    {
      "id": "i9",
      "type": "action",
      "content": "email the customer to inform them of the damage and additional charges"
    },
    {
      "id": "i10",
      "type": "action",
      "content": "In case of missing items and replacement charges, we email the customer to inform them."
    },
    {
      "id": "i11",
      "type": "action",
      "content": "temporarily take them out of inventory"
    },
    {
      "id": "i12",
      "type": "action",
      "content": "If the 'Customer returns the missing items,'"
    },
    {
      "id": "i13",
      "type": "action",
      "content": "when the process is complete, it ends."
    },
    {
      "id": "i14",
      "type": "action",
      "content": "If the 'Items are repaired and added into inventory,' we continue the process. On the other hand, if the 'Items can't be repaired and are discarded,'"
    },
    {
      "id": "i15",
      "type": "action",
      "content": "Items are repaired and added into inventory"
    },
    {
      "id": "i16",
      "type": "action",
      "content": "Items can't be repaired and are discarded"
    },
    {
      "id": "i17",
      "type": "action",
      "content": "email the customer with replacement charges"
    },
    {
      "id": "i18",
      "type": "action",
      "content": "If the 'Items are packed for an existing order,'"
    },
    {
      "id": "i19",
      "type": "action",
      "content": "customer is then emailed with replacement charges"
    },
