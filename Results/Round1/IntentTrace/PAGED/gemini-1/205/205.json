      "id": "i16",
      "content": "the Packing Slip is received"
    },
    {
      "id": "i17",
      "content": "the Invoice is received"
    },
    {
      "id": "i18",
      "content": "Upon receiving the Packing Slip, it is recorded"
    },
    {
      "id": "i19",
      "content": "upon receiving the Invoice, it is recorded"
    },
    {
      "id": "i20",
      "content": "Once the funds are released for payment,"
