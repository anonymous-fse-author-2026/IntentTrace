    {
      "id": "i1",
      "content": "To initiate the process for ACME Company, the Resupply Cycle is triggered"
    },
    {
      "id": "i2",
      "content": "checking the Inventory Level"
    },
    {
      "id": "i3",
      "content": "If the Inventory is greater than the Minimum Level"
    },
    {
      "id": "i4",
      "content": "is greater than the Minimum Level"
    },
    {
      "id": "i5",
      "content": "then the process ends."
    },
    {
      "id": "i6",
      "content": "Otherwise,"
    },
    {
      "id": "i7",
      "content": "a Purchase Order is created"
    },
    {
      "id": "i8",
      "content": "The Purchase Order is then reviewed"
    },
    {
      "id": "i9",
      "content": "If the Purchase Order is rejected"
    },
    {
      "id": "i10",
      "content": "is rejected,"
    },
    {
      "id": "i11",
      "content": "it is reworked"
    },
    {
      "id": "i12",
      "content": "is accepted,"
    },
    {
      "id": "i13",
      "content": "funds are reserved for payment"
    },
    {
      "id": "i14",
      "content": "the Purchase Order is sent to the Supplier"
    },
    {
      "id": "i15",
      "content": "Simultaneously, the following steps are completed:"
    },
