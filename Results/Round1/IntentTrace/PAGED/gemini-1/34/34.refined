init(i1)
branch(b_and, AND)
action(n2, "check the Referee Reports")
action(n_monitor, "monitor if the Referee Reports have been completed")
branch(b1, XOR)
action(n4, "flag it and send a reminder")
action(n5, "check again if the Referee Reports have been completed")
branch(b2, XOR)
action(n_flag2, "flag it again and send another reminder.")
converge(c1)
converge(c_and)
action(n7, "organize interviews for the Selection Panel with the top candidates")
action(n8, "receive feedback from the interview candidates")
action(n9, "check if a Psychometric Test is required")
branch(b3, XOR)
action(n10, "check if an HR Specialist is required")
branch(b4, XOR)
action(n11, "schedule the test with a third party")
action(n12, "complete the Psychometric Test")
action(n13, "coordinate the second round of selection")
converge(c2)
action(n14, "request the final candidate ranking and continue with the process")
end(e1)

defines(v1, "reports_completed", {"Yes", "No"})
defines(v2, "recheck_completed", {"Yes", "No"})
defines(v3, "psycho_required", {"Yes", "No"})
defines(v4, "hr_required", {"Yes", "No"})

actor(a_default, "Default", [i1, b_and, n2, n_monitor, b1, n4, n5, b2, n_flag2, c1, c_and, n7, n8, n9, b3, n10, b4, n11, n12, n13, c2, n14, e1])

precedence(i1, b_and)
precedence(b_and, n2)
precedence(b_and, n_monitor)
precedence(n2, c_and)

precedence(n_monitor, b1)
precedence(b1, c1)
precedence(b1, n4)
precedence(n4, n5)
precedence(n5, b2)
precedence(b2, c1)
precedence(b2, n_flag2)
precedence(n_flag2, c1)

precedence(c1, c_and)

precedence(c_and, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, b3)

precedence(b3, n10)
precedence(b3, n13)
precedence(n10, b4)
precedence(b4, n11)
precedence(b4, n12)

precedence(n11, c2)
precedence(n12, c2)
precedence(n13, c2)

precedence(c2, n14)
precedence(n14, e1)

guard(b1, c1, v1=="Yes")
guard(b1, n4, v1=="No")
guard(b2, c1, v2=="Yes")
guard(b2, n_flag2, v2=="No")
guard(b3, n10, v3=="Yes")
guard(b3, n13, v3=="No")
guard(b4, n11, v4=="Yes")
guard(b4, n12, v4=="No")