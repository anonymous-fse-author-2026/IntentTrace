@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start Process;
:Bill for Purchased Goods/Services;
:Receive Invoice;
:v1: Invoice Complete? ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:Return Invoice;
stop
else ([v1 = 'Yes'])
:Invoice Compliant?;
:v2: Invoice Compliant? ({No, Yes}); <<objectSignal>>
if () then ([v2 = 'No'])
:Conduct Further Checks;
:Issue Can Be Resolved With Phone Call?;
:v3: Issue Can Be Resolved With Phone Call? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:Resolve Non-Compliance;
else ([v3 = 'No'])
:Return Invoice;
:Resolve Non-Compliance;
endif
else ([v2 = 'Yes'])
->;
endif
:Pay Invoice;
split
:Notify Client Of Payment;
:End Process;
stop
split again
:Bill Client;
:Client Satisfied?;
:v6: Client Satisfied? ({No response, No, Yes}); <<objectSignal>>
if () then ([v6 = 'No response'])
:Wait 10 Days;
:Send Reminder;
:End Process;
stop
else ([v6 = 'No'])
:Resolve Payment Discrepancy;
:End Process;
stop
endif
end split
endif
@enduml