      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the invoice is paid"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "branch:b7"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed:"
      ],
      "justification": "Explicitly declares a parallel split (AND gateway)."
    },
    {
