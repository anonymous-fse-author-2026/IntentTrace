    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Receive Invoice"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete,"
      ],
      "justification": "The conditional phrase opens the decision and supports the negative branch guard."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "it is returned."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "guard:b1->c_loop"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Matches the positive condition and explicitly mentions the process continuing, implying the converge."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant,"
      ],
      "justification": "The conditional establishes the check action, the split, and the branch for non-compliance."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "further checks are conducted."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Captures the positive compliant condition and the convergence point."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call,"
      ],
      "justification": "Captures the decision action, the decision branch, and the phone-call resolution guard."
    },
    {
      "refs": [
        "action:n10",
        "action:n15"
      ],
      "verbatim_texts": [
        "non-compliance is resolved."
      ],
      "justification": "Direct paraphrase supporting both instances of this action."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back,"
      ],
      "justification": "Captures the alternative condition guard."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
