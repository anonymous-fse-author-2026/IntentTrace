init(i1)
action(n1, "wake up")
branch(b1, XOR)
action(n3, "take a shower (A)")
action(n4, "have breakfast (A)")
branch(b2, XOR)
action(n6, "take a shower (B)")
action(n7, "have breakfast (B)")
action(n8, "get on the bus and complete process")
end(e1)
converge(c2)
defines(v1, "are you hungry?", {"yes", "no"})
defines(v2, "still not hungry after first action?", {"yes", "no"})
actor(a_default, "Default", [i1, n1, b1, n3, n4, b2, n6, n7, n8, e1, c2])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c2)
precedence(n4, b2)
precedence(b2, n6)
precedence(b2, n7)
precedence(n6, c2)
precedence(n7, e1)
precedence(c2, n8)
precedence(n8, e1)
guard(b1, n3, v1 == "no")
guard(b1, n4, v1 == "yes")
guard(b2, n6, v2 == "yes")
guard(b2, n7, v2 == "no")