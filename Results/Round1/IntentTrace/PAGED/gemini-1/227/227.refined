init(start)
converge(c1)
action(n1, "start with Insurance emergency")
action(n2, "analyze the insurance agreement")
branch(b1, XOR)
action(n4, "offer immediate help")
action(n5, "send out an offer for emergency help")
branch(b2, XOR)
action(n7, "ask for a rejection notification")
action(n8, "proceed with internal accounting")
converge(c2)
converge(c3)
branch(b3, XOR)
action(n12, "conclude the process")
end(e1)
defines(v1, "coverage", {"yes", "no"})
defines(v2, "offer status", {"rejected", "accepted"})
defines(v3, "repeat steps", {"yes", "no"})
actor(a_default, "Default", [start, c1, n1, n2, b1, n4, n5, b2, n7, n8, c2, c3, b3, n12, e1])
precedence(start, c1)
precedence(b3, c1)
precedence(c1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, b2)
precedence(b2, n7)
precedence(b2, n8)
precedence(n7, c2)
precedence(n8, c2)
precedence(n4, c3)
precedence(c2, c3)
precedence(c3, b3)
precedence(b3, n12)
precedence(n12, e1)
guard(b1, n4, v1 == "yes")
guard(b1, n5, v1 == "no")
guard(b2, n7, v2 == "rejected")
guard(b2, n8, v2 == "accepted")
guard(b3, c1, v3 == "yes")
guard(b3, n12, v3 == "no")