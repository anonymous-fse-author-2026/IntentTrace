init(i1)
action(n1, "Invoice arrives on Ground Floor")
action(n2, "Confirm payment possibility")
action(n3, "Can client pay?")
branch(b1, XOR)
action(n4, "Add cost centers and complete process")
action(n5, "End")
end(e1)
action(n6, "Reject invoice and return to client")
action(n7, "End")
end(e2)
defines(v1, "Can client pay?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, e1, n6, n7, e2])
precedence(i1, n1)
precedence(n3, b1)
precedence(n5, e1)
precedence(n7, e2)
precedence(n1, n2)
precedence(n2, n3)
precedence(b1, n4)
precedence(n4, n5)
precedence(b1, n6)
precedence(n6, n7)
guard(b1, n4, v1 = 'Yes')
guard(b1, n6, v1 = 'No')