action(n14, "receive invoice")
action(n15, "record invoice")
action(n16, "release funds for payment")
action(n17, "issue payment")
end(end_node)
converge(c1)
branch(b2, AND)
defines(v1, "is purchase order good?", {"Yes", "No"})
actor(a_default, "Default", [start_node, n1, n2, n3, n4, c_loop, n5, b1, n6, n7, n8, n9, n10, n10a, n11, n12, n13, n14, n15, n16, n17, end_node, c1, b2])
precedence(start_node, n1)
