init(i1)
action(n1, "start the process")
action(n2, "undergo immigration checks")
action(n3, "select the method for exit control checks")
branch(b1, XOR)
action(n4, "undergo a check using biometrics")
action(n5, "undergo checks using identity documents")
converge(c1)
branch(b2, XOR)
action(n6, "if the passenger is denied permission")
action(n7, "leave the area")
action(n9, "If the exit control check outcome is unsuccessful")
action(n8, "proceed to the next step")
action(n11, "continue to the next step")
converge(c2)
action(n10, "the process ends")
end(e1)

defines(v1, "method", {"biometrics", "ID documents"})
defines(v2, "permission", {"denied", "allowed"})

actor(a1, "Passenger", [i1, n1, n2, n3, b1, n4, n5, c1, b2, n6, n7, n9, n8, n11, c2, n10, e1])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, c1)
precedence(n5, c1)
precedence(c1, b2)
precedence(b2, n6)
precedence(b2, n8)
precedence(n6, n7)
precedence(n7, n9)
precedence(n9, c2)
precedence(n8, n11)
precedence(n11, c2)
precedence(c2, n10)
precedence(n10, e1)

guard(b1, n4, v1 == "biometrics")
guard(b1, n5, v1 == "ID documents")
guard(b2, n6, v2 == "denied")
guard(b2, n8, v2 == "allowed")