init(i1)
action(n1, "start the process by identifying the vacancy")
action(n2, "Is there a suitable candidate available")
branch(b1, XOR)
action(n3, "advertise the vacancy")
converge(c2)
action(n5, "Is there a suitable candidate available")
branch(b3, XOR)
action(n6, "advertise the vacancy again")
converge(c1)
action(n7, "select the appropriate applicant")
action(n8, "appoint the candidate")
action(n9, "process ends")
end(e1)
defines(v1, "Is there a suitable candidate available", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, c2, n5, b3, n6, c1, n7, n8, n9, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, c1)
precedence(n3, c2)
precedence(n6, c2)
precedence(c2, n5)
precedence(n5, b3)
precedence(b3, n6)
precedence(b3, c1)
precedence(c1, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, e1)
guard(b1, n3, v1 == "No")
guard(b1, c1, v1 == "Yes")
guard(b3, n6, v1 == "No")
guard(b3, c1, v1 == "Yes")