  "input_elements": [
    {
      "id": "i1",
      "content": "To initiate the Drop-off tech process"
    },
    {
      "id": "i2",
      "content": "the customer is first informed about canceling the order"
    },
    {
      "id": "i3",
      "content": "has the order already been fulfilled?"
    },
    {
      "id": "i4",
      "content": "If the answer is \"Yes,\""
    },
    {
      "id": "i5",
      "content": "the bag is marked as returned in IS"
    },
    {
      "id": "i6",
      "content": "However, if the answer is \"No,\""
    },
    {
      "id": "i7",
      "content": "the script(s) are marked as declined by the customer in IS"
    },
    {
      "id": "i8",
      "content": "If the bag is indeed returned"
    },
    {
      "id": "i9",
      "content": "it is marked as such in IS"
    },
    {
      "id": "i10",
      "content": "if the bag is not returned"
    },
    {
      "id": "i11",
      "content": "Once the bag is marked as returned in IS, the script bag is returned as well."
    },
    {
      "id": "i12",
      "content": "when the script(s) are marked as declined by the customer in IS, the script order is declined."
    },
    {
      "id": "i13",
      "content": "Finally, the customer notification is processed"
    },
    {
      "id": "i14",
      "content": "and the entire process comes to an end."
    }
  ]
