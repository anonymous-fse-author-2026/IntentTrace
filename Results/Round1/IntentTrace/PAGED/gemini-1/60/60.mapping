{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process"
      ],
      "justification": "Matches the implied initialization of the process."
    },
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "begin by clicking on \"Start\""
      ],
      "justification": "Matches the start and click start actions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "selecting \"Edit Report\""
      ],
      "justification": "Matches the action of selecting the edit report option."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the expense is"
      ],
      "justification": "Matches the implied action to check the expense and the resulting decision branch."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "greater than 1000"
      ],
      "justification": "Matches the upper condition for the expense."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the report should be reviewed"
      ],
      "justification": "Matches the review report action."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "is less than or equal to 1000"
      ],
      "justification": "Matches the lower condition for the expense."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check if there is a need for translation"
      ],
      "justification": "Matches the action to check translation need."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If translation is required"
      ],
      "justification": "Matches the translation decision branch and its positive condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "translate the receipts"
      ],
      "justification": "Matches the translation action."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Matches the negative condition for translation."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "confirm the receipts"
      ],
      "justification": "Matches the confirm receipts action."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After this"
      ],
      "justification": "Implicitly matches the converging of preceding paths."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "evaluate the review decision"
      ],
      "justification": "Matches the evaluation action."
    },
    {
      "refs": [
        "guard:b3->c_edit"
      ],
      "verbatim_texts": [
        "If the report is rejected"
      ],
      "justification": "Matches the branch and its rejection condition."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "edit the report"
      ],
      "justification": "Matches the edit action (and its associated converge node for loop routing)."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Matches the approved condition."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision"
      ],
      "justification": "Matches the secondary evaluation action."
    },
    {
      "refs": [
        "guard:b4->c_edit"
      ],
      "verbatim_texts": [
        "If the report is rejected"
      ],
      "justification": "Matches the second evaluation's branch and rejection condition."
    },
    {
      "refs": [
        "guard:b4->n12"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Matches the second evaluation's approved condition."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "translate the receipts"
      ],
      "justification": "Matches the second instance of the translate action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "confirm them"
      ],
      "justification": "Matches the second instance of the confirm action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "evaluate the receipts decision"
      ],
      "justification": "Matches the receipts decision evaluation action."
    },
    {
      "refs": [
        "guard:b5->n15"
      ],
      "verbatim_texts": [
        "If the receipts are accepted"
      ],
      "justification": "Matches the receipts branch and its accepted condition."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "process the expense"
      ],
      "justification": "Matches the process expense action."
    },
    {
      "refs": [
        "guard:b5->c_edit"
      ],
      "verbatim_texts": [
        "If they are rejected"
      ],
      "justification": "Matches the receipts rejection condition."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "ending it"
      ],
      "justification": "Matches the final step and structural end of the process."
    }
  ],
  "mutations": [],
  "omissions": [
    {
      "verbatim_texts": [
        "continue to check if there is a need for translation."
      ],
      "reason": "The text instructs to check for translation need if the report is approved at the first review, but the model skips this step and proceeds directly to evaluating the review decision again."
    }
  ],
