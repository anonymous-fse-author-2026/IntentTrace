init(i1)
action(n1, "start")
action(n2, "click: Start")
converge(c_loop)
action(n3, "select: Edit Report")
action(n4, "check expense")
branch(b1, XOR)
action(n5, "review report")
action(n6, "check translation need")
branch(b2, XOR)
action(n7, "translate receipts")
action(n8, "confirm receipts")
converge(c1)
action(n9, "evaluate the review decision")
branch(b3, XOR)
converge(c_edit)
action(n10, "edit the report")
action(n11, "Once again, evaluate the review decision")
branch(b4, XOR)
action(n12, "translate the receipts")
action(n13, "confirm the receipts")
action(n14, "evaluate the receipts decision")
branch(b5, XOR)
action(n15, "process the expense")
action(n17, "end")
end(e1)

defines(v1, "expense", {[0-]})
defines(v2, "check translation need", {"Yes", "No"})
defines(v3, "evaluate the review decision", {"Rejected", "Approved"})
defines(v4, "Once again, evaluate the review decision", {"Rejected", "Approved"})
defines(v5, "evaluate the receipts decision", {"Accepted", "Rejected"})

actor(a_default, "Default", [i1, n1, n2, c_loop, n3, n4, b1, n5, c1, n6, b2, n7, n8, n9, b3, c_edit, n10, n11, b4, n12, n13, n14, b5, n15, n17, e1])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, c_loop)
precedence(n10, c_loop)
precedence(c_loop, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n5)
precedence(b1, n6)
precedence(n6, b2)
precedence(b2, n7)
precedence(b2, n8)
precedence(n5, c1)
precedence(n7, c1)
precedence(n8, c1)
precedence(c1, n9)
precedence(n9, b3)
precedence(b3, c_edit)
precedence(b3, n11)
precedence(n11, b4)
precedence(b4, c_edit)
precedence(b4, n12)
precedence(n12, n13)
precedence(n13, n14)
precedence(n14, b5)
precedence(b5, c_edit)
precedence(b5, n15)
precedence(c_edit, n10)
precedence(n15, n17)
precedence(n17, e1)

guard(b1, n5, v1 > 1000)
guard(b1, n6, v1 <= 1000)
guard(b2, n7, v2 = 'Yes')
guard(b2, n8, v2 = 'No')
guard(b3, c_edit, v3 = 'Rejected')
guard(b3, n11, v3 = 'Approved')
guard(b4, c_edit, v4 = 'Rejected')
guard(b4, n12, v4 = 'Approved')
guard(b5, c_edit, v5 = 'Rejected')
guard(b5, n15, v5 = 'Accepted')