init(i1)
action(n1, "Start")
action(n_meet, "Informational meeting (half a day)")
action(n2, "Is the informational meeting successful?")
branch(b1, XOR)
action(n3, "Work on storyboard (full day)")
action(n_story_check, "Is the storyboard successful?")
branch(b_story, XOR)
action(n_end_story, "End Process")
end(e_story)
action(n4, "End Process")
end(e1)
branch(b4, AND)
action(n5, "Site design (10 days)")
action(n6, "Content preparation")
converge(c1)
action(n7, "Merge: Site design and content preparation completed")
action(n8, "Site development (2 days)")
action(n9, "Review process (1 day)")
action(n10, "Is the review successful?")
branch(b2, XOR)
action(n_end_rev, "End Process")
end(e_rev)
action(n11, "Approval stage (half a day)")
action(n_app_check, "Is the approval complete?")
branch(b_app, XOR)
action(n12, "End Process")
end(e2)
action(n13, "Rebuild site (3 days)")
action(n14, "Is the rebuild approved?")
branch(b3, XOR)
action(n15, "End Process")
end(e3)
action(n16, "Rebuild site again (3 days)")
end(e4)

defines(v1, "Is the informational meeting successful?", {"Yes", "No"})
defines(v_story, "Is the storyboard successful?", {"Yes", "No"})
defines(v2, "Is the review successful?", {"Yes", "No"})
defines(v_app, "Is the approval complete?", {"Yes", "No"})
defines(v3, "Is the rebuild approved?", {"Yes", "No"})

actor(a_default, "Default", [i1, n1, n_meet, n2, b1, n3, n_story_check, b_story, n_end_story, e_story, n4, e1, b4, n5, n6, c1, n7, n8, n9, n10, b2, n_end_rev, e_rev, n11, n_app_check, b_app, n12, e2, n13, n14, b3, n15, e3, n16, e4])

precedence(i1, n1)
precedence(n1, n_meet)
precedence(n_meet, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
guard(b1, n3, v1 == "Yes")
guard(b1, n4, v1 == "No")
precedence(n4, e1)

precedence(n3, n_story_check)
precedence(n_story_check, b_story)
precedence(b_story, b4)
precedence(b_story, n_end_story)
guard(b_story, b4, v_story == "Yes")
guard(b_story, n_end_story, v_story == "No")
precedence(n_end_story, e_story)

precedence(b4, n5)
precedence(b4, n6)
precedence(n5, c1)
precedence(n6, c1)
precedence(c1, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, n10)
precedence(n10, b2)

precedence(b2, n11)
precedence(b2, n_end_rev)
guard(b2, n11, v2 == "Yes")
guard(b2, n_end_rev, v2 == "No")
precedence(n_end_rev, e_rev)

precedence(n11, n_app_check)
precedence(n_app_check, b_app)
precedence(b_app, n12)
precedence(b_app, n13)
guard(b_app, n12, v_app == "Yes")
guard(b_app, n13, v_app == "No")
precedence(n12, e2)

precedence(n13, n14)
precedence(n14, b3)
precedence(b3, n15)
precedence(b3, n16)
guard(b3, n15, v3 == "Yes")
guard(b3, n16, v3 == "No")
precedence(n15, e3)

precedence(n16, e4)