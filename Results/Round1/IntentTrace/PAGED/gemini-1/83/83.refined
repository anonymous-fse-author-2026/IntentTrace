init(i1)
action(n1, "Start Rental Items Return Process")
action(n2, "Are items returned by Customer to Store")
action(n4, "Are items picked up by Delivery Crew at Event Site")
branch(b1, XOR)
action(n3, "Continue process after Customer returns items")
action(n5, "Continue process after Delivery Crew picks up items")
converge(c1)
action(n6, "Count items and compare to original contract")
action(n7, "Is Order complete and all items returned")
action(n9, "Is the Order incomplete and items missing")
action(n11, "Is Order complete but items damaged")
branch(b3, XOR)
action(n8, "Proceed with process for complete order")
action(n10, "Proceed with process for incomplete order")
action(n12, "Email customer informing about damage and additional charges")
action(n13, "Do items get packed for existing order")
action(n15, "Do items get stored for future orders")
branch(b6, XOR)
action(n14, "Continue process for items packed for existing order")
action(n16, "Continue process for items stored for future orders")
converge(c2)
action(n17, "Are there missing items and replacement charges")
action(n18, "Email customer for missing items and replacement charges")
action(n21, "Did customer return missing items")
branch(b10, XOR)
action(n22, "Continue process after customer returns missing items")
action(n23, "Continue process when customer does not return missing items")
converge(c3)
action(n19, "Are there damaged items and additional charges")
action(n20, "Temporarily remove damaged items from inventory")
action(n24, "Is items repaired and added into inventory")
action(n26, "Are items can't be repaired and are discarded")
branch(b9, XOR)
action(n25, "Continue process after items repaired and added into inventory")
action(n27, "Email customer with replacement charges for discarded items")
action(n28, "Do items get packed for existing order (final)")
action(n30, "Do items get stored for future orders (final)")
branch(b13, XOR)
action(n29, "Continue process for items packed for existing order (final)")
action(n31, "Continue process for items stored for future orders (final)")
converge(c4)
action(n32, "Email customer with replacement charges (final)")
converge(c5)
action(n33, "End of Rental Items Return Process")
end(e1)
