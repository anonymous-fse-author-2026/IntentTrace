@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the flickr login process;
:provide userdata for flickr;
:v1: login status ({Successful, Fails}); <<objectSignal>>
if () then ([v1 = 'Successful'])
:end process successful login;
stop
else ([v1 = 'Fails'])
:do you want to try again;
:v2: try again ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:provide userdata for flickr again after first failure;
:do you want to try again after second failure;
:v4: try again after second failure ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:provide userdata for flickr again after second failure;
else ([v4 = 'No'])
:if you decide to abort;
stop
endif
else ([v2 = 'No'])
:abort process after first failure;
stop
endif
endif
@enduml