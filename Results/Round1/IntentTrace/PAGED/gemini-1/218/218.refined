init(i1)
action(n1, "start the expenses process for MyCorp")
action(n2, "enter expenses")
action(n3, "generate spreadsheet")
action(n4, "is the request approved")
branch(b1, XOR)
action(n5, "pay out expenses")
action(n7, "is the request approved")
branch(b2, XOR)
action(n8, "pay out expenses")
action(n10, "end the expenses process")
end(e1)
converge(c1)
defines(v1, "is the request approved", {"Approved", "Not Approved"})
defines(v2, "is the request approved", {"Approved", "Not Approved"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, n7, b2, n8, n10, e1, c1])
precedence(i1, n1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n5)
precedence(b1, c1)
precedence(n5, n7)
precedence(n7, b2)
precedence(b2, n8)
precedence(b2, c1)
precedence(n8, n10)
precedence(n10, e1)
guard(b1, n5, v1 == "Approved")
guard(b1, c1, v1 == "Not Approved")
guard(b2, n8, v2 == "Approved")
guard(b2, c1, v2 == "Not Approved")
label(b1, c1, "Not Approved")
label(b2, c1, "Not Approved")