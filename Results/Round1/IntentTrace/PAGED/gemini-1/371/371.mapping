      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\""
      ],
      "justification": "The text initiates the process and explicitly describes starting, clicking start, and selecting edit report."
    },
    {
