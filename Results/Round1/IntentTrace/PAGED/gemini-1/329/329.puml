start
:start processing incoming orders;
:order received;
:send the collected order list;
:implement collected order list in database;
:gather all information in one excel file;
:check the order and customer details;
:v1: is permit data option selected ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:is permit data option selected;
:permit the data;
:release the data if permitted;
else ([v1 = 'No'])
:not permit the data;
:contact the selling agency if not permitted;
endif
:check the worth of the orders;
:v1: is permit data option selected ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'No'])
:v2: should orders be released ({Release, Cancel}); <<objectSignal>>
if () then ([v2 = 'Release'])
:should orders be released;
:continue with the process;
else ([v2 = 'Cancel'])
:end process;
stop
endif
else ([v1 = 'Yes'])
->;
endif
:v3: is order worth less than 5000 ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:is order worth less than 5000;
:continue with process;
else ([v3 = 'No'])
:order signed off by board of directors;
endif
:collect the order and start production;
:v4: production path ({Path1, Path2, Path3}); <<objectSignal>>
switch ()
case ([v4 = 'Path1'])
:send the memorandum and invoice;
:send the quality report;
stop
case ([v4 = 'Path2'])
:check the quality of production;
:send the quality report again;
stop
case ([v4 = 'Path3'])
:collect the goods;
:sign off on the memorandum;
:pick the goods;
:send the goods to complete the process;
:end of process;
stop
