init(i1)
action(n2, "look at the order")
branch(b1, XOR)
action(n_cont_rej, "the process should continue")
end(e1)
branch(b_and, AND)
action(n4, "preparing the assembling order")
action(n5, "checking availability")
branch(b2, XOR)
action(n7, "availability needs to be checked again")
branch(b3, XOR)
action(n8, "the process ends")
end(e_loop)
action(n_cont, "the process should continue")
converge(c2)
action(n9, "assemble the bike")
action(n10, "ship the product")
end(e2)
defines(v1, "order status", {"Accepted", "Rejected"})
defines(v2, "backorder?", {"Yes", "No"})
defines(v3, "check again", {"Loop", "End"})
actor(a_default, "Default", [i1, n2, b1, n_cont_rej, e1, b_and, n4, n5, b2, n7, b3, n8, e_loop, n_cont, c2, n9, n10, e2])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n_cont_rej)
precedence(n_cont_rej, e1)
precedence(b1, b_and)
precedence(b_and, n4)
precedence(b_and, n5)
precedence(n4, c2)
precedence(n5, b2)
precedence(b2, n7)
precedence(n7, b3)
precedence(b3, n5)
precedence(b3, n8)
precedence(n8, e_loop)
precedence(b2, n_cont)
precedence(n_cont, c2)
precedence(c2, n9)
precedence(n9, n10)
precedence(n10, e2)
guard(b1, b_and, v1 = 'Accepted')
guard(b1, n_cont_rej, v1 = 'Rejected')
guard(b2, n7, v2 = 'Yes')
guard(b2, n_cont, v2 = 'No')
guard(b3, n5, v3 = 'Loop')
guard(b3, n8, v3 = 'End')