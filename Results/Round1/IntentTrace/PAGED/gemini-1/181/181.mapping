      ],
      "justification": "Action describing sending documentation and approval."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Action matching exactly."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Redundant action that faithfully matches the text."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
