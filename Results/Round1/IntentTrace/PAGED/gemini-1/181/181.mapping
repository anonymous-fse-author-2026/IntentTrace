      ],
      "justification": "Action of HR receiving the documents."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "this marks the end of the process."
      ],
      "justification": "Process end modeled as both an action and a structural end node."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Conditional branch and continuation action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "if there are variations, a business case is completed."
      ],
      "justification": "Alternate branch action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Second instance of conditional branch and continuation action."
    },
    {
