{
  "matches": [
    {
      "refs": [
        "action:n2",
        "guard:b1->n2"
      ],
      "verbatim_texts": [
        "Initially, if the option \"research schedule directly\" is selected"
      ],
      "justification": "Initiates the process, establishes the XOR branch, and specifies the condition for the positive path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the action to be taken is \"Research schedule\""
      ],
      "justification": "Direct paraphrase of the action on the positive arm."
    },
    {
      "refs": [
        "guard:b1->n25"
      ],
      "verbatim_texts": [
        "If the option is not selected"
      ],
      "justification": "Condition for the negative path."
    },
    {
      "refs": [
        "action:n25",
        "action:n4",
        "action:n11"
      ],
      "verbatim_texts": [
        "then \"provide indications\""
      ],
      "justification": "Direct mapping to the indication actions."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "proceed with the research schedule"
      ],
      "justification": "Direct mapping to the action following the indications."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule"
      ],
      "justification": "Direct mapping to the validation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory"
      ],
      "justification": "Establishes the check and the XOR branch."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Condition for the negative path."
    },
    {
      "refs": [
        "action:n5",
        "action:n9"
      ],
      "verbatim_texts": [
        "perform the action \"Research schedule\""
      ],
      "justification": "Maps to the recurring research schedule actions in the negative loops."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "If it is"
      ],
      "justification": "Condition for the positive path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed with writing a ticket order to SNCF",
        "write a ticket order to SNCF"
      ],
      "justification": "Maps to the ticket ordering action and implied convergence from the repeated condition."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory"
      ],
      "justification": "Condition for the next step of the negative loop."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory"
      ],
      "justification": "Condition exiting the loop."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it"
      ],
      "justification": "Implicit convergence after the writing step, flowing into validation."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved"
      ],
      "justification": "Establishes the check and the XOR branch."
    },
    {
      "refs": [
        "guard:b4->n15",
        "guard:b5->n18",
        "guard:b6->n22"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Conditions for the negative paths leading to termination."
    },
    {
      "refs": [
        "action:n15",
        "action:n18",
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "then the process ends"
      ],
      "justification": "Direct mapping to the end states described in the text."
    },
    {
      "refs": [
        "guard:b4->n16",
        "guard:b5->n19"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Conditions for the positive paths."
    },
    {
      "refs": [
        "action:n16",
        "action:n19"
      ],
      "verbatim_texts": [
        "validate the ticket order"
      ],
      "justification": "Direct mapping to the repeated validation steps."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved"
      ],
      "justification": "Establishes the check and the XOR branch."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved"
      ],
      "justification": "Establishes the final check and the XOR branch."
    },
    {
      "refs": [
        "guard:b6->n21"
      ],
      "verbatim_texts": [
        "If it is"
      ],
      "justification": "Final positive condition leading to process end."
    }
