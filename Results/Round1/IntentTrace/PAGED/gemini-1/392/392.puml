@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start User Task;
:v1: User Task ({Service Task 1, Service Task 2, Service Task 3}); <<objectSignal>>
switch ()
case ([v1 = "Service Task 1"])
:Continue Process after Service Task 1;
:Is there a Manual Task?;
:v3: Manual Task ({Yes, No}); <<objectSignal>>
if () then ([v3 = "Yes"])
:End Process if Manual Task Yes;
stop
else ([v3 = "No"])
stop
endif
case ([v1 = "Service Task 2"])
:Continue Process after Service Task 2;
case ([v1 = "Service Task 3"])
:End Process due to Service Task 3;
stop
endswitch
@enduml