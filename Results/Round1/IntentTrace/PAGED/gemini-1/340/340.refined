init(i1)
action(n1, "the first step")
action(n2, "identify the parts")
branch(b1, XOR)
action(n4, "check the availability of the parts")
action(n13, "proceed with the process")
converge(c1)
branch(b2, XOR)
action(n8, "record the customer's details")
action(n14, "order")
action(n7, "receive the part from Disuki")
action(n9, "Once the part is received, the team can then contract the customer")
converge(c2)
action(n10, "After all the necessary parts are collected")
action(n11, "proceed with the payment")
action(n12, "Once the payment is made, the process comes to an end.")
end(e1)
defines(v1, "availability info", {"Need to elicit information", "already have the availability information"})
defines(v2, "customer details", {"Parts are supplied to the customer", "need to record the customer details"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, n13, c1, b2, n8, n14, n7, n9, c2, n10, n11, n12, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n13)
precedence(n4, c1)
precedence(n13, c1)
precedence(c1, b2)
precedence(b2, c2)
precedence(b2, n8)
precedence(n8, n14)
precedence(n14, n7)
precedence(n7, n9)
precedence(n9, c2)
precedence(c2, n10)
precedence(n10, n11)
precedence(n11, n12)
precedence(n12, e1)
guard(b1, n4, v1 = 'Need to elicit information')
guard(b1, n13, v1 = 'already have the availability information')
guard(b2, c2, v2 = 'Parts are supplied to the customer')
guard(b2, n8, v2 = 'need to record the customer details')
label(n1, n2, "Identify the parts")
label(n10, n11, "Proceed to payment step")
label(n11, n12, "Payment completed")