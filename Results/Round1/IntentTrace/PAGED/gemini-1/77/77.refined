converge(c2)
action(n18, "perform work according to your assigned role")
action(n19, "Check the progress and consult any problems that arise")
action(n20, "If the project is accepted")
branch(b7, XOR)
action(n21, "present it")
action(n22, "continue working according to your role")
action(n26, "present it again")
action(n24, "Finally, present the project")
action(n27, "the process will come to an end")
end(e1)

defines(v1, "If the process model is NOT OK", {"Yes", "No"})
defines(v2, "If it is still NOT OK", {"Yes", "No"})
defines(v7, "If the project is accepted", {"Yes", "No"})

actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, n6, b2, n7, c1, n8, n10, n11, n12, n13, n14, n15, n16, c2, n18, n19, n20, b7, n21, n22, n26, n24, n27, e1])

