@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start the resupply process;
:Check inventory level;
:v1: Is inventory level at or below minimum ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:End process due to sufficient inventory;
stop
else ([v1 = 'Yes'])
:Create purchase order;
repeat :Review purchase order;
:v2: Is purchase status rejected ({Yes, No}); <<objectSignal>>
backward:Rework purchase order;
repeat while () is ([v2 = 'Yes']) not ([v2 = 'No'])
:Reserve funds after first approval;
:Send order to supplier after first approval;
split
:Receive packing slip;
:Record packing slip;
:End after recording packing slip;
stop
split again
:Receive invoice;
:Record invoice;
:End after recording invoice;
stop
end split
endif
@enduml