init(i1)
action(n1, "start")
action(n2, "receive claim")
action(n3, "create and record claim")
action(n4, "decide on claim")
branch(b1, XOR)
action(n5, "reject claim")
action(n6, "review rejection")
action(n9, "accept claim")
action(n10, "offer benefit")
action(n11, "prepare discharge")
action(n12, "record payment")
converge(c1)
branch(b2, XOR)
action(n15, "process ends")
end(e1)
action(n7, "operate outgoing payment")
action(n8, "close the claim")
end(e2)
defines(v1, "decide on claim", {"No", "Yes"})
defines(v2, "termination mode", {"Direct", "Payment"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, n6, n9, n10, n11, n12, c1, b2, n15, e1, n7, n8, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n5)
guard(b1, n5, v1 = 'No')
precedence(n5, n6)
precedence(n6, c1)
precedence(b1, n9)
guard(b1, n9, v1 = 'Yes')
precedence(n9, n10)
precedence(n10, n11)
precedence(n11, n12)
precedence(n12, c1)
precedence(c1, b2)
precedence(b2, n15)
guard(b2, n15, v2 = 'Direct')
precedence(n15, e1)
precedence(b2, n7)
guard(b2, n7, v2 = 'Payment')
precedence(n7, n8)
precedence(n8, e2)