@startuml
!theme plain
|a_default| Default
|a_default|
start
:choose destination and calculate distance;
:check if need to book train or flight;
:v1: check if need to book train or flight ({yes, no}); <<objectSignal>>
if () then ([v1 = "no"])
:book a train;
:check if code is available within 24 hours (train);
:v2: check if code is available within 24 hours (train) ({yes, no}); <<objectSignal>>
if () then ([v2 = "yes"])
:code available within 24 hours (train);
:along with the hotel reservation;
stop
else ([v2 = "no"])
:call travel agency (train);
:cancel journey;
stop
endif
else ([v1 = "yes"])
:book a flight;
:check if code is available within 24 hours (flight);
:v3: check if code is available within 24 hours (flight) ({yes, no}); <<objectSignal>>
if () then ([v3 = "yes"])
:code available within 24 hours (flight);
:along with the hotel reservation;
stop
else ([v3 = "no"])
:call travel agency (flight);
:cancel journey;
stop
endif
endif
@enduml