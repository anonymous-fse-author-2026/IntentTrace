{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we receive the contract for the marketing campaign."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial receipt action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once we have the contract, we take it to the department."
      ],
      "justification": "Direct paraphrase of the second step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "In the next step, we input the customer's details into NKE."
      ],
      "justification": "Direct paraphrase of the data entry step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the customer's details"
      ],
      "justification": "Introduces the conditional decision point."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "are missing"
      ],
      "justification": "Captures the condition/operator for the first branch path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "we contact the customers"
      ],
      "justification": "Action taken when details are missing; model adds descriptive context without changing core meaning."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "However, if the customer's details are ready"
      ],
      "justification": "Condition for the alternative branch path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "we create a suitable team"
      ],
      "justification": "Action taken when details are ready."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After contacting the customers, we receive additional customer details."
      ],
      "justification": "Describes the follow-up action on the missing-details path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "check previous campaigns for reusable material"
      ],
      "justification": "Direct extraction of the research step from the compound sentence."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Upon finding reusable ideas from previous campaigns, we create a new concept."
      ],
      "justification": "Covers both the trigger condition and the subsequent creation action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the new concept is created, we integrate new ideas and add further points."
      ],
      "justification": "Direct paraphrase of the refinement step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Next, we integrate the revised campaign into the database."
      ],
      "justification": "Direct paraphrase of the database integration step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The concept is then presented to the relevant party for consideration."
      ],
      "justification": "Direct paraphrase of the internal review/presentation step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the concept"
      ],
      "justification": "Introduces the second decision point regarding acceptance."
    },
    {
      "refs": [
        "guard:b3->n16"
      ],
      "verbatim_texts": [
        "is declined"
      ],
      "justification": "Condition for the rejection path."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "we rework it"
      ],
      "justification": "Direct paraphrase of the revision action."
    },
    {
      "refs": [
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "On the other hand, if the concept is accepted"
      ],
      "justification": "Condition for the approval path."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "we proceed to present it to the customer"
      ],
      "justification": "Direct paraphrase of the final external presentation step."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "This marks the end of the process."
      ],
      "justification": "Explicit closing statement mapping to the process end node."
    }
