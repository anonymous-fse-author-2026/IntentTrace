  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start with Password Verification, followed by Verifiy Password."
    },
    {
      "id": "i2",
      "content": "If you choose \"Select Cancel\", you will be directed to iforgot.apple.com. However, if you select \"Reset password\", you will be automatically directed to iforgot.apple.com. In case you choose \"Retry\", you will need to re-enter your password."
    },
    {
      "id": "i3",
      "content": "choose \"Select Cancel\""
    },
    {
      "id": "i4",
      "content": "directed to iforgot.apple.com"
    },
    {
      "id": "i5",
      "content": "select \"Reset password\""
    },
    {
      "id": "i6",
      "content": "automatically directed to iforgot.apple.com"
    },
    {
      "id": "i7",
      "content": "choose \"Retry\""
    },
    {
      "id": "i8",
      "content": "re-enter your password"
    },
    {
      "id": "i9",
      "content": "After that, go to iforgot.apple.com and proceed with Reset Password."
    },
    {
      "id": "i10",
      "content": "then verify it"
    },
    {
      "id": "i11",
      "content": "Once the password is reset, you can return to the iTunes purchases page."
    },
    {
      "id": "i12",
      "content": "select the price of the item."
    },
    {
      "id": "i13",
      "content": "If prompted to \"Enter Password\", verify the password. Alternatively, if asked to \"Enter Apple ID\", enter the password."
    },
    {
      "id": "i14",
      "content": "prompted to \"Enter Password\""
    },
    {
      "id": "i15",
      "content": "verify the password"
    },
    {
      "id": "i16",
      "content": "asked to \"Enter Apple ID\""
    },
    {
      "id": "i17",
      "content": "enter the password"
    },
    {
      "id": "i18",
      "content": "Finally, enter the password and verify it."
    }
  ]
