  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, the customer needs to make a purchase and then connect to the website."
    },
    {
      "id": "i2",
      "content": "they should search for an item"
    },
    {
      "id": "i3",
      "content": "If they choose to"
    },
    {
      "id": "i4",
      "content": "If they choose to \"Add item to cart\""
    },
    {
      "id": "i5",
      "content": "they can proceed to checkout"
    },
    {
      "id": "i6",
      "content": "if they select \"Continue Shopping\""
    },
    {
      "id": "i7",
      "content": "they should continue with the process"
    },
    {
      "id": "i8",
      "content": "they need to enter their address, shipping method, and payment information"
    },
    {
      "id": "i9",
      "content": "they should also authorize the credit card and check the inventory levels"
    },
    {
      "id": "i10",
      "content": "If the credit card is approved and there is inventory in stock"
    },
    {
      "id": "i11",
      "content": "However, if the credit card is denied or there is no inventory in stock, the transaction will end."
    },
    {
      "id": "i12",
      "content": "the order confirmation number should be displayed"
    },
    {
      "id": "i13",
      "content": "the final order being shown to the customer"
    },
    {
      "id": "i14",
      "content": "the order should be confirmed and a confirmation notice should be emailed to the customer"
    },
    {
      "id": "i15",
      "content": "Once the order entry is complete, the process will end."
    }
  ]
