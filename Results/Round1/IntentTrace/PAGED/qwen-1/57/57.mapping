      "verbatim_texts": [
        "To begin the process, the customer needs to make a purchase and then connect to the website."
      ],
      "justification": "Opening clause implicitly triggers the process start; the remainder describes the initial action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "they should search for an item"
      ],
      "justification": "Direct paraphrase of the next sequential step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If they choose to"
