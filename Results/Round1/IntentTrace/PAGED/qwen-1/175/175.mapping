{
  "matches": [
    {
      "refs": [
        "action:a_return"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "The opening clause implicitly signals the start node and directly describes the initial return action."
    },
    {
      "refs": [
        "guard:b_method->a_cust_ret",
        "action:a_cust_ret"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process."
      ],
      "justification": "Conditional introduces the XOR decision point; guard abstracts the routing condition; action restates the positive path."
    },
    {
      "refs": [
        "guard:b_method->a_crew_pick",
        "action:a_crew_pick"
      ],
      "verbatim_texts": [
        "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Covers the alternative pickup method; both branches implicitly rejoin at the converge node."
    },
    {
      "refs": [
        "action:a_compare"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct paraphrase of the verification/counting step."
    },
    {
      "refs": [
        "guard:b_status->a_complete",
        "action:a_complete"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process."
      ],
      "justification": "Establishes the status evaluation gateway; guard and action align with the fully returned condition."
    },
    {
      "refs": [
        "guard:b_status->a_incomplete",
        "action:a_incomplete"
      ],
      "verbatim_texts": [
        "However, if the \"Order is incomplete and items are missing,\" we still continue the process."
      ],
      "justification": "Matches the negative/incomplete order path exactly."
    },
    {
      "refs": [
        "guard:b_status->a_damaged",
        "action:a_damaged"
      ],
      "verbatim_texts": [
        "Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Captures the damaged-item condition and the immediate customer notification step."
    },
    {
      "refs": [
        "guard:b_comp_act->a_pack1",
        "action:a_pack1"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Splits flow based on whether packing occurs immediately."
    },
    {
      "refs": [
        "guard:b_comp_act->a_store1",
        "action:a_store1"
      ],
      "verbatim_texts": [
        "Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Alternative storage path merges back with the packing path."
    },
    {
      "refs": [
        "action:a_email_miss"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Exact match for the missing-items notification action."
    },
    {
      "refs": [
        "action:a_take_inv"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Directly models the inventory-removal step for damaged goods."
    },
    {
      "refs": [
        "guard:b_miss_ret->a_miss_yes",
        "action:a_miss_yes"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process."
      ],
      "justification": "Introduces decision on missing-item return; guard routes the positive outcome."
    },
    {
      "refs": [
        "guard:b_miss_ret->a_miss_no",
        "action:a_miss_no"
      ],
      "verbatim_texts": [
        "However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Covers the non-return path; both outcomes rejoin at the converge node."
    },
    {
      "refs": [
        "guard:b_repair->a_repaired",
        "action:a_repaired"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process."
      ],
      "justification": "Branch evaluates repair outcome; guard and action cover the successful repair path."
    },
    {
      "refs": [
        "guard:b_repair->a_discarded",
        "action:a_discarded"
      ],
      "verbatim_texts": [
        "On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Matches the discard condition and associated billing notification."
    },
    {
      "refs": [
        "action:a_pack2"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order."
      ],
      "justification": "Direct restatement of the final packing action."
    },
    {
      "refs": [
        "guard:b_rep_act->a_pack2"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Re-evaluates disposition; guard routes to the pack action based on the condition."
    },
    {
      "refs": [
        "guard:b_rep_act->a_store2",
        "action:a_store2"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Storage alternative merges flows back together."
    },
    {
      "refs": [
        "end:e_rep"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Explicit secondary termination point in the narrative."
    },
    {
      "refs": [
        "action:a_email_rep"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges, and the process is complete."
      ],
      "justification": "Combines the final billing email action with the concluding end state."
    }
  ],
