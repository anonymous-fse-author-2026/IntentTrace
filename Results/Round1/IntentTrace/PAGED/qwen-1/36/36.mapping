{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially"
      ],
      "justification": "The opening phrase implicitly starts the process and describes the initial setup step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Direct mapping of the first conditional check action."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\""
      ],
      "justification": "Conditional clause triggers the XOR branch and the positive guard."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Direct paraphrase of the positive arm action."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Negative path guard leads to the convergence point where flows rejoin."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Direct mapping of the second conditional check."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\""
      ],
      "justification": "Conditional clause triggers the second XOR branch and positive guard."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then continue to check if the change is within the set client limits."
      ],
      "justification": "Direct mapping of the limit verification step."
    },
    {
      "refs": [
        "guard:b3->n6"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Negative condition guard for exceeding limits."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "relay the applicant's changes."
      ],
      "justification": "Direct mapping of the relay action on the negative path."
    },
    {
      "refs": [
        "guard:b3->n7"
      ],
      "verbatim_texts": [
        "If it is within the limits"
      ],
      "justification": "Positive condition guard for staying within limits."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "continue with the process. After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Combines the continuation and relay steps described in the source."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Direct mapping of the approval step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Direct mapping of the modification step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Direct mapping of the documentation sending step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Direct mapping of the scanning and uploading step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Direct mapping of the formal offer step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Direct mapping of the acceptability check."
    },
    {
      "refs": [
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If they are"
      ],
      "justification": "Conditional clause triggers the fourth XOR branch and positive guard."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Direct mapping of the continuation on the positive path."
    },
    {
      "refs": [
        "guard:b4->n15"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Negative condition guard for unacceptable changes."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "select a new applicant from the list."
      ],
      "justification": "Direct mapping of the selection step on the negative path."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Direct mapping of the client acceptance check."
    },
    {
      "refs": [
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "If they do"
      ],
      "justification": "Conditional clause triggers the fifth XOR branch and positive guard."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Explicit termination step and corresponding end node."
    },
    {
      "refs": [
        "guard:b5->n18"
      ],
      "verbatim_texts": [
        "Otherwise"
      ],
      "justification": "Negative condition guard for client rejection."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "select a new candidate from the list."
      ],
      "justification": "Direct mapping of the candidate selection step."
    },
    {
