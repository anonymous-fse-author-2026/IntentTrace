{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Initially"
      ],
      "justification": "Process initiation and generic start step aligned with the opening temporal marker."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected, then the action to be taken is \"Research schedule\""
      ],
      "justification": "XOR decision, positive guard, and corresponding research action faithfully restated."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Negative guard routes to providing indications followed by proceeding with research schedule."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Validation step and satisfactoriness check condition leading to the next decision point."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Negative path from the first satisfactoriness check triggers the research schedule action."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Positive path merges and executes the ticket order writing action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\"."
      ],
      "justification": "Secondary evaluation of schedule status modeled as a condition-action and branching node."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Second failure condition correctly routes to providing indications."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Alternative success path rejoins the main flow prior to ticket generation."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Direct post-creation validation step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Approval verification condition and associated decision gateway."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "First rejection outcome terminates the workflow."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Approval outcome leads to ticket validation."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Repeated approval check condition and decision node."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Second rejection outcome terminates the workflow."
    },
    {
      "refs": [
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Repeated approval leads to another validation step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Final approval check condition and decision node."
    },
    {
      "refs": [
        "guard:b6->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Final success outcome terminates the workflow."
    },
    {
      "refs": [
        "guard:b6->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Final failure outcome terminates the workflow."
    }
