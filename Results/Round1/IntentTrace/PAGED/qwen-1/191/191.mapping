{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "The opening phrase implicitly starts the process and directly describes the first registration action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If there is no fee",
        "However, if there is a fee"
      ],
      "justification": "The conditional clauses justify the explicit check action modeling the fee evaluation."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request. However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "The dual conditional paths imply an exclusive choice (XOR) branch."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request."
      ],
      "justification": "The guard captures the 'no fee' condition (modeled as v1='No'), and the action matches the registration step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "The guard captures the 'fee exists' condition (modeled as v1='Yes'), and the action matches creating the purchase request."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Describes the termination action for the no-fee path and implies the structural end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Directly matches the approval verification step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification. On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "The mutually exclusive approval and rejection outcomes imply a second XOR branch."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "The guard captures the approval condition (v2='Approved') and the action matches receiving the notification."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "The guard captures the rejection condition (v2='Rejected') and the action matches being notified of it."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Faithfully restates the post-approval registration step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "The rejection leads to process termination; combined with the earlier end condition, it justifies the convergence of terminal paths and the final end node."
    }
  ],
