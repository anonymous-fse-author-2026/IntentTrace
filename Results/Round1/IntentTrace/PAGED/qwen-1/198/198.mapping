  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "The opening clause implicitly initiates the workflow, covers the generic start action, and directly describes the initial identification step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer, they should then check the availability of the parts."
      ],
      "justification": "Captures the XOR decision split, models the elicitation condition as both an action and guard per the generated structure, and maps to the subsequent availability check action."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "if they already have the availability information, they can proceed with the process."
      ],
      "justification": "Maps the pre-existing information condition to the guard and represents the implicit rejoining of parallel/alternative paths at the converge node."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer, the team can also continue with the process."
      ],
      "justification": "Direct mapping of the supply condition stated in the action and its corresponding path guard."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if they need to record the customer's details, they should order and receive the part from Disuki."
      ],
      "justification": "Accurately reflects the customer detail recording condition guard and the explicit ordering/receiving action from the vendor."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "Direct paraphrase of the customer contracting step that occurs after part receipt."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected, the team can proceed with the payment."
      ],
      "justification": "Exact match for the payment progression step following collection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "Explicitly covers the final concluding action and the structural process termination."
    }
  ],
