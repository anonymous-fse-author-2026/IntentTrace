{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For developers practicing BPMN execution TDD, the first step is to understand the BPMN Model."
      ],
      "justification": "Implicit process start and the first required action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, they should write a failing test."
      ],
      "justification": "Direct match of the second step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "To make the test pass, they need to extend BPMN/mocks."
      ],
      "justification": "Direct paraphrase of the mock extension step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the test is green"
      ],
      "justification": "Models the condition and implicit XOR decision point."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the test is not green"
      ],
      "justification": "Models the alternative condition for the same decision point."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "Once the test is green"
      ],
      "justification": "Guard captures the positive outcome path."
    },
    {
      "refs": [
        "guard:b1->n10"
      ],
      "verbatim_texts": [
        "If the test is not green"
      ],
      "justification": "Guard captures the negative outcome path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should check if the level satisfies the project requirements."
      ],
      "justification": "Direct match of the requirement check step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If it does, the process ends. If not, they should continue the process."
      ],
      "justification": "Captures the requirement evaluation and subsequent decision gateway."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it does"
      ],
      "justification": "Reflects the affirmative outcome leading to termination."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Direct match for the process termination step."
    },
    {
