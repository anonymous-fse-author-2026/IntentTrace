  "mutations": [
    {
      "refs": [
        "guard:b2->n13"
      ],
      "verbatim_texts": [
        "If the review is successful"
      ],
      "reason": "This guard evaluates the negative condition for the review branch (b2) and routes to 'Rebuild site'. However, the source explicitly states that rebuilding occurs only if 'the approval is rejected', not if the review fails. The guard incorrectly binds the rebuild trigger to the wrong decision node."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "However, if the approval is rejected"
      ],
      "reason": "The source clearly describes a conditional split immediately after the approval stage (complete vs. rejected). The model lacks a corresponding branch element and routing guards after the approval action, causing the rejection logic to be misplaced under the review branch instead."
    }
  ],
