{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, for CAB, the first step is to assess the change request."
      ],
      "justification": "Implicit process start and the first action are fully covered by the opening clause."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the affected systems for any impacts on the business unit"
      ],
      "justification": "Direct match for the system impact verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "determine whether the change request should be approved or not"
      ],
      "justification": "Describes the decision step and implicitly triggers the XOR branch."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the change request should be approved in its current state, then it is approved."
      ],
      "justification": "Condition guard and resulting approval action align with the text."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the change is implemented."
      ],
      "justification": "Implementation action and path termination match the source exactly."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the change request should not be approved in its current state, further evaluation is needed to determine if the change will be acceptable with more information provided"
      ],
      "justification": "Negative condition and subsequent re-evaluation action are directly supported."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "if the change is deemed unacceptable, it is rejected."
      ],
      "justification": "Branch, guard, rejection action, and endpoint map to the unacceptability clause."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "In this case, a request for more information is made to the Change Coordinator."
      ],
      "justification": "The alternative path to rejection correctly routes to the information request."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The request is then followed by an email enquiry to the Change Coordinator."
      ],
      "justification": "Direct match for the follow-up email step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the approval register is updated within a timeframe of 3 business days."
      ],
      "justification": "Preserves the exact action and specified timeframe."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The email enquiry is also forwarded to the Change Requester."
      ],
      "justification": "Direct match for forwarding the enquiry to the requester."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If there are no further inquiries or issues, the process concludes after 3 business days."
      ],
      "justification": "Flow convergence, condition check, no-inquiry status, process conclusion, and endpoint are all justified by this sentence."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "if there are inquiries from the CAB, a response is expected within 1-3 business days."
      ],
      "justification": "Conditional guard and expected response window align precisely with the text."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the response is received from the requester, it is forwarded to the CAB for further evaluation."
      ],
      "justification": "Exact match for forwarding the received response back to the CAB."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Based on the response, a final determination is made regarding the approval of the change request."
      ],
      "justification": "Final decision action and resulting branch split are explicitly described."
    },
    {
      "refs": [
        "guard:b4->n21",
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "a final determination is made regarding the approval of the change request."
      ],
      "justification": "Implicit positive outcome of the final determination leads to approval and subsequent implementation."
    },
    {
      "refs": [
        "guard:b4->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "a final determination is made regarding the approval of the change request."
      ],
      "justification": "Implicit negative outcome of the final determination leads to rejection."
    }
