end(e2)
converge(c1)
defines(v1, "did you get a bonus", {"Yes", "No"})
defines(v2, "did you get a paycheck", {"Yes", "No"})
defines(v3, "entry_condition", {"bonus", "paycheck"})
actor(a_default, "Default", [i1, n1, n2, b1, b_res, n3, n4, n5, b2, n6, n7, n8, n9, e2, c1])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n2)
precedence(b1, n5)
precedence(n2, b_res)
precedence(b_res, n3)
