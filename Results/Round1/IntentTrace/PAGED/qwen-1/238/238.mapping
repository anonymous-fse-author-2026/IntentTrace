{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO,"
      ],
      "justification": "Implicit start node and initial action align with the opening clause indicating process initiation."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "start by placing an Order and then proceed to Check the Customer's Credit Limit."
      ],
      "justification": "Sequential actions directly correspond to the first two operational steps described."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "The condition is redundantly modeled as an action step and a branch/guard structure; all elements faithfully capture the positive outcome path."
    },
    {
      "refs": [
        "guard:b1->c3",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Negative guard and denial action match the alternative path; converge node structurally gathers this flow before proceeding."
    },
    {
      "refs": [
        "action:n7",
        "guard:b6->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "After checking the availability, if the response is \"Okay\", proceed to Check the Availability of the Article again."
      ],
      "justification": "Second availability check condition and repeat action are captured across the action, branch, and guard elements."
    },
    {
      "refs": [
        "guard:b6->c3"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Second occurrence of the negative response condition routes to the same convergence/denial flow as the first."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Branch and guard correctly route the unavailable case to the production step."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Guard and action correctly route the available case to the collection step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Convergence point and confirmation action match the step that follows the produce/collect paths."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "AND branch and parallel actions accurately model the simultaneous requirements, followed by a convergence node."
    },
    {
      "refs": [
        "action:n13",
        "action:n14",
        "guard:b3->n15",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Check the Payment status. If the payment has been received, close the Order and end the process."
      ],
      "justification": "Payment check, redundant condition action, XOR branch, positive guard, and closing/end actions faithfully restate the source sequence."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17",
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3. If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Unpaid path guard triggers reminder count check; subsequent branch and guard correctly handle the threshold condition for write-off."
    },
    {
      "refs": [
        "action:n20",
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder. After writing off the Order, close the Order and end the process."
      ],
      "justification": "Final actions for sending reminder, closing order, and ending process align exactly with the concluding sentences."
    },
    {
      "refs": [
        "guard:b4->c4"
      ],
      "verbatim_texts": [
        "check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Structural elements and the negative guard represent the implicit less-than-three path and subsequent process routing implied by the condition."
    }
  ],
