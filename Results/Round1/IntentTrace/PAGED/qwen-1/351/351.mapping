{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially, you should check if the applicant wishes to discuss the terms and conditions"
      ],
      "justification": "Implicit process start and the initial verification step described together."
    },
    {
      "refs": [
        "guard:b1->n2",
        "action:n2"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Captures the first decision point, the positive guard value, and the corresponding discussion action."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Maps the negative guard, fallback continuation, and the implicit path merge."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Direct match to the modification intent check."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits."
      ],
      "justification": "Captures the second decision point, positive guard, and the limit verification step."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Represents the implicit negative fallback for the modification query, its continuation action, and the resulting merge."
    },
    {
      "refs": [
        "guard:b3->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "Maps the limit compliance split, the negative guard, and the relaying action."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process."
      ],
      "justification": "Maps the positive limit guard, continuation action, and the subsequent path convergence."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Exact textual match for the post-evaluation relay step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Exact textual match."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Exact textual match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Exact textual match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Exact textual match."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Exact textual match."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Pairs the acceptability verification action with its associated decision node."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If they are, continue with the process."
      ],
      "justification": "Maps the positive acceptability guard and continuation action."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If not, select a new applicant from the list."
      ],
      "justification": "Maps the negative acceptability guard, replacement selection action, and path merge."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Pairs the client acceptance check with its decision node."
    },
    {
      "refs": [
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Maps the positive acceptance guard, the termination action phrasing, and the explicit end node."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Maps the negative acceptance guard, candidate replacement action, and final path convergence."
    }
  ],
