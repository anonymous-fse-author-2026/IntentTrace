end(e2)
converge(c1)
defines(v1, "Is the amount less than 200 euros", {true, false})
defines(v2, "Is the expense report acceptable", {true, false})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, b2, n6, n7, e1, n8, n9, e2, c1])
precedence(i1, n1)
precedence(n1, n2)
