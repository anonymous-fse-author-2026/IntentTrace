{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "The opening clause implicitly triggers the process start (init) and describes initiating the cycle (actions)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then Check Levels of Inventory."
      ],
      "justification": "Direct match to the inventory verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "The conditional check and XOR decision point are captured together."
    },
    {
      "refs": [
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "is below or equal to the minimum"
      ],
      "justification": "Guard correctly encodes the less-than-or-equal threshold."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "is greater than the minimum"
      ],
      "justification": "Guard correctly encodes the greater-than threshold."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report."
      ],
      "justification": "Direct match to the low inventory report step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report."
      ],
      "justification": "Direct match to the high inventory report step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)."
      ],
      "justification": "Matches the PO creation trigger following the report condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Captures the explicit termination point and maps it to both the terminal action and structural end node."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "The AND branch and converge capture the parallel execution implied by 'Simultaneously', backed by the two concurrent actions."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "receive the Packing Slip."
      ],
      "justification": "Matches the packing slip receipt step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "proceed to receive the Invoice."
      ],
      "justification": "Matches the invoice receipt step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match."
      ],
      "justification": "Direct match to the three-way match step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "release the funds."
      ],
      "justification": "Matches the fund release step following the successful match."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "issue the payment."
      ],
      "justification": "Matches the final payment issuance step."
    }
  ],
