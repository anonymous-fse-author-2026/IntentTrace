{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "The opening clause implies the process start and describes initiating the resupply cycle."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Check Levels of Inventory"
      ],
      "justification": "Direct match to the initial inspection step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
      ],
      "justification": "Conditional split, guard capturing the threshold, and resulting report generation action are all derived from this sentence."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Alternative branch condition and corresponding report action aligned with source."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Describes the early termination path for the above-minimum case, supporting both the action and structural end."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "Action content faithfully restates the PO creation step following the report condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Direct match to the mandatory review step."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Decision point, rejection guard, and rework action fully supported by this clause."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Approval guard and print/release action correctly capture the positive branch."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "The timing word 'Simultaneously' and conjunction 'and' imply an AND split, parallel actions, and subsequent convergence points."
    },
    {
      "refs": [
        "label:n10->c1",
        "action:n12"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Label captures the reserved funds state transition; action captures the subsequent packing slip receipt."
    },
    {
      "refs": [
        "label:n11->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Label captures the mailed POs state; action captures the inventory receipt step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "receive the Invoice"
      ],
      "justification": "Direct match to the invoice receipt step described in the conditional flow."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match"
      ],
      "justification": "Direct match to the matching verification step."
    },
    {
      "refs": [
        "action:n18",
        "label:n18->n19"
      ],
      "verbatim_texts": [
        "release the funds. Once the funds are released,"
      ],
      "justification": "Action matches the fund release step; label captures the explicit transition condition stated immediately after."
    },
    {
      "refs": [
        "action:n19",
        "label:n19->n20"
      ],
      "verbatim_texts": [
        "issue the payment. After the payment is issued,"
      ],
      "justification": "Action matches payment issuance; label captures the temporal transition leading to completion."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Final status update action and overall process termination align with the closing sentence."
    }
  ],
