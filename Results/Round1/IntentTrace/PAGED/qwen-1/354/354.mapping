      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks,"
      ],
      "justification": "The opening clause implicitly triggers the process start (init) and directly describes the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "select the method for exit control checks"
      ],
      "justification": "Direct mapping to the selection action following immigration."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics,"
      ],
      "justification": "The conditional phrase introduces the XOR branch split and provides the exact condition captured by the biometric guard."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "they should undergo a check using biometrics"
      ],
      "justification": "Faithful restatement of the action taken on the biometric branch path."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if the passenger prefers to use ID documents,"
      ],
      "justification": "Captures the alternative choice condition for the second branch guard."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should undergo checks using identity documents"
      ],
      "justification": "Direct paraphrase of the action on the ID document branch path."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After the exit control checks,"
      ],
      "justification": "Signals the point where the biometric and ID document paths rejoin before subsequent evaluation."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "if the passenger is denied permission,"
      ],
      "justification": "The action models the permission evaluation step, and the branch node captures the exclusive split based on that evaluation."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "denied permission"
      ],
      "justification": "The guard condition accurately reflects the negative outcome stated in the source."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should leave the area"
      ],
      "justification": "Direct mapping to the action required when permission is denied."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "if the passenger is allowed to continue,"
      ],
      "justification": "Captures the positive outcome condition for the continuation guard."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they should proceed to the next step"
      ],
      "justification": "Direct paraphrase of the action taken when permission is granted."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Explicit closing phrase indicating process termination."
    }
