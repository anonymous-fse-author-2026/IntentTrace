@startuml
!theme plain
|a_default| Default
|a_default|
start
:Ensure invoice is ready for verification;
:Check invoice completeness;
:Check SLA;
:Check compliance;
:Allocate invoices to Data Entry Officer by 9 am next working day;
repeat :Process invoice batch;
:More batches to process?;
:v1: More batches to process? ({Yes, No}); <<objectSignal>>
repeat while () is ([v1 = 'Yes']) not ([v1 = 'No'])
:Take batch to outbox;
repeat :Clear outbox every hour until completely cleared;
:Outbox completely cleared?;
:v2: Outbox completely cleared? ({Yes, No}); <<objectSignal>>
repeat while () is ([v2 = 'No']) not ([v2 = 'Yes'])
:End of process;
stop
@enduml