      ],
      "justification": "Direct match for the loop-back step on rejection."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the request is approved,"
      ],
      "justification": "Matches the positive condition guarding the payment path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the expenses can be paid out."
      ],
      "justification": "Direct match for the financial execution step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Captures the second decision point; repeated conditional logic faithfully restated."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
