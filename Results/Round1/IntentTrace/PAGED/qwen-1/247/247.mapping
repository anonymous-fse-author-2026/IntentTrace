    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "we proceed with the step of \"ONS-Resolving URN to a domain-name\"."
      ],
      "justification": "Directly matches the resolution step executed on the positive branch."
    },
    {
      "refs": [
        "guard:b1->n8",
