{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "Implicit process start combined with the explicitly named first step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level."
      ],
      "justification": "Direct sequence mapping of the inventory verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\""
      ],
      "justification": "Conditional clause implicitly opens the XOR branch and is captured as a condition-action step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "then proceed to Create Purchase Order."
      ],
      "justification": "Positive branch guard routes to the purchase order creation step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "Negative branch guard covers the alternative condition, leading to the termination action and structural end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Direct sequential mapping."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved, then reserve the funds for the purchase."
      ],
      "justification": "Introduces the second XOR decision, captures the approval state as an action, applies the positive guard, and performs fund reservation."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the Purchase Order is rejected, then rework the order."
      ],
      "justification": "Negative guard covers the rejection path leading to the rework step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Sequential step following successful fund reservation."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Loopback/re-evaluation step matching the rejection recovery path."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "Concurrency keyword explicitly signals the AND gateway split."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "the Supplier sends a packing slip and an invoice."
      ],
      "justification": "Two parallel supplier activities branching from the concurrent split."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it."
      ],
      "justification": "First parallel path recording task."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Similarly, when the invoice is received, record it as well."
      ],
      "justification": "Second parallel path recording task."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice,"
      ],
      "justification": "Completion of both recording tasks triggers the synchronous join point."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "Sequential financial steps executed post-convergence."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Final procedural action paired with the explicit process termination marker."
    }
  ],
