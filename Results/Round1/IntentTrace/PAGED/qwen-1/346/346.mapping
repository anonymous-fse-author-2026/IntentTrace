{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "Covers the implicit process start and the first explicit action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Direct match for the receiving step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Direct match for the clarification step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Direct match for the initial checking step."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized."
      ],
      "justification": "Captures the decision query, XOR split, positive guard condition (mapped to yes/internal), and the resulting authorization action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Captures the negative guard condition (mapped to no/external), the alternative authorization action, and the implicit convergence point where both authorization paths meet."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Direct match for the documentation sending step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Direct match for scanning and recording."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Covers both the re-checking and re-sending actions described sequentially in the same clause."
    },
    {
      "refs": [
        "action:n13",
        "action:n20"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Covers the receipt action, the descriptive end step, and the structural end node."
    },
    {
      "refs": [
        "action:n14",
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Captures the variation decision query, XOR split, negative guard (no variations), and continuation action."
    },
    {
      "refs": [
        "guard:b2->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed."
      ],
      "justification": "Captures the positive guard (variations) and the business case completion action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues. However, if there are variations, a business case is completed and attached."
      ],
      "justification": "The repeated conditional block signals path rejoining (converge) and adds the specific attachment action on the variation path."
    }
  ],
