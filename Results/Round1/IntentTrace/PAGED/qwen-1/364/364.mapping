    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Then, we make a decision."
      ],
      "justification": "Direct match for the sequential step that follows the parallel branch."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If we need to check the declaration, the process ends."
      ],
      "justification": "The condition implies a second XOR branch; the guard, action, and end node align with this termination path."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "Otherwise, if we need to invite the declarant, the process also ends."
      ],
      "justification": "The guard matches the final condition, while the action and end node capture the corresponding path and termination."
    }
