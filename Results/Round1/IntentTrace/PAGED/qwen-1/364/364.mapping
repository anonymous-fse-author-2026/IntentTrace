    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After receiving the form, we check if it is complete."
      ],
      "justification": "Direct restatement of the completeness verification step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If it needs to be sent back, the process ends."
      ],
