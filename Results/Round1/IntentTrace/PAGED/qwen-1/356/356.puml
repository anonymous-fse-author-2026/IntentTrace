@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process;
:Ensure Freights are ready to be shipped;
:Ship Freight;
split
:Deliver Freight;
split again
:Notify Delivery;
end split
:Check for Merchandise Return Request;
:v1: Condition ({5 days passed, Return accepted, Return rejected, Loss claim lodged}); <<objectSignal>>
switch ()
case ([v1 = 'Return accepted'] Return Accepted)
:Accept Merchandise Return;
:Proceed with Returning Merchandise;
stop
case ([v1 = 'Return rejected'] Return Rejected)
:Reject Merchandise Return;
stop
case ([v1 = '5 days passed'] 5 days have passed)
:Invoice the Customer;
stop
case ([v1 = 'Loss claim lodged'] Loss Claim Lodged)
:Approve Loss Claim and End Process;
stop
endswitch
@enduml