      "verbatim_texts": [
        "To start, ask the 1st Level Support if there is an issue."
      ],
      "justification": "The opening clause implicitly initializes the process, captures the introductory 'start' keyword, and directly maps to the first inquiry action."
    },
    {
      "refs": [
