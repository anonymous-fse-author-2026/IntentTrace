{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "The opening sentence implicitly triggers the start event and explicitly describes the first three sequential actions."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report. If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "The conditional introduces the XOR split, and the two arms correspond exactly to the two report-generation actions."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum"
      ],
      "justification": "The parallel/duplicate report paths converge implicitly before evaluating the report, which forms the next XOR decision node and its checking action."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs). If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Covers the positive arm action, the negative arm termination action, and the implicit process end node."
    },
    {
      "refs": [
        "action:n17",
        "action:n11",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed. If the PO is rejected, it needs to be reworked. If the PO is approved, it is printed and released in the system. If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Captures the review requirement, the approval/rejection XOR split, the rework and print/release actions, and the recursive creation step following rework."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "The timing word 'Simultaneously' drives the AND gateway split into the two parallel funding and mailing actions."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Direct mapping of the funding path's immediate follow-up action."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Direct mapping of the subsequent step in the packing-slip path."
    },
    {
      "refs": [
        "action:n36"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Direct mapping of the mailing path's immediate follow-up action."
    },
    {
      "refs": [
        "action:n39"
      ],
      "verbatim_texts": [
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Direct mapping of the inventory path's transition step."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match."
      ],
      "justification": "The two parallel branches implicitly merge before entering the three-way match step."
    },
    {
      "refs": [
        "action:n43",
        "action:n44",
        "action:n45"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds. Once the funds are released, issue the payment. After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Sequentially covers fund release, payment issuance, cycle completion, and the final process end."
    }
  ],
