  "input_elements": [
    {
      "id": "i1",
      "content": "To initiate the process, start by receiving the order."
    },
    {
      "id": "i2",
      "content": "At the same time, complete the following steps: check the order and check the customer."
    },
    {
      "id": "i3",
      "content": "If the order is okay, then continue with the process."
    },
    {
      "id": "i4",
      "content": "If the customer is not permitted, send a refusal."
    },
    {
      "id": "i5",
      "content": "However, if the customer is permitted, continue with the process."
    },
    {
      "id": "i6",
      "content": "In this case, send a refusal and end the process."
    },
    {
      "id": "i7",
      "content": "If the order is not okay, send a refusal and end the process."
    },
    {
      "id": "i8",
      "content": "Release the order and then transfer the data in the database."
    },
    {
      "id": "i9",
      "content": "Once the data is transferred, check the worth of the order. If it is greater than 10.000 \u20ac, sign off on the order."
    },
    {
      "id": "i10",
      "content": "Otherwise, continue with the process. Sign off on the order and forward it to production."
    },
    {
      "id": "i11",
      "content": "At the same time, complete the following steps: check the product quality, start production, and produce the product."
    },
    {
      "id": "i12",
      "content": "Also, create a material report. Check the product quality and create the material report."
    },
    {
      "id": "i13",
      "content": "Once the report is created, send it to the warehouse."
    },
    {
      "id": "i14",
      "content": "At the same time, create a quality report, send the product to shipment, and send the order to accounting."
    },
    {
      "id": "i15",
      "content": "After sending the report to the warehouse, the process ends."
    },
    {
      "id": "i16",
      "content": "Once the report is created, send it to Finance."
    },
    {
      "id": "i17",
      "content": "Ship the product and send the invoice."
    },
    {
      "id": "i18",
      "content": "After sending the report, archive it. Archive the report and end the process."
    },
    {
      "id": "i19",
      "content": "Check the payment. If the payment is received, close the order."
    },
    {
      "id": "i20",
      "content": "If the payment is not received, check if a reminder has been sent more than three times."
    },
    {
      "id": "i21",
      "content": "If a reminder has been sent more than three times, acquire a lawyer."
    },
    {
      "id": "i22",
      "content": "Otherwise, send a reminder."
    },
    {
      "id": "i23",
      "content": "Acquire a lawyer and complete the court proceedings."
    },
    {
      "id": "i24",
      "content": "Send a reminder and then send the reminder."
    }
  ]
