init(n1)
action(n1, "start booking service")
action(n2, "book bus")
action(n3, "check availability of bus")
action(n4, "receive availability information")
branch(b1, XOR)
action(n6, "end booking due to unavailable bus")
end(e1)
action(n7, "proceed to book bus")
action(n8, "end booking complete")
end(e2)
defines(v1, "availability ok?", {"No", "Yes"})
actor(a_default, "Default", [n1, n2, n3, n4, b1, n6, e1, n7, n8, e2])
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n6)
precedence(b1, n7)
precedence(n6, e1)
precedence(n7, n8)
precedence(n8, e2)
guard(b1, n6, v1 = 'No')
guard(b1, n7, v1 = 'Yes')