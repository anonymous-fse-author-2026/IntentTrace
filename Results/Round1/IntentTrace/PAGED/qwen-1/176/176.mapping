      "verbatim_texts": [
        "The loan application process starts with receiving the loan application."
      ],
      "justification": "The opening clause implicitly triggers the init node and explicitly describes the starting and receiving actions."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Explicit concurrency marker that mandates an AND gateway split for the upcoming tasks."
    },
    {
      "refs": [
        "action:n3",
        "label:b2->n3"
      ],
      "verbatim_texts": [
        "assessing the loan risk"
      ],
      "justification": "Exact match for the first parallel task and its connecting label."
    },
    {
      "refs": [
        "action:n4",
        "label:b2->n4"
      ],
      "verbatim_texts": [
        "checking the credit history"
      ],
      "justification": "Exact match for the second parallel task and its connecting label."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After that,"
      ],
      "justification": "Temporal connector signals that the parallel branches have finished and the flow rejoins."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the eligibility of the applicant is assessed."
      ],
      "justification": "Describes the evaluation step that directly precedes and triggers the XOR decision split."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the applicant is eligible, the acceptance pack is prepared."
      ],
      "justification": "Maps the positive eligibility condition to the 'Yes' guard and the corresponding preparation action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the applicant is not eligible, the application is rejected."
      ],
      "justification": "Maps the negative eligibility condition to the 'No' guard and the corresponding rejection action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the application is rejected, the loan application process ends."
      ],
      "justification": "Describes the terminal action and process end for the rejection path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The prepared acceptance pack is then sent."
      ],
      "justification": "Direct correspondence to the sending step following pack preparation."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the acceptance pack is sent, the process ends."
      ],
      "justification": "Describes the final delivery action and process end for the successful path."
    }
