@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process by identifying the vacancy;
:Is there a suitable candidate available;
:v1: Is there a suitable candidate available ({false, true}); <<objectSignal>>
if () then ([v1 = false])
:advertise the vacancy;
repeat
:v1: Is there a suitable candidate available ({false, true}); <<objectSignal>>
backward:advertise the vacancy again;
repeat while () is ([v1 = false]) not ([v1 = true])
else ([v1 = true])
:Is there a suitable candidate available;
endif
:select the appropriate applicant;
:appoint the candidate;
:process ends;
stop
@enduml