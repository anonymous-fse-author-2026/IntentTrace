@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:receive claim;
:create and record the claim;
:make a decision on the claim;
:v1: make a decision on the claim ({Rejected, Accepted, Other}); <<objectSignal>>
switch ()
case ([v1 = 'Rejected'])
:reject the claim;
:review the claim rejection;
:v2: rejection decision ({Accepted, Not Accepted}); <<objectSignal>>
if () then ([v2 = 'Accepted'] [v2 = 'Not Accepted'])
->;
else ([v2 = 'Accepted'] [v2 = 'Not Accepted'])
->;
endif
:continue the process;
case ([v1 = 'Accepted'])
:offer the benefit;
:prepare the claim discharge;
:record the benefit payment;
case ([v1 = 'Other'])
:operate outgoing payment;
:close the claim;
endswitch
:end of process;
stop
@enduml