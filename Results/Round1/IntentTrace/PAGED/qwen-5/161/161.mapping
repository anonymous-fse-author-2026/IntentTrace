{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "Opening clause implies process initialization and directly supports both start and team-joining actions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "create a process model and check it"
      ],
      "justification": "Direct paraphrase of the model creation and verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\""
      ],
      "justification": "Conditional phrasing supports the check action and the XOR branch node."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "then assign negative points"
      ],
      "justification": "Positive branch condition and consequent action match the penalty assignment step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\""
      ],
      "justification": "Second conditional check maps to the repeated evaluation action and branch."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "assign negative points again"
      ],
      "justification": "Repetition of the penalty outcome aligns with the guard and follow-up action."
    },
    {
      "refs": [
        "action:n9",
        "guard:b1->c1",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Positive outcome phrase supports the continuation action and the 'Model OK' routing guards."
    },
    {
      "refs": [
        "label:b6->n10",
        "guard:b6->n10"
      ],
      "verbatim_texts": [
        "If there are any issues"
      ],
      "justification": "Issue condition directly matches the edge label and guard."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "fix them in the next session and extend the process to levels 2 and 3"
      ],
      "justification": "Instruction for remediation and extension matches the action content."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process.",
        "If you need to analyze the field of study"
      ],
      "justification": "Two alternative needs are combined into a single decision-action node in the model."
    },
    {
      "refs": [
        "label:b6->n11",
        "guard:b6->n11",
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "Routing label, guard, and fallback guard correspond to the check/continue path."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "assign roles in the team"
      ],
      "justification": "Analysis condition directs flow via branch/guard to the role assignment action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "continue with the process and perform work according to your assigned role"
      ],
      "justification": "Direct match for post-assignment workflow continuation."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Exact match for the monitoring and consultation step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the project is accepted"
      ],
      "justification": "First acceptance condition maps to the evaluation action and XOR branch."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "present it"
      ],
      "justification": "Positive outcome guard and presentation action align with the text."
    },
    {
      "refs": [
        "guard:b4->n18"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Negative outcome and continuation instruction match the guard and action."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "continue working according to your role"
      ],
      "justification": "Negative outcome and continuation instruction match the guard and action."
    },
    {
      "refs": [
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Repeated check sequence supports the second evaluation branch and presentation action."
    },
    {
      "refs": [
        "guard:b5->n21",
        "guard:b5->n22",
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Second negative outcome and continuation match the branching guards and corresponding actions."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Closing sentence explicitly signals process termination, matching the end node."
    }
  ],
