{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "The opening clause implicitly initiates the process (init), contains an explicit start step, and describes the initial billing and invoice receipt actions."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Captures the completeness check question, the XOR decision node, the affirmative condition guard, and the corresponding return action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Maps the negative outcome guard and the action that advances the workflow to subsequent compliance checks."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "it is returned."
      ],
      "justification": "The invoice return implicitly terminates this branch, justifying the end-of-process action and structural end node."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted. On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Establishes the second decision point evaluating compliance status before routing to resolution paths."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Directly aligns the phone-call condition guard with the action resolving non-compliance via that method."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Aligns the mail-back condition guard with the action that returns the invoice under that requirement."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the invoice is returned."
      ],
      "justification": "The second return scenario also terminates its branch, supporting the end action and structural end node."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Bill Client."
      ],
      "justification": "Exact match for the client billing step executed in the parallel flow."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n14",
        "guard:b3->e3",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Covers the response check, the XOR branch, both outcome guards (yes/no), and the waiting period action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Directly matches the reminder action and explicitly signals the termination of this branch."
    },
    {
      "refs": [
        "action:n11",
        "action:n18"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Both action nodes faithfully restate the payment and notification step, with the end node marking the conclusion of this flow. Redundancy is acceptable per guidelines."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n17",
        "guard:b4->e4",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved. However, if the client is satisfied, the process continues."
      ],
      "justification": "Encompasses the satisfaction evaluation, the branching logic, both outcome guards, the discrepancy resolution action, and the continuation action."
    }
  ],
