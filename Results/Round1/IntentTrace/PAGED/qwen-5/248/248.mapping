  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process at the Italian restaurant, first enter and ask for the menu."
      ],
      "justification": "Explicitly initiates the process and describes the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After checking the offers,"
      ],
      "justification": "Describes the preparatory action preceding the parallel workflow."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "simultaneously take the following steps:"
      ],
      "justification": "Directly signals concurrent execution, justifying the AND gateway."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "order a glass of red wine and a salad."
      ],
      "justification": "Covers the two concurrent ordering actions spawned by the AND branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the order is placed, wait for it to arrive"
      ],
      "justification": "Implies the rejoining of the parallel ordering paths before the waiting step begins."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "and then enjoy the salad and wine."
      ],
      "justification": "Direct mapping to the consumption step following arrival."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After finishing, you will be asked if you would like a dessert."
      ],
      "justification": "Captures the inquiry action and implicitly introduces the exclusive decision point for dessert."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If you answer \"yes\" to tiramisu, then go ahead and order it."
      ],
      "justification": "Supports the positive condition guard and the subsequent ordering action."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If you answer \"no\" to tiramisu, then simply decline any dessert."
      ],
      "justification": "Supports the negative condition guard and the corresponding declining action."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If you did order tiramisu, wait for it to be served, then enjoy it."
      ],
      "justification": "Describes the sequential steps taken only on the affirmative tiramisu branch."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Once you are ready, ask for the bill and proceed to pay it."
      ],
      "justification": "Implies the convergence of the dessert branches and describes the billing sequence."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "After settling the bill, you can leave the restaurant and the process will be complete."
      ],
      "justification": "Covers the final departure, the completion statement, and implicitly terminates the process."
    }
  ],
