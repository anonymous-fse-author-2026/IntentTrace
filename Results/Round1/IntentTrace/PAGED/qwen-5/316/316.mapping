{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "The opening clause implicitly triggers the start node and directly describes the initial registration action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "The conditional phrase justifies the decision action, the XOR branch, the positive guard ('Yes'), and the request action on that path."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "label:n4->c1"
      ],
      "verbatim_texts": [
        "if an exception is not needed, the process can continue."
      ],
      "justification": "Covers the negative guard ('No'), the continuation action, and the label on the flow."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "After the exception is approved, the next step is course enrollment,"
      ],
      "justification": "The approval condition acts as a gating action, the converge node merges the exception/no-exception flows, and the sentence specifies the subsequent enrollment step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "followed by seminar group enrollment."
      ],
      "justification": "Directly maps to the seminar enrollment action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the seminar group enrollment is completed, the homework assignment can be started."
      ],
      "justification": "Temporal cue leads directly into starting the homework assignment."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After working on the homework, it should be turned in."
      ],
      "justification": "Directly describes submitting the homework."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated, and the process can continue."
      ],
      "justification": "Matches the evaluation step and signals forward flow."
    },
    {
      "refs": [
        "action:n12",
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Captures the loop condition check, XOR branch, negative guard ('No'), and the assignment action for continuing the cycle."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "However, if it was the last homework, the process can continue."
      ],
      "justification": "Covers the positive guard ('Yes') for breaking the homework loop and proceeding."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "Explicit concurrency marker justifies the AND gateway, the two parallel actions, and the synchronization/merge node representing their completion."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "After signing up for the exam,"
      ],
      "justification": "Directly matches the exam registration step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "it should be attended."
      ],
      "justification": "Directly matches taking part in the exam."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the exam is attended, it will be evaluated."
      ],
      "justification": "Directly matches the post-exam evaluation step."
    },
    {
      "refs": [
        "action:n22",
        "guard:b4->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue."
      ],
      "justification": "Captures the pass condition check, XOR branch, positive guard ('Pass'), and the course-pass confirmation action."
    },
    {
      "refs": [
        "guard:b4->n24",
        "action:n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Covers the negative guard ('Fail'), the retry sign-up action, and the implicit loop-back action returning to exam attendance/evaluation."
    }
  ],
