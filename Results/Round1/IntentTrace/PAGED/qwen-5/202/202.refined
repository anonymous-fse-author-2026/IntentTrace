init(i1)
action(n1, "start cutting banana process")
action(n2, "prepare to cut banana")
branch(b1, XOR)
action(n3, "hold banana securely")
action(n4, "cut the banana")
converge(c1)
action(n5, "end of process")
end(e1)
defines(v_route, "route", {"hold", "cut"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, c1, n5, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, c1)
precedence(c1, n5)
precedence(n5, e1)
guard(b1, n3, v_route = 'hold')
guard(b1, n4, v_route = 'cut')