    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n2"
      ],
      "verbatim_texts": [
        "If the meeting is successful"
      ],
      "justification": "The conditional clause establishes the XOR decision point, defines the positive guard value, and implies the implicit check action."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "if the meeting is not successful"
      ],
      "justification": "Directly maps to the negative branch condition; 'No' is an acceptable paraphrase for 'not successful'."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "The termination action and structural end node both derive from this explicit closing statement."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "work on the storyboard"
