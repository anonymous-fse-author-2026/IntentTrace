    },
    {
      "refs": [
        "action:n6",
        "action:n5"
      ],
      "verbatim_texts": [
        "the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "The conjunction 'and' supports the parallel AND gateway splitting into two concurrent action steps."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After that, the site development"
      ],
      "justification": "The temporal marker 'After that' implies the merging of prior parallel paths into a converge node, followed immediately by the development action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "it goes through a review process"
      ],
      "justification": "Directly matches the review action step."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If the review is successful"
      ],
      "justification": "Defines the third XOR decision point and its passing guard condition."
    },
    {
