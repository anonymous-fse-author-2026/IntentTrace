        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If there is a \"Construct Error Response\""
      ],
      "justification": "The conditional phrase opens the XOR branch and justifies the positive-path guard."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then the process ends with an \"Error Message\""
      ],
      "justification": "Describes the error action and the immediate process termination point."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
