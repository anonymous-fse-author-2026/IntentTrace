{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "Covers implicit start, initial trigger action, and first check step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "Captures the XOR decision point, positive condition guard, and the resulting action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Maps the negative condition guard, the explicit end action, and the terminal end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Directly matches the post-creation review step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "Covers the XOR branch, the condition modeled as an action step, the positive guard, and the rework action."
    },
    {
      "refs": [
        "guard:b2->n_reserve",
        "action:n_reserve"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Maps the approval condition guard and the fund reservation action."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Reiterates the rework step and introduces the subsequent review action."
    },
    {
      "refs": [
        "action:n_reserve",
        "action:n_send"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Reiterates fund reservation and adds the supplier dispatch action."
    },
    {
      "refs": [
        "action:n_recv_ps",
        "action:n_recv_inv"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Concurrency marker implies an AND branch, splitting into two parallel receive actions."
    },
    {
      "refs": [
        "action:n_rec_ps"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Matches the sequential recording of the packing slip."
    },
    {
      "refs": [
        "action:n_rec_ps"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Links the recording action to its corresponding terminal node."
    },
    {
      "refs": [
        "action:n_rec_inv"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Matches the sequential recording of the invoice."
    },
    {
      "refs": [
        "action:n_rec_inv"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Links the recording action to its corresponding terminal node."
    }
