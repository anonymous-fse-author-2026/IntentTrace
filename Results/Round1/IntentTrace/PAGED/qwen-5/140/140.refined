init(i1)
action(n1, "Start the resupply process")
action(n2, "Check inventory level")
branch(b1, XOR)
action(n4, "End process due to sufficient inventory")
end(e1)
action(n5, "Create purchase order")
action(n6, "Review purchase order")
action(n7, "Is purchase status rejected")
branch(b2, XOR)
action(n8, "Rework purchase order")
action(n9, "Review purchase order again after rework")
action(n_reserve, "Reserve funds")
action(n_send, "Send order to supplier")
branch(b_par, AND)
action(n_recv_ps, "Receive packing slip")
action(n_recv_inv, "Receive invoice")
action(n_rec_ps, "Record packing slip")
end(e_ps)
action(n_rec_inv, "Record invoice")
end(e_inv)
defines(v1, "Is inventory level at or below minimum", {"No", "Yes"})
defines(v2, "Is purchase status rejected", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, e1, n5, n6, n7, b2, n8, n9, n_reserve, n_send, b_par, n_recv_ps, n_recv_inv, n_rec_ps, e_ps, n_rec_inv, e_inv])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, e1)
precedence(n5, n6)
precedence(n6, n7)
precedence(n7, b2)
precedence(b2, n8)
precedence(n8, n9)
precedence(n9, b2)
precedence(b2, n_reserve)
precedence(n_reserve, n_send)
precedence(n_send, b_par)
precedence(b_par, n_recv_ps)
precedence(b_par, n_recv_inv)
precedence(n_recv_ps, n_rec_ps)
precedence(n_rec_ps, e_ps)
precedence(n_recv_inv, n_rec_inv)
precedence(n_rec_inv, e_inv)
guard(b1, n4, v1 = 'No')
guard(b1, n5, v1 = 'Yes')
guard(b2, n8, v2 = 'Yes')
guard(b2, n_reserve, v2 = 'No')