@startuml
!theme plain
|a_default| Default
|a_default|
start
:start process for ACME Company;
:receive customer request;
:check current inventory level;
:is inventory at or below minimum level?;
:v1: is inventory at or below minimum level? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:accept customer request;
:create purchase order;
repeat :;
:review purchase order;
:is purchase order approved?;
:v2: is purchase order approved? ({Yes, No}); <<objectSignal>>
backward:rework purchase order;
repeat while () is ([v2 = 'No']) not ([v2 = 'Yes'])
:reserve funds;
:send purchase order;
split
:receive packing slip;
:record packing slip;
split again
:receive invoice;
:record invoice;
end split
:release reserved funds and issue payment;
:end process;
stop
else ([v1 = 'No'])
:reject customer request;
:is rejected;
:end process for rejected request;
stop
endif
@enduml