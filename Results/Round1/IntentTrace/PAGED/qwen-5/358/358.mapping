    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After that, we look up the Vendor on SAP."
      ],
      "justification": "Describes the vendor lookup action and implicitly establishes the state check that feeds into the subsequent branch."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the answer is \"No\", then we need a Vendor master record and the process ends."
      ],
      "justification": "Maps the negative guard condition, the required record action, the termination step, and the corresponding end node."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "But if the answer is \"Yes\", then we enter the invoice in SAP."
      ],
      "justification": "Directly aligns the positive guard with the invoice entry action."
    },
    {
      "refs": [
        "action:n11",
        "guard:b4->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the answer is \"No\", then we need a Vendor master record and the process ends."
      ],
      "justification": "Captures the recurring decision context, branch logic, negative guard, record requirement, and process termination."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "However, if the answer is \"Yes\", then we give it priority."
      ],
      "justification": "Matches the affirmative guard and the associated priority action on this branch arm."
    },
    {
      "refs": [
        "action:n15",
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "And if the answer is \"Yes\" again, then we enter the invoice in SAP."
      ],
      "justification": "Reflects the repeated confirmation check, branch, guard, and resulting invoice entry action."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the invoice is entered in SAP, we place the entered invoices in the normal Outbox and the process ends."
      ],
      "justification": "The completion of preceding branches implies convergence, followed by the outbox placement, explicit end action, and final process termination."
    }
