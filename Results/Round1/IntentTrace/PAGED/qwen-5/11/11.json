  "input_elements": [
    {
      "id": "i1",
      "content": "To initiate the process for ACME Company, the Resupply Cycle is triggered"
    },
    {
      "id": "i2",
      "content": "followed by checking the Inventory Level."
    },
    {
      "id": "i3",
      "content": "If the Inventory is greater than the Minimum Level,"
    },
    {
      "id": "i4",
      "content": "greater than the Minimum Level"
    },
    {
      "id": "i5",
      "content": "then the process ends."
    },
    {
      "id": "i6",
      "content": "Otherwise"
    },
    {
      "id": "i7",
      "content": "a Purchase Order is created."
    },
    {
      "id": "i8",
      "content": "The Purchase Order is then reviewed."
    },
    {
      "id": "i9",
      "content": "If the Purchase Order is rejected, it is reworked. However, if the Purchase Order is accepted, funds are reserved for payment."
    },
    {
      "id": "i10",
      "content": "rejected"
    },
    {
      "id": "i11",
      "content": "it is reworked."
    },
    {
      "id": "i12",
      "content": "accepted"
    },
    {
      "id": "i13",
      "content": "funds are reserved for payment."
    },
    {
      "id": "i14",
      "content": "After reserving funds for payment, the Purchase Order is sent to the Supplier."
    },
    {
      "id": "i15",
      "content": "Simultaneously"
    },
    {
      "id": "i16",
      "content": "the Packing Slip is received and the Invoice is received."
    },
    {
      "id": "i17",
      "content": "Upon receiving the Packing Slip, it is recorded."
    },
    {
      "id": "i18",
      "content": "Similarly, upon receiving the Invoice, it is recorded."
    },
    {
      "id": "i19",
      "content": "Once the funds are released for payment,"
    },
    {
      "id": "i20",
      "content": "the payment is issued to the Supplier."
    },
    {
      "id": "i21",
      "content": "Finally, the process ends with the issuance of payment to the Supplier."
    }
  ]
