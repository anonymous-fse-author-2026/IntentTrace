{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "The opening clause establishes the process start (init) and describes the first two sequential actions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "Describes the inspection step and implicitly triggers the first XOR decision."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "The positive guard condition and the immediate termination action."
    },
    {
      "refs": [
        "guard:b1->n_i5"
      ],
      "verbatim_texts": [
        "if not"
      ],
      "justification": "Captures the negative condition that directs flow to the subsequent check."
    },
    {
      "refs": [
        "action:n_i5"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again"
      ],
      "justification": "The repeated inspection step and its associated decision node."
    },
    {
      "refs": [
        "guard:b_i5->n4b",
        "action:n4b"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "The positive condition and termination for the second check cycle."
    },
    {
      "refs": [
        "guard:b_i5->n5"
      ],
      "verbatim_texts": [
        "if not"
      ],
      "justification": "Negative condition advancing the flow to the information verification stage."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "The verification step and the implicit XOR split based on completeness."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Matches the complete-state guard and the corresponding recording action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Matches the incomplete-state guard and the phone call action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Implicitly rejoins the divergent paths after the call and describes the data completion step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Direct paraphrase of the scheduled transport action."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Covers the membership approval condition, guard, and the stamping/dating action."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Covers the rejection condition, notification action, and implicit path termination."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Direct match for the post-stamping data entry step."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "The concurrency keyword explicitly justifies the AND gateway."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "calculate the fee and hand the letter to Charles. Ask Charles to write the amount in the register."
      ],
      "justification": "Combined execution of the fee calculation, letter handoff, and register instruction."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Exact match for the card printing and dispatch step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Explicit textual termination mapped to the action and end node."
    },
    {
      "refs": [
        "action:n_ima17"
      ],
      "verbatim_texts": [
        "Hand the letter to Charles and add the new member to the register."
      ],
      "justification": "Direct match for the follow-up handoff and registration update."
    },
    {
      "refs": [
        "action:n_ima18"
      ],
      "verbatim_texts": [
        "Prepare an invoice for the new members and continue the process."
      ],
      "justification": "Direct match for the invoice preparation step."
    },
    {
      "refs": [
        "action:n_ima19"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register and write the fee amount to the register."
      ],
      "justification": "Direct match for the final register entry instructions."
    }
  ],
  "mutations": [],
  "omissions": [],
  "additions": [
    {
      "refs": [
        "guard:b_end_choice->n15"
      ],
      "reason": "The source text lists printing the membership card and preparing the invoice as sequential steps without any conditional split or decision variables. These guards invent routing logic ('v_end = Membership Card', 'v_end = Invoice') that has no basis in the source."
    },
    {
      "refs": [
        "guard:b_end_choice->n_ima17"
      ],
      "reason": "The source text lists printing the membership card and preparing the invoice as sequential steps without any conditional split or decision variables. These guards invent routing logic ('v_end = Membership Card', 'v_end = Invoice') that has no basis in the source."
    }
  ],
