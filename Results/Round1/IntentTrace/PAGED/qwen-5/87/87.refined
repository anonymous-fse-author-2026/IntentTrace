init(i1)
action(n1, "Begin process in Admin Office")
action(n2, "Has the process started")
branch(b1, XOR)
action(n4, "Check completeness of the invoices")
action(n5, "Return invoices to client through postal mail")
action(n5_2, "Return uncompleted invoices via postal mail")
action(n7, "Receive completed invoices")
action(n8, "Mark relevant box on invoice entry form")
action(n9, "Continue the process")
action(n10, "Check if the process has been completed")
branch(b2, XOR)
action(n11, "End process")
end(e2)
action(n12, "Return invoices to client through postal mail")
action(n14, "Receive completed invoices")
converge(c1)
converge(c2)
branch(b3, AND)
defines(v_gate1, "Branch Gate 1", {"Proceed", "Terminate"})
defines(v2, "Completion Status", {"Completed", "Ongoing"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, n5, n5_2, n7, n8, n9, n10, b2, n11, e2, n12, n14, c1, c2, b3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, e2)
precedence(n4, b3)
precedence(b3, n5)
precedence(b3, n9)
precedence(n5, n5_2)
precedence(n5_2, n7)
precedence(n7, c2)
precedence(c2, n8)
precedence(n8, c1)
precedence(n9, c1)
precedence(c1, n10)
precedence(n10, b2)
precedence(b2, n11)
precedence(b2, n12)
precedence(n11, e2)
precedence(n12, n14)
precedence(n14, c2)
guard(b1, n4, v_gate1 = 'Proceed')
guard(b1, e2, v_gate1 = 'Terminate')
guard(b2, n11, v2 = 'Completed')
guard(b2, n12, v2 = 'Ongoing')