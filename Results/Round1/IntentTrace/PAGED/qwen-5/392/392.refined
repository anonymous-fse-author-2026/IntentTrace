init(i1)
action(n1, "Start User Task")
branch(b1, XOR)
action(n3, "Continue Process after Service Task 1")
action(n5, "Continue Process after Service Task 2")
action(n6, "End Process due to Service Task 3")
converge(c1)
action(n7, "Merge Continue Process after Service Task 1 and 2")
action(n8, "Is there a Manual Task?")
end(e1)
defines(v1, "Task Type", {"Service Task 1", "Service Task 2", "Service Task 3"})
actor(a_default, "Default", [i1, n1, b1, n3, n5, n6, c1, n7, n8, e1])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n3)
precedence(b1, n5)
precedence(b1, n6)
precedence(n3, c1)
precedence(n5, c1)
precedence(c1, n7)
precedence(n7, n8)
precedence(n8, e1)
precedence(n6, e1)
guard(b1, n3, "v1 = 'Service Task 1'")
guard(b1, n5, "v1 = 'Service Task 2'")
guard(b1, n6, "v1 = 'Service Task 3'")