{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "The opening phrase implicitly signals the process start (init) and directly justifies the generic start action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process. However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "The action summarizes both return/pickup paths; the XOR branch and guards capture the exclusive decision and its two quoted conditions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct paraphrase of the inventory verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "The abstract status-check action and XOR branch correspond to the three distinct order outcome conditions described sequentially."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "Order is complete and all items were returned"
      ],
      "justification": "Each guard extracts the exact conditional phrase governing its respective branch arm."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "Order is incomplete and items are missing"
      ],
      "justification": "Each guard extracts the exact conditional phrase governing its respective branch arm."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "Order is complete but items are damaged"
      ],
      "justification": "Each guard extracts the exact conditional phrase governing its respective branch arm."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then we proceed with the process"
      ],
      "justification": "Maps to the positive outcome path for complete/returned orders."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Direct match for the damage notification step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Direct match for the missing item notification step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Direct match for the temporary inventory removal step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b4->n8"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process. However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "The branch and dual guards capture the XOR decision on missing item return status; the action captures the positive case."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Explicit completion statement maps to the termination action and structural end node."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Decision action and XOR branch cover the repair versus discard logic described in the text."
    },
    {
      "refs": [
        "guard:b5->n12"
      ],
      "verbatim_texts": [
        "Items are repaired and added into inventory"
      ],
      "justification": "Guards extract the exact conditional phrases for repair capability outcomes."
    },
    {
      "refs": [
        "guard:b5->n13"
      ],
      "verbatim_texts": [
        "Items can't be repaired and are discarded"
      ],
      "justification": "Guards extract the exact conditional phrases for repair capability outcomes."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Items are repaired and added into inventory"
      ],
      "justification": "Faithfully restates the successful repair outcome."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Items can't be repaired and are discarded,",
        "we email the customer with replacement charges."
      ],
      "justification": "Combines the discard condition and the subsequent customer notification step described in the source."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\" we continue the process. Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Captures the intermediate routing conditions for packing or storing items."
    },
    {
      "refs": [
        "action:n14",
        "guard:b6->n16"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\" we continue the process. If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Disposition action, XOR branch, and final routing guards map to the repeated packing/storing logic at the process tail."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Second explicit completion statement maps to another termination action and end node."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "and the process is complete."
      ],
      "justification": "Final completion phrase from the closing sentence justifies the last end action and node."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "then we can continue the process.",
        "then we also continue the process.",
        "we still continue the process."
      ],
      "justification": "Repeated continuation phrases across divergent paths imply concurrent or inclusive flows reconverging to the main sequence."
    }
  ],
