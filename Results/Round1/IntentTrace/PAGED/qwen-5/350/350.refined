init(i_start)
action(a1, "To start, please provide the userdata for flickr.")
action(a_succ, "the process will end.")
action(a_fail, "if the login fails, we will continue with the process")
action(a_try1, "please provide the userdata for flickr.")
action(a_abt1, "if you choose to abort, the process will end.")
action(a_try2, "please provide the userdata for flickr.")
action(a_abt2, "if you decide to abort, the process will end.")
branch(b_login, XOR)
branch(b_opt1, XOR)
branch(b_dec1, XOR)
branch(b_opt2, XOR)
end(e_succ)
end(e_try1)
end(e_abt1)
end(e_try2)
end(e_abt2)
defines(v_login, "login result", {"success", "fail"})
defines(v_opt1, "first retry option", {"try", "abort"})
defines(v_dec1, "after first retry decision", {"end", "continue"})
defines(v_opt2, "second retry option", {"try", "abort"})
actor(a_default, "Default", [i_start, a1, a_succ, a_fail, a_try1, a_abt1, a_try2, a_abt2, b_login, b_opt1, b_dec1, b_opt2, e_succ, e_try1, e_abt1, e_try2, e_abt2])
precedence(i_start, a1)
precedence(a1, b_login)
precedence(b_login, a_succ)
precedence(a_succ, e_succ)
precedence(b_login, a_fail)
precedence(a_fail, b_opt1)
precedence(b_opt1, a_try1)
precedence(a_try1, b_dec1)
precedence(b_dec1, e_try1)
precedence(b_dec1, b_opt2)
precedence(b_opt2, a_try2)
precedence(a_try2, e_try2)
precedence(b_opt2, a_abt2)
precedence(a_abt2, e_abt2)
precedence(b_opt1, a_abt1)
precedence(a_abt1, e_abt1)
guard(b_login, a_succ, v_login = 'success')
guard(b_login, a_fail, v_login = 'fail')
guard(b_opt1, a_try1, v_opt1 = 'try')
guard(b_opt1, a_abt1, v_opt1 = 'abort')
guard(b_dec1, e_try1, v_dec1 = 'end')
guard(b_dec1, b_opt2, v_dec1 = 'continue')
guard(b_opt2, a_try2, v_opt2 = 'try')
guard(b_opt2, a_abt2, v_opt2 = 'abort')