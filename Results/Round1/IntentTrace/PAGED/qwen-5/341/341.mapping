    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The loan application process starts with receiving the loan application."
      ],
      "justification": "The opening clause implicitly defines the process start (init) and explicitly describes the first action."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps should be completed: assessing the loan risk and checking the credit history."
      ],
      "justification": "Simultaneous execution implies an AND branch splitting into two parallel actions."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, the eligibility of the applicant is assessed."
      ],
      "justification": "Completion of parallel paths implies convergence; the transitional completion state and subsequent eligibility assessment are captured here."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the applicant is eligible"
      ],
      "justification": "Sets up the exclusive choice point; modeled redundantly as an action and a branch node, which is permitted."
    },
    {
      "refs": [
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the applicant is eligible"
      ],
      "justification": "Boolean guard correctly captures the positive condition leading to preparation."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the acceptance pack is prepared."
      ],
      "justification": "Direct paraphrase of the positive branch outcome."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the applicant is not eligible"
      ],
      "justification": "Boolean guard correctly captures the negative condition leading to rejection."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the application is rejected."
      ],
      "justification": "Direct paraphrase of the negative branch outcome."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the application is rejected, the loan application process ends."
      ],
      "justification": "Explicitly links rejection to process termination, justifying both the terminal action label and the end node."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "The prepared acceptance pack is then sent."
      ],
      "justification": "Direct match to the sequential step following eligibility confirmation."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the acceptance pack is sent, the process ends."
      ],
      "justification": "Explicitly links successful dispatch to process termination, justifying the final action label and end node."
    }
  ],
