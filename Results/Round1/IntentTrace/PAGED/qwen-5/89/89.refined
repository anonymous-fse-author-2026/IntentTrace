init(i1)
action(n1, "start the process")
action(n2, "send: Course Packet Information Received")
action(n3, "send: Design to Faculty")
action(n4_f, "Faculty chooses the design")
action(n4, "identify content requiring copyright clearance and contact publisher")
converge(c1)
branch(b1, XOR)
action(n6, "notify: Contact Faculty to inform of denial and ask if new content should be added")
action(n7, "calculate: Course Packet Cost")
action(n8, "add: Bookstore margin to determine retail price")
branch(b2, XOR)
action(n10, "notify: Notify Bookstore of Course packet  Course number  Faculty name  and sections")
action(n11, "end: Packet information notified to Bookstore")
action(n12, "reconsider content to decrease price")
end(e1)
defines(v1, "copyright status", {"Denial", "Cleared"})
defines(v2, "price status", {"Finalized", "Reconsider"})
actor(a_default, "Default", [i1, n1, n2, n3, n4_f, c1, n4, b1, n6, n7, n8, b2, n10, n11, n12, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4_f)
precedence(n4_f, c1)
precedence(c1, n4)
precedence(n4, b1)
precedence(b1, n6)
precedence(b1, n7)
precedence(n6, c1)
precedence(n7, n8)
precedence(n8, b2)
precedence(b2, n10)
precedence(b2, n12)
precedence(n12, c1)
precedence(n10, n11)
precedence(n11, e1)
guard(b1, n6, v1 = 'Denial')
guard(b1, n7, v1 = 'Cleared')
guard(b2, n10, v2 = 'Finalized')
guard(b2, n12, v2 = 'Reconsider')