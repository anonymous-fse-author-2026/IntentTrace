{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "The opening clause establishes the start event and describes the first procedural step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then Check Levels of Inventory."
      ],
      "justification": "Direct restatement of the second sequential step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "The conditional phrase defines the evaluation checkpoint and implicitly triggers the XOR decision gateway."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "below or equal to the minimum"
      ],
      "justification": "Extracts the operator and threshold guarding the affirmative inventory path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report."
      ],
      "justification": "Direct paraphrase of the reporting action for low inventory."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "greater than the minimum"
      ],
      "justification": "Extracts the operator and threshold guarding the alternative inventory path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report."
      ],
      "justification": "Direct paraphrase of the reporting action for high inventory."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)."
      ],
      "justification": "Exact match for the procurement initiation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Covers both the branching terminal action and the implicit end event for the high-inventory route."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Direct capture of the mandatory review step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked. If the PO is approved, it is printed and released in the system."
      ],
      "justification": "The dual conditional outcomes establish the approval decision point and its implicit XOR gateway."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "PO is approved"
      ],
      "justification": "Maps directly to the positive outcome condition guarding the release path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "it is printed and released in the system."
      ],
      "justification": "Exact restatement of the approved PO handling procedure."
    },
    {
      "refs": [
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "PO is rejected"
      ],
      "justification": "Maps directly to the negative outcome condition guarding the rework path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "it needs to be reworked."
      ],
      "justification": "Exact restatement of the rejected PO correction step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously,"
      ],
      "justification": "Temporal keyword explicitly signals a concurrent AND split."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "reserve funds for the released POs"
      ],
      "justification": "Direct extraction of the first concurrent task."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "mail the POs to the supplier."
      ],
      "justification": "Direct extraction of the second concurrent task."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive the Packing Slip."
      ],
      "justification": "Direct extraction of the post-funding receipt step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "receive the inventory."
      ],
      "justification": "Direct extraction of the post-mailing receipt step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "receive the Invoice."
      ],
      "justification": "Direct extraction of the financial document receipt step."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match."
      ],
      "justification": "The navigational phrasing covers both entering and executing the matching procedure."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Captures both the success condition check and the corresponding fund release action."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "issue the payment."
      ],
      "justification": "Direct restatement of the final payment execution."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Explicitly denotes the final closure action and the overall process termination event."
    }
  ],
