  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
    },
    {
      "id": "i2",
      "content": "If the inventory"
    },
    {
      "id": "i3",
      "content": "is below or equal to the minimum, generate an Equal to or below minimum Report"
    },
    {
      "id": "i4",
      "content": "If the inventory is greater than the minimum, generate an Above Minimum Report"
    },
    {
      "id": "i5",
      "content": "create Purchase Orders (POs)"
    },
    {
      "id": "i6",
      "content": "If the report indicates that the inventory is above the minimum, the process ends."
    },
    {
      "id": "i7",
      "content": "If the PO is rejected"
    },
    {
      "id": "i8",
      "content": "If the PO is rejected, it needs to be reworked."
    },
    {
      "id": "i9",
      "content": "If the PO is approved"
    },
    {
      "id": "i10",
      "content": "If the PO is approved, it is printed and released in the system."
    },
    {
      "id": "i11",
      "content": "If the PO is created, it needs to be reviewed."
    },
    {
      "id": "i12",
      "content": "Simultaneously"
    },
    {
      "id": "i13",
      "content": "reserve funds for the released POs and mail the POs to the supplier"
    },
    {
      "id": "i14",
      "content": "receive the Packing Slip"
    },
    {
      "id": "i15",
      "content": "receive the inventory"
    },
    {
      "id": "i16",
      "content": "receive the Invoice"
    },
    {
      "id": "i17",
      "content": "Three-way match"
    },
    {
      "id": "i18",
      "content": "If the Three-way match"
    },
    {
      "id": "i19",
      "content": "is successful, release the funds"
    },
    {
      "id": "i20",
      "content": "Once the funds are released, issue the payment."
    },
    {
      "id": "i21",
      "content": "After the payment is issued, the Resupply Cycle is complete and the process ends."
    }
  ]
