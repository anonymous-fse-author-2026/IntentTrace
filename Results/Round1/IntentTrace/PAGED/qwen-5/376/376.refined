precedence(b1, n4)
precedence(b1, n5)
precedence(n4, e1)
precedence(n5, b2)
precedence(b2, c1)
precedence(b2, e2)
guard(b1, n4, v1 = 'Yes')
guard(b1, n5, v1 = 'No')
guard(b2, c1, v2 = 'Retry')
guard(b2, e2, v2 = 'Abort')