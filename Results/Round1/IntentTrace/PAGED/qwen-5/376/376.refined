init(i1)
end(e1)
end(e2)
action(n1, "Start process for flickr login")
action(n2, "Provide userdata for flickr login")
action(n3, "Is login successful")
action(n4, "End process after successful login")
action(n5, "Decide to retry or abort")
branch(b1, XOR)
branch(b2, XOR)
converge(c1)
defines(v1, "Is login successful", {"Yes", "No"})
defines(v2, "User choice after failure", {"Retry", "Abort"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, e1, e2, b1, b2, c1])
precedence(i1, n1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, n3)
