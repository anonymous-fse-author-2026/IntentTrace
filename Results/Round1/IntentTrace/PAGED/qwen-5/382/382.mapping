    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Exact match for the continuation scan step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "proceed with Macroscopic description writing."
      ],
      "justification": "Exact match for macroscopic writing step."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Tissue processing, check if 'Digitalization?' is required."
      ],
      "justification": "Timing word 'Simultaneously' implies an AND split (b3), and the clause enumerates both parallel tasks (n11, n12)."
    },
    {
      "refs": [
        "guard:b1->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the answer is 'yes,' proceed with Digitalization."
      ],
