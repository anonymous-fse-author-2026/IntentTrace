      ],
      "justification": "Second negative conditional arm matches guard and rejoining converge node."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "assign cases to the pathologist and then move on to Microscopic examination and diagnosis."
      ],
      "justification": "Conjunctive clause covers two sequential downstream actions."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
