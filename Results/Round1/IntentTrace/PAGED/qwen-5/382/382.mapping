    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If the answer is 'no,' continue the process."
      ],
      "justification": "Negative guard condition directs flow back to the main path, implying convergence."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "check if 'Digitalization?' is required again."
      ],
      "justification": "Repeated check action establishes the second explicit decision node (b2)."
    },
    {
      "refs": [
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the answer is 'yes,' proceed with Digitalization."
      ],
      "justification": "Second positive conditional arm matches guard and action content."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
