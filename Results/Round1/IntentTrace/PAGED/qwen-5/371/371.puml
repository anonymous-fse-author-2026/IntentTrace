@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start ExpenseReport process;
:click Start;
:select Edit Report;
:expense greater than 1000?;
:v1: expense greater than 1000? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:review report;
else ([v1 = 'No'])
:check if there is a need for translation;
:v3: translation required? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:translate receipts;
else ([v3 = 'No'])
:confirm receipts;
endif
endif
:After this, evaluate the review decision;
:v2: review decision ({Rejected, Approved}); <<objectSignal>>
if () then ([v2 = 'Rejected'])
:edit report;
else ([v2 = 'Approved'])
:continue to check if there is a need for translation;
:v4: second translation required? ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:translate receipts;
else ([v4 = 'No'])
:confirm receipts;
endif
:Once again, evaluate the review decision;
:v5: second review decision ({Rejected, Approved}); <<objectSignal>>
if () then ([v5 = 'Rejected'])
:edit report;
else ([v5 = 'Approved'])
:translate the receipts and then confirm them;
:evaluate the receipts decision;
:v6: evaluate receipts decision ({Accepted, Rejected}); <<objectSignal>>
if () then ([v6 = 'Accepted'])
:process expense;
else ([v6 = 'Rejected'])
:edit report;
:End;
endif
stop
endif
endif
@enduml