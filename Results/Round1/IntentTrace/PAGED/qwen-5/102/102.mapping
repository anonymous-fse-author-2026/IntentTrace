{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "The opening clause implicitly initiates the process (init) and describes the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level."
      ],
      "justification": "Directly corresponds to the inventory check action."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the"
      ],
      "justification": "Signals the start of an exclusive decision point regarding inventory status."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "Inventory level is at or below the minimum"
      ],
      "justification": "Exact condition threshold for the positive branch."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then proceed to Create Purchase Order."
      ],
      "justification": "Directly matches the action triggered by the low inventory condition."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if the Inventory Level is above the minimum"
      ],
      "justification": "Exact condition threshold for the negative branch."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process ends."
      ],
      "justification": "The explicit termination instruction supports both the end-state action and the structural end node."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Direct paraphrase of the sequential review step."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved"
      ],
      "justification": "The approval condition jointly justifies the preparatory action, the XOR branch structure, and the outgoing guard."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "then reserve the funds for the purchase."
      ],
      "justification": "Directly matches the fund reservation action."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the Purchase Order is rejected"
      ],
      "justification": "Exact condition for the rejection path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then rework the order."
      ],
      "justification": "Directly matches the rework action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Temporal phrasing aligns with the send-order action."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "The loop-back instruction implies a convergence point where the rework path rejoins the main flow."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "The concurrency trigger explicitly justifies an AND parallel split."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the Supplier sends a packing slip"
      ],
      "justification": "Directly matches the first parallel supplier action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "and an invoice."
      ],
      "justification": "Directly matches the second parallel supplier action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it."
      ],
      "justification": "Directly matches the packing slip recording step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Similarly, when the invoice is received, record it as well."
      ],
      "justification": "Directly matches the invoice recording step."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice,"
      ],
      "justification": "Waiting for both recorded items implies a synchronization/converge point."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "Directly matches the combined payment release action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "The closing instruction fully justifies both the final action description and the structural end node."
    }
  ],
