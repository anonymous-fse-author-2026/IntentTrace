{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by claiming what is requested"
      ],
      "justification": "The opening phrase implicitly triggers the process start and explicitly describes the first action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then check the insured status of the claimant."
      ],
      "justification": "Sequential action that follows the initial claim step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the claimant is insured"
      ],
      "justification": "Conditional clause establishes the XOR branch and supports the positive guard condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed to evaluate the claim."
      ],
      "justification": "Action executed on the positive (insured) path."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if the claimant is not insured, reject the claim."
      ],
      "justification": "Negative condition and its corresponding rejection action are directly aligned."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "notify the claimant and the process comes to an end."
      ],
      "justification": "Notification step immediately followed by an explicit process termination signal."
    },
    {
      "refs": [
        "guard:b2->n10",
        "guard:b2->n11",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the claim is a simple one or a complex one, send the relevant forms accordingly."
      ],
      "justification": "The either/or condition drives the branch, both guards, and the two distinct form-sending actions."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the forms are returned"
      ],
      "justification": "Completion of the divergent form paths implies a converge point, leading into the form receipt action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "check them for completeness."
      ],
      "justification": "Direct mapping to the data validation step."
    },
    {
      "refs": [
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided"
      ],
      "justification": "Condition on completeness establishes the next XOR decision and its positive guard."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "proceed to register the claim."
      ],
      "justification": "Action performed when the completeness condition is satisfied."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "if not all the relevant details are provided, inform the claimant to complete them."
      ],
      "justification": "Incomplete details trigger the negative guard and the corresponding notification action."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Once the claim is registered, the process comes to an end."
      ],
      "justification": "Explicit termination statement following the successful registration path."
    }
  ],
