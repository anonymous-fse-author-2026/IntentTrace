@startuml
!theme plain
|a_default| Default
|a_default|
start
:Ask 1st Level Support if there is an issue;
:v1: Issue resolved? ({Yes, No}); <<objectSignal>>
if () then ([v1 = "Yes"])
:Provide feedback for account manager;
stop
else ([v1 = "No"])
:Ask developer for assistance;
:Check result again;
:v2: Result resolved? ({Yes, No}); <<objectSignal>>
if () then ([v2 = "Yes"])
:Provide feedback for account manager;
else ([v2 = "No"])
:Ask developer for help;
:Provide feedback for account manager;
:Ask developer and provide feedback for 1st Level support;
:Provide feedback for 1st Level support and account manager;
endif
stop
endif
@enduml