@startuml
!theme plain
|a_default| Default
|a_default|
start
:v_order: Order Status ({Rejected, Accepted}); <<objectSignal>>
if () then ([v_order = 'Rejected'] [v_order = 'Accepted'])
->;
else ([v_order = 'Rejected'] [v_order = 'Accepted'])
->;
endif
split
:Prepare Assembling Order;
split again
:Check Availability;
end split
:v_availability: Availability Status ({Backorder, Reserved}); <<objectSignal>>
if () then ([v_availability = 'Backorder'])
:Check Availability Again;
stop
else ([v_availability = 'Reserved'])
:Assemble Bike;
:Ship Product;
stop
endif
@enduml