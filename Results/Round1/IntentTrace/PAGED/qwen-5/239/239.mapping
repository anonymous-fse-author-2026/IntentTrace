  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "For the company, the first step is to look at the order."
      ],
      "justification": "Establishes the initiation of the process workflow."
    },
    {
      "refs": [
        "guard:b_order->c_order"
      ],
      "verbatim_texts": [
        "If the order is to be rejected, the process should continue. If the order is to be accepted, the process should also continue."
      ],
      "justification": "The conditional triggers the XOR branch, the two guards capture the rejected/accepted states, and continuing on both arms implicitly merges at the converge node."
    },
    {
      "refs": [
        "action:n_prepare",
        "action:n_check_avail"
      ],
      "verbatim_texts": [
        "At the same time, two steps need to be completed: preparing the assembling order and checking availability."
      ],
      "justification": "'At the same time' signals an AND-split for concurrent execution of the two listed actions, which reconvene upon completion."
    },
    {
      "refs": [
        "guard:b_availability->n_check_again",
        "action:n_check_again"
      ],
      "verbatim_texts": [
        "If there is a backorder, availability needs to be checked again and the process ends."
      ],
      "justification": "Maps the backorder condition to the branch and guard, the re-check action, and explicitly terminates that path."
    },
    {
      "refs": [
        "guard:b_availability->n_assemble"
      ],
      "verbatim_texts": [
        "If the item can be reserved, the process should continue."
      ],
      "justification": "Guard accurately captures the reservation condition that permits flow to advance to subsequent steps."
    },
    {
      "refs": [
        "action:n_assemble",
        "action:n_ship"
      ],
      "verbatim_texts": [
        "The next steps are to assemble the bike and then ship the product."
      ],
      "justification": "Directly maps the sequential assembly and shipping actions, concluding with the natural end of the process."
    }
  ],
