{
  "matches": [
    {
      "refs": [
        "action:a_start"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial interaction steps."
    },
    {
      "refs": [
        "guard:b_exp->a_rev",
        "action:a_rev"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "The conditional introduces the XOR branch, the guard captures the threshold, and the action describes the positive outcome."
    },
    {
      "refs": [
        "guard:b_exp->a_chkTrans1",
        "action:a_chkTrans1"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "The guard captures the alternative threshold, and the action describes the corresponding step."
    },
    {
      "refs": [
        "guard:b_trans1->a_trans",
        "action:a_trans"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "The conditional opens the second XOR branch, the guard captures the requirement state, and the action describes the translation step."
    },
    {
      "refs": [
        "guard:b_trans1->a_conf",
        "action:a_conf"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "The guard captures the negative case, and the action describes the confirmation step."
    },
    {
      "refs": [
        "guard:b_rev1->a_edit1",
        "action:a_edit1"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Direct mapping of the rejection guard and the corresponding editing action."
    },
    {
      "refs": [
        "guard:b_rev1->a_chkTrans2",
        "action:a_chkTrans2"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Direct mapping of the approval guard and the follow-up checking action."
    },
    {
      "refs": [
        "guard:b_rev2->a_edit2",
        "action:a_edit2"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Direct mapping of the second rejection guard and editing action."
    },
    {
      "refs": [
        "guard:b_rev2->a_transConf",
        "action:a_transConf"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Direct mapping of the second approval guard and the combined translation/confirmation action."
    },
    {
      "refs": [
        "guard:b_rec->a_proc",
        "action:a_proc"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Direct mapping of the acceptance guard and the processing action."
    },
    {
      "refs": [
        "guard:b_rec->a_edit3",
        "action:a_edit3"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Direct mapping of the rejection guard and the fallback editing action."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Explicitly states the termination point of the workflow."
    }
  ],
