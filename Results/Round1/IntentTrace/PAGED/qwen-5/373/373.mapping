{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The opening clause implicitly initiates the process and describes the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Directly describes the second sequential action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "The decision step inherently introduces the XOR branching point for rejection vs acceptance."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected"
      ],
      "justification": "Condition on the rejection path faithfully restates the source threshold/outcome."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the claim is to be accepted"
      ],
      "justification": "Condition on the acceptance path faithfully restates the source threshold/outcome."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then reject it."
      ],
      "justification": "Direct paraphrase of the rejection arm action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "offer the benefit."
      ],
      "justification": "Direct paraphrase of the acceptance arm action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "review the claim rejection."
      ],
      "justification": "Exact match for the post-rejection step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "prepare the claim discharge."
      ],
      "justification": "Exact match for the post-acceptance step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Directly matches the sequential recording step following discharge preparation."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted"
      ],
      "justification": "The conditional query and its corresponding XOR branch element share this source span."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted",
        "But if the claim rejection is not accepted"
      ],
      "justification": "Both guard variants (Yes/No) map to the affirmative and negative outcomes described in the text."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "continue the process.",
        "also continue the process."
      ],
      "justification": "Represents the unified continuation step executed regardless of the rejection review outcome."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Models the implicit synchronization/merge point where the benefit and rejection paths rejoin before termination. Treated as a match per redundancy rules."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicitly signals process termination, supporting both the labeled end step and the structural end node."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "At the same time,"
      ],
      "justification": "Temporal concurrency keyword explicitly justifies the AND gateway splitting the final parallel tasks."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "operate outgoing payment and close the claim."
      ],
      "justification": "Describes the two concurrent actions and implicitly their subsequent rejoining points before the process concludes."
    }
