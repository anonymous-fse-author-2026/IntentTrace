init(i1)
action(n2, "receive order request")
action(n3, "register order")
action(n4, "evaluate order")
branch(b1, XOR)
action(n8, "perform installation")
branch(b2, XOR)
action(n10, "check installation")
action(n11, "prepare billing")
action(n13, "mark order as ok")
action(n14, "end ok")
end(e_nok)
end(e_ok)
defines(v1, "evaluation result ok", {"NOK", "ok"})
defines(v2, "installation successful", {"No", "Yes"})
actor(a_default, "Default", [i1, n2, n3, n4, b1, n8, b2, n10, n11, n13, n14, e_nok, e_ok])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, e_nok)
precedence(b1, n8)
precedence(n8, b2)
precedence(b2, e_nok)
precedence(b2, n10)
precedence(n10, n11)
precedence(n11, n13)
precedence(n13, n14)
precedence(n14, e_ok)
guard(b1, e_nok, v1 = 'NOK')
guard(b1, n8, v1 = 'ok')
guard(b2, e_nok, v2 = 'No')
guard(b2, n10, v2 = 'Yes')