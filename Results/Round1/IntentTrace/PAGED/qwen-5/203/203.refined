init(i1)
action(n1, "Start the loan process")
action(n2, "Check loan application")
branch(b1, XOR)
action(n4, "Process ends")
end(e1)
action(n5, "Apply special terms")
action(n6, "Disburse funds")
action(n7, "Process ends")
end(e2)
defines(v1, "Decision outcome", {"Rejected", "SpecialTerms"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, e1, n5, n6, n7, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, n7)
precedence(n7, e2)
precedence(n4, e1)
guard(b1, n4, v1 = 'Rejected')
guard(b1, n5, v1 = 'SpecialTerms')