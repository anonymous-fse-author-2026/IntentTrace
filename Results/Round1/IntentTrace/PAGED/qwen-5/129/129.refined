init(i1)
action(n_check, "check loan application")
branch(b_dec, XOR)
action(n_disburse, "disburse funds")
end(e_rej)
end(e_end)
defines(v_res, "result", {"rejected", "agreed"})
actor(a_default, "Default", [i1, n_check, b_dec, n_disburse, e_rej, e_end])
precedence(i1, n_check)
precedence(n_check, b_dec)
precedence(b_dec, e_rej)
precedence(b_dec, n_disburse)
precedence(n_disburse, e_end)
guard(b_dec, e_rej, v_res = 'rejected')
guard(b_dec, n_disburse, v_res = 'agreed')