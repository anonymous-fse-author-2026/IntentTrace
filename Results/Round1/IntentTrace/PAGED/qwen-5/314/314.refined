init(i1)
action(n1, "Identify Vacancy")
action(n2, "Any candidates available?")
branch(b1, XOR)
converge(c1)
action(n3, "Select Applicant")
converge(c2)
action(n4, "Advertise Vacancy")
action(n5, "After advertising  any candidates?")
branch(b2, XOR)
action(n6, "Advertise Again")
action(n7, "Final check: Any candidates after second advertisement?")
branch(b3, XOR)
action(n8, "End")
end(e1)
defines(v1, "Any candidates available?", {"Yes", "No"})
defines(v2, "After advertising  any candidates?", {"Yes", "No"})
defines(v3, "Final check: Any candidates after second advertisement?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, c1, n3, c2, n4, n5, b2, n6, n7, b3, n8, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, c1)
precedence(b1, n4)
precedence(n4, n5)
precedence(n5, b2)
precedence(b2, c1)
precedence(b2, n6)
precedence(n6, n7)
precedence(n7, b3)
precedence(b3, c1)
precedence(b3, c2)
precedence(c1, n3)
precedence(n3, c2)
precedence(c2, n8)
precedence(n8, e1)
guard(b1, c1, v1 = 'Yes')
guard(b1, n4, v1 = 'No')
guard(b2, c1, v2 = 'Yes')
guard(b2, n6, v2 = 'No')
guard(b3, c1, v3 = 'Yes')
guard(b3, c2, v3 = 'No')