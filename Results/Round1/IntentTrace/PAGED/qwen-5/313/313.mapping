{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "Implicit process start and direct mapping to the first registration step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If there is no fee"
      ],
      "justification": "Implies the XOR gateway splitting the flow based on fee presence."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no fee"
      ],
      "justification": "Exact condition for the no-fee branch arm."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "register a post-seminar request"
      ],
      "justification": "Direct match to the action on the no-fee path."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "the process will come to an end"
      ],
      "justification": "Explicit termination of the no-fee workflow."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if there is a fee"
      ],
      "justification": "Exact condition for the alternative fee-based path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "create a purchase request"
      ],
      "justification": "Direct match to the required action when a fee exists."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "check if the purchase request has been approved"
      ],
      "justification": "Implies the second XOR gateway evaluating approval status."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Captures the positive approval condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "you will receive an approved notification"
      ],
      "justification": "Direct paraphrase of the approval outcome step."
    },
    {
      "refs": [
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "if the purchase request is rejected"
      ],
      "justification": "Captures the negative rejection condition."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "you will be notified of the rejection"
      ],
      "justification": "Direct paraphrase matching the rejection notification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "you should then register a post-seminar request"
      ],
      "justification": "Direct match to the subsequent registration step triggered by approval."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Explicit termination condition for the rejection path."
    }
  ],
