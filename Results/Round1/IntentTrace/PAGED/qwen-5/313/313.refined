init(i1)
action(n2, "register participation for the event")
branch(b1, XOR)
action(n4, "register post-seminar request")
end(e1)
action(n6, "create purchase request")
branch(b2, XOR)
action(n8, "receive approved notification")
action(n9, "register post-seminar request")
end(e2)
action(n11, "receive rejection notification")
end(e3)
defines(v1, "is there a fee?", {"No fee", "Fee"})
defines(v2, "is purchase request approved?", {"Approved", "Rejected"})
actor(a_default, "Default", [i1, n2, b1, n4, e1, n6, b2, n8, n9, e2, n11, e3])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(n4, e1)
precedence(b1, n6)
precedence(n6, b2)
precedence(b2, n8)
precedence(n8, n9)
precedence(n9, e2)
precedence(b2, n11)
precedence(n11, e3)
guard(b1, n4, v1 = 'No fee')
guard(b1, n6, v1 = 'Fee')
guard(b2, n8, v2 = 'Approved')
guard(b2, n11, v2 = 'Rejected')