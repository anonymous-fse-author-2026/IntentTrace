{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, go to the Amazon homepage."
      ],
      "justification": "The opening phrase implicitly signals the process start and describes the first navigation action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, search for a book."
      ],
      "justification": "Directly corresponds to the search step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once you've found the book, click on the link that says \"22 used\" to see the used books available."
      ],
      "justification": "Faithful paraphrase of clicking the specific link to view used books."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "From there, click on the \"Add to Cart\" button for the second book on the list."
      ],
      "justification": "Accurately captures the target item (second book) and the exact button clicked."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After adding it to your cart, click on the \"Proceed to Checkout\" button."
      ],
      "justification": "Direct match for the checkout initiation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "On the checkout page, enter your email address and select the option that says \"I am a new customer\"."
      ],
      "justification": "Combines two sequential inputs described in the same clause into one action node, preserving exact meaning."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Next, click on the \"Sign in using our secure server\" button."
      ],
      "justification": "Exact button label matched."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once you've signed in, enter your customer details and click on the \"Create account\" button."
      ],
      "justification": "Combines detail entry and account creation click into a single action as stated in the source."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After creating your account, enter your shipping details and click on the \"Continue\" button."
      ],
      "justification": "Matches the combined shipping detail entry and continue action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "On the next page, select your preferred shipping options and click on \"Continue\" again."
      ],
      "justification": "Correctly captures selecting options and the subsequent continue click."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Then, choose your payment method and enter your credit card details."
      ],
      "justification": "Direct match for payment selection and data entry."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Click on the \"Add your card\" button to save your card information."
      ],
      "justification": "Matches the button click to save card info."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After that, click on \"Continue\" to proceed."
      ],
      "justification": "Direct match for the proceeding step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Next, choose your billing address and select the option to use the address you've chosen."
      ],
      "justification": "Faithfully restates the address selection and confirmation steps."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, click on \"Place your order in AUD\" to complete the process."
      ],
      "justification": "The closing action triggers the process completion, justifying both the final step and the implicit end node."
    }
  ],
