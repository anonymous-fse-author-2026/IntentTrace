    "init(i1)",
    "action(n1, \"To begin the process, Rental Items are Returned to the Store.\")",
    "action(n2, \"If the Customer returns the items to the store, then we can continue the process. However, if the Delivery Crew picks-up items at the event site, then we also continue the process.\")",
    "branch(b1, XOR)",
    "action(n3, \"During this step, the items are counted and compared to the original contract.\")",
    "action(n4, \"If the Order is complete and all items were returned, then we proceed with the process. However, if the Order is incomplete and items are missing, we still continue the process. Similarly, if the Order is complete but items are damaged, we email the customer to inform them of the damage and additional charges.\")",
    "branch(b2, XOR)",
    "action(n5, \"In case of missing items and replacement charges, we email the customer to inform them.\")",
    "action(n6, \"If the Customer returns the missing items, we continue the process. However, if the Customer does not return the missing items, we still continue the process.\")",
    "branch(b3, XOR)",
    "action(n7, \"we email the customer to inform them of the damage and additional charges\")",
    "action(n8, \"Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory.\")",
    "action(n9, \"If the Items are repaired and added into inventory, we continue the process. On the other hand, if the Items can't be repaired and are discarded, we email the customer with replacement charges.\")",
