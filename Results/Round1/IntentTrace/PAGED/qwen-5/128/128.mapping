{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "The opening clause explicitly starts the process and describes the initial return action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process. However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Action captures the full conditional routing text, while the branch node structurally represents the XOR decision implied by 'If... However, if...'."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "Customer returns the items to the store",
        "Delivery Crew picks-up items at the event site"
      ],
      "justification": "Guard payloads extract the exact quoted conditions that determine the outgoing path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct verbatim match for the counting/comparison action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Action covers the multi-condition branching logic and the embedded damage-email step; branch node captures the XOR split."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "Order is complete and all items were returned"
      ],
      "justification": "Guards carry the exact quoted conditions. The converge node is structurally justified as the point where the 'complete' path rejoins the main flow."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "Order is incomplete and items are missing"
      ],
      "justification": "Guards carry the exact quoted conditions. The converge node is structurally justified as the point where the 'complete' path rejoins the main flow."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "Order is complete but items are damaged"
      ],
      "justification": "Guards carry the exact quoted conditions. The converge node is structurally justified as the point where the 'complete' path rejoins the main flow."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Each action faithfully restates a distinct operational step described in the source. Redundant overlap with n4's span is acceptable per rules."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Each action faithfully restates a distinct operational step described in the source. Redundant overlap with n4's span is acceptable per rules."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges"
      ],
      "justification": "Each action faithfully restates a distinct operational step described in the source. Redundant overlap with n4's span is acceptable per rules."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process. However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Captures the exclusive choice regarding missing item return status and its implied XOR branch."
    },
    {
      "refs": [
        "guard:b3->c1"
      ],
      "verbatim_texts": [
        "Customer returns the missing items",
        "Customer does not return the missing items"
      ],
      "justification": "Extracts the exact quoted conditions governing the post-missing-items decision."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Explicitly signals the termination of this process segment, justifying both the action description and the end node."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Covers the repair-versus-discard decision logic and its immediate consequences."
    },
    {
      "refs": [
        "guard:b4->n10"
      ],
      "verbatim_texts": [
        "Items are repaired and added into inventory"
      ],
      "justification": "Exact extraction of the two mutually exclusive conditions."
    },
    {
      "refs": [
        "guard:b4->n11"
      ],
      "verbatim_texts": [
        "Items can't be repaired and are discarded"
      ],
      "justification": "Exact extraction of the two mutually exclusive conditions."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the Items are repaired and added into inventory, we continue the process."
      ],
      "justification": "Actions decompose the branch outcomes into granular steps. n12 is a redundant extraction of the email step, which is permitted."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "if the Items can't be repaired and are discarded, we email the customer with replacement charges."
      ],
      "justification": "Actions decompose the branch outcomes into granular steps. n12 is a redundant extraction of the email step, which is permitted."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "we email the customer with replacement charges."
      ],
      "justification": "Actions decompose the branch outcomes into granular steps. n12 is a redundant extraction of the email step, which is permitted."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order. If the \"Items are packed for an existing order,\" we continue the process. If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Captures the final packing/storage decision point and its associated conditional flow."
    },
    {
      "refs": [
        "guard:b5->n14"
      ],
      "verbatim_texts": [
        "Items are packed for an existing order",
        "Items are stored for future orders"
      ],
      "justification": "Guards accurately reflect the two quoted routing conditions."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges, and the process is complete."
      ],
      "justification": "Direct match for the final notification and completion state."
    }
