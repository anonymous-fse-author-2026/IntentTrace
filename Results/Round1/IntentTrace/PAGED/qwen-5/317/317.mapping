{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially, it is important to check the Referee Reports."
      ],
      "justification": "The opening clause establishes the process context/start and describes the initial checking action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "At the same time, you should continue to monitor if the Referee Reports have been completed."
      ],
      "justification": "Captures the concurrent monitoring action described immediately after the initial check."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If they have been completed",
        "if they have not been completed"
      ],
      "justification": "Marks the exclusive decision point based on report completion status."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If they have been completed, you can proceed with the process"
      ],
      "justification": "Aligns the positive guard condition with the corresponding forward-moving action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if they have not been completed, you should flag it and send a reminder"
      ],
      "justification": "Aligns the negative guard condition with the flagging and reminder action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check again if the Referee Reports have been completed"
      ],
      "justification": "Direct match to the re-check instruction following the reminder loop."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If they have",
        "If not"
      ],
      "justification": "The re-evaluation question and subsequent binary choice map to the check action and XOR branch."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If they have, you can continue with the process"
      ],
      "justification": "Maps the positive re-check outcome guard and continuation action."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If not, you should flag it again and send another reminder"
      ],
      "justification": "Maps the negative re-check outcome guard and repeated reminder action."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Once the Referee Reports have been completed"
      ],
      "justification": "Signals the point where the retry loop resolves and flow rejoins the main path."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "move on to organizing interviews for the Selection Panel with the top candidates"
      ],
      "justification": "Direct paraphrase of the interview organization step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive feedback from the interview candidates"
      ],
      "justification": "Direct match to the feedback collection step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Next, you need to check if a Psychometric Test is required.",
        "If it is",
        "If not"
      ],
      "justification": "Combines the inquiry action and the resulting exclusive branch based on test requirement."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is, you should then check if an HR Specialist is required"
      ],
      "justification": "Links the positive psych-test condition to the HR specialist verification action."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If not, you can continue with the process and coordinate the second round of selection"
      ],
      "justification": "Links the negative psych-test condition to the second-round coordination action."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required",
        "Otherwise"
      ],
      "justification": "Captures the secondary exclusive decision regarding HR involvement."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required, you should schedule the test with a third party"
      ],
      "justification": "Matches the positive HR requirement guard and third-party scheduling action."
    },
    {
      "refs": [
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "Otherwise, you can proceed to complete the Psychometric Test"
      ],
      "justification": "Matches the negative HR requirement guard ('otherwise') and the internal test completion action."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Finally, you should request the final candidate ranking"
      ],
      "justification": "Direct match to the final ranking request step."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "and continue with the process."
      ],
      "justification": "The closing phrase signals the natural termination/conclusion of the described workflow segment."
    }
