{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The opening clause implicitly starts the process (init) AND describes the first action step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Direct paraphrase of the creation and recording step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "The action describes the decision step, which implicitly triggers the XOR branching gateway."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "The guard captures the rejection condition, and the action captures the corresponding rejection step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Direct match for the review step following a rejection."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "Guard and action n9 capture the acceptance condition; action n10 captures the benefit offering step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Direct match for the discharge preparation step on the acceptance path."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Captures the payment recording step, with the timing phrase indicating flow order."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process. But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Both conditional outcomes converge to the same continuation step, faithfully restated by the action."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicitly marks the process termination point."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "The timing word justifies the concurrent guard; the subsequent phrases directly match the two parallel actions."
    }
  ],
