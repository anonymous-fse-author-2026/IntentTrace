  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start with the Resupply Cycle Triggered step"
    },
    {
      "id": "i2",
      "content": "followed by checking the Inventory Level."
    },
    {
      "id": "i3",
      "content": "If the \"Inventory level is at or below the minimum\", then proceed to Create Purchase Order. However, if the \"Inventory Level is above the minimum\", then the process ends."
    },
    {
      "id": "i4",
      "content": "Inventory level is at or below the minimum"
    },
    {
      "id": "i5",
      "content": "proceed to Create Purchase Order."
    },
    {
      "id": "i6",
      "content": "Inventory Level is above the minimum"
    },
    {
      "id": "i7",
      "content": "then the process ends."
    },
    {
      "id": "i8",
      "content": "move on to Reviewing the Purchase Order."
    },
    {
      "id": "i9",
      "content": "If the Purchase Order is approved, then reserve the funds for the purchase. On the other hand, if the Purchase Order is rejected, then rework the order."
    },
    {
      "id": "i10",
      "content": "approved"
    },
    {
      "id": "i11",
      "content": "reserve the funds for the purchase."
    },
    {
      "id": "i12",
      "content": "rejected"
    },
    {
      "id": "i13",
      "content": "rework the order."
    },
    {
      "id": "i14",
      "content": "send the Order to Suppliers."
    },
    {
      "id": "i15",
      "content": "review the Purchase Order again."
    },
    {
      "id": "i16",
      "content": "Simultaneously"
    },
    {
      "id": "i17",
      "content": "the Supplier sends a packing slip and an invoice."
    },
    {
      "id": "i18",
      "content": "Once the packing slip is received, record it."
    },
    {
      "id": "i19",
      "content": "when the invoice is received, record it as well."
    },
    {
      "id": "i20",
      "content": "After recording the packing slip and invoice"
    },
    {
      "id": "i21",
      "content": "release the reserved funds and issue the payment to the supplier."
    },
    {
      "id": "i22",
      "content": "Finally, the process ends after the payment is issued to the supplier."
    }
  ]
