    {
      "refs": [
        "action:n2",
        "label:n1->n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "Implies process start, defines the initial action, and labels the transition identically."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "label:n2->n3"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer,"
      ],
      "justification": "Captures the conditional check as an action query, XOR gateway, guard condition, and edge label."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should then check the availability of the parts."
      ],
      "justification": "Direct paraphrase of the positive branch action."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "On the other hand, if they already have the availability information, they can proceed with the process.",
        "If the parts are supplied to the customer, the team can also continue with the process."
      ],
      "justification": "Combines both alternative scenarios into a single guard condition for the non-elicitation path."
    },
    {
      "refs": [
        "action:n5",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if they need to record the customer's details,"
      ],
      "justification": "Models the secondary condition as a branching point and associated checking/recording actions."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6",
        "action:n7",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "they should order and receive the part from Disuki."
      ],
      "justification": "Represents the ordering and receiving steps along with their triggering transitions."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "Reception implies path convergence, immediately followed by the contracting action."
    },
    {
      "refs": [
        "action:n10",
        "label:n10->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected, the team can proceed with the payment."
      ],
      "justification": "Maps the collection milestone, transition label, and payment action."
    },
    {
      "refs": [
        "label:n11->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "Final transition label, termination action, implicit final merge, and explicit end node all derive from the closing statement."
    }
  ],
