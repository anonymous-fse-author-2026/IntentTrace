{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "The opening clause implicitly starts the process and describes the first placement step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Check the Customer's Credit Limit"
      ],
      "justification": "Direct match to the credit limit verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\""
      ],
      "justification": "Models the credit limit condition check and the subsequent XOR decision point."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\""
      ],
      "justification": "Captures the positive guard value matching the source condition."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the response is \"No\""
      ],
      "justification": "Captures the negative guard value matching the source condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article"
      ],
      "justification": "Direct match to the positive-arm action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "send a Denial to the Customer"
      ],
      "justification": "Direct match to the negative-arm denial step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After checking the availability, if the response is \"Okay\""
      ],
      "justification": "Models the secondary availability check and its branching decision."
    },
    {
      "refs": [
        "guard:b2->b3"
      ],
      "verbatim_texts": [
        "if the response is \"Okay\""
      ],
      "justification": "Guard continues the flow to the next decision on a positive response."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the response is \"No\""
      ],
      "justification": "Guard routes to the denial step on a negative response."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "send a Denial to the Customer"
      ],
      "justification": "Direct match to the denial step for unavailability."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the Article is not available"
      ],
      "justification": "Defines the third decision point based on article status."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If the Article is not available"
      ],
      "justification": "Matches the condition leading to production."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "proceed to Produce the Goods"
      ],
      "justification": "Direct match to the production step."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "if the Article is available"
      ],
      "justification": "Matches the condition leading to collection."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "proceed to Collect the Goods"
      ],
      "justification": "Direct match to the collection step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Implicit converge after split paths, followed by the confirmation action."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Timing word explicitly triggers the AND gateway for parallel execution."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Ship the Goods"
      ],
      "justification": "Direct match to the first parallel step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Send the Invoice"
      ],
      "justification": "Direct match to the second parallel step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Direct match to the payment verification step."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "If the payment has been received"
      ],
      "justification": "Defines the payment decision point."
    },
    {
      "refs": [
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "If the payment has been received"
      ],
      "justification": "Guard value corresponds to the positive payment condition."
    },
    {
      "refs": [
        "guard:b4->n19"
      ],
      "verbatim_texts": [
        "If the payment has not been received"
      ],
      "justification": "Guard value corresponds to the negative payment condition."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "close the Order and end the process."
      ],
      "justification": "Models closing the order and terminating the process on successful payment."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "check if the Reminder count is greater than or equal to 3"
      ],
      "justification": "Direct match to the reminder threshold evaluation step."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3"
      ],
      "justification": "Defines the final decision point based on reminder history."
    },
    {
      "refs": [
        "guard:b5->n21"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3"
      ],
      "justification": "Guard matches the threshold condition leading to write-off."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Write off the Order"
      ],
      "justification": "Direct match to the write-off step."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Models the alternative path guard and the reminder dispatch action."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "close the Order and end the process."
      ],
      "justification": "Models closing the order and ending the process after a write-off."
    }
  ],
