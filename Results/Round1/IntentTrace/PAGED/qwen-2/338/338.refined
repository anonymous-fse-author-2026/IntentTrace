init(i1)
branch(b1, XOR)
action(n_research_direct, "Research schedule")
action(n_provide_ind, "Provide indications")
action(n_research_after_ind, "Research schedule")
converge(c_join1)
action(n_validate_sched, "Validate schedule")
branch(b_sched_sat, XOR)
action(n_research_again, "Research schedule")
branch(b_sched_sat2, XOR)
action(n_provide_ind2, "Provide indications")
converge(c_write_prep)
action(n_write_ticket, "Write ticket order to SNCF")
action(n_validate_tkt1, "Validate ticket order")
branch(b_app1, XOR)
end(e_end1)
action(n_validate_tkt2, "Validate ticket order")
branch(b_app2, XOR)
end(e_end2)
action(n_validate_tkt3, "Validate ticket order")
branch(b_app3, XOR)
end(e_end3)
end(e_end4)
defines(v_option, "research schedule directly selected", {"Yes", "No"})
defines(v_sched_sat, "schedule satisfactory", {"Yes", "No"})
defines(v_sched_sat2, "schedule still satisfactory", {"Yes", "No"})
defines(v_app1, "ticket order approved", {"No", "Yes"})
defines(v_app2, "ticket order approved", {"No", "Yes"})
defines(v_app3, "ticket order approved", {"Yes", "No"})
actor(a_default, "Default", [i1, b1, n_research_direct, n_provide_ind, n_research_after_ind, c_join1, n_validate_sched, b_sched_sat, n_research_again, b_sched_sat2, n_provide_ind2, c_write_prep, n_write_ticket, n_validate_tkt1, b_app1, e_end1, n_validate_tkt2, b_app2, e_end2, n_validate_tkt3, b_app3, e_end3, e_end4])
precedence(i1, b1)
precedence(b1, n_research_direct)
precedence(b1, n_provide_ind)
precedence(n_provide_ind, n_research_after_ind)
precedence(n_research_direct, c_join1)
precedence(n_research_after_ind, c_join1)
precedence(c_join1, n_validate_sched)
precedence(n_validate_sched, b_sched_sat)
precedence(b_sched_sat, n_research_again)
precedence(b_sched_sat, c_write_prep)
precedence(n_research_again, b_sched_sat2)
precedence(b_sched_sat2, n_provide_ind2)
precedence(b_sched_sat2, c_write_prep)
precedence(n_provide_ind2, c_write_prep)
precedence(c_write_prep, n_write_ticket)
precedence(n_write_ticket, n_validate_tkt1)
precedence(n_validate_tkt1, b_app1)
precedence(b_app1, e_end1)
precedence(b_app1, n_validate_tkt2)
precedence(n_validate_tkt2, b_app2)
precedence(b_app2, e_end2)
precedence(b_app2, n_validate_tkt3)
precedence(n_validate_tkt3, b_app3)
precedence(b_app3, e_end3)
precedence(b_app3, e_end4)
guard(b1, n_research_direct, v_option = 'Yes')
guard(b1, n_provide_ind, v_option = 'No')
guard(b_sched_sat, c_write_prep, v_sched_sat = 'Yes')
guard(b_sched_sat, n_research_again, v_sched_sat = 'No')
guard(b_sched_sat2, c_write_prep, v_sched_sat2 = 'Yes')
guard(b_sched_sat2, n_provide_ind2, v_sched_sat2 = 'No')
guard(b_app1, e_end1, v_app1 = 'No')
guard(b_app1, n_validate_tkt2, v_app1 = 'Yes')
guard(b_app2, e_end2, v_app2 = 'No')
guard(b_app2, n_validate_tkt3, v_app2 = 'Yes')
guard(b_app3, e_end3, v_app3 = 'Yes')
guard(b_app3, e_end4, v_app3 = 'No')