{
  "matches": [
    {
      "refs": [
        "guard:b1->n_research_direct",
        "action:n_research_direct"
      ],
      "verbatim_texts": [
        "Initially, if the option \"research schedule directly\" is selected, then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Covers the process start, the initial conditional split, and the positive branch leading to the direct research action."
    },
    {
      "refs": [
        "guard:b1->n_provide_ind",
        "action:n_provide_ind",
        "action:n_research_after_ind"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Maps the negative branch, its sequential actions, and the point where this path rejoins the main flow."
    },
    {
      "refs": [
        "action:n_validate_sched"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Describes the validation step followed immediately by a decision on satisfaction."
    },
    {
      "refs": [
        "guard:b_sched_sat->n_research_again",
        "action:n_research_again"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Captures the first negative outcome condition and the corresponding research action."
    },
    {
      "refs": [
        "branch:b_sched_sat2"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\"."
      ],
      "justification": "The repeated negative condition signals the next decision point in the loop."
    },
    {
      "refs": [
        "guard:b_sched_sat2->n_provide_ind2",
        "action:n_provide_ind2"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Matches the second consecutive negative outcome and its action."
    },
    {
      "refs": [
        "guard:b_sched_sat->c_write_prep"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Maps the first positive schedule outcome to the convergence point."
    },
    {
      "refs": [
        "guard:b_sched_sat2->c_write_prep",
        "action:n_write_ticket"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Maps the second positive outcome, the merge of paths, and the ticket writing step."
    },
    {
      "refs": [
        "action:n_validate_tkt1"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it.",
        "Check if the ticket order is approved."
      ],
      "justification": "Covers the first validation and the subsequent approval check."
    },
    {
      "refs": [
        "guard:b_app1->e_end1"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Maps the first rejection outcome to a termination node."
    },
    {
      "refs": [
        "guard:b_app1->n_validate_tkt2"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Positive approval triggers a second validation and approval check cycle."
    },
    {
      "refs": [
        "action:n_validate_tkt2"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Positive approval triggers a second validation and approval check cycle."
    },
    {
      "refs": [
        "guard:b_app2->e_end2"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Maps the second rejection outcome to a termination node."
    },
    {
      "refs": [
        "guard:b_app2->n_validate_tkt3"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Second positive approval triggers a third validation and final approval check."
    },
    {
      "refs": [
        "action:n_validate_tkt3"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Second positive approval triggers a third validation and final approval check."
    },
    {
      "refs": [
        "guard:b_app3->e_end3"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Maps the final positive approval outcome to a termination node."
    },
    {
      "refs": [
        "guard:b_app3->e_end4"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Maps the final negative approval outcome to a termination node."
    }
  ],
