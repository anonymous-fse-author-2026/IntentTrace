    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order."
      ],
      "justification": "Matches the first occurrence of the rejection condition, its guard, and the rework action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "But if the purchase order is accepted, continue the process."
      ],
      "justification": "Matches the acceptance guard leading to the continuation flow."
    },
    {
      "refs": [
        "guard:b3->n7"
      ],
      "verbatim_texts": [
