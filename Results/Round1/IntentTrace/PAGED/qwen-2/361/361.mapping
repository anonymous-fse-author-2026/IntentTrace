        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the inventory level is below the minimum, create a purchase order."
      ],
      "justification": "Captures the below-minimum guard, the purchase order creation action, and the structural converge point where conditional paths prepare to proceed."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the purchase order is created, review it."
      ],
