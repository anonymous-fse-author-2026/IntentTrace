{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "Covers initialization and the first three sequential actions described in the opening sentence."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
      ],
      "justification": "Captures the XOR decision, the condition check modeled as an action, the guard threshold, and the resulting report generation."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Maps the alternative branch guard and action to the positive condition in the text; 'Above' faithfully paraphrases 'greater than'."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "Direct match for the instruction to create POs when inventory is low."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Explicit termination path mapped to the action and end node."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Captures the rejection decision branch, guard value, and rework action."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Matches the approval guard and subsequent print/release action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Direct match for the review step."
    },
    {
      "refs": [
        "converge:c_loop"
      ],
      "verbatim_texts": [
        "If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Structural converge node supporting the loop back to PO creation."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "AND branch triggered by concurrency keyword, splitting into the two parallel actions."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Direct match for the post-reservation step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Direct match for the post-mailing step."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice. If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Structural converge capturing the rejoining of the parallel paths before continuing."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Direct match for the invoice receipt step following convergence."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Direct match for the matching step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Direct match for fund release after successful match."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Direct match for payment issuance."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Final termination node mapped to the concluding sentence."
    }
  ],
