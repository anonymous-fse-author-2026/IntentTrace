        "action:n8",
        "guard:b3->n9",
        "action:n9",
        "guard:b3->e3"
      ],
      "verbatim_texts": [
        "if there is a Manual Task, the process will end."
      ],
      "justification": "Covers the post-merge check for a Manual Task, the XOR decision, the explicit positive guard leading to termination, the termination action itself, and the implicit negative guard that completes the exclusive gateway."
    }
