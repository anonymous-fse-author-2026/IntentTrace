init(i1)
action(n1, "start the process for ACME")
action(n2, "begin New Resupply Cycle")
action(n3, "Check Levels of Inventory")
branch(b1, XOR)
action(n4, "generate Equal to or below minimum Report")
action(n5, "generate Above Minimum Report")
end(e1)
action(n6, "create Purchase Orders (POs)")
action(n7, "Review Purchase Order")
branch(b2, XOR)
action(n8, "Rework Purchase Order")
action(n9, "Create Purchase Order again")
action(n10, "Print and release PO in system")
branch(b3, AND)
action(n11, "Reserve funds for released POs")
action(n12, "Mail POs to supplier")
action(n12a, "Receive Inventory")
converge(c_loop)
converge(c1)
action(n13, "Receive Packing Slip")
action(n14, "Receive Invoice")
action(n15, "Perform Three-way match")
action(n16, "Release funds")
action(n17, "Issue payment")
end(e2)
defines(v_inv_level, "Inventory Level Status", {"BelowOrEqual", "Above"})
defines(v_po_status, "PO Review Status", {"Rejected", "Approved"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, e1, n6, n7, b2, n8, n9, n10, b3, n11, n12, n12a, c_loop, c1, n13, n14, n15, n16, n17, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, e1)
precedence(n4, c_loop)
precedence(n9, c_loop)
precedence(c_loop, n6)
precedence(n6, n7)
precedence(n7, b2)
precedence(b2, n8)
precedence(b2, n10)
precedence(n8, n9)
precedence(n10, b3)
precedence(b3, n11)
precedence(b3, n12)
precedence(n11, c1)
precedence(n12, n12a)
precedence(n12a, c1)
precedence(c1, n13)
precedence(n13, n14)
precedence(n14, n15)
precedence(n15, n16)
precedence(n16, n17)
precedence(n17, e2)
guard(b1, n4, v_inv_level = 'BelowOrEqual')
guard(b1, n5, v_inv_level = 'Above')
guard(b2, n8, v_po_status = 'Rejected')
guard(b2, n10, v_po_status = 'Approved')