        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "The opening sentence implicitly starts the process and describes the first three sequential steps."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum",
        "If the inventory is greater than the minimum"
      ],
      "justification": "The two conditional clauses imply the XOR decision point."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
      ],
      "justification": "Single span provides both the guard condition and the corresponding action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Single span provides both the guard condition and the corresponding action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)"
      ],
      "justification": "Direct match to the step triggered when inventory is at or below minimum."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Maps to the early termination clause for when inventory is above the minimum."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Single span provides the rejection condition and subsequent rework action."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Single span provides the approval condition and print/release action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "it needs to be reviewed"
      ],
      "justification": "Direct match to the review step for created POs."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "it needs to be created again"
      ],
      "justification": "Direct match to the re-creation step following a rework."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Standalone timing word explicitly triggers the AND gateway for concurrency."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "reserve funds for the released POs"
      ],
      "justification": "First concurrent action branching from the AND gateway."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "mail the POs to the supplier"
      ],
      "justification": "Second concurrent action branching from the AND gateway."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "receive the Packing Slip"
      ],
      "justification": "Direct match to the step following fund reservation."
    },
