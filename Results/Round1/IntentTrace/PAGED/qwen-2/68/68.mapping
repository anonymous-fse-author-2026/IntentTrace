{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "The opening phrase explicitly starts the process and describes the initial action."
    },
    {
      "refs": [
        "guard:b1->n_cust",
        "action:n_cust",
        "guard:b1->n_crew",
        "action:n_crew"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process. However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "The conditional structure creates an XOR branch with two labeled outcomes, each supported by the exact quoted cases in the text."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct paraphrase of the counting and comparison action."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5",
        "guard:b2->n6",
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "The three-way conditional creates an XOR branch; guards capture the specific statuses and the email action for damaged items matches the text."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Exact semantic match for the action regarding missing items and charges."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Direct paraphrase of temporarily removing damaged items from inventory."
    },
    {
      "refs": [
        "guard:b4->n_ret",
        "action:n_ret",
        "guard:b4->n_noRet",
        "action:n_noRet"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process. However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Exclusive choice on customer return status with exact guard and action matches."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Explicit statement of the first process termination point."
    },
    {
      "refs": [
        "guard:b5->n12",
        "action:n12",
        "guard:b5->n13",
        "action:n13",
        "action:n22_email"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Branches on repair outcome; guards and actions faithfully restate the conditions and the subsequent email step."
    },
    {
      "refs": [
        "action:n23_pack"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order."
      ],
      "justification": "Direct match for the packing action statement."
    },
    {
      "refs": [
        "guard:b6->n_pack",
        "action:n_pack",
        "guard:b6->n_store",
        "action:n_store"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\" we continue the process. If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Conditional split on item disposition with matching guards and downstream actions."
    }
  ],
