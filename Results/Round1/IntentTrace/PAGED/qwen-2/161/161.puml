@startuml
!theme plain
|a_default| Default
|a_default|
start
:join the team and agree on domain;
:create process model and check it;
:v1: process_model_status ({NOT OK, OK}); <<objectSignal>>
if () then ([v1 = 'NOT OK'])
:assign negative points;
:is process model STILL NOT OK?;
:v2: process_model_status_again ({NOT OK, OK}); <<objectSignal>>
if () then ([v2 = 'NOT OK'])
:assign negative points again;
stop
else ([v2 = 'OK'])
->;
endif
else ([v1 = 'OK'])
->;
endif
:if process is okay continue with it;
split
:fix issues in next session and extend to levels 2 and 3;
split again
:check process and assign points or analyze field of study;
:v3: next_step_decision ({check_points, analyze_study}); <<objectSignal>>
if () then ([v3 = 'analyze_study'])
:analyze the field of study;
:assign roles in team;
else ([v3 = 'check_points'])
->;
endif
end split
:continue with process and perform work according role;
:check progress and consult problems;
:is project accepted?;
:v4: project_acceptance_1 ({accepted, not_accepted}); <<objectSignal>>
if () then ([v4 = 'accepted'])
:present it;
stop
else ([v4 = 'not_accepted'])
:continue working according role;
:present project again;
:is project accepted?;
:v5: project_acceptance_2 ({accepted, not_accepted}); <<objectSignal>>
if () then ([v5 = 'accepted'])
:present project and end process;
stop
else ([v5 = 'not_accepted'])
:continue working according role;
endif
endif
@enduml