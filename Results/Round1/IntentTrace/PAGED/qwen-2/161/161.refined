action(n13, "continue with process and perform work according role")
action(n14, "check progress and consult problems")
action(n15, "is project accepted?")
branch(b4, XOR)
action(n16, "present it")
end(e1)
action(n18, "continue working according role")
action(n19, "present project again")
action(n20, "is project accepted?")
branch(b5, XOR)
action(n21, "present project and end process")
end(e2)
action(n22, "continue working according role")
defines(v1, "process_model_status", {"NOT OK", "OK"})
defines(v2, "process_model_status_again", {"NOT OK", "OK"})
defines(v3, "next_step_decision", {"check_points", "analyze_study"})
defines(v4, "project_acceptance_1", {"accepted", "not_accepted"})
defines(v5, "project_acceptance_2", {"accepted", "not_accepted"})
