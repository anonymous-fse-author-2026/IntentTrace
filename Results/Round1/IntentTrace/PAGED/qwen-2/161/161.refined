end(e_neg1)
end(e_neg2)
converge(c1)
action(n9, "if process is okay continue with it")
branch(b6, AND)
action(n10, "fix issues in next session and extend to levels 2 and 3")
action(n11, "check process and assign points or analyze field of study")
branch(b3, XOR)
action(n_analyze, "analyze the field of study")
action(n12, "assign roles in team")
