@startuml
!theme plain
|a_default| Default
|a_default|
start
:v_order: sum of the order ({lt500, 500-999, 1000-1500, gt2000}); <<objectSignal>>
switch ()
case ([v_order = 'lt500'])
:continue with the process;
case ([v_order = 'gt2000'])
:compute discount of 4 percent;
case ([v_order = '1000-1500'])
:compute discount of 3 percent;
case ([v_order = '500-999'])
:compute discount of 2 percent;
endswitch
:create the bill;
stop
@enduml