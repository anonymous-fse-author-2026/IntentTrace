      "justification": "Captures the failure condition that directs the flow to the next decision stage."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If you want to try again, please provide the userdata for flickr."
      ],
      "justification": "Maps the retry choice action (n5), the subsequent exclusive branch (b2), the retry guard (b2->c1), and the convergence point (c1) that reunites the flow to re-request credentials."
