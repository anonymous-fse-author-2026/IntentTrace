{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, create a Temporary ID."
      ],
      "justification": "The opening clause implicitly triggers the start (init), paraphrases the initiation (action n1), and specifies the first concrete step (action n2)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, proceed to access the eLiving System."
      ],
      "justification": "Directly corresponds to the system access step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once in the eLiving System, verify the student's identity."
      ],
      "justification": "Accurately captures the identity verification action within the specified system."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the student's identity is confirmed, check if their account is frozen."
      ],
      "justification": "The conditional premise leads directly into the account status check action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is frozen, unfreeze the student account."
      ],
      "justification": "The conditional introduces the decision split (branch), the guard abstracts the 'frozen' state, and the action performs the unfreezing."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not frozen, continue with the process."
      ],
      "justification": "The guard covers the alternative condition, the action resumes the workflow, and the converge node represents the two paths rejoining before the next step."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Next, navigate to the Harco System and select \"Cardholder Transactions\"."
      ],
      "justification": "The compound instruction is correctly decomposed into sequential navigation and selection actions."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "From there, choose the option for \"Forgotten Card\"."
      ],
      "justification": "Direct paraphrase of selecting the specific menu option."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "In the \"Forgotten Card\" section, enter the reason code and temporary card number."
      ],
      "justification": "Exactly matches the data entry requirement."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After providing the reason code and temporary card number, move on to the point of sale system."
      ],
      "justification": "Faithfully captures the transition to the next system."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "In the point of sale system, scan the temporary card to complete the process."
      ],
      "justification": "The final action concludes the workflow, implicitly triggering the end node."
    }
  ],
