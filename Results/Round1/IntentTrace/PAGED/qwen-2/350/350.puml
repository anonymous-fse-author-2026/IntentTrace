@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the flickr login process;
:provide userdata for flickr;
:is the login successful;
:v1: login_status ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:end process successful login;
stop
else ([v1 = 'No'])
:do you want to try again;
:v2: first_retry_choice ({Try Again, Abort}); <<objectSignal>>
if () then ([v2 = 'Try Again'])
:provide userdata for flickr again after first failure;
:do you want to try again after second failure;
:v3: second_retry_choice ({Try Again, Abort}); <<objectSignal>>
if () then ([v3 = 'Try Again'])
:provide userdata for flickr again after second failure;
stop
else ([v3 = 'Abort'])
:abort process after second failure;
stop
endif
else ([v2 = 'Abort'])
:abort process after first failure;
stop
endif
endif
@enduml