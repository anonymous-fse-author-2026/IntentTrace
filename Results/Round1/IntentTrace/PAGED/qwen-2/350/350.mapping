{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please provide the userdata for flickr."
      ],
      "justification": "Covers the process initiation, the starting context, and the initial action to provide userdata."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the login is successful, the process will end."
      ],
      "justification": "Captures the success condition decision point, the positive guard, the termination action, and the associated end node."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the login fails, we will continue with the process."
      ],
      "justification": "Matches the negative outcome path that leads to process continuation."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If you want to try again, please provide the userdata for flickr."
      ],
      "justification": "Models the first retry prompt, the corresponding decision branch, the retry guard, and the action to re-provide userdata."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if you choose to abort, the process will end."
      ],
      "justification": "Covers the abort choice on the first failure path, the corresponding action, and process termination."
    },
    {
      "refs": [
        "action:n10",
        "guard:b4->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If you still want to try again, please provide the userdata for flickr."
      ],
      "justification": "Models the second retry prompt, the decision branch, the retry guard, and the re-provision action."
    },
    {
      "refs": [
        "guard:b4->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Alternatively, if you decide to abort, the process will end."
      ],
      "justification": "Covers the abort choice on the second failure path, the corresponding action, and process termination."
    }
  ],
