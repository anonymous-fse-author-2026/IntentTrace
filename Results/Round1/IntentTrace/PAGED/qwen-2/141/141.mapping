      ],
      "justification": "Describes the sequential waiting and consumption steps following the convergence."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After finishing, you will be asked if you would like a dessert."
      ],
      "justification": "Maps to the inquiry action regarding dessert preferences."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If you answer \"yes\" to tiramisu, then go ahead and order it."
      ],
      "justification": "Establishes the XOR decision point, defines the positive guard condition, and specifies the corresponding order action."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If you answer \"no\" to tiramisu, then simply decline any dessert."
      ],
      "justification": "Defines the negative guard condition and the corresponding decline action on the alternative branch."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If you did order tiramisu, wait for it to be served, then enjoy it."
      ],
      "justification": "Describes the conditional follow-up step exclusive to the positive dessert path."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "Once you are ready,"
      ],
      "justification": "Signals that both dessert outcome branches have completed and flow reconverges before payment."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "ask for the bill and proceed to pay it."
      ],
      "justification": "Directly maps to the request and payment action following the converge."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After settling the bill, you can leave the restaurant and the process will be complete."
      ],
      "justification": "Describes departing (modeled as 'End' action) and explicitly states process completion, fully justifying the terminal end node."
