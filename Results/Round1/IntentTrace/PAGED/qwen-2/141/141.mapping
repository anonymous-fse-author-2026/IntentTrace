      "verbatim_texts": [
        "To start the process at the Italian restaurant, first enter and ask for the menu."
      ],
      "justification": "The opening clause implicitly signals the process start (init) and directly describes the initial actions of starting, entering, and requesting the menu."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After checking the offers,"
      ],
