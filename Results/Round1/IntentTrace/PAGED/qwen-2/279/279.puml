@startuml
!theme plain
|a_default| Default
|a_default|
start
:Knows SLA;
:v1: Knows SLA ({Yes, No}); <<objectSignal>>
if () then ([v1 = "Yes"])
:Continue the process after knowing SLA;
else ([v1 = "No"])
:Look up SLA;
endif
:Enter the date;
:Task is Urgent;
:v2: Task is Urgent ({Urgent, Non Urgent}); <<objectSignal>>
if () then ([v2 = "Urgent"])
:Red Stamp task;
else ([v2 = "Non Urgent"])
:Continue process with Non Urgent task;
endif
:End process;
stop
@enduml