      "verbatim_texts": [
        "To begin the process, start with Low Inventory."
      ],
      "justification": "The opening clause implicitly triggers the process start (init) and explicitly defines the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed to Create P.R."
      ],
      "justification": "Direct match to the first PR creation step."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "move on to Create P.R., followed by Submit P.O."
      ],
      "justification": "Sequentially maps the repeated PR action and the subsequent PO submission."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "proceed to Ship Material"
      ],
      "justification": "Direct match to the shipping action."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "check if the shipment is okay"
      ],
      "justification": "Defines the first exclusive decision point."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed to Send Payment."
      ],
      "justification": "The guard translates the positive condition to a boolean 'Yes', and the action matches the payment step."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "if there are any problems with the shipment, communicate them accordingly."
      ],
      "justification": "The guard translates the negative/problem condition to 'No', and the action matches the communication step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "After checking the shipment status again"
      ],
      "justification": "Explicitly signals the second decision/verification point."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "if it is okay, proceed to Send Payment."
      ],
      "justification": "Matches the positive condition and corresponding payment action on the retry path."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Otherwise, communicate any shipment problems."
      ],
      "justification": "Matches the fallback condition and communication action."
    },
    {
      "refs": [
        "action:n14",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "once the payment is sent, the process comes to an end."
      ],
      "justification": "All end-related structural and action nodes correspond to this single closing statement. Redundant termination points are permitted as they do not alter process behavior."
    },
    {
      "refs": [
        "action:n10",
        "action:n13"
      ],
      "verbatim_texts": [
        "In case there were any shipment problems, make sure to communicate them before proceeding to Ship Material."
      ],
      "justification": "Reinforces the communication actions already modeled. Covers the remaining instructional text without introducing new steps."
    }
