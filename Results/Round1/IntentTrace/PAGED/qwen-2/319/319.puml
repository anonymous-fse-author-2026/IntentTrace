@startuml
!theme plain
|a_default| Default
|a_default|
start
:choose a book;
split
:view: book details;
:v1: do you want to select a copy or view new copies? ({select, view_new}); <<objectSignal>>
if () then ([v1 = 'select'])
:select a copy;
:end procedure;
stop
else ([v1 = 'view_new'])
:view: new copies;
endif
split again
:view: used copies;
end split
:evaluate and select a copy from the list;
:end procedure;
stop
