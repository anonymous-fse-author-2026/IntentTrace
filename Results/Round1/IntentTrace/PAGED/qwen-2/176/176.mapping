        "init:n2"
      ],
      "verbatim_texts": [
        "The loan application process starts with receiving the loan application."
      ],
      "justification": "Explicitly defines the process initiation and initial reception context."
    },
    {
      "refs": [
        "action:n3",
        "label:b2->n3",
        "action:n4",
        "label:b2->n4"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps should be completed: assessing the loan risk and checking the credit history."
      ],
      "justification": "'Simultaneously' triggers the AND gateway; the enumerated tasks map directly to the parallel actions and their connecting labels."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, the eligibility of the applicant is assessed."
      ],
      "justification": "'After that' signals the rejoining of parallel paths (converge), immediately followed by the eligibility assessment action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the applicant is eligible, the acceptance pack is prepared."
      ],
      "justification": "The conditional introduces the XOR split; the positive guard ('Yes') and preparation step faithfully restate the eligible outcome."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the applicant is not eligible, the application is rejected."
      ],
      "justification": "Negative conditional maps directly to the 'No' guard and the rejection action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the application is rejected, the loan application process ends."
      ],
      "justification": "Explicitly links the rejection path to process termination."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The prepared acceptance pack is then sent."
      ],
      "justification": "Direct correspondence to the transmission step on the success path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the acceptance pack is sent, the process ends."
      ],
      "justification": "Temporal clause and termination statement map to the final success-path action and end node."
    }
  ],
