  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process, make sure the Freights are ready to be shipped and then ship the freight."
      ],
      "justification": "Covers process initiation and sequences the preparation and shipping actions exactly as described."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: deliver the freight and notify the delivery."
      ],
      "justification": "Timing phrase and conjunction justify the parallel split, two concurrent actions, and subsequent merge."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the request for merchandise return is lodged, continue with the process."
      ],
      "justification": "Models the conditional check, XOR split, and affirmative guard leading to continuation."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it has been 5 days, invoice the customer."
      ],
      "justification": "Captures the time condition query, decision node, affirmative guard, and resulting invoice action."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the return is accepted, proceed with accepting the merchandise return."
      ],
      "justification": "Negative guard from previous step routes flow to this condition; models the acceptance check, split, affirmative guard, and acceptance action."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the return is rejected, reject the merchandise return."
      ],
      "justification": "Negative guard and action correctly implement the rejection branch."
    },
    {
      "refs": [
        "guard:b1->n16",
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If a loss claim report is lodged, approve the loss claim and the process ends."
      ],
      "justification": "Alternative guard routes to loss claim condition; covers query, approval, end state description, and termination."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the process ends with the customer being invoiced."
      ],
      "justification": "Describes the terminal state for the invoicing branch and matches the end node."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Return the merchandise"
      ],
      "justification": "Direct match for the physical return step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the process ends with the merchandise being returned."
      ],
      "justification": "Describes the terminal state for the successful return path and matches the end node."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "the process ends with the merchandise return request being rejected."
      ],
      "justification": "Describes the terminal state for the rejected return path and matches the end node."
    }
  ],
