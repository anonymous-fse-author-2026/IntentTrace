{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially,"
      ],
      "justification": "Contextual header and temporal marker establish the process start."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
      "justification": "Conditional clause mapped to an action representation, the decision node, and the positive guard."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Direct statement of the positive path action."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the option is not selected"
      ],
      "justification": "Negative conditional mapped to the corresponding guard."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Two sequential actions described in the negative path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule,"
      ],
      "justification": "Validation step preceding the satisfaction check."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory."
      ],
      "justification": "Evaluation question mapped to an action step and the following decision node."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Negative guard and corresponding remedial action."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Positive guard and corresponding forward action."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11",
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\". If it is still not satisfactory, then \"provide indications\". Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Secondary satisfaction evaluation block covering the check node, both guards, and their respective outcome actions."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Explicit validation step for the newly created ticket order."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "First approval verification mapped to action and decision node."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Negative guard leading to process termination action and end node."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Positive guard leading to the first re-validation step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Second approval verification mapped to action and decision node."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Negative guard for second check leading to termination."
    },
    {
      "refs": [
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Positive guard for second check leading to second re-validation."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Third approval verification mapped to action and decision node."
    },
    {
      "refs": [
        "guard:b6->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Positive guard for final check leading to successful termination."
    },
    {
      "refs": [
        "guard:b6->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Negative guard for final check leading to unsuccessful termination."
    }
  ],
