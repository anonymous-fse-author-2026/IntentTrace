    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "Captures the first decision point and splits the flow, modeled here as an action step preceding the branch."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "then advertise the vacancy"
      ],
      "justification": "The guard represents the negative condition ('No'); the action faithfully restates the advertising step."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "The guard captures the positive condition leading to the merge point where both paths rejoin."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available"
      ],
      "justification": "Represents the second decision checkpoint after the initial advertising phase."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "then advertise the vacancy again"
      ],
      "justification": "The guard models the repeated negative outcome; the action matches the re-advertisement step."
    },
    {
      "refs": [
        "guard:b2->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "The guard captures the positive result of the second check; the action faithfully restates the applicant selection step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "Covers the final termination state and concluding step described in the last sentence."
    }
  ],
