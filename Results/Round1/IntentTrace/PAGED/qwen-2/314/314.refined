init(i1)
action(n1, "Start")
action(n2, "Any candidates available?")
branch(b1, XOR)
action(n4, "Advertise Vacancy")
converge(c1)
action(n5, "After advertising any candidates?")
branch(b2, XOR)
action(n6, "Advertise Again")
action(n3, "Select Applicant")
action(n8, "End")
end(e1)
defines(v1, "Any candidates available?", {Yes, No})
defines(v2, "After advertising any candidates?", {Yes, No})
actor(a_default, "Default", [i1, n1, n2, b1, n4, c1, n5, b2, n6, n3, n8, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, c1)
precedence(n4, c1)
precedence(c1, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n3)
precedence(n3, n8)
precedence(n8, e1)
precedence(n6, e1)
guard(b1, n4, v1 = 'No')
guard(b1, c1, v1 = 'Yes')
guard(b2, n6, v2 = 'No')
guard(b2, n3, v2 = 'Yes')