init(i1)
action(n1, "start flight booking process for Flight Centre")
converge(n2)
branch(b1, XOR)
action(n3, "Select return flight")
action(n4, "Complete flight selection")
action(n5, "End process")
end(e1)
converge(n6)
action(n7, "Is departing flight available")
branch(b2, XOR)
defines(v1, "Is departing flight available", {true, false})
defines(v2, "Is departing flight available", {true, false})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, e1, n6, n7, b2])
precedence(i1, n1)
precedence(n2, b1)
precedence(n5, e1)
precedence(n7, b2)
precedence(n1, n2)
precedence(b1, n3)
precedence(n3, n4)
precedence(n4, n5)
precedence(b1, n6)
precedence(b2, n6)
precedence(n6, n7)
precedence(b2, n2)
guard(b1, n3, v1 = true)
guard(b1, n6, v1 = false)
guard(b2, n6, v2 = false)
guard(b2, n2, v2 = true)
label(n1, n2, "availability of the departing flight")