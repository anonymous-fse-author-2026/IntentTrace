{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "Explicitly defines the process initiation and the first executed step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "checking the Inventory Level. If the \"Inventory level is at or below the minimum\""
      ],
      "justification": "Covers the inventory verification action and introduces the exclusive decision gateway."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "\"Inventory level is at or below the minimum\""
      ],
      "justification": "Abstract boolean representation of the affirmative condition arm."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "\"Inventory Level is above the minimum\""
      ],
      "justification": "Abstract boolean representation of the negative condition arm."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then proceed to Create Purchase Order."
      ],
      "justification": "Direct mapping of the positive outcome action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process ends."
      ],
      "justification": "Maps the termination instruction to both the action placeholder and structural end node."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Sequential step directly following purchase order creation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved"
      ],
      "justification": "Establishes the approval checkpoint and the second exclusive branch."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "approved"
      ],
      "justification": "Boolean abstraction for the approved route."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "rejected"
      ],
      "justification": "Boolean abstraction for the rejected route."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "then reserve the funds for the purchase."
      ],
      "justification": "Direct mapping of the approved path action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then rework the order."
      ],
      "justification": "Direct mapping of the rejected path action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Sequential step triggered by fund reservation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Captures the iterative review step for rejected orders."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "Explicit concurrency marker mapping to the AND gateway."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the Supplier sends a packing slip and an invoice."
      ],
      "justification": "Joint supplier action initiating the parallel sub-process."
    },
    {
      "refs": [
        "label:b3->n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received"
      ],
      "justification": "Temporal condition labeling the packing slip path."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "record it."
      ],
      "justification": "Action corresponding to processing the packing slip."
    },
    {
      "refs": [
        "label:b3->n13"
      ],
      "verbatim_texts": [
        "when the invoice is received"
      ],
      "justification": "Temporal condition labeling the invoice path."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "record it as well."
      ],
      "justification": "Action corresponding to processing the invoice."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice, release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "Implies the synchronization of the two recording paths and details the subsequent financial actions."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Explicit final termination statement mapping to the closing action and structural end node."
    }
  ],
