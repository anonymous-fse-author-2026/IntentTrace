init(i1)
action(n1, "start the process")
action(n2, "empty the mailbox")
action(n3, "check if mailbox is empty")
branch(b1, XOR)
action(n4, "end process")
end(e1)
action(n5, "verify information completeness")
branch(b2, XOR)
action(n6, "add incoming mail number  date  and record in letter book")
action(n7, "make telephone call to sender")
action(n8, "complete data by adding incoming mail number  date  and record in letter book")
action(n9, "take letter book and member register to Miranda every Wednesday evening")
action(n10, "check if applicant becomes a member")
branch(b3, XOR)
action(n11, "stamp 'new Member' on the letter and write date")
action(n12, "write data")
action(n13, "calculate fee")
action(n14, "hand letter to Charles and ask to write amount in register")
action(n15, "print membership card with all data and send to new member")
action(n16, "end process")
end(e2)
action(n17, "write to applicant and inform them of decision")
converge(c1)
converge(c2)
branch(b4, AND)
action(n20, "check if mailbox is empty again")
action(n21, "hand letter to Charles and add new member to register")
action(n22, "prepare an invoice for the new members")
action(n23, "ask Charles to write the amount in the register and write the fee amount to the register")
action(n24, "after stamping new member on letter and writing date write the data")
end(e4)
defines(v1, "check if mailbox is empty", {"Yes", "No"})
defines(v2, "verify information completeness", {"Complete", "Not Complete"})
defines(v3, "check if applicant becomes a member", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, e1, n5, b2, n6, n7, n8, n9, n10, b3, n11, n12, n13, n14, n15, n16, e2, n17, e4, c1, c2, b4, n20, n21, n22, n23, n24])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n20)
precedence(n20, n5)
precedence(n4, e1)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n7)
precedence(n7, n8)
precedence(n6, c1)
precedence(n8, c1)
precedence(c1, n9)
precedence(n9, n10)
precedence(n10, b3)
precedence(b3, n11)
precedence(b3, n17)
precedence(n11, n24)
precedence(n24, b4)
precedence(b4, n12)
precedence(b4, n13)
precedence(b4, n14)
precedence(n12, c2)
precedence(n13, c2)
precedence(n14, c2)
precedence(c2, n15)
precedence(n15, n16)
precedence(n16, n21)
precedence(n21, n22)
precedence(n22, n23)
precedence(n23, e2)
precedence(n17, e4)
guard(b1, n4, v1 = 'Yes')
guard(b1, n20, v1 = 'No')
guard(b2, n6, v2 = 'Complete')
guard(b2, n7, v2 = 'Not Complete')
guard(b3, n11, v3 = 'Yes')
guard(b3, n17, v3 = 'No')