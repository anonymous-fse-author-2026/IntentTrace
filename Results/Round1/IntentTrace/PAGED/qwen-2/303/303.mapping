{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process, begin by supplying the requirement and then documenting it."
      ],
      "justification": "Opening clause implicitly starts the process and sequentially describes the first three actions."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the order is received via fax, input the order into an Excel file."
      ],
      "justification": "Conditional opens the XOR branch, guard captures the fax condition, and action nodes restate the condition check and the subsequent input step."
    },
    {
      "refs": [
        "guard:b1->n5m",
        "action:n5m"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone, also input the order into an Excel file."
      ],
      "justification": "Guard and action capture the alternative branch condition and the corresponding input step."
    },
    {
      "refs": [
        "action:n_i7",
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete after a week, send it to the student."
      ],
      "justification": "Completion of parallel input paths implies convergence, followed by the weekly completion wait step and the sending action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list, type the orders into the MS-Access database."
      ],
      "justification": "Direct mapping to the database typing action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed."
      ],
      "justification": "Direct mapping to the database completion verification action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the database is completed, control the incoming order."
      ],
      "justification": "Direct mapping to the order control action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "At the same time, continue to do the check."
      ],
      "justification": "Concurrency keyword and check action align with the model's parallel continuation."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the order is correct, release it."
      ],
      "justification": "Conditional logic splits into XOR branch, guard captures correctness, and action nodes restate the condition and release step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Send the Excel list to the student and upon receiving it, continue with the process."
      ],
      "justification": "Action node directly restates the secondary sending step described here."
    },
    {
      "refs": [
        "guard:b2->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Guard captures the negative condition, action captures contacting the agency."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac, release it."
      ],
      "justification": "Conditional logic, threshold guard (< 5000), and corresponding action nodes match exactly."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17",
        "action:n18",
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "Guard captures the higher threshold, and action nodes correctly split and later merge the parallel sign-off and check tasks."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
      ],
      "justification": "Compound action accurately combines contacting the agency and sending for sign-off upon receipt."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Once the order is signed off, contact the client and release the order."
      ],
      "justification": "Directly maps to contacting the client and releasing the order post-sign-off."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "Directly maps to PPC initiating production."
    },
    {
      "refs": [
        "guard:b4->n25",
        "action:n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order."
      ],
      "justification": "Negative condition triggers XOR branch, guard captures unsolvable state, and actions restate the query and cancellation."
    },
    {
      "refs": [
        "guard:b4->n27",
        "action:n27"
      ],
      "verbatim_texts": [
        "If the issue can be solved, release the order."
      ],
      "justification": "Positive condition guard and release action match perfectly."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "After PPC initiates production, the goods will be produced."
      ],
      "justification": "Directly maps to the goods production step."
    },
    {
      "refs": [
        "guard:b5->n30",
        "action:n29",
        "action:n30"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends."
      ],
      "justification": "Cancellation condition triggers branch, guard captures affirmative path, and actions/end node match process termination."
    },
    {
      "refs": [
        "guard:b5->n31",
        "action:n31"
      ],
      "verbatim_texts": [
        "If not, check the quality of the goods."
      ],
      "justification": "Negative guard and quality check action align with the alternative path."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "justification": "Direct mapping to report creation and sending to finance."
    },
    {
      "refs": [
        "action:n33",
        "action:n34"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "justification": "Two actions faithfully split the memo release and warehouse confirmation steps."
    },
    {
      "refs": [
        "action:n35",
        "action:n36"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "justification": "Actions match invoice sending and subsequent finance reporting."
    },
    {
      "refs": [
        "action:n37",
        "action:n38"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods and sign and send the memo."
      ],
      "justification": "Concurrency keyword matches parallel structure, and actions match commissioning and memo signing/sending."
    },
    {
      "refs": [
        "action:n39",
        "action:n40"
      ],
      "verbatim_texts": [
        "Also, send the goods and ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "Actions match goods dispatch and logistics memo confirmation."
    },
    {
      "refs": [
        "action:n41"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order."
      ],
      "justification": "Direct mapping to the final archiving and closing step."
    },
    {
      "refs": [
        "action:n42"
      ],
      "verbatim_texts": [
        "This marks the end of the process."
      ],
      "justification": "Explicit closing statement matches the final action and end node."
    }
  ],
