  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "At the start, we receive a form."
      ],
      "justification": "The opening clause implicitly initiates the process, redundantly echoes the start signal, and describes the initial receipt step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After receiving the form, we check if it is complete."
      ],
      "justification": "Describes the completion validation step and implicitly establishes the first decision gate."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If it needs to be sent back, the process ends."
      ],
      "justification": "Maps the negative branch condition, the send-back action, and the termination of this specific path."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if we need to check the income, we continue with the process."
      ],
      "justification": "Models the positive continuation guard and the income verification step."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "At the same time, we complete the following steps: checking deductibles and checking the house."
      ],
      "justification": "Directly captures the concurrency instruction and both parallel verification tasks."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Then, we make a decision."
      ],
      "justification": "Explicitly signals the second branching point in the workflow."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If we need to check the declaration, the process ends."
      ],
      "justification": "Corresponds to the declaration check condition that leads immediately to process termination."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Otherwise, if we need to invite the declarant, the process also ends."
      ],
      "justification": "Aligns with the fallback condition, the invitation step, and the subsequent final termination."
    }
  ],
