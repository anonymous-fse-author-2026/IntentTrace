      ],
      "verbatim_texts": [
        "At the beginning,"
      ],
      "justification": "Signals the implicit start of the process and justifies the initial action node."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "if someone \"Knows SLA\","
      ],
      "justification": "Introduces the first decision gateway and captures the conditional query."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "\"Knows SLA\", they should \"continue the process\"."
      ],
      "justification": "Positive branch outcome. Guard uses 'Yes' as a faithful paraphrase for the affirmative case, matching the action text."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If they don't \"Know SLA\", they should \"Look up\"."
      ],
      "justification": "Negative branch outcome. Guard uses 'No' as a faithful paraphrase for the negative case, matching the look-up action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, they should enter the date."
      ],
      "justification": "Temporal phrase implies paths rejoin (converge) before proceeding to the date entry step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the task is \"Urgent\", they should \"Red Stamp\"."
      ],
      "justification": "Covers the second decision gateway, its query action, the urgent condition guard, and the resulting red stamp action."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is \"Non Urgent\", they should \"continue the process\"."
      ],
      "justification": "Covers the non-urgent condition guard and its corresponding continuation action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Indicates flow convergence prior to termination, the explicit end step, and the structural end node."
    }
