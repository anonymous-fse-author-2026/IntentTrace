init(i1)
action(n1, "start the process")
action(n2, "send: Course Packet Information Received")
action(n3, "send: Design to Faculty")
action(n14, "Faculty will choose the design")
action(n4, "identify content requiring copyright clearance and contact publisher")
branch(b1, XOR)
action(n6, "notify: Contact Faculty to inform of denial and ask if new content should be added")
action(n7, "calculate: Course Packet Cost")
action(n8, "add: Bookstore margin to determine retail price")
branch(b2, XOR)
action(n10, "notify: Notify Bookstore of Course packet  Course number  Faculty name  and sections")
action(n11, "end: Packet information notified to Bookstore")
end(e1)
action(n12, "reconsider content to decrease price")
converge(c1)
defines(v1, "copyright_clearance", {"Contact Faculty to inform of denial and ask if new content should be added", "Entire Course Packet Copyright Cleared"})
defines(v2, "price_finalization", {"Faculty needs to reconsider the course packet content to decrease the price", "Price of the Course Packet is finalized"})
actor(a_default, "Default", [i1, n1, n2, n3, n14, n4, b1, n6, n7, n8, b2, n10, n11, e1, n12, c1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, c1)
precedence(c1, n14)
precedence(n14, n4)
precedence(n4, b1)
precedence(b1, n6)
precedence(b1, n7)
precedence(n7, n8)
precedence(n8, b2)
precedence(b2, n10)
precedence(b2, n12)
precedence(n10, n11)
precedence(n11, e1)
precedence(n6, c1)
precedence(n12, c1)
guard(b1, n6, v1 = "Contact Faculty to inform of denial and ask if new content should be added")
guard(b1, n7, v1 = "Entire Course Packet Copyright Cleared")
guard(b2, n10, v2 = "Price of the Course Packet is finalized")
guard(b2, n12, v2 = "Faculty needs to reconsider the course packet content to decrease the price")