@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process;
:send: Course Packet Information Received;
:send: Design to Faculty;
repeat :;
:Faculty will choose the design;
:identify content requiring copyright clearance and contact publisher;
:v1: copyright_clearance ({Contact Faculty to inform of denial and ask if new content should be added, Entire Course Packet Copyright Cleared}); <<objectSignal>>
backward:notify: Contact Faculty to inform of denial and ask if new content should be added;
repeat while () is ([v1 = "Contact Faculty to inform of denial and ask if new content should be added"]) not ([v1 = "Entire Course Packet Copyright Cleared"])
:calculate: Course Packet Cost;
:add: Bookstore margin to determine retail price;
:v2: price_finalization ({Faculty needs to reconsider the course packet content to decrease the price, Price of the Course Packet is finalized}); <<objectSignal>>
if () then ([v2 = "Price of the Course Packet is finalized"])
:notify: Notify Bookstore of Course packet  Course number  Faculty name  and sections;
:end: Packet information notified to Bookstore;
stop
else ([v2 = "Faculty needs to reconsider the course packet content to decrease the price"])
:reconsider content to decrease price;
endif
@enduml