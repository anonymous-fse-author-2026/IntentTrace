defines(v1, "make a decision on the claim", {"Rejected", "Accepted"})
defines(v2, "rejection outcome", {"accepted", "not accepted"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, n6, n7, n8, n9, n10, n11, n12, n13, e1, c1, b2, b3, b_rev, n8_off])
