@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:advise unsuccessful candidates;
:check candidate availability;
:v1: are there more candidates? ({Yes, No}); <<objectSignal>>
if () then (["v1 = 'No'"])
:re-advertise position;
else (["v1 = 'Yes'"])
:check terms and conditions;
:check voluntary redundancy acceptance;
:v11: candidate accepted voluntary redundancy? ({Yes, No}); <<objectSignal>>
if () then (["v11 = 'Yes'"])
:conduct further investigation;
else (["v11 = 'No'"])
:voluntary redundancy not accepted - continue;
endif
:send appointment approval form;
:check if approver is external resource;
:v3: is approver external resource? ({Yes, No}); <<objectSignal>>
if () then (["v3 = 'Yes'"])
:handle external resource authorization;
else (["v3 = 'No'"])
:approver is existing employee - continue;
endif
:form approved - send to client HR;
:scan and record form in GovSource;
:check for variations;
:v5: are there any variations? ({Yes, No}); <<objectSignal>>
if () then (["v5 = 'Yes'"])
:create business case;
else (["v5 = 'No'"])
:no variations - continue;
endif
:check medical assessment requirement (12% rate);
:v6: is medical assessment required? ({Yes, No}); <<objectSignal>>
if () then (["v6 = 'Yes'"])
:arrange and complete medical assessment;
:inform recruitment manager and liaise with HR representative;
:check assessment satisfaction;
:v7: is assessment satisfactory? ({Yes, No}); <<objectSignal>>
if () then (["v7 = 'No'"])
:contact next candidate on shortlist;
else (["v7 = 'Yes'"])
:make formal verbal offer;
:check candidate offer acceptance;
:v8: does candidate accept offer? ({Yes, No}); <<objectSignal>>
if () then (["v8 = 'Yes'"])
:create formal written offer;
else (["v8 = 'No'"])
:candidate declined - continue;
endif
:send commencement pack and letter;
:check for 40% rate;
:v9: is there a 40% rate? ({Yes, No}); <<objectSignal>>
if () then (["v9 = 'Yes'"])
:renegotiate terms;
:check renegotiation success;
:v10: are renegotiations successful? ({Yes, No}); <<objectSignal>>
if () then (["v10 = 'No'"])
:identify next candidate on shortlist;
else (["v10 = 'Yes'"])
->;
endif
else (["v9 = 'No'"])
->;
endif
endif
:end of procedure;
stop
else (["v6 = 'No'"])
:medical assessment not required - continue;
endif
endif
@enduml