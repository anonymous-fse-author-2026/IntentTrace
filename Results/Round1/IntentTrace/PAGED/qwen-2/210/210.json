  "input_elements": [
    {
      "id": "i1",
      "content": "For the customer, the process begins with a request to purchase a motorcycle."
    },
    {
      "id": "i2",
      "content": "Once the request is received, the next step is to either continue the process if a production order is received or update the sales information and proceed to order dispatch."
    },
    {
      "id": "i3",
      "content": "If there are unavailable materials, they are ordered from the supplier."
    },
    {
      "id": "i4",
      "content": "Alternatively, if there are available goods for production, a manufacturing order is placed."
    },
    {
      "id": "i5",
      "content": "Once the materials are received from the supplier, the goods are issued and the motorcycles are produced."
    },
    {
      "id": "i6",
      "content": "At the same time, the stock is updated and the motorcycles are dispatched."
    },
    {
      "id": "i7",
      "content": "After the goods are issued and the motorcycles are produced, the stock is updated and the process ends."
    },
    {
      "id": "i8",
      "content": "Simultaneously, the stock is updated and the sales information is updated."
    }
  ]
