{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "The opening clause implicitly starts the process, describes the start action, and details the initial prioritization step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information."
      ],
      "justification": "Direct paraphrase of the information check step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the customer exists, we move on to checking their payment history."
      ],
      "justification": "Captures the existence check condition, the XOR split, the positive guard, and the subsequent payment history review."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if the customer does not exist, we need to verify their customer status."
      ],
      "justification": "Matches the negative branch condition and the corresponding status verification action."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process."
      ],
      "justification": "Models the payment history evaluation, the XOR decision, the positive guard, and the convergence point where parallel/divergent paths rejoin."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Captures the customer-type evaluation, the exclusive split, the positive guard for private customers, and the decline message action."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "The negative guard from the customer-type branch implies the wholesaler case, followed by the creation and availability check steps."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->n16",
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Fully covers the unavailability condition, production action, second decline message, explicit termination action, and end node."
    },
    {
      "refs": [
        "guard:b4->c1",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Positive guard routes back to the convergence point, and the action sends the confirmation."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "AND gateway correctly models the simultaneous/split execution for notifying both departments."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Sequentially matches the packing/invoicing step and the subsequent readiness state."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Convergence node represents the rejoined flow after notifications/prep; action matches the delivery step."
    },
    {
      "refs": [
        "guard:b5->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Captures the payment receipt check, positive guard, and order closure action."
    },
    {
      "refs": [
        "guard:b5->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Negative payment guard leads to the reminder quantity evaluation step."
    },
    {
      "refs": [
        "guard:b6->n29",
        "action:n29"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Threshold check, XOR split, positive guard, and continuation action all align."
    },
    {
      "refs": [
        "guard:b6->n30",
        "action:n30",
        "action:n31"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Negative guard covers the high-reminder case, triggering the donning process action and explicit termination."
    }
  ],
