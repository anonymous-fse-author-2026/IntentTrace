{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n_i2",
        "action:n3"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "The opening clause implicitly signals process initiation (init) and contains the exact names for the first three action steps."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "guard:b1->n6",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned. However, if the invoice is complete, the process continues."
      ],
      "justification": "The conditional split is captured by the XOR branch and the action-step condition; guards map to incomplete/complete outcomes, and n5 maps to the return action."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted. On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Branch and action represent the compliance decision point; guards cover both the non-compliant and compliant routing paths."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved. But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Direct mapping of the two resolution methods described in the source."
    },
    {
      "refs": [
        "action:n10",
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Covers the payment step and the subsequent compliance resolution triggered upon return."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "\"Simultaneously\" explicitly triggers a parallel AND split; the action matches the billing client step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Faithfully captures the waiting period condition and exact duration."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "the client is notified of the payment."
      ],
      "justification": "Exact textual match for the notification action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Matches the reminder action and explicitly signals the termination of this workflow path."
    },
    {
      "refs": [
        "action:n18",
        "guard:b3->n19",
        "guard:b3->n20",
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved. However, if the client is satisfied, the process continues."
      ],
      "justification": "Fully covers the satisfaction check, branching guards, and both resulting outcomes without altering logic or values."
    }
  ],
