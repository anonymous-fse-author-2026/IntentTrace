init(i1)
action(n1, "Start Process")
action(n2, "Enter Metadata")
action(n3, "IN-Patient Step")
action(n4, "Send Data to Suppliers")
action(n5, "Create Claim")
action(n6, "Extract and Transfer Data from Suppliers to Doctor")
action(n7, "Confirm GOP")
branch(b1, XOR)
action(n8, "End Process: GOP Confirmed")
end(e1)
action(n9, "Register Case")
action(n10, "Handle Claim")
action(n11, "Extract Data from Suppliers Again")
action(n12, "Enter Data on Patient Record or Confirm IN-Patient Status")
branch(b2, XOR)
