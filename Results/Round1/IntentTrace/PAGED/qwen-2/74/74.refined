action(n14, "Receive Payment")
action(n15, "End Process: Payment Received")
end(e2)
action(n16, "Confirm IN-Patient Status")
end(e3)
defines(v1, "Confirm GOP", {"Confirmed", "Not Confirmed"})
defines(v2, "Enter Data on Patient Record or Confirm IN-Patient Status", {"Entered", "Confirmed"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, n6, n7, b1, n8, e1, n9, n10, n11, n12, b2, n13, n14, n15, e2, n16, e3])
precedence(i1, n1)
precedence(n1, n2)
