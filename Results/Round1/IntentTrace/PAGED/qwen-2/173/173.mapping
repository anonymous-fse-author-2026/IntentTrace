{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "The opening clause implicitly signals the process start and directly describes the first action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "Captures the initial decision node, the negative condition guard, and the corresponding advertising action."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available"
      ],
      "justification": "Maps to the positive branch guard from the first decision point."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then continue with the process. If there is still no suitable candidate available"
      ],
      "justification": "Models the continuation flow and introduces the second decision checkpoint."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "if there is a suitable candidate available"
      ],
      "justification": "Corresponds to the positive outcome path from the second decision."
    },
    {
      "refs": [
        "guard:b2->e2"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Models an alternative termination path from the second decision, consistent with the overall process conclusion."
    },
    {
      "refs": [
        "action:n5",
        "guard:b3->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "Covers the third decision, its negative condition guard, and the repeated advertising step."
    },
    {
      "refs": [
        "guard:b3->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available"
      ],
      "justification": "Captures the final positive decision path and the logical rejoining of flows before proceeding."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "then proceed with selecting the appropriate applicant."
      ],
      "justification": "Direct textual match for the applicant selection step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed"
      ],
      "justification": "Direct textual match for the appointment step."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Faithfully restates the process termination. Redundant nodes are permitted and treated as matches when content aligns."
    }
