init(i1)
action(n1, "start")
action(n2, "Passengers undergo immigration checks")
action(n3, "Select method for exit control checks: Biometrics or ID documents?")
branch(b1, XOR)
action(n4, "Undergo biometric check")
action(n5, "Check using identity documents")
converge(c1)
branch(b2, XOR)
action(n7, "Leave the area and end process")
end(e1)
action(n8, "Proceed to next step")
branch(b3, XOR)
action(n11, "Leave the area and end process")
end(e3)
action(n9, "End of successful process")
end(e2)
defines(v1, "Select method for exit control checks: Biometrics or ID documents?", {"Biometrics", "ID documents"})
defines(v2, "Permission", {"Denied", "Allowed"})
defines(v3, "Outcome", {"Unsuccessful", "Successful"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, c1, b2, n7, e1, n8, b3, n11, e3, n9, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, c1)
precedence(n5, c1)
precedence(c1, b2)
precedence(b2, n7)
precedence(b2, n8)
precedence(n7, e1)
precedence(n8, b3)
precedence(b3, n11)
precedence(b3, n9)
precedence(n11, e3)
precedence(n9, e2)
guard(b1, n4, v1 = 'Biometrics')
guard(b1, n5, v1 = 'ID documents')
guard(b2, n7, v2 = 'Denied')
guard(b2, n8, v2 = 'Allowed')
guard(b3, n11, v3 = 'Unsuccessful')
guard(b3, n9, v3 = 'Successful')