guard(b_monitor, i4, v_completed = 'Yes')
guard(b_monitor, i7, v_completed = 'No')
guard(b_loop, c_i5, v_completed2 = 'Yes')
guard(b_loop, i10, v_completed2 = 'No')
guard(b_psy, i14, v_psy = 'Yes')
