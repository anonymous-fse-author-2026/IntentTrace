init(i1)
action(i2, "check the Referee Reports")
action(i3, "At the same time, you should continue to monitor if the Referee Reports have been completed.")
branch(b_and, AND)
branch(b_monitor, XOR)
action(i4, "if the Referee Reports have been completed")
action(i5, "If they have")
action(i6, "you can proceed with the process")
action(i7, "if they have not been completed")
converge(c_loop)
action(i8, "flag it and send a reminder")
action(i9, "check again if the Referee Reports have been completed")
branch(b_loop, XOR)
action(i10, "If not")
converge(c_i5)
converge(c_and)
action(i11, "Once the Referee Reports have been completed")
action(i12, "organizing interviews for the Selection Panel with the top candidates")
action(i23, "receive feedback from interview candidates")
action(i13, "check if a Psychometric Test is required")
branch(b_psy, XOR)
action(i14, "If it is")
action(i15, "check if an HR Specialist is required")
branch(b_hr, XOR)
action(i17, "If an HR Specialist is required")
action(i18, "schedule the test with a third party")
action(i19, "Otherwise,")
action(i20, "proceed to complete the Psychometric Test")
action(i10_2, "If not")
action(i16, "coordinate the second round of selection")
converge(c_hr)
converge(c_psy)
action(i21, "Finally")
action(i22, "request the final candidate ranking and continue with the process")
end(e1)

defines(v_completed, "Referee Reports completed?", {"Yes", "No"})
defines(v_completed2, "Referee Reports completed again?", {"Yes", "No"})
defines(v_psy, "Psychometric Test required?", {"Yes", "No"})
defines(v_hr, "HR Specialist required?", {"Yes", "No"})

actor(a_default, "Default", [i1, i2, i3, b_and, b_monitor, i4, i5, i6, i7, c_loop, i8, i9, b_loop, i10, c_i5, c_and, i11, i12, i23, i13, b_psy, i14, i15, b_hr, i17, i18, i19, i20, i10_2, i16, c_hr, c_psy, i21, i22, e1])

precedence(i1, b_and)
precedence(b_and, i2)
precedence(b_and, i3)
precedence(i2, c_and)
