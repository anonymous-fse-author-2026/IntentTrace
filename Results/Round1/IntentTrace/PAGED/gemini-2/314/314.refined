init(i1)
action(n1, "start by identifying the vacancy.")
action(n2, "Any candidates available?")
branch(b1, XOR)
action(n_cont, "continue with the process.")
action(n4, "Advertise Vacancy")
converge(c2)
action(n5, "After advertising  any candidates?")
branch(b2, XOR)
action(n6, "Advertise Again")
converge(c1)
action(n3, "Select Applicant")
action(n_app, "Once the candidate is appointed")
action(n8, "End")
end(e1)
defines(v1, "Any candidates available?", {"Yes", "No"})
defines(v2, "After advertising  any candidates?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n_cont, n4, c2, n5, b2, n6, c1, n3, n_app, n8, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n_cont)
guard(b1, n_cont, v1=="Yes")
precedence(b1, n4)
guard(b1, n4, v1=="No")
precedence(n_cont, c1)
precedence(n4, c2)
precedence(c2, n5)
precedence(n5, b2)
precedence(b2, c1)
guard(b2, c1, v2=="Yes")
precedence(b2, n6)
guard(b2, n6, v2=="No")
precedence(n6, c2)
precedence(c1, n3)
precedence(n3, n_app)
precedence(n_app, n8)
precedence(n8, e1)