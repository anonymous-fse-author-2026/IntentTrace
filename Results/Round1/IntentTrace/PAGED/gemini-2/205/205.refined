init(i1)
action(n1, "start")
action(n2, "Initiate Resupply Cycle for ACME Company")
action(n3, "Check Inventory Level")
branch(b1, XOR)
converge(c3)
action(n4, "Create Purchase Order")
action(n5, "Review Purchase Order")
branch(b2, XOR)
action(n6, "Rework Purchase Order")
action(n7, "Reserve Funds for Payment")
action(n8, "Send Purchase Order to Supplier")
branch(b3, AND)
action(n9, "Receive Packing Slip")
action(n10, "Record Packing Slip")
action(n11, "Receive Invoice")
action(n12, "Record Invoice")
converge(c1)
action(n13, "Release Funds for Payment")
action(n14, "Issue Payment to Supplier")
end(e1)
end(e2)
defines(v1, "Check Inventory Level", {"<= Minimum", "> Minimum"})
defines(v2, "Review Purchase Order", {"Accepted", "Rejected"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, c3, n4, n5, b2, n6, n7, n8, b3, n9, n10, n11, n12, c1, n13, n14, e1, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
guard(b1, n4, v1="<= Minimum")
precedence(b1, e2)
guard(b1, e2, v1="> Minimum")
precedence(n4, c3)
precedence(n6, c3)
precedence(c3, n5)
precedence(n5, b2)
precedence(b2, n7)
guard(b2, n7, v2="Accepted")
precedence(b2, n6)
guard(b2, n6, v2="Rejected")
precedence(n7, n8)
precedence(n8, b3)
precedence(b3, n9)
precedence(n9, n10)
precedence(n10, c1)
precedence(b3, n11)
precedence(n11, n12)
precedence(n12, c1)
precedence(c1, n13)
precedence(n13, n14)
precedence(n14, e1)