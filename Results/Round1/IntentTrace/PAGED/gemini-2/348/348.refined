init(i1)
action(a1, "the process starts")
action(a2, "Bill for Purchased Goods/Services")
action(a3, "Receive Invoice")
branch(b1, XOR)
action(a5, "it is returned")
end(e1)
converge(c1)
action(a7, "the process continues")
branch(b2, XOR)
action(a9, "further checks are conducted")
branch(b3, XOR)
action(a13, "non-compliance is resolved")
action(a15, "requires mail back, the invoice is returned")
end(e2)
converge(c2)
action(a16, "invoice is paid")
action(a17, "Bill Client")
branch(b4, XOR)
action(a19, "a period of 10 days is given")
action(a21, "a reminder is sent")
end(e3)
action(a20, "client is notified of the payment")
branch(b5, XOR)
action(a23, "payment discrepancy is resolved")
end(e4)

defines(v1, "Invoice Completeness", {"Incomplete", "Complete"})
defines(v2, "Invoice Compliance", {"Non-Compliant", "Compliant"})
defines(v3, "Issue Resolution", {"Phone Call", "Mail Back"})
defines(v4, "Client Response", {"No Response", "Responded"})
defines(v5, "Client Satisfaction", {"Unsatisfied", "Satisfied"})

actor(a_def, "Default Actor", [i1, a1, a2, a3, b1, a5, e1, c1, a7, b2, a9, b3, a13, a15, e2, c2, a16, a17, b4, a19, a21, e3, a20, b5, a23, e4])

precedence(i1, a1)
precedence(a1, a2)
precedence(a2, a3)
precedence(a3, b1)
precedence(b1, a5)
precedence(a5, e1)
precedence(b1, c1)
precedence(c1, a7)
precedence(a7, b2)
precedence(b2, a9)
precedence(b2, c2)
precedence(a9, b3)
precedence(b3, a13)
precedence(b3, a15)
precedence(a15, e2)
precedence(a13, c2)
precedence(c2, a16)
precedence(a16, a17)
precedence(a17, b4)
precedence(b4, a19)
precedence(a19, a21)
precedence(a21, e3)
precedence(b4, a20)
precedence(a20, b5)
precedence(b5, a23)
precedence(a23, e4)
precedence(b5, c1)

guard(b1, a5, v1 = 'Incomplete')
guard(b1, c1, v1 = 'Complete')
guard(b2, a9, v2 = 'Non-Compliant')
guard(b2, c2, v2 = 'Compliant')
guard(b3, a13, v3 = 'Phone Call')
guard(b3, a15, v3 = 'Mail Back')
guard(b4, a19, v4 = 'No Response')
guard(b4, a20, v4 = 'Responded')
guard(b5, a23, v5 = 'Unsatisfied')
guard(b5, c1, v5 = 'Satisfied')