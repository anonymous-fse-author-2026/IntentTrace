init(i1)
action(i2, "Rental Items are Returned to the Store")
branch(b1, XOR)
action(i3, "Customer returns the items to the store")
action(i4, "Delivery Crew picks-up items at the event site")
converge(c1)
action(i5, "During this step, the items are counted and compared to the original contract.")
branch(b2, XOR)
action(i6, "Order is complete and all items were returned")
branch(b3, XOR)
action(i11, "Items are packed for an existing order")
action(i12, "Items are stored for future orders")
converge(c2)
action(i7, "Order is incomplete and items are missing")
action(i10, "we email the customer to inform them")
branch(b4, XOR)
action(i14, "Customer returns the missing items")
action(i15, "Customer does not return the missing items")
converge(c3)
converge(c6)
action(i16, "Finally, when the process is complete, it ends.")
end(e1)
action(i8, "Order is complete but items are damaged")
action(i9, "we email the customer to inform them of the damage and additional charges")
action(i13, "if there are damaged items and additional charges, we temporarily take them out of inventory")
branch(b5, XOR)
action(i17, "Items are repaired and added into inventory")
branch(b6, XOR)
action(i20, "Items are packed for an existing order")
action(i21, "Items are stored for future orders")
converge(c4)
action(i18, "Items can't be repaired and are discarded")
action(i19, "we email the customer with replacement charges")
converge(c5)
action(i22, "Once again, when the process is complete, it ends.")
end(e2)
defines(v1, "Return Method", {"customer", "delivery"})
defines(v2, "Order Status", {"complete", "incomplete", "damaged"})
defines(v3, "Items Status", {"packed", "stored"})
defines(v4, "Missing Items", {"returned", "not returned"})
defines(v5, "Repair Status", {"repaired", "discarded"})
defines(v6, "Repaired Items Status", {"packed", "stored"})
actor(a_default, "Default", [i1, i2, b1, i3, i4, c1, i5, b2, i6, b3, i11, i12, c2, i7, i10, b4, i14, i15, c3, c6, i16, e1, i8, i9, i13, b5, i17, b6, i20, i21, c4, i18, i19, c5, i22, e2])
precedence(i1, i2)
precedence(i2, b1)
precedence(b1, i3)
precedence(b1, i4)
precedence(i3, c1)
precedence(i4, c1)
precedence(c1, i5)
precedence(i5, b2)
precedence(b2, i6)
precedence(i6, b3)
precedence(b3, i11)
precedence(b3, i12)
precedence(i11, c2)
precedence(i12, c2)
precedence(c2, c6)
precedence(b2, i7)
precedence(i7, i10)
precedence(i10, b4)
precedence(b4, i14)
precedence(b4, i15)
precedence(i14, c3)
precedence(i15, c3)
precedence(c3, c6)
precedence(c6, i16)
precedence(i16, e1)
precedence(b2, i8)
precedence(i8, i9)
precedence(i9, i13)
precedence(i13, b5)
precedence(b5, i17)
precedence(b5, i18)
precedence(i17, b6)
precedence(b6, i20)
precedence(b6, i21)
precedence(i20, c4)
precedence(i21, c4)
precedence(c4, c5)
precedence(i18, i19)
precedence(i19, c5)
precedence(c5, i22)
precedence(i22, e2)
guard(b1, i3, v1 == "customer")
guard(b1, i4, v1 == "delivery")
guard(b2, i6, v2 == "complete")
guard(b2, i7, v2 == "incomplete")
guard(b2, i8, v2 == "damaged")
guard(b3, i11, v3 == "packed")
guard(b3, i12, v3 == "stored")
guard(b4, i14, v4 == "returned")
guard(b4, i15, v4 == "not returned")
guard(b5, i17, v5 == "repaired")
guard(b5, i18, v5 == "discarded")
guard(b6, i20, v6 == "packed")
guard(b6, i21, v6 == "stored")