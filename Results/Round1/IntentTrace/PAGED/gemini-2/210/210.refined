init(i1)
action(n1, "Request to purchase a motorcycle")
branch(b1, XOR)
action(n2, "production order is received")
action(n3, "continue the process")
action(n4, "update the sales information")
action(n5, "proceed to order dispatch")
branch(b2, XOR)
action(n6, "If there are unavailable materials")
action(n7, "ordered from the supplier")
action(n8, "Alternatively, if there are available goods for production")
action(n9, "a manufacturing order is placed")
action(n10, "materials are received from the supplier")
converge(c1)
action(n11, "the goods are issued")
action(n12, "the motorcycles are produced")
branch(b4, XOR)
action(n14, "At the same time, the stock is updated and the motorcycles are dispatched.")
action(n15, "After the goods are issued and the motorcycles are produced, the stock is updated and the process ends.")
action(n16, "Simultaneously, the stock is updated and the sales information is updated.")
end(e1)

defines(v1, "Production order received", {"Yes", "No"})
defines(v2, "Materials unavailable", {"Yes", "No"})
defines(v3, "Outcome", {"A", "B", "C"})

actor(a_default, "Default", [i1, n1, b1, n2, n3, n4, n5, b2, n6, n7, n8, n9, n10, c1, n11, n12, b4, n14, n15, n16, e1])

precedence(i1, n1)
precedence(n1, b1)

precedence(b1, n2)
guard(b1, n2, v1 == "Yes")
precedence(b1, n4)
guard(b1, n4, v1 == "No")

precedence(n2, n3)
precedence(n3, b2)

precedence(n4, n5)
precedence(n5, e1)

precedence(b2, n6)
guard(b2, n6, v2 == "Yes")
precedence(b2, n8)
guard(b2, n8, v2 == "No")

precedence(n6, n7)
precedence(n7, n10)
precedence(n10, c1)

precedence(n8, n9)
precedence(n9, c1)

precedence(c1, n11)
precedence(n11, n12)
precedence(n12, b4)

precedence(b4, n14)
guard(b4, n14, v3 == "A")
precedence(b4, n15)
guard(b4, n15, v3 == "B")
precedence(b4, n16)
guard(b4, n16, v3 == "C")

precedence(n14, e1)
precedence(n15, e1)
precedence(n16, e1)