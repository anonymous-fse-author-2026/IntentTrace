init(i1)
action(n1, "Orders Required")
action(n2, "place Bulk order")
branch(b1, XOR)
action(n4, "process order for delivery")
action(n5, "Outstanding Balance")
branch(b4, XOR)
action(n6, "place new order")
action(n7, "record in Accounts Receivable")
action(n8, "End at Warehouse")
end(e1)
branch(b2, XOR)
action(n10, "drop order")
action(n12, "identify order for installation")
branch(b3, XOR)
action(n14, "assign Installer")
action(n16, "pack for delivery")
converge(c1)
defines(v1, "credit allowance", {"Order with prior internal credit allowance", "order exceeds the purchaser's credit allowance"})
defines(v2, "payments", {"Payments are Received", "no payments are received"})
defines(v3, "installation", {"installation needs to be scheduled", "order does not require installation"})
defines(v4, "new order", {"If a new order is placed", "process ends at the Warehouse"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, n5, b4, n6, n7, n8, e1, b2, n10, c1, n12, b3, n14, n16])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, b4)
precedence(b4, n6)
precedence(b4, n8)
precedence(n8, e1)
precedence(n6, n7)
precedence(n7, b2)
precedence(n4, c1)
precedence(b2, c1)
precedence(b2, n10)
precedence(n10, e1)
precedence(c1, n12)
precedence(n12, b3)
precedence(b3, n14)
precedence(n14, e1)
precedence(b3, n16)
precedence(n16, e1)
guard(b1, n4, v1 = "Order with prior internal credit allowance")
guard(b1, n5, v1 = "order exceeds the purchaser's credit allowance")
guard(b2, c1, v2 = "Payments are Received")
guard(b2, n10, v2 = "no payments are received")
guard(b3, n14, v3 = "installation needs to be scheduled")
guard(b3, n16, v3 = "order does not require installation")
guard(b4, n6, v4 = "If a new order is placed")
guard(b4, n8, v4 = "process ends at the Warehouse")