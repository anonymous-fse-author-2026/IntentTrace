init(i1)
action(n1, "For TS recruitment, the first step is")
action(n2, "advise unsuccessful candidates")
action(n3, "If there are \"no more candidates\"")
branch(b1, XOR)
action(n4, "then the position should be re-advertised.")
action(n5, "Finally, the process ends.")
end(e1)
action(n6, "However, if the terms and conditions of the offer for a candidate need to be sorted out")
action(n7, "it is necessary to check if the candidate has accepted a voluntary redundancy.")
branch(b3, XOR)
action(n8, "On the other hand, if the candidate has accepted, further investigation is required.")
action(n9, "If the candidate has not accepted,")
action(n9a, "the process continues.")
action(n11, "The recruitment manager sends an Appointment Approval form,")
action(n12, "which is then received by the next level manager.")
action(n13, "If the manager is an external resource")
branch(b4, XOR)
action(n14, "they may not authorize the form.")
action(n15, "Finally, the process ends.")
end(e2)
action(n16, "if the approver is an existing employee of the client,")
action(n16a, "the process continues.")
action(n16b, "If the form is approved")
action(n19, "the recruitment manager sends the form and other documentation, which is received by the client HR.")
action(n20, "client HR receives form and documentation")
action(n21, "The HR department scans the completed form and records the position against the stored position in GovSource.")
action(n22, "If there are any variations")
branch(b6, XOR)
action(n23, "a complete business case is required.")
action(n24, "Otherwise, the process continues.")
action(n24a, "the process continues.")
action(n25, "The Appointment Approval is carried forward.")
action(n26, "If the position requires a medical assessment")
branch(b7, XOR)
action(n27, "it is applicable for a 12% rate.")
action(n28, "Otherwise, a medical assessment is not necessary.")
action(n29, "it can take up to 21 days to arrange and complete.")
action(n30, "The TS HR coordinator informs the recruitment manager,")
action(n31, "who then liaises with the HR representative to confirm the offer to the candidate.")
action(n32, "If the assessment is not satisfactory")
branch(b8, XOR)
action(n33, "the next candidate on the shortlist should be contacted.")
action(n34, "Finally, the process ends.")
end(e4)
action(n35, "However, if the assessment is fine, The recruitment manager makes a formal verbal offer of employment to the candidate.")
action(n36, "If the candidate accepts")
branch(b9, XOR)
action(n37, "the recruitment manager creates a formal written offer.")
action(n38, "If the candidate declines,")
action(n38a, "the process continues.")
action(n39, "Simultaneously, the commencement pack and letter of appointment are sent to the candidate.")
action(n40, "Once the candidate receives these documents")
action(n41, "if there is a \"40%\" rate")
branch(b10, XOR)
action(n42, "renegotiation is required.")
action(n43, "If the renegotiation is successful")
branch(b11, XOR)
action(n44, "However, if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified.")
action(n45, "Finally, the process ends.")
end(e5)
action(n46, "the process continues.")
end(e6)
action(n47, "Otherwise, if the candidate accepts")
action(n48, "the process continues.")
end(e7)
