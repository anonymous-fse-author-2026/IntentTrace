init(i1)
action(n1, "start")
action(n2, "Is x greater than 2?")
branch(b1, XOR)
action(n3, "Continue the process")
action(n4, "Continue the process")
converge(c1)
action(n6, "Similarly, if the value of x is greater than 2")
branch(b2, XOR)
action(n7, "Continue the process")
action(n8, "Continue the process")
converge(c2)
end(e1)
defines(v1, "Is x greater than 2?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, c1, n6, b2, n7, n8, c2, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, c1)
precedence(c1, n6)
precedence(n6, b2)
precedence(b2, n7)
precedence(b2, n8)
precedence(n7, c2)
precedence(n8, c2)
precedence(c2, e1)
guard(b1, n3, v1 == "Yes")
guard(b1, n4, v1 == "No")
guard(b2, n7, v1 == "Yes")
guard(b2, n8, v1 == "No")