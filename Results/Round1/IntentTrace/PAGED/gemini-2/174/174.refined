action(n16, "Notify Client Of Payment")
end(e3)

defines(v1, "Invoice Complete?", {"No", "Yes"})
defines(v2, "Invoice Compliant?", {"No", "Yes"})
defines(v3, "Issue Can Be Resolved With Phone Call?", {"Yes", "No"})
defines(v6, "Client Response", {"No response", "Unsatisfied", "Satisfied"})

actor(a_default, "Default", [i1, n1, n2, n3, b1, n5, e1, c4, n7, b2, n8, n9, b3, n11, c3, n10, c1, b7, n18, b6, n20, n21, e4, n24, e5, n26, n13, n16, e3])

