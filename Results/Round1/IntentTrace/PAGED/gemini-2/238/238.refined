action(n18, "Write Off the Order")
action(n20, "Send Reminder")
action(n21, "Close the Order")
action(n22, "End")
end(e3)
converge(c1)
converge(c2)
branch(b5, AND)
defines(v1, "Credit Limit Okay", {"No", "Okay"})
defines(v_avail1, "Response Okay", {"No", "Okay"})
defines(v2, "Article Available", {"No", "Yes"})
defines(v3, "Payment Received", {"Yes", "No"})
