init(i1)
action(n1, "start")
action(n2, "check loan application")
branch(b1, XOR)
action(n3, "is application rejected?")
action(n4, "end process: application rejected")
end(e1)
action(n5, "are special terms agreed upon?")
action(n6, "disburse funds")
action(n7, "end process: funds disbursed")
end(e2)
defines(v1, "is application rejected?", {"Yes", "No"})
defines(v2, "are special terms agreed upon?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, e1, n5, n6, n7, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(n3, n4)
precedence(n4, e1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, n7)
precedence(n7, e2)
guard(b1, n3, v1 == "Yes")
guard(b1, n5, v1 == "No")