init(i1)
branch(b_return, XOR)
action(i3, "Customer returns the items to the store")
action(i5, "Delivery Crew picks-up items at the event site")
converge(c_return)
action(i6, "the items are counted and compared to the original contract")
branch(b_status, XOR)
branch(b_disp1, XOR)
action(i11, "Items are packed for an existing order")
action(i12, "Items are stored for future orders")
converge(c1)
action(i17, "Finally, when the process is complete, it ends")
end(e1)
action(i13, "In case of missing items and replacement charges, we email the customer to inform them")
branch(b_missing, XOR)
action(i15, "Customer returns the missing items")
action(i16, "Customer does not return the missing items")
converge(c3)
action(i23, "The customer is then emailed with replacement charges, and the process is complete")
end(e2)
action(i10, "we email the customer to inform them of the damage and additional charges")
action(i14, "temporarily take them out of inventory")
branch(b_repair, XOR)
action(i18, "Items are repaired and added into inventory")
branch(b_disp2, XOR)
action(i20, "Items are packed for an existing order")
action(i21, "Items are stored for future orders")
converge(c2)
action(i22, "Once again, when the process is complete, it ends")
end(e3)
action(i19, "Items can't be repaired and are discarded")

defines(v_return, "Return type", {"Customer", "Crew"})
defines(v_status, "Order status", {"Complete", "Missing", "Damaged"})
defines(v_disp1, "Disposition 1", {"Packed", "Stored"})
defines(v_missing, "Missing items", {"Returned", "Not returned"})
defines(v_repair, "Repair status", {"Repaired", "Discarded"})
defines(v_disp2, "Disposition 2", {"Packed", "Stored"})

actor(a_sys, "System", [i1, b_return, i3, i5, c_return, i6, b_status, b_disp1, i11, i12, c1, i17, e1, i13, b_missing, i15, i16, c3, i23, e2, i10, i14, b_repair, i18, b_disp2, i20, i21, c2, i22, e3, i19])

precedence(i1, b_return)
precedence(b_return, i3)
precedence(b_return, i5)
precedence(i3, c_return)
precedence(i5, c_return)
precedence(c_return, i6)
precedence(i6, b_status)
precedence(b_status, b_disp1)
precedence(b_disp1, i11)
precedence(b_disp1, i12)
precedence(i11, c1)
precedence(i12, c1)
precedence(i15, c1)
precedence(c1, i17)
precedence(i17, e1)
precedence(b_status, i13)
precedence(i13, b_missing)
precedence(b_missing, i15)
precedence(b_missing, i16)
precedence(i16, c3)
precedence(i19, c3)
precedence(c3, i23)
precedence(i23, e2)
precedence(b_status, i10)
precedence(i10, i14)
precedence(i14, b_repair)
precedence(b_repair, i18)
precedence(b_repair, i19)
precedence(i18, b_disp2)
precedence(b_disp2, i20)
precedence(b_disp2, i21)
precedence(i20, c2)
precedence(i21, c2)
precedence(c2, i22)
precedence(i22, e3)

guard(b_return, i3, v_return = 'Customer')
guard(b_return, i5, v_return = 'Crew')
guard(b_status, b_disp1, v_status = 'Complete')
guard(b_status, i13, v_status = 'Missing')
guard(b_status, i10, v_status = 'Damaged')
guard(b_disp1, i11, v_disp1 = 'Packed')
guard(b_disp1, i12, v_disp1 = 'Stored')
guard(b_missing, i15, v_missing = 'Returned')
guard(b_missing, i16, v_missing = 'Not returned')
guard(b_repair, i18, v_repair = 'Repaired')
guard(b_repair, i19, v_repair = 'Discarded')
guard(b_disp2, i20, v_disp2 = 'Packed')
guard(b_disp2, i21, v_disp2 = 'Stored')