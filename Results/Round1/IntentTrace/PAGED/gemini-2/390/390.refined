defines(v_ob, "new_order", {"yes", "no"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, c1, n6, b_ob, n19, n7, n8, b2, n9, n10, n11, e1, n13, b3, n14, n15, n16])
