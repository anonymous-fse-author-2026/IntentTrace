init(i1)
action(n1, "begin by checking if the order has been received.")
action(n2, "check sum of order")
branch(b1, XOR)
action(n3, "compute a discount of 4%")
action(n4, "compute a discount of 3%")
action(n5, "compute a discount of 2%")
action(n6, "continue with the process")
converge(c1)
action(n7, "create the bill")
end(e1)
defines(v1, "check sum of order", {">2000", "1000-1500", "500-999", "<500"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, n6, c1, n7, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(b1, n5)
precedence(b1, n6)
precedence(n3, c1)
precedence(n4, c1)
precedence(n5, c1)
precedence(n6, c1)
precedence(c1, n7)
precedence(n7, e1)
guard(b1, n3, v1 = '>2000')
guard(b1, n4, v1 = '1000-1500')
guard(b1, n5, v1 = '500-999')
guard(b1, n6, v1 = '<500')
label(n1, n2, "Start")