    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, the eligibility of the applicant is assessed."
      ],
      "justification": "'After that' signals the rejoining of parallel paths (converge) immediately before the eligibility assessment action and the resulting XOR decision branch."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the applicant is eligible, the acceptance pack is prepared."
      ],
      "justification": "The guard condition faithfully models the eligibility check as 'Yes', leading directly to the pack preparation action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the applicant is not eligible, the application is rejected."
      ],
      "justification": "The guard condition faithfully models the negative case as 'No', leading directly to the rejection action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the application is rejected, the loan application process ends."
      ],
      "justification": "Explicitly describes the termination of the workflow on the rejection path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The prepared acceptance pack is then sent."
      ],
      "justification": "Directly matches the dispatch step following pack preparation."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the acceptance pack is sent, the process ends."
      ],
      "justification": "Describes the final state transition and termination of the successful path."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "On the other hand, if the applicant is eligible, the acceptance pack is prepared."
      ],
      "justification": "Repetition of the positive eligibility branch in the source text redundantly supports the same guard and action, which is treated as a valid match per the redundancy rule."
    }
