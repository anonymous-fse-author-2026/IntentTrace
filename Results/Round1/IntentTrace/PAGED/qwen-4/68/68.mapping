{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Opening clause implicitly starts the process (init), describes the start action, and covers the initial item return step."
    },
    {
      "refs": [
        "guard:b1->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process."
      ],
      "justification": "Conditional phrase establishes the XOR branch and supports the guard and action for customer returns."
    },
    {
      "refs": [
        "guard:b1->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Second arm of the branch captures the delivery crew pickup condition and action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Parallel paths rejoin before the counting step, and the sentence describes the action."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process."
      ],
      "justification": "First case of the contract comparison decision maps to the branch, guard, and disposition action."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "if the \"Order is incomplete and items are missing,\" we still continue the process."
      ],
      "justification": "Condition triggers the missing items path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Subsequent sentence specifies the emailing action modeled for the missing items path."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Damage condition and its corresponding emailing action are captured."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Explicit instruction to remove damaged items from inventory matches the action."
    },
    {
      "refs": [
        "action:n11",
        "guard:b5->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process."
      ],
      "justification": "Implies the repair check question/action, the branch, and the positive repair guard/action."
    },
    {
      "refs": [
        "guard:b5->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Negative repair arm condition and corresponding action/guard."
    },
    {
      "refs": [
        "action:n14",
        "guard:b3->n18",
        "action:n18",
        "guard:b6->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order. If the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Transition to packing disposition and duplicate parallel branches capturing the packing condition and action. Redundancy is acceptable."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15",
        "guard:b6->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "if the \"Items are stored for future orders,\" we also continue the process. Once again, when the process is complete, it ends."
      ],
      "justification": "Stored condition for both branch instances leads to process termination, supported by the explicit end statement."
    },
    {
      "refs": [
        "guard:b4->n19",
        "action:n7",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process."
      ],
      "justification": "Conditional handles the positive arm for returning missing items, supporting the branch, guard, and duplicate actions."
    },
    {
      "refs": [
        "guard:b4->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the \"Customer does not return the missing items,\" we still continue the process. Finally, when the process is complete, it ends."
      ],
      "justification": "Handles the negative arm for missing items, leading to process completion and the structural end node."
    }
  ],
