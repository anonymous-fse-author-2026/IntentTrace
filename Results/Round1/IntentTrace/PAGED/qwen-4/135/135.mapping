      ],
      "verbatim_texts": [
        "After checking the shipment status again, if it is okay, proceed to Send Payment."
      ],
      "justification": "This single span supports the re-check action, the implicit second decision point, the positive guard, and the consequent payment action."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Otherwise, communicate any shipment problems."
      ],
      "justification": "The guard captures the alternative path logic, while the action directly matches the stated communication step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, once the payment is sent, the process comes to an end."
      ],
      "justification": "The closing sentence implies the convergence of parallel/alternative paths, names the final conceptual step, and explicitly signals the process termination."
