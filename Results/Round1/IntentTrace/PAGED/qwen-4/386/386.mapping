{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we receive the contract for the marketing campaign."
      ],
      "justification": "Opening clause implicitly signals the process start and directly describes the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once we have the contract, we take it to the department."
      ],
      "justification": "Direct paraphrase of the second sequential step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "In the next step, we input the customer's details into NKE."
      ],
      "justification": "Direct match for the data entry step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer's details are missing"
      ],
      "justification": "Conditional phrase triggers the XOR decision; modeling the condition as a check action is acceptable per example rules."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "we contact the customers."
      ],
      "justification": "Positive condition arm (missing=yes) correctly routes to the contact action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the customer's details are ready, we create a suitable team."
      ],
      "justification": "Negative condition arm (ready=no missing) correctly routes to the first team creation action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After contacting the customers, we receive additional customer details."
      ],
      "justification": "Direct match following the contact path."
    },
    {
      "refs": [
        "action:n7",
        "action:n9"
      ],
      "verbatim_texts": [
        "Then, we create the team and check previous campaigns for reusable material."
      ],
      "justification": "Conjoined clause splits into two sequential actions; n7 captures the second team creation instance explicitly mentioned here."
    },
    {
      "refs": [
        "action:n10",
        "guard:b2->n11",
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "Upon finding reusable ideas from previous campaigns"
      ],
      "justification": "Conditional phrase triggers the second XOR branch and both outcome guards; check action faithfully restates the condition."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "we create a new concept."
      ],
      "justification": "Action matches source; n12 is a structurally redundant parallel path but carries identical source-backed content."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the new concept is created, we integrate new ideas and add further points."
      ],
      "justification": "Action matches source; n14 is a structurally redundant duplicate carrying identical source-backed content."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Next, we integrate the revised campaign into the database."
      ],
      "justification": "Direct match for the database integration step."
    },
    {
      "refs": [
        "action:n16",
        "action:n21"
      ],
      "verbatim_texts": [
        "The concept is then presented to the relevant party for consideration."
      ],
      "justification": "Action matches source; n21 represents a redundant loop-back presentation step, which aligns with the source text under the redundancy rule."
    },
    {
      "refs": [
        "guard:b3->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the concept is declined, we rework it."
      ],
      "justification": "Decline condition triggers the XOR branch, negative guard, and rework action."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "On the other hand, if the concept is accepted, we proceed to present it to the customer."
      ],
      "justification": "Acceptance condition triggers positive guard and customer presentation action."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "This marks the end of the process."
      ],
      "justification": "Closing sentence explicitly signals termination, supporting both the end action and structural end node."
    }
  ],
