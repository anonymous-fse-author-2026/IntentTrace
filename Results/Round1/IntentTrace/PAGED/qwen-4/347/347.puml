@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process for ACME;
:begin New Resupply Cycle;
:Check Levels of Inventory;
:v1: Inventory Level ({inventory is below or equal to the minimum, inventory is greater than the minimum}); <<objectSignal>>
if () then ([v1 = 'inventory is below or equal to the minimum'])
:generate Equal to or below minimum Report;
:create Purchase Orders POs;
repeat :;
:If the PO is created, it needs to be reviewed. If the PO needs to be reworked, it needs to be created again.;
:v2: PO Status ({PO is rejected, PO is approved}); <<objectSignal>>
backward:rework PO;
repeat while () is ([v2 = 'PO is rejected']) not ([v2 = 'PO is approved'])
:print and release PO in system;
split
:reserve funds for released POs;
:Receive Packing Slip;
split again
:Mail POs to supplier;
:receive inventory;
end split
:Receive Invoice;
:Proceed to Three way match;
:Release funds;
:Issue payment;
:Resupply Cycle is complete process ends;
stop
else ([v1 = 'inventory is greater than the minimum'])
:generate Above Minimum Report;
stop
endif
@enduml