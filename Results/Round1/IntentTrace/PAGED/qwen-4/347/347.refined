init(i1)
action(n1, "start the process for ACME")
action(n2, "begin New Resupply Cycle")
action(n3, "Check Levels of Inventory")
branch(b1, XOR)
action(n4, "generate Equal to or below minimum Report")
action(n5, "generate Above Minimum Report")
end(e1)
action(n6, "create Purchase Orders POs")
action(n7, "If the PO is created, it needs to be reviewed. If the PO needs to be reworked, it needs to be created again.")
branch(b2, XOR)
action(n8, "rework PO")
action(n9, "print and release PO in system")
branch(b3, AND)
action(n10, "reserve funds for released POs")
action(n11, "Mail POs to supplier")
converge(c0)
converge(c2)
action(n12, "Receive Packing Slip")
action(n13, "receive inventory")
action(n14, "Receive Invoice")
action(n15, "Proceed to Three way match")
action(n16, "Release funds")
action(n17, "Issue payment")
action(n18, "Resupply Cycle is complete process ends")
end(e2)
defines(v1, "Inventory Level", {"inventory is below or equal to the minimum", "inventory is greater than the minimum"})
defines(v2, "PO Status", {"PO is rejected", "PO is approved"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n5, e1, n6, n7, b2, n8, n9, b3, n10, n11, c0, c2, n12, n13, n14, n15, n16, n17, n18, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, e1)
precedence(n4, n6)
precedence(n6, c0)
precedence(n8, c0)
precedence(c0, n7)
precedence(n7, b2)
precedence(b2, n8)
precedence(b2, n9)
precedence(n9, b3)
precedence(b3, n10)
precedence(b3, n11)
precedence(n10, n12)
precedence(n11, n13)
precedence(n12, c2)
precedence(n13, c2)
precedence(c2, n14)
precedence(n14, n15)
precedence(n15, n16)
precedence(n16, n17)
precedence(n17, n18)
precedence(n18, e2)
guard(b1, n4, v1 = 'inventory is below or equal to the minimum')
guard(b1, n5, v1 = 'inventory is greater than the minimum')
guard(b2, n8, v2 = 'PO is rejected')
guard(b2, n9, v2 = 'PO is approved')