{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n3"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Opening clause implicitly starts the process and sequentially describes the first two actions."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Initial completeness decision leads to the return action and path termination."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Guard represents the positive path continuing past the first check."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Compliance verification step feeding into the second decision gateway."
    },
    {
      "refs": [
        "guard:b2->n_skip",
        "action:n_skip"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Compliant branch guard and accompanying skip/proceed action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Phone-based resolution branch and its corresponding action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Mail requirement branch and corresponding return action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Rejoining of split paths followed by the combined payment and resolution step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Explicitly named parallel task executed alongside the main flow."
    },
    {
      "refs": [
        "guard:b_resp->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Client response decision branching to the mandatory waiting period."
    },
    {
      "refs": [
        "guard:b_resp->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Positive response path leading to the payment notification action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Reminder action immediately followed by explicit process termination."
    },
    {
      "refs": [
        "action:n18",
        "guard:b3->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Satisfaction evaluation branching to discrepancy resolution and terminating that path."
    },
    {
      "refs": [
        "guard:b3->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Satisfied path guard leading to the completion step and final end node."
    }
  ],
