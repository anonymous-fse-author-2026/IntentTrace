@startuml
!theme plain
|a_default| Default
|a_default|
start
:To start, please provide the userdata for flickr.;
:v1: login_status ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:If the login is successful;
else ([v1 = 'No'])
:if the login fails, we will continue with the process.;
:v2: user_choice ({try again, abort, still try again, decide to abort}); <<objectSignal>>
switch ()
case ([v2 = 'try again'])
:If you want to try again;
:please provide the userdata for flickr.;
case ([v2 = 'abort'])
:On the other hand, if you choose to abort;
:the process will end.;
case ([v2 = 'still try again'])
:If you still want to try again;
case ([v2 = 'decide to abort'])
:Alternatively, if you decide to abort;
endswitch
stop
endif
@enduml