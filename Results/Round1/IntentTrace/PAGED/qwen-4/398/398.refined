action(i8, "If you still want to try again")
action(i9, "Alternatively, if you decide to abort")
branch(b1, XOR)
branch(b2, XOR)
converge(c1)
converge(c2)
end(e1)
defines(v1, "login_status", {"Yes", "No"})
defines(v2, "user_choice", {"try again", "abort", "still try again", "decide to abort"})
actor(a_default, "Default", [start, i1, i2, i3, i4, i5, i6, i7, i8, i9, b1, b2, c1, c2, e1])
precedence(start, i1)
precedence(i1, b1)
