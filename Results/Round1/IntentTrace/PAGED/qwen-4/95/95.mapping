{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Covers the implicit process start, the explicit start action, and the initial placing order step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check the Customer's Credit Limit"
      ],
      "justification": "Direct match to the first evaluation step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "Captures the conditional split, the positive outcome state modeled as an action, and the routing guard for the 'Okay' case."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Matches the negative routing guard, the denial action, and the implicit termination of this branch."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "if the response is \"Okay\", proceed to Check the Availability of the Article again."
      ],
      "justification": "Captures the second availability decision point, the positive outcome action, the 'Okay' guard, and the repeated check action."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Matches the negative routing guard for the second check, the corresponding denial action, and branch termination."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Aligns with the unavailability decision, the 'Not Available' guard, and the production step."
    },
    {
      "refs": [
        "action:n12",
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Matches the availability condition action, the 'Available' guard, and the collection step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Direct match to the confirmation sending step."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "Captures the parallel split, the subsequent converge nodes, and both concurrent shipping/invoicing actions."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Direct match to the payment verification step."
    },
    {
      "refs": [
        "action:n19",
        "guard:b4->n20"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "Captures the positive payment outcome action, the payment decision split, and the 'Received' routing guard."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Matches the negative payment guard and the reminder count evaluation action."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "close the Order and end the process."
      ],
      "justification": "Maps to the closure action, process ending action, and structural end node for the successful payment path."
    },
    {
      "refs": [
        "guard:b5->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Aligns with the threshold decision, the '>= 3' guard, and the write-off action."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Direct match to the reminder dispatch step."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Captures the post-writeoff closure, process ending action, and terminal end node."
    }
  ],
