@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start WIGGO process;
:Place Order;
:Check Customer Credit Limit;
:Credit response okay;
:v1: Credit response okay ({Okay, No}); <<objectSignal>>
if () then ([v1 = 'No'])
:Send Denial to Customer;
stop
else ([v1 = 'Okay'])
:Check Availability of Article;
:Availability okay first check;
:v2: Availability okay first check ({Okay, No}); <<objectSignal>>
if () then ([v2 = 'Okay'])
:Check Availability of Article again;
:Article available second check;
:v3: Article available second check ({Available, Not Available}); <<objectSignal>>
if () then ([v3 = 'Available'])
:Collect Goods;
else ([v3 = 'Not Available'])
:Produce Goods;
endif
:Send Order Confirmation;
split
:Ship Goods;
split again
:Send Invoice;
end split
:Check Payment status;
:Payment received;
:v4: Payment received ({Received, Not Received}); <<objectSignal>>
if () then ([v4 = 'Received'])
:Close Order;
:End process;
stop
else ([v4 = 'Not Received'])
:Reminder count greater than or equal to 3;
:v5: Reminder count ({[0-]}); <<objectSignal>>
if () then ([v5 >= 3])
:Write off Order;
:Send Reminder;
:Close Order;
:End process;
else ([v5 < 3])
->;
endif
stop
endif
else ([v2 = 'No'])
:Send Denial to Customer;
stop
endif
endif
@enduml