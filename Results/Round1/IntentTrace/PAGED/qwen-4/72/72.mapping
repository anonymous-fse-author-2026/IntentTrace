{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "The opening clause explicitly initiates the process and describes the first two sequential actions."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Captures the completeness check, the incomplete branch condition, the return action, and the associated termination point."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Models the positive branch guard and the continuation step that leads into the next compliance check."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Corresponds to the secondary compliance evaluation node and its decision gateway."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Matches the phone resolution condition and the resulting corrective action."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Aligns with the mail-back condition, the return action, and the associated process termination."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "The concurrency keyword maps to parallel branches, while the specific task maps to the billing action and subsequent join point."
    },
    {
      "refs": [
        "action:n11",
        "action:n18"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Both action elements faithfully restate the payment and notification step, consistent with acceptable redundancy."
    },
    {
      "refs": [
        "end:e4"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Explicit closing marker in the source text justifies the terminal node."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Covers the response check, decision gateway, negative-path guard, and the waiting period action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Directly matches the post-wait reminder action and the corresponding termination node."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Accurately models the satisfaction check, the unsatisfied guard condition, and the discrepancy resolution step."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Reflects the satisfied branch outcome and the continuation instruction; 'Yes' in the guard is an acceptable modeling paraphrase."
    }
  ],
