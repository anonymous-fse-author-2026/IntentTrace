    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If you still want to try again, please provide the userdata for flickr."
      ],
      "justification": "Positive retry guard and associated action are supported by both sequential instances of the retry instruction."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
