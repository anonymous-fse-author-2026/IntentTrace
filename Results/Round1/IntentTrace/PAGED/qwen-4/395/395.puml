@startuml
!theme plain
|a_default| Default
|a_default|
start
:check referee reports status;
:are referee reports completed?;
:v1: are referee reports completed? ({Referee Reports not completed, Referee Reports completed}); <<objectSignal>>
if () then ([v1 = 'Referee Reports not completed'])
:flag and send reminder;
-> Referee Reports still not completed;
:After that;
-> Referee Reports still not completed after second check;
:check again if referee reports are completed;
:v2: are referee reports completed after reminder? ({Referee Reports still not completed, Referee Reports completed}); <<objectSignal>>
if () then ([v2 = 'Referee Reports still not completed'])
:flag and send another reminder;
else ([v2 = 'Referee Reports completed'])
->;
endif
else ([v1 = 'Referee Reports completed'])
->;
endif
:proceed with process;
:organize interviews for selection panel with top candidates;
:receive feedback from interview candidates;
:is psychometric test required?;
:v3: is psychometric test required? ({Psychometric Test not required, HR Specialist not required, HR Specialist required}); <<objectSignal>>
switch ()
case ([v3 = 'HR Specialist not required'])
:coordinate second round of selection;
-> Finalize process;
case ([v3 = 'HR Specialist required'])
:schedule psychometric test with third party;
-> Finalize process;
case ([v3 = 'Psychometric Test not required'])
:complete psychometric test;
-> Finalize process;
endswitch
:request final candidate ranking and continue process;
stop
@enduml