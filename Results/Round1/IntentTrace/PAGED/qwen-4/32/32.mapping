    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is not approved"
      ],
      "justification": "Matches the negative condition for the second branch looping back."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
