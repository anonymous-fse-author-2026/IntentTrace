      "verbatim_texts": [
        "To start the process, begin by adding the image description and uploading the image."
      ],
      "justification": "The opening clause implicitly initiates the process and directly describes the first action step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the message \"Image upload successful\" appears, then the process will end."
      ],
      "justification": "Describes the decision point for upload status, the positive guard condition, the corresponding termination action, and the structural end node."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the message indicates an unsuccessful upload, then try again."
      ],
      "justification": "Maps the negative outcome guard to the failure condition and captures the retry prompt/action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the option to try again is selected, the process will continue."
      ],
      "justification": "Captures the second decision point, the affirmative guard for retrying, and the convergence node that loops the flow back."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the option to try again is not selected, then an error will occur and the process will end."
      ],
      "justification": "Maps the negative retry guard to the error action and the final structural end node."
    }
