  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we receive the contract for the marketing campaign."
      ],
      "justification": "The opening clause establishes the process start and describes the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once we have the contract, we take it to the department."
      ],
      "justification": "Direct paraphrase of the second step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "In the next step, we input the customer's details into NKE."
      ],
      "justification": "Exact match for the data entry step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the customer's details are missing",
        "However, if the customer's details are ready"
      ],
      "justification": "The conditional clauses imply the XOR decision point."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "customer's details are ready"
      ],
      "justification": "Models the readiness check as an action step, faithfully reflecting the source condition."
    },
