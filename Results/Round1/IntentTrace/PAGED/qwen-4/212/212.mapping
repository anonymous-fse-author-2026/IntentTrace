      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "customer's details are missing"
      ],
      "justification": "Guard evaluates to 'No' for readiness, correctly mapping to the missing details condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "we contact the customers."
      ],
      "justification": "Direct match for the contact action on the missing-details path."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "customer's details are ready"
      ],
      "justification": "Guard evaluates to 'Ready', matching the positive condition."
    },
    {
      "refs": [
