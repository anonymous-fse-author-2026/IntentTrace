        "label:n6->c1"
      ],
      "verbatim_texts": [
        "After contacting the customers, we receive additional customer details."
      ],
      "justification": "Action captures receiving details, while the label reflects the temporal transition."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "we create a suitable team.",
        "Then, we create the team"
      ],
      "justification": "Both the ready path and the post-contact path merge before executing the team creation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "we create a suitable team."
      ],
      "justification": "Direct match for the team creation action."
    },
    {
