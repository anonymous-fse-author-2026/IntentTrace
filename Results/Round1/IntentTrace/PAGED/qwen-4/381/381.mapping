{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin with"
      ],
      "justification": "Implicit process start signal and explicit start action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "you should choose your destination and calculate the distance"
      ],
      "justification": "Direct correspondence to the initial planning step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "While doing so, continue to check if you need to book a train or a flight."
      ],
      "justification": "Describes the verification step and implies the XOR decision point."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the answer is \"no\", then proceed to book a train."
      ],
      "justification": "Guard captures the negative condition (v1=false) and action matches booking a train."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the answer is \"yes\", then book a flight."
      ],
      "justification": "Guard captures the positive condition (v1=true) and action matches booking a flight."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours, the process will end."
      ],
      "justification": "Covers the train-path time-bound check, branch, positive guard, result state, and termination."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours, the process will end."
      ],
      "justification": "Covers the identical time-bound check and termination on the flight path."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "Otherwise, if 24 hours have passed, you should call a travel agency."
      ],
      "justification": "Timeout/negative condition and subsequent agency contact for the train path."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Otherwise, if 24 hours have passed, you should call a travel agency."
      ],
      "justification": "Identical timeout condition and action for the flight path."
    },
    {
      "refs": [
        "guard:b4->n9",
        "action:n9",
        "action:n13"
      ],
      "verbatim_texts": [
        "If a code is available, the process will end along with the hotel reservation."
      ],
      "justification": "Secondary code availability decision and its terminating outcomes for both paths."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "On the other hand, if a code is not available, you should cancel your journey."
      ],
      "justification": "Negative code availability guard (v4=false) leads directly to journey cancellation."
    },
    {
      "refs": [
        "end:e5"
      ],
      "verbatim_texts": [
        "In that case, the process will end as well."
      ],
      "justification": "Structural end node capturing the final termination clause."
    }
  ],
