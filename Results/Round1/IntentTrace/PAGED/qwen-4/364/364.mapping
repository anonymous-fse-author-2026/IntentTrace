{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "At the start, we receive a form."
      ],
      "justification": "The opening phrase establishes the process initiation and directly describes the form receipt action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After receiving the form, we check if it is complete."
      ],
      "justification": "Directly maps to the completeness verification step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If it needs to be sent back, the process ends."
      ],
      "justification": "Captures the exclusive branch condition, the resulting termination action, and the corresponding end node."
    },
    {
      "refs": [
        "guard:b1->b_and",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if we need to check the income, we continue with the process."
      ],
      "justification": "Aligns with the alternative branch condition and the subsequent income check action."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "At the same time, we complete the following steps: checking deductibles and checking the house."
      ],
      "justification": "The concurrency cue triggers the AND gateway, while the listed tasks match the parallel actions."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Then, we make a decision."
      ],
      "justification": "Implies the rejoining of parallel paths and directly states the next decision step."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If we need to check the declaration, the process ends."
      ],
      "justification": "Maps the second exclusive branch condition, its associated action, and the terminal node."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "Otherwise, if we need to invite the declarant, the process also ends."
      ],
      "justification": "Covers the final exclusive condition, the invitation action, and the concluding end node."
    }
  ],
