{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "Opening clause implicitly starts the process (init) and explicitly describes the first two sequential actions."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Conditional phrase opens the XOR branch; guard captures the negative eligibility state; action matches informing the customer."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Guard captures the positive eligibility condition; action faithfully restates opening the ERP order."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Explicitly terminates the ineligible path, covering both the terminal action and the end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "perform an availability check."
      ],
      "justification": "Direct paraphrase of the availability verification step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\"."
      ],
      "justification": "Question/setup phrase implicitly defines the exclusive decision point."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "Guard captures unavailability; action matches initiating production."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process."
      ],
      "justification": "Guard captures availability; action reflects proceeding down the main path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Parallel/decision branches rejoin (converge) before the explicit preparation step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "ship the products and send the invoice"
      ],
      "justification": "Directly maps to the two distinct shipping and invoicing tasks."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "checking for payment."
      ],
      "justification": "Matches the payment verification step preceding the decision branch."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the payment is received"
      ],
      "justification": "Conditional phrase initiates the payment outcome decision point."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Guard aligns with receipt status; action matches closing the order."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Guard aligns with non-receipt; action matches dispatching the reminder."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Action represents counting reminders; branch models the loop condition; guard captures the '<3' threshold; action matches looping back."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Guard covers the max-threshold case (normalized to >=3 as the logical complement of <3); action matches notifying legal counsel; end node matches process closure."
    },
    {
      "refs": [
        "converge:c_loop"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "Implicit rejoin point where concurrent/shipping/invoicing/payment paths merge before downstream steps."
    }
  ],
