      ],
      "verbatim_texts": [
        "To begin the process in the Admin Office, first check if it has started."
      ],
      "justification": "The opening clause implicitly triggers the process start (init), describes the location/initiation step (n1), and specifies the initial status verification (n2)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "verify the completeness of the invoices"
      ],
      "justification": "Directly corresponds to the verification step."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If they are marked as \"Uncompleted\", they should be returned to the client through postal mail."
      ],
      "justification": "Captures the conditional check (modeled as action n5 and branch b2), the exact guard value (n6 guard), and the resulting return action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "However, if they are marked as \"Completed\", the process should be continued."
      ],
      "justification": "Guard matches the positive condition value, and converge implicitly represents the flow rejoining after continuation."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "receive the completed ones"
      ],
      "justification": "Direct match for the receipt step after return."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "mark the relevant box on the invoice entry form"
      ],
      "justification": "Exact correspondence to the documentation step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "checking if the process has been completed"
      ],
      "justification": "Action models the evaluation step, and branch captures the resulting decision gateway."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Both outcome paths (completed/not completed) correctly route to termination actions and end nodes, faithfully reflecting the closing statement."
    }
  ],
