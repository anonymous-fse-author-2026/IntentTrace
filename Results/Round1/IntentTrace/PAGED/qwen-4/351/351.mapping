{
  "matches": [
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Positive guard condition and its corresponding discussion action match the source text exactly."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Negative guard outcome and continuation action align with the otherwise clause."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Direct mapping to the second XOR decision point."
    },
    {
      "refs": [
        "guard:b2->b3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits."
      ],
      "justification": "Positive guard transitions directly to the limit-check branch as described."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Matches the negative outcome path for the modification check."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "Guard captures the 'not within limits' condition leading to the relay action."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process."
      ],
      "justification": "Guard captures the 'within limits' condition leading to the continuation action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Exact match to the subsequent combined action step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Direct paraphrase of the approval-seeking step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Exact wording match for the modification step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Exact wording match for the HR notification step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Exact wording match for the document scanning/uploading step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Exact wording match for the formal offer step."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Direct mapping to the acceptability decision node."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they are, continue with the process."
      ],
      "justification": "Positive guard and continuation action match the acceptable changes path."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If not, select a new applicant from the list."
      ],
      "justification": "Negative guard and selection action match the unacceptable changes path."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Direct mapping to the first client acceptance decision node."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Positive guard leads to the termination action and corresponding end node."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Negative guard and selection action match the rejection path."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Direct mapping to the repeated client acceptance decision node."
    },
    {
      "refs": [
        "guard:b6->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Positive guard leads to the termination action and remaining end nodes for the duplicated clause."
    },
    {
      "refs": [
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Negative guard and selection action match the final rejection path."
    }
  ],
