    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "the first step is to identify the parts."
      ],
      "justification": "Implicit process initiation paired with the explicitly stated first action."
    },
    {
      "refs": [
        "guard:b1->n3",
        "label:n2->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer"
      ],
      "justification": "The conditional clause triggers the XOR split, defines the path guard, provides the edge label, and specifies the elicitation action."
    },
    {
      "refs": [
        "label:n3->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "they should then check the availability of the parts."
      ],
      "justification": "Direct mapping to the transition label and the checking action."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if they already have the availability information, they can proceed with the process."
      ],
      "justification": "Represents the first alternative branch condition that bypasses intermediate steps."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer, the team can also continue with the process."
      ],
      "justification": "Represents the second alternative branch condition that similarly bypasses intermediate steps."
    },
    {
      "refs": [
        "label:n4->c1"
      ],
      "verbatim_texts": [
        "proceed with the process."
      ],
      "justification": "Marks the point where bypassed paths rejoin the main workflow, with the label indicating completion of the routing/check phase."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if they need to record the customer's details"
      ],
      "justification": "Conditional path leading to the recording details action."
    },
    {
      "refs": [
        "action:n6",
        "label:n6->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "they should order and receive the part from Disuki."
      ],
      "justification": "Compound source action accurately decomposed into order step, transition label, and receive step."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "The temporal receipt condition and subsequent action are accurately captured as consecutive steps."
    },
    {
      "refs": [
        "action:n10",
        "label:n10->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected, the team can proceed with the payment."
      ],
      "justification": "Temporal prerequisite and subsequent action correctly captured as collection step, transition label, and payment action."
    },
    {
      "refs": [
        "label:n11->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "Transition label, explicit end action, and structural end node all derive from this closing statement."
    }
