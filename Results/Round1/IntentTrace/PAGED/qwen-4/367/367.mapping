{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "The opening clause implicitly triggers the start node and directly describes initiating the cycle and checking inventory levels."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
      ],
      "justification": "Captures the conditional check, the XOR branch gateway, the 'BelowOrEqual' guard value, and the corresponding report generation action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Captures the alternative guard condition ('Above') and the matching report generation action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "Directly aligns with the instruction to create purchase orders when inventory falls at or below the threshold."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Matches the termination action and implies the end node for this exclusive path."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Accurately models the rejection branch, the 'Rejected' guard, and the subsequent rework action."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Captures the 'Approved' guard condition and the exact print-and-release action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Directly corresponds to the mandatory review step after PO creation."
    },
    {
      "refs": [
        "action:n12",
        "action:n18"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "The term 'Simultaneously' signals an AND parallel split. The actions correctly capture funding reservation and mailing POs."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Directly matches the packing slip receipt step contingent on fund reservation."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Directly matches receiving inventory upon mailing the POs."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Directly corresponds to the sequential invoice receipt step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Directly matches the secondary packing slip receipt step tied to inventory arrival."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Implies convergence of the parallel documentation paths before executing the three-way match action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Core meaning preserved; the successful match condition transitions directly into releasing funds."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment. After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Covers issuing payment and explicitly marks the final completion and end of the process."
    }
  ],
