@startuml
!theme plain
|a_default| Default
|a_default|
start
:make appointment at hairdresser's;
:go to hairdresser;
:v1: need hair washed? ({Yes, No})
v2: want hair dyed? ({Yes, No})
v3: need haircut? ({Yes, No}); <<objectSignal>>
switch ()
case ([v1 = 'Yes'])
:wash hair;
case ([v2 = 'Yes'])
:dye hair;
case ([v3 = 'Yes'])
:cut hair;
case ([v1 = 'No'])
endswitch
:pay hairdresser;
:end process;
stop
@enduml