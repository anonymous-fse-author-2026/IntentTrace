{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "The opening phrase implies process initiation and defines the initial registration step."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request."
      ],
      "justification": "Describes the fee evaluation, implies the XOR decision and negative guard, and specifies the immediate action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "Defines the alternative positive branch condition and its corresponding action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Explicitly states the termination point for the fee-free path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Describes the approval verification step and implies the subsequent decision gateway."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Captures the approval condition and the notification delivery step."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Captures the rejection condition and the corresponding notification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Directly describes the follow-up registration action after receiving approval."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Specifies the final termination step following a rejection notification."
    }
  ],
