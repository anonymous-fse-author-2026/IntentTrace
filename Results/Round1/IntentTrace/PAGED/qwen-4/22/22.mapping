      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, the order is registered and evaluated."
      ],
      "justification": "Direct mapping to the sequential registration and evaluation steps."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the evaluation result is \"NOK\""
      ],
      "justification": "Captures the first XOR decision point and its corresponding negative guard condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then the order is considered as \"NOK\" and the process comes to an end."
      ],
      "justification": "Matches the failure handling action and the immediate process termination."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if the evaluation result is \"ok\""
      ],
      "justification": "Captures the positive branch condition leading to installation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then the installation process takes place."
      ],
      "justification": "Direct paraphrase of the installation execution step."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the installation is not successful"
      ],
      "justification": "Captures the second decision point and the failure condition guard."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the order is considered as \"NOK\" and the process ends."
      ],
      "justification": "Matches the second failure outcome and process termination."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "However, if the installation is successful"
      ],
      "justification": "Captures the success condition guarding the path toward verification and billing."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the next step is to check the installation."
      ],
      "justification": "Direct mapping to the post-installation verification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the installation is verified, the billing is prepared."
      ],
      "justification": "Maps to the billing preparation step triggered after verification."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Finally, if everything is in order, the order is marked as \"ok\" and the process is completed."
      ],
      "justification": "Matches the final status update action and the conclusive process end."
    }
