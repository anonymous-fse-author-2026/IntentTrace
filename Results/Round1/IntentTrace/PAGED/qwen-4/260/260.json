  "input_elements": [
    {
      "id": "i1",
      "content": "For SSP, the process begins by receiving the invoice."
    },
    {
      "id": "i2",
      "content": "After receiving the invoice, it is sorted per client."
    },
    {
      "id": "i3",
      "content": "Once sorted per client, it is then sorted per vendor."
    },
    {
      "id": "i4",
      "content": "The next step is to attach the invoice entry form to the invoice."
    },
    {
      "id": "i5",
      "content": "After attaching the form, the required information is entered onto the form."
    },
    {
      "id": "i6",
      "content": "Following that, the completeness of the invoice is checked."
    },
    {
      "id": "i7",
      "content": "If the invoice is not complete, the process ends."
    },
    {
      "id": "i8",
      "content": "If it is complete, the information for the SLA is entered. The date for completion is also entered and the priority is checked."
    },
    {
      "id": "i9",
      "content": "priority is checked"
    },
    {
      "id": "i10",
      "content": "If the priority is high, a red stamp is placed on the entry invoice."
    },
    {
      "id": "i11",
      "content": "If it is low, the process continues."
    },
    {
      "id": "i12",
      "content": "The invoice compliance is then checked."
    },
    {
      "id": "i13",
      "content": "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
    },
    {
      "id": "i14",
      "content": "If it is a normal case, the client is called."
    },
    {
      "id": "i15",
      "content": "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
    },
    {
      "id": "i16",
      "content": "Finally, the client is called and information is requested."
    },
    {
      "id": "i17",
      "content": "The invoice is then batched and allocated to DEO, and the process ends."
    }
  ]
