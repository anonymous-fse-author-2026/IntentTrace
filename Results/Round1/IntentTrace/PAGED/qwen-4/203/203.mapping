        "guard:b2->n6",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the funds are disbursed, the process ends."
      ],
      "justification": "Covers the sequential fund disbursement step, the routing guard, the final termination action, and the second structural end node."
    }
