init(i1)
action(n1, "start the process")
action(n2, "claim what is requested")
action(n3, "check insured status of claimant")
branch(b1, XOR)
action(n5, "evaluate the claim")
action(n6, "reject the claim")
action(n7, "notify the claimant")
end(e1)
branch(b2, XOR)
action(n10, "send simple claim forms")
action(n11, "send complex claim forms")
action(n12, "receive returned forms")
action(n13, "check forms for completeness")
branch(b3, XOR)
action(n15, "register the claim")
action(n16, "inform claimant to complete details")
end(e2)
end(e3)
converge(c1)
defines(v1, "is claimant insured?", {"Yes", "No"})
defines(v2, "is claim simple or complex?", {"simple", "complex"})
defines(v3, "are all relevant details provided?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n5, n6, n7, e1, b2, n10, n11, n12, n13, b3, n15, n16, e2, e3, c1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(b1, n6)
precedence(n6, n7)
precedence(n7, e1)
precedence(n5, b2)
precedence(b2, n10)
precedence(b2, n11)
precedence(n10, c1)
precedence(n11, c1)
precedence(c1, n12)
precedence(n12, n13)
precedence(n13, b3)
precedence(b3, n15)
precedence(b3, n16)
precedence(n15, e2)
precedence(n16, e3)
guard(b1, n5, v1 = 'Yes')
guard(b1, n6, v1 = 'No')
guard(b2, n10, v2 = 'simple')
guard(b2, n11, v2 = 'complex')
guard(b3, n15, v3 = 'Yes')
guard(b3, n16, v3 = 'No')