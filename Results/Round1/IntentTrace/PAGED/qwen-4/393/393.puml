@startuml
!theme plain
|a1| Process Participant
|a1|
start
:advise unsuccessful candidates;
:v1: more candidates ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'No'])
:re-advertise position;
else ([v1 = 'Yes'])
:check if terms and conditions need to be sorted out;
:check if the candidate has accepted a voluntary redundancy;
:v2: voluntary redundancy accepted ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'No'])
:the process continues;
else ([v2 = 'Yes'])
:further investigation is required;
endif
:send Appointment Approval form;
:received by next level manager;
:v3: approver type ({External, Internal}); <<objectSignal>>
if () then ([v3 = 'External'])
:If the manager is an external resource;
:they may not authorize the form;
else ([v3 = 'Internal'])
:if the approver is an existing employee of the client;
:If the form is approved;
:which is received by the client HR;
endif
:scan and record form in GovSource;
:v4: variations present ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:create business case;
else ([v4 = 'No'])
:continue process;
endif
:v5: medical required ({Yes, No}); <<objectSignal>>
if () then ([v5 = 'Yes'])
:arrange and complete medical assessment (21 days);
else ([v5 = 'No'])
:medical assessment is not necessary;
endif
:inform recruitment manager and liaise with HR representative;
:v6: assessment satisfactory ({Yes, No}); <<objectSignal>>
if () then ([v6 = 'No'])
:contact next candidate on shortlist;
else ([v6 = 'Yes'])
:assessment is fine;
endif
:make formal verbal offer to candidate;
:v7: candidate accepts ({Yes, No}); <<objectSignal>>
if () then ([v7 = 'Yes'])
:create formal written offer;
else ([v7 = 'No'])
:process continues;
endif
:send commencement pack and letter of appointment;
:candidate receives documents;
:v8: 40% rate applicable ({Yes, No}); <<objectSignal>>
if () then ([v8 = 'Yes'])
:renegotiate terms;
:v9: renegotiation successful ({Yes, No}); <<objectSignal>>
if () then ([v9 = 'Yes'])
:continue process;
else ([v9 = 'No'])
:identify next candidate on shortlist;
endif
else ([v8 = 'No'])
:continue process;
endif
endif
stop
@enduml