init(i1)
converge(c2)
action(i2, "Once that is done, create a process model and check it")
branch(b2, XOR)
action(i3, "If the process model is 'NOT OK', then assign negative points")
action(i4, "If it is still 'NOT OK', assign negative points again")
action(i5, "However, if the process is okay, you can continue with it")
action(i6, "If there are any issues, fix them in the next session and extend the process to levels 2 and 3")
action(i7, "If you need to check the process and assign points, continue with the process")
action(i8, "If you need to analyze the field of study, assign roles in the team")
converge(c9)
action(i9, "If the process is okay, continue with the process and perform work according to your assigned role")
action(i10, "Check the progress and consult any problems that arise")
action(i11, "If the project is accepted, present it. If not, continue working according to your role")
branch(b11, XOR)
action(i12, "If the project is accepted, present it again. If not, continue working according to your role")
branch(b12, XOR)
action(i13, "Finally, present the project and the process will come to an end")
end(e1)

defines(v_model, "model status", {"OK", "NOT OK"})
defines(v_proj, "project status", {"Accepted", "Not Accepted"})

actor(a_team, "Team", [i1, c2, i2, b2, i3, i4, i5, i6, i7, i8, c9, i9, i10, i11, b11, i12, b12, i13, e1])

precedence(i1, c2)
precedence(i4, c2)
precedence(c2, i2)
precedence(i2, b2)
precedence(b2, i3)
precedence(b2, i5)
precedence(i3, i4)
precedence(i5, i6)
precedence(i6, i7)
precedence(i7, i8)
precedence(i8, c9)
precedence(b11, c9)
precedence(b12, c9)
precedence(c9, i9)
precedence(i9, i10)
precedence(i10, i11)
precedence(i11, b11)
precedence(b11, i12)
precedence(i12, b12)
precedence(b12, i13)
precedence(i13, e1)

guard(b2, i3, v_model = 'NOT OK')
guard(b2, i5, v_model = 'OK')
guard(b11, i12, v_proj = 'Accepted')
guard(b11, c9, v_proj = 'Not Accepted')
guard(b12, i13, v_proj = 'Accepted')
guard(b12, c9, v_proj = 'Not Accepted')