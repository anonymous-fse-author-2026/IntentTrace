{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "Captures the implicit start node, the initial 'start' action, and the customer check step from the opening sentence."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Maps the XOR decision point, the guard condition matching 'not eligible', and the corresponding inform action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Matches the alternative guard condition and the ERP order creation action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Directly corresponds to the termination step and end node following customer notification."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Open a new order in the ERP system and perform an availability check."
      ],
      "justification": "Aligns with the explicit instruction to perform the availability check."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\"."
      ],
      "justification": "Implicitly triggers the XOR branch for evaluating product availability."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "Guards the negative availability outcome ('not available') and maps to the production initiation action."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process. Prepare the products for shipment."
      ],
      "justification": "Covers the positive availability guard and the shipment preparation steps. Duplicate action nodes reflect source redundancy and are permitted."
    },
    {
      "refs": [
        "action:n_sim"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "The timing keyword 'Simultaneously' explicitly justifies the standalone action node and the AND gateways that split the flow into parallel paths."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "ship the products and send the invoice while checking for payment."
      ],
      "justification": "Directly maps to the three concurrent tasks listed in the source."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Captures the payment condition check (modeled as action n13), the branching logic, the positive guard, and the order closure action."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Matches the negative payment guard and the reminder sending action."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->c5",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Models the reminder count evaluation, the branch, the '<3' guard, the continuation action, and includes all converge nodes that structurally rejoin parallel or conditional flows at this point."
    },
    {
      "refs": [
        "guard:b4->c6",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Captures the '=3' guard condition, the lawyer notification/end action, and the terminal nodes signaling process completion."
    }
  ],
