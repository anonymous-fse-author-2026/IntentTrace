{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "The opening clause implicitly triggers the process start and directly describes the first action of sending the form."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Direct paraphrase capturing the receipt of approval."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Exact alignment with the stated coordination step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Maps to the verification step described after approval receipt."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized."
      ],
      "justification": "Captures the XOR split point, the conditional check modeled as an action step, the positive guard condition, and the corresponding authorization action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Captures the negative/complementary guard condition and the identical authorization outcome for the external path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Direct restatement of the documentation transfer step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Exact match for the scanning and system recording action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Faithfully restates the combined verification and forwarding step, consistent with source redundancy."
    },
    {
      "refs": [
        "action:n12",
        "action:n19"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Single span supports the HR reception action, the explicit process-end action, and the structural end node."
    },
    {
      "refs": [
        "action:n13",
        "guard:b2->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Groups the implied variation check, the XOR split, the false-no-variation guard, and the continue action."
    },
    {
      "refs": [
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed."
      ],
      "justification": "Maps the true-variation guard and the corresponding business case completion action."
    },
    {
      "refs": [
        "action:n16",
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Captures the second repeated conditional block, modeling the check as an action, the split, the false guard, and continuation."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed and attached."
      ],
      "justification": "Maps the true guard and the slightly elaborated 'completed and attached' action from the repeated source clause."
    }
  ],
