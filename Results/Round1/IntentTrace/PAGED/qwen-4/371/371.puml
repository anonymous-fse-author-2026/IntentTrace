@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start ExpenseReport process;
:click Start;
:select Edit Report;
:expense greater than 1000?;
:v1: expense ({[-]}); <<objectSignal>>
if () then ([v1 > 1000])
:review report;
else ([v1 <= 1000])
:translation required?;
:v3: translation required? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:translate receipts;
else ([v3 = 'No'])
:confirm receipts;
endif
endif
:evaluate review decision;
:v2: review decision ({Rejected, Approved}); <<objectSignal>>
if () then ([v2 = 'Rejected'])
:edit report;
stop
else ([v2 = 'Approved'])
:translation required?;
:v3: translation required? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:translate receipts;
else ([v3 = 'No'])
:confirm receipts;
endif
:Once again, evaluate the review decision;
:v4: evaluate review decision ({Rejected, Approved}); <<objectSignal>>
if () then ([v4 = 'Rejected'])
:edit report;
stop
else ([v4 = 'Approved'])
:evaluate receipts decision;
:v5: evaluate receipts decision ({Accepted, Rejected}); <<objectSignal>>
if () then ([v5 = 'Accepted'])
:process expense;
else ([v5 = 'Rejected'])
:edit report;
endif
stop
endif
endif
@enduml