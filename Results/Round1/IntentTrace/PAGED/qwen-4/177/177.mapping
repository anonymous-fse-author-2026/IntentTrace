  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process, make sure the Freights are ready to be shipped and then ship the freight."
      ],
      "justification": "The opening clause signals the process start and explicitly describes three sequential preparation and shipping actions."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: deliver the freight and notify the delivery."
      ],
      "justification": "The concurrency marker implies an AND split for parallel execution; lists two simultaneous actions; convergence is implied upon completion of parallel tasks."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->n7",
        "guard:b1->n16"
      ],
      "verbatim_texts": [
        "If the request for merchandise return is lodged, continue with the process."
      ],
      "justification": "The conditional check is modeled as an action and XOR branch; the guards represent the implicit yes/no routing to subsequent paths."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
        "guard:b2->n10",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it has been 5 days, invoice the customer."
      ],
      "justification": "Captures the time-based condition check, the decision branch, guards for both outcomes, and the resulting invoice action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Invoice the customer and the process ends with the customer being invoiced."
      ],
      "justification": "Explicitly states the invoice confirmation step and maps directly to the corresponding process end node."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "guard:b3->n14",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the return is accepted, proceed with accepting the merchandise return."
      ],
      "justification": "Covers the return status decision point, both outcome guards, and the initial acceptance action described in the clause."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Accept the merchandise return and proceed with returning the merchandise."
      ],
      "justification": "Describes the physical return execution step and the explicit process termination for the successful return path."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Return the merchandise and the process ends with the merchandise being returned."
      ],
      "justification": "Describes the physical return execution step and the explicit process termination for the successful return path."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the return is rejected, reject the merchandise return."
      ],
      "justification": "Confirms the rejection action and maps to its dedicated process end node."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Reject the merchandise return and the process ends with the merchandise return request being rejected."
      ],
      "justification": "Confirms the rejection action and maps to its dedicated process end node."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n17",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If a loss claim report is lodged, approve the loss claim and the process ends."
      ],
      "justification": "Captures the loss claim condition, branch, approval guard, approval action, and the stated process termination."
    }
  ],
