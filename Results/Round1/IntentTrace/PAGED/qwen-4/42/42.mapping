{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, you should choose your destination and calculate the distance."
      ],
      "justification": "The opening clause implies the process start and directly describes the first action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "While doing so, continue to check if you need to book a train or a flight."
      ],
      "justification": "Describes the preliminary check action and the implicit XOR branch for routing between transport modes."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the answer is \"no\", then proceed to book a train."
      ],
      "justification": "Guard captures the negative condition, action captures the corresponding booking step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if the answer is \"yes\", then book a flight."
      ],
      "justification": "Guard captures the positive condition, action captures the corresponding booking step."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours, the process will end."
      ],
      "justification": "Sets up the time-based condition, routes the positive outcome via the guard, executes the termination action, and reaches the end node."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, if 24 hours have passed, you should call a travel agency."
      ],
      "justification": "Negative/time-exceeded condition routes to the travel agency contact step."
    },
    {
      "refs": [
        "action:n10",
        "guard:b4->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If a code is available, the process will end along with the hotel reservation."
      ],
      "justification": "Second condition setup routes the positive outcome to termination with reservation details and the corresponding end node."
    },
    {
      "refs": [
        "guard:b4->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "if a code is not available, you should cancel your journey."
      ],
      "justification": "Negative code availability condition routes to the cancellation step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "In that case, the process will end as well."
      ],
      "justification": "Final termination statement covers the last path's end action and node."
    }
  ],
