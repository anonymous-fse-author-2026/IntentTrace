init(i1)
converge(c_loop)
action(n1, "start ExpenseReport process by clicking Start then selecting Edit Report")
branch(b1, XOR)
action(n3, "review the report")
action(n7, "evaluate the review decision")
branch(b3, XOR)
action(n9, "edit the report")
action(n11, "continue to check if there is a need for translation")
action(n12, "evaluate the review decision")
branch(b6, XOR)
action(n13, "edit the report")
action(n15, "translate the receipts")
action(n16, "confirm them")
action(n4, "check if there is a need for translation")
branch(b2, XOR)
action(n5, "translate the receipts")
action(n6, "confirm the receipts")
converge(c_rec)
action(n17, "evaluate the receipts decision")
branch(b9, XOR)
action(n19, "process the expense")
action(n21, "ending it")
end(e1)
action(n20, "edit the report")

defines(v_exp, "expense", {"> 1000", "<= 1000"})
defines(v_rev1, "first review decision", {"approved", "rejected"})
defines(v_rev2, "second review decision", {"approved", "rejected"})
defines(v_trans, "translation need", {"required", "not required"})
defines(v_rec, "receipts decision", {"accepted", "rejected"})

actor(a_default, "Default", [i1, c_loop, n1, b1, n3, n7, b3, n9, n11, n12, b6, n13, n15, n16, n4, b2, n5, n6, c_rec, n17, b9, n19, n21, e1, n20])

precedence(i1, c_loop)
precedence(n9, c_loop)
precedence(n13, c_loop)
precedence(n20, c_loop)
precedence(c_loop, n1)
precedence(n1, b1)

precedence(b1, n3)
guard(b1, n3, v_exp == "> 1000")
precedence(b1, n4)
guard(b1, n4, v_exp == "<= 1000")

precedence(n3, n7)
precedence(n7, b3)

precedence(b3, n9)
guard(b3, n9, v_rev1 == "rejected")
precedence(b3, n11)
guard(b3, n11, v_rev1 == "approved")

precedence(n11, n12)
precedence(n12, b6)

precedence(b6, n13)
guard(b6, n13, v_rev2 == "rejected")
precedence(b6, n15)
guard(b6, n15, v_rev2 == "approved")

precedence(n15, n16)
precedence(n16, c_rec)

precedence(n4, b2)
precedence(b2, n5)
guard(b2, n5, v_trans == "required")
precedence(b2, n6)
guard(b2, n6, v_trans == "not required")

precedence(n5, c_rec)
precedence(n6, c_rec)

precedence(c_rec, n17)
precedence(n17, b9)

precedence(b9, n19)
guard(b9, n19, v_rec == "accepted")
precedence(b9, n20)
guard(b9, n20, v_rec == "rejected")

precedence(n19, n21)
precedence(n21, e1)