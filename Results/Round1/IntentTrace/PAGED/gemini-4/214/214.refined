action(n17, "are there no additional samples?")
branch(b6, XOR)
action(n14, "end: no additional samples")
end(e1)
action(n15, "end: process completed")
end(e2)

defines(v1, "can we capture data from FMA?", {"Yes", "No"})
defines(v2, "can we capture data from Jamendo?", {"Yes", "No"})
