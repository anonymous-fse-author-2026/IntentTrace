init(i1)
action(n1, "start")
action(n2, "send: Course Packet Information Received")
action(n3, "send: Design to Faculty")
converge(c1)
action(n4, "choose: Faculty chooses the design")
action(n5, "identify: Content requiring copyright clearance")
action(n6, "contact: Contact publisher for clearance")
action(n7, "is copyright cleared?")
branch(b1, XOR)
action(n8, "notify: Contact Faculty to inform of denial and ask if new content should be added")
action(n9, "calculate: Calculate the Course Packet Cost")
action(n10, "add: Add Bookstore margin to determine retail price")
action(n11, "is price finalized?")
branch(b2, XOR)
action(n12, "reconsider: Re-evaluate content after reconsideration")
action(n13, "notify: notify the Bookstore of the Course packet, Course number, Faculty name, and sections")
action(n15, "notify: the Packet information should be notified to the Bookstore")
action(n14, "end")
end(e1)
defines(v1, "is copyright cleared?", {"Yes", "No"})
defines(v2, "is price finalized?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, c1, n4, n5, n6, n7, b1, n8, n9, n10, n11, b2, n12, n13, n15, n14, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, c1)
precedence(n8, c1)
precedence(n12, c1)
precedence(c1, n4)
precedence(n4, n5)
precedence(n5, n6)
precedence(n6, n7)
precedence(n7, b1)
precedence(b1, n8)
precedence(b1, n9)
precedence(n9, n10)
precedence(n10, n11)
precedence(n11, b2)
precedence(b2, n12)
precedence(b2, n13)
precedence(n13, n15)
precedence(n15, n14)
precedence(n14, e1)
guard(b1, n8, v1=="No")
guard(b1, n9, v1=="Yes")
guard(b2, n12, v2=="No")
guard(b2, n13, v2=="Yes")