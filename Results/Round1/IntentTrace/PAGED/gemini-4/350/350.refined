init(i1)
action(n1, "start the flickr login process")
converge(c1)
action(n2, "provide userdata for flickr")
action(n3, "is the login successful")
branch(b1, XOR)
action(n4, "end process successful login")
end(e1)
action(n5, "do you want to try again")
branch(b2, XOR)
action(n6, "provide userdata for flickr again after first failure")
action(n7, "abort process after first failure")
action(i6, "if you choose to abort,")
end(e2)
action(n10, "do you want to try again after second failure")
branch(b4, XOR)
action(n11, "provide userdata for flickr again after second failure")
action(n12, "abort process after second failure")
action(i8, "if you decide to abort,")
end(e4)

defines(v1, "is the login successful", {"Yes", "No"})
defines(v2, "do you want to try again", {"Yes", "No", "Retry"})
defines(v4, "do you want to try again after second failure", {"Yes", "No"})

actor(a_default, "Default", [i1, n1, c1, n2, n3, b1, n4, e1, n5, b2, n6, n7, i6, e2, n10, b4, n11, n12, i8, e4])

precedence(i1, n1)
precedence(n1, c1)
precedence(n6, c1)
precedence(n11, c1)
precedence(c1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(n4, e1)
precedence(b1, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n7)
precedence(n7, i6)
precedence(i6, e2)
precedence(b2, n10)
precedence(n10, b4)
precedence(b4, n11)
precedence(b4, n12)
precedence(n12, i8)
precedence(i8, e4)

guard(b1, n4, v1 = 'Yes')
guard(b1, n5, v1 = 'No')
guard(b2, n6, v2 = 'Yes')
guard(b2, n7, v2 = 'No')
guard(b2, n10, v2 = 'Retry')
guard(b4, n11, v4 = 'Yes')
guard(b4, n12, v4 = 'No')