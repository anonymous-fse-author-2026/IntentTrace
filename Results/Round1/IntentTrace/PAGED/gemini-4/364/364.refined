init(start)
action(n2, "receive form")
action(n3, "check if form is complete")
branch(b1, XOR)
action(n4, "end process: form needs to be sent back")
end(e1)
action(n5, "check income")
branch(b3, AND)
action(n6, "check deductibles")
action(n7, "check house")
converge(c1)
action(n8, "make decision")
branch(b2, XOR)
action(n9, "end process: check declaration")
end(e2)
action(n10, "invite declarant")
end(e3)
defines(v1, "check if form is complete", {"send back", "check income"})
defines(v2, "make decision", {"check declaration", "invite declarant"})
actor(a_default, "Default", [start, n2, n3, b1, n4, e1, n5, b3, n6, n7, c1, n8, b2, n9, e2, n10, e3])
precedence(start, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, e1)
precedence(n5, b3)
precedence(b3, n6)
precedence(b3, n7)
precedence(n6, c1)
precedence(n7, c1)
precedence(c1, n8)
precedence(n8, b2)
precedence(b2, n9)
precedence(b2, n10)
precedence(n9, e2)
precedence(n10, e3)
guard(b1, n4, v1=="send back")
guard(b1, n5, v1=="check income")
guard(b2, n9, v2=="check declaration")
guard(b2, n10, v2=="invite declarant")