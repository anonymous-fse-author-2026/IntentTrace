init(i1)
action(n1, "For TS recruitment, the first step is")
action(n2, "advise unsuccessful candidates")
branch(b1, XOR)
action(n3, "If there are \"no more candidates\"")
action(n4, "the position should be re-advertised")
action(n5, "if the terms and conditions of the offer for a candidate need to be sorted out")
action(n6, "check if the candidate has accepted a voluntary redundancy")
branch(b3, XOR)
action(n7, "if the candidate has accepted")
action(n8, "further investigation is required")
action(n9, "If the candidate has not accepted")
action(n10, "the process continues")
converge(c1)
action(n11, "The recruitment manager sends an Appointment Approval form")
action(n12, "which is then received by the next level manager")
branch(b4, XOR)
action(n13, "If the manager is an external resource")
action(n14, "they may not authorize the form")
action(n15, "if the approver is an existing employee of the client")
action(n16, "If the form is approved")
action(n17, "the recruitment manager sends the form and other documentation")
action(n18, "which is received by the client HR")
action(n19, "The HR department scans the completed form and records the position against the stored position in GovSource.")
branch(b6, XOR)
action(n20, "If there are any variations")
action(n21, "a complete business case is required")
action(n22, "Otherwise, the process continues")
converge(c2)
action(n23, "The Appointment Approval is carried forward.")
branch(b7, XOR)
action(n24, "If the position requires a medical assessment")
action(n25, "it is applicable for a 12% rate")
action(n26, "Otherwise, a medical assessment is not necessary.")
converge(c3)
action(n27, "take up to 21 days to arrange and complete")
action(n28, "The TS HR coordinator informs the recruitment manager")
action(n29, "who then liaises with the HR representative to confirm the offer to the candidate")
branch(b8, XOR)
action(n30, "If the assessment is not satisfactory")
action(n31, "the next candidate on the shortlist should be contacted")
action(n32, "if the assessment is fine, the process continues. The recruitment manager makes a formal verbal offer of employment to the candidate.")
branch(b12, AND)
branch(b9, XOR)
action(n33, "If the candidate accepts")
action(n34, "creates a formal written offer")
action(n35, "If the candidate declines, the process continues.")
action(n36, "Simultaneously")
action(n37, "the commencement pack and letter of appointment are sent to the candidate")
action(n38, "Once the candidate receives these documents")
converge(c4)
branch(b10, XOR)
action(n39, "if there is a \"40%\" rate")
action(n40, "renegotiation is required")
action(n41, "Otherwise, if the candidate accepts, the process continues.")
action(n42, "If the renegotiation is successful")
branch(b11, XOR)
action(n43, "If the renegotiation is successful, the process continues.")
action(n44, "if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified")
converge(c_end)
action(n45, "Finally, the process ends.")
end(e1)
end(e2)
end(e3)
end(e4)

defines(v1, "v1", {"no more", "terms"})
