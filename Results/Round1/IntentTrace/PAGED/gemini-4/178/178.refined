end(e1)
converge(c1)
converge(c2)
defines(v1, "answer is no", {"Yes", "No"})
defines(v2, "second answer is no", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, b2, n5, n6, n7, n8, n9, e1, c1, c2])
precedence(i1, n1)
precedence(n1, b1)
