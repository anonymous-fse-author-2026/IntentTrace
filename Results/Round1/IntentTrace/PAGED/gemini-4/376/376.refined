init(i1)
action(n1, "Start process for flickr login")
action(n2, "Provide userdata for flickr login")
action(n_cont, "Continue with the process")
branch(b1, XOR)
action(n4, "End process after successful login")
end(e1)
action(n5, "Choose to try login again")
branch(b2, XOR)
action(n6, "Provide userdata for flickr login")
action(n7, "Choose to abort after retry option")
action(n8, "End process after abort")
end(e2)
defines(v1, "Login result", {"Successful", "Fails"})
defines(v2, "Retry choice", {"Try again", "Abort"})
actor(a_default, "Default", [i1, n1, n2, n_cont, b1, n4, e1, n5, b2, n6, n7, n8, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n_cont)
precedence(n_cont, n5)
precedence(n5, b2)
precedence(n4, e1)
precedence(b2, n6)
precedence(n6, b2)
precedence(b2, n7)
precedence(n7, n8)
precedence(n8, e2)
guard(b1, n4, v1 == 'Successful')
guard(b1, n_cont, v1 == 'Fails')
guard(b2, n6, v2 == 'Try again')
guard(b2, n7, v2 == 'Abort')