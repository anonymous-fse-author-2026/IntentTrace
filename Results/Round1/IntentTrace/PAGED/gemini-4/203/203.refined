init(i1)
action(n1, "Start the loan process")
action(n2, "Check loan application")
branch(b1, XOR)
action(n4, "Process ends")
end(e1)
action(n9, "The process continues")
action(n6, "Disburse funds")
action(n7, "Process ends")
end(e2)
defines(v1, "Application status", {"Application rejected", "Special terms agreed upon"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, e1, n9, n6, n7, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(n4, e1)
precedence(b1, n9)
precedence(n9, n6)
precedence(n6, n7)
precedence(n7, e2)
guard(b1, n4, v1 = 'Application rejected')
guard(b1, n9, v1 = 'Special terms agreed upon')