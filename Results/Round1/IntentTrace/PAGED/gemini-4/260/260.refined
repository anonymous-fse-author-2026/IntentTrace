init(i1)
action(n1, "start")
action(n2, "receive invoice")
action(n3, "sort per client")
action(n4, "sort per vendor")
action(n5, "attach entry form to invoice")
action(n6, "enter required information onto form")
action(n7, "check completeness of invoice")
branch(b1, XOR)
action(n8, "end process: incomplete invoice")
end(e1)
action(n9, "enter sla information date and check priority")
action(n10, "check priority level")
branch(b2, XOR)
action(n11, "place red stamp on entry invoice")
converge(c1)
action(n12, "check compliance status")
branch(b3, XOR)
branch(b4, XOR)
action(n13, "process non-compliance invoice for experienced staff")
action(n14, "call client")
action(n18, "call client and request information")
action(n15, "send postal mail requesting complete information")
action(n19, "end process")
end(e2)
converge(c2)
action(n16, "batch and allocate to deo")
end(e3)

defines(v1, "check completeness of invoice", {"complete", "incomplete"})
defines(v2, "check priority level", {"high", "low"})
defines(v3, "check compliance status", {"complete", "incomplete"})
defines(v4, "case type", {"experienced staff", "normal case", "none"})

actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, n6, n7, b1, n8, e1, n9, n10, b2, n11, c1, n12, b3, b4, n13, n14, n18, n15, n19, e2, c2, n16, e3])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, n5)
precedence(n5, n6)
precedence(n6, n7)
precedence(n7, b1)
precedence(b1, n8)
precedence(b1, n9)
precedence(n8, e1)
precedence(n9, n10)
precedence(n10, b2)
precedence(b2, n11)
precedence(b2, c1)
precedence(n11, c1)
precedence(c1, n12)
precedence(n12, b3)
precedence(b3, c2)
precedence(b3, b4)
precedence(b4, n13)
precedence(b4, n14)
precedence(b4, n15)
precedence(n13, c2)
precedence(n14, n18)
precedence(n18, c2)
precedence(n15, n19)
precedence(n19, e2)
precedence(c2, n16)
precedence(n16, e3)

guard(b1, n9, v1 == "complete")
guard(b1, n8, v1 == "incomplete")
guard(b2, n11, v2 == "high")
guard(b2, c1, v2 == "low")
guard(b3, c2, v3 == "complete")
guard(b3, b4, v3 == "incomplete")
guard(b4, n13, v4 == "experienced staff")
guard(b4, n14, v4 == "normal case")
guard(b4, n15, v4 == "none")