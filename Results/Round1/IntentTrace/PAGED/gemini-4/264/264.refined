init(i1)
action(n1, "Initially, the appointment approval form is sent.")
action(n2, "the approval is received.")
branch(b6, XOR)
action(n3, "there is a contact with TS to clarify the timing.")
action(n4, "it is checked.")
branch(b1, XOR)
action(n6, "the appointment is authorized.")
action(n7, "the appointment is also authorized.")
branch(b_var, XOR)
action(n15_new, "the process continues.")
action(n17_new, "a business case is completed.")
action(n18_new, "a business case is completed and attached.")
converge(c1)
action(n8, "the mandatory documentation along with the approval is sent to HR services.")
action(n9, "The form is then scanned and recorded into the GovSource system.")
action(n10, "The approval is checked")
action(n11, "sent along with the mandatory documentation to HR services.")
action(n12, "HR services receive the documentations")
action(n13_new, "this marks the end of the process.")
end(e1)

defines(v_path, "Path after approval", {"TS", "check", "variations"})
defines(v1, "Resource type", {"internal", "external"})
defines(v2, "Variations", {"yes", "no"})

actor(a_default, "Default", [i1, n1, n2, b6, n3, n4, b1, n6, n7, b_var, n15_new, n17_new, n18_new, c1, n8, n9, n10, n11, n12, n13_new, e1])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b6)
precedence(b6, n3)
precedence(b6, n4)
precedence(b6, b_var)
precedence(n3, c1)
precedence(n4, b1)
precedence(b1, n6)
precedence(b1, n7)
precedence(n6, c1)
precedence(n7, c1)
precedence(b_var, n15_new)
precedence(b_var, n17_new)
precedence(n15_new, c1)
precedence(n17_new, n18_new)
precedence(n18_new, c1)
precedence(c1, n8)
precedence(n8, n9)
precedence(n9, n10)
precedence(n10, n11)
precedence(n11, n12)
precedence(n12, n13_new)
precedence(n13_new, e1)

guard(b6, n3, v_path == "TS")
guard(b6, n4, v_path == "check")
guard(b6, b_var, v_path == "variations")
guard(b1, n6, v1 == "internal")
guard(b1, n7, v1 == "external")
guard(b_var, n15_new, v2 == "no")
guard(b_var, n17_new, v2 == "yes")