init(i1)
action(n1, "Start Expense Report process by receiving the expense report")
action(n2, "Verify the account")
action(n3, "Review the report")
branch(b1, XOR)
action(n5, "Process the reimbursement")
action(n6, "Proceed with the payment")
action(n7, "End process after payment")
end(e1)
action(n8, "Send Expense Rejection Notification")
action(n9, "End process after rejection notification")
end(e2)
defines(v1, "Is the report accepted", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n5, n6, n7, e1, n8, n9, e2])
precedence(i1, n1)
precedence(n7, e1)
precedence(n9, e2)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, n7)
precedence(b1, n8)
precedence(n8, n9)
guard(b1, n5, v1 == "Yes")
guard(b1, n8, v1 == "No")