init(i1)
action(n1, "start")
action(n2, "Check if process has started in Admin Office")
action(n3, "Proceed to verify completeness of invoices")
branch(b1, XOR)
action(n5, "Return uncompleted invoices to client via postal mail")
action(n6, "Receive completed invoices from client")
action(n7, "Mark relevant box on invoice entry form")
action(n_cont, "the process should be continued")
converge(c1)
action(n8, "Check if process has been completed")
branch(b2, XOR)
action(n9, "End")
action(n10, "Proceed to verify completeness of invoices")
end(e2)
defines(v1, "Completeness of invoices", {"Uncompleted", "Completed"})
defines(v2, "Check if process has been completed", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n5, n6, n7, n_cont, c1, n8, b2, n9, n10, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, n7)
precedence(n7, c1)
precedence(b1, n_cont)
precedence(n_cont, c1)
precedence(c1, n8)
precedence(n8, b2)
precedence(b2, n9)
precedence(n9, e2)
precedence(b2, n10)
precedence(n10, e2)
guard(b1, n5, v1 == "Uncompleted")
guard(b1, n_cont, v1 == "Completed")
guard(b2, n9, v2 == "Yes")
guard(b2, n10, v2 == "No")