init(i1)
action(n1, "Start process")
action(n2, "Items returned by customer or picked up by delivery crew")
action(n3, "Count and compare items to contract")
branch(b2, XOR)
action(i7, "Order is complete and all items were returned")
branch(b3, XOR)
action(i24, "Items are packed for an existing order")
action(i25, "Items are stored for future orders")
converge(c_end2)
action(n15, "End process")
end(e2)
action(n6, "Email customer missing items and replacement charges")
branch(b4, XOR)
action(n7, "Customer returns missing items")
action(i17, "Customer does not return the missing items")
converge(c_end1)
action(n8, "End process")
end(e1)
action(n9, "Email customer damage and additional charges")
action(n10, "Temporarily remove damaged items from inventory")
branch(b5, XOR)
action(n12, "Repair items and add to inventory")
branch(b6, XOR)
action(i24_r, "Items are packed for an existing order")
action(i25_r, "Items are stored for future orders")
action(n13, "Discard items and email customer replacement charges")
converge(c_end3)
action(n16, "End process")
end(e3)

defines(v2, "Order status after count", {"All items returned", "Items missing", "Items damaged"})
defines(v3, "Items disposition for returned items", {"Packed", "Stored"})
defines(v4, "Customer returns missing items", {"Returned", "Not returned"})
defines(v5, "Can damaged items be repaired", {"Can be repaired", "Cannot be repaired"})
defines(v6, "Items disposition after repair", {"Packed", "Stored"})

actor(a_default, "Default", [i1, n1, n2, n3, b2, i7, b3, i24, i25, c_end2, n15, e2, n6, b4, n7, i17, c_end1, n8, e1, n9, n10, b5, n12, b6, i24_r, i25_r, n13, c_end3, n16, e3])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b2)
precedence(b2, i7)
precedence(b2, n6)
precedence(b2, n9)
precedence(i7, b3)
precedence(b3, i24)
precedence(b3, i25)
precedence(i24, c_end2)
precedence(i25, c_end2)
precedence(c_end2, n15)
precedence(n15, e2)
precedence(n6, b4)
precedence(b4, n7)
precedence(b4, i17)
precedence(n7, c_end1)
precedence(i17, c_end1)
precedence(c_end1, n8)
precedence(n8, e1)
