precedence(b6, i25_r)
precedence(i24_r, c_end3)
precedence(i25_r, c_end3)
precedence(n13, c_end3)
precedence(c_end3, n16)
precedence(n16, e3)

guard(b2, i7, v2 = 'All items returned')
guard(b2, n6, v2 = 'Items missing')
guard(b2, n9, v2 = 'Items damaged')
guard(b3, i24, v3 = 'Packed')
guard(b3, i25, v3 = 'Stored')
guard(b4, n7, v4 = 'Returned')
guard(b4, i17, v4 = 'Not returned')
guard(b5, n12, v5 = 'Can be repaired')
guard(b5, n13, v5 = 'Cannot be repaired')
guard(b6, i24_r, v6 = 'Packed')
guard(b6, i25_r, v6 = 'Stored')