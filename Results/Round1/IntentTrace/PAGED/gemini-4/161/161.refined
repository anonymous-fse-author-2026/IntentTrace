init(i1)
action(i2, "join the team and agree on the team's domain")
converge(c_i3)
action(i3, "create a process model and check it")
branch(b1, XOR)
action(i4, "If the process model is \"NOT OK\"")
action(i5, "assign negative points")
action(i6, "If it is still \"NOT OK\"")
action(i7, "assign negative points again")
action(i8, "if the process is okay")
action(i12, "continue with the process")
action(i9, "If there are any issues")
action(i10, "fix them in the next session and extend the process to levels 2 and 3")
action(i11, "If you need to check the process and assign points")
action(i13, "If you need to analyze the field of study")
action(i14, "assign roles in the team")
action(i15, "continue with the process and perform work according to your assigned role")
converge(c_i16)
action(i16, "Check the progress and consult any problems that arise")
branch(b2, XOR)
action(i17, "If the project is accepted")
branch(b3, XOR)
action(i18, "present it")
action(i21, "present it again")
action(i19, "If not")
action(i20, "continue working according to your role")
converge(c_i22)
action(i22, "Finally, present the project and the process will come to an end")
end(e1)
defines(v1, "Model status", {"NOT OK", "okay"})
defines(v2, "Project status", {"accepted", "not"})
defines(v3, "Presentation", {"first", "again"})
actor(a1, "Default", [i1, i2, c_i3, i3, b1, i4, i5, i6, i7, i8, i12, i9, i10, i11, i13, i14, i15, c_i16, i16, b2, i17, b3, i18, i21, i19, i20, c_i22, i22, e1])
precedence(i1, i2)
precedence(i2, c_i3)
