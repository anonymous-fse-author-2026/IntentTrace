init(start_node)
action(n1, "start procedure")
action(n2, "choose a book")
action(n4, "view: book details")
action(n5, "do you want to select a copy or view new copies?")
branch(b1, XOR)
action(n6, "select a copy")
action(n7, "end procedure")
end(e1)
action(n8, "view: new copies")
action(n9, "view: used copies")
action(n10, "evaluate and select a copy from the list")
action(n11, "end procedure")
end(e2)
converge(c2)
converge(c3)
branch(b2, XOR)
defines(v1, "do you want to select a copy or view new copies?", {"Select", "New"})
defines(v2, "book choice", {"Details", "New", "Used"})
actor(a_default, "Default", [start_node, n1, n2, n4, n5, b1, n6, n7, e1, n8, n9, n10, n11, e2, c2, c3, b2])
precedence(start_node, n1)
precedence(n1, n2)
precedence(n2, b2)
precedence(b2, n4)
precedence(b2, c2)
precedence(b2, n9)
precedence(n4, n5)
precedence(n5, b1)
precedence(b1, c2)
precedence(b1, c3)
precedence(c2, n8)
precedence(n8, c3)
precedence(c3, n6)
precedence(n6, n7)
precedence(n7, e1)
precedence(n9, n10)
precedence(n10, n11)
precedence(n11, e2)
guard(b1, c3, v1=="Select")
guard(b1, c2, v1=="New")
guard(b2, n4, v2=="Details")
guard(b2, c2, v2=="New")
guard(b2, n9, v2=="Used")