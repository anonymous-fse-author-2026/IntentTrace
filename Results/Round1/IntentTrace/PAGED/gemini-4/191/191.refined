init(i1)
action(n1, "start registration for event participation")
action(n2, "check if there is a fee")
branch(b1, XOR)
action(n3, "register a post-seminar request")
action(n4, "create a purchase request")
converge(c2)
action(n5, "End process after post-seminar request registration")
end(e1)
action(n6, "check if purchase request is approved")
branch(b2, XOR)
action(n7, "receive an approved notification")
action(n8, "receive a rejection notification")
action(n9, "register a post-seminar request after approval")
end(e3)
defines(v1, "check if there is a fee", {"Yes", "No"})
defines(v2, "check if purchase request is approved", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, c2, n5, e1, n6, b2, n7, n8, n9, e3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n4, n6)
precedence(n6, b2)
precedence(b2, n7)
precedence(b2, n8)
precedence(n7, n9)
precedence(n3, c2)
precedence(n9, c2)
precedence(c2, n5)
precedence(n5, e1)
precedence(n8, e3)
guard(b1, n3, v1 == "No")
guard(b1, n4, v1 == "Yes")
guard(b2, n7, v2 == "Yes")
guard(b2, n8, v2 == "No")