init(i1)
action(n1, "start WIGGO process")
action(n2, "Place Order")
action(n3, "Check Customers Credit Limit")
action(n4, "Credit Limit Okay")
branch(b1, XOR)
action(n5, "Send Denial To Customer")
action(n6, "Check Availability Of Article")
action(n_i9, "After checking the availability, if the response is \"Okay\", proceed to Check the Availability of the Article again. If the response is \"No\", send a Denial to the Customer.")
branch(b2, XOR)
action(n8, "Produce the Goods")
action(n9, "Collect the Goods")
action(n10, "Send Order Confirmation")
action(n11, "Ship the Goods")
action(n12, "Send Invoice")
action(n13, "Check Payment Status")
branch(b3, XOR)
action(n15, "Close the Order")
action(n16, "End")
end(e1)
end(e_denial)
action(n17, "Reminder Count Ge 3")
branch(b4, XOR)
action(n18, "Write Off the Order")
action(n20, "Send Reminder")
action(n21, "Close the Order")
action(n22, "End")
end(e3)
converge(c1)
converge(c2)
converge(c3)
converge(c4)
branch(b5, AND)
defines(v1, "Credit Limit Okay", {"Okay", "No"})
defines(v2, "Article Available", {"No", "not available", "available"})
defines(v3, "Payment Received", {"received", "not received"})
defines(v4, "Reminder Count Ge 3", {[0-]})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, c3, n5, e_denial, n6, n_i9, b2, n8, n9, c1, n10, b5, n11, n12, c2, c4, n13, b3, n15, n16, e1, n17, b4, n18, n20, n21, n22, e3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, c3)
precedence(n4, n6)
precedence(n6, n_i9)
precedence(n_i9, b2)
precedence(b2, c3)
precedence(b2, n8)
precedence(b2, n9)
precedence(c3, n5)
precedence(n5, e_denial)
precedence(n8, c1)
precedence(n9, c1)
precedence(c1, n10)
precedence(n10, b5)
precedence(b5, n11)
precedence(b5, n12)
precedence(n11, c2)
precedence(n12, c2)
precedence(c2, c4)
precedence(n20, c4)
precedence(c4, n13)
precedence(n13, b3)
precedence(b3, n15)
precedence(b3, n17)
precedence(n15, n16)
precedence(n16, e1)
precedence(n17, b4)
precedence(b4, n18)
precedence(b4, n20)
precedence(n18, n21)
precedence(n21, n22)
precedence(n22, e3)
guard(b1, n4, v1 = 'Okay')
guard(b1, c3, v1 = 'No')
guard(b2, c3, v2 = 'No')
guard(b2, n8, v2 = 'not available')
guard(b2, n9, v2 = 'available')
guard(b3, n15, v3 = 'received')
guard(b3, n17, v3 = 'not received')
guard(b4, n18, v4 >= 3)
guard(b4, n20, v4 < 3)