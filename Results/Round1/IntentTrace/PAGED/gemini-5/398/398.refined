action(n14, "Alternatively, if you decide to abort")
defines(v1, "is login successful", {"Yes", "No"})
defines(v2, "do you want to try again", {"Yes", "No", "Still", "Alt"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, e1, n5, b2, n6, e2, n10, n9, n11, e3, n14])
precedence(i1, n1)
precedence(n1, n2)
