init(i1)
branch(b_and, AND)
action(n2, "Check if Referee Reports have been completed")
action(n2_mon, "monitor if the Referee Reports have been completed")
converge(c_and)
branch(b1, XOR)
action(n3, "Flag and send reminder")
converge(c_loop)
action(n4, "Re-check Referee Reports status")
branch(b_loop, XOR)
action(n15, "flag it again and send another reminder")
converge(c1)
action(n5, "Proceed with organizing interviews")
action(n6, "Organize interviews for Selection Panel")
action(n7, "Receive feedback from interview candidates")
action(n8, "Check if Psychometric Test is required")
branch(b2, XOR)
action(n9, "Coordinate second round of selection")
action(n10, "Check if HR Specialist is required")
branch(b3, XOR)
action(n11, "Schedule Psychometric Test with third party")
action(n12, "Proceed to complete Psychometric Test")
converge(c2)
action(n13, "Request final candidate ranking and continue process")
end(e1)

defines(v1, "Check if Referee Reports have been completed", {"No", "Yes"})
defines(v2, "Check if Psychometric Test is required", {"No", "Yes"})
defines(v3, "Check if HR Specialist is required", {"Yes", "No"})

actor(a_default, "Default", [i1, b_and, n2, n2_mon, c_and, b1, n3, c_loop, n4, b_loop, n15, c1, n5, n6, n7, n8, b2, n9, n10, b3, n11, n12, c2, n13, e1])

precedence(i1, b_and)
precedence(b_and, n2)
precedence(b_and, n2_mon)
precedence(n2, c_and)
precedence(n2_mon, c_and)
precedence(c_and, b1)
precedence(b1, n3)
precedence(b1, c1)
precedence(n3, c_loop)
precedence(n15, c_loop)
precedence(c_loop, n4)
precedence(n4, b_loop)
precedence(b_loop, c1)
precedence(b_loop, n15)
precedence(c1, n5)
precedence(n5, n6)
precedence(n6, n7)
precedence(n7, n8)
precedence(n8, b2)
precedence(b2, n9)
precedence(b2, n10)
precedence(n10, b3)
precedence(b3, n11)
precedence(b3, n12)
precedence(n9, c2)
precedence(n11, c2)
precedence(n12, c2)
precedence(c2, n13)
precedence(n13, e1)

guard(b1, n3, v1 = 'No')
guard(b1, c1, v1 = 'Yes')
guard(b_loop, n15, v1 = 'No')
guard(b_loop, c1, v1 = 'Yes')
guard(b2, n9, v2 = 'No')
guard(b2, n10, v2 = 'Yes')
guard(b3, n11, v3 = 'Yes')
guard(b3, n12, v3 = 'No')