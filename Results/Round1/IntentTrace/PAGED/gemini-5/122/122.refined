init(i1)
action(n1, "start")
converge(c1)
action(n2, "Is input a URN or URL?")
branch(b1, XOR)
action(n3, "Resolve URN to domain-name")
action(n4, "Send DNS query")
action(n6, "The result of this query is a list of URLs")
action(n5, "Link to designated DS and end")
end(e1)
action(n7, "After this, we again check if the input is a URN or a URL")
defines(v1, "Is input a URN or URL?", {"URN", "URL"})
actor(a_default, "Default", [i1, n1, c1, n2, b1, n3, n4, n6, n5, e1, n7])
precedence(i1, n1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, b1)
precedence(b1, n3)
guard(b1, n3, v1=="URN")
precedence(n3, n4)
precedence(n4, n6)
precedence(n6, n5)
precedence(n5, e1)
precedence(b1, n7)
guard(b1, n7, v1=="URL")
precedence(n7, c1)