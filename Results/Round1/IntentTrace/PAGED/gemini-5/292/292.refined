init(i1)
action(n1, "start")
action(n2, "receive claim")
action(n3, "create and record claim")
action(n4, "decide on claim")
branch(b1, XOR)
action(n5, "reject claim")
action(n6, "review rejection")
branch(b2, XOR)
action(n16, "continue the process")
action(n17, "continue the process")
converge(c2)
action(n9, "accept claim")
action(n10, "offer benefit")
action(n11, "prepare discharge")
action(n12, "record payment")
converge(c1)
branch(b3, AND)
action(n7, "operate outgoing payment")
action(n8, "close the claim")
converge(c3)
action(n15, "end")
end(e1)
defines(v1, "decide on claim", {"rejected", "accepted"})
defines(v2, "claim rejection", {"accepted", "not accepted"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, n6, b2, n16, n17, c2, n9, n10, n11, n12, c1, b3, n7, n8, c3, n15, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, b2)
precedence(b2, n16)
precedence(b2, n17)
precedence(n16, c2)
precedence(n17, c2)
precedence(c2, c1)
precedence(b1, n9)
precedence(n9, n10)
precedence(n10, n11)
precedence(n11, n12)
precedence(n12, c1)
precedence(c1, b3)
precedence(b3, n7)
precedence(b3, n8)
precedence(n7, c3)
precedence(n8, c3)
precedence(c3, n15)
precedence(n15, e1)
guard(b1, n5, v1 = 'rejected')
guard(b1, n9, v1 = 'accepted')
guard(b2, n16, v2 = 'accepted')
guard(b2, n17, v2 = 'not accepted')