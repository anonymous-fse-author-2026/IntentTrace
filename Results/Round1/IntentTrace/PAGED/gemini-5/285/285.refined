init(i1)
action(n1, "Emergency Determined")
action(n2, "Measuring Severity")
action(n3, "Quick Payment")
action(n4, "Approval of operation")
action(n5, "Standard Process")
action(n6, "You have completed this procedure")
end(e1)
converge(c1)
branch(b1, XOR)
defines(v1, "Choice", {"Quick Payment", "Approval"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, n6, e1, c1, b1])
precedence(i1, n1)
precedence(n6, e1)
precedence(c1, n5)
precedence(n2, b1)
precedence(n1, n2)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, c1)
precedence(n5, n6)
guard(b1, n3, v1 = "Quick Payment")
guard(b1, n4, v1 = "Approval")
label(b1, n3, "Quick Payment chosen")
label(b1, n4, "Approval chosen")
label(n3, c1, "Process continued")
label(n4, c1, "Process continued")