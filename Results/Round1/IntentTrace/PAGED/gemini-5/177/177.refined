init(i1)
action(n1, "To start the process")
action(n2, "make sure the Freights are ready to be shipped")
action(n3, "ship the freight")
action(n_i4, "At the same time")
branch(b5, AND)
action(n4, "deliver the freight")
action(n5, "notify the delivery")
converge(c1)
branch(b1, XOR)
action(n7, "If it has been 5 days")
action(n8, "invoice the customer")
action(n9, "and the process ends with the customer being invoiced")
end(e1)
action(n16, "If a loss claim report is lodged")
action(n17, "approve the loss claim")
action(n19, "and the process ends")
end(e4)
action(n6, "If the request for merchandise return is lodged")
branch(b3, XOR)
action(n10, "If the return is accepted")
action(n11, "Accept the merchandise return")
action(n12, "Return the merchandise")
action(n13, "and the process ends with the merchandise being returned")
end(e2)
action(n14, "If the return is rejected")
action(n15, "and the process ends with the merchandise return request being rejected")
end(e3)
defines(v1, "Next step condition", {"5 days", "loss claim", "return lodged"})
defines(v3, "Return status", {"accepted", "rejected"})
actor(a_default, "Default", [i1, n1, n2, n3, n_i4, b5, n4, n5, c1, b1, n7, n8, n9, e1, n16, n17, n19, e4, n6, b3, n10, n11, n12, n13, e2, n14, n15, e3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n_i4)
precedence(n_i4, b5)
precedence(b5, n4)
precedence(b5, n5)
precedence(n4, c1)
precedence(n5, c1)
precedence(c1, b1)
precedence(b1, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, e1)
precedence(b1, n16)
precedence(n16, n17)
precedence(n17, n19)
precedence(n19, e4)
precedence(b1, n6)
precedence(n6, b3)
precedence(b3, n10)
precedence(n10, n11)
precedence(n11, n12)
precedence(n12, n13)
precedence(n13, e2)
precedence(b3, n14)
precedence(n14, n15)
precedence(n15, e3)
guard(b1, n7, v1 = '5 days')
guard(b1, n16, v1 = 'loss claim')
guard(b1, n6, v1 = 'return lodged')
guard(b3, n10, v3 = 'accepted')
guard(b3, n14, v3 = 'rejected')