init(i1)
action(n2, "Identify parts")
branch(b1, XOR)
action(n4, "Check availability of parts")
action(n5, "Proceed with process")
converge(c1)
branch(b2, XOR)
action(n_continue, "Continue with the process")
action(n8, "Record customer details")
action(n9, "Order and receive part from Disuki")
action(n7, "Contract customer")
converge(c2)
action(n10, "Proceed with payment")
action(n11, "End")
end(e1)
defines(v1, "Information elicitation", {"Needs to elicit information from the customer", "Already have the availability information"})
defines(v2, "Parts supply", {"Parts are supplied to the customer", "Need to record the customer's details"})
actor(a_default, "Default", [i1, n2, b1, n4, n5, c1, b2, n_continue, n8, n9, n7, c2, n10, n11, e1])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, c1)
precedence(n5, c1)
precedence(c1, b2)
precedence(b2, n_continue)
precedence(b2, n8)
precedence(n_continue, c2)
precedence(n8, n9)
precedence(n9, n7)
precedence(n7, c2)
precedence(c2, n10)
precedence(n10, n11)
precedence(n11, e1)
guard(b1, n4, v1 = "Needs to elicit information from the customer")
guard(b1, n5, v1 = "Already have the availability information")
guard(b2, n_continue, v2 = "Parts are supplied to the customer")
guard(b2, n8, v2 = "Need to record the customer's details")