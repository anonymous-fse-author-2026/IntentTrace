init(i1)
action(i2, "Rental Items are Returned to the Store")
branch(b1, XOR)
action(i3, "If the \"Customer returns the items to the store,\"")
action(i4, "if the \"Delivery Crew picks-up items at the event site,\"")
converge(c1)
action(i5, "During this step, the items are counted and compared to the original contract.")
branch(b2, XOR)
action(i6, "If the \"Order is complete and all items were returned,\"")
branch(b3, XOR)
action(i9, "if the \"Items are packed for an existing order,\"")
action(i10, "if the \"Items are stored for future orders,\"")
converge(c2)
action(i7, "if the \"Order is incomplete and items are missing,\"")
action(i11, "In case of missing items and replacement charges, we email the customer to inform them.")
branch(b4, XOR)
action(i13, "If the \"Customer returns the missing items,\"")
action(i14, "if the \"Customer does not return the missing items,\"")
converge(c3)
converge(c4)
action(i15, "Finally, when the process is complete, it ends.")
end(e1)
action(i8, "if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges.")
action(i12, "if there are damaged items and additional charges, we temporarily take them out of inventory.")
branch(b5, XOR)
action(i16, "If the \"Items are repaired and added into inventory,\"")
branch(b6, XOR)
action(i19, "If the \"Items are packed for an existing order,\"")
action(i20, "If the \"Items are stored for future orders,\"")
converge(c5)
action(i21, "Once again, when the process is complete, it ends.")
end(e2)
action(i17, "if the \"Items can't be repaired and are discarded,\"")
action(i18, "we email the customer with replacement charges.")
action(i22, "and the process is complete.")
end(e3)

defines(v_return_method, "Return Method", {"Customer", "Delivery Crew"})
defines(v_order_status, "Order Status", {"Complete all returned", "Incomplete missing", "Complete damaged"})
defines(v_pack_store, "Pack or Store", {"Packed", "Stored"})
defines(v_missing_return, "Missing Return", {"Returned", "Not returned"})
defines(v_repair, "Repair Status", {"Repaired", "Discarded"})
defines(v_pack_store2, "Pack or Store 2", {"Packed", "Stored"})

actor(a_default, "Default", [i1, i2, b1, i3, i4, c1, i5, b2, i6, b3, i9, i10, c2, i7, i11, b4, i13, i14, c3, c4, i15, e1, i8, i12, b5, i16, b6, i19, i20, c5, i21, e2, i17, i18, i22, e3])

precedence(i1, i2)
precedence(i2, b1)
precedence(b1, i3)
precedence(b1, i4)
precedence(i3, c1)
precedence(i4, c1)
precedence(c1, i5)
precedence(i5, b2)
precedence(b2, i6)
precedence(b2, i7)
precedence(b2, i8)
precedence(i6, b3)
precedence(b3, i9)
precedence(b3, i10)
precedence(i9, c2)
precedence(i10, c2)
precedence(c2, c4)
precedence(i7, i11)
precedence(i11, b4)
precedence(b4, i13)
precedence(b4, i14)
precedence(i13, c3)
precedence(i14, c3)
precedence(c3, c4)
precedence(c4, i15)
precedence(i15, e1)
precedence(i8, i12)
precedence(i12, b5)
precedence(b5, i16)
precedence(b5, i17)
precedence(i16, b6)
precedence(b6, i19)
precedence(b6, i20)
precedence(i19, c5)
precedence(i20, c5)
precedence(c5, i21)
precedence(i21, e2)
precedence(i17, i18)
precedence(i18, i22)
precedence(i22, e3)

guard(b1, i3, v_return_method == "Customer")
guard(b1, i4, v_return_method == "Delivery Crew")
guard(b2, i6, v_order_status == "Complete all returned")
guard(b2, i7, v_order_status == "Incomplete missing")
guard(b2, i8, v_order_status == "Complete damaged")
guard(b3, i9, v_pack_store == "Packed")
guard(b3, i10, v_pack_store == "Stored")
guard(b4, i13, v_missing_return == "Returned")
guard(b4, i14, v_missing_return == "Not returned")
guard(b5, i16, v_repair == "Repaired")
guard(b5, i17, v_repair == "Discarded")
guard(b6, i19, v_pack_store2 == "Packed")
guard(b6, i20, v_pack_store2 == "Stored")