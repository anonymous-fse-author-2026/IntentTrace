init(i1)
action(n1, "start")
action(n2, "check inventory")
action(n3, "compare inventory levels in spreadsheet with sales")
branch(b1, XOR)
action(n5, "no need to manually count inventory")
converge(c1)
action(n7, "manually count inventory items")
action(n8, "make list of low stock items")
action(n9, "select suppliers and place orders")
action(n10, "receive order")
action(n11, "process ends")
end(e2)
defines(v1, "is inventory level high", {"High", "Low"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n5, c1, n7, n8, n9, n10, n11, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(b1, n7)
precedence(n5, c1)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, n10)
precedence(n10, c1)
precedence(c1, n11)
precedence(n11, e2)
guard(b1, n5, v1 = 'High')
guard(b1, n7, v1 = 'Low')