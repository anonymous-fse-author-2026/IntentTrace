init(i1)
action(n1, "start the process")
action(n2, "can we capture data from FMA?")
branch(b1, XOR)
action(n3, "we should continue the process")
action(n4, "can we capture data from Jamendo?")
branch(b2, XOR)
action(n5, "we should continue the process")
action(n6, "get: music ids for the genre")
branch(b3, XOR)
action(n8, "If the genre is missing")
action(n9, "if there are no additional genres")
action(n10, "if there are no additional genres, we should continue the process.")
action(n12, "If the sample is missing")
branch(b5, XOR)
action(n13, "We should download the sample.")
action(n14, "if there are no additional samples")
end(e1)
converge(c1)
defines(v1, "can we capture data from FMA?", {"Yes", "No"})
defines(v2, "can we capture data from Jamendo?", {"Yes", "No"})
defines(v3, "is the genre missing?", {"Yes", "No  check next"})
defines(v4, "is there an additional genre?", {"Yes", "No"})
defines(v5, "is the sample missing?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, b2, n5, n6, b3, n8, n9, n10, n12, b5, n13, n14, e1, c1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n4, b2)
precedence(b2, n5)
precedence(b2, c1)
precedence(n3, c1)
precedence(n5, c1)
precedence(c1, n6)
precedence(n6, b3)
precedence(b3, n8)
precedence(n8, n6)
precedence(b3, n9)
precedence(n9, n10)
precedence(n10, n12)
precedence(n12, b5)
precedence(b5, n13)
precedence(b5, n14)
precedence(n13, n14)
precedence(n14, e1)
guard(b1, n3, v1 = 'Yes')
guard(b1, n4, v1 = 'No')
guard(b2, n5, v2 = 'Yes')
guard(b2, c1, v2 = 'No')
guard(b3, n8, v3 = 'Yes')
guard(b3, n9, v3 = 'No  check next')
guard(b5, n13, v5 = 'Yes')
guard(b5, n14, v5 = 'No')