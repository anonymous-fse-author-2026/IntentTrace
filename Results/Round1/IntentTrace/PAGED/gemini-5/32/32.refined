init(i1)
action(n1, "start")
converge(c1)
action(n2, "Enter Expenses")
action(n3, "Generate Spreadsheet")
action(n4, "Approval Check 1")
branch(b1, XOR)
action(n5, "Payout")
action(n6, "Approval Check 2")
branch(b2, XOR)
action(n8, "Payout")
end(e1)
defines(v1, "Approval Check 1", {"Approved", "Not Approved"})
defines(v2, "Approval Check 2", {"Approved", "Not Approved"})
actor(a_default, "Default", [i1, n1, c1, n2, n3, n4, b1, n5, n6, b2, n8, e1])
precedence(i1, n1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, c1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, b2)
precedence(b2, c1)
precedence(b2, n8)
precedence(n8, e1)
guard(b1, c1, v1=="Not Approved")
guard(b1, n5, v1=="Approved")
guard(b2, c1, v2=="Not Approved")
guard(b2, n8, v2=="Approved")