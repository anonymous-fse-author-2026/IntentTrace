init(i1)
branch(b1, XOR)
action(n3, "proceed with the acquisition of the pricing")
action(n4, "continue with the process")
branch(b2, XOR)
action(n5, "acquire the pricing")
converge(c1)
action(n6, "margin calculation")
action(n7, "preparation of the offer")
action(n8, "the transport rate is calculated")
action(n9, "the process comes to an end")
end(e1)
defines(v1, "Is initial answer yes", {"yes", "no"})
defines(v2, "Is second answer yes", {"yes", "no"})
actor(a_default, "Default", [i1, b1, n3, n4, b2, n5, c1, n6, n7, n8, n9, e1])
precedence(i1, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, b2)
precedence(b2, n5)
precedence(b2, c1)
precedence(n5, c1)
precedence(c1, n6)
precedence(n6, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, e1)
guard(b1, n4, v1 == "yes")
guard(b1, n3, v1 == "no")
guard(b2, c1, v2 == "yes")
guard(b2, n5, v2 == "no")