init(i1)
action(i2, "Rental Items are Returned to the Store")
branch(b1, XOR)
action(i3, "If the 'Customer returns the items to the store,'")
action(i4, "if the 'Delivery Crew picks-up items at the event site,'")
action(i5, "Delivery Crew picks-up items at the event site")
converge(c_start)
action(i6, "the items are counted and compared to the original contract")
branch(b2, XOR)

action(i7, "If the 'Order is complete and all items were returned,'")
action(i8, "Order is complete and all items were returned")
branch(b3, XOR)
action(i14, "if the 'Items are packed for an existing order,'")
action(i15, "if the 'Items are stored for future orders,'")
action(i16, "Items are stored for future orders")

action(i9, "if the 'Order is incomplete and items are missing,'")
action(i10, "Order is incomplete and items are missing")
action(i17, "In case of missing items and replacement charges, we email the customer to inform them.")
branch(b4, XOR)
action(i19, "If the 'Customer returns the missing items,'")
action(i20, "if the 'Customer does not return the missing items,'")
action(i21, "Customer does not return the missing items")

action(i11, "if the 'Order is complete but items are damaged,'")
action(i12, "Order is complete but items are damaged")
action(i13, "we email the customer to inform them of the damage and additional charges")
action(i18, "temporarily take them out of inventory")
branch(b5, XOR)
action(i23, "If the 'Items are repaired and added into inventory,'")
action(i24, "Items are repaired and added into inventory")
branch(b6, XOR)
action(i28, "If the 'Items are packed for an existing order,'")
action(i29, "If the 'Items are stored for future orders,'")
converge(c6)
action(i30, "Once again, when the process is complete, it ends.")
end(e30)

action(i25, "if the 'Items can't be repaired and are discarded,'")
action(i26, "Items can't be repaired and are discarded")
action(i27, "Items can't be repaired and are discarded,\" we email the customer with replacement charges.")

converge(c_end)
action(i31, "The customer is then emailed with replacement charges")
action(i32, "and the process is complete.")
end(e32)

converge(c22)
action(i22, "when the process is complete, it ends")
end(e22)

