init(i1)
action(n1, "Start the loan process")
action(n2, "Check loan application")
branch(b1, XOR)
action(n3, "Application rejected")
action(n5, "Special terms agreed upon")
action(n9, "The process continues")
action(n6, "Disburse funds")
converge(c1)
action(n4, "Process ends")
end(e1)
defines(v1, "Application outcome", {"Rejected", "Special terms agreed upon"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n5, n9, n6, c1, n4, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(n3, c1)
precedence(b1, n5)
precedence(n5, n9)
precedence(n9, n6)
precedence(n6, c1)
precedence(c1, n4)
precedence(n4, e1)
guard(b1, n3, v1 = 'Rejected')
guard(b1, n5, v1 = 'Special terms agreed upon')