init(i1)
action(i2, "look at the order")
branch(b1, XOR)
action(i3, "If the order is to be rejected")
action(i4, "If the order is to be accepted")
action(i5, "At the same time")
branch(b2, AND)
action(i6, "preparing the assembling order")
converge(c2)
action(i7, "checking availability")
branch(b3, XOR)
action(i8, "If there is a backorder")
action(i9, "availability needs to be checked again")
branch(b4, XOR)
action(i10, "and the process ends")
action(i11, "If the item can be reserved")
converge(c1)
action(i12, "assemble the bike")
action(i13, "ship the product")
end(e1)
end(e2)
end(e3)
defines(v1, "order status", {"Accepted", "Rejected"})
defines(v2, "availability", {"Backorder", "Reserved"})
defines(v3, "check again", {"Loop", "End"})
actor(a_default, "Default", [i1, i2, b1, i3, i4, i5, b2, i6, c2, i7, b3, i8, i9, b4, i10, i11, c1, i12, i13, e1, e2, e3])
precedence(i1, i2)
precedence(i2, b1)
precedence(b1, i3)
precedence(i3, e1)
precedence(b1, i4)
precedence(i4, i5)
precedence(i5, b2)
precedence(b2, i6)
precedence(b2, c2)
precedence(c2, i7)
precedence(i7, b3)
precedence(b3, i8)
precedence(i8, i9)
precedence(i9, b4)
precedence(b4, c2)
precedence(b4, i10)
precedence(i10, e2)
precedence(b3, i11)
precedence(i6, c1)
precedence(i11, c1)
precedence(c1, i12)
precedence(i12, i13)
precedence(i13, e3)
guard(b1, i3, v1 = 'Rejected')
guard(b1, i4, v1 = 'Accepted')
guard(b3, i8, v2 = 'Backorder')
guard(b3, i11, v2 = 'Reserved')
guard(b4, c2, v3 = 'Loop')
guard(b4, i10, v3 = 'End')