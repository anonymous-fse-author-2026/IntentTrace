init(start)
action(i1, "In the beginning,")
branch(b1, XOR)
action(i3, "then we continue the process.")
branch(b2, XOR)
action(i4, "we continue the process.")
action(i7_2, "then we give it priority.")
action(i7_1, "then we give it priority.")
converge(c1)
action(i8, "we look up the Vendor on SAP.")
branch(b3, XOR)
action(i10, "then we need a Vendor master record")
action(i11, "and the process ends.")
end(e1)
action(i12, "then we enter the invoice in SAP.")
branch(b4, XOR)
action(i10_2, "then we need a Vendor master record")
action(i11_2, "and the process ends.")
end(e2)
action(i7_3, "then we give it priority.")
action(i12_2, "then we enter the invoice in SAP.")
action(i14, "Once the invoice is entered in SAP,")
action(i15, "we place the entered invoices in the normal Outbox")
end(e3)

defines(v1, "Answer1", {"No", "Yes"})
defines(v2, "Answer2", {"No", "Yes"})
defines(v3, "Vendor on SAP", {"No", "Yes"})
defines(v4, "Invoice entered", {"No", "Yes"})

actor(a1, "Participant", [start, i1, b1, i3, b2, i4, i7_2, i7_1, c1, i8, b3, i10, i11, e1, i12, b4, i10_2, i11_2, e2, i7_3, i12_2, i14, i15, e3])

precedence(start, i1)
precedence(i1, b1)
precedence(b1, i3)
precedence(i3, b2)
precedence(b2, i4)
precedence(b2, i7_2)
