branch(b1, XOR)
action(i3, "If the sum of the order is less than 500")
action(i5, "if the sum of the order is greater than 2000")
action(i7, "If the sum of the order falls between 1000 and 1500")
action(i9, "if the sum of the order falls between 500 and 999")
