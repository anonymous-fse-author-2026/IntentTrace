action(i12, "Once again, check the sum of the order")
action(i13, "If it is less than 500")
action(i4, "continue with the process")
action(i6, "compute a discount of 4%")
action(i8, "compute a discount of 3%")
action(i10, "compute a discount of 2%")
converge(c_i4)
converge(c_i6)
converge(c_all)
action(i14, "create the bill")
action(i15, "the process will come to an end")
end(e1)
defines(v_cond, "condition", {"c1", "c2", "c3", "c4", "c5", "c6"})
actor(a_default, "Default", [init1, i1, i2, b1, i3, i5, i7, i9, i11, i12, i13, i4, i6, i8, i10, c_i4, c_i6, c_all, i14, i15, e1])
precedence(init1, i1)
precedence(i1, i2)
