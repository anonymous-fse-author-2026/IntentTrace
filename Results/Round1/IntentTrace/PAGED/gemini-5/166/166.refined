init(i1)
action(n2, "assess potential for seizure")
action(n3, "assess potential for significant hemorrhage")
action(n4, "assess potential for acute respiratory distress")
action(n5, "administer midazolam 10 mg as needed")
action(n6, "end procedure")
end(e1)
converge(c1)
branch(b1, XOR)
defines(v_assessment, "assessment type", {"seizure", "hemorrhage", "respiratory distress"})
actor(a_default, "Default", [i1, n2, n3, n4, n5, n6, e1, c1, b1])
precedence(i1, b1)
precedence(n6, e1)
precedence(c1, n5)
precedence(b1, n2)
precedence(b1, n3)
precedence(b1, n4)
guard(b1, n2, v_assessment == "seizure")
guard(b1, n3, v_assessment == "hemorrhage")
guard(b1, n4, v_assessment == "respiratory distress")
precedence(n2, c1)
precedence(n3, c1)
precedence(n4, c1)
precedence(n5, n6)