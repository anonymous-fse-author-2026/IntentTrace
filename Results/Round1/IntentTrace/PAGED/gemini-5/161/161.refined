init(i1)
action(n1, "To start")
action(n2, "join the team and agree on the team's domain")
converge(c_loop)
action(n3, "create a process model and check it")
branch(b1, XOR)
action(n4, "If the process model is \"NOT OK\"")
action(n5, "assign negative points")
action(n6, "If it is still \"NOT OK\"")
action(n7, "assign negative points again")
action(n8, "if the process is okay, you can continue with it")
action(n9, "If there are any issues, fix them in the next session and extend the process to levels 2 and 3")
action(n10, "If you need to check the process and assign points, continue with the process. If you need to analyze the field of study")
action(n11, "continue with the process")
action(n12, "If you need to analyze the field of study, assign roles in the team")
converge(c1)
action(n13, "If the process is okay, continue with the process and perform work according to your assigned role")
converge(c2)
action(n14, "Check the progress and consult any problems that arise")
branch(b2, XOR)
action(n15, "If the project is accepted")
action(n16, "present it")
action(n17, "If not, continue working according to your role")
action(n18, "If not, continue working according to your role.")
action(n19, "If the project is accepted, present it again")
converge(c3)
action(n20, "Finally, present the project and the process will come to an end")
end(e1)
defines(v1, "b1_decision", {"NOT OK", "okay", "issues", "check", "analyze"})
defines(v2, "b2_decision", {"accepted", "not accepted", "not accepted 2", "accepted again"})
actor(a_default, "Default", [i1, n1, n2, c_loop, n3, b1, n4, n5, n6, n7, n8, n9, n10, n11, n12, c1, n13, c2, n14, b2, n15, n16, n17, n18, n19, c3, n20, e1])
precedence(i1, n1)
precedence(n1, n2)
