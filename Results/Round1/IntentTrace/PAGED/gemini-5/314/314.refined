init(i1)
action(n1, "Start")
action(n_identify, "identifying the vacancy")
action(n2, "Any candidates available?")
branch(b1, XOR)
action(n3, "Select Applicant")
action(n4, "Advertise Vacancy")
converge(c1)
action(n5, "After advertising  any candidates?")
branch(b2, XOR)
action(n6, "Advertise Again")
converge(c2)
action(n_appoint, "Once the candidate is appointed")
action(n8, "End")
end(e1)
defines(v1, "Any candidates available?", {"Yes", "No"})
defines(v2, "After advertising  any candidates?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n_identify, n2, b1, n3, n4, c1, n5, b2, n6, c2, n_appoint, n8, e1])
precedence(i1, n1)
precedence(n1, n_identify)
precedence(n_identify, n2)
precedence(n2, b1)
precedence(b1, c2)
precedence(b1, n4)
precedence(n4, c1)
precedence(c1, n5)
precedence(n5, b2)
precedence(b2, c2)
precedence(b2, n6)
precedence(n6, c1)
precedence(c2, n3)
precedence(n3, n_appoint)
precedence(n_appoint, n8)
precedence(n8, e1)
guard(b1, c2, v1=="Yes")
guard(b1, n4, v1=="No")
guard(b2, c2, v2=="Yes")
guard(b2, n6, v2=="No")