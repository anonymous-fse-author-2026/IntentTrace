init(i1)
action(n1, "start process for ACME Company")
action(n2, "receive customer request")
action(n3, "check current inventory level")
branch(b1, XOR)
action(n5, "accept customer request")
action(n6, "reject customer request")
action(n7, "the process ends")
end(e1)
action(n8, "create purchase order")
converge(c2)
action(n9, "review purchase order")
action(n10, "is purchase order approved?")
branch(b2, XOR)
action(n11, "reserve funds")
action(n12, "rework purchase order")
action(n13, "send purchase order")
action(n14, "receive packing slip")
action(n15, "receive invoice")
action(n16, "record packing slip")
action(n17, "record invoice")
converge(c1)
action(n18, "Release the reserved funds")
action(n20, "Finally, issue the payment")
branch(b3, AND)
defines(v1, "inventory level", {"at or below the minimum", "above the minimum"})
defines(v2, "purchase order status", {"approved", "rejected"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n5, n6, n7, e1, n8, c2, n9, n10, b2, n11, n12, n13, n14, n15, n16, n17, n18, n20, c1, b3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(b1, n6)
precedence(n6, n7)
precedence(n7, e1)
precedence(n5, n8)
precedence(n8, c2)
precedence(n12, c2)
precedence(c2, n9)
precedence(n9, n10)
precedence(n10, b2)
precedence(b2, n11)
precedence(b2, n12)
precedence(n11, n13)
precedence(n13, b3)
precedence(b3, n14)
precedence(b3, n15)
precedence(n14, n16)
precedence(n15, n17)
precedence(n16, c1)
precedence(n17, c1)
precedence(c1, n18)
precedence(n18, n20)
precedence(n20, e1)
guard(b1, n5, v1 = 'at or below the minimum')
guard(b1, n6, v1 = 'above the minimum')
guard(b2, n11, v2 = 'approved')
guard(b2, n12, v2 = 'rejected')