{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To start the process"
      ],
      "justification": "Directly corresponds to the explicit process initiation phrase."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "we first trigger the Resupply Cycle."
      ],
      "justification": "Faithfully reproduces the initial action step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, we check the inventory level."
      ],
      "justification": "Exact match for the inventory verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the inventory level is checked, we proceed to create a purchase order."
      ],
      "justification": "Directly maps to the purchase order creation action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the purchase order is not good, we reject it. However, if the purchase order is good, we approve it."
      ],
      "justification": "The XOR branch captures the decision split, and the action step faithfully restates the evaluation question posed by the conditional clause."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the purchase order is not good, we reject it."
      ],
      "justification": "The guard captures the negative condition threshold/state, and the action captures the corresponding rejection step."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "if the purchase order is good, we approve it."
      ],
      "justification": "The guard captures the positive condition, and the action captures the corresponding approval step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "In case the purchase order is rejected, we rework it."
      ],
      "justification": "Direct match for the rework action triggered by the rejection path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, we review it again."
      ],
      "justification": "Faithfully represents the mandatory review step following rework."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "if the purchase order is approved, we reserve funds for the purchase."
      ],
      "justification": "Maps directly to the fund reservation action on the approval branch."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, we send the purchase order to the supplier."
      ],
      "justification": "Direct match for transmitting the approved PO to the supplier."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "The concurrency keyword explicitly triggers an AND parallel split."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "receive the packing slip"
      ],
      "justification": "Exact match for the first parallel receipt task."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive the invoice"
      ],
      "justification": "Exact match for the second parallel receipt task."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After receiving the packing slip, we record it."
      ],
      "justification": "Directly maps to the packing slip documentation step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "after receiving the invoice, we record it as well."
      ],
      "justification": "Directly maps to the invoice documentation step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Next, we release funds for payment"
      ],
      "justification": "The parallel tracking branches implicitly rejoin (converge) before execution proceeds to the fund release action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "and issue the payment."
      ],
      "justification": "Exact match for the final financial execution step."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued."
      ],
      "justification": "Explicitly marks the process termination point."
