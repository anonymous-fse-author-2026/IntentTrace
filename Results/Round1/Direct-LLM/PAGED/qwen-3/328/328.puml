@startuml
!theme plain
|a_customer| Customer
|a_customer|
start
:Request information about organization;
:Schedule an appointment;
:v1: Is the customer in Intake stage? ({Intake, Potential client}); <<objectSignal>>
if () then ([v1 = "Potential client"])
stop
else ([v1 = "Intake"])
:Proceed with Control and measurement;
:Revisit after two weeks;
:v2: Has target been reached? ({Target reached, Dissatisfied}); <<objectSignal>>
if () then ([v2 = "Target reached"])
stop
else ([v2 = "Dissatisfied"])
stop
endif
endif
@enduml