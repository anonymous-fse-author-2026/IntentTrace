{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "Implicitly starts the process and covers the first two sequential actions: initiating the resupply cycle and checking inventory levels."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n5",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report. If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Models the XOR decision on inventory relative to the minimum, the condition-check action, boolean guards for true/false outcomes, and the respective report generation steps."
    },
    {
      "refs": [
        "action:n7",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs). If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Directly maps creating POs for low inventory and terminates the process for high inventory."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Faithfully restates the PO review requirement."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n10",
        "guard:b2->n11",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked. If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Captures the approval/rejection XOR split, the evaluation question, guards for each state, and the corresponding print/release or rework actions."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "it needs to be reworked."
      ],
      "justification": "Redundant fragment reinforcing the rework action on rejection."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "it is printed and released in the system."
      ],
      "justification": "Redundant fragment reinforcing the print/release action on approval."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "\"Simultaneously\" correctly triggers an AND gateway splitting into fund reservation and mailing actions."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive the Packing Slip."
      ],
      "justification": "Exact match for receiving the packing slip."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "receive the inventory."
      ],
      "justification": "Exact match for receiving the inventory."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "proceed to receive the Invoice."
      ],
      "justification": "Exact match for receiving the invoice."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Covers transitioning to and performing the three-way match as implied by the progression."
    },
    {
      "refs": [
        "guard:b4->n19",
        "guard:b4->e2"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful"
      ],
      "justification": "Models the XOR condition on match success and sets up boolean guards for routing."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "release the funds."
      ],
      "justification": "Directly implements fund release upon successful match."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment. After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Sequenced correctly: issues payment, marks cycle complete, and terminates the process."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b4->e2"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful"
      ],
      "reason": "The source only specifies behavior when the match is successful. Routing the unsuccessful path directly to process termination invents a fallback logic not stated in the text."
    }
  ],
