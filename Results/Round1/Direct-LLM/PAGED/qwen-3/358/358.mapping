        "action:n13"
      ],
      "verbatim_texts": [
        "If the answer is \"No\", then we need a Vendor master record and the process ends."
      ],
      "justification": "Guards, actions, end nodes, and branch collectively implement the negative outcome requiring a vendor master record and termination. Redundant implementations are treated as matches."
    },
    {
