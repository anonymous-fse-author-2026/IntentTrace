    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Faithfully restates scanning the form and recording it into the GovSource system."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Captures the sending step described alongside the check in this source unit."
    },
    {
