{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "i1: To begin the process, start by checking the customer's order."
      ],
      "justification": "Implicit process start and explicit order-checking steps directly align with the opening instruction."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "i2: If the customer is a registered customer, then check their payment morale."
      ],
      "justification": "Registration evaluation and positive guard correctly route to the payment morale review step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "i3: If they are a new customer, then check their status."
      ],
      "justification": "Negative registration guard routes to status check, matching the 'new customer' alternative clause."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "i4: If their payment morale is good, continue with the process."
      ],
      "justification": "Direct mapping of the good morale condition and subsequent continuation step."
    },
    {
      "refs": [
        "guard:b2->c1",
        "action:n7",
        "guard:b3->c1",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "i5: If their payment morale is bad or if they are an end customer, reject the order and end the process."
      ],
      "justification": "Accurately models the disjunction between bad morale and end-customer status, converging to order rejection and process termination."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "i7: enter their data and take the order."
      ],
      "justification": "Exact restatement of the data entry and order acceptance step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "i8: check the availability of the items."
      ],
      "justification": "Availability check and AND-split gateway capture the concurrent execution signaled by 'at the same time'."
    },
    {
      "refs": [
        "action:n13",
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "i9: If the items are out of stock, start production."
      ],
      "justification": "Out-of-stock condition correctly triggers the production start action."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "i10: If they are in stock, continue with the process."
      ],
      "justification": "In-stock guard and continuation action match the source exactly."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "i11: send the order confirmation."
      ],
      "justification": "Direct mapping of the post-availability confirmation step."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "i12: produce the article"
      ],
      "justification": "Production action and its paired confirmation restatement align with the production branch requirements."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "i13: send the invoice and deliver the product."
      ],
      "justification": "Combined invoice/delivery action and AND-split reflect the simultaneous execution requirement."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "i14: Check the payment status."
      ],
      "justification": "Phrased as a conditional check but preserves the exact instruction to verify payment status."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "i15: If payment is received, close the order."
      ],
      "justification": "Positive payment guard and order closure action faithfully reproduce the source clause."
    },
    {
      "refs": [
        "guard:b5->n22"
      ],
      "verbatim_texts": [
        "i16: If no payment is received, check the number of reminders."
      ],
      "justification": "The guard itself correctly captures the negative payment condition leading to the reminder pathway."
    },
    {
      "refs": [
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "i17: If there are more than three reminders, engage a lawyer."
      ],
      "justification": "Threshold guard and lawyer engagement action match the source precisely."
    },
    {
      "refs": [
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "i18: If there are three or fewer reminders, send a reminder."
      ],
      "justification": "Guard threshold and reminder action faithfully reproduce the fallback case."
    }
