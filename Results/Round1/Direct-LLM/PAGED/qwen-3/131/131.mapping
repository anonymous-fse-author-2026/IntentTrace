{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "The opening clause implicitly starts the process and explicitly describes the mailbox-emptying action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "Describes the verification step and inherently creates the XOR decision point for the mailbox state."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if not, continue the process"
      ],
      "justification": "Maps the negative condition path that proceeds to the next verification step."
    },
    {
      "refs": [
        "guard:b1->e1"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Captures the positive termination condition and the corresponding structural end node."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Describes the completeness check and implicitly creates the subsequent exclusive choice."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Accurately links the complete-data condition to the recording action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Accurately links the incomplete-data condition to the telephone outreach action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Direct correspondence to the post-call data completion and logging step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Exact match for the scheduled document transfer task."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member"
      ],
      "justification": "Captures the initial conditional check before the membership decision."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "The conditional phrase establishes the XOR gateway for the membership outcome."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Maps the positive membership guard to the physical stamping and dating action."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Maps the negative membership guard to the rejection notification action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Direct match for the sequential data-entry step following the stamp."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "The timing adverb explicitly signals a parallel execution split requiring an AND gateway."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "calculate the fee"
      ],
      "justification": "Direct match for the financial calculation step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "hand the letter to Charles. Ask Charles to write the amount in the register."
      ],
      "justification": "Combines the two closely related clauses describing the handoff and register request."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Explicit terminal statement mapping directly to the process end node."
    }
