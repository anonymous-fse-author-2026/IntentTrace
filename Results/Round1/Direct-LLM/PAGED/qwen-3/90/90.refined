init(i1)
action(n1, "Start")
action(n2, "Note Vendor Number on Invoice Entry Form")
branch(b1, XOR)
action(n4, "Sort Invoices by Vendor")
action(n5, "Sort Invoices by Amount")
action(n9, "Tick 'Invoice Entered' on Form")
action(n10, "Place Invoice Batch in Urgent Outbox")
action(n11, "Set Up Hourly Collection")
action(n12, "End of Process")
end(e1)
converge(c1)
defines(v1, "Sort by Vendor or Amount?", {"Sort Invoice by vendor", "Sort invoice by invoice amount"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, n5, n9, n10, n11, n12, e1, c1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, c1)
precedence(n5, c1)
precedence(c1, n9)
precedence(n9, n10)
precedence(n10, n11)
precedence(n11, n12)
precedence(n12, e1)
guard(b1, n4, v1 = "Sort Invoice by vendor")
guard(b1, n5, v1 = "Sort invoice by invoice amount")