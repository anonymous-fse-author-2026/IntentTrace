init(i1)
action(n1, "start Purchase Order-to-Delivery phase")
action(n2, "formally review the purchase invoice and ensure its accuracy")
branch(b1, XOR)
action(n4, "approve the purchase invoice")
action(n6, "trigger payment")
end(e1)
converge(c1)
defines(v1, "invoice amount", {[0-]})
actor(a_default, "Default", [i1, n1, n2, b1, n4, n6, e1, c1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, c1)
precedence(n4, c1)
precedence(c1, n6)
precedence(n6, e1)
guard(b1, n4, v1 > 5000)
guard(b1, c1, v1 <= 5000)