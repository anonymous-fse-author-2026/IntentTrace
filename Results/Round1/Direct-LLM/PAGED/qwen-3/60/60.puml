@startuml
!theme plain
|a_default| Default
|a_default|
start
:click: Start;
:select: Edit Report;
:is expense > 1000?;
:v1: is expense > 1000? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:review report;
repeat :evaluate review decision;
:v3: evaluate review decision ({Rejected, Approved}); <<objectSignal>>
backward:check translation need again;
repeat while () is ([v3 = 'Approved']) not ([v3 = 'Rejected'])
:edit report;
else ([v1 = 'No'])
:check translation need;
:v2: check translation need ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:translate receipts;
else ([v2 = 'No'])
:confirm receipts;
endif
repeat :evaluate receipt decision;
:v5: evaluate receipt decision ({Accepted, Rejected}); <<objectSignal>>
backward:edit report;
repeat while () is ([v5 = 'Rejected']) not ([v5 = 'Accepted'])
:process expense;
stop
endif
@enduml