{
  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Directly covers the process start and the two initial sequential actions."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Branch captures the decision point; action faithfully restates the return step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Branch captures the compliance decision; action matches the conduct checks step."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Action n9 models the condition as a step (allowed per guidelines); branch handles the split; action n10 matches the resolution step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Faithfully restates the return action for the mail-back scenario."
    },
    {
      "refs": [
        "action:n13",
        "action:n15",
        "label:n15->c2"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Action n13 matches payment; branch n14 handles the return check; action n15 and label match the resolution step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "AND gateway correctly models 'Simultaneously'; action matches 'Bill Client'."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Branch captures response check; action matches waiting period."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Faithfully restates the client notification step."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Action matches sending reminder; end node implicitly signals process termination described in the closing clause."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Branch captures satisfaction check; action matches discrepancy resolution."
    }
  ],
