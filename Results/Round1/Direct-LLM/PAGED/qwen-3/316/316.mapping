  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "Implicitly triggers the start node and defines the initial registration action."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If an exception is needed"
      ],
      "justification": "Captures the exclusive split and the positive guard condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then a Request for the exception should be made."
      ],
      "justification": "Directly implements the requested exception action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "label:n4->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if an exception is not needed, the process can continue."
      ],
      "justification": "Captures the negative guard, the continuation action, and the edge label."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "After the exception is approved"
      ],
      "justification": "Temporal condition implies path convergence and guards the approved route."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the next step is course enrollment"
      ],
      "justification": "Faithfully restates the enrollment step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "followed by seminar group enrollment."
      ],
      "justification": "Directly corresponds to the seminar enrollment step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the homework assignment can be started."
      ],
      "justification": "Directly corresponds to initiating the homework."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "it should be turned in."
      ],
      "justification": "Directly corresponds to submitting the homework."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated"
      ],
      "justification": "Directly corresponds to the evaluation step."
    },
    {
      "refs": [
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "If it was not the last homework"
      ],
      "justification": "Captures the loop condition and its guard."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "another homework assignment will be given."
      ],
      "justification": "Splits the source clause into assignment and subsequent start actions, preserving meaning."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "However, if it was the last homework, the process can continue."
      ],
      "justification": "Captures the exit condition and continuation action."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed:"
      ],
      "justification": "Explicitly signals a parallel split for concurrent work."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "granting accreditation and announcing the date of the exam."
      ],
      "justification": "Directly implements the two concurrent steps."
    },
    {
      "refs": [
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "After signing up for the exam, it should be attended."
      ],
      "justification": "Sequentially captures registration and attendance."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the exam is attended, it will be evaluated."
      ],
      "justification": "Directly corresponds to exam evaluation."
    },
    {
      "refs": [
        "guard:b4->n23"
      ],
      "verbatim_texts": [
        "If the exam is passed"
      ],
      "justification": "Captures the pass condition split and guard."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "the course is considered passed"
      ],
      "justification": "Faithfully restates the successful outcome."
    },
    {
      "refs": [
        "guard:b4->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Captures the fail condition and retry action."
    }
