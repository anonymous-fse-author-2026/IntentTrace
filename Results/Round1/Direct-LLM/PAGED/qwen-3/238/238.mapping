{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "i1: To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "The opening unit establishes the process start (init), describes initializing the workflow (action:n1), and specifies the first concrete step (action:n2)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "i2: Check the Customer's Credit Limit."
      ],
      "justification": "Directly implements the credit limit verification step with identical semantics."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "i4: If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "The unit triggers the XOR decision (branch:b1), defines the affirmative state (action:n4), sets the routing condition (guard:b1->n6), and executes the resulting next step (action:n6)."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "i5: if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Captures the negative response condition and the corresponding denial action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "i7: If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Maps the unavailability condition to the production step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "i9: if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Triggers the second XOR decision, records the available state, applies the positive guard, and executes collection."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "i10: After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Faithfully reproduces the post-availability confirmation step."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "i11: Simultaneously, complete the following steps:"
      ],
      "justification": "The concurrency directive explicitly signals the AND gateway."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "i12: Ship the Goods and Send the Invoice."
      ],
      "justification": "Splits the conjunction into two parallel actions matching the unit's instructions."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "i13: Check the Payment status."
      ],
      "justification": "Direct implementation of the payment status verification."
    },
    {
      "refs": [
        "action:n14",
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "i15: If the payment has been received, close the Order"
      ],
      "justification": "Captures the receipt state, opens the third XOR branch, applies the positive guard, and executes order closure."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "i16: end the process."
      ],
      "justification": "Implements the terminal action and the structural end node."
    },
    {
      "refs": [
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "i17: If the payment has not been received"
      ],
      "justification": "Routes the negative payment outcome to the reminder handling path."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "i18: check if the Reminder count is greater than or equal to 3.",
        "i19: If the Reminder count is greater than or equal to 3"
      ],
      "justification": "Models the threshold evaluation as an action step and triggers the subsequent exclusive decision."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "i20: If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Applies the threshold met condition and executes the write-off action."
    },
    {
      "refs": [
        "guard:b4->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "i21: Additionally, send a Reminder."
      ],
      "justification": "The remaining negative branch of the reminder count check routes to sending a reminder, fully covering the unit."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "i22: After writing off the Order, close the Order and end the process."
      ],
      "justification": "Implements the final closure step and the process termination node."
    }
  ],
