{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For TS recruitment, the first step is to advise unsuccessful candidates."
      ],
      "justification": "The opening clause implicitly initializes the process and directly states the first action."
    },
    {
      "refs": [
        "guard:n3->n4",
        "action:n4",
        "guard:n3->n6"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\", then the position should be re-advertised."
      ],
      "justification": "Captures the conditional split, the positive guard/action for re-advertising, and the implicit negative guard to continue."
    },
    {
      "refs": [
        "guard:n6->n7"
      ],
      "verbatim_texts": [
        "However, if the terms and conditions of the offer for a candidate need to be sorted out",
        "it is necessary to check if the candidate has accepted a voluntary redundancy."
      ],
      "justification": "Maps the nested conditions and their implied continuation paths accurately."
    },
    {
      "refs": [
        "guard:n6->n10"
      ],
      "verbatim_texts": [
        "However, if the terms and conditions of the offer for a candidate need to be sorted out",
        "it is necessary to check if the candidate has accepted a voluntary redundancy."
      ],
      "justification": "Maps the nested conditions and their implied continuation paths accurately."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if the terms and conditions of the offer for a candidate need to be sorted out",
        "it is necessary to check if the candidate has accepted a voluntary redundancy."
      ],
      "justification": "Maps the nested conditions and their implied continuation paths accurately."
    },
    {
      "refs": [
        "guard:n7->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the candidate has not accepted, the process continues."
      ],
      "justification": "Directly models the negative acceptance condition and its continuation."
    },
    {
      "refs": [
        "guard:n7->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the candidate has accepted, further investigation is required."
      ],
      "justification": "Directly models the positive acceptance condition and the investigation step."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form, which is then received by the next level manager."
      ],
      "justification": "Faithfully splits the single sentence into send and receive actions."
    },
    {
      "refs": [
        "guard:n13->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the manager is an external resource, they may not authorize the form."
      ],
      "justification": "Models the external resource check and its authorization implication."
    },
    {
      "refs": [
        "guard:n13->n16"
      ],
      "verbatim_texts": [
        "However, if the approver is an existing employee of the client, the process continues."
      ],
      "justification": "Captures the alternative approver condition leading to the next decision point."
    },
    {
      "refs": [
        "guard:n16->n19",
        "action:n19",
        "action:n20",
        "guard:n16->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the form is approved, the recruitment manager sends the form and other documentation, which is received by the client HR."
      ],
      "justification": "Covers both the approval continuation path (sending/receiving docs) and the implicit non-approval path."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "justification": "Exact paraphrase of the scanning and recording step."
    },
    {
      "refs": [
        "guard:n22->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If there are any variations, a complete business case is required."
      ],
      "justification": "Models the variation condition and the resulting business case preparation."
    },
    {
      "refs": [
        "guard:n22->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "Otherwise, the process continues."
      ],
      "justification": "Directly maps the else condition to a continuation action."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "The Appointment Approval is carried forward."
      ],
      "justification": "Exact match of the carry-forward step."
    },
    {
      "refs": [
        "guard:n26->n27",
        "action:n27"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate."
      ],
      "justification": "Accurately captures the medical assessment requirement and its associated rate."
    },
    {
      "refs": [
        "guard:n26->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "Otherwise, a medical assessment is not necessary."
      ],
      "justification": "Directly models the alternative where no assessment is needed."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "For the step of the Preferred Candidate's medical assessments, it is important to note that it can take up to 21 days to arrange and complete."
      ],
      "justification": "Preserves the timing constraint and action description."
    },
    {
      "refs": [
        "action:n30",
        "action:n31"
      ],
      "verbatim_texts": [
        "The TS HR coordinator informs the recruitment manager, who then liaises with the HR representative to confirm the offer to the candidate."
      ],
      "justification": "Correctly segments the coordination sequence into two sequential actions."
    },
    {
      "refs": [
        "guard:n32->n33",
        "action:n33"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory, the next candidate on the shortlist should be contacted."
      ],
      "justification": "Models the unsatisfactory outcome and the fallback candidate contact."
    },
    {
      "refs": [
        "guard:n32->n35",
        "action:n35"
      ],
      "verbatim_texts": [
        "However, if the assessment is fine, the process continues. The recruitment manager makes a formal verbal offer of employment to the candidate."
      ],
      "justification": "Captures the satisfactory path leading to the verbal offer."
    },
    {
      "refs": [
        "guard:n36->n37",
        "action:n37"
      ],
      "verbatim_texts": [
        "If the candidate accepts, the recruitment manager creates a formal written offer."
      ],
      "justification": "Directly models the acceptance condition and written offer creation."
    },
    {
      "refs": [
        "guard:n36->n38",
        "action:n38"
      ],
      "verbatim_texts": [
        "If the candidate declines, the process continues."
      ],
      "justification": "Directly models the decline condition and continuation."
    },
    {
      "refs": [
        "action:n39"
      ],
      "verbatim_texts": [
        "Simultaneously, the commencement pack and letter of appointment are sent to the candidate."
      ],
      "justification": "The AND gateway correctly captures simultaneous execution, paired with the sending action."
    },
    {
      "refs": [
        "action:n40",
        "guard:n41->n42",
        "action:n42"
      ],
      "verbatim_texts": [
        "Once the candidate receives these documents, if there is a \"40%\" rate, renegotiation is required."
      ],
      "justification": "Accurately models document receipt, the 40% rate condition, and the renegotiation trigger."
    },
    {
      "refs": [
        "guard:n43->n44",
        "action:n44"
      ],
      "verbatim_texts": [
        "However, if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified."
      ],
      "justification": "Correctly maps the unsuccessful renegotiation outcome to identifying a new candidate."
    },
    {
      "refs": [
        "end:e5"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicit closing statement mapped to a terminal node."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:n41->e6"
      ],
      "verbatim_texts": [
        "Otherwise, if the candidate accepts, the process continues."
      ],
      "reason": "The model routes the 'no 40% rate' path directly to an end node (e6) instead of continuing the process as stated in the text."
    },
    {
      "refs": [
        "guard:n43->e6"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful, the process continues."
      ],
      "reason": "The model routes the successful renegotiation path to an end node (e6) instead of continuing the process as stated in the text."
    }
  ],
  "omissions": [
