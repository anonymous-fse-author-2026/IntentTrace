@startuml
!theme plain
|a_rec_mngr| Recruitment Manager
|a_next_mgr| Next Level Manager
|a_client_hr| Client HR
|a_ts_hr_coord| TS HR Coordinator
|a_candidate| Candidate
|a_system| System
|a_rec_mngr|
start
:start TS recruitment;
:advise unsuccessful candidates;
:v1: no more candidates? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
|a_system|
:re-advertise position;
stop
|a_rec_mngr|
else ([v1 = 'No'])
:v2: terms and conditions need sorting? ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:v3: candidate accepted voluntary redundancy? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
|a_system|
:conduct further investigation;
|a_rec_mngr|
else ([v3 = 'No'])
|a_system|
:proceed with recruitment process;
|a_rec_mngr|
endif
else ([v2 = 'No'])
|a_system|
:proceed with recruitment process;
|a_rec_mngr|
endif
:send Appointment Approval form;
|a_next_mgr|
:receive Appointment Approval form by next level manager;
:v4: approver is existing client employee? ({No, Yes}); <<objectSignal>>
if () then ([v4 = 'No'])
:authorization check for external resource;
else ([v4 = 'Yes'])
->;
endif
:v5: form approved? ({No, Yes}); <<objectSignal>>
if () then ([v5 = 'No'])
:form not approved by approver;
|a_system|
stop
|a_next_mgr|
else ([v5 = 'Yes'])
|a_rec_mngr|
:recruitment manager sends form and other documentation;
|a_client_hr|
:client HR receives form and documentation;
:HR scans and records position in GovSource;
:v6: any variations? ({Yes, No}); <<objectSignal>>
if () then ([v6 = 'Yes'])
:prepare complete business case;
else ([v6 = 'No'])
:continue process;
endif
:carry forward Appointment Approval;
:v7: position requires medical assessment? ({Yes, No}); <<objectSignal>>
if () then ([v7 = 'Yes'])
:medical assessment applicable at 12 percent rate;
:arrange and complete medical assessment within 21 days;
else ([v7 = 'No'])
:medical assessment not necessary;
endif
|a_ts_hr_coord|
:TS HR coordinator informs recruitment manager;
|a_rec_mngr|
:recruitment manager liaises with HR representative to confirm offer to candidate;
|a_system|
:v8: medical assessment satisfactory? ({No, Yes}); <<objectSignal>>
if () then ([v8 = 'No'])
:contact next candidate on shortlist;
stop
else ([v8 = 'Yes'])
|a_rec_mngr|
:recruitment manager makes formal verbal offer of employment to candidate;
|a_system|
split
|a_candidate|
:v9: candidate accepts verbal offer? ({Yes, No}); <<objectSignal>>
if () then ([v9 = 'Yes'])
|a_rec_mngr|
:create formal written offer;
|a_candidate|
else ([v9 = 'No'])
|a_system|
:continue process;
|a_candidate|
endif
split again
|a_rec_mngr|
:send commencement pack and letter of appointment to candidate;
end split
|a_candidate|
:candidate receives documents;
:v10: rate is 40 percent? ({Yes, No}); <<objectSignal>>
if () then ([v10 = 'Yes'])
|a_system|
:renegotiation required;
:v11: renegotiation successful? ({No, Yes}); <<objectSignal>>
if () then ([v11 = 'No'])
:identify next candidate on shortlist;
stop
else ([v11 = 'Yes'])
->;
endif
|a_candidate|
else ([v10 = 'No'])
->;
endif
|a_system|
stop
endif
|a_next_mgr|
endif
|a_rec_mngr|
endif
@enduml