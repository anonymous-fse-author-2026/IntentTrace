@startuml
!theme plain
|a_default| Default
|a_default|
start
:start registration for event participation;
:check if there is a fee;
:v1: check if there is a fee ({no fee, fee}); <<objectSignal>>
if () then ([v1 = 'no fee'])
:register a post-seminar request;
stop
else ([v1 = 'fee'])
:create a purchase request;
:check if purchase request is approved;
:v2: check if purchase request is approved ({approved, rejected}); <<objectSignal>>
if () then ([v2 = 'approved'])
:receive an approved notification;
:register a post-seminar request after approval;
else ([v2 = 'rejected'])
:receive a rejection notification;
endif
stop
endif
@enduml