init(i1)
action(n1, "start")
action(n2, "Check if process has started in Admin Office")
action(n3, "Proceed to verify completeness of invoices")
branch(b1, XOR)
action(n5, "Return uncompleted invoices to client via postal mail")
action(n6, "Receive completed invoices from client")
action(n7, "Mark relevant box on invoice entry form")
action(n8, "Check if process has been completed")
end(e1)
defines(v1, "Check if process has started in Admin Office", {"Started", "Not Started"})
defines(v2, "Check if process has been completed", {"Uncompleted", "Completed"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n5, n6, n7, n8, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(b1, n7)
precedence(n5, n6)
precedence(n6, n7)
precedence(n7, n8)
precedence(n8, e1)
guard(b1, n5, v2 = 'Uncompleted')
guard(b1, n7, v2 = 'Completed')