      ],
      "verbatim_texts": [
        "To begin the process, the customer makes an enquiry."
      ],
      "justification": "The opening clause establishes the process start and defines the initial enquiry action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check if the article is in stock."
      ],
      "justification": "Describes the verification step that inherently introduces the stock-availability decision gateway."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the article is available"
      ],
      "justification": "Models the positive availability condition as a boolean guard on the continuing path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "we continue with the process."
      ],
      "justification": "Directly restates the action taken when the stock check is positive."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "we abort the enquiry and end the process."
      ],
      "justification": "Captures the negative-branch outcome and its corresponding guard logic."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
