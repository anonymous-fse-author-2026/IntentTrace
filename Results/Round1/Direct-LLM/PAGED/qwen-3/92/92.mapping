{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "The opening clause implicitly initiates the process and directly specifies the first registration action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request. However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "The XOR branch captures the split logic, and the preceding action extracts the core condition ('Is there a fee?') as a distinct check step, faithfully preserving the source decision point."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to register a post-seminar request."
      ],
      "justification": "The guard condition aligns with the 'no fee' path context, and the action text matches the registration instruction for that branch."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "you need to create a purchase request."
      ],
      "justification": "The guard condition aligns with the 'fee' path context, and the action text matches the purchase request creation instruction."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "The structural end node directly corresponds to the explicit termination statement for the no-fee path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "The check action and subsequent XOR branch accurately model the approval status verification step."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "The guard value 'Approved' and the passive action text precisely capture the positive approval outcome described in the source."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "The guard value 'Rejected' and the passive action text precisely capture the negative rejection outcome described in the source."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "The action faithfully restates the instruction to register a post-seminar request following approval notification."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "The structural end node directly corresponds to the explicit termination statement for the rejection path."
    }
  ],
