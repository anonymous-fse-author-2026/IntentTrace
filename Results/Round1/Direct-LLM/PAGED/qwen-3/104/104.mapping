{
  "matches": [
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially, if the option \"research schedule directly\" is selected, then the action to be taken is \"Research schedule\"."
      ],
      "justification": "The span implicitly initializes the process, establishes the XOR decision, phrases the condition as a check step, provides the positive guard, and executes the corresponding research action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "The negative guard routes to the indication provision and subsequent research schedule steps."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Validates the schedule, performs the satisfaction check, and opens the next decision branch."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Negative outcome on the first satisfaction check correctly triggers the research schedule action."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n12"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Positive outcome converges parallel/nested paths and executes the ticket writing step."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Second satisfaction check branch routes to the indication provision on the negative path."
    },
    {
      "refs": [
        "guard:b3->c2",
        "action:n12"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Positive path from the second check rejoins the flow to write the ticket order."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Directly implements the validation step following ticket creation."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Models the first approval verification and its associated decision gateway."
    },
    {
      "refs": [
        "guard:b4->e2"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Negative result on the first approval check correctly terminates the workflow."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Positive result routes to the ticket validation action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Models the second approval verification and its decision gateway."
    },
    {
      "refs": [
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Includes the intervening validation step, the third approval check, and its decision gateway."
    },
    {
      "refs": [
        "guard:b6->e4"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Positive result on the final approval check correctly terminates the process."
    }
  ],
