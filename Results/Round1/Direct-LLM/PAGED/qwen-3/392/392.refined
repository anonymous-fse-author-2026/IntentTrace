init(i1)
action(n1, "Start User Task")
action(n2, "Is User Task Service Task 1?")
branch(b1, XOR)
action(n3, "Continue Process after Service Task 1")
action(n4, "Is User Task Service Task 2?")
branch(b2, XOR)
action(n5, "Continue Process after Service Task 2")
action(n6, "End Process due to Service Task 3")
end(e1)
action(n7, "Merge Continue Process after Service Task 1 and 2")
action(n8, "Is there a Manual Task?")
branch(b3, XOR)
action(n9, "End Process if Manual Task Yes")
end(e2)
action(n10, "Continue Process if no Manual Task")
action(n11, "End Process")
end(e3)
converge(c1)
defines(v1, "User Task Type", {"Service Task 1", "Service Task 2", "Service Task 3"})
defines(v2, "Is User Task Service Task 2?", {"true", "false"})
defines(v3, "Is there a Manual Task?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, b2, n5, n6, e1, n7, n8, b3, n9, e2, n10, n11, e3, c1])
precedence(i1, n1)
precedence(n2, b1)
precedence(n4, b2)
precedence(n6, e1)
precedence(n8, b3)
precedence(n9, e2)
precedence(n11, e3)
precedence(c1, n7)
precedence(n1, n2)
precedence(b1, n3)
precedence(b1, n4)
precedence(b2, n5)
precedence(b2, n6)
precedence(n3, c1)
precedence(n5, c1)
precedence(n7, n8)
precedence(b3, n9)
precedence(b3, n10)
precedence(n10, n11)
guard(b1, n3, v1 = 'Service Task 1')
guard(b1, n4, v1 != 'Service Task 1')
guard(b2, n5, v1 = 'Service Task 2')
guard(b2, n6, v1 = 'Service Task 3')
guard(b3, n9, v3 = 'Yes')
guard(b3, n10, v3 = 'No')