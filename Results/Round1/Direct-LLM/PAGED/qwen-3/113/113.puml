@startuml
!theme plain
|a_default| Default
|a_default|
start
:claim what is requested;
:check insured status;
:is claimant insured?;
:v1: is claimant insured? ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:reject claim;
:notify claimant;
stop
else ([v1 = 'Yes'])
:evaluate claim;
:is claim simple or complex?;
:v2: is claim simple or complex? ({simple, complex}); <<objectSignal>>
if () then ([v2 = 'simple'])
:send relevant forms for simple claim;
else ([v2 = 'complex'])
:send relevant forms for complex claim;
endif
:check forms for completeness;
:are all relevant details provided?;
:v3: are all relevant details provided? ({No, Yes}); <<objectSignal>>
if () then ([v3 = 'No'])
:inform claimant to complete details;
else ([v3 = 'Yes'])
:register claim;
stop
endif
endif
@enduml