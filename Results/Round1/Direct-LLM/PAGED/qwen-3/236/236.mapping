{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "Init and two actions faithfully capture the starting trigger and the prioritization instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information."
      ],
      "justification": "Direct paraphrase of the information verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer exists"
      ],
      "justification": "Action restates the condition as a query, branch handles the XOR split."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "checking their payment history."
      ],
      "justification": "Exact match for the payment history review step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "verify their customer status."
      ],
      "justification": "Exact match for status verification."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the payment history is good"
      ],
      "justification": "Action restates the condition, branch handles the split."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Structural convergence implicitly models the workflow continuation described in the text."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Captures the private customer check and the associated decline message action."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Correctly decomposes the compound instruction into two sequential actions."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the products are not available"
      ],
      "justification": "Action restates the availability condition, branch handles the split."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n18",
        "action:n9"
      ],
      "verbatim_texts": [
        "produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Covers production, messaging, redundant end step, and terminal node."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "continue with the process and send an order confirmation."
      ],
      "justification": "Direct match for the confirmation dispatch step."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "AND branch and converge accurately model the concurrent notifications triggered by 'Simultaneously'."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Two actions faithfully capture the packing/invoicing task and the resulting readiness state."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Direct match for the physical delivery step."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "If payment has been received"
      ],
      "justification": "Action restates the payment condition, branch handles the split."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "we close the order."
      ],
      "justification": "Exact match for the order closure action."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "If there are less than three reminders"
      ],
      "justification": "Action restates the threshold condition, branch handles the split."
    },
    {
      "refs": [
        "action:n30",
        "action:n31",
        "action:n12",
        "action:n27"
      ],
      "verbatim_texts": [
        "activate the donning process, thus ending the process."
      ],
      "justification": "Covers the activation step, redundant end actions across paths, and terminal nodes."
    }
  ],
