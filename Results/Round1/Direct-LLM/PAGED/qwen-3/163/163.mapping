  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "init captures the process start implied by the opening clause; action:n1 faithfully restates the first operational step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After entering the metadata, proceed to the IN-Patient step."
      ],
      "justification": "Direct correspondence to the second step instruction."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: send data to suppliers and create a claim."
      ],
      "justification": "branch:b1 (AND) correctly models the concurrent execution signaled by 'At the same time'; n3 and n4 cover the two listed tasks."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the data is sent to suppliers, extract the data from the suppliers and transfer it to the doctor's phone."
      ],
      "justification": "Both actions accurately reflect the extraction and transfer instructions."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, confirm the GOP and the process will come to an end."
      ],
      "justification": "Actions cover the confirmation step; end:e1 aligns with the explicit termination statement."
    },
    {
      "refs": [
        "action:n5",
        "action:n10"
      ],
      "verbatim_texts": [
        "Next, register the case and handle the claim."
      ],
      "justification": "Direct mapping to the case registration and claim handling steps."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Create a claim and handle the claim accordingly."
      ],
      "justification": "Accurately reflects the claim creation and subsequent handling instruction."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status."
      ],
      "justification": "branch:b2 (XOR) models the exclusive choice; n15 and n16 cover the data extraction and record/status update."
    },
    {
      "refs": [
        "action:n22",
        "action:n27"
      ],
      "verbatim_texts": [
        "Enter the data on the patient's record or confirm the IN-Patient status, and then send the data back to the suppliers."
      ],
      "justification": "branch:b3 (XOR) handles the alternative path; n27 and n22 cover the status/data entry and return transmission."
    },
    {
      "refs": [
        "action:n28",
        "action:n29"
      ],
      "verbatim_texts": [
        "Finally, receive the payment and conclude the process."
      ],
      "justification": "Covers the final payment receipt and process conclusion steps."
    }
  ],
