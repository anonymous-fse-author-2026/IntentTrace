{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am"
      ],
      "justification": "Opening clause implicitly triggers the process start."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then empty the mailbox."
      ],
      "justification": "Direct correspondence to the mailbox clearing step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty, if not, continue the process."
      ],
      "justification": "Action and XOR branch capture the initial conditional check and split."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Guard condition, termination action, and end node align with the positive branch outcome."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty, if not, continue the process."
      ],
      "justification": "Negative branch guard and continuation action match the source clause."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again, if not, continue the process."
      ],
      "justification": "Second verification step and decision node match the repeated check."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again, if not, continue the process."
      ],
      "justification": "Negative branch guard and action correspond to the continuation path."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Reuses the positive termination logic for the second mailbox check."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Verification step and subsequent XOR branch match the completeness check."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Guard and action faithfully reproduce the positive completion path."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Guard and action match the incomplete-information branch."
    },
    {
      "refs": [
        "label:n11->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Temporal label and follow-up data entry action align with the source."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it.",
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "XOR branch models the membership approval/rejection decision split."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member, stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Guard condition and stamping/writing actions match the approval arm."
    },
    {
      "refs": [
        "guard:b4->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Guard condition and notification action match the rejection arm."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles."
      ],
      "justification": "AND branch and fee calculation action capture the concurrency keyword and task."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee and hand the letter to Charles.",
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Combines handing the letter to Charles and requesting register entry across two sequential source units."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Direct match for card printing and delivery."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Final action and terminal nodes align with the explicit closing statement."
    }
  ],
