{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "At the start, we receive a form."
      ],
      "justification": "The initiation node and receiving action directly correspond to the opening phrase describing process start and form intake."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "we check if it is complete"
      ],
      "justification": "The action captures the completeness verification, and the subsequent XOR branch implements the conditional evaluation."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If it needs to be sent back, the process ends."
      ],
      "justification": "The guard models the negative condition, while the action and end node faithfully represent the rejection and termination outcome."
    },
    {
      "refs": [
        "guard:b1->b2"
      ],
      "verbatim_texts": [
        "if we need to check the income, we continue with the process"
      ],
      "justification": "The guard captures the conditional routing that allows the process to proceed along the continuation path."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "At the same time, we complete the following steps: checking deductibles and checking the house."
      ],
      "justification": "The AND branch and converge node correctly model the simultaneous execution, and the two actions map precisely to the specified parallel checks."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Then, we make a decision."
      ],
      "justification": "The action and following XOR branch accurately sequence the decision point after the parallel phase completes."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If we need to check the declaration, the process ends."
      ],
      "justification": "The guard, action, and end node together faithfully implement the conditional path and its termination result."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, if we need to invite the declarant, the process also ends."
      ],
      "justification": "The guard, action, and end node correctly capture the alternative condition and its corresponding termination."
    }
  ],
