@startuml
!theme plain
|a_default| Default
|a_default|
start
:choose your destination and calculate the distance;
:check if you need to book a train or a flight;
:v1: booking decision ({no, yes}); <<objectSignal>>
if () then ([v1 = "no"])
:book a train;
else ([v1 = "yes"])
:book a flight;
endif
:check if code is available within 24 hours;
:v2: code availability ({available, unavailable}); <<objectSignal>>
if () then ([v2 = "available"])
stop
else ([v2 = "unavailable"])
:call a travel agency;
:check if code is available;
:v3: code availability after agency ({available, unavailable}); <<objectSignal>>
if () then ([v3 = "available"])
stop
else ([v3 = "unavailable"])
:cancel your journey;
stop
endif
endif
@enduml