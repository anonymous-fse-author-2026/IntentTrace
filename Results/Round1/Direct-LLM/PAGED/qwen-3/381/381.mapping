  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, you should choose your destination and calculate the distance."
      ],
      "justification": "The opening clause implicitly starts the process and describes the first combined action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "While doing so, continue to check if you need to book a train or a flight."
      ],
      "justification": "Action directly captures the concurrent verification step described."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the answer is \"no\", then proceed to book a train."
      ],
      "justification": "Branch opens the decision, guard captures the negative condition, and action executes the booking step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the answer is \"yes\", then book a flight."
      ],
      "justification": "Guard captures the positive condition and action executes the corresponding flight booking."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->e1"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours, the process will end."
      ],
      "justification": "Action evaluates availability within the timeframe, branch/guard check the condition, and end node terminates the flow as specified."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Otherwise, if 24 hours have passed, you should call a travel agency."
      ],
      "justification": "Action faithfully restates the required agency contact step."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->e2"
      ],
      "verbatim_texts": [
        "If a code is available, the process will end along with the hotel reservation."
      ],
      "justification": "Action checks code status, branch/guard evaluate availability, and end node terminates the process."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "On the other hand, if a code is not available, you should cancel your journey."
      ],
      "justification": "Guard captures the unavailability condition and action executes the journey cancellation."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "In that case, the process will end as well."
      ],
      "justification": "Structural end node correctly marks the final termination point following cancellation."
    }
  ],
