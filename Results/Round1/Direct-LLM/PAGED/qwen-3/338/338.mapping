{
  "matches": [
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "Initially, if the option \"research schedule directly\" is selected, then the action to be taken is \"Research schedule\"."
      ],
      "justification": "The opening clause establishes the process start, the first XOR decision, the positive guard condition, and the resulting action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "The negative branch guard and its two sequential actions directly mirror the source phrasing and ordering."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Captures the validation step followed immediately by the satisfaction check decision."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Direct mapping of the unsatisfactory schedule outcome and its prescribed action."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "The satisfactory guard, structural convergence point, and the ticket-order action align with this clause."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\". If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Captures the repeated unsatisfactory check branching to the indications action; the redundant research step is absorbed by prior modeling without behavioral change."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Models the alternative positive path converging back to the ticket-order flow."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it. Check if the ticket order is approved."
      ],
      "justification": "Structural convergence after the scheduling loop, followed by validation and the approval decision."
    },
    {
      "refs": [
        "guard:b4->e2"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Exact match for the first unapproved outcome terminating the process."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Direct mapping of the approved path continuing to another validation step."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Captures the second explicit approval verification decision."
    },
    {
      "refs": [
        "guard:b5->e3"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Exact match for the second unapproved termination path."
    },
    {
      "refs": [
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Direct mapping of the second approved continuation to validation."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Captures the third and final explicit approval verification decision."
    },
    {
      "refs": [
        "guard:b6->e4"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Exact match for the final approved termination path."
    },
    {
      "refs": [
        "guard:b6->e5"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Exact match for the final unapproved termination path."
    }
  ],
