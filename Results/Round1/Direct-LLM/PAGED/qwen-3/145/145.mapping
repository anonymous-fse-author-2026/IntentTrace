{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, go to the Amazon homepage."
      ],
      "justification": "The opening clause implicitly starts the process and directly describes the first navigation step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, search for a book."
      ],
      "justification": "Direct correspondence to the search instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once you've found the book, click on the link that says \"22 used\" to see the used books available."
      ],
      "justification": "Faithfully captures the click action and target label."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "From there, click on the \"Add to Cart\" button for the second book on the list."
      ],
      "justification": "Exact match for the add-to-cart step and its specific target."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After adding it to your cart, click on the \"Proceed to Checkout\" button."
      ],
      "justification": "Directly maps to the checkout transition step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "On the checkout page, enter your email address and select the option that says \"I am a new customer\"."
      ],
      "justification": "Accurately combines the two required inputs described in the source."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Next, click on the \"Sign in using our secure server\" button."
      ],
      "justification": "Direct match for the sign-in trigger."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once you've signed in, enter your customer details and click on the \"Create account\" button."
      ],
      "justification": "Correctly groups the detail entry and account creation click."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After creating your account, enter your shipping details and click on the \"Continue\" button."
      ],
      "justification": "Faithfully restates the shipping info entry and continuation step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "On the next page, select your preferred shipping options and click on \"Continue\" again."
      ],
      "justification": "Matches the shipping selection and subsequent continue action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Then, choose your payment method and enter your credit card details."
      ],
      "justification": "Directly covers the payment method choice and card detail entry."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Click on the \"Add your card\" button to save your card information."
      ],
      "justification": "Exact match for the card saving action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After that, click on \"Continue\" to proceed."
      ],
      "justification": "Corresponds precisely to the procedural advance step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Next, choose your billing address and select the option to use the address you've chosen."
      ],
      "justification": "Accurately reflects the billing address selection and confirmation."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, click on \"Place your order in AUD\" to complete the process."
      ],
      "justification": "The final click action maps to the action node, and the phrase 'complete the process' implies the end structural node."
    }
  ],
