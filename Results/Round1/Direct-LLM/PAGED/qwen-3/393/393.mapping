{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For TS recruitment, the first step is to advise unsuccessful candidates."
      ],
      "justification": "Init marks the process trigger; n2 faithfully executes the first instructed step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\""
      ],
      "justification": "Captures the candidate availability check and routes positively to subsequent steps."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "then the position should be re-advertised."
      ],
      "justification": "Routes negatively (v1=false) to re-advertisement when candidates are exhausted."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If there are any variations,"
      ],
      "justification": "Directly models the variation check and corresponding decision split."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "a complete business case is required."
      ],
      "justification": "Faithfully implements the required remedial action upon variation."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Otherwise, the process continues."
      ],
      "justification": "Accurately represents the default continuation path."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate."
      ],
      "justification": "Preserves the medical assessment condition and associated rate threshold."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "it is important to note that it can take up to 21 days to arrange and complete."
      ],
      "justification": "Retains the exact timeframe and action for the assessment phase."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory"
      ],
      "justification": "Models the satisfaction evaluation and subsequent branching correctly."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "the next candidate on the shortlist should be contacted."
      ],
      "justification": "Directly matches the fallback recruitment action."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "if the assessment is fine, the process continues."
      ],
      "justification": "Faithfully restates the positive assessment outcome."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "If the candidate accepts"
      ],
      "justification": "Correctly captures the candidate acceptance decision point."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "the recruitment manager creates a formal written offer."
      ],
      "justification": "Aligns with the positive acceptance workflow step."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "If the candidate declines, the process continues."
      ],
      "justification": "Accurately models the decline continuation path."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Simultaneously, the commencement pack and letter of appointment are sent to the candidate."
      ],
      "justification": "Action matches document dispatch; AND gateway structurally enforces the 'simultaneously' concurrency."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "Once the candidate receives these documents, if there is a \"40%\" rate,"
      ],
      "justification": "Preserves the receipt trigger and exact percentage threshold for branching."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "renegotiation is required."
      ],
      "justification": "Directly implements the mandatory renegotiation step."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful, the process continues."
      ],
      "justification": "Captures the success evaluation and forward flow."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified."
      ],
      "justification": "Faithfully implements the failure fallback procedure."
    },
    {
      "refs": [
        "action:n33"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful, the process continues."
      ],
      "justification": "Redundant but exact restatement of the success continuation."
    },
    {
      "refs": [
        "action:n34"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Jointly and precisely represent the explicit process termination."
    }
  ],
  "mutations": [
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the terms and conditions of the offer for a candidate need to be sorted out, it is necessary to check if the candidate has accepted a voluntary redundancy."
      ],
      "reason": "Truncates the source instruction by performing only the terms/conditions check while completely dropping the mandatory voluntary redundancy verification."
    },
    {
      "refs": [
        "guard:b3->n8",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If the manager is an external resource, they may not authorize the form. However, if the approver is an existing employee of the client, the process continues. If the form is approved,"
      ],
      "reason": "Inverts the source logic: the text specifies continuation for existing employees and potential blockage for external resources, but the guards route v3=true to 'continue process' and v3=false to 'approve form', reversing the intended conditional outcomes."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form, which is then received by the next level manager."
      ],
      "reason": "Drops the critical downstream actor ('received by the next level manager'), altering the granularity and handoff specification of the original instruction."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "reason": "Omits the responsible actor ('HR department') and the precise target context ('against the stored position'), reducing instructional fidelity."
    },
    {
      "refs": [
        "action:n14",
        "action:n20"
      ],
      "verbatim_texts": [
        "The TS HR coordinator informs the recruitment manager, who then liaises with the HR representative to confirm the offer to the candidate."
      ],
      "reason": "Duplicates the step but strips key actors ('TS HR coordinator', 'HR representative') and the explicit objective ('confirm the offer to the candidate'), violating the no-dropped-qualifier standard."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "The recruitment manager makes a formal verbal offer of employment to the candidate."
      ],
      "reason": "Removes the designated actor ('recruitment manager') from the verbal offer step, changing the responsibility assignment defined in the source."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "If the candidate has not accepted, the process continues.",
        "On the other hand, if the candidate has accepted, further investigation is required."
      ],
      "reason": "The entire voluntary redundancy acceptance branch (both negative continuation and positive investigation paths) is absent from the model."
    }
  ],
  "additions": [
