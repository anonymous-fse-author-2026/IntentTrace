  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "The init and two action nodes faithfully reproduce the starting steps described in this unit."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
      ],
      "justification": "Action n3 captures the conditional state, branch b1 handles the decision split, and action n4 executes the specified positive outcome."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance."
      ],
      "justification": "Action n5 directly states the resulting balance condition from the source unit."
    },
    {
      "refs": [
        "action:n6",
        "action:n8"
      ],
      "verbatim_texts": [
        "In the case of an Outstanding Balance, a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "Action n6 covers placing the new order, and action n8 covers the terminal warehouse step described in the same clause."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If a new order is placed, it will be recorded in the Accounts Receivable."
      ],
      "justification": "Action n7 faithfully restates the recording step without altering granularity or target."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If Payments are Received, the process continues."
      ],
      "justification": "Action n9 captures the payment receipt condition, and converge c1 structurally implements the described continuation/rejoin of the flow."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "However, if no payments are received, the order is dropped."
      ],
      "justification": "Both actions redundantly but faithfully capture the order-dropping outcome stated in the source."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Next, identify the order for installation."
      ],
      "justification": "Action n12 exactly matches the identification step specified."
    },
    {
      "refs": [
        "action:n13",
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled, an Installer will be assigned."
      ],
      "justification": "Action n13 holds the scheduling condition, branch b3 splits the flow, and actions n14/n15 redundantly capture the installer assignment."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "On the other hand, if the order does not require installation, it will be packed for delivery."
      ],
      "justification": "Actions n16 and n17 redundantly but accurately reflect the packing step for the non-installation path."
    }
  ],
