{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "The opening clause establishes the process start, explicitly describes the initial check, and implies the XOR branch for the conditional routing."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "The guard captures the affirmative condition, and the action faithfully restates the prescribed step for the positive arm."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "The 'Otherwise' clause directly supports the negative guard path bypassing the discussion step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Models the second checkpoint as an action step followed by its implicit XOR branch, preserving the exact inquiry."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits."
      ],
      "justification": "The 'Yes' guard routes to the nested check (modeled as an action + branch), faithfully capturing the conditional drilling down."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "The negative guard triggers the relay action exactly as specified for the out-of-limits case."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process."
      ],
      "justification": "The positive guard captures the in-limits condition, directing flow forward past the decision."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Directly implements the post-decision sequential step with identical wording and intent."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Exact reproduction of the approval-seeking step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Exact reproduction of the modification instruction."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Faithful restatement of the handoff step; minor article omission does not alter meaning or data."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Exact match of the archival/upload action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Exact match of the offer creation step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Models the acceptability check as an action preceding its XOR branch, preserving the exact query."
    },
    {
      "refs": [
        "guard:b4->c4"
      ],
      "verbatim_texts": [
        "If they are, continue with the process."
      ],
      "justification": "Captures the affirmative outcome routing the process forward."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If not, select a new applicant from the list."
      ],
      "justification": "The negative guard correctly triggers the replacement action with identical phrasing."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Accurately models the client acceptance check and its associated decision gateway."
    },
    {
      "refs": [
        "guard:b5->e1"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "The affirmative guard routes directly to the structural end node, matching the terminal condition."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "The negative guard activates the candidate replacement step exactly as described."
    }
  ],
