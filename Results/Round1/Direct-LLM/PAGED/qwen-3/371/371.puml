@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start ExpenseReport process;
:click Start;
:select Edit Report;
:expense greater than 1000?;
:v1: expense greater than 1000? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:review report;
:evaluate review decision;
:v4: evaluate review decision ({Rejected, Approved}); <<objectSignal>>
switch ()
case ([v4 = 'Rejected'])
:edit report;
case ([v4 = 'Approved'])
case (else)
:translate receipts;
:confirm receipts;
:evaluate receipts decision;
:v5: evaluate receipts decision ({Accepted, Rejected}); <<objectSignal>>
if () then ([v5 = 'Accepted'])
:process expense;
:End;
stop
else ([v5 = 'Rejected'])
:edit report;
endif
endswitch
else ([v1 = 'No'])
->;
endif
:translation required?;
:v3: translation required? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:translate receipts;
else ([v3 = 'No'])
:confirm receipts;
endif
@enduml