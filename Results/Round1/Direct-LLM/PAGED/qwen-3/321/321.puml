@startuml
!theme plain
|a_default| buyers
|a_default|
start
:choose a book;
:v1: selection path ({details, new copies, used copies}); <<objectSignal>>
switch ()
case ([v1 = 'details'])
:view book details;
:v2: details path ({new copies, select copy}); <<objectSignal>>
if () then ([v2 = 'new copies'])
:view list of new copies from book details;
else ([v2 = 'select copy'])
:select a copy and complete process;
endif
case ([v1 = 'new copies'])
:view list of new copies;
case ([v1 = 'used copies'])
:view list of used copies;
:evaluate list of used copies;
:select preferred copy and complete process;
endswitch
stop
@enduml