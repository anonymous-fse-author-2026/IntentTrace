init(i1)
action(n1, "Start by receiving the invoice")
action(n2, "Check the invoice for any mismatches")
branch(b1, XOR)
action(n3, "Re-send the invoice to the customer")
action(n6, "Post the invoice")
action(n8, "Block the invoice")
converge(c1)
action(n10, "Park the invoice")
end(e2)
defines(v1, "Mismatch resolution", {"Re-send the invoice to the customer", "Post the invoice", "Block the invoice"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n6, n8, c1, n10, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n6)
precedence(b1, n8)
precedence(n3, c1)
precedence(n6, c1)
precedence(n8, c1)
precedence(c1, n10)
precedence(n10, e2)
guard(b1, n3, v1 = 'Re-send the invoice to the customer')
guard(b1, n6, v1 = 'Post the invoice')
guard(b1, n8, v1 = 'Block the invoice')