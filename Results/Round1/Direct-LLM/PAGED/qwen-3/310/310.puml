@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start by receiving the invoice;
:Check the invoice for any mismatches;
:v1: Mismatch resolution ({Re-send the invoice to the customer, Post the invoice, Block the invoice}); <<objectSignal>>
switch ()
case ([v1 = 'Re-send the invoice to the customer'])
:Re-send the invoice to the customer;
case ([v1 = 'Post the invoice'])
:Post the invoice;
case ([v1 = 'Block the invoice'])
:Block the invoice;
endswitch
:Park the invoice;
stop
@enduml