@startuml
!theme plain
|a_default| Default
|a_default|
start
:make an appointment at the hairdresser's;
:go to the hairdresser's;
:do you need your hair washed;
:v1: do you need your hair washed ({Yes, No}); <<objectSignal>>
fork
if () then ([v1 = 'Yes'])
:wash hair;
endif
fork again
if () then ([v1 = 'No'])
:do you want your hair dyed;
:v2: do you want your hair dyed ({Yes, No}); <<objectSignal>>
fork
if () then ([v2 = 'Yes'])
:dye hair;
endif
fork again
if () then ([v2 = 'No'])
:do you need a haircut;
:v3: do you need a haircut ({Yes, No}); <<objectSignal>>
fork
if () then ([v3 = 'Yes'])
:cut hair;
endif
fork again
if () then ([v3 = 'No'])
endif
end fork
endif
end fork
endif
end fork
:pay the hairdresser;
stop
@enduml