init(i1)
action(n1, "Start the Casual Admin Assistant hiring process")
action(n2, "Commence reference check")
action(n3, "Check applicants referees")
branch(b1, XOR)
end(e1)
action(n6, "Send Complete Referee Report to archive applications")
action(n7, "Evaluate and rank candidates")
action(n8, "Process concludes")
end(e2)
defines(v1, "Is referee report complete", {'Incomplete', 'Complete'})
actor(a_default, "Casual Admin Assistant", [i1, n1, n2, n3, b1, e1, n6, n7, n8, e2])
precedence(i1, n1)
precedence(n3, b1)
precedence(b1, e1)
precedence(n8, e2)
precedence(n1, n2)
precedence(n2, n3)
precedence(b1, n6)
precedence(n6, n7)
precedence(n7, n8)
guard(b1, e1, v1 = 'Incomplete')
guard(b1, n6, v1 = 'Complete')