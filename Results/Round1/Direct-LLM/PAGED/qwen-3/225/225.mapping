{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process for ACME Company, start by receiving the customer request"
      ],
      "justification": "Opening clause implicitly starts the process and defines the first action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then check the current inventory level."
      ],
      "justification": "Directly matches the second sequential step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum"
      ],
      "justification": "Conditional clause implicitly creates the XOR decision point."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "accept the customer request."
      ],
      "justification": "Direct restatement of the positive arm action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the inventory level is above the minimum, reject the customer request."
      ],
      "justification": "Guard captures the negative condition; action captures the rejection step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "After accepting the customer request, create a purchase order."
      ],
      "justification": "Directly matches the creation step following acceptance."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "If the customer request is rejected, the process ends.",
        "the process ends."
      ],
      "justification": "Structural end node corresponds to the explicit process termination described in the rejection path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the purchase order is created, review it."
      ],
      "justification": "Directly matches the review step."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected"
      ],
      "justification": "Conditional opens the XOR branch and defines the rejection guard."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "rework the purchase order."
      ],
      "justification": "Directly matches the rework action."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "However, if the purchase order is approved, reserve the funds."
      ],
      "justification": "Guard faithfully captures the approval condition."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "In case the purchase order needs to be reworked, review it again."
      ],
      "justification": "Structural converge node represents the join point where the rework loop returns to the review stage."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After reserving the funds, send the purchase order."
      ],
      "justification": "Directly matches the sending step."
    },
    {
      "refs": [
        "action:n10",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "AND gateway and two actions faithfully model the concurrent receipt steps."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Upon receiving the packing slip, record it."
      ],
      "justification": "Directly matches the packing slip recording step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Similarly, upon receiving the invoice, record it as well."
      ],
      "justification": "Directly matches the invoice recording step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Release the reserved funds and issue the payment."
      ],
      "justification": "Content exactly matches the release and payment issuance step."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Upon receiving the packing slip, record it.",
        "Similarly, upon receiving the invoice, record it as well."
      ],
      "justification": "Structural converge node joins the two parallel recording paths before proceeding."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, issue the payment and the process ends."
      ],
      "justification": "Action and structural end node correspond to the final closure statement."
    }
  ],
