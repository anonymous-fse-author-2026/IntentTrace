init(i1)
action(n1, "start")
action(n2, "book a bus")
action(n3, "check availability")
action(n7, "receive the necessary information")
branch(b1, XOR)
action(n5, "proceed to book the bus")
end(e1)
end(e2)
defines(v1, "check availability", {"nok", "ok"})
actor(a_default, "Default", [i1, n1, n2, n3, n7, b1, n5, e1, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n7)
precedence(n7, b1)
precedence(b1, e1)
precedence(b1, n5)
precedence(n5, e2)
guard(b1, e1, v1 = 'nok')
guard(b1, n5, v1 = 'ok')