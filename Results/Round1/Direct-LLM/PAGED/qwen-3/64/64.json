  "input_elements": [
    {
      "id": "i1",
      "content": "To initiate the process for the election of a rector, it is necessary to begin with the rector's final year in their current position."
    },
    {
      "id": "i2",
      "content": "the acceptance of proposals for candidates for the rector position should be launched."
    },
    {
      "id": "i3",
      "content": "the rector can nominate themselves as a candidate for the position."
    },
    {
      "id": "i4",
      "content": "the acceptance of proposals should be stopped."
    },
    {
      "id": "i5",
      "content": "If a candidate meets the required criteria, they should be included in the list of candidates."
    },
    {
      "id": "i6",
      "content": "if a candidate does not meet the criteria, they should be informed of the refusal and the process will come to an end."
    },
    {
      "id": "i7",
      "content": "Once the list of candidates has been formed, it should be made public."
    },
    {
      "id": "i8",
      "content": "Simultaneously, the candidates should promote their ideas to the public and organize a public meeting of the Academic Senate."
    },
    {
      "id": "i9",
      "content": "The public meeting should then commence, ensuring that all members are able to vote for a new rector."
    },
    {
      "id": "i10",
      "content": "an election should be conducted and the votes should be counted."
    },
    {
      "id": "i11",
      "content": "If the voting fails, another election should be conducted."
    },
    {
      "id": "i12",
      "content": "if the voting is successful"
    },
    {
      "id": "i13",
      "content": "the result of the election should be announced."
    },
    {
      "id": "i14",
      "content": "the public meeting should be concluded"
    },
    {
      "id": "i15",
      "content": "the candidate should be informed of the election results"
    },
    {
      "id": "i16",
      "content": "marking the end of the process."
    }
  ]
}