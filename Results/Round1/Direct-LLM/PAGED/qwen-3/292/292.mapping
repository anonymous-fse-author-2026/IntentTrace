{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The opening clause establishes the process start and describes the first action of receiving the claim."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Direct paraphrase of the second step combining creation and recording."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "Describes the decision step and implicitly introduces the subsequent exclusive split."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "Guard captures the rejection condition; action captures the rejection step."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "Guard and action n9 capture the acceptance condition (modeled as action per guidelines), while n10 captures the subsequent benefit offer."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Captures the review step; the conditional context is handled by the preceding branch and guard."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Captures the preparation step; the conditional context is handled by the preceding branch."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Captures the payment recording step triggered by completion of the prior step."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process. But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Covers the conditional split on rejection status and the convergence point where both paths rejoin to continue."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicit closing statement mapped to the structural end node."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "'At the same time' implies parallel execution (AND branch), covering both concurrent steps and their implicit rejoin."
    }
  ],
