@startuml
!theme plain
|a_default| Default
|a_default|
start
:Resupply Cycle Triggered;
:Checking the Inventory Level;
:v1: Inventory level at or below the minimum? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Create Purchase Order;
:Review Purchase Order;
:Purchase Order approved?;
:v2: Purchase Order approved? ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:Reserve funds for purchase;
:Send Order to Suppliers;
:Supplier sends packing slip and invoice;
split
-> Packing Slip Received;
:Receive and record packing slip;
split again
-> Invoice Received;
:Receive and record invoice;
end split
:Release reserved funds and issue payment to supplier;
:End;
stop
else ([v2 = 'No'])
:Rework the order;
:Review Purchase Order;
endif
else ([v1 = 'No'])
:End;
stop
endif
@enduml