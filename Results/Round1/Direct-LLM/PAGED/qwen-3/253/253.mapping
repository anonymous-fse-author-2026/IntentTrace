{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "The initial trigger step directly supports both the process start and the first action node."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level. If the \"Inventory level is at or below the minimum\""
      ],
      "justification": "Action covers the inventory check step; the XOR branch structurally captures the conditional split introduced by the clause."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then proceed to Create Purchase Order"
      ],
      "justification": "Direct correspondence to the purchase order creation step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process ends."
      ],
      "justification": "Both the action step and the structural end node faithfully represent the early termination described."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Exact match for the review step following order creation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved",
        "Purchase Order is approved"
      ],
      "justification": "The action node explicitly models the condition check, and the XOR branch handles the subsequent flow split."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "then reserve the funds for the purchase."
      ],
      "justification": "Direct match for the fund reservation step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then rework the order."
      ],
      "justification": "Direct match for the rework step on the rejection path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Direct match for dispatching the order after funding."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Direct match for the loop-back review step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: the Supplier sends a packing slip and an invoice."
      ],
      "justification": "Action captures the supplier's activity; the AND branch correctly models the simultaneous execution requirement."
    },
    {
      "refs": [
        "action:n12",
        "label:b3->n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it."
      ],
      "justification": "Action and connection label precisely mirror the receipt and recording instructions."
    },
    {
      "refs": [
        "action:n13",
        "label:b3->n13"
      ],
      "verbatim_texts": [
        "Similarly, when the invoice is received, record it as well."
      ],
      "justification": "Action and connection label precisely mirror the receipt and recording instructions for the invoice."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice, release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "Converge node captures the synchronization of parallel paths; action matches the fund release and payment issuance."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Action and structural end node jointly represent the final process termination."
    }
  ],
