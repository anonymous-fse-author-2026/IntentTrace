  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process"
    },
    {
      "id": "i2",
      "content": "make a purchase and then connect to the website"
    },
    {
      "id": "i3",
      "content": "search for an item"
    },
    {
      "id": "i4",
      "content": "If they choose to \"Add item to cart\""
    },
    {
      "id": "i5",
      "content": "choose to \"Add item to cart\", they can proceed to checkout"
    },
    {
      "id": "i6",
      "content": "if they select \"Continue Shopping\""
    },
    {
      "id": "i7",
      "content": "select \"Continue Shopping\", they should continue with the process"
    },
    {
      "id": "i8",
      "content": "enter their address, shipping method, and payment information"
    },
    {
      "id": "i9",
      "content": "At the same time"
    },
    {
      "id": "i10",
      "content": "authorize the credit card and check the inventory levels"
    },
    {
      "id": "i11",
      "content": "If the credit card is approved and there is inventory in stock"
    },
    {
      "id": "i12",
      "content": "if the credit card is denied or there is no inventory in stock, the transaction will end"
    },
    {
      "id": "i13",
      "content": "In either case"
    },
    {
      "id": "i14",
      "content": "the order confirmation number should be displayed"
    },
    {
      "id": "i15",
      "content": "followed by the final order being shown to the customer"
    },
    {
      "id": "i16",
      "content": "Additionally, the order should be confirmed and a confirmation notice should be emailed to the customer"
    },
    {
      "id": "i17",
      "content": "Once the order entry is complete, the process will end"
    }
  ]
