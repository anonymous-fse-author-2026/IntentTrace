@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process by identifying the vacancy;
:Is there a suitable candidate available;
:v1: Is there a suitable candidate available ({true, false}); <<objectSignal>>
if () then ([v1 = false])
:advertise the vacancy;
repeat :Is there a suitable candidate available;
:v3: Is there a suitable candidate available ({true, false}); <<objectSignal>>
backward:advertise the vacancy again;
repeat while () is ([v3 = false]) not ([v3 = true])
else ([v1 = true])
->;
endif
:select the appropriate applicant;
:appoint the candidate;
stop
@enduml