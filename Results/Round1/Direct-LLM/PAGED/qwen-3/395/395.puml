start
:start;
:check referee reports status;
:are referee reports completed?;
:v1: are referee reports completed? ({Completed, Not completed}); <<objectSignal>>
if () then ([v1 = 'Not completed'])
:flag and send reminder;
-> Referee Reports still not completed;
repeat :check again if referee reports are completed;
:are referee reports completed after reminder?;
:v2: are referee reports completed after reminder? ({Completed, Still not completed}); <<objectSignal>>
backward:flag and send another reminder;
repeat while () is ([v2 = 'Still not completed']) not ([v2 = 'Completed'])
else ([v1 = 'Completed'])
->;
endif
:proceed with process;
:organize interviews for selection panel with top candidates;
:receive feedback from interview candidates;
:is psychometric test required?;
:v3: is psychometric test required? ({Required, Not required}); <<objectSignal>>
if () then ([v3 = 'Not required'])
:coordinate second round of selection;
-> Finalize process;
else ([v3 = 'Required'])
:check if HR specialist is required;
:v4: is HR specialist required? ({Required, Not required}); <<objectSignal>>
if () then ([v4 = 'Required'])
:schedule psychometric test with third party;
-> Finalize process;
else ([v4 = 'Not required'])
:complete psychometric test;
-> Finalize process;
endif
endif
:request final candidate ranking and continue process;
