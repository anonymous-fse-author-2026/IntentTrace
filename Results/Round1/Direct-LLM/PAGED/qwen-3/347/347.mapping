{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "Covers process initiation and the three sequential starting steps described in the opening unit."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
      ],
      "justification": "Captures the conditional check, XOR split, positive outcome guard, and report generation action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Represents the negative outcome guard and corresponding report generation action."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "Models the report check condition, split, positive guard, and PO creation action."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Captures the negative guard, process termination action, and end node."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Models the rejection check, split, positive guard, and rework action."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Represents the approval guard and print/release action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Faithfully captures the review requirement as a conditional action step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Directly represents the recreate requirement upon rework."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "Models the parallel execution via AND split and subsequent converge, along with both simultaneous actions."
    },
    {
      "refs": [
        "action:n23",
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Captures the fund reservation check, split, positive guard, and packing slip receipt action."
    },
    {
      "refs": [
        "action:n36"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Represents the inventory receipt step triggered by mailing."
    },
    {
      "refs": [
        "action:n27",
        "guard:b6->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Models the slip receipt check, split, positive guard, and invoice receipt action."
    },
    {
      "refs": [
        "action:n38",
        "guard:b8->n39",
        "action:n39"
      ],
      "verbatim_texts": [
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Captures the inventory receipt check, split, positive guard, and packing slip receipt action."
    },
    {
      "refs": [
        "action:n31",
        "guard:b7->n32",
        "action:n32"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Models the invoice receipt check, split, positive guard, and progression to matching."
    },
    {
      "refs": [
        "action:n42",
        "guard:b9->n43",
        "action:n43"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Captures the match success check, split, positive guard, and fund release action."
    },
    {
      "refs": [
        "action:n44"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Directly represents the payment issuance step."
    },
    {
      "refs": [
        "action:n45"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Models the cycle completion action and final process termination."
    }
  ],
  "mutations": [],
  "omissions": [],
  "additions": [],
