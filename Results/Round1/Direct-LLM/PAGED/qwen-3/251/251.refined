end(e1)
converge(c1)
branch(b1, XOR)
branch(b2, XOR)
defines(v_choice, "food selection", {salad, sausages, meat})
defines(v_enough, "enough to eat", {true, false})
actor(a_default, "Default", [i1, n1, n2, n3, n5, n6, n7, n8, n9, e1, c1, b1, b2])
precedence(i1, n1)
precedence(n1, n2)
