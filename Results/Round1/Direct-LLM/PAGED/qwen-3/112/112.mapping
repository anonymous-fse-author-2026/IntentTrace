{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "The opening clause implicitly triggers the process start and defines the initial registration action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "Captures the conditional check, the XOR split, the positive guard path, and the corresponding request action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "On the other hand, if an exception is not needed, the process can continue."
      ],
      "justification": "Maps the negative guard condition and the continuation action for the non-exception path."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->c1",
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "After the exception is approved, the next step is course enrollment, followed by seminar group enrollment."
      ],
      "justification": "Models the approval check as a decision point, routes the positive outcome, and executes the two subsequent enrollment steps in sequence."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the seminar group enrollment is completed, the homework assignment can be started."
      ],
      "justification": "Directly implements the start-homework action triggered by prior completion."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After working on the homework, it should be turned in."
      ],
      "justification": "Faithfully captures the submission step described in the source."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated, and the process can continue."
      ],
      "justification": "Accurately models the homework evaluation step."
    },
    {
      "refs": [
        "action:n12",
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Maps the loop condition check, the XOR branch, the false guard (not last), and the repeat assignment action."
    },
    {
      "refs": [
        "guard:b3->b5"
      ],
      "verbatim_texts": [
        "However, if it was the last homework, the process can continue."
      ],
      "justification": "The true guard (is last homework) correctly directs flow to the parallel split for final steps."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "Correctly models the concurrent execution (AND gateway) of the two specified administrative steps and their rejoinder."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After signing up for the exam, it should be attended."
      ],
      "justification": "Sequentially captures both the registration and attendance actions for the exam."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once the exam is attended, it will be evaluated."
      ],
      "justification": "Directly implements the post-exam evaluation step."
    },
    {
      "refs": [
        "action:n21",
        "guard:b4->n22",
        "action:n22",
        "action:n25"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue."
      ],
      "justification": "Models the pass/fail decision, routes the positive outcome, marks the course as passed, and continues the flow."
    },
    {
      "refs": [
        "guard:b4->n23"
      ],
      "verbatim_texts": [
        "However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Maps the negative exam outcome guard and the retry sign-up action. Both identical source spans are covered."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "If the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Maps the negative exam outcome guard and the retry sign-up action. Both identical source spans are covered."
    }
  ],
