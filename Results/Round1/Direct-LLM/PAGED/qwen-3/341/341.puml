@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start loan application process by receiving the loan application;
split
:Assess loan risk;
split again
:Check credit history;
end split
:Assess eligibility of applicant;
:v1: Is applicant eligible ({eligible, not eligible}); <<objectSignal>>
