{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Opening clause implicitly triggers the init node and directly supports the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\""
      ],
      "justification": "Condition captured as a decision-style action node alongside the implicit XOR branch."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then we can continue the process."
      ],
      "justification": "Direct restatement of the positive outcome continuation."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the \"Delivery Crew picks-up items at the event site,\""
      ],
      "justification": "Alternative condition captured as a decision action with its structural branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then we also continue the process."
      ],
      "justification": "Matches the continuation step for the delivery crew path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Faithful paraphrase of the counting and comparison task."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\""
      ],
      "justification": "Completion condition modeled as a decision action and branch."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then we proceed with the process."
      ],
      "justification": "Direct match for the proceeding step on the complete-order path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the \"Order is incomplete and items are missing,\""
      ],
      "justification": "Incomplete order condition mapped to decision action and branch."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "we still continue the process."
      ],
      "justification": "Continuation step for the incomplete-order arm."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Similarly, if the \"Order is complete but items are damaged,\""
      ],
      "justification": "Damaged-items condition captured as decision action and branch."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Exact match for the notification action following damage detection."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\""
      ],
      "justification": "Packing condition mapped to decision action and branch."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "we continue the process."
      ],
      "justification": "Continuation step for the existing-order packing path."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Alternatively, if the \"Items are stored for future orders,\""
      ],
      "justification": "Storage condition supports the decision action, branch, and implied continuation step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges,"
      ],
      "justification": "Missing-item charge condition captured as decision action and branch."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "we email the customer to inform them."
      ],
      "justification": "Direct match for the email notification action."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges,"
      ],
      "justification": "Damaged-item charge condition mapped to decision action and branch."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "we temporarily take them out of inventory."
      ],
      "justification": "Exact match for the inventory removal step."
    },
    {
      "refs": [
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "Positive return condition supports the decision action, branch, and continuation step."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Negative return condition and its continuation captured in a single action step."
    },
    {
      "refs": [
        "action:n33"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Explicit termination statement justifies both the end node and closing action."
    },
    {
      "refs": [
        "action:n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\""
      ],
      "justification": "Repair condition maps to decision action, branch, and post-repair continuation."
    },
    {
      "refs": [
        "action:n26",
        "action:n27"
      ],
      "verbatim_texts": [
        "On the other hand, if the \"Items can't be repaired and are discarded,\""
      ],
      "justification": "Discard condition maps to decision action, branch, and subsequent email action for charges."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "we email the customer with replacement charges."
      ],
      "justification": "Shares justification with previous entry; directly supports the email payload."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order."
      ],
      "justification": "Final packing statement paraphrased into a decision-style action."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\""
      ],
      "justification": "Repeating pack condition maps to branch and continuation action."
    },
    {
      "refs": [
        "action:n30",
        "action:n31"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\""
      ],
      "justification": "Repeating store condition maps to decision action, branch, and continuation."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges,"
      ],
      "justification": "Final charge email step directly matched."
    }
  ],
