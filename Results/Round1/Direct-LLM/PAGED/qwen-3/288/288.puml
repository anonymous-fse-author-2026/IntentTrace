@startuml
!theme plain
|a_default| review clerk
|a_default|
start
:review the received application;
:load the case data;
:review the case;
:are there any new findings;
:v1: are there any new findings ({true, false}); <<objectSignal>>
if () then ([v1 = true])
:recalculate the refund;
else ([v1 = false])
:send a letter of denial;
endif
:are there any new findings;
:v2: are there any new findings ({true, false}); <<objectSignal>>
if () then ([v2 = true])
:recalculate the refund;
else ([v2 = false])
:send another letter of denial;
endif
:write back the case data;
stop
@enduml