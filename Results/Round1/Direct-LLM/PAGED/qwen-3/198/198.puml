@startuml
!theme plain
|a_part_provision_team| Part Provision Team
|a_part_provision_team|
start
:identify the parts;
:v1: does team need to elicit information from the customer ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:check availability of parts;
else ([v1 = 'No'])
->;
endif
:v2: need to record customer's details ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:order and receive part from Disuki;
else ([v2 = 'No'])
->;
endif
:contract the customer;
:collect necessary parts;
:proceed with payment;
stop
@enduml