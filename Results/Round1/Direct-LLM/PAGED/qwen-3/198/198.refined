action(n7, "contract the customer")
action(n10, "collect necessary parts")
action(n8, "proceed with payment")
end(e1)
defines(v1, "does team need to elicit information from the customer", {"Yes", "No"})
defines(v2, "need to record customer's details", {"Yes", "No"})
actor(a_part_provision_team, "Part Provision Team", [i1, n2, b1, n4, c1, b2, n6, c2, n7, n10, n8, e1])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, c1)
precedence(n4, c1)
