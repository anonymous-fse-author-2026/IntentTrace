      ],
      "verbatim_texts": [
        "For EC-Lille: Initially,"
      ],
      "justification": "The opening clause implicitly establishes the process start."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
