      ],
      "justification": "Two sequential actions and the negative-branch guard collectively implement the full alternative instruction."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Validation action, satisfaction check action, and subsequent decision branch align exactly with the compound sentence."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "The action and its guard correctly model the unsatisfactory schedule retry path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory",
        "then \"provide indications\"."
      ],
      "justification": "The status check, XOR branch, indication action, and positive guard accurately reflect the repeated failure handling."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory",
        "then \"provide indications\"."
      ],
      "justification": "The status check, XOR branch, indication action, and positive guard accurately reflect the repeated failure handling."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory",
        "then \"provide indications\"."
      ],
      "justification": "The status check, XOR branch, indication action, and positive guard accurately reflect the repeated failure handling."
    },
    {
