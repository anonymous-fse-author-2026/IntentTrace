@startuml
!theme plain
|a_default| I
|a_default|
start
:feel stressed;
:go on vacation decision;
:v1: go on vacation decision ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:resign from job;
stop
else ([v1 = 'Yes'])
:select travel method;
:v2: select travel method ({Plane, Car}); <<objectSignal>>
if () then ([v2 = 'Plane'])
:book tickets;
:tickets successfully booked;
else ([v2 = 'Car'])
:book hotel;
:hotel successfully booked;
endif
:pack luggage;
:take luggage to car;
stop
endif
@enduml