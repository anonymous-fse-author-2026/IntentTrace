{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "The opening clause initiates the process, describes the start action, and specifies the first two sequential tasks."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "The XOR branch captures the completeness decision, the guard routes the positive case, and the action executes the return."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "The guard routes the negative completeness case, and the action faithfully restates the continuation instruction."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "The XOR branch element implements the decision point that gates the subsequent compliance checks."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "The guard selects the phone-call resolution path, and the action performs the stated resolution."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "The guard selects the mail-back path, and the action executes the corresponding return."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "'Simultaneously' mandates an AND split, the action maps to 'Bill Client', and the converge node captures the implicit rejoining after parallel completion."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "The branch evaluates response status, the guard catches the 'no response' case, and the action implements the waiting period."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Direct paraphrase capturing both payment and notification in a single action step."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "The guard routes the alternative/timeout path, the action sends the reminder, and the end node matches the explicit termination statement."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "The branch assesses client satisfaction, the guard selects the negative case, and the action resolves the discrepancy."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "The guard routes the positive satisfaction case, and the action restates the continuation instruction."
    }
  ],
