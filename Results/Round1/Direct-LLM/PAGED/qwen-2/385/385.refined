init(i1)
action(n2, "Commence reference check")
action(n3, "Check applicants referees")
action(n4, "Is referee report complete")
branch(b1, XOR)
action(n6, "Send Complete Referee Report to archive applications")
action(n7, "Evaluate and rank candidates")
end(e1)
end(e2)
defines(v1, "Is referee report complete", {"Complete", "Incomplete"})
actor(a_default, "Casual Admin Assistant", [i1, n2, n3, n4, b1, e1, n6, n7, e2])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, e1)
precedence(b1, n6)
precedence(n6, n7)
precedence(n7, e2)
guard(b1, e1, v1 = 'Incomplete')
guard(b1, n6, v1 = 'Complete')