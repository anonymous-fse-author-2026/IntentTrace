@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:Receive and Categorize Invoice;
:v1: Instruction ({Forward Invoice to Admin Officer, Reject invoice, Return invoice to client for completion, Process Invoice for SAP Entry}); <<objectSignal>>
switch ()
case ([v1 = 'Forward Invoice to Admin Officer'])
:Sort Invoice;
stop
case ([v1 = 'Reject invoice'])
:Reject Invoice;
stop
case ([v1 = 'Return invoice to client for completion'])
:Return Invoice to Client for Completion;
:Receive and Categorize Invoice;
case ([v1 = 'Process Invoice for SAP Entry'])
:Process Invoice for SAP Entry;
:Forward Invoice for Validation;
:Validate Invoice;
stop
endswitch
@enduml