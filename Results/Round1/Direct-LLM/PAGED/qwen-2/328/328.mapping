      "verbatim_texts": [
        "To begin the process, the customer should first request information about the organization and then schedule an appointment."
      ],
      "justification": "The opening clause triggers the process start and explicitly describes the two sequential initial actions, which are faithfully captured."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the customer is in the \"Intake\" stage, they should proceed with \"Control and measurement\"."
      ],
      "justification": "The conditional logic establishes the XOR branch, which is split by the guard capturing the Intake condition and directing flow to the matching action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the customer is a \"Potential client\", the process will come to an end."
      ],
      "justification": "Captures the alternative branch condition, the explicit termination action labeled with the path reason, and the structural end node."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After the \"Control and measurement\" stage, the customer should revisit after two weeks."
      ],
      "justification": "Directly reproduces the follow-up step and its specific two-week timeframe."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the target has been reached, the process will come to an end."
      ],
      "justification": "Models the second decision point, the success condition on the guard, the termination action, and the corresponding end node."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if the customer is dissatisfied or for any other reason, the process will also come to an end."
      ],
      "justification": "Captures the alternative/failure condition, the corresponding termination action, and the structural end node."
    }
  ],
