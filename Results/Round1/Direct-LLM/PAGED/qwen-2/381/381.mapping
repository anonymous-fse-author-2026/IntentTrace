      "verbatim_texts": [
        "To begin with,",
        "choose your destination and calculate the distance"
      ],
      "justification": "Implicit process start followed by direct paraphrase of the initial planning task."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "continue to check if you need to book a train or a flight"
      ],
      "justification": "Describes the verification step and implicitly establishes the exclusive split between transport options."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the answer is \"no\", then proceed to book a train. However, if the answer is \"yes\", then book a flight."
      ],
      "justification": "Guards capture the explicit yes/no conditions; actions faithfully execute the corresponding booking instructions."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours",
        "the process will end"
      ],
      "justification": "Models the timing condition check, captures the positive outcome state, and correctly terminates the flow."
    },
