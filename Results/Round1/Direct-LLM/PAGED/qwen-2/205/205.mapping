{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the process for ACME Company, the Resupply Cycle is triggered"
      ],
      "justification": "The opening clause implicitly triggers the process start (init) and explicitly describes initiating the Resupply Cycle (action)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level"
      ],
      "justification": "Direct correspondence to the inventory checking step."
    },
    {
      "refs": [
        "guard:b1->c2"
      ],
      "verbatim_texts": [
        "If the Inventory is greater than the Minimum Level"
      ],
      "justification": "The conditional clause establishes the XOR decision point and the positive guard condition."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, a Purchase Order is created."
      ],
      "justification": "The 'Otherwise' clause maps to the negative guard path and the subsequent creation action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "The Purchase Order is then reviewed."
      ],
      "justification": "Exact match for the review step."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected"
      ],
      "justification": "Establishes the second decision point and the rejection guard."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "it is reworked."
      ],
      "justification": "Direct match for the rework action on the rejection path."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "However, if the Purchase Order is accepted"
      ],
      "justification": "Captures the acceptance condition for the alternative path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "funds are reserved for payment."
      ],
      "justification": "Direct match for the fund reservation action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reserving funds for payment, the Purchase Order is sent to the Supplier."
      ],
      "justification": "Faithfully restates the post-review sending step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed:"
      ],
      "justification": "The concurrency keyword directly implies the AND branch node."
    },
    {
      "refs": [
        "action:n9",
        "action:n11"
      ],
      "verbatim_texts": [
        "the Packing Slip is received and the Invoice is received."
      ],
      "justification": "The compound statement splits into two parallel receipt actions."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Upon receiving the Packing Slip, it is recorded."
      ],
      "justification": "Exact match for recording the packing slip."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Similarly, upon receiving the Invoice, it is recorded."
      ],
      "justification": "Exact match for recording the invoice."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the funds are released for payment,"
      ],
      "justification": "Direct match for the fund release step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "the payment is issued to the Supplier."
      ],
      "justification": "Exact match for issuing the payment."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, the process ends with the issuance of payment to the Supplier."
      ],
      "justification": "Explicitly signals the termination of the process."
    }
