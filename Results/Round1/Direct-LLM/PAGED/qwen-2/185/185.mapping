{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "The opening clause implicitly starts the process (init) and describes the first action (receiving the invoice)."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "it is sorted per client."
      ],
      "justification": "Direct paraphrase of the sorting step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor."
      ],
      "justification": "Direct paraphrase of the second sorting step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice."
      ],
      "justification": "Exact restatement of the attachment step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form."
      ],
      "justification": "Direct paraphrase of the data entry step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked."
      ],
      "justification": "Exact restatement of the completeness check."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "The conditional triggers the XOR branch, the guard captures the negative state, and the action reflects the termination outcome."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered."
      ],
      "justification": "The guard captures the positive state, the redundant state node models the branch outcome, and the action executes the SLA entry."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "The date for completion is also entered and the priority is checked."
      ],
      "justification": "The single source sentence cleanly splits into two sequential actions."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "Branch handles the decision, guard/action capture the high-priority condition, and final action applies the stamp."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Guard and state action accurately reflect the low-priority continuation path."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Direct paraphrase of the compliance check step."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If it is not complete, the check continues."
      ],
      "justification": "Branch and guard handle the incomplete condition, while the action captures the continuation logic."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is complete, the process continues."
      ],
      "justification": "Guard and state action model the complete compliance path."
    },
    {
      "refs": [
        "action:n19",
        "guard:b5->n20",
        "action:n20",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Action models the conditional check, branch/guard state the experienced-staff route, and final action processes the non-compliant invoice."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21",
        "action:n23"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Guard/action define the normal-case path, leading to the client call."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Captures the fallback condition, the mailing action, and explicitly models the process termination."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Direct paraphrase of the final client outreach step."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO, and the process ends."
      ],
      "justification": "Action covers batching/allocation, and structural end node matches the explicit process termination."
    }
  ],
