init(i1)
action(n1, "make appointment at hairdresser's")
action(n2, "go to hairdresser")
branch(b1, XOR)
action(n4, "wash hair")
branch(b2, XOR)
action(n6, "dye hair")
branch(b3, XOR)
action(n8, "cut hair")
action(n9, "pay hairdresser")
end(e1)
converge(c1)
converge(c2)
converge(c3)
defines(v1, "need hair washed?", {"Yes", "No"})
defines(v2, "want hair dyed?", {"Yes", "No"})
defines(v3, "need haircut?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, b2, n6, b3, n8, n9, e1, c1, c2, c3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, c1)
precedence(n4, c1)
precedence(c1, b2)
precedence(b2, n6)
precedence(b2, c2)
precedence(n6, c2)
precedence(c2, b3)
precedence(b3, n8)
precedence(b3, c3)
precedence(n8, c3)
precedence(c3, n9)
precedence(n9, e1)
guard(b1, n4, v1 = 'Yes')
guard(b1, c1, v1 = 'No')
guard(b2, n6, v2 = 'Yes')
guard(b2, c2, v2 = 'No')
guard(b3, n8, v3 = 'Yes')
guard(b3, c3, v3 = 'No')