      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step,"
      ],
      "justification": "Opening clause implicitly signals process start and defines the initial triggering action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
