precedence(b3, n12)
precedence(n12, n13)
precedence(n13, e3)
precedence(b3, n14)
precedence(n14, n15)
precedence(n15, e4)
guard(b1, n4, v1 = 'Resolved')
guard(b1, n6, v1 = '1st Level Issue')
guard(b2, n8, v2 = 'Resolved')
guard(b2, n10, v2 = '1st Level Issue')
