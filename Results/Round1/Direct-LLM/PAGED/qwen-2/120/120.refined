action(n12, "Provide feedback for account manager")
action(n13, "End process")
end(e3)
action(n14, "Provide feedback for the 1st Level support")
action(n15, "Provide feedback for the account manager")
end(e4)
defines(v1, "Is the issue resolved?", {"Resolved", "1st Level Issue"})
defines(v2, "Is the issue resolved now?", {"Resolved", "1st Level Issue"})
defines(v3, "Is the issue resolved after re-assistance?", {"Resolved", "1st Level Issue"})
actor(a_support, "1st Level Support", [i1, n1, n2, n3, b1, n5, n9, n13, e1, e2, e3])
actor(a_dev, "Developer", [n6, n7, b2, n10, n11, b3])
actor(a_am, "Account Manager", [n4, n8, n12, n14, n15, e4])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(n4, n5)
precedence(n5, e1)
