init(i1)
action(n1, "start")
action(n2, "Ask 1st Level Support if there is an issue")
action(n3, "Is the issue resolved?")
branch(b1, XOR)
action(n4, "Provide feedback for account manager")
action(n5, "End process")
end(e1)
action(n6, "Ask developer for assistance")
action(n7, "Is the issue resolved now?")
branch(b2, XOR)
action(n8, "Provide feedback for account manager")
action(n9, "End process")
end(e2)
action(n10, "Ask developer for help again")
action(n11, "Is the issue resolved after re-assistance?")
