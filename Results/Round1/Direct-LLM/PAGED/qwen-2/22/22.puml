@startuml
!theme plain
|a_default| Default
|a_default|
start
:Receive Order Request;
:Register Order;
:Evaluate Order;
:v1: Evaluate Order ({NOK, ok}); <<objectSignal>>
if () then ([v1 = 'NOK'])
:End: Evaluation Failed;
stop
else ([v1 = 'ok'])
:Install Order;
:v2: Installation Result ({unsuccessful, successful}); <<objectSignal>>
if () then ([v2 = 'successful'])
:Installation Check;
:Prepare Billing;
:v3: Final Verification ({in order, issue found}); <<objectSignal>>
if () then ([v3 = 'in order'])
:Mark as Ok;
stop
else ([v3 = 'issue found'])
stop
endif
else ([v2 = 'unsuccessful'])
:End: Installation Failed;
stop
endif
endif
@enduml