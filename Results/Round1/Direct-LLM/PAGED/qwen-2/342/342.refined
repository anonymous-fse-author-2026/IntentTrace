init(i1)
action(n2, "gather information about part from customer including make model and year")
action(n3, "is part available in local inventory")
branch(b1, XOR)
action(n4, "retrieve part from local inventory")
end(e1)
action(n6, "record customer details")
action(n7, "order part from Disuki")
end(e2)
defines(v1, "is part available in local inventory", {"available", "not available"})
actor(a_default, "DMS Parts Provision Team", [i1, n2, n3, b1, n4, e1, n6, n7, e2])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(n4, e1)
precedence(b1, n6)
precedence(n6, n7)
precedence(n7, e2)
guard(b1, n4, v1 = 'available')
guard(b1, n6, v1 = 'not available')