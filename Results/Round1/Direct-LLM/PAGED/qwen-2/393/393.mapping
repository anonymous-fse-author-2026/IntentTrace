{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For TS recruitment, the first step is to advise unsuccessful candidates."
      ],
      "justification": "Init implicitly starts the process; action faithfully restates the first step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n5",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\", then the position should be re-advertised."
      ],
      "justification": "Action and branch capture the decision point; guards and action align with the condition and outcome."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "if the terms and conditions of the offer for a candidate need to be sorted out"
      ],
      "justification": "Elements model the conditional check for terms and conditions along with its yes/no paths."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form, which is then received by the next level manager."
      ],
      "justification": "Action directly paraphrases the sending step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If the manager is an external resource, they may not authorize the form."
      ],
      "justification": "Elements capture the external resource condition and its implication."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the approver is an existing employee of the client, the process continues."
      ],
      "justification": "Guard and action align with the internal employee continuation path."
    },
    {
      "refs": [
        "guard:b4->n11",
        "guard:b4->c1",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the form is approved, the recruitment manager sends the form and other documentation, which is received by the client HR."
      ],
      "justification": "Branch and guards model the approval decision; action captures the approval step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "justification": "Action faithfully reproduces the scanning and recording instruction."
    },
    {
      "refs": [
        "action:n15",
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If there are any variations, a complete business case is required."
      ],
      "justification": "Elements model the variation check and the resulting business case creation."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "Otherwise, the process continues."
      ],
      "justification": "Guard and action align with the fallback continuation."
    },
    {
      "refs": [
        "action:n18",
        "guard:b6->n19"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate."
      ],
      "justification": "Elements combine the condition and rate applicability into the decision node and guard."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "For the step of the Preferred Candidate's medical assessments, it is important to note that it can take up to 21 days to arrange and complete."
      ],
      "justification": "Action directly states the arrangement and 21-day duration."
    },
    {
      "refs": [
        "action:n21",
        "guard:b7->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory, the next candidate on the shortlist should be contacted."
      ],
      "justification": "Elements model the unsatisfactory assessment condition and contacting the next candidate."
    },
    {
      "refs": [
        "guard:b7->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "if the assessment is fine, the process continues."
      ],
      "justification": "Guard and action align with the satisfactory assessment path."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "The recruitment manager makes a formal verbal offer of employment to the candidate."
      ],
      "justification": "Action faithfully restates the verbal offer step."
    },
    {
      "refs": [
        "action:n25",
        "guard:b8->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If the candidate accepts, the recruitment manager creates a formal written offer."
      ],
      "justification": "Elements capture the acceptance condition and creation of the written offer."
    },
    {
      "refs": [
        "guard:b8->n27",
        "action:n27"
      ],
      "verbatim_texts": [
        "If the candidate declines, the process continues."
      ],
      "justification": "Guard and action align with the decline continuation."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Simultaneously, the commencement pack and letter of appointment are sent to the candidate."
      ],
      "justification": "Action captures the sending of documents."
    },
    {
      "refs": [
        "action:n29",
        "guard:b9->n30",
        "action:n30"
      ],
      "verbatim_texts": [
        "if there is a \"40%\" rate, renegotiation is required."
      ],
      "justification": "Elements model the 40% rate condition and renegotiation requirement."
    },
    {
      "refs": [
        "guard:b9->c4",
        "guard:b11->n18",
        "action:n33"
      ],
      "verbatim_texts": [
        "Otherwise, if the candidate accepts, the process continues."
      ],
      "justification": "Guards and action collectively model the otherwise condition, acceptance check, and continuation."
    },
    {
      "refs": [
        "action:n31",
        "guard:b10->n33",
        "action:n33"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful, the process continues."
      ],
      "justification": "Elements capture the success condition and continuation."
    },
    {
      "refs": [
        "guard:b10->n32",
        "action:n32"
      ],
      "verbatim_texts": [
        "if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified."
      ],
      "justification": "Guard and action align with the unsuccessful renegotiation outcome."
    },
    {
      "refs": [
        "action:n34",
        "guard:b11->c4"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Action, end node, and guard jointly represent the process termination."
    }
  ],
  "mutations": [
    {
      "refs": [
        "action:n14",
        "action:n20"
      ],
      "verbatim_texts": [
        "The TS HR coordinator informs the recruitment manager, who then liaises with the HR representative to confirm the offer to the candidate."
      ],
      "reason": "Both action elements drop the critical qualifier \"to confirm the offer to the candidate,\" altering the specific purpose and target of the liaison step."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "it is necessary to check if the candidate has accepted a voluntary redundancy."
      ],
      "reason": "No element models the mandatory check for voluntary redundancy acceptance."
    },
    {
      "verbatim_texts": [
        "If the candidate has not accepted, the process continues."
      ],
      "reason": "The continuation path following a non-acceptance of voluntary redundancy is missing."
    },
    {
      "verbatim_texts": [
        "if the candidate has accepted, further investigation is required."
      ],
      "reason": "The requirement for further investigation upon acceptance of voluntary redundancy is absent."
    }
  ],
  "additions": [
    {
      "refs": [
        "action:n1"
      ],
      "reason": "The 'start' action has no corresponding instruction in the source text; the process initiation is implicitly covered by init:i1."
    },
    {
      "refs": [
        "action:n10"
      ],
      "reason": "Checks for external approver authorization are invented; the source only mentions external managers potentially not authorizing, without a dedicated verification step."
    },
    {
      "refs": [
        "guard:b8->c4"
      ],
      "reason": "The 'pending' guard value introduces a third outcome not described in the source, which only specifies accept or decline."
    },
    {
      "refs": [
        "guard:b6->c2"
      ],
      "reason": "No supporting verbatim portion was mapped from the input text.",
      "source_line": "guard b6->c2: v6 = 'no'"
    }
  ],
