  "input_elements": [
    {
      "id": "i1",
      "content": "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
    },
    {
      "id": "i2",
      "content": "If the expense is greater than 1000, the report should be reviewed."
    },
    {
      "id": "i3",
      "content": "if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
    },
    {
      "id": "i4",
      "content": "If translation is required, proceed to translate the receipts. If not, confirm the receipts."
    },
    {
      "id": "i5",
      "content": "After this, evaluate the review decision."
    },
    {
      "id": "i6",
      "content": "If the report is rejected, edit the report."
    },
    {
      "id": "i7",
      "content": "If it is approved, continue to check if there is a need for translation."
    },
    {
      "id": "i8",
      "content": "Once again, evaluate the review decision. If the report is rejected, edit the report."
    },
    {
      "id": "i9",
      "content": "If it is approved, translate the receipts and then confirm them."
    },
    {
      "id": "i10",
      "content": "Finally, evaluate the receipts decision."
    },
    {
      "id": "i11",
      "content": "If the receipts are accepted, proceed to process the expense."
    },
    {
      "id": "i12",
      "content": "If they are rejected, edit the report."
    },
    {
      "id": "i13",
      "content": "The process ends by processing the expense and then ending it."
    }
  ]
}