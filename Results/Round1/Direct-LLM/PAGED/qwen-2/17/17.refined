init(i1)
action(n1, "start the process with receiving an order request")
action(n2, "register the order")
action(n3, "evaluate the order")
branch(b1, XOR)
action(n5, "order is NOK end process")
end(e1)
action(n6, "perform installation process")
branch(b2, XOR)
action(n8, "order is NOK end process")
end(e2)
action(n9, "check installation")
action(n10, "prepare billing")
action(n11, "mark order as ok and complete process")
end(e3)
defines(v1, "is evaluation result ok", {"ok", "NOK"})
defines(v2, "is installation successful", {"successful", "not successful"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n5, e1, n6, b2, n8, e2, n9, n10, n11, e3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(b1, n6)
precedence(n6, b2)
precedence(b2, n8)
precedence(b2, n9)
precedence(n9, n10)
precedence(n10, n11)
precedence(n5, e1)
precedence(n8, e2)
precedence(n11, e3)
guard(b1, n5, v1 = 'NOK')
guard(b1, n6, v1 = 'ok')
guard(b2, n8, v2 = 'not successful')
guard(b2, n9, v2 = 'successful')