    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the evaluation result is \"NOK\""
      ],
      "justification": "XOR gateway and negative guard accurately model the initial failure condition and threshold."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the order is considered as \"NOK\" and the process comes to an end."
      ],
      "justification": "Action and terminator correctly implement the immediate rejection path and process halt."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if the evaluation result is \"ok\""
      ],
      "justification": "Positive guard precisely matches the alternative evaluation outcome."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then the installation process takes place."
      ],
      "justification": "Direct mapping to the installation initiation step."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the installation is not successful"
      ],
      "justification": "Secondary XOR gateway and guard correctly model the installation failure condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the order is considered as \"NOK\" and the process ends."
      ],
      "justification": "Action and terminator correctly implement the secondary rejection path and process halt."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "if the installation is successful"
      ],
      "justification": "Success guard precisely matches the positive installation outcome."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the next step is to check the installation."
      ],
      "justification": "Exact alignment with the post-installation verification inspection step."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "Finally, if everything is in order, the order is marked as \"ok\" and the process is completed."
      ],
      "justification": "Structural end node correctly marks the process termination point described in the closing clause."
    }
  ],
  "mutations": [
