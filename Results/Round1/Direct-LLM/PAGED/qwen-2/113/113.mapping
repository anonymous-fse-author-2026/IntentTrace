{
  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start by claiming what is requested and then check the insured status of the claimant."
      ],
      "justification": "The opening clause initiates the process, describes the initial claim action, and specifies the status check action."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the claimant is insured, proceed to evaluate the claim."
      ],
      "justification": "Captures the insured condition check, the XOR branch, the positive guard value, and the subsequent evaluation action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the claimant is not insured, reject the claim."
      ],
      "justification": "Maps directly to the negative guard condition and the rejection action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the claim is rejected, notify the claimant and the process comes to an end."
      ],
      "justification": "Faithfully represents the notification step and the first terminal point of the process."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n10",
        "guard:b2->n11",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the claim is a simple one or a complex one, send the relevant forms accordingly."
      ],
      "justification": "Models the type evaluation, the exclusive choice, both branch guards, and the two corresponding form-distribution actions."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the forms are returned, check them for completeness."
      ],
      "justification": "The convergence node represents the rejoining of the parallel form paths, and the action captures the completeness verification."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided, proceed to register the claim."
      ],
      "justification": "Corresponds to the details validation step, the decision branch, the affirmative guard, and the registration action."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "However, if not all the relevant details are provided, inform the claimant to complete them."
      ],
      "justification": "Aligns with the negative guard outcome and the instruction to the claimant."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Once the claim is registered, the process comes to an end."
      ],
      "justification": "Structural end node correctly marks the final termination described in the closing sentence."
    }
  ],
