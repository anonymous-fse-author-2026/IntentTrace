      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "Opening clause establishes the process start and defines the initial registration step."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If an exception is needed"
      ],
      "justification": "Conditional phrasing triggers the XOR branch and the positive guard path; condition correctly modeled as an action step per explicit instructions."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then a Request for the exception should be made."
      ],
      "justification": "Direct mapping to the required action on the positive branch."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if an exception is not needed, the process can continue."
      ],
      "justification": "Negative condition and subsequent continuation step accurately captured."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "the process can continue."
      ],
      "justification": "Standalone continuation instruction mapped to the corresponding action node."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "After the exception is approved,"
      ],
      "justification": "Approval condition initiates the next decision point and defines the approved-guard path; condition modeled as action per explicit instructions."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the next step is course enrollment,"
      ],
      "justification": "Direct mapping to the enrollment action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "followed by seminar group enrollment."
      ],
      "justification": "Direct mapping to the seminar enrollment step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the homework assignment can be started."
      ],
      "justification": "Exact alignment with the homework initiation step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "it should be turned in."
      ],
      "justification": "Direct mapping to the submission step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated,"
      ],
      "justification": "Exact alignment with the evaluation step."
    },
    {
      "refs": [
        "action:n12",
        "guard:b3->n13",
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "If it was not the last homework,"
      ],
      "justification": "Decision point and both guards (not last / last) derive from this conditional statement."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "another homework assignment will be given."
      ],
      "justification": "Direct mapping to the loop-back homework assignment."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "At the same time,"
      ],
      "justification": "Concurrency marker correctly triggers the AND gateway."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed:"
      ],
      "justification": "Preparatory phrase summarizing the upcoming parallel tasks."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "granting accreditation and announcing the date of the exam."
      ],
      "justification": "Conjoined tasks correctly split into two parallel actions."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "After signing up for the exam,"
      ],
      "justification": "Direct mapping to the exam registration step."
    },
    {
