{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "i1: To begin the process, start by checking the customer's order."
      ],
      "justification": "init denotes process commencement; action n2 performs the explicit initial check."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "i2: If the customer is a registered customer, then check their payment morale."
      ],
      "justification": "n3 states registration check, b1 creates XOR split, guard routes affirmative path, n4 executes morale verification."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "i3: If they are a new customer, then check their status."
      ],
      "justification": "n5 faithfully implements the consequent status check action."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "i4: If their payment morale is good, continue with the process."
      ],
      "justification": "n6 captures morale condition, b2 splits flow, guard routes good outcome, n10 continues execution."
    },
    {
      "refs": [
        "guard:b2->c1",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "i5: If their payment morale is bad or if they are an end customer, reject the order and end the process."
      ],
      "justification": "Guard handles bad morale branch; n8 rejects, n9 terminates, e1 marks process end."
    },
    {
      "refs": [
        "action:n7",
        "action:n11"
      ],
      "verbatim_texts": [
        "i6: If the customer is a wholesaler, enter their data and take the order."
      ],
      "justification": "n7 evaluates wholesaler status; n11 records data and accepts order."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "i7: At the same time, check the availability of the items."
      ],
      "justification": "b3 (AND) enforces concurrent execution; n12 verifies item availability."
    },
    {
      "refs": [
        "action:n13",
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "i8: If the items are out of stock, start production."
      ],
      "justification": "n13 queries stock level, b4 diverges flow, guard selects shortage path, n15 initiates manufacturing."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "i9: If they are in stock, continue with the process."
      ],
      "justification": "Guard directs in-stock scenario; n14 proceeds workflow."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "i10: Once the availability is checked, send the order confirmation."
      ],
      "justification": "Directly models post-check confirmation dispatch."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "i11: If production is started, produce the article and send the order confirmation."
      ],
      "justification": "n17 manufactures item; n18 transmits confirmation as instructed."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "i12: Simultaneously, send the invoice and deliver the product."
      ],
      "justification": "n19 consolidates billing and shipping; b8 (AND) mandates parallel handling."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "i14: If payment is received, close the order."
      ],
      "justification": "Branch/guard manage receipt routing; n21 finalizes order closure."
    },
    {
      "refs": [
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "i16: If there are more than three reminders, engage a lawyer."
      ],
      "justification": "b6 forks reminder count; guard targets excess threshold; n24 initiates legal involvement."
    },
    {
      "refs": [
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "i17: If there are three or fewer reminders, send a reminder."
      ],
      "justification": "Guard filters low count; n26 generates follow-up notice."
    }
