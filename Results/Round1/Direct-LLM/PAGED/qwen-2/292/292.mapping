{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To start the process"
      ],
      "justification": "Explicit starting instruction maps directly to the init node."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin by receiving the claim."
      ],
      "justification": "Content faithfully restates the first operational step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Direct correspondence in content and instructional sequence."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "Action captures the explicit decision step; branch structurally represents the resulting XOR split."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "Guard encodes the rejection condition; action executes the corresponding rejection step."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "Guard captures the acceptance condition; subsequent actions model the acceptance state and the benefit offer."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Directly matches the review instruction following rejection."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Faithfully reproduces the instruction to prepare discharge upon acceptance."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Directly corresponds to recording the payment after discharge preparation."
    },
    {
      "refs": [
        "guard:b2->n16",
        "action:n16",
        "guard:b2->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process. But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Branch and guards model the exclusive choice on rejection status; actions capture the stated conditional outcomes."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Structural end node directly matches the explicit closing statement."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "Both actions directly correspond to the specified concurrent steps."
    }
  ],
