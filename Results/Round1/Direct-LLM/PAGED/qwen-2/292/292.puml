@startuml
!theme plain
|a_default| Default
|a_default|
start
:receive claim;
:create and record claim;
:decide on claim;
:v1: decide on claim ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:reject claim;
:review rejection;
:v2: claim rejection decision ({Accepted, Not Accepted}); <<objectSignal>>
if () then ([v2 = 'Accepted'])
:rejection accepted;
else ([v2 = 'Not Accepted'])
:rejection not accepted;
endif
else ([v1 = 'Yes'])
:accept claim;
:offer benefit;
:prepare discharge;
:record payment;
endif
:operate outgoing payment;
:close the claim;
stop
@enduml