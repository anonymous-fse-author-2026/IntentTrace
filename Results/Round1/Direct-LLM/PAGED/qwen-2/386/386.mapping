{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we receive the contract for the marketing campaign."
      ],
      "justification": "The opening clause explicitly starts the process and describes the first action, both captured faithfully."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once we have the contract, we take it to the department."
      ],
      "justification": "Exact reproduction of the second process step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "In the next step, we input the customer's details into NKE."
      ],
      "justification": "Exact reproduction of the data entry step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer's details are missing"
      ],
      "justification": "The conditional check and XOR decision node directly model this threshold condition."
    },
    {
      "refs": [
        "action:n5",
        "label:b1->n5",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "we contact the customers."
      ],
      "justification": "Action matches the positive branch outcome; label and guard accurately denote the affirmative condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if the customer's details are ready, we create a suitable team."
      ],
      "justification": "Exact match for the team creation step when details are ready."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After contacting the customers, we receive additional customer details."
      ],
      "justification": "Exact reproduction of receiving supplementary details."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Then, we create the team and check previous campaigns for reusable material."
      ],
      "justification": "Covers the inspection step; team creation appropriately overlaps with the prior conditional path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Upon finding reusable ideas from previous campaigns"
      ],
      "justification": "Models the conditional check and decision node for reusable material exactly."
    },
    {
      "refs": [
        "action:n11",
        "label:b2->n11",
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "we create a new concept."
      ],
      "justification": "Action matches the positive outcome; label and guard denote affirmation of finding materials."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the new concept is created, we integrate new ideas and add further points."
      ],
      "justification": "Exact reproduction of refining the concept."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Next, we integrate the revised campaign into the database."
      ],
      "justification": "Exact reproduction of the database integration step."
    },
    {
      "refs": [
        "action:n16",
        "action:n21"
      ],
      "verbatim_texts": [
        "The concept is then presented to the relevant party for consideration."
      ],
      "justification": "Both actions match the presentation step perfectly; redundancy is permitted and does not alter behavior."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the concept is declined",
        "On the other hand, if the concept is accepted, we proceed to present it to the customer."
      ],
      "justification": "Models the acceptance/decline decision and evaluation check exactly as described."
    },
    {
      "refs": [
        "action:n18",
        "label:b3->n18",
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "On the other hand, if the concept is accepted, we proceed to present it to the customer."
      ],
      "justification": "Matches the customer presentation step on acceptance; guards/labels correctly map the positive path."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "If the concept is declined",
        "we rework it."
      ],
      "justification": "Matches the rework step on decline; guards/labels correctly map the negative path."
    },
    {
      "refs": [
        "label:b3->n20"
      ],
      "verbatim_texts": [
        "If the concept is declined",
        "we rework it."
      ],
      "justification": "Matches the rework step on decline; guards/labels correctly map the negative path."
    },
    {
      "refs": [
        "guard:b3->n20"
      ],
      "verbatim_texts": [
        "If the concept is declined",
        "we rework it."
      ],
      "justification": "Matches the rework step on decline; guards/labels correctly map the negative path."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "This marks the end of the process."
      ],
      "justification": "Structural end node aligns directly with the explicit closing statement."
    }
