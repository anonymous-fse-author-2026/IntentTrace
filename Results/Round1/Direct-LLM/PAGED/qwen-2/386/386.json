  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process, we receive the contract for the marketing campaign."
    },
    {
      "id": "i2",
      "content": "Once we have the contract, we take it to the department."
    },
    {
      "id": "i3",
      "content": "In the next step, we input the customer's details into NKE."
    },
    {
      "id": "i4",
      "content": "If the customer's details are missing"
    },
    {
      "id": "i5",
      "content": "we contact the customers."
    },
    {
      "id": "i6",
      "content": "However, if the customer's details are ready, we create a suitable team."
    },
    {
      "id": "i7",
      "content": "After contacting the customers, we receive additional customer details."
    },
    {
      "id": "i8",
      "content": "Then, we create the team and check previous campaigns for reusable material."
    },
    {
      "id": "i9",
      "content": "Upon finding reusable ideas from previous campaigns"
    },
    {
      "id": "i10",
      "content": "we create a new concept."
    },
    {
      "id": "i11",
      "content": "Once the new concept is created, we integrate new ideas and add further points."
    },
    {
      "id": "i12",
      "content": "Next, we integrate the revised campaign into the database."
    },
    {
      "id": "i13",
      "content": "The concept is then presented to the relevant party for consideration."
    },
    {
      "id": "i14",
      "content": "If the concept is declined"
    },
    {
      "id": "i15",
      "content": "we rework it."
    },
    {
      "id": "i16",
      "content": "On the other hand, if the concept is accepted, we proceed to present it to the customer."
    },
    {
      "id": "i17",
      "content": "This marks the end of the process."
    }
  ]
}