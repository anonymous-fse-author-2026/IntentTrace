init(i1)
action(n2, "review the received application")
action(n3, "load the case data")
action(n4, "review the case")
branch(b1, XOR)
action(n6, "recalculate the refund")
action(n7, "send a letter of denial")
branch(b2, XOR)
action(n9, "recalculate the refund")
action(n10, "send another letter of denial")
action(n11, "write back the case data")
end(e1)
converge(c1)
converge(c2)
defines(v1, "are there any new findings", {true, false})
defines(v2, "are there any new findings", {true, false})
actor(a_default, "review clerk", [i1, n2, n3, n4, b1, n6, n7, c1, b2, n9, n10, c2, n11, e1])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, n4)
