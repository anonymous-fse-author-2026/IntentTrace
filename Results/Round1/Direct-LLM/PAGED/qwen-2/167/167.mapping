      ],
      "verbatim_texts": [
        "The process starts with receiving a purchase order,"
      ],
      "justification": "The opening clause explicitly signals process initiation and describes the first step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by checking the availability of stock."
      ],
      "justification": "Checking availability serves as both the preparatory action and the implicit decision point for the subsequent split."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the product is not in stock,"
      ],
      "justification": "Defines the condition for the negative branch arm."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "raw materials are acquired."
      ],
      "justification": "Directly states the action taken when stock is unavailable."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the product is in stock,"
      ],
      "justification": "Defines the condition for the positive branch arm."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the product is retrieved from the warehouse."
      ],
      "justification": "Directly states the action taken when stock is available."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "and the product is manufactured."
      ],
      "justification": "States the subsequent step after material acquisition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The product is retrieved from the warehouse, and the order is confirmed."
      ],
      "justification": "Describes the completion of the in-stock path and its merge into the confirmation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The product is manufactured, and the order is confirmed."
      ],
      "justification": "Describes the completion of the out-of-stock path and its merge into the confirmation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The order is then shipped and invoiced."
      ],
      "justification": "Directly states the post-confirmation logistics step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "The order is archived,"
      ],
      "justification": "Directly states the record-keeping step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "and the process ends with the order being fulfilled."
      ],
      "justification": "Explicitly states the final status and signals process termination."
    }
