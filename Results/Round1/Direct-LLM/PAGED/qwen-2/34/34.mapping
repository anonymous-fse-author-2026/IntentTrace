{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially, it is important to check the Referee Reports."
      ],
      "justification": "Implicit process start and direct paraphrase of the initial checking action."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "monitor if the Referee Reports have been completed. If they have been completed"
      ],
      "justification": "Action models the monitoring step, branch handles the decision point, and guard captures the positive completion condition."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "flag it and send a reminder."
      ],
      "justification": "Action matches the fallback step; guard routes the negative/incomplete condition to this action."
    },
    {
      "refs": [
        "action:n5",
        "action:n6",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "check again if the Referee Reports have been completed. If they have"
      ],
      "justification": "Actions model the re-check sequence, branch splits the outcome, and guard captures the positive re-check result."
    },
    {
      "refs": [
        "action:n16",
        "guard:b2->n16"
      ],
      "verbatim_texts": [
        "If not, you should flag it again and send another reminder."
      ],
      "justification": "Action faithfully restates the secondary fallback step; guard captures the negative condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the Referee Reports have been completed, you can move on to organizing interviews for the Selection Panel with the top candidates."
      ],
      "justification": "Convergence marks the synchronization point after reports are ready, immediately followed by the interview organization action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "receive feedback from the interview candidates."
      ],
      "justification": "Exact paraphrase of the feedback collection step."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "check if a Psychometric Test is required. If it is"
      ],
      "justification": "Action and branch model the test requirement check; guard directs the positive path toward further validation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "check if an HR Specialist is required. If an HR Specialist is required"
      ],
      "justification": "Action and branch correctly implement the nested condition regarding HR specialist involvement."
    },
    {
      "refs": [
        "action:n11",
        "guard:b4->n11"
      ],
      "verbatim_texts": [
        "schedule the test with a third party."
      ],
      "justification": "Action matches the scheduling instruction; guard captures the positive HR specialist condition triggering it."
    },
    {
      "refs": [
        "action:n12",
        "guard:b4->n12"
      ],
      "verbatim_texts": [
        "Otherwise, you can proceed to complete the Psychometric Test."
      ],
      "justification": "Action matches the alternative completion path; guard captures the 'otherwise' negative condition."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "If not, you can continue with the process and coordinate the second round of selection."
      ],
      "justification": "Guard and converge handle the 'test not required' path, flowing directly into coordinating the second round."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, you should request the final candidate ranking and continue with the process."
      ],
      "justification": "Convergence gathers preceding paths, action executes the final ranking request, and implicit end node closes the process."
    }
  ],
