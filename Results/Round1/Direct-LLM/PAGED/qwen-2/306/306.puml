@startuml
!theme plain
|a_default| Default
|a_default|
start
:trigger resupply cycle;
:check inventory level;
:v1: inventory at or below minimum ({true, false}); <<objectSignal>>
if () then ([v1 = true])
:create purchase order;
:review purchase order;
:v2: purchase status ({approved, rejected}); <<objectSignal>>
if () then ([v2 = 'rejected'])
:rework purchase order;
:review purchase order;
else ([v2 = 'approved'])
:reserve funds;
:send order to supplier;
split
:receive packing slip;
:record packing slip;
stop
split again
:receive invoice;
:record invoice;
stop
end split
endif
else ([v1 = false])
stop
endif
@enduml