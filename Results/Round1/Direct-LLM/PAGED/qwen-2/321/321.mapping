      ],
      "verbatim_texts": [
        "After selecting a book, they can either view the book details or see a list of new copies. Alternatively, they can also view a list of used copies."
      ],
      "justification": "The explicit choice action, XOR branch, and three guarded arms faithfully implement the three options presented after book selection."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
