{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "The opening clause implicitly initiates the flow and describes the first two sequential actions. Minor wording differences ('start/process' vs 'trigger/cycle') preserve core meaning."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n5",
        "label:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "The conditional sentence triggers the XOR split, models the threshold check as an action step, and defines the positive guard/label routing to the purchase order creation."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Captures the negative branch outcome, the explicit termination action, and the first process endpoint."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Directly corresponds to the mandatory review step following order creation."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "Establishes the second XOR decision, models the status check as an action, and routes via the positive guard to the rework step."
    },
    {
      "refs": [
        "guard:b2->n23",
        "label:b2->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Maps to the alternative branch outcome. The 'No' guard/label correctly corresponds to 'approved' given the rejection-based decision phrasing, leading to fund reservation."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Implies the convergence of the rework path back into the main flow, immediately followed by the repeated review action."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Faithfully captures the second half of the sequential pair, handling the supplier dispatch."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Explicit temporal marker 'At the same time' correctly drives the AND gateway, splitting into the two parallel receipt actions."
    },
    {
      "refs": [
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it. Receive the invoice and then record it."
      ],
      "justification": "Sequential recording steps for both documents accurately model the paired instructions."
    },
    {
      "refs": [
        "end:e4"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Marks the specific termination point tied to completing the packing slip workflow."
    },
    {
      "refs": [
        "end:e5"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Marks the specific termination point tied to completing the invoice workflow."
    }
  ],
