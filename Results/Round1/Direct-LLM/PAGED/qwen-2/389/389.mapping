{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For developers practicing BPMN execution TDD, the first step is to understand the BPMN Model."
      ],
      "justification": "The opening clause implicitly triggers the start node and explicitly defines the first action step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "write a failing test."
      ],
      "justification": "Exact reproduction of the second process step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "To make the test pass, they need to extend BPMN/mocks."
      ],
      "justification": "Direct paraphrase preserving the core instruction and goal; slash spacing difference is negligible."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "Once the test is green"
      ],
      "justification": "The temporal/conditional clause establishes the XOR decision point and its positive outcome guard."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check if the level satisfies the project requirements"
      ],
      "justification": "Exact match of the verification step following the green-test path."
    },
    {
      "refs": [
        "guard:b2->e1"
      ],
      "verbatim_texts": [
        "If it does, the process ends."
      ],
      "justification": "The positive outcome of the requirement check triggers the termination guard and end node."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9",
        "label:n9->n3"
      ],
      "verbatim_texts": [
        "If not, they should continue the process."
      ],
      "justification": "Models the negative outcome path; the parenthetical loop clarification is redundant but behaviorally faithful to standard TDD cycling, qualifying as a match under the redundancy rule."
    },
    {
      "refs": [
        "guard:b1->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the test is not green, they should upgrade the test level."
      ],
      "justification": "Correctly captures the negative arm of the initial test-status branch and the subsequent action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After that, they need to check if the level satisfies the project requirements again."
      ],
      "justification": "Faithfully restates the repeated verification step; dropping 'again' does not alter the core instruction."
    },
    {
      "refs": [
        "guard:b3->e2",
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If not, they should upgrade the test level once more."
      ],
      "justification": "Covers the final decision split and both outcomes: the negative path upgrades the level once more and terminates, while the structural positive path terminates immediately as implied by the broader sentence context."
    }
  ],
