  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process for ACME Company, start by receiving the customer request and then check the current inventory level."
      ],
      "justification": "The opening clause implicitly starts the process and sequentially describes initiating, receiving the request, and checking inventory."
    },
    {
      "refs": [
        "guard:b1->n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, accept the customer request."
      ],
      "justification": "Introduces the exclusive decision point; guards capture the stated threshold condition and its logical inverse for the alternate path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, accept the customer request.",
        "accept the customer request.",
        "After accepting the customer request, create a purchase order."
      ],
      "justification": "Consolidates the acceptance instruction and the immediate follow-up PO creation described across consecutive units."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the customer request is rejected, the process ends."
      ],
      "justification": "Directly models the rejection path and the explicit termination of the workflow."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the purchase order is created, review it."
      ],
      "justification": "Faithfully restates the review step following PO creation."
    },
    {
      "refs": [
        "guard:b2->n7",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order. However, if the purchase order is approved, reserve the funds."
      ],
      "justification": "Captures the approval/rejection decision gateway and maps each outcome to its corresponding guard."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order. However, if the purchase order is approved, reserve the funds.",
        "If the purchase order is rejected, rework the purchase order."
      ],
      "justification": "Implements the rework action described in the conditional arm and its repeated fragment."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order. However, if the purchase order is approved, reserve the funds.",
        "However, if the purchase order is approved, reserve the funds."
      ],
      "justification": "Implements the fund reservation action tied to the approval condition and its repeated fragment."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After reserving the funds, send the purchase order."
      ],
      "justification": "Direct correspondence to the PO dispatch step after reservation."
    },
    {
      "refs": [
        "action:n10",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "The concurrency marker triggers an AND split to handle receiving both documents in parallel."
    },
    {
      "refs": [
        "action:n11",
        "action:n14"
      ],
      "verbatim_texts": [
        "Upon receiving the packing slip, record it. Similarly, upon receiving the invoice, record it as well."
      ],
      "justification": "Maps the parallel recording tasks to their respective branches."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Release the reserved funds and issue the payment.",
        "Finally, issue the payment and the process ends."
      ],
      "justification": "Covers the financial settlement steps described across the final units."
    }
