{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial registration action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "guard:b1->n4",
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request. However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "The conditional check, XOR branch, guards, and subsequent actions for both fee scenarios are fully derived from this sentence pair."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Explicitly marks the termination point of the no-fee path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Describes the explicit check step and implies the subsequent exclusive decision point."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Captures the positive approval condition and the resulting notification action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Captures the negative rejection condition and the resulting notification action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Directly states the action taken upon receiving the approval notification."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Explicitly marks the termination point of the rejection path."
    }
  ],
