init(i1)
action(n1, "start registration for event participation")
action(n2, "check if there is a fee")
branch(b1, XOR)
action(n3, "register a post-seminar request")
action(n4, "create a purchase request")
end(e1)
action(n6, "check if purchase request is approved")
branch(b2, XOR)
action(n7, "receive an approved notification")
action(n8, "receive a rejection notification")
action(n9, "register a post-seminar request after approval")
end(e2)
converge(c1)
defines(v1, "check if there is a fee", {"fee", "no_fee"})
defines(v2, "check if purchase request is approved", {"approved", "rejected"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, e1, n6, b2, n7, n8, n9, e2, c1])
precedence(i1, n1)
precedence(n2, b1)
precedence(n6, b2)
precedence(n1, n2)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, e1)
precedence(n4, n6)
precedence(b2, n7)
precedence(b2, n8)
precedence(n7, n9)
precedence(n8, c1)
precedence(n9, c1)
precedence(c1, e2)
guard(b1, n3, v1 = 'no_fee')
guard(b1, n4, v1 = 'fee')
guard(b2, n7, v2 = 'approved')
guard(b2, n8, v2 = 'rejected')