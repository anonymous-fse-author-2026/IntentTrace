{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The opening clause initiates the process and describes the first action of receiving the claim."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Direct match to the second procedural step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "The action describes the decision step, while the branch node models the resulting XOR split implied by the decision."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "The guard captures the rejection condition, and the action captures the corresponding outcome."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "The guard captures the acceptance condition, and the action restates the benefit-offering step across both spanning units."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "offer the benefit"
      ],
      "justification": "The guard captures the acceptance condition, and the action restates the benefit-offering step across both spanning units."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Direct match to the rejection review step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Direct match to the discharge preparation step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Direct match to the payment recording step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process. But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "The converge node re-joins the previously split paths, and the action implements the universal continuation step described in the unit."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "The AND branch and subsequent converge model the simultaneous execution, while the two action nodes exactly implement the specified parallel steps."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "The closing sentence maps to both the terminal action description and the explicit end node."
    }
  ],
