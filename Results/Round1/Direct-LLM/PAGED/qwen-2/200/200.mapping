{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "The opening clause implicitly initiates the process and defines the first two sequential actions."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "The conditional opens the XOR branch, the guard captures the exact eligibility string, and the action matches the instruction."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Guard preserves the exact alternative condition; action faithfully restates the ERP order creation."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Explicit termination point for the ineligible customer path."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "Open a new order in the ERP system and perform an availability check."
      ],
      "justification": "Reiterates the ERP order step and introduces the distinct availability check action."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\"."
      ],
      "justification": "Decision point modeled as XOR branch; positive guard aligns with the available state."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "Negative condition drives the guard; action matches part production; continuation action bridges to the next phase."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Direct one-to-one mapping of the preparation step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "ship the products and send the invoice while checking for payment"
      ],
      "justification": "Parallel execution implied by simultaneous instructions maps to AND split and three concurrent actions."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Payment receipt condition triggers XOR branch; guard and action align exactly with source."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Non-receipt condition captured in guard; action matches sending the reminder."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "ending the process"
      ],
      "justification": "Marks the termination point following successful payment/order closure."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->c_merge"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Reminder count check and sub-threshold loopback are faithfully modeled with action, branch, and guard."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Threshold condition triggers lawyer notification and explicit final process termination."
    }
  ],
