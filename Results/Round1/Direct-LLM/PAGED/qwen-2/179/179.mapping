    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial joining/agreeing step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "create a process model"
      ],
      "justification": "Direct match to the second instruction."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "check it. If the process model is"
      ],
      "justification": "Captures the verification step and the XOR decision point with its OK/NOT OK guard conditions."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then assign negative points"
      ],
      "justification": "Direct match to the penalty action on the first failure path."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\""
      ],
      "justification": "Captures the re-evaluation step and the second XOR decision point with its guard condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "assign negative points again"
      ],
      "justification": "Direct match to the repeated penalty action."
    },
    {
      "refs": [
        "action:n7",
        "action:n8",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Matches the success continuation path, its guard condition, and the implicit path rejoin."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "fix them in the next session and extend the process to levels 2 and 3"
      ],
      "justification": "Faithfully restates the remediation and extension instruction."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points"
      ],
      "justification": "Captures the first alternative condition and routes it via the XOR branch and guard."
    },
    {
      "refs": [
        "action:n9",
        "action:n12"
      ],
      "verbatim_texts": [
        "continue with the process"
      ],
      "justification": "Redundant action nodes that both faithfully implement the continuation instruction."
    },
    {
      "refs": [
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study"
      ],
      "justification": "Captures the second alternative condition, its guard, and the subsequent path rejoin."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "assign roles in the team"
      ],
      "justification": "Direct match to the role assignment action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the process is okay"
      ],
      "justification": "Restates the conditional check for proceeding to role-based work."
    },
    {
      "refs": [
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "continue with the process and perform work according to your assigned role"
      ],
      "justification": "Split into two sequential actions that together preserve the full instruction."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct match to the monitoring and consultation step."
    },
    {
