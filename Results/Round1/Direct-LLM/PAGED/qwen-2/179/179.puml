@startuml
!theme plain
|a_default| Default
|a_default|
start
:start by joining the team and agreeing on teams domain;
:create a process model;
:is the process model OK;
:v1: is the process model OK ({OK, NOT OK}); <<objectSignal>>
if () then ([v1 = "NOT OK"])
:assign negative points;
:is the process model OK after assigning negative points;
:v2: is the process model OK after assigning negative points ({OK, NOT OK}); <<objectSignal>>
if () then ([v2 = "NOT OK"])
:assign negative points again;
:continue with the process;
:determine next course of action;
:need to fix issues in the next session and extend process to levels two and three;
else ([v2 = "OK"])
:continue with the process;
endif
else ([v1 = "OK"])
:continue with the process;
endif
:need to check the process and assign points or analyze field of study;
:v3: need to check the process and assign points or analyze field of study ({Check and Assign Points, Analyze Field of Study}); <<objectSignal>>
if () then ([v3 = "Check and Assign Points"])
:continue with the process;
:is the process OK after checking and assigning points;
:confirm process status;
:continue with the process according to assigned roles;
else ([v3 = "Analyze Field of Study"])
:assign roles in the team;
endif
:perform work according to your assigned role;
:check the progress and consult problems that arise;
:is the project accepted;
:v5: is the project accepted ({Accepted, Not Accepted}); <<objectSignal>>
if () then ([v5 = "Accepted"])
:present the project;
else ([v5 = "Not Accepted"])
:continue working according to your role;
:is the project accepted after continuing work;
:v6: is the project accepted after continuing work ({Accepted, Not Accepted}); <<objectSignal>>
if () then ([v6 = "Accepted"])
:present the project;
else ([v6 = "Not Accepted"])
:continue working according to your role;
endif
endif
:present the project and end the process;
stop
@enduml