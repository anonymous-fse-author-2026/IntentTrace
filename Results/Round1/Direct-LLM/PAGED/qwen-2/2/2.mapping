{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For TS recruitment, the first step is to advise unsuccessful candidates."
      ],
      "justification": "The opening clause establishes the process scope, implicitly starting it, and defines the first concrete action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\""
      ],
      "justification": "Models the candidate availability check as a decision split and associated state node."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the position should be re-advertised."
      ],
      "justification": "Directly implements the re-advertisement step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if the terms and conditions of the offer for a candidate need to be sorted out, it is necessary to check if the candidate has accepted a voluntary redundancy."
      ],
      "justification": "Captures the conditional trigger and the required investigation action."
    },
    {
      "refs": [
        "action:n8",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form, which is then received by the next level manager."
      ],
      "justification": "Accurately splits the sending and receiving events, with permitted redundancy."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the manager is an external resource, they may not authorize the form.",
        "However, if the approver is an existing employee of the client, the process continues."
      ],
      "justification": "Correctly bifurcates the flow based on approver employment status."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the form is approved, the recruitment manager sends the form and other documentation, which is received by the client HR.",
        "If the form is approved"
      ],
      "justification": "Handles the approval gateway and subsequent document transfer steps."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the form is approved, the recruitment manager sends the form and other documentation, which is received by the client HR.",
        "If the form is approved"
      ],
      "justification": "Handles the approval gateway and subsequent document transfer steps."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the form is approved, the recruitment manager sends the form and other documentation, which is received by the client HR.",
        "If the form is approved"
      ],
      "justification": "Handles the approval gateway and subsequent document transfer steps."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "justification": "Faithfully reproduces the scanning and system recording step."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If there are any variations, a complete business case is required."
      ],
      "justification": "Triggers the variation check and the mandatory business case creation."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Otherwise, the process continues. The Appointment Approval is carried forward."
      ],
      "justification": "Preserves the continuation flow and approval handoff."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate."
      ],
      "justification": "Links the medical assessment requirement to the specific rate application."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Otherwise, a medical assessment is not necessary."
      ],
      "justification": "Clearly states the exemption path."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "The TS HR coordinator informs the recruitment manager, who then liaises with the HR representative to confirm the offer to the candidate."
      ],
      "justification": "Splits the notification and liaison tasks without altering meaning."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory, the next candidate on the shortlist should be contacted."
      ],
      "justification": "Models the negative assessment outcome and the fallback action."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "The recruitment manager makes a formal verbal offer of employment to the candidate."
      ],
      "justification": "Directly mirrors the verbal offer step."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "If the candidate accepts, the recruitment manager creates a formal written offer."
      ],
      "justification": "Captures candidate acceptance leading to formal documentation."
    },
    {
      "refs": [
        "action:n32",
        "action:n33"
      ],
      "verbatim_texts": [
        "Simultaneously, the commencement pack and letter of appointment are sent to the candidate."
      ],
      "justification": "Separates the two concurrent mailings while preserving simultaneity."
    },
    {
      "refs": [
        "action:n34",
        "action:n36"
      ],
      "verbatim_texts": [
        "Once the candidate receives these documents, if there is a \"40%\" rate, renegotiation is required."
      ],
      "justification": "Tracks document receipt and correctly gates the renegotiation trigger."
    },
    {
      "refs": [
        "action:n37"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful, the process continues.",
        "However, if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified. Finally, the process ends."
      ],
      "justification": "Handles renegotiation resolution paths and correctly places the terminal node."
    }
  ],
