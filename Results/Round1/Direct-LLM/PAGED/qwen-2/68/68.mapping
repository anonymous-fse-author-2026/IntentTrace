  "mutations": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Rental Items are Returned to the Store.",
        "If the \"Customer returns the items to the store,\" then we can continue the process.",
        "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "reason": "Merges distinct source statements (unconditional return, customer return condition, crew pickup condition) into a single synthesized action, altering the source's explicit conditional structure."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process.",
        "Order is complete and all items were returned,"
      ],
      "reason": "Drops the \"Order is complete\" qualifier, changing the threshold to only check for all items returned."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "However, if the \"Order is incomplete and items are missing,\" we still continue the process.",
        "Order is incomplete and items are missing,"
      ],
      "reason": "Drops the \"Order is incomplete\" qualifier, reducing the condition to merely missing items."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "Order is complete but items are damaged,",
        "Similarly, if the \"Order is complete but items are damaged\","
      ],
      "reason": "Drops the \"Order is complete\" context, mutating the condition to only check for damage."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process."
      ],
      "reason": "Strips the conditional wrapper and models the event as a standalone action step rather than a decision path."
    },
    {
      "refs": [
        "guard:b5->n12"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process.",
        "Items are repaired and added into inventory,"
      ],
      "reason": "Changes the definitive source statement into a capability question (\"Can be repaired\"), altering the guard's semantic type."
    },
    {
      "refs": [
        "guard:b5->n13"
      ],
      "verbatim_texts": [
        "Items can't be repaired and are discarded,",
        "On the other hand, if the \"Items can't be repaired and are discarded\","
      ],
      "reason": "Simplifies the source condition to a binary state (\"Cannot be repaired\") and drops the explicit \"discarded\" outcome from the guard payload."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges, and the process is complete."
      ],
      "reason": "Omits the mandatory email step regarding replacement charges, capturing only the process termination."
    }
