init(i1)
action(n1, "Start process for flickr login")
action(n2, "Provide userdata for flickr login")
converge(c1)
action(n3, "Is login successful")
branch(b1, XOR)
action(n4, "End process after successful login")
end(e1)
action(n5, "Choose to try login again")
branch(b2, XOR)
action(n6, "Provide userdata for flickr login")
action(n8, "End process after abort")
end(e2)
defines(v1, "Login status", {"Successful", "Failed"})
defines(v2, "User decision", {"Retry", "Abort"})
actor(a_default, "Default", [i1, n1, n2, c1, n3, b1, n4, e1, n5, b2, n6, n8, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, c1)
precedence(n6, c1)
precedence(c1, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, e1)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n8)
precedence(n8, e2)
guard(b1, n4, v1 = 'Successful')
guard(b1, n5, v1 = 'Failed')
guard(b2, n6, v2 = 'Retry')
guard(b2, n8, v2 = 'Abort')