{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "Opening clause establishes process start, followed by two sequential actions matching the source sequence."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Decision point, negative eligibility guard, and resulting inform action faithfully reproduce the conditional branch."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Explicit termination signal following the non-eligible notification path."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Positive eligibility guard and corresponding ERP order creation action align exactly with the source."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Open a new order in the ERP system and perform an availability check."
      ],
      "justification": "Second half of the compound instruction maps directly to the availability check action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\". If it is not, start producing the missing parts."
      ],
      "justification": "Product availability evaluation, negative condition guard, and missing parts production action preserve original logic and phrasing."
    },
    {
      "refs": [
        "guard:b2->c_prep",
        "action:n8"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process. Prepare the products for shipment."
      ],
      "justification": "Positive availability outcome leads to path convergence and the specified shipment preparation action."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "AND gateway captures simultaneous execution, distributing the three listed parallel tasks accurately."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Payment status check, positive receipt guard, and order closure action match the source condition and outcome."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "Otherwise, if the payment is not received, send a reminder and close the order, ending the process."
      ],
      "justification": "Negative payment path reconvenes, triggers the non-receipt guard and reminder action, and reaches the specified endpoint."
    },
    {
      "refs": [
        "guard:b4->c_loop"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Reminder counter evaluation, sub-threshold guard, and loop-back convergence correctly model the continuation logic."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Maximum reminder threshold guard, lawyer notification action, and final termination node correspond precisely to the source clause."
    }
  ],
