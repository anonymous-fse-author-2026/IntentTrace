@startuml
!theme plain
|a_default| Default
|a_default|
start
:place order;
:check customer eligibility;
:v1: customer eligibility ({not eligible, eligible}); <<objectSignal>>
if () then ([v1 = "not eligible"])
:inform customer not eligible;
stop
else ([v1 = "eligible"])
:open new order in ERP system;
:perform availability check;
:v2: product availability ({available, not available}); <<objectSignal>>
if () then ([v2 = "not available"])
:start producing missing parts;
else ([v2 = "available"])
->;
endif
:prepare products for shipment;
split
:ship the products;
:v3: payment status ({received, not received}); <<objectSignal>>
if () then ([v3 = "received"])
:close order;
stop
else ([v3 = "not received"])
:send payment reminder;
:v4: reminder count ({< 3, = 3}); <<objectSignal>>
if () then ([v4 = "< 3"])
->;
else ([v4 = "= 3"])
:inform lawyer and end process;
stop
endif
endif
split again
:send the invoice;
split again
end split
:check for payment;
endif
