    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "The opening clause implicitly starts the process (init) and explicitly defines the first operational step (action)."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "The conditional statement establishes the first XOR decision (branch), with its negative outcome guarded to trigger the advertising step (action)."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "The secondary check forms a second XOR decision (branch), where the negative guard directs flow to the repeated advertising action."
    },
    {
      "refs": [
        "guard:b1->c1",
        "guard:b2->c1",
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "The positive outcomes from both conditional branches merge at the converge node and feed directly into the applicant selection step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "The final appointment step concludes the workflow, naturally aligning with the termination node."
    }
  ],
