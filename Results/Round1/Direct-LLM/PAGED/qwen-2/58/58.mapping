{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "Captures process initiation and the initial prioritization step."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information. If the customer exists,"
      ],
      "justification": "Models the existence check, the resulting XOR split, and the positive condition guard."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "we move on to checking their payment history."
      ],
      "justification": "Directly implements the payment history check action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "On the other hand, if the customer does not exist, we need to verify their customer status."
      ],
      "justification": "Maps the negative existence branch guard and the subsequent status verification step."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->c2",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process."
      ],
      "justification": "Covers the condition evaluation, decision node, explicit positive guard, and implicit negative guard."
    },
    {
      "refs": [
        "action:n7",
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Handles the private customer condition, branch, guard, and message action."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Implements the wholesaler branch guard, customer creation, and availability check."
    },
    {
      "refs": [
        "action:n11",
        "guard:b4->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Aligns unavailability check, branch, guard, production/decline action, explicit end-step, and termination node."
    },
    {
      "refs": [
        "guard:b4->c2",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Maps availability guard and the combined continuation/confirmation action."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "AND gateway correctly models the simultaneous parallel notifications and their synchronization."
    },
    {
      "refs": [
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Decomposes the compound preparation statement into packing, invoicing, and readiness steps."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "we deliver the goods and invoice to the customer."
      ],
      "justification": "Directly implements the final delivery and handover action."
    },
    {
      "refs": [
        "action:n22",
        "guard:b5->c_res",
        "action:n20"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Captures payment receipt check, branch, received guard, and closing action."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Implements outstanding payment guard and the reminder quantity check action."
    },
    {
      "refs": [
        "action:n25",
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Models the reminder count evaluation, branch, less-than-three guard, and continuation action."
    },
    {
      "refs": [
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Covers donning activation, explicit end-step, and termination node for the high-reminder path."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b6->n27"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "reason": "Source specifies strictly greater than three (>3), but the guard uses greater-than-or-equal (>=3), altering the threshold logic."
    }
  ],
  "omissions": [],
  "additions": [
    {
      "refs": [
        "action:n29"
      ],
      "reason": "Source text describes closing the order but does not state the process ends there; flow continues to delivery."
    },
    {
      "refs": [
        "action:n31"
      ],
      "reason": "Source text instructs sending a declining message to private customers but does not specify that the process terminates at this point."
    }
  ],
