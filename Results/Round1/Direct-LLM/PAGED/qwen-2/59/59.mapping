{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "The opening clause initiates the process and explicitly describes the first two sequential steps."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
      ],
      "justification": "The conditional introduces the XOR split and specifies the positive arm's processing action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance."
      ],
      "justification": "Captures the resulting balance state described in the negative condition arm."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "In the case of an Outstanding Balance, a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "Directly states the next order-placing action and the explicit termination point."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If a new order is placed, it will be recorded in the Accounts Receivable."
      ],
      "justification": "Faithfully restates the accounting recording step triggered by the new order."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If Payments are Received, the process continues."
      ],
      "justification": "Models the payment receipt event as a process node preceding the subsequent decision."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if no payments are received, the order is dropped."
      ],
      "justification": "Introduces the second XOR split and defines the order-dropping outcome."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Next, identify the order for installation."
      ],
      "justification": "Exact match for the installation identification step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled, an Installer will be assigned."
      ],
      "justification": "Defines the third XOR split and the positive installer assignment action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "On the other hand, if the order does not require installation, it will be packed for delivery."
      ],
      "justification": "Faithfully captures the negative arm's packing-for-delivery action."
    }
  ],
