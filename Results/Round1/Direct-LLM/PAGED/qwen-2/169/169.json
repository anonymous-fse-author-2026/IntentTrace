  "input_elements": [
    {
      "id": "i1",
      "content": "The first step is to receive and categorize the invoice."
    },
    {
      "id": "i2",
      "content": "If the instruction is to \"Forward Invoice to Admin Officer\", then the next step is to sort the invoice. However, if the instruction is to \"Reject invoice\", then the process ends there. On the other hand, if the instruction is to \"Return invoice to client for completion\", then the invoice is received and categorized again. Alternatively, if the instruction is to \"Process Invoice for SAP Entry\", then the invoice is forwarded for validation."
    },
    {
      "id": "i3",
      "content": "If the instruction is to \"Forward Invoice to Admin Officer\""
    },
    {
      "id": "i4",
      "content": "sort the invoice"
    },
    {
      "id": "i5",
      "content": "if the instruction is to \"Reject invoice\""
    },
    {
      "id": "i6",
      "content": "then the process ends there"
    },
    {
      "id": "i7",
      "content": "if the instruction is to \"Return invoice to client for completion\""
    },
    {
      "id": "i8",
      "content": "then the invoice is received and categorized again"
    },
    {
      "id": "i9",
      "content": "if the instruction is to \"Process Invoice for SAP Entry\""
    },
    {
      "id": "i10",
      "content": "then the invoice is forwarded for validation"
    },
    {
      "id": "i11",
      "content": "Once the invoice is forwarded for validation, it is then validated, and the process ends."
    }
  ]
