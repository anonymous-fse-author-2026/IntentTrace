      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts with the Request for Quotation,"
      ],
      "justification": "The opening clause establishes the process initiation and describes the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by the Customer submitting the RFQ."
      ],
      "justification": "Directly captures the customer RFQ submission step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After the RFQ is submitted, the Quotation is also submitted."
      ],
      "justification": "Faithfully represents the quotation submission following the RFQ."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the Quotation is submitted, we receive it."
      ],
      "justification": "Accurately maps to the reception of the quotation."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Upon receiving the Quotation, we then submit the Purchase Order."
      ],
      "justification": "Directly corresponds to submitting the purchase order."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Simultaneously, we complete two steps: sending the Goods and sending the Invoice."
      ],
      "justification": "Both action nodes precisely reflect the two simultaneous sending steps described."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the Goods are sent, we mark them as sent."
      ],
      "justification": "Exact match for the post-sending tracking step for goods."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Similarly, after the Invoice is sent, we mark it as sent."
      ],
      "justification": "Exact match for the post-sending tracking step for the invoice."
    }
  ],
