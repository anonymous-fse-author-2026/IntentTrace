  "input_elements": [
    {
      "id": "i1",
      "content": "The process starts with an informational meeting that lasts half a day, involving the customer and the web design team."
    },
    {
      "id": "i2",
      "content": "If the meeting is successful, the next step is to work on the storyboard"
    },
    {
      "id": "i3",
      "content": "However, if the meeting is not successful, the process ends."
    },
    {
      "id": "i4",
      "content": "If the storyboard is successful, the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
    },
    {
      "id": "i5",
      "content": "Once the site is built, it goes through a review process that lasts 1 day."
    },
    {
      "id": "i6",
      "content": "If the review is successful, it moves on to the approval stage, which takes half a day."
    },
    {
      "id": "i7",
      "content": "If the approval is complete, the process ends. However, if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
    },
    {
      "id": "i8",
      "content": "If the rebuild is complete, the process ends."
    },
    {
      "id": "i9",
      "content": "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days."
    }
  ]
