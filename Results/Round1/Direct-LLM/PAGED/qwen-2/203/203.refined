init(i1)
action(n2, "Check loan application")
branch(b1, XOR)
end(e1)
branch(b2, XOR)
action(n6, "Disburse funds")
end(e2)
defines(v1, "Application rejected", {"Yes", "No"})
defines(v2, "Special terms agreed upon", {"Yes", "No"})
actor(a_default, "Default", [i1, n2, b1, e1, b2, n6, e2])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, e1)
precedence(b1, b2)
precedence(b2, n6)
precedence(b2, e1)
precedence(n6, e2)
guard(b1, e1, v1 = 'Yes')
guard(b1, b2, v1 = 'No')
guard(b2, n6, v2 = 'Yes')
guard(b2, e1, v2 = 'No')