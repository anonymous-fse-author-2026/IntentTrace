@startuml
!theme plain
|a_default| Default
|a_default|
start
:feel hungry;
:go shopping;
:v_choice: choice ({salad, sausages, meat}); <<objectSignal>>
switch ()
case ([v_choice = "salad"])
:purchase salad;
case ([v_choice = "sausages"])
:purchase sausages;
case ([v_choice = "meat"])
:purchase meat;
endswitch
:pay for products;
stop
@enduml