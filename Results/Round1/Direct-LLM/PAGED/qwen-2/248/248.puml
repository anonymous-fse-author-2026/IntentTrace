@startuml
!theme plain
|a_default| Default
|a_default|
start
:enter the Italian restaurant and ask for the menu;
:check the offers;
split
:order a glass of red wine;
split again
:order a salad;
end split
:wait for the red wine and salad to arrive;
:enjoy the salad and wine;
:would you like a dessert;
:v1: would you like a dessert ({yes, no}); <<objectSignal>>
if () then ([v1 = "yes"])
:order tiramisu;
:wait for tiramisu to be served;
:enjoy the tiramisu;
else ([v1 = "no"])
:decline any dessert;
endif
:ask for the bill;
:pay the bill;
:leave the restaurant;
stop
@enduml