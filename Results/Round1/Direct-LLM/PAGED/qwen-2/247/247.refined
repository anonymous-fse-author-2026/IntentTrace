init(i1)
action(n1, "Start ONS Bootstrapping process")
action(n2, "Is input a URN?")
branch(b1, XOR)
action(n3, "Resolve URN to domain-name")
action(n4, "Send DNS query for the domain-name")
action(n5, "Get list of URLs from DNS query")
action(n6, "Link to designated DS")
end(e1)
action(n8, "Send DNS query for the URL")
action(n9, "Get list of URLs from DNS query")
action(n10, "Link to designated DS")
end(e2)
converge(c1)
branch(b2, XOR)
defines(v1, "Is input a URN?", {"Yes", "No"})
defines(v2, "Second input check", {"URN", "URL"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, n6, e1, n8, n9, n10, e2, c1, b2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, c1)
precedence(n3, c1)
precedence(c1, b2)
precedence(b2, n4)
precedence(b2, n8)
precedence(n4, n5)
precedence(n5, n6)
precedence(n6, e1)
precedence(n8, n9)
precedence(n9, n10)
precedence(n10, e2)
guard(b1, n3, v1 = 'Yes')
guard(b1, c1, v1 = 'No')
guard(b2, n4, v2 = 'URN')
guard(b2, n8, v2 = 'URL')