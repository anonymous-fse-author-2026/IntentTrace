{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step, followed by checking the Inventory Level."
      ],
      "justification": "The opening unit explicitly signals process initiation and describes the first two sequential actions."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\", then proceed to Create Purchase Order.",
        "However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "The mutually exclusive conditions in i2 and i3 implicitly define an XOR decision point."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\", then proceed to Create Purchase Order."
      ],
      "justification": "Directly implements the action prescribed for the low-inventory path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "The high-inventory arm terminates immediately, justifying both the terminal action and end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Faithfully restates the post-creation review step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved, then reserve the funds for the purchase.",
        "On the other hand, if the Purchase Order is rejected, then rework the order."
      ],
      "justification": "The approval vs rejection split implicitly defines a second XOR decision point."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved, then reserve the funds for the purchase."
      ],
      "justification": "Directly implements the funding step for the approved path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the Purchase Order is rejected, then rework the order."
      ],
      "justification": "Directly implements the rework step for the rejected path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Exact match for the supplier dispatch step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Exact match for the iterative review step."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: the Supplier sends a packing slip and an invoice."
      ],
      "justification": "The keyword 'Simultaneously' mandates an AND split, followed by the two parallel supplier actions."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it. Similarly, when the invoice is received, record it as well."
      ],
      "justification": "Directly captures both recording actions for the parallel deliverables."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice, release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "The completion of both recording tasks implies convergence, followed by the fund release and payment actions."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Explicitly marks process termination following payment issuance."
    }
  ],
