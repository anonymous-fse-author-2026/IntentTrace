@startuml
!theme plain
|a_default| Default
|a_default|
start
:Resupply Cycle Triggered;
:Check Inventory Level;
:v1: Inventory Level at or below minimum ({true, false}); <<objectSignal>>
if () then ([v1 = true])
:Create Purchase Order;
:Reviewing Purchase Order;
:v2: Purchase Order Approved ({true, false}); <<objectSignal>>
if () then ([v2 = true])
:Reserve Funds for Purchase;
:Send Order to Suppliers;
split
:Supplier sends packing slip;
:Record packing slip;
split again
:Supplier sends invoice;
:Record invoice;
end split
:Release reserved funds;
:Issue payment to supplier;
:End Process;
stop
else ([v2 = false])
:Rework Order;
:Reviewing Purchase Order;
endif
else ([v1 = false])
:End Process;
stop
endif
@enduml