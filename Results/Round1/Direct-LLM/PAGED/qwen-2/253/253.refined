init(i1)
action(n1, "Resupply Cycle Triggered")
action(n2, "Check Inventory Level")
branch(b1, XOR)
action(n3, "Create Purchase Order")
action(n5, "Review Purchase Order")
action(n6, "Check Purchase Order Approval")
branch(b2, XOR)
action(n7, "Reserve funds for purchase")
action(n8, "Rework the order")
action(n9, "Send Order to Suppliers")
action(n10, "Review Purchase Order")
action(n11, "Supplier sends packing slip and invoice")
action(n12, "Receive and record packing slip")
action(n13, "Receive and record invoice")
action(n14, "Release reserved funds and issue payment to supplier")
end(e1)
end(e2)
converge(c1)
branch(b3, AND)
defines(v1, "Inventory level at or below the minimum?", {"Yes", "No"})
defines(v2, "Purchase Order approved?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n5, n6, b2, n7, n8, n9, n10, n11, n12, n13, n14, e1, e2, c1, b3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, e1)
precedence(n3, n5)
precedence(n5, n6)
precedence(n6, b2)
precedence(b2, n7)
precedence(b2, n8)
precedence(n7, n9)
precedence(n8, n10)
precedence(n10, n5)
precedence(n9, n11)
precedence(n11, b3)
precedence(b3, n12)
precedence(b3, n13)
precedence(n12, c1)
precedence(n13, c1)
precedence(c1, n14)
precedence(n14, e2)
guard(b1, n3, v1 = 'Yes')
guard(b1, e1, v1 = 'No')
guard(b2, n7, v2 = 'Yes')
guard(b2, n8, v2 = 'No')
label(b3, n12, "Packing Slip Received")
label(b3, n13, "Invoice Received")