    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "The opening clause implicitly triggers the process start and directly describes the initial action of identifying the vacancy."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "action:n3",
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "Captures the suitability check, the XOR decision split, the negative guard condition, the advertising action, and the implicit positive continuation path."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->n6",
        "action:n6",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "Faithfully models the secondary availability check, the decision gateway, the negative guard routing to the repeat advertisement, and the positive forward path."
    },
    {
      "refs": [
        "action:n5",
        "guard:b3->c1",
        "action:n7",
        "guard:b3->n6"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Restates the final suitability evaluation, splits the flow via the gateway, applies the positive guard to route to the selection step, and includes the structural negative branch for completeness."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "The converge node collects the preceding conditional paths, followed by the appointment step, termination description, and explicit end node, fully covering the closing clause."
    }
  ],
