      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle."
      ],
      "justification": "The opening clause justifies the process start (init), the explicit start step (action:n1), and the resupply trigger action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, check the current inventory level."
      ],
      "justification": "Direct correspondence to the inventory verification step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the inventory level is above the minimum"
      ],
      "justification": "The XOR branch and its positive guard faithfully capture the upper-threshold condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process ends"
      ],
      "justification": "The action and terminal node jointly implement the early termination path."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the inventory level is below the minimum"
      ],
      "justification": "Guard accurately reflects the lower-threshold condition on the alternate branch arm."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "create a purchase order"
      ],
      "justification": "Exact match to the procurement creation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the purchase order is created, review it."
      ],
      "justification": "Faithfully reproduces the initial review requirement."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected"
      ],
      "justification": "Branch and guard correctly model the rejection decision point."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "rework the purchase order"
      ],
      "justification": "Direct match to the correction/rework step."
    },
    {
      "refs": [
        "guard:b2->b4"
      ],
      "verbatim_texts": [
        "if the purchase order is accepted"
      ],
      "justification": "Guard correctly routes acceptance toward the parallel execution phase."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, review it again."
      ],
      "justification": "Accurately captures the secondary review step."
    },
    {
      "refs": [
        "action:n9",
        "action:n12"
      ],
      "verbatim_texts": [
        "reserve funds for the purchase and send the purchase order to the supplier"
      ],
      "justification": "Both actions split the single source clause into its two constituent parallel tasks without altering meaning."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, release the reserved funds"
      ],
      "justification": "Content closely mirrors the source step combining slip receipt and fund release."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "and then the process ends"
      ],
      "justification": "Structural end node aligns with the explicit process termination statement."
    }
