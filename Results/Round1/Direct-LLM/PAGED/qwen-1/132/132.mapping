    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "After that, we send the offer, and once the offer is sent, we wait for the customer to accept it."
      ],
      "justification": "Single compound sentence cleanly supports both the sending and waiting actions."
    },
    {
      "refs": [
