    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "At the same time, we complete the following steps simultaneously: reserving the article and calculating the price."
      ],
      "justification": "The introductory span lists both tasks that correspond to these two action elements."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
