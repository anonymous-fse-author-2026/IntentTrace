      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order and then proceed to Check the Customer's Credit Limit."
      ],
      "justification": "Process initiation and the first two sequential actions are directly derived from this opening instruction."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article.",
        "If the response is \"Okay\"",
        "However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "The XOR branch splits the credit limit response. Guards and actions faithfully implement the positive path (check availability) and negative path (send denial)."
    },
