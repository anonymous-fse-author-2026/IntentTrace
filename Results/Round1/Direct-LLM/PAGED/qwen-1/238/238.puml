@startuml
!theme plain
|a_default| Default
|a_default|
start
:Place Order;
:Check Customers Credit Limit;
:v1: Credit Limit Okay ({No, Okay}); <<objectSignal>>
if () then ([v1 = 'No'])
:Send Denial To Customer;
else ([v1 = 'Okay'])
:Check Availability Of Article;
:v2: Article Available ({No, Okay}); <<objectSignal>>
if () then ([v2 = 'No'])
:Produce the Goods;
else ([v2 = 'Okay'])
:Collect the Goods;
endif
:Send Order Confirmation;
split
:Ship the Goods;
split again
:Send Invoice;
end split
repeat :;
:Check Payment Status;
:v3: Payment Received ({No, Okay}); <<objectSignal>>
backward:Write Off the Order; Send Reminder; Close the Order;
repeat while () is ([v3 = 'No']) not ([v3 = 'Okay'])
:Close the Order;
endif
stop
@enduml