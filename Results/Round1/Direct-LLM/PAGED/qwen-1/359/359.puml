@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start the process by identifying the vacancy;
:v1: Is there a suitable candidate available initially ({available, not_available}); <<objectSignal>>
if () then ([v1 = 'not_available'])
:Advertise the vacancy;
:v2: Is there a suitable candidate available after advertising ({available, not_available}); <<objectSignal>>
if () then ([v2 = 'not_available'])
:Advertise the vacancy again;
else ([v2 = 'available'])
:Select the appropriate applicant;
:Candidate is appointed;
:Process ends after candidate appointment;
endif
stop
else ([v1 = 'available'])
->;
endif
@enduml