init(i1)
action(n1, "Start process")
action(n2, "Check SLA knowledge")
branch(b1, XOR)
action(n3, "Continue the process after knowing SLA")
action(n4, "Look up SLA")
converge(c1)
action(n5, "Enter the date")
action(n6, "Check task urgency")
branch(b2, XOR)
action(n7, "Red Stamp task")
action(n8, "Continue process with Non Urgent task")
end(e1)
converge(c2)
defines(v1, "Knows SLA", {true, false})
defines(v2, "Task is Urgent", {true, false})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, c1, n5, n6, b2, n7, n8, e1, c2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, c1)
precedence(c1, n5)
precedence(n5, n6)
precedence(n6, b2)
precedence(b2, n7)
precedence(b2, n8)
precedence(n7, c2)
precedence(n8, c2)
precedence(c2, e1)
guard(b1, n3, v1 = true)
guard(b1, n4, v1 = false)
guard(b2, n7, v2 = true)
guard(b2, n8, v2 = false)