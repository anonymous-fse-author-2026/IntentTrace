{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "The opening clause implicitly initiates the process and directly describes the initial registration action."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no fee"
      ],
      "justification": "The conditional clause establishes the XOR decision point and defines the guard condition for the no-fee path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "register a post-seminar request"
      ],
      "justification": "Directly corresponds to the action specified for the no-fee scenario."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if there is a fee, you need to create a purchase request"
      ],
      "justification": "Provides the alternative guard condition and the corresponding purchase request creation action."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "check if the purchase request has been approved"
      ],
      "justification": "The verification instruction implies the exclusive branching decision before routing to approval or rejection outcomes."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Accurately captures the positive condition guard and the subsequent notification reception step."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Accurately captures the negative condition guard and the corresponding rejection notification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "The instructional clause faithfully restates the post-approval registration action."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Explicitly denotes the process termination following a rejection notification."
    }
  ],
