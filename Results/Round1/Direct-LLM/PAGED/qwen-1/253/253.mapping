{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "The opening clause implicitly starts the process and defines the initial trigger step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level."
      ],
      "justification": "Direct correspondence to the inventory verification action."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\", then proceed to Create Purchase Order. However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "The full conditional statement introduces the exclusive split for inventory evaluation."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "\"Inventory level is at or below the minimum\""
      ],
      "justification": "Guard captures the affirmative condition leading to order creation."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to Create Purchase Order"
      ],
      "justification": "Action executed when inventory falls below the threshold."
    },
    {
      "refs": [
        "guard:b1->e1"
      ],
      "verbatim_texts": [
        "\"Inventory Level is above the minimum\""
      ],
      "justification": "Guard captures the negative condition terminating the process early."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "then the process ends"
      ],
      "justification": "Explicit termination point for the sufficient inventory path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Directly maps to the sequential review step post-order creation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved"
      ],
      "justification": "The conditional inquiry initiates the approval/rejection decision gateway."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "Purchase Order is approved"
      ],
      "justification": "Guard represents the positive approval outcome."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "reserve the funds for the purchase"
      ],
      "justification": "Action triggered upon order approval."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "Purchase Order is rejected"
      ],
      "justification": "Guard represents the negative rejection outcome."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "rework the order"
      ],
      "justification": "Action triggered upon order rejection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Sequential step dispatched after fund reservation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Loop-back review step for rejected orders, faithfully restating the source."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "Keyword 'Simultaneously' explicitly signals parallel execution requiring an AND gateway."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the Supplier sends a packing slip and an invoice."
      ],
      "justification": "Describes the supplier's concurrent deliverable actions initiating the parallel paths."
    },
    {
      "refs": [
        "label:b3->n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received"
      ],
      "justification": "Temporal condition labeling the trigger for the packing slip branch."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "record it."
      ],
      "justification": "Action to log the received packing slip."
    },
    {
      "refs": [
        "label:b3->n13"
      ],
      "verbatim_texts": [
        "when the invoice is received"
      ],
      "justification": "Temporal condition labeling the trigger for the invoice branch."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "record it as well."
      ],
      "justification": "Action to log the received invoice."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice,"
      ],
      "justification": "Synchronization point waiting for completion of both parallel recording tasks."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "Final financial actions executed after convergence."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Explicit process termination statement marking successful completion."
    }
