@startuml
!theme plain
|a_default| Default
|a_default|
start
:start by placing an order;
:check customer eligibility;
:v1: check customer eligibility ({eligible, not eligible}); <<objectSignal>>
if () then ([v1 = 'not eligible'])
:inform customer not eligible;
stop
else ([v1 = 'eligible'])
:open new order in ERP system;
:perform availability check;
:v2: perform availability check ({available, unavailable}); <<objectSignal>>
if () then ([v2 = 'unavailable'])
:start producing missing parts;
:prepare products for shipment;
else ([v2 = 'available'])
:prepare products for shipment;
endif
split
:ship the products;
:payment received?;
:v3: payment received? ({received, not received}); <<objectSignal>>
if () then ([v3 = 'received'])
:close order;
stop
else ([v3 = 'not received'])
:send payment reminder;
:reminders sent count < 3?;
:v4: reminders sent count < 3? ({<3, 3}); <<objectSignal>>
if () then ([v4 = '<3'])
:send another payment reminder;
else ([v4 = '3'])
:inform lawyer and end process;
endif
endif
split again
:send the invoice;
split again
end split
:check for payment;
endif
@enduml