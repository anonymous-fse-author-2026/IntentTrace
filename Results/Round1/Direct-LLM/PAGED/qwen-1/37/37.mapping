{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "The opening clause implicitly starts the process and directly specifies the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "then proceed to Check the Customer's Credit Limit"
      ],
      "justification": "Direct imperative match for the second step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the response is",
        "\"Okay\", proceed to Check the Availability of the Article",
        "if the response is",
        "\"No\", send a Denial to the Customer"
      ],
      "justification": "Structural XOR split capturing the bifurcation based on credit check response."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the response is",
        "\"Okay\", proceed to Check the Availability of the Article"
      ],
      "justification": "Guard correctly captures the positive response condition and target."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the response is",
        "\"No\", send a Denial to the Customer"
      ],
      "justification": "Guard correctly captures the negative response condition and target."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "After checking the availability, if the response is",
        "\"Okay\", proceed to Check the Availability of the Article again"
      ],
      "justification": "Structural XOR split for the post-availability check decision point."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "After checking the availability, if the response is",
        "\"Okay\", proceed to Check the Availability of the Article again"
      ],
      "justification": "Guard aligns with the conditional leading to the repeated check."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "\"No\", send a Denial to the Customer"
      ],
      "justification": "Captures the second textual occurrence of the denial path condition."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the Article is not available",
        "If the Article is not available, proceed to Produce the Goods",
        "if the Article is available, proceed to Collect the Goods"
      ],
      "justification": "Structural XOR split handling the article availability decision."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If the Article is not available",
        "If the Article is not available, proceed to Produce the Goods"
      ],
      "justification": "Guard matches the unavailability condition."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "if the Article is available, proceed to Collect the Goods"
      ],
      "justification": "Guard paraphrases 'available' as 'Yes', preserving core boolean logic."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods"
      ],
      "justification": "Faithfully restates the production step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "if the Article is available, proceed to Collect the Goods"
      ],
      "justification": "Faithfully restates the collection step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation"
      ],
      "justification": "Direct match for the confirmation step."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice"
      ],
      "justification": "AND gateway and parallel actions faithfully capture the concurrent shipping and invoicing."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Check the Payment status"
      ],
      "justification": "Direct match for payment verification."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "If the payment has been received",
        "If the payment has been received, close the Order and end the process",
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3"
      ],
      "justification": "Structural XOR split handling payment outcome branching."
    },
    {
      "refs": [
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "If the payment has been received",
        "If the payment has been received, close the Order and end the process"
      ],
      "justification": "Guard correctly routes the positive payment path."
    },
    {
      "refs": [
        "guard:b4->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3"
      ],
      "justification": "Guard and action jointly cover the unpaid payment fallback condition."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order",
