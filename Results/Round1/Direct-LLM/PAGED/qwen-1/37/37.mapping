      ],
      "justification": "Structural split handling the reminder count threshold and additional step."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order"
      ],
      "justification": "Guard and action faithfully implement the write-off threshold and step."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder"
      ],
      "justification": "Guard and action cover the supplementary reminder dispatch."
