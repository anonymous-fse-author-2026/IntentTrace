  "additions": [
    {
      "refs": [
        "guard:b3->n8"
      ],
      "reason": "Routes to the 'End' action when no candidate is found on the final check. The source text only specifies proceeding to selection if a candidate is available and explicitly ties the process end to successful appointment. This guard invents an unsupported termination path."
    }
