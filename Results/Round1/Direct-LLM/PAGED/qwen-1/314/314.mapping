  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "The opening clause implicitly triggers the process start and explicitly defines the initial identification step."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy. However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "The conditional statement establishes the first decision checkpoint (branch), its two logical outcomes (guards), and frames the availability inquiry (action)."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "advertise the vacancy"
      ],
      "justification": "Direct implementation of the prescribed action for the initial negative condition."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n3",
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "Captures the second availability check, the split logic, and the conditional routing following the first advertisement."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "advertise the vacancy again"
      ],
      "justification": "Exact match for the fallback advertising step triggered by the second negative check."
    },
    {
      "refs": [
        "action:n7",
        "guard:b3->n3"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Maps the final affirmative condition and the directional flow toward the selection phase."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "selecting the appropriate applicant"
      ],
      "justification": "Faithfully restates the selection instruction. The element is reused across paths, which is permitted redundancy."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed"
      ],
      "justification": "Corresponds to the appointment milestone that precedes termination."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "The action and structural end node jointly implement the explicit termination condition tied to appointment."
    }
  ],
  "mutations": [],
