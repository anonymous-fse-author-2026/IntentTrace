@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start loan application process by receiving the loan application;
split
:Assess loan risk;
split again
:Check credit history;
end split
:Assess eligibility of applicant;
:v1: Is applicant eligible ({eligible, not_eligible}); <<objectSignal>>
if () then ([v1 = 'eligible'])
:Prepare acceptance pack;
:Send acceptance pack;
:End process after acceptance pack sent;
stop
else ([v1 = 'not_eligible'])
:Reject application;
:End process after rejection;
stop
endif
@enduml