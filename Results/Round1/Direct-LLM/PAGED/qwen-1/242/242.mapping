    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After the RFQ is submitted, the Quotation is also submitted."
      ],
      "justification": "Captures the sequential submission of the quotation."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the Quotation is submitted, we receive it."
      ],
      "justification": "Maps directly to the receipt of the quotation."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Upon receiving the Quotation, we then submit the Purchase Order."
      ],
      "justification": "Accurately reflects the purchase order submission step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "Simultaneously, we complete two steps:"
      ],
