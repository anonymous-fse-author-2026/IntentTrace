      ],
      "justification": "Directly corresponds to the second parallel task."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the Goods are sent, we mark them as sent."
      ],
      "justification": "Faithfully restates the post-send marking step for goods."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Similarly, after the Invoice is sent, we mark it as sent."
      ],
      "justification": "Faithfully restates the post-send marking step for the invoice."
    }
