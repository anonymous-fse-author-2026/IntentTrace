  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "Implicit process start and direct paraphrase of the initial team joining and domain agreement step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model and check it."
      ],
      "justification": "Direct alignment with the modeling and verification instruction."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\", then assign negative points."
      ],
      "justification": "Condition evaluation, exclusive choice, and penalty assignment match the source clause exactly."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\", assign negative points again."
      ],
      "justification": "Second condition check, branching, and repeated penalty assignment align perfectly."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Both continuation actions faithfully capture the positive workflow path described in the source."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Issue detection, decision split, and remediation/expansion steps match the source granularity."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points"
      ],
      "justification": "Segmented condition and subsequent continuation step align with the split input units."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Segmented condition and subsequent continuation step align with the split input units."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Analysis trigger, branching logic, and role assignment correspond exactly."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Decision point and the dual-action workflow continuation/role execution match the source."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct restatement of the progress monitoring and troubleshooting step."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it."
      ],
      "justification": "Acceptance verification, branching, and presentation action align with the source."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Exact match of the fallback operational path."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Repeated acceptance check and branching logic correspond to the source. (Presentation action handled in mutations due to strictness)."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Final presentation step and explicit process termination signal match the closing sentence."
    }
