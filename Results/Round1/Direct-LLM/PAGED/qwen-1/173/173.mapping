{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "The opening span explicitly initiates the workflow and defines the first required step."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "The condition triggers the first XOR decision point; the guard v1=false correctly models the negative outcome path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then advertise the vacancy."
      ],
      "justification": "Directly implements the action prescribed for the first negative branch."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "if there is a suitable candidate available,"
      ],
      "justification": "Models the positive outcome of the first decision using v1=true."
    },
    {
      "refs": [
        "action:n5",
        "guard:b3->n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available,"
      ],
      "justification": "Represents the second decision checkpoint and its negative guard condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then advertise the vacancy again."
      ],
      "justification": "Faithfully executes the repeated advertising step specified for the second negative branch."
    },
    {
      "refs": [
        "guard:b3->c1",
        "action:n7"
      ],
      "verbatim_texts": [
        "then proceed with selecting the appropriate applicant."
      ],
      "justification": "The positive path from the second branch (v1=true) merges at the converge node before executing the selection action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed,"
      ],
      "justification": "Directly corresponds to the appointment step preceding termination."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Explicitly signals workflow completion mapped to the terminal node."
    }
  ],
