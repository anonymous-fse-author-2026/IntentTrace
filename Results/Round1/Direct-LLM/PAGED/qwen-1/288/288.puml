@startuml
!theme plain
|a_default| Review Clerk
|a_default|
start
:review the received application;
:load the case data;
:review the case;
:v1: are there any new findings ({yes, no}); <<objectSignal>>
if () then ([v1 = 'yes'])
:recalculate the refund;
else ([v1 = 'no'])
:send a letter of denial;
endif
:v2: are there any new findings ({yes, no}); <<objectSignal>>
if () then ([v2 = 'yes'])
:recalculate the refund;
else ([v2 = 'no'])
:send another letter of denial;
endif
:write back the case data;
stop
@enduml