      ],
      "verbatim_texts": [
        "To begin the process, start with"
      ],
      "justification": "The init node captures the process start, and n1 faithfully restates the initial instruction."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "Orders Required and then place a Bulk order."
      ],
      "justification": "Both action nodes directly map to the two sequential steps described in the span."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
      ],
      "justification": "b1 captures the decision point, and n5 matches the positive-arm action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "if the order exceeds the purchaser's credit allowance, there will be an Outstanding Balance."
      ],
      "justification": "n6 accurately reflects the resulting state described in the negative arm."
    },
    {
      "refs": [
        "action:n7",
        "action:n12"
      ],
      "verbatim_texts": [
        "a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "n7 covers placing the new order, while n12 and e1 jointly represent the process termination described."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If a new order is placed, it will be recorded in the Accounts Receivable."
      ],
      "justification": "Directly matches the recording step triggered by the new order."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If Payments are Received, the process continues."
      ],
      "justification": "b2 represents the payment decision, and n10 matches the continuation action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "if no payments are received, the order is dropped."
      ],
      "justification": "Accurately captures the negative payment outcome."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Next, identify the order for installation."
      ],
      "justification": "Exact alignment with the next sequential step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled, an Installer will be assigned."
      ],
      "justification": "b3 marks the installation decision, and n15 matches the assignment action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "if the order does not require installation, it will be packed for delivery.",
