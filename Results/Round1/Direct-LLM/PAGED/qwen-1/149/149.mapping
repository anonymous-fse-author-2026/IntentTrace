{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For the customer, the process begins with a request to purchase a motorcycle."
      ],
      "justification": "The opening clause establishes the process trigger (init) and defines the initial customer action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once the request is received, the next step is to either continue the process if a production order is received"
      ],
      "justification": "Describes the evaluation checkpoint and implicitly opens the XOR split based on production order status."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "continue the process if a production order is received"
      ],
      "justification": "Captures the affirmative branch condition and the resulting continuation step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "update the sales information and proceed to order dispatch"
      ],
      "justification": "Captures the alternative branch condition and the resulting dual action step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If there are unavailable materials"
      ],
      "justification": "Establishes the material availability verification and the subsequent decision gateway."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "they are ordered from the supplier"
      ],
      "justification": "Maps the unavailability outcome directly to the supplier ordering action."
    },
    {
      "refs": [
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "Alternatively, if there are available goods for production"
      ],
      "justification": "Captures the alternative availability condition routing flow toward manufacturing."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "a manufacturing order is placed"
      ],
      "justification": "Faithfully restates the placement of the manufacturing order."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier"
      ],
      "justification": "Models the receipt of external materials as a distinct process step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the goods are issued and the motorcycles are produced"
      ],
      "justification": "Accurately combines the issuance and production actions into a single step as described."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "At the same time",
        "Simultaneously"
      ],
      "justification": "Both temporal markers signal concurrent execution paths correctly modeled by the AND gateway."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the stock is updated"
      ],
      "justification": "Directly corresponds to the inventory update step referenced multiple times in the flow."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the motorcycles are dispatched"
      ],
      "justification": "Exact match for the vehicle dispatch action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "The terminal statement justifies both the structural end node and the explicit closing action step."
    }
  ],
