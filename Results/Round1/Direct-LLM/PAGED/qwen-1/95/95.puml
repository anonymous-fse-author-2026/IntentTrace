@startuml
!theme plain
|a_default| Default
|a_default|
start
:Place Order;
:Check Customer Credit Limit;
:v1: Credit response okay ({Okay, No}); <<objectSignal>>
if () then ([v1 = 'No'])
:Send Denial to Customer;
else ([v1 = 'Okay'])
:Check Availability of Article;
:v2: Availability okay first check ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:Check Availability of Article again;
:v3: Article available second check ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:Collect Goods;
else ([v3 = 'No'])
:Produce Goods;
endif
:Send Order Confirmation;
split
:Ship Goods;
split again
:Send Invoice;
end split
:Check Payment status;
:v4: Payment received ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:Close Order;
:End process;
stop
else ([v4 = 'No'])
:v5: Reminder count greater than or equal to 3 ({Yes, No}); <<objectSignal>>
if () then ([v5 = 'Yes'])
:Write off Order;
:Send Reminder;
:Close Order;
:End process;
stop
endif
endif
else ([v2 = 'No'])
:Send Denial to Customer;
endif
endif
@enduml