  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process for WIGGO"
    },
    {
      "id": "i2",
      "content": "placing an Order"
    },
    {
      "id": "i3",
      "content": "Check the Customer's Credit Limit"
    },
    {
      "id": "i4",
      "content": "If the response is \"Okay\", proceed to Check the Availability of the Article."
    },
    {
      "id": "i5",
      "content": "if the response is \"No\", send a Denial to the Customer."
    },
    {
      "id": "i6",
      "content": "if the response is \"Okay\", proceed to Check the Availability of the Article again."
    },
    {
      "id": "i7",
      "content": "If the response is \"No\", send a Denial to the Customer."
    },
    {
      "id": "i8",
      "content": "If the Article is not available, proceed to Produce the Goods."
    },
    {
      "id": "i9",
      "content": "if the Article is available, proceed to Collect the Goods."
    },
    {
      "id": "i10",
      "content": "send an Order Confirmation."
    },
    {
      "id": "i11",
      "content": "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
    },
    {
      "id": "i12",
      "content": "Check the Payment status."
    },
    {
      "id": "i13",
      "content": "If the payment has been received, close the Order and end the process."
    },
    {
      "id": "i14",
      "content": "If the payment has not been received, check if the Reminder count is greater than or equal to 3."
    },
    {
      "id": "i15",
      "content": "If the Reminder count is greater than or equal to 3, Write off the Order."
    },
    {
      "id": "i16",
      "content": "Additionally, send a Reminder."
    },
    {
      "id": "i17",
      "content": "After writing off the Order, close the Order and end the process."
    }
  ]
