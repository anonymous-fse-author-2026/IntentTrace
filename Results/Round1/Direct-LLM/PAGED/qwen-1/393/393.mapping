    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form, which is then received by the next level manager."
      ],
      "justification": "Direct paraphrase of the form submission and receipt step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
