      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks"
      ],
      "justification": "The opening clause establishes the process initiation and defines the first operational step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then they should select the method for exit control checks."
      ],
      "justification": "Direct restatement of the second sequential selection step."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics"
      ],
      "justification": "The conditional introduces the XOR branch and supplies the guard value for the biometrics path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "they should undergo a check using biometrics."
      ],
      "justification": "Faithful execution step corresponding to the biometrics choice."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if the passenger prefers to use ID documents"
      ],
      "justification": "Captures the alternative condition for the second branch arm."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should undergo checks using identity documents."
      ],
      "justification": "Direct implementation of the ID document check step."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After the exit control checks,"
      ],
      "justification": "Temporal phrase implies the structural merging of the two parallel check paths before the next decision."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "if the passenger is denied permission"
      ],
      "justification": "Introduces the second decision point and defines the negative guard condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should leave the area"
      ],
      "justification": "Action executed when the permission condition evaluates to denied."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "if the passenger is allowed to continue"
      ],
      "justification": "Defines the positive guard condition for continuation."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they should proceed to the next step"
      ],
      "justification": "Action executed when allowed to continue."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful"
      ],
      "justification": "The conditional is modeled as an evaluation action and a branch, with the guard accurately capturing the unsuccessful outcome threshold."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the passenger should leave the area and the process ends."
      ],
      "justification": "Combines the departure action and the explicit process termination signal."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "if the outcome is successful"
      ],
      "justification": "Guard captures the successful outcome condition for the alternate branch arm."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "the passenger should continue to the next step and the process ends."
