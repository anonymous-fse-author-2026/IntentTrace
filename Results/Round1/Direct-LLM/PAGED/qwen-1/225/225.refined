init(i1)
action(n1, "start acme process")
action(n2, "receive customer request")
action(n3, "check inventory level")
branch(b1, XOR)
action(n4, "accept customer request")
action(n4a, "create purchase order")
action(n5, "reject request - end process")
end(e1)
action(n6, "review purchase order")
branch(b2, XOR)
action(n7, "rework purchase order")
action(n8, "reserve funds")
action(n9, "send purchase order")
action(n10, "receive packing slip")
action(n11, "record packing slip")
action(n12, "release reserved funds and issue payment")
action(n13, "receive invoice")
action(n14, "record invoice")
action(n15, "end process")
end(e2)
converge(c1)
branch(b3, AND)
defines(v1, "check inventory level", {below_min, above_min})
defines(v2, "review purchase order", {approved, rejected})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n4a, n5, e1, n6, b2, n7, n8, n9, n10, n11, n12, n13, n14, n15, e2, c1, b3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(n4, n4a)
precedence(n4a, n6)
precedence(b1, n5)
precedence(n5, e1)
precedence(n6, b2)
precedence(b2, n7)
precedence(n7, n6)
precedence(b2, n8)
precedence(n8, n9)
precedence(n9, b3)
precedence(b3, n10)
precedence(n10, n11)
precedence(n11, c1)
precedence(b3, n13)
precedence(n13, n14)
precedence(n14, c1)
precedence(c1, n12)
precedence(n12, n15)
precedence(n15, e2)
guard(b1, n4, v1 = 'below_min')
guard(b1, n5, v1 = 'above_min')
guard(b2, n7, v2 = 'rejected')
guard(b2, n8, v2 = 'approved')