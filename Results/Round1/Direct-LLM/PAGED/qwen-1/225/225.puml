@startuml
!theme plain
|a_default| Default
|a_default|
start
:start acme process;
:receive customer request;
:check inventory level;
if () then ([v1 = 'below_min'])
:accept customer request;
:create purchase order;
repeat :review purchase order;
backward:rework purchase order;
repeat while () is ([v2 = 'rejected']) not ([v2 = 'approved'])
:reserve funds;
:send purchase order;
split
:receive packing slip;
:record packing slip;
split again
:receive invoice;
:record invoice;
end split
:release reserved funds and issue payment;
:end process;
stop
else ([v1 = 'above_min'])
:reject request - end process;
stop
endif
