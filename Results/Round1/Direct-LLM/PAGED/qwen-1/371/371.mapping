{
  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "The opening sentence explicitly defines the process start and the two initial actions."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "The conditional threshold, decision gateway, guard value (>1000), and resulting review action all directly correspond to this clause."
    },
    {
      "refs": [
        "guard:b1->c1",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "The alternative guard (<=1000) flows into the convergence point and immediately triggers the translation-check action."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9",
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts. If not, confirm the receipts."
      ],
      "justification": "The exclusive choice, its Yes/No guards, and the respective translate/confirm actions faithfully implement the branching instructions."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "The first evaluation step and its associated decision gateway map directly to this unit."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7",
        "guard:b4->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "The source describes this rejection path twice due to the process loop; the model correctly implements it on both decision branches."
    },
    {
      "refs": [
        "guard:b2->c1",
        "action:n8"
      ],
      "verbatim_texts": [
        "continue to check if there is a need for translation."
      ],
      "justification": "The approved path from the first review converges back to the translation check, reusing the same structural and action nodes as intended by the loop."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "The second evaluation step and its decision gateway correspond to this explicit instruction."
    },
    {
      "refs": [
        "guard:b4->n13",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "The approved guard from the second review feeds into the sequential translate and confirm actions."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "The final evaluation action and its corresponding decision gateway match this unit exactly."
    },
    {
      "refs": [
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "The acceptance guard and subsequent processing action align perfectly with the source."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "The rejection guard and edit-report action directly implement this fallback path."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "The closing instruction explicitly signals the process termination, mapped to the End action and terminal node."
    }
  ],
