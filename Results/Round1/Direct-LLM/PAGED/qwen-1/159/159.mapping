      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the Referee Reports have been completed, you can move on to organizing interviews for the Selection Panel with the top candidates."
      ],
      "reason": "The element drops the specific qualifier 'with the top candidates', altering the defined target scope of the interviews."
    }
  ],
