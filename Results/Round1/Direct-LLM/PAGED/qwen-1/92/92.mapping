{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To start,"
      ],
      "justification": "Explicitly indicates the process initiation point."
    },
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "please register your participation for the event."
      ],
      "justification": "Directly implements the first registration step with identical wording."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3",
        "action:n2"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request."
      ],
      "justification": "Captures the exclusive decision point, the 'no fee' guard condition, the resulting registration action, and the redundant query action representing the condition check."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "Maps to the alternative 'fee' guard condition and the corresponding purchase request creation action."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Marks the termination point immediately following the no-fee registration path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Represents the approval verification step and the subsequent exclusive decision gateway."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Aligns perfectly with the approval condition guard and the notification receipt step."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Aligns perfectly with the rejection condition guard and the rejection notification step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Faithfully reproduces the follow-up registration action triggered by approval."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Correctly places the second termination point following the rejection path."
    }
  ],
