@startuml
!theme plain
|a_customer_web| Customer and Web Design Team
|a_web_team| Web Design Team
|a_process_ctrl| Process Control
|a_process_ctrl|
start
|a_customer_web|
:Informational meeting;
|a_process_ctrl|
:v1: Is meeting successful? ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:End process;
stop
else ([v1 = 'Yes'])
|a_customer_web|
:Create storyboard;
|a_process_ctrl|
:v_sb: Is storyboard successful? ({Not successful, Successful}); <<objectSignal>>
if () then ([v_sb = 'Not successful'])
:End process;
stop
else ([v_sb = 'Successful'])
split
|a_web_team|
:Prepare content;
-> Site ready;
split again
:Design site;
-> Site ready;
end split
:Develop site;
:Review site;
|a_process_ctrl|
:v2: Review site ({Not successful, Successful}); <<objectSignal>>
if () then ([v2 = 'Not successful'])
:End process;
stop
else ([v2 = 'Successful'])
|a_web_team|
:Approve site;
|a_process_ctrl|
:v3: Approve site ({Approved, Rejected}); <<objectSignal>>
if () then ([v3 = 'Approved'])
:End process;
stop
else ([v3 = 'Rejected'])
|a_web_team|
:Rebuild site;
|a_process_ctrl|
:v_rb: Rebuild outcome ({Complete, Rejected}); <<objectSignal>>
if () then ([v_rb = 'Complete'])
:End process;
else ([v_rb = 'Rejected'])
|a_web_team|
:Rebuild site again;
|a_process_ctrl|
endif
stop
endif
endif
endif
endif
@enduml