init(i1)
action(n1, "Start by receiving the invoice")
action(n2, "Check the invoice for any mismatches")
branch(b1, XOR)
action(n4, "Continue process after re-sending invoice")
action(n7, "Continue process after posting invoice")
action(n9, "Continue process after blocking invoice")
converge(c2)
action(n10, "Park the invoice")
action(n11, "End process")
end(e2)
defines(v1, "Check the invoice for any mismatches", {"Proceed to re-send check", "Proceed to post check", "Proceed to block check"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, n7, n9, c2, n10, n11, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n7)
precedence(b1, n9)
precedence(n4, c2)
precedence(n7, c2)
precedence(n9, c2)
precedence(c2, n10)
precedence(n10, n11)
precedence(n11, e2)
guard(b1, n4, v1 = 'Proceed to re-send check')
guard(b1, n7, v1 = 'Proceed to post check')
guard(b1, n9, v1 = 'Proceed to block check')