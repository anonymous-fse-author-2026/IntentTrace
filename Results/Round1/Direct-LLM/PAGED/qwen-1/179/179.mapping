{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "Opening clause implicitly starts the process and defines the initial team formation action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model"
      ],
      "justification": "Directly corresponds to the instruction to create the model after setup."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "and check it. If the process model is \"NOT OK\","
      ],
      "justification": "The conditional evaluation of the model introduces the XOR split."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "and check it. If the process model is \"NOT OK\","
      ],
      "justification": "Guard captures the negative condition; action executes the penalty assignment."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then assign negative points."
      ],
      "justification": "Guard captures the negative condition; action executes the penalty assignment."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\","
      ],
      "justification": "Second conditional check introduces another XOR split."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\","
      ],
      "justification": "Guard captures the repeated negative condition; action assigns the repeated penalty."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "assign negative points again."
      ],
      "justification": "Guard captures the repeated negative condition; action assigns the repeated penalty."
    },
    {
      "refs": [
        "guard:b1->n7",
        "guard:b2->n8",
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Positive outcome from either check converges into proceeding with the process."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Action restates the remediation steps described in the source."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "Conditional branch models the decision point between checking/assigning versus analyzing."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "Guard captures the primary decision trigger; action proceeds as instructed."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Standalone unit explicitly instructs continuation, matched by the action step."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Guard captures the alternative analysis condition; action assigns team roles."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Conditional approval triggers the work execution phase."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Guard confirms the positive state; actions decompose the continuation and role-based work."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Directly matches the monitoring and consultation step."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it."
      ],
      "justification": "Acceptance condition introduces a presentation decision point."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it."
      ],
      "justification": "Guard verifies acceptance; action executes the presentation."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Guard handles the rejection fallback; action continues role-based work."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Second acceptance check introduces another presentation decision."
    },
    {
      "refs": [
        "guard:b6->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Guard verifies second acceptance; action presents the project."
    },
    {
      "refs": [
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Matches the repeated fallback instruction for non-acceptance."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Convergence nodes gather final paths; action performs the concluding presentation and end node terminates the flow."
    }
  ],
