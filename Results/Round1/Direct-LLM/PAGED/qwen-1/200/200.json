  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start by placing an order"
    },
    {
      "id": "i2",
      "content": "then check the customer."
    },
    {
      "id": "i3",
      "content": "If the customer is \"not eligible to order\", inform them. Otherwise, if the customer is \"eligible to order\""
    },
    {
      "id": "i4",
      "content": "open a new order in the ERP system."
    },
    {
      "id": "i5",
      "content": "After informing the customer, the process ends."
    },
    {
      "id": "i6",
      "content": "Open a new order in the ERP system and perform an availability check."
    },
    {
      "id": "i7",
      "content": "perform an availability check."
    },
    {
      "id": "i8",
      "content": "Check if the product is \"available\"."
    },
    {
      "id": "i9",
      "content": "If it is not"
    },
    {
      "id": "i10",
      "content": "start producing the missing parts."
    },
    {
      "id": "i11",
      "content": "Otherwise, continue the process."
    },
    {
      "id": "i12",
      "content": "Prepare the products for shipment."
    },
    {
      "id": "i13",
      "content": "ship the products"
    },
    {
      "id": "i14",
      "content": "send the invoice"
    },
    {
      "id": "i15",
      "content": "while checking for payment."
    },
    {
      "id": "i16",
      "content": "If the payment is received, close the order."
    },
    {
      "id": "i17",
      "content": "If the payment is not received, send a reminder."
    },
    {
      "id": "i18",
      "content": "If the number of reminders is less than 3, continue the process."
    },
    {
      "id": "i19",
      "content": "Otherwise, if the number of reminders is equal to 3"
    },
    {
      "id": "i20",
      "content": "inform the lawyer and end the process."
    }
  ]
