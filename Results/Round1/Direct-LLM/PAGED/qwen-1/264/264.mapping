{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "The init node establishes the process start implied by 'Initially', and the action accurately captures sending the approval form."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Directly corresponds to the step of receiving the approval."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Faithfully restates the step of contacting TS for timing clarification."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Accurately represents the approval checking step."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1->n6",
        "action:n6",
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized. If the resource is external, the appointment is also authorized."
      ],
      "justification": "The XOR branch and guards correctly split the flow based on internal vs external resources, leading to the appropriate authorization actions. Action n5 redundantly states the condition but preserves meaning."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Captures sending the mandatory documentation and approval to HR services."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Direct match for scanning and recording the form into GovSource."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Sequentially models checking the approval and subsequently sending it with documentation to HR."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Action n12 covers HR receiving the documents, and end:e1 correctly marks process termination."
    },
    {
      "refs": [
        "action:n13",
        "action:n14",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues. However, if there are variations, a business case is completed."
      ],
      "justification": "These actions capture the branching outcomes regarding process continuation and business case completion."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues. However, if there are variations, a business case is completed and attached."
      ],
      "justification": "Actions faithfully reproduce the extended clause covering continuation and attaching the business case."
    }
  ],
