@startuml
!theme plain
|a_default| Default
|actor_faculty| Faculty
|actor_mpc| MPC
|a_default|
start
:start;
:send: Course Packet Information Received;
:send: Design to Faculty;
|actor_faculty|
:choose: Faculty chooses the design;
|a_default|
repeat :identify: Content requiring copyright clearance;
:contact: Contact publisher for clearance;
:v1: is copyright cleared? ({true, false}); <<objectSignal>>
backward:notify: Contact Faculty to inform of denial and ask if new content should be added;
repeat while () is ([v1 = false]) not ([v1 = true])
|actor_mpc|
repeat :calculate: Calculate the Course Packet Cost;
:add: Add Bookstore margin to determine retail price;
:v2: is price finalized? ({true, false}); <<objectSignal>>
backward:reconsider: Re-evaluate content after reconsideration;
repeat while () is ([v2 = false]) not ([v2 = true])
:notify: Notify bookstore of finalization;
|a_default|
stop
@enduml