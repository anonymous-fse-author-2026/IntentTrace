    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For the customer, the process begins with a request to purchase a motorcycle."
      ],
      "justification": "The opening clause explicitly starts the process (init) and defines the initial triggering action."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "the next step is to either continue the process if a production order is received"
      ],
      "justification": "Describes the XOR decision point, the positive guard condition, and the corresponding continue action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "or update the sales information and proceed to order dispatch."
      ],
      "justification": "Defines the alternative branch guard and the two sequential actions on that path."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If there are unavailable materials,"
      ],
      "justification": "Signals a second XOR decision and the guard condition leading to the supplier ordering path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they are ordered from the supplier."
      ],
      "justification": "Directly corresponds to the action of ordering materials when unavailable."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "Alternatively, if there are available goods for production,"
      ],
      "justification": "Represents the alternative branch condition for the manufacturing path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "a manufacturing order is placed."
      ],
      "justification": "Faithfully restates the action taken when production goods are available."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier,"
      ],
      "justification": "Models the arrival/event of receiving materials/goods from the supplier."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "the goods are issued and the motorcycles are produced."
      ],
      "justification": "Splits the compound instruction into two distinct sequential action steps."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "At the same time, the stock is updated and the motorcycles are dispatched."
      ],
      "justification": "The concurrency marker 'At the same time' justifies the AND split gateway, branching into two parallel update/dispatch actions."
    },
    {
      "refs": [
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "After the goods are issued and the motorcycles are produced, the stock is updated and the process ends."
      ],
      "justification": "'After...' implies a convergence of prior paths, followed by a final stock update action, an explicit end process step, and the terminal node."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, the stock is updated and the sales information is updated."
      ],
      "justification": "'Simultaneously' denotes parallel execution that rejoins at the converge point, alongside the sales information update action."
    }
  ],
