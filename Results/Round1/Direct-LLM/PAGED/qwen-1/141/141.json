  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process at the Italian restaurant, first enter and ask for the menu."
    },
    {
      "id": "i2",
      "content": "After checking the offers"
    },
    {
      "id": "i3",
      "content": "simultaneously take the following steps"
    },
    {
      "id": "i4",
      "content": "order a glass of red wine and a salad."
    },
    {
      "id": "i5",
      "content": "Once the order is placed"
    },
    {
      "id": "i6",
      "content": "wait for it to arrive and then enjoy the salad and wine."
    },
    {
      "id": "i7",
      "content": "you will be asked if you would like a dessert."
    },
    {
      "id": "i8",
      "content": "If you answer \"yes\" to tiramisu,"
    },
    {
      "id": "i9",
      "content": "then go ahead and order it."
    },
    {
      "id": "i10",
      "content": "If you answer \"no\" to tiramisu,"
    },
    {
      "id": "i11",
      "content": "then simply decline any dessert."
    },
    {
      "id": "i12",
      "content": "If you did order tiramisu,"
    },
    {
      "id": "i13",
      "content": "wait for it to be served, then enjoy it."
    },
    {
      "id": "i14",
      "content": "Once you are ready, ask for the bill and proceed to pay it."
    },
    {
      "id": "i15",
      "content": "After settling the bill, you can leave the restaurant and the process will be complete."
    }
  ]
