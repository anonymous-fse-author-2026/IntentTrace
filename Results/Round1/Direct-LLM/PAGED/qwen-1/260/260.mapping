{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "The opening clause implicitly triggers the init node, explicitly justifies the standalone start label, and describes the initial receipt action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is sorted per client."
      ],
      "justification": "Direct correspondence to the first sorting step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor."
      ],
      "justification": "Direct correspondence to the second sorting step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice."
      ],
      "justification": "Faithful restatement of attaching the entry form."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form."
      ],
      "justification": "Exact alignment with data entry onto the form."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked."
      ],
      "justification": "Action performs the check, which structurally necessitates the subsequent XOR branch."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Guard captures the negative condition, action executes the termination, and end node marks process conclusion."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered. The date for completion is also entered and the priority is checked."
      ],
      "justification": "Guard routes the positive path; action consolidates the sequential SLA/data entry and priority verification described in the span."
    },
    {
      "refs": [
        "guard:b2->n11",
        "guard:b2->c1",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "Branch models the priority decision, guards route high/low outcomes, and action performs the stamping on the high-priority path."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Direct paraphrase preserving the compliance verification step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff... If it is a normal case... If none of these conditions apply..."
      ],
      "justification": "Structural branch captures the three-way routing logic outlined in the source unit."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "the non-compliance invoice is processed."
      ],
      "justification": "Guard routes to the experienced-staff condition, and action processes the corresponding non-compliance document."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "the client is called."
      ],
      "justification": "Guard routes to the normal-case condition, and action executes the client call."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Guard handles the fallback condition, action dispatches the mail request, and end node terminates this branch."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO"
      ],
      "justification": "Direct correspondence to the batching and allocation step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Labels the final termination state and concludes the main process flow."
    }
  ],
