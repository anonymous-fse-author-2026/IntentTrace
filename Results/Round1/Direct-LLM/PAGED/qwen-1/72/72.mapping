{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Captures the implicit start node, the explicit initiation action, and the first two sequential business steps."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Models the completeness check as an action feeding an XOR gateway; the true path executes the return step and terminates the branch."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "The false guard and subsequent action faithfully capture the continuation flow when completeness is confirmed."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Sets up the conditional evaluation step and the exclusive decision gateway for compliance handling."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "True branch condition and the corresponding resolution action align exactly with the source."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "False branch handles the mail-back contingency, returning the invoice and marking the sub-process end."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "The 'Simultaneously' keyword justifies the converge node, while the action captures the parallel billing task."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n14",
        "action:n14",
        "guard:b3->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Encapsulates the response check, the branching logic, and both the waiting-period (true) and response-received (false) paths."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved.",
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Faithfully consolidates the payment execution and client notification described across the repeated source clauses."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Direct mapping of the delayed reminder action and the corresponding termination node."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Gateway evaluates client satisfaction; the negative outcome correctly triggers discrepancy resolution."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Positive outcome allows continuation, culminating in the final notification step and process end."
    }
  ],
