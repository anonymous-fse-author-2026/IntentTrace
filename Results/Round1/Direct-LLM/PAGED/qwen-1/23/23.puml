@startuml
!theme plain
|a_default| DMS Parts Provision Team
|a_default|
start
:gather part information from customer including make model and year;
:check availability of part in local inventory;
:v1: is part available locally ({Available, Not Available}); <<objectSignal>>
if () then ([v1 = "Available"])
:retrieve part from local inventory;
:end process after retrieving part;
stop
else ([v1 = "Not Available"])
:record customer details;
:order part from Disuki;
:end process after ordering part;
stop
endif
@enduml