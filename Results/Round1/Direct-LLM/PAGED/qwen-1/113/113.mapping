{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by claiming what is requested"
      ],
      "justification": "The opener implicitly triggers the process initiator. The redundant 'Start process' action and 'claim what is requested' action together faithfully reproduce the introductory instruction."
    },
    {
      "refs": [
        "guard:n4->n8"
      ],
      "verbatim_texts": [
        "If the claimant is insured,"
      ],
      "justification": "The XOR branch node and positive guard accurately capture the conditional opener and its affirmative path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed to evaluate the claim."
      ],
      "justification": "Direct paraphrase of the positive-arm action."
    },
    {
      "refs": [
        "guard:n4->n5"
      ],
      "verbatim_texts": [
        "However, if the claimant is not insured,"
      ],
      "justification": "Guard accurately models the negative conditional branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "reject the claim."
      ],
      "justification": "Exact match of the rejection instruction."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the claim is rejected, notify the claimant"
      ],
      "justification": "Faithfully captures the notification step following rejection."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "and the process comes to an end."
      ],
      "justification": "Explicit termination phrase maps directly to the end node."
    },
    {
      "refs": [
        "guard:n9->n10",
        "guard:n9->n11"
      ],
      "verbatim_texts": [
        "If the claim is a simple one or a complex one,"
      ],
      "justification": "Branch node and two guards correctly split the inclusive OR condition into two exclusive paths."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "send the relevant forms accordingly."
      ],
      "justification": "Both actions distribute the single source instruction across the two guarded paths, preserving the operational meaning."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Once the forms are returned,"
      ],
      "justification": "Temporal completion marker implies synchronization of the simple/complex form paths, justifying the converge node."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "check them for completeness."
      ],
      "justification": "Direct paraphrase of the completeness verification step."
    },
    {
      "refs": [
        "guard:n13->n15"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided,"
      ],
      "justification": "Branch and positive guard correctly model the completeness condition."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "proceed to register the claim."
      ],
      "justification": "Accurate restatement of the registration step."
    },
    {
      "refs": [
        "guard:n13->n14"
      ],
      "verbatim_texts": [
        "However, if not all the relevant details are provided,"
      ],
      "justification": "Negative guard correctly captures the incomplete-details condition."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "inform the claimant to complete them."
      ],
      "justification": "Faithfully models the follow-up notification action."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Once the claim is registered, the process comes to an end."
      ],
      "justification": "Explicit closing statement maps directly to the second end node."
    }
