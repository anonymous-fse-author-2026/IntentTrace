{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially,"
      ],
      "justification": "Explicitly marks the start/context of the process flow."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
      "justification": "Defines the XOR decision point and its positive condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Directly specifies the action on the positive branch."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Captures the negative condition and both resulting steps (indications and research)."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule,"
      ],
      "justification": "Models the validation step immediately preceding the next check."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory."
      ],
      "justification": "Establishes the satisfaction evaluation as a decision gate."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Maps the unsatisfactory condition and the remediation action."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Maps the satisfactory condition and the subsequent ticketing action."
    },
    {
      "refs": [
        "guard:b3->n11",
        "guard:b3->n12",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\". Alternatively, if the schedule is satisfactory,"
      ],
      "justification": "Covers the secondary satisfaction check, its split guards, and the negative-action arm."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "write a ticket order to SNCF."
      ],
      "justification": "Matches the positive-arm action following the alternative clause."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Corresponds to the post-writing validation step."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Represents the approval verification gate."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15",
        "action:n18"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Aligns with the rejection outcome. action:n18 is included as a structurally redundant restatement permitted by the redundancy rule."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Maps the approval confirmation and the subsequent validation step."
    },
    {
      "refs": [
        "guard:b5->n18"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Captures the repeated approval check and its implied negative exit path."
    },
    {
      "refs": [
        "guard:b6->n21"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Captures the final approval check and its implied negative exit path."
    },
    {
      "refs": [
        "guard:b6->n22",
        "action:n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Matches the final positive termination condition. action:n22 is a redundant restatement of the same outcome."
    }
  ],
  "mutations": [],
  "omissions": [],
  "additions": [
    {
      "refs": [
        "guard:b5->n19"
      ],
      "reason": "The guard leading to n19 and the action 'validate the ticket order once more' have no supporting source unit. The text proceeds directly from checking approval (i16) to checking again (i17) without inserting an additional validation step."
    },
