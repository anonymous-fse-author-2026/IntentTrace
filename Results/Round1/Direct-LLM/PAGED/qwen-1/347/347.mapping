{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME"
      ],
      "justification": "Opening clause implicitly signals process start and describes the initial action."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "begin with the New Resupply Cycle and then Check Levels of Inventory"
      ],
      "justification": "Directly maps to the two sequential opening steps."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "Condition establishes the first XOR decision point and its positive routing."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum"
      ],
      "justification": "Negative routing of the first branch correctly triggers the alternative report."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report"
      ],
      "justification": "Negative routing of the first branch correctly triggers the alternative report."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report"
      ],
      "justification": "Positive arm action precisely matches source instruction."
    },
    {
      "refs": [
        "converge:c_rep"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report",
        "generate an Above Minimum Report"
      ],
      "justification": "Structural converge implicitly joins the two parallel reporting paths."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum"
      ],
      "justification": "Second conditional establishes another XOR split and routes to PO creation."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum"
      ],
      "justification": "Negative arm of second branch correctly terminates the process early."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Negative arm of second branch correctly terminates the process early."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)"
      ],
      "justification": "Direct mapping of the positive outcome action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Captures the mandatory review step following PO creation."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked"
      ],
      "justification": "Rejection branch and corresponding rework action are faithfully modeled."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system"
      ],
      "justification": "Approval branch correctly routes to the print/release step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Accurately reflects the iterative rework loop condition and action."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "AND gateway correctly splits into two concurrent actions as specified."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Maps the downstream dependency for the funds reservation path."
    },
    {
      "refs": [
        "action:n36"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Maps the downstream dependency for the mailing path."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice.",
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Converge node rejoins the parallel physical/digital receipt paths before proceeding to invoice handling."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Direct sequential step after invoice receipt."
    },
    {
      "refs": [
        "action:n42",
        "guard:b9->n43",
        "action:n43"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Condition, decision node, successful guard, and resulting action are fully aligned."
    },
    {
      "refs": [
        "action:n44"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Correctly sequences payment issuance after fund release."
    },
    {
      "refs": [
        "action:n45"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Final action states cycle completion and structurally maps to the process end node."
    }
  ],
