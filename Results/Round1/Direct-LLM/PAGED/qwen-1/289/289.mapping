{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "The opening instruction initializes the process and describes the first interactive step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "The conditional threshold triggers an XOR split, routes to the review action via the correct guard."
    },
    {
      "refs": [
        "guard:b1->b2"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "The alternative threshold guard leads to the translation-check decision node."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5",
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts. If not, confirm the receipts."
      ],
      "justification": "Both translation-condition arms and their immediate convergence are fully modeled."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Directly implements the sequential evaluation step."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report. If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Covers both rejection/edit and approval/re-check paths with correct guards and actions."
    },
    {
      "refs": [
        "guard:b6->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Accurately models the second rejection condition and its corresponding edit action."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "The repeated evaluation is structurally represented by the XOR gateway preceding the next outcome set."
    },
    {
      "refs": [
        "guard:b6->n15",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Correctly captures the approval guard followed by the sequential translate-and-confirm steps."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Directly implements the final evaluation step."
    },
    {
      "refs": [
        "guard:b9->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Maps the acceptance condition and the processing action correctly."
    },
    {
      "refs": [
        "guard:b9->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Correctly models the rejection guard and the final edit action."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Structural termination node aligns with the explicit closing statement; processing was already covered."
    }
  ],
