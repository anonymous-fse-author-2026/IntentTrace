@startuml
!theme plain
|a_default| Default
|a_default|
start
:choose destination and calculate distance;
:check if need to book train or flight;
:v1: check if need to book train or flight ({yes, no}); <<objectSignal>>
if () then ([v1 = 'no'])
:book a train;
else ([v1 = 'yes'])
:book a flight;
endif
:check if code is available within 24 hours;
:v2: check if code is available within 24 hours ({yes, no}); <<objectSignal>>
if () then ([v2 = 'yes'])
:code available within 24 hours;
stop
else ([v2 = 'no'])
:call travel agency;
:check if code is available;
:v3: check if code is available ({yes, no}); <<objectSignal>>
if () then ([v3 = 'yes'])
:process ends along with hotel reservation;
stop
else ([v3 = 'no'])
:cancel journey;
stop
endif
endif
@enduml