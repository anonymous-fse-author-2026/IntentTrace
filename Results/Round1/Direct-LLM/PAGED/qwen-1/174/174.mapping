{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "The opening clause explicitly triggers the start event and defines the first two sequential actions. 'Start Process' is a permissible redundant restatement of initiation."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5",
        "guard:b1->n7",
        "action:c1"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned. However, if the invoice is complete, the process continues."
      ],
      "justification": "Captures the XOR decision on invoice completeness, the return action on the negative path, and the continuation on the positive path. Boolean guards correctly reflect the yes/no branching logic."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
        "action:n8",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted. On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Accurately models the compliance check, routes non-compliant cases to further checks, and directs compliant cases forward to continue."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->n10",
        "action:n10",
        "label:n10->c_pay",
        "guard:b3->n11",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved. But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Fideliy represents the phone-call resolution decision, the resolution action, the mail-back fallback returning the invoice, and the resulting resolved state."
    },
    {
      "refs": [
        "action:n13",
        "action:n14",
        "guard:b4->n15",
        "action:n15",
        "label:n15->c_notify",
        "guard:b4->c2",
        "action:c2"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Correctly sequences payment, evaluates post-payment return status, resolves non-compliance upon return, and continues the flow otherwise."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Maps the billing action to the client-facing stream. The two converge nodes structurally capture the parallel execution and rejoins implied by 'Simultaneously'."
    },
    {
      "refs": [
        "action:n19",
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Directly models the response check and applies the 10-day wait period when no response occurs."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Faithfully captures the client notification step following payment."
    },
    {
      "refs": [
        "action:n21",
        "action:n17",
        "action:n22"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Matches the reminder action and the explicit process termination. Duplicate end-related actions are retained as permissible redundancy."
    },
    {
      "refs": [
        "action:n23",
        "guard:b6->n24",
        "action:n24",
        "action:n25",
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved. However, if the client is satisfied, the process continues."
      ],
      "justification": "Accurately branches on client satisfaction, resolves discrepancies on dissatisfaction, and continues the flow on satisfaction."
    }
  ],
