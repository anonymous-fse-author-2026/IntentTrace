@startuml
!theme plain
|a_default| Default
|a_supplier| Supplier
|a_default|
start
:Resupply Cycle Triggered;
:Check Inventory Level;
:v1: Inventory Level at or below minimum ({At or below, Above}); <<objectSignal>>
if () then ([v1 = 'At or below'])
:Create Purchase Order;
:Reviewing Purchase Order;
:v2: Purchase Order Approved ({Approved, Rejected}); <<objectSignal>>
if () then ([v2 = 'Approved'])
:Reserve Funds for Purchase;
:Send Order to Suppliers;
split
|a_supplier|
:Supplier sends packing slip;
|a_default|
:Record packing slip;
split again
|a_supplier|
:Supplier sends invoice;
|a_default|
:Record invoice;
end split
:Release reserved funds;
:Issue payment to supplier;
stop
else ([v2 = 'Rejected'])
:Rework Order;
:Reviewing Purchase Order;
endif
else ([v1 = 'Above'])
stop
endif
@enduml