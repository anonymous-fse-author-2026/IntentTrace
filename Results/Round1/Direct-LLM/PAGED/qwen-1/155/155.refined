branch(b3, AND)
defines(v1, "Inventory Level at or below minimum", {"At or below", "Above"})
defines(v2, "Purchase Order Approved", {"Approved", "Rejected"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, e1, n6, b2, n8, n9, n10, n11, n14, n15, n16, n17, e2, c1, b3])
