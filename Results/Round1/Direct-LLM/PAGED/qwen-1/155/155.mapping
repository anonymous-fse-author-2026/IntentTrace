{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "The opening clause explicitly signals process initiation and names the triggering action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level."
      ],
      "justification": "Directly maps to the sequential inventory verification step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\","
      ],
      "justification": "The conditional clause inherently creates the XOR decision point and defines the guard for the lower-bound path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then proceed to Create Purchase Order."
      ],
      "justification": "Corresponds to the action taken when the inventory threshold condition is met."
    },
    {
      "refs": [
        "guard:b1->e1"
      ],
      "verbatim_texts": [
        "However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "The alternative condition and explicit termination statement jointly justify the upper-bound guard and the immediate end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Matches the sequential review step following PO creation."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved,"
      ],
      "justification": "Approval condition introduces the second XOR gateway and its positive guard."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then reserve the funds for the purchase."
      ],
      "justification": "Direct action associated with the approval path."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the Purchase Order is rejected, then rework the order."
      ],
      "justification": "Reject condition and its corresponding corrective action are captured together."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Sequential step triggered after fund reservation."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Maps to the post-rework review step; functional repetition aligns with the model's duplicate action node."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "Concurrency marker explicitly mandates parallel execution, justifying the AND gateway."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "the Supplier sends a packing slip and an invoice."
      ],
      "justification": "The combined supplier output is correctly decomposed into two parallel action nodes."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it."
      ],
      "justification": "Directly corresponds to the packing slip recording task."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Similarly, when the invoice is received, record it as well."
      ],
      "justification": "Directly corresponds to the invoice recording task."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice,"
      ],
      "justification": "Completion of both independent recording tasks implies synchronization before proceeding, justifying the converge node."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "The compound instruction is accurately split into two subsequent financial actions."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Explicit closing statement maps directly to the final termination node."
    }
  ],
