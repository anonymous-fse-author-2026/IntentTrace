  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order"
      ],
      "justification": "The opening clause implicitly starts the process (init) and describes the initial placement action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then check the customer."
      ],
      "justification": "Direct correspondence to the second sequential step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer is"
      ],
      "justification": "The conditional opening implies the XOR split and is restated as an action step checking eligibility."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "not eligible to order"
      ],
      "justification": "Captures the negative condition path leading to the inform action."
    },
    {
      "refs": [
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "eligible to order"
      ],
      "justification": "Captures the positive condition path leading to the ERP order action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "inform them."
      ],
      "justification": "Direct match to the consequence of the negative eligibility branch."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Explicitly signals the termination of this branch path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "open a new order in the ERP system."
      ],
      "justification": "Direct match to the consequence of the positive eligibility branch."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "and perform an availability check."
      ],
      "justification": "Direct match to the subsequent verification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Check if the product is"
      ],
      "justification": "The verification step implies the next decision split and is modeled as both an action and a branch."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Captures the negative availability condition."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "start producing the missing parts."
      ],
      "justification": "Direct match to the production trigger step."
    },
    {
      "refs": [
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process."
      ],
      "justification": "Captures the positive availability path proceeding to the next phase."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Direct match to the preparation step."
    },
    {
      "refs": [
        "action:n12",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "The concurrency keyword triggers the AND gateway, which splits into the three simultaneous parallel actions."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the payment is",
        "received"
      ],
      "justification": "The conditional statement defines the payment outcome decision point."
    },
    {
      "refs": [
        "guard:b3->n16"
      ],
      "verbatim_texts": [
        "received"
      ],
      "justification": "Captures the positive payment condition."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "close the order."
      ],
      "justification": "Direct match to the successful payment outcome step."
    },
    {
      "refs": [
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "not received"
      ],
      "justification": "Captures the negative payment condition."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "send a reminder."
      ],
      "justification": "Direct match to the failed payment handling step."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "send a reminder and close the order, ending the process."
      ],
      "justification": "Reflects the alternative closing path described in the source."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "If the number of reminders is",
        "less than 3"
      ],
      "justification": "Defines the threshold decision for continuing versus terminating."
    },
    {
      "refs": [
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "less than 3"
      ],
      "justification": "Captures the condition allowing the process to continue."
    },
    {
      "refs": [
        "guard:b4->n20"
      ],
      "verbatim_texts": [
        "equal to 3"
      ],
      "justification": "Captures the threshold met condition triggering legal escalation."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "inform the lawyer"
      ],
      "justification": "Direct match to the escalation action."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "and end the process."
      ],
      "justification": "Explicitly marks the final termination of the workflow."
    },
    {
      "refs": [
        "converge:c4"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Implicitly models the rejoining of paths after the reminder loop checks."
    }
