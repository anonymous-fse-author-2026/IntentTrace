{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "The opening clause implicitly initiates the workflow and explicitly names the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "then proceed to Check Levels of Inventory."
      ],
      "justification": "Directly corresponds to the sequential action of checking inventory levels."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the inventory is",
        "\"greater than\" the minimum",
        "\"below or equal to\" the minimum"
      ],
      "justification": "The conditional phrasing establishes an exclusive decision point between two inventory states."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the inventory is",
        "\"greater than\" the minimum"
      ],
      "justification": "Faithfully captures the positive condition for routing to the above-minimum report."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "generate an \"Above Minimum Report\""
      ],
      "justification": "Exact semantic match for generating the report when inventory exceeds the threshold."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "\"below or equal to\" the minimum"
      ],
      "justification": "Accurately reflects the negative/equal condition for routing to the alternative report."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an \"Equal to or below minimum Report\""
      ],
      "justification": "Directly implements the action tied to the lower/inventory-met condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process ends with the End Resupply Cycle."
      ],
      "justification": "The clause simultaneously describes the final action and signals process termination for this path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "POs are Created."
      ],
      "justification": "Matches the creation step triggered by the below/equal minimum report path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the POs are Created, they are subject to POs Review."
      ],
      "justification": "Paraphrases the review step while preserving the exact target and sequence."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the POs are",
        "\"rejected\"",
        "\"approved\""
      ],
      "justification": "Establishes the second exclusive decision gate based on PO review outcomes."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If the POs are",
        "\"rejected\""
      ],
      "justification": "Captures the rejection condition directing flow to rework."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "they need to be \"reworked\""
      ],
      "justification": "Directly implements the mandatory rework step upon rejection."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "\"approved\""
      ],
      "justification": "Reflects the approval condition directing flow to printing/release."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "they are \"Printed and released in the system\""
      ],
      "justification": "Faithfully restates the final fulfillment action for approved POs."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Explicitly marks the termination point following the approved PO path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the POs are \"reworked\", then POs are Created again."
      ],
      "justification": "Corresponds to the loop-back action that recreates POs after rework is complete."
    }
