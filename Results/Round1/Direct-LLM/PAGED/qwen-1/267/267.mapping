{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "For EC-Lille:"
      ],
      "justification": "Contextual header implicitly defines the process start point."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "Initially, if the option \"research schedule directly\" is selected"
      ],
      "justification": "The conditional question, XOR decision node, and true guard collectively capture the initial selection check."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Directly corresponds to the prescribed action when the option is selected."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "The false guard and two subsequent actions faithfully implement the alternative path and its compound steps."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Captures the validation step, the satisfaction check question, and the resulting decision point."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "The false guard and repeated research action match the unsatisfactory outcome path."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "The true guard and ticket-writing action match the satisfactory outcome path."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11",
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\". Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Models the secondary satisfaction check, the branching logic, and both divergent outcomes exactly as described."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Direct paraphrase of the post-writting validation step."
    },
    {
      "refs": [
        "action:n14",
        "guard:b4->e1",
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
      ],
      "justification": "Completely covers the first approval check, the termination condition, and the validation action for approval."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->e2",
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
      ],
      "justification": "Faithfully reproduces the second approval iteration, including termination and re-validation paths."
    },
    {
      "refs": [
        "action:n20",
        "guard:b6->e3",
        "guard:b6->e4"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved. If it is, then the process ends. If it is not, then the process ends."
      ],
      "justification": "Accurately models the final approval check and the dual termination endpoints regardless of outcome."
    }
  ],
