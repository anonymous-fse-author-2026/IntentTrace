@startuml
!theme plain
|a_default| Default
|a_default|
start
:receive form;
:check if form is complete;
:v1: check if form is complete ({needs to be sent back, need to check the income}); <<objectSignal>>
if () then ([v1 = 'need to check the income'])
split
:check income;
split again
:check deductibles;
split again
:check house;
end split
:make decision;
:v2: make decision ({check the declaration, invite the declarant}); <<objectSignal>>
if () then ([v2 = 'check the declaration'])
stop
else ([v2 = 'invite the declarant'])
stop
endif
else ([v1 = 'needs to be sent back'])
stop
endif
@enduml