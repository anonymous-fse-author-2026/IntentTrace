init(i1)
action(n2, "check loan application")
branch(b1, XOR)
end(e1)
branch(b2, XOR)
action(n7, "disburse funds")
end(e3)
defines(v1, "is application rejected", {"Yes", "No"})
defines(v2, "are special terms agreed upon", {"No", "Yes"})
actor(a_default, "Default", [i1, n2, b1, e1, b2, n7, e3])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, e1)
precedence(b1, b2)
precedence(b2, n7)
precedence(n7, e3)
guard(b1, e1, v1 = 'Yes')
guard(b1, b2, v1 = 'No')
guard(b2, n7, v2 = 'Yes')