@startuml
!theme plain
|a_default| Default
|a_mac| Mac
|a_default|
start
:check inventory;
|a_mac|
:compare inventory levels with sales;
:is inventory level high;
:v1: is inventory level high ({high, low}); <<objectSignal>>
if () then ([v1 = 'high'])
:no manual count needed;
else ([v1 = 'low'])
:need manual inventory count;
:count each item manually;
:make list of low stock items;
:select suppliers for low stock items;
:place orders for needed products;
endif
|a_default|
:received the order;
:end process;
stop
@enduml