      ],
      "verbatim_texts": [
        "To begin the process, start with Insurance \"emergency\" and then analyze the insurance agreement."
      ],
      "justification": "The opening clause establishes the process initiation and specifies the two sequential starting actions."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If there is coverage"
      ],
      "justification": "The conditional phrase dictates the XOR split, the coverage verification step, the true/false routing guards, and the subsequent path merger."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "offer immediate help"
      ],
      "justification": "Direct restatement of the action taken when coverage exists."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "send out an offer for emergency help"
      ],
      "justification": "Exact match to the action taken when coverage is absent."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "ask for a rejection notification"
      ],
      "justification": "Direct match to the step executed upon offer rejection."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n8",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If it is accepted"
      ],
      "justification": "The acceptance condition drives the second XOR decision, the acceptance check step, and the associated true/false routing guards."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed with internal accounting"
      ],
      "justification": "Exact match to the action following offer acceptance."
    },
    {
      "refs": [
        "guard:b3->n2",
        "guard:b3->e1"
      ],
      "verbatim_texts": [
        "Repeat the same steps if necessary."
      ],
      "justification": "The repetition criterion governs the loop-back branch and determines whether execution continues or terminates."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "The process concludes once all steps have been completed."
      ],
      "justification": "Explicitly signals the final termination point of the workflow."
    }
