  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start with Insurance \"emergency\" and then analyze the insurance agreement."
    },
    {
      "id": "i2",
      "content": "If there is coverage"
    },
    {
      "id": "i3",
      "content": "offer immediate help"
    },
    {
      "id": "i4",
      "content": "send out an offer for emergency help"
    },
    {
      "id": "i5",
      "content": "ask for a rejection notification"
    },
    {
      "id": "i6",
      "content": "If it is accepted"
    },
    {
      "id": "i7",
      "content": "proceed with internal accounting"
    },
    {
      "id": "i8",
      "content": "Repeat the same steps if necessary."
    },
    {
      "id": "i9",
      "content": "The process concludes once all steps have been completed."
    }
  ]
