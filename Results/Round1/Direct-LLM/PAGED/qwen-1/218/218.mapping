{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For MyCorp, the process begins by entering expenses."
      ],
      "justification": "The opening clause implicitly signals the process start and explicitly describes the first actionable step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After entering expenses, the next step is to generate a spreadsheet."
      ],
      "justification": "Direct correspondence to the sequential next step in the workflow."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the spreadsheet is generated, the request can be approved or disapproved."
      ],
      "justification": "Describes the evaluation point that triggers the first exclusive decision gateway and its associated check action."
    },
    {
      "refs": [
        "guard:b1->n2"
      ],
      "verbatim_texts": [
        "If the request is not approved, the process goes back to entering expenses."
      ],
      "justification": "Maps the negative conditional outcome to the guard directing flow back to the expense entry step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the request is approved, the expenses can be paid out."
      ],
      "justification": "Maps the positive conditional outcome to the guard and the subsequent payment execution step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Describes the repeated evaluation point, triggering the second exclusive decision gateway and its check action."
    },
    {
      "refs": [
        "guard:b2->n2"
      ],
      "verbatim_texts": [
        "If it is not approved, the process goes back to entering expenses."
      ],
      "justification": "Maps the second negative conditional outcome to the guard looping back to the initial step."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if it is approved, the expenses can be paid out."
      ],
      "justification": "Maps the second positive conditional outcome to the guard and the final payment execution step."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, after the expenses are paid out, the process comes to an end."
      ],
      "justification": "Explicitly marks the termination point of the described workflow."
    }
  ],
