init(i1)
action(n1, "obtaining the raw material from the received list")
action(n2, "Is raw material available in stock?")
branch(b1, XOR)
action(n3, "Check raw material")
end(e1)
action(n6, "Select supplier")
action(n7, "Send material purchase order")
action(n8, "Check raw material after PO")
end(e2)
defines(v1, "Is raw material available in stock?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, e1, n6, n7, n8, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(n3, e1)
precedence(b1, n6)
precedence(n6, n7)
precedence(n7, n8)
precedence(n8, e2)
guard(b1, n3, v1 = "Yes")
guard(b1, n6, v1 = "No")