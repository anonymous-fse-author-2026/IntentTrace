init(i1)
action(n1, "Start reviewing the incoming CV")
branch(b1, XOR)
action(n3, "Send negative email")
end(e1)
action(n4, "Schedule an interview with the candidate")
action(n5, "Conduct the interview")
end(e2)
defines(v1, "Decision", {"Send a negative email", "Invite the candidate"})
actor(a_default, "Default", [i1, n1, b1, n3, e1, n4, n5, e2])
precedence(i1, n1)
precedence(n1, b1)
precedence(n3, e1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n4, n5)
precedence(n5, e2)
guard(b1, n3, v1 = 'Send a negative email')
guard(b1, n4, v1 = 'Invite the candidate')