init(i1)
action(n2, "Provide shipping information")
action(n3, "Determine shipping details")
branch(b1, XOR)
converge(c1)
action(n5, "Confirm shipping address")
action(n7, "Select shipping speed")
end(e1)
defines(v1, "Is the shipping address saved or new?", {"Saved shipping address", "New shipping address"})
actor(a_default, "Default", [i1, n2, n3, b1, c1, n5, n7, e1])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, c1)
precedence(b1, c1)
precedence(c1, n5)
precedence(n5, n7)
precedence(n7, e1)
guard(b1, c1, v1 = 'Saved shipping address')
guard(b1, c1, v1 = 'New shipping address')