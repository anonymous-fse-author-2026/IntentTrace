init(i1)
action(n1, "Start by identifying the vacancy")
action(n2, "Any candidates available?")
branch(b1, XOR)
converge(c1)
action(n3, "Select Applicant")
action(n4, "Advertise Vacancy")
action(n5, "After advertising  any candidates?")
branch(b2, XOR)
action(n6, "Advertise Again")
action(n8, "Appoint candidate")
end(e1)
defines(v1, "Any candidates available?", {true, false})
defines(v2, "After advertising  any candidates?", {true, false})
actor(a_default, "Default", [i1, n1, n2, b1, c1, n3, n4, n5, b2, n6, n8, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, c1)
precedence(b1, n4)
precedence(n4, n5)
precedence(n5, b2)
precedence(b2, c1)
precedence(b2, n6)
precedence(c1, n3)
precedence(n6, e1)
precedence(n3, n8)
precedence(n8, e1)
guard(b1, c1, v1 == true)
guard(b1, n4, v1 == false)
guard(b2, c1, v2 == true)
guard(b2, n6, v2 == false)