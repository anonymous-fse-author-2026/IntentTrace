@startuml
!theme plain
|a_default| Default
|a_default|
start
:start by placing an order;
:check customer eligibility;
:v1: check customer eligibility ({eligible to order, not eligible to order}); <<objectSignal>>
if () then ([v1 == "not eligible to order"])
:inform customer not eligible;
:end process;
stop
else ([v1 == "eligible to order"])
:open new order in ERP system;
:perform availability check;
:v2: perform availability check ({available, not available}); <<objectSignal>>
if () then ([v2 == "not available"])
:start producing missing parts;
:prepare products for shipment;
split
:ship the products;
:payment received?;
:v3: payment received? ({received, not received}); <<objectSignal>>
if () then ([v3 == "received"])
:close order;
stop
else ([v3 == "not received"])
:send payment reminder;
:reminders sent count < 3?;
:v4: reminders sent count < 3? ({< 3, = 3}); <<objectSignal>>
if () then ([v4 == "< 3"])
:send another payment reminder;
else ([v4 == "= 3"])
:inform lawyer and end process;
stop
endif
endif
split again
:send the invoice;
split again
end split
:check for payment;
else ([v2 == "available"])
:prepare products for shipment;
split
split again
split again
end split
endif
endif
@enduml