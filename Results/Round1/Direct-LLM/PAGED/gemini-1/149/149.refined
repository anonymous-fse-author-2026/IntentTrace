init(i1)
action(n1, "Request to Purchase Motorcycle")
action(n2, "Production Order Received?")
branch(b1, XOR)
action(n3, "Continue with Production Order")
action(n4, "Update Sales Information and Proceed to Dispatch")
converge(c1)
action(n5, "Check Material Availability")
branch(b2, XOR)
action(n6, "Order Materials from Supplier")
action(n7, "Receive Materials from Supplier")
action(n12, "Place Manufacturing Order")
converge(c2)
action(n8, "Issue Goods and Produce Motorcycles")
branch(b3, AND)
action(n9, "Update Stock Information")
action(n10, "Dispatch Motorcycles")
converge(c3)
branch(b4, AND)
action(n11, "End of Process")
action(n13, "Update Sales Information")
end(e1)
end(e2)

defines(v1, "Production Order Received?", {"Yes", "No"})
defines(v2, "Check Material Availability", {"Available", "Unavailable"})

actor(a_customer, "Customer", [i1, n1])
actor(a_supplier, "Supplier", [n6, n7])
actor(a_default, "Default", [n2, b1, n3, n4, c1, n5, b2, n12, c2, n8, b3, n9, n10, c3, b4, n11, n13, e1, e2])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, c1)
precedence(c1, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n12)
precedence(n6, n7)
precedence(n7, c2)
precedence(n12, c2)
precedence(c2, n8)
precedence(n8, b3)
precedence(b3, n9)
precedence(b3, n10)
precedence(n9, c3)
precedence(n10, c3)
precedence(c3, b4)
precedence(b4, n11)
precedence(b4, n13)
precedence(n11, e1)
precedence(n13, e2)

guard(b1, n3, v1 = "Yes")
guard(b1, n4, v1 = "No")
guard(b2, n12, v2 = "Available")
guard(b2, n6, v2 = "Unavailable")