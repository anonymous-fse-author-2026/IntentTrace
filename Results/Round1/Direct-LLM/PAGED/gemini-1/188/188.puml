@startuml
!theme plain
|a_default| IT Infrastructure
|a_default|
start
:Loan Application;
:Receive Loan Application;
:Check Banking Privilege Status;
:v1: Construct Error Response from Banking Privilege Status ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Error Message;
stop
else ([v1 = 'No'])
:Retrieve Customer Information;
:Check fulfillment of loan conditions;
:v2: Construct Error Response from loan conditions ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:Error Message;
stop
else ([v2 = 'No'])
:Calculate threshold amount;
:Check Creditworthiness;
:Designate Status;
:Initialize Loan Form;
:v4: Construct Approve Response ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:Approved Message;
stop
else ([v4 = 'No'])
:Reject Message;
stop
endif
endif
endif
@enduml