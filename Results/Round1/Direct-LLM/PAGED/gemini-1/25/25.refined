init(i1)
action(n1, "Provide requested shipping information")
action(n2, "Determine shipping details")
action(n3, "Is shipping address saved or new")
branch(b1, XOR)
action(n6, "Confirm shipping address")
action(n8, "Select desired shipping speed")
end(e1)
converge(c1)
defines(v1, "Is shipping address saved or new", {"Saved shipping address", "New shipping address"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n6, n8, e1, c1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, c1)
precedence(b1, c1)
precedence(c1, n6)
precedence(n6, n8)
precedence(n8, e1)
guard(b1, c1, v1 = "Saved shipping address")
guard(b1, c1, v1 = "New shipping address")