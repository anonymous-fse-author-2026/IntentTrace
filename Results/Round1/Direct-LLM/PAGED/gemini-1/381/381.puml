@startuml
!theme plain
|a_default| Default
|a_default|
start
split
:choose destination and calculate distance;
split again
:check if need to book train or flight;
end split
:v1: check if need to book train or flight ({no, yes}); <<objectSignal>>
if () then ([v1 == "no"])
:book a train;
:check if code is available within 24 hours (train);
:v2: check if code is available within 24 hours (train) ({available, passed}); <<objectSignal>>
if () then ([v2 == "available"])
:code available within 24 hours (train);
stop
else ([v2 == "passed"])
:call travel agency (train);
:v4: agency code (train) ({available, not available}); <<objectSignal>>
if () then ([v4 == "available"])
:hotel reservation (train);
stop
else ([v4 == "not available"])
:cancel your journey (train);
stop
endif
endif
else ([v1 == "yes"])
:book a flight;
:check if code is available within 24 hours (flight);
:v3: check if code is available within 24 hours (flight) ({available, passed}); <<objectSignal>>
if () then ([v3 == "available"])
:code available within 24 hours (flight);
stop
else ([v3 == "passed"])
:call travel agency (flight);
:v5: agency code (flight) ({available, not available}); <<objectSignal>>
if () then ([v5 == "available"])
:hotel reservation (flight);
stop
else ([v5 == "not available"])
:cancel your journey (flight);
stop
endif
endif
endif
@enduml