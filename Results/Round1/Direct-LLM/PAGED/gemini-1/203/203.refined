init(i1)
action(n2, "Check loan application")
branch(b1, XOR)
end(e1)
action(n6, "Disburse funds")
end(e2)
defines(v1, "Application check outcome", {"Rejected", "Special terms agreed upon"})
actor(a_default, "Default", [i1, n2, b1, e1, n6, e2])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, e1)
precedence(b1, n6)
precedence(n6, e2)
guard(b1, e1, v1 = 'Rejected')
guard(b1, n6, v1 = 'Special terms agreed upon')