@startuml
!theme plain
|a_default| Default
|a_default|
start
:trigger resupply cycle;
:check inventory level;
:v1: inventory level ({at or below the minimum, above the minimum}); <<objectSignal>>
if () then ([v1 = "at or below the minimum"])
:create purchase order;
repeat :;
:review purchase order;
:v2: purchase status ({rejected, approved}); <<objectSignal>>
backward:rework purchase order;
repeat while () is ([v2 = "rejected"]) not ([v2 = "approved"])
:reserve funds;
:send order to supplier;
split
:receive packing slip;
:record packing slip;
stop
split again
:receive invoice;
:record invoice;
stop
end split
else ([v1 = "above the minimum"])
stop
endif
@enduml