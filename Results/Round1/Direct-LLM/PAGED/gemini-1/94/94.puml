@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process by creating Temporary ID;
:access the eLiving System;
:verify the students identity;
:v1: is students identity confirmed ({confirmed, not confirmed}); <<objectSignal>>
if () then ([v1 = 'not confirmed'])
stop
else ([v1 = 'confirmed'])
:check if student account is frozen;
:v2: is student account frozen ({frozen, not frozen}); <<objectSignal>>
if () then ([v2 = 'not frozen'])
:continue with the process;
else ([v2 = 'frozen'])
:unfreeze the student account;
endif
:navigate to the Harco System;
:select Cardholder Transactions;
:choose Forgotten Card option;
:enter reason code and temporary card number;
:move to the point of sale system;
:scan the temporary card to complete the process;
stop
endif
@enduml