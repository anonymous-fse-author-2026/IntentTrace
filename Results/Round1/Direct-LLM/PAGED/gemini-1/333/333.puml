@startuml
!theme plain
|a_default| Default
|a_default|
start
:create a Temporary ID;
:access the eLiving System;
:verify the student's identity;
:check if the student account is frozen;
:v2: check if the student account is frozen ({Account not frozen, Account frozen}); <<objectSignal>>
if () then ([v2 = 'Account frozen'])
:unfreeze the student account;
else ([v2 = 'Account not frozen'])
->;
endif
:navigate to the Harco System;
:select Cardholder Transactions;
:choose Forgotten Card option;
:enter reason code and temporary card number;
:go to point of sale system;
:scan the temporary card to complete the process;
stop
