@startuml
!theme plain
|a_default| Default
|a_default|
start
:start course registration procedure;
:is exception needed;
:v1: is exception needed ({true, false}); <<objectSignal>>
if () then ([v1 == true])
:make request for exception;
:is exception approved;
:v2: is exception approved ({true, false}); <<objectSignal>>
if () then ([v2 == true])
:proceed to course enrollment;
:enroll in seminar group;
repeat :;
:start homework assignment;
:turn in homework;
:homework evaluation;
:is last homework;
:v3: is last homework ({true, false}); <<objectSignal>>
backward:give another homework assignment;
repeat while () is ([v3 == false]) not ([v3 == true])
:complete additional steps for accreditation and exam date announcement;
split
:grant accreditation;
split again
:announce exam date;
end split
:merge after granting accreditation and announcing exam date;
:sign up for exam;
repeat :;
:attend exam;
:exam evaluation;
:did pass exam;
:v4: did pass exam ({true, false}); <<objectSignal>>
backward:sign up again for exam;
repeat while () is ([v4 == false]) not ([v4 == true])
:course considered passed;
:merge course pass and exam re-sign up;
:continue process;
else ([v2 == false])
->;
endif
:End;
stop
else ([v1 == false])
:continue process without exception;
endif
@enduml