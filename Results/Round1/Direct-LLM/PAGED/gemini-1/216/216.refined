init(i1)
action(n1, "start process for resellers upon receiving an order")
action(n2, "send an invoice")
action(n3, "ship the products")
action(n4, "receive payment")
end(e1)
converge(c1)
branch(b1, AND)
actor(a_resellers, "resellers", [i1, n1, n2, n3, n4, e1, c1, b1])
precedence(i1, n1)
precedence(c1, e1)
precedence(n1, b1)
precedence(b1, n2)
precedence(b1, n3)
precedence(n2, n4)
precedence(n3, c1)
precedence(n4, c1)
label(n2, n4, "after sending invoice")
label(n3, c1, "after all steps completed")
label(n4, c1, "after all steps completed")