end(e1)
converge(c1)
converge(c2)
defines(v1, "answer", {"Yes", "No"})
defines(v2, "second answer", {"Yes", "No"})
actor(a_default, "ICT Logistics", [i1, n2, b1, n3, n4, b2, n5, n6, n7, n8, e1, c1, c2])
precedence(i1, n2)
precedence(n2, b1)
