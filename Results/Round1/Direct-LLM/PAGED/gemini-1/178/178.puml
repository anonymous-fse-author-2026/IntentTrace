@startuml
!theme plain
|a_default| ICT Logistics
|a_default|
start
:check answer;
:v1: answer ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'No'])
:acquire pricing;
else ([v1 = 'Yes'])
->;
endif
:check second answer;
:v2: second answer ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'No'])
:acquire pricing;
else ([v2 = 'Yes'])
->;
endif
:calculate margin;
:prepare offer;
:calculate transport rate;
stop
@enduml