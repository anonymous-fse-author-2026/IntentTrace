@startuml
!theme plain
|a_default| The Parts Provision Team
|a_default|
start
:request authorisation for extra Parts;
:v1: authorisation given ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:obtain requested Parts from stock;
else ([v1 = 'No'])
:stop work and wait for parts;
:resume work;
endif
stop
