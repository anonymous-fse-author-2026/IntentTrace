init(i1)
action(n2, "request authorisation for extra Parts")
branch(b1, XOR)
action(n4, "obtain requested Parts from stock")
action(n5, "stop work and wait for parts")
action(n7, "resume work")
end(e1)
converge(c1)
defines(v1, "authorisation given", {"Yes", "No"})
actor(a_default, "The Parts Provision Team", [i1, n2, b1, n4, n5, n7, e1, c1])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, n7)
precedence(n4, c1)
precedence(n7, c1)
precedence(c1, e1)
guard(b1, n4, v1 = 'Yes')
guard(b1, n5, v1 = 'No')