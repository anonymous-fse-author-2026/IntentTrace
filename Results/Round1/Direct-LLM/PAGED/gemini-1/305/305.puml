@startuml
!theme plain
|a_ground_floor| Ground Floor
|a_client| Client
|a_ground_floor|
start
:Invoice arrives on Ground Floor;
|a_client|
:Confirm payment possibility;
|a_ground_floor|
:v1: Can client pay? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Add cost centers and complete process;
stop
else ([v1 = 'No'])
:Reject invoice and return to client;
stop
endif
