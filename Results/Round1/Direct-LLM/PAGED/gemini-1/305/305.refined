init(i1)
action(n1, "Invoice arrives on Ground Floor")
action(n2, "Confirm payment possibility")
branch(b1, XOR)
action(n4, "Add cost centers and complete process")
end(e1)
action(n6, "Reject invoice and return to client")
end(e2)
defines(v1, "Can client pay?", {"Yes", "No"})
actor(a_ground_floor, "Ground Floor", [i1, n1, b1, n4, e1, n6, e2])
actor(a_client, "Client", [n2])
precedence(i1, n1)
precedence(n1, n2)
