@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start by receiving the invoice;
:Check the invoice for any mismatches;
:v1: Check the invoice for any mismatches ({Proceed to re-send check, Proceed to post check, Proceed to block check}); <<objectSignal>>
switch ()
case ([v1 = 'Proceed to re-send check'])
:v2: Is re-send the invoice to the customer needed ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:re-send the invoice to the customer;
else ([v2 = 'No'])
->;
endif
case ([v1 = 'Proceed to post check'])
:v3: Is option to post the invoice ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:post the invoice;
else ([v3 = 'No'])
->;
endif
case ([v1 = 'Proceed to block check'])
:v4: Is option to block the invoice ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:block the invoice;
else ([v4 = 'No'])
->;
endif
endswitch
:Park the invoice;
stop
@enduml