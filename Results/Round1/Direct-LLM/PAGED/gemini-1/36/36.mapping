{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "For Talent Seek: Initially"
      ],
      "justification": "Implicitly starts the process."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check if the applicant wishes to discuss the terms and conditions"
      ],
      "justification": "Sets up the XOR branch and the action checking the condition."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\""
      ],
      "justification": "Captures the positive condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to discuss the terms and conditions with the candidate"
      ],
      "justification": "Direct paraphrase of the action."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "Otherwise"
      ],
      "justification": "Captures the negative condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "check if the applicant wants to modify the terms and conditions"
      ],
      "justification": "Action and XOR branch for modifying terms."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "check if the change is within the set client limits"
      ],
      "justification": "Action and XOR branch for checking limits."
    },
    {
      "refs": [
        "guard:b3->n6"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Negative condition for limits."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "relay the applicant's changes"
      ],
      "justification": "Action to relay changes."
    },
    {
      "refs": [
        "guard:b3->n7"
      ],
      "verbatim_texts": [
        "If it is within the limits"
      ],
      "justification": "Positive condition for limits."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "relay the applicant's changes and continue with the process"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Make a formal offer"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable"
      ],
      "justification": "Action and XOR branch for acceptable changes."
    },
    {
      "refs": [
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If they are"
      ],
      "justification": "Positive condition."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "continue with the process"
      ],
      "justification": "Action to continue process."
    },
    {
      "refs": [
        "guard:b4->n15"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Negative condition."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "select a new applicant from the list"
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n16",
        "action:n19"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes"
      ],
      "justification": "The source text implies checking this twice; maps to both occurrences."
    },
    {
      "refs": [
        "guard:b5->n17",
        "guard:b6->n20"
      ],
      "verbatim_texts": [
        "If they do"
      ],
      "justification": "Positive condition mapped to both occurrences."
    },
    {
      "refs": [
        "action:n17",
        "action:n20"
      ],
      "verbatim_texts": [
