@startuml
!theme plain
|a_default| Default
|a_default|
start
:receive claim;
:create and record the claim;
:make a decision on the claim;
:v1: make a decision on the claim ({Rejected, Accepted}); <<objectSignal>>
if () then ([v1 = 'Rejected'])
:reject the claim;
:review the claim rejection;
:v2: review the claim rejection ({Accepted, Not Accepted}); <<objectSignal>>
if () then ([v2 = 'Accepted'])
:continue the process;
else ([v2 = 'Not Accepted'])
:also continue the process;
endif
else ([v1 = 'Accepted'])
:offer the benefit;
:prepare the claim discharge;
:record the benefit payment;
endif
split
:operate outgoing payment;
split again
:close the claim;
split again
:end of process;
end split
stop
@enduml