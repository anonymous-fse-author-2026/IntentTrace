@startuml
!theme plain
|a_default| Default
|a_default|
start
:Place an Order;
:Check Customer Eligibility;
:v1: Check Customer Eligibility ({eligible to order, not eligible to order}); <<objectSignal>>
if () then ([v1 == 'not eligible to order'])
:Inform Ineligible Customer;
:End Process - Ineligible;
stop
else ([v1 == 'eligible to order'])
:Open New Order in ERP System;
:Perform Availability Check;
:v2: Perform Availability Check ({available, not available}); <<objectSignal>>
if () then ([v2 == 'available'])
->;
else ([v2 == 'not available'])
:Start Producing Missing Parts;
endif
:Prepare Products for Shipment;
split
:Ship Products;
:v3: Check Payment Status ({received, not received}); <<objectSignal>>
if () then ([v3 == 'received'])
:Close Order - Payment Received;
stop
else ([v3 == 'not received'])
:Send Payment Reminder;
:Close Order;
:Check Number of Reminders;
:v4: Check Number of Reminders ({[0-3]}); <<objectSignal>>
if () then ([v4 < 3])
:Continue Process;
else ([v4 == 3])
:Inform Lawyer;
stop
endif
endif
split again
:Send Invoice;
split again
end split
:Check Payment Status;
endif
@enduml