@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start ONS Bootstrapping process;
:Is input a URN?;
:v1: Is input a URN? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Resolve URN to domain-name;
else ([v1 = 'No'])
->;
endif
:Check if the input is a URN or a URL;
:v2: Check if the input is a URN or a URL ({URN, URL}); <<objectSignal>>
if () then ([v2 = 'URN'])
:Send DNS query for the domain-name;
:Get list of URLs from DNS query;
else ([v2 = 'URL'])
->;
endif
:Link to designated DS;
:End of process;
stop
@enduml