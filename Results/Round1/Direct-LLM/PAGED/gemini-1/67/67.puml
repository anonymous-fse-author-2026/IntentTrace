repeat while () is ([v2 == "No"]) not ([v2 == "Yes"])
split
:Grant accreditation;
split again
:Announce exam date;
end split
repeat :;
:Sign up for exam;
:Attend exam;
:Exam evaluation;
:Is exam passed?;
:v3: Is exam passed? ({Yes, No}); <<objectSignal>>
backward:Sign up for exam again;
repeat while () is ([v3 == "No"]) not ([v3 == "Yes"])
:Course passed;
