  "mutations": [
    {
      "refs": [
        "action:n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete"
      ],
      "reason": "The source explicitly checks if the invoice is incomplete, but the model reverses the framing to ask if it is complete and swaps the target logic (v1='No')."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant"
      ],
      "reason": "The source checks if the invoice is non-compliant, but the model reverses this framing to ask if it is compliant and swaps the target logic (v2='No')."
    },
    {
      "refs": [
        "action:n21",
        "guard:b8->n22"
      ],
      "verbatim_texts": [
        "If there is no response"
      ],
      "reason": "The source checks for 'no response', but the model reverses the condition to ask 'Did client respond' and targets the negative outcome."
    },
    {
      "refs": [
        "action:n27",
        "guard:b9->n28"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied"
      ],
      "reason": "The source checks if the client is unsatisfied, but the model reverses the condition to ask if they are satisfied."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "if it is returned"
      ],
      "reason": "The model completely omits this condition, instead executing the subsequent non-compliance resolution step unconditionally."
    }
  ],
