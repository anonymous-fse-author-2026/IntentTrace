init(i1)
action(n1, "verifying the amount")
branch(b1, XOR)
action(n3, "Approve the expense report")
action(n4, "Evaluate the expense report")
branch(b2, XOR)
action(n6, "Approve the expense report")
end(e1)
end(e2)
converge(c1)
defines(v1, "amount", {"less than 200", "200 or more"})
defines(v2, "expense report", {"acceptable", "not satisfactory"})
actor(a_default, "Default", [i1, n1, b1, n3, n4, b2, n6, e1, e2, c1])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n4, b2)
precedence(b2, n6)
precedence(b2, e2)
precedence(n3, c1)
precedence(n6, c1)
precedence(c1, e1)
guard(b1, n3, v1 == "less than 200")
guard(b1, n4, v1 == "200 or more")
guard(b2, n6, v2 == "acceptable")
guard(b2, e2, v2 == "not satisfactory")