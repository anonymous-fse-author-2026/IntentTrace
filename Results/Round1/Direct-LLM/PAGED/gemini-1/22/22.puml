@startuml
!theme plain
|a_default| Default
|a_default|
start
:Receive Order Request;
:Register Order;
:Evaluate Order;
:v1: Evaluate Order ({NOK, ok}); <<objectSignal>>
if () then ([v1 = 'NOK'])
:Consider order as NOK;
stop
else ([v1 = 'ok'])
:Install Order;
:v2: Install Order ({unsuccessful, successful}); <<objectSignal>>
if () then ([v2 = 'successful'])
:Installation Check;
:Verify Installation;
:Prepare Billing;
:Mark as Ok;
stop
else ([v2 = 'unsuccessful'])
:Consider order as NOK;
stop
endif
endif
@enduml