init(i1)
action(n1, "Start immigration checks")
action(n2, "Select exit control check method")
branch(b1, XOR)
action(n3, "Undergo biometrics check")
action(n4, "Undergo ID documents check")
action(n5, "Evaluate exit control check permission")
branch(b2, XOR)
action(n6, "Passenger denied permission leave area")
action(n7, "Passenger allowed to continue proceed to next step")
action(n8, "Check exit control check outcome")
branch(b3, XOR)
action(n9, "Passenger leave area and end process")
action(n10, "Passenger continue next step and end process")
action(n11, "End")
end(e1)
converge(c1)
converge(c2)
defines(v1, "Select exit control check method", {"Biometrics", "ID documents"})
defines(v2, "Evaluate exit control check permission", {"Denied", "Allowed"})
defines(v3, "Check exit control check outcome", {"Unsuccessful", "Successful"})
actor(a_passenger, "Passenger", [i1, n1, n2, b1, n3, n4, n5, b2, n6, n7, n8, b3, n9, n10, n11, e1, c1, c2])
precedence(i1, n1)
precedence(n2, b1)
precedence(n5, b2)
precedence(n8, b3)
precedence(n11, e1)
precedence(c1, n5)
precedence(c2, n11)
precedence(n1, n2)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, c1)
precedence(b2, n6)
precedence(b2, n7)
precedence(n7, n8)
precedence(b3, n9)
precedence(b3, n10)
precedence(n6, c2)
precedence(n9, c2)
precedence(n10, c2)
guard(b1, n3, v1 == "Biometrics")
guard(b1, n4, v1 == "ID documents")
guard(b2, n6, v2 == "Denied")
guard(b2, n7, v2 == "Allowed")
guard(b3, n9, v3 == "Unsuccessful")
guard(b3, n10, v3 == "Successful")