{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To start the process for ACME,"
      ],
      "justification": "Implicitly starts the process."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin with the New Resupply Cycle"
      ],
      "justification": "Direct paraphrase of starting the cycle."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then Check Levels of Inventory."
      ],
      "justification": "Direct paraphrase of the action step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "Matches the XOR branch gateway and the condition text, modeled here as an action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report."
      ],
      "justification": "Direct paraphrase of generating the report."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report."
      ],
      "justification": "Direct paraphrase of generating the report."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "Captures the action to create Purchase Orders."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Matches the explicit termination."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Matches the XOR branch representing the decision and the subsequent rework action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Captures the action to print and release the POs."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed. If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Matches the action step to review the POs."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "Matches the parallel AND split and the two concurrent actions."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Matches the action to receive the inventory."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip.",
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Matches the action to receive the packing slip and the structural convergence implied by multiple paths logically leading to it."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Matches the action to receive the invoice."
    },
    {
      "refs": [
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match. If the Three-way match is successful, release the funds. Once the funds are released, issue the payment. After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Faithfully maps to the sequence of actions for the match, funds release, payment issuance, and final process end."
    }
  ],
