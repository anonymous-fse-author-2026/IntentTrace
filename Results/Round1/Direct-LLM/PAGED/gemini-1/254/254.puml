@startuml
!theme plain
|a_default| Default
|a_default|
start
:begin with the rector's final year in their current position;
:launch acceptance of proposals for candidates;
:nominate candidate for rector position;
:stop acceptance of proposals;
:check if candidate meets criteria;
:v1: check if candidate meets criteria ({meets criteria, does not meet criteria}); <<objectSignal>>
if () then ([v1 == "meets criteria"])
:include in list of candidates;
:form and publicize list of candidates;
:publicize candidate list;
split
:promote ideas to the public;
split again
:organize public meeting of Academic Senate;
end split
:commence public meeting and ensure voting capability;
repeat :;
:conduct election and count votes;
:check if voting was successful;
:v2: check if voting was successful ({fails, successful}); <<objectSignal>>
backward:repeat election process;
repeat while () is ([v2 == "fails"]) not ([v2 == "successful"])
:announce election result;
:conclude public meeting and inform candidate of results;
stop
else ([v1 == "does not meet criteria"])
:inform of refusal and end process;
stop
endif
@enduml