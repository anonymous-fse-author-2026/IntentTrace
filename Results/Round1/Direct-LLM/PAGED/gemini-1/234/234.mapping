      ],
      "justification": "The XOR branch and guard correspond directly to the fax reception condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the order is received via fax, input the order into an Excel file"
      ],
      "justification": "Direct paraphrase of the fax order input."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone"
      ],
      "justification": "Captures the alternative mail/phone reception condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone, also input the order into an Excel file"
      ],
      "justification": "Direct paraphrase of the mail/phone input step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
