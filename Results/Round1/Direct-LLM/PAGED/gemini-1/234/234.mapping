      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n8b"
      ],
      "verbatim_texts": [
        "ensure that it is completed"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n9",
        "action:n9b"
      ],
      "verbatim_texts": [
        "control the incoming order. At the same time, continue to do the check"
      ],
      "justification": "Accurately represents both actions and the 'at the same time' parallel branch."
    },
    {
      "refs": [
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "If the order is correct"
      ],
      "justification": "The XOR branch and positive guard capture the correctness condition."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If the order is correct, release it",
        "release it"
      ],
      "justification": "Direct paraphrase of the action to release the correct order."
    },
    {
      "refs": [
        "action:n12b",
        "action:n12c"
      ],
      "verbatim_texts": [
        "Send the Excel list to the student and upon receiving it, continue with the process."
      ],
      "justification": "The elements capture the sending and continuation steps directly."
    },
    {
      "refs": [
        "guard:b2->n13"
      ],
      "verbatim_texts": [
        "if the order is incorrect"
      ],
      "justification": "Captures the negative incorrect condition."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "if the order is incorrect, contact the selling agency"
      ],
      "justification": "Direct paraphrase of the negative action arm."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac"
      ],
      "justification": "The branch maps to the conditional evaluation of the order worth."
    },
    {
      "refs": [
        "guard:b3->b10"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac"
      ],
      "justification": "Matches the condition for the greater-than threshold."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off"
      ],
      "justification": "Direct paraphrase of the sign-off action."
    },
    {
      "refs": [
        "action:n13b",
        "action:n13c",
        "action:n16c",
        "action:n16d"
      ],
      "verbatim_texts": [
        "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
      ],
      "justification": "The elements precisely break down the sequence of contacting and sending for sign-off."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "they will initiate production"
      ],
      "justification": "Paraphrase of initiating production."
    },
    {
      "refs": [
        "guard:b4->n21"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved"
      ],
      "justification": "The XOR branch and guard map to the unsolvable condition."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order"
      ],
      "justification": "Paraphrase of the cancellation step."
    },
    {
      "refs": [
        "guard:b4->n22"
      ],
      "verbatim_texts": [
        "If the issue can be solved"
      ],
      "justification": "Captures the solvable condition."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "If the issue can be solved, release the order"
      ],
      "justification": "Paraphrase of releasing the solvable order."
    },
    {
      "refs": [
        "guard:b5->n24"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled"
      ],
      "justification": "The XOR branch and guard map to the cancellation condition."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends"
      ],
      "justification": "Captures the end event and ending action."
    },
    {
      "refs": [
        "guard:b5->n25"
      ],
      "verbatim_texts": [
