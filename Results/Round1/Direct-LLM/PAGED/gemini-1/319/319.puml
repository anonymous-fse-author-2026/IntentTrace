@startuml
!theme plain
|a_buyer| Buyer
|a_buyer|
start
:choose a book;
:v2: book options ({view details, view new copies, view used copies}); <<objectSignal>>
switch ()
case ([v2 = 'view details'])
:view: book details;
:v1: do you want to select a copy or view new copies? ({view new copies, select a copy}); <<objectSignal>>
if () then ([v1 = 'select a copy'])
:select a copy;
else ([v1 = 'view new copies'])
:view: new copies;
endif
stop
case ([v2 = 'view used copies'])
:view: used copies;
:evaluate and select a copy from the list;
stop
case ([v2 = 'view new copies'])
endswitch
@enduml