@startuml
!theme plain
|a_default| Default
|a_default|
start
:start ExpenseReport process by clicking Start then selecting Edit Report;
:Is expense greater than 1000;
:v1: Is expense greater than 1000 ({Yes, No}); <<objectSignal>>
if () then ([v1 == 'Yes'])
:review the report;
:evaluate review decision;
:v3: evaluate review decision ({Approved, Rejected}); <<objectSignal>>
if () then ([v3 == 'Rejected'])
:edit the report;
else ([v3 == 'Approved'])
:check if translation is needed;
:evaluate the review decision;
:v7: Is report rejected after second review ({Yes, No}); <<objectSignal>>
if () then ([v7 == 'Yes'])
:edit the report;
else ([v7 == 'No'])
:translate the receipts;
:confirm receipts;
:evaluate receipts decision;
:v9: evaluate receipts decision ({Accepted, Rejected}); <<objectSignal>>
if () then ([v9 == 'Accepted'])
:process the expense;
:end process;
else ([v9 == 'Rejected'])
:edit the report;
endif
endif
endif
stop
else ([v1 == 'No'])
:Is translation needed;
:v2: Is translation needed ({Yes, No}); <<objectSignal>>
if () then ([v2 == 'Yes'])
:translate the receipts;
else ([v2 == 'No'])
:confirm the receipts;
endif
endif
@enduml