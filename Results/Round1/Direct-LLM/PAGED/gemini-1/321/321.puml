@startuml
!theme plain
|a_buyer| Buyer
|a_buyer|
start
:choose a book;
:choose what to do after selecting book;
:v1: choose what to do after selecting book ({details, new, used}); <<objectSignal>>
switch ()
case ([v1 == "details"])
:view book details;
:choose what to do after viewing book details;
:v2: choose what to do after viewing book details ({new, select}); <<objectSignal>>
if () then ([v2 == "new"])
:view list of new copies from book details;
else ([v2 == "select"])
:select a copy and complete process;
-> After selecting preferred copy;
endif
case ([v1 == "new"])
:view list of new copies;
case ([v1 == "used"])
:view list of used copies;
:evaluate list of used copies;
:select preferred copy and complete process;
-> After selecting preferred copy;
endswitch
stop
@enduml