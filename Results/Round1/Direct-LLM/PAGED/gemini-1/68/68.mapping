      ],
      "justification": "Implicitly sets the process start and matches the initial action."
    },
    {
      "refs": [
        "guard:b1->n17"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\""
      ],
      "justification": "Captures the XOR branch point and perfectly matches the guard condition."
    },
    {
      "refs": [
        "guard:b1->n24"
      ],
      "verbatim_texts": [
