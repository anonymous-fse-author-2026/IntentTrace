@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start process;
:Items returned by customer or picked up by delivery crew;
:v1: Items returned by customer or picked up by delivery crew ({Delivery crew picks up items at event site, Customer returns the items to the store}); <<objectSignal>>
if () then ([v1 = 'Customer returns the items to the store'])
:Continue process;
else ([v1 = 'Delivery crew picks up items at event site'])
:Continue process;
endif
:Count and compare items to contract;
:Order status after count;
:v2: Order status after count ({All items returned, Items missing, Items damaged}); <<objectSignal>>
switch ()
case ([v2 = 'All items returned'])
:Items disposition for returned items;
:v3: Items disposition for returned items ({Stored for future orders, Items are packed for an existing order}); <<objectSignal>>
if () then ([v3 = 'Stored for future orders'])
:Continue process;
else ([v3 = 'Items are packed for an existing order'])
:Continue process;
endif
:End process;
stop
case ([v2 = 'Items missing'])
:Email customer missing items and replacement charges;
:Customer returns missing items;
:v4: Customer returns missing items ({Customer does not return missing items, Customer returns the missing items}); <<objectSignal>>
if () then ([v4 = 'Customer does not return missing items'])
:Continue process;
else ([v4 = 'Customer returns the missing items'])
:Continue process;
endif
:End process;
stop
case ([v2 = 'Items damaged'])
:Email customer damage and additional charges;
:v7: Items disposition after email ({Items are packed for an existing order, Items are stored for future orders}); <<objectSignal>>
if () then ([v7 = 'Items are packed for an existing order'])
:Continue process;
else ([v7 = 'Items are stored for future orders'])
:Continue process;
endif
:Temporarily remove damaged items from inventory;
:Can damaged items be repaired;
:v5: Can damaged items be repaired ({Can be repaired, Cannot be repaired}); <<objectSignal>>
if () then ([v5 = 'Can be repaired'])
:Repair items and add to inventory;
else ([v5 = 'Cannot be repaired'])
:Discard items and email customer replacement charges;
endif
:Items disposition after repair;
:v6: Items disposition after repair ({Stored for future orders, Items are packed for an existing order}); <<objectSignal>>
if () then ([v6 = 'Stored for future orders'])
:Continue process;
else ([v6 = 'Items are packed for an existing order'])
:Continue process;
endif
:End process;
:Email customer with replacement charges;
stop
endswitch
@enduml