    {
      "id": "i1",
      "content": "To begin the process"
    },
    {
      "id": "i2",
      "content": "start by claiming what is requested"
    },
    {
      "id": "i3",
      "content": "check the insured status of the claimant"
    },
    {
      "id": "i4",
      "content": "If the claimant is insured"
    },
    {
      "id": "i5",
      "content": "proceed to evaluate the claim"
    },
    {
      "id": "i6",
      "content": "if the claimant is not insured"
    },
    {
      "id": "i7",
      "content": "reject the claim"
    },
    {
      "id": "i8",
      "content": "notify the claimant"
    },
    {
      "id": "i9",
      "content": "and the process comes to an end."
    },
    {
      "id": "i10",
      "content": "If the claim is a simple one or a complex one"
    },
    {
      "id": "i11",
      "content": "send the relevant forms accordingly."
    },
    {
      "id": "i12",
      "content": "Once the forms are returned, check them for completeness."
    },
    {
      "id": "i13",
      "content": "If all the relevant details are provided"
    },
    {
      "id": "i14",
      "content": "proceed to register the claim."
    },
    {
      "id": "i15",
      "content": "if not all the relevant details are provided"
    },
    {
      "id": "i16",
      "content": "inform the claimant to complete them."
    },
    {
      "id": "i17",
      "content": "Once the claim is registered, the process comes to an end."
    }
