defines(v5, "check if invoice needs to be sent to experienced staff", {"experienced staff", "normal case", "none of the above"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, n6, b1, e1, n9, n10, n11, b2, n14, c1, n15, b3, n19, b5, n22, n23, c2, n25, e3, n26, n27, n28, e4])
