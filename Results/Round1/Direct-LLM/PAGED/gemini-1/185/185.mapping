      ],
      "verbatim_texts": [
        "i1: For SSP, the process begins by receiving the invoice."
      ],
      "justification": "The text explicitly starts the process and describes the first action of receiving the invoice."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "i2: it is sorted per client."
      ],
      "justification": "Direct paraphrase of the sorting action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "i3: it is then sorted per vendor."
      ],
      "justification": "Direct paraphrase of the subsequent sorting action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "i4: attach the invoice entry form to the invoice."
      ],
      "justification": "Exact match for attaching the form."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "i5: the required information is entered onto the form."
      ],
      "justification": "Direct paraphrase of entering information onto the form."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "i6: the completeness of the invoice is checked."
      ],
      "justification": "Direct paraphrase of checking invoice completeness."
    },
    {
      "refs": [
        "guard:b1->e1"
      ],
      "verbatim_texts": [
        "i7: If the invoice is not complete"
      ],
      "justification": "Captures the XOR branch and the condition for an incomplete invoice."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "i8: the process ends."
      ],
      "justification": "Maps directly to the end node."
    },
    {
      "refs": [
        "guard:b1->n9"
      ],
      "verbatim_texts": [
        "i9: If it is complete"
      ],
      "justification": "Captures the condition for a complete invoice."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "i10: the information for the SLA is entered."
      ],
      "justification": "Direct paraphrase of entering SLA information."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "i11: The date for completion is also entered"
      ],
      "justification": "Direct paraphrase of entering the completion date."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "i12: and the priority is checked."
      ],
      "justification": "Direct paraphrase of checking the priority."
    },
    {
      "refs": [
        "guard:b2->n14"
      ],
      "verbatim_texts": [
        "i13: If the priority is high"
      ],
      "justification": "Captures the XOR branch and the condition for high priority."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "i14: a red stamp is placed on the entry invoice."
      ],
      "justification": "Direct paraphrase of the action to place a red stamp."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "i15: If it is low"
      ],
      "justification": "Captures the condition for low priority."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "i16: The invoice compliance is then checked."
      ],
      "justification": "Direct paraphrase of checking invoice compliance, which also implicitly converges the preceding priority evaluation paths."
    },
    {
      "refs": [
        "guard:b3->c1"
      ],
      "verbatim_texts": [
        "i17: If it is not complete, the check continues."
      ],
      "justification": "Captures the XOR branch and the negative condition for compliance."
    },
    {
      "refs": [
        "action:n19",
        "guard:b5->n22"
      ],
      "verbatim_texts": [
        "i18: If the invoice needs to be sent to experienced staff"
      ],
      "justification": "Captures the branch, the guard for this specific path, and the condition correctly modeled as an action step (checking the requirement)."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "i19: the non-compliance invoice is processed."
      ],
      "justification": "Direct paraphrase of processing the non-compliance invoice."
    },
    {
      "refs": [
        "guard:b5->n23"
      ],
      "verbatim_texts": [
        "i20: If it is a normal case"
      ],
      "justification": "Captures the normal case condition."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "i21: the client is called."
      ],
      "justification": "Direct paraphrase of calling the client."
    },
    {
      "refs": [
