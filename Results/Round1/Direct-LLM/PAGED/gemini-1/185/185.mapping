      ],
      "verbatim_texts": [
        "i22: If none of these conditions apply"
      ],
      "justification": "Captures the fallback condition."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "i23: a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Captures the combined action of sending mail and ending the process, as well as the explicit end node."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "i24: and the process ends."
      ],
      "justification": "Captures the final end process action and its corresponding structural end node."
    },
    {
      "refs": [
