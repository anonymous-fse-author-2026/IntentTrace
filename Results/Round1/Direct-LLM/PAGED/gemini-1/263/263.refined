init(i1)
action(n1, "Informational meeting (half a day)")
action(n2, "Is the informational meeting successful?")
branch(b1, XOR)
action(n3, "Work on storyboard (full day)")
branch(b_sb, XOR)
action(n_sb_end, "End Process")
end(e_sb)
action(n4, "End Process")
end(e1)
action(n5, "Site design (10 days)")
action(n6, "Content preparation")
action(n7, "Merge: Site design and content preparation completed")
action(n8, "Site development (2 days)")
action(n9, "Review process (1 day)")
action(n10, "Is the review successful?")
branch(b2, XOR)
action(n_rev_end, "End Process")
end(e_rev)
action(n11, "Approval stage (half a day)")
branch(b_app, XOR)
action(n12, "End Process")
end(e2)
action(n13, "Rebuild site (3 days)")
action(n14, "Is the rebuild approved?")
branch(b3, XOR)
action(n15, "End Process")
end(e3)
action(n16, "Rebuild site again (3 days)")
action(n17, "End Process")
end(e4)
converge(c1)
branch(b4, AND)

defines(v1, "Is the informational meeting successful?", {"Yes", "No"})
defines(v_sb, "Is the storyboard successful?", {"Yes", "No"})
defines(v2, "Is the review successful?", {"Yes", "No"})
defines(v_app, "Is the approval complete?", {"Yes", "No"})
defines(v3, "Is the rebuild approved?", {"Yes", "No"})

actor(a_cust_web, "Customer and Web design team", [n1, n2, b1, n3, b_sb])
actor(a_web, "Web design team", [n5, n8])
actor(a_default, "Default", [i1, n_sb_end, e_sb, n4, e1, n6, n7, n9, n10, b2, n_rev_end, e_rev, n11, b_app, n12, e2, n13, n14, b3, n15, e3, n16, n17, e4, c1, b4])

precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
guard(b1, n3, v1 = "Yes")
precedence(b1, n4)
guard(b1, n4, v1 = "No")
precedence(n4, e1)

precedence(n3, b_sb)
precedence(b_sb, b4)
guard(b_sb, b4, v_sb = "Yes")
precedence(b_sb, n_sb_end)
guard(b_sb, n_sb_end, v_sb = "No")
precedence(n_sb_end, e_sb)

precedence(b4, n5)
precedence(b4, n6)
precedence(n5, c1)
precedence(n6, c1)
precedence(c1, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, n10)
precedence(n10, b2)

precedence(b2, n11)
guard(b2, n11, v2 = "Yes")
precedence(b2, n_rev_end)
guard(b2, n_rev_end, v2 = "No")
precedence(n_rev_end, e_rev)

precedence(n11, b_app)
precedence(b_app, n12)
guard(b_app, n12, v_app = "Yes")
precedence(b_app, n13)
guard(b_app, n13, v_app = "No")
precedence(n12, e2)

precedence(n13, n14)
precedence(n14, b3)
precedence(b3, n15)
guard(b3, n15, v3 = "Yes")
precedence(b3, n16)
guard(b3, n16, v3 = "No")
precedence(n15, e3)
precedence(n16, n17)
precedence(n17, e4)