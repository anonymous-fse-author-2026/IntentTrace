    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "The conditional implies the XOR branch and supports the action step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "if the \"Customer does not return the missing items,\""
      ],
      "justification": "Direct paraphrase of the negative condition modeled as an action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
