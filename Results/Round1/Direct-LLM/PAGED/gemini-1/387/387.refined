init(i1)
action(n2, "trigger the resupply cycle")
action(n3, "check the inventory level")
branch(b1, XOR)
action(n5, "create a purchase order")
end(e1)
converge(c1)
action(n7, "review the purchase order")
branch(b2, XOR)
action(n9, "rework the purchase order")
action(n13, "reserve the funds")
action(n14, "send order to supplier")
branch(b4, AND)
action(n15, "receive the packing slip")
action(n16, "receive the invoice")
action(n17, "record the packing slip")
action(n18, "record the invoice")
end(e2)
end(e3)
defines(v1, "inventory level", {"at or below minimum", "above minimum"})
defines(v2, "purchase status", {"rejected", "approved"})
actor(a_default, "Default", [i1, n2, n3, b1, n5, e1, c1, n7, b2, n9, n13, n14, b4, n15, n16, n17, n18, e2, e3])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(b1, e1)
precedence(n5, c1)
precedence(n9, c1)
precedence(c1, n7)
precedence(n7, b2)
precedence(b2, n9)
precedence(b2, n13)
precedence(n13, n14)
precedence(n14, b4)
precedence(b4, n15)
precedence(b4, n16)
precedence(n15, n17)
precedence(n16, n18)
precedence(n17, e2)
precedence(n18, e3)
guard(b1, n5, v1 == "at or below minimum")
guard(b1, e1, v1 == "above minimum")
guard(b2, n9, v2 == "rejected")
guard(b2, n13, v2 == "approved")