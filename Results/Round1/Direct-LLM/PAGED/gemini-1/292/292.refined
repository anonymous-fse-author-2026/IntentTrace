defines(v1, "decide on claim", {"No", "Yes"})
defines(v2, "claim rejection accepted", {"Yes", "No"})
actor(a_default, "Default", [i1, n2, n3, n4, b1, n5, n6, b2, n16, n17, c2, b3, n7, n8, c3, n10, n11, n12, b4, n13, n14, c4, c1, e1])
