      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "The initial phrase fully supports the structural init and start action, as well as the step to prioritize orders."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to check the customer's information."
      ],
      "justification": "Direct paraphrase of the checking step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the customer exists"
      ],
      "justification": "This condition dictates the decision point, the branch, and the affirmative guard."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "checking their payment history."
      ],
      "justification": "Directly implements the payment history check."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if the customer does not exist"
      ],
      "justification": "The text directly provides the negative path condition mapping exactly to this guard."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "verify their customer status."
      ],
      "justification": "Direct match for the verification action."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the payment history is good"
      ],
      "justification": "The condition maps to the decision action, the branch, and the positive guard."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "The structural converge element implements the instruction to continue the flow."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "if the customer is a private customer"
      ],
      "justification": "This condition establishes the decision node, the split, and the affirmative guard for private customers."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "send them a declining message."
      ],
      "justification": "Directly paraphrases sending the decline message."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer"
      ],
      "justification": "The action directly implements the creation of a new customer."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "check for product availability."
      ],
      "justification": "Direct paraphrase of checking product availability."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If the products are not available"
      ],
      "justification": "This explicit negative condition establishes the decision action, branch, and corresponding negative guard."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "produce the missing goods"
      ],
      "justification": "Direct paraphrase for the production step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "send a decline message"
      ],
      "justification": "Direct match for the messaging step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
