@startuml
!theme plain
|a_default| Default
|a_default|
start
:check if the input is a URN;
:v1: check if the input is a URN ({URN, URL}); <<objectSignal>>
if () then ([v1 == "URN"])
:perform ONS-Resolving URN to a domain name;
else ([v1 == "URL"])
:continue with the process;
endif
:check if the input is a URN or a URL;
:v2: check if the input is a URN or a URL ({URN, URL}); <<objectSignal>>
if () then ([v2 == "URN"])
:send a DNS query;
:receive a list of URLs from the DNS query;
:use the list of URLs to link to a designated DS;
else ([v2 == "URL"])
:continue with the process;
endif
:link to the designated DS;
stop
@enduml