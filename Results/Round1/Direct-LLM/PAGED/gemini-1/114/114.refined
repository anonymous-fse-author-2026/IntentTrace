init(i1)
action(n1, "start selling cars")
action(n2, "did you get a bonus")
branch(b1, XOR)
action(n5, "did you get a paycheck")
action(n8, "pay the bill")
end(e2)
converge(c1)
defines(v1, "did you get a bonus", {"Yes", "No"})
defines(v2, "did you get a paycheck", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n5, n8, e2, c1])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n2)
precedence(b1, n5)
precedence(n2, c1)
precedence(n5, c1)
precedence(c1, n8)
precedence(n8, e2)
guard(b1, n2, v1 = 'Yes')
guard(b1, n5, v1 = 'No')