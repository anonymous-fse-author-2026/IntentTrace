  "mutations": [
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\""
      ],
      "reason": "The model alters the condition from 'no more candidates' to 'are there more candidates?', changing the phrasing and reversing the literal check."
    },
    {
      "refs": [
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "If the manager is an external resource"
      ],
      "reason": "The model reverses the logic, incorrectly routing the 'Yes' path of being an external resource to 'continue process', whereas the text implies external resources may not authorize the form."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the form is approved"
      ],
      "reason": "The model alters the general condition 'If the form is approved' to specifically check if it was authorized by an external approver."
    }
  ],
  "omissions": [
    {
      "verbatim_texts": [
        "check if the candidate has accepted a voluntary redundancy",
        "the process continues",
        "if the candidate has accepted, further investigation is required"
      ],
      "reason": "The model completely skips the checks, continuation, and investigation steps regarding voluntary redundancy."
    },
    {
      "verbatim_texts": [
        "they may not authorize the form"
      ],
      "reason": "The model omits the explicit action or possible outcome of an external resource not authorizing the form."
    }
  ],
