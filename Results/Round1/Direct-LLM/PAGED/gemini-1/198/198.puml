@startuml
!theme plain
|a_default| Part Provision Team
|a_default|
start
:identify the parts;
:v1: does team need to elicit information from the customer ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:check availability of parts;
else ([v1 = 'No'])
->;
endif
:v2: parts supply condition ({parts supplied to the customer, need to record the customer details}); <<objectSignal>>
if () then ([v2 = 'need to record the customer details'])
:order and receive part from Disuki;
:contract the customer;
else ([v2 = 'parts supplied to the customer'])
->;
endif
:proceed with payment;
stop
@enduml