init(i1)
action(n2, "Check loan application")
branch(b1, XOR)
action(n3, "End process due to rejection")
end(e1)
action(n5, "Disburse funds")
action(n6, "End process after disbursal")
end(e2)
defines(v1, "Is loan application rejected", {"Yes", "No"})
defines(v2, "Are special terms agreed upon", {"No", "Yes"})
actor(a_default, "Default", [i1, n2, b1, n3, e1, n5, n6, e2])
precedence(i1, n2)
precedence(n2, b1)
precedence(n3, e1)
precedence(n6, e2)
precedence(b1, n3)
precedence(b1, n5)
precedence(n5, n6)
guard(b1, n3, v1 = 'Yes')
guard(b1, n5, v1 = 'No')