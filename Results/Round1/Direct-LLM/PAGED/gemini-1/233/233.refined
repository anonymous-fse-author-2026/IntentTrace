init(i1)
action(n2, "Check Answer")
branch(b1, XOR)
action(n3, "Acquire Pricing A")
action(n4, "Recheck Answer")
branch(b2, XOR)
action(n5, "Acquire Pricing B")
action(n6, "Margin Calculation")
action(n7, "Prepare Offer")
action(n8, "Calculate Transport Rate")
end(e1)
converge(c1)
defines(v1, "Check Answer", {"Yes", "No"})
defines(v2, "Recheck Answer", {"Yes", "No"})
actor(a_default, "ICT Logistics", [i1, n2, b1, n3, n4, b2, n5, n6, n7, n8, e1, c1])
precedence(i1, n2)
precedence(n2, b1)
precedence(n4, b2)
precedence(c1, n6)
precedence(b1, n3)
precedence(n3, n4)
precedence(b2, n5)
precedence(b1, c1)
precedence(b2, c1)
precedence(n5, c1)
precedence(n6, n7)
precedence(n7, n8)
precedence(n8, e1)
guard(b1, n3, v1 = 'No')
guard(b2, n5, v2 = 'No')
guard(b1, c1, v1 = 'Yes')
guard(b2, c1, v2 = 'Yes')