@startuml
!theme plain
|a_default| Default
|a_faculty| Faculty
|a_mpc| MPC
|a_default|
start
:send: Course Packet Information Received;
:send: Design to Faculty;
repeat :;
|a_faculty|
:choose: Faculty chooses the design;
|a_default|
:identify: Content requiring copyright clearance;
:contact: Contact publisher for clearance;
:v1: is copyright cleared? ({Yes, No}); <<objectSignal>>
backward:notify: Contact Faculty to inform of denial and ask if new content should be added;
repeat while () is ([v1=="No"]) not ([v1=="Yes"])
|a_mpc|
:calculate: Calculate the Course Packet Cost;
:add: Add Bookstore margin to determine retail price;
|a_default|
:v2: is price finalized? ({Yes, No}); <<objectSignal>>
if () then ([v2=="No"])
:reconsider: Re-evaluate content after reconsideration;
else ([v2=="Yes"])
|a_mpc|
:notify: Notify the Bookstore of the Course packet, Course number, Faculty name, and sections;
|a_default|
:notify: Packet information should be notified to the Bookstore;
stop
endif
@enduml