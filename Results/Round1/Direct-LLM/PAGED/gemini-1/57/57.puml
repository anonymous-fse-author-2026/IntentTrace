@startuml
!theme plain
|a_customer| customer
|a_customer|
start
:make a purchase;
:connect to the website;
repeat :;
:search for item;
:v1: add item to cart / continue shopping ({Add item to cart, Continue Shopping}); <<objectSignal>>
backward:continue shopping;
repeat while () is ([v1 = 'Continue Shopping']) not ([v1 = 'Add item to cart'])
:proceed to checkout;
split
:enter address shipping method and payment information;
split again
:authorize credit card and check inventory levels;
end split
:v3: credit card approved and inventory in stock? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'No'])
:transaction ended;
else ([v3 = 'Yes'])
->;
endif
:display order confirmation number;
:show final order to customer;
:confirm the order;
:send confirmation notice via email;
:order entry complete;
stop
@enduml