init(i1)
action(n2, "identify parts")
action(n3, "does the team need to elicit information from the customer?")
branch(b1, XOR)
action(n4, "check availability of the parts")
action(n5, "do they need to record the customer's details?")
branch(b2, XOR)
action(n6, "order part from Disuki")
action(n7, "receive part from Disuki")
action(n9, "contract the customer")
action(n10, "collect all necessary parts")
action(n11, "proceed with payment")
end(e1)
converge(c1)
converge(c2)
defines(v1, "does the team need to elicit information from the customer?", {"Need to elicit information", "Already have the availability information"})
defines(v2, "do they need to record the customer's details?", {"Parts are supplied to the customer", "Need to record customer details"})
actor(a_default, "Part Provision Team", [i1, n2, n3, b1, n4, n5, b2, n6, n7, n9, n10, n11, e1, c1, c2])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, c2)
precedence(n4, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, c1)
precedence(n6, n7)
precedence(n7, c1)
precedence(c1, n9)
precedence(n9, c2)
precedence(c2, n10)
precedence(n10, n11)
precedence(n11, e1)
guard(b1, n4, v1 = 'Need to elicit information')
guard(b1, c2, v1 = 'Already have the availability information')
guard(b2, n6, v2 = 'Need to record customer details')
guard(b2, c1, v2 = 'Parts are supplied to the customer')
label(n2, n3, "Check if information needs to be elicited")
label(n4, n5, "Check if parts are available or need ordering")
label(n9, c2, "Proceed with process or after contacting customer")
label(n10, n11, "Proceed to payment step")