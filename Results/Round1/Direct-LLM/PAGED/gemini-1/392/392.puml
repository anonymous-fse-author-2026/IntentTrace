@startuml
!theme plain
|a_default| MyPool
|a_default|
start
:Start User Task;
:v1: Is User Task Service Task 1? ({Yes, No}); <<objectSignal>>
if () then ([v1 == "No"])
:v2: Is User Task Service Task 2? ({Yes, No}); <<objectSignal>>
if () then ([v2 == "No"])
stop
else ([v2 == "Yes"])
->;
endif
else ([v1 == "Yes"])
->;
endif
:v3: Is there a Manual Task? ({Yes, No}); <<objectSignal>>
if () then ([v3 == "Yes"])
stop
else ([v3 == "No"])
stop
endif
@enduml