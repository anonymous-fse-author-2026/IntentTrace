@startuml
!theme plain
|a_default| Default
|a_default|
start
:sell cars;
:v1: get a bonus ({No, Yes})
v2: get a paycheck ({No, Yes}); <<objectSignal>>
fork
if () then ([v1 = 'Yes'])
:get a bonus;
endif
fork again
if () then ([v2 = 'Yes'])
:get a paycheck;
endif
fork again
if () then ([v1 = 'No' and v2 = 'No'])
endif
end fork
:pay the bill;
stop
@enduml