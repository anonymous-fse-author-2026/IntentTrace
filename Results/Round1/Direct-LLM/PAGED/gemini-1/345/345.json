  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process for ACME, begin with the New Resupply Cycle"
    },
    {
      "id": "i2",
      "content": "proceed to Check Levels of Inventory"
    },
    {
      "id": "i3",
      "content": "If the inventory is \"greater than\" the minimum"
    },
    {
      "id": "i4",
      "content": "generate an \"Above Minimum Report\""
    },
    {
      "id": "i5",
      "content": "If it is \"below or equal to\" the minimum"
    },
    {
      "id": "i6",
      "content": "generate an \"Equal to or below minimum Report\""
    },
    {
      "id": "i7",
      "content": "the process ends with the End Resupply Cycle"
    },
    {
      "id": "i8",
      "content": "then POs are Created"
    },
    {
      "id": "i9",
      "content": "they are subject to POs Review"
    },
    {
      "id": "i10",
      "content": "If the POs are \"rejected\""
    },
    {
      "id": "i11",
      "content": "they need to be \"reworked\""
    },
    {
      "id": "i12",
      "content": "If they are \"approved\""
    },
    {
      "id": "i13",
      "content": "they are \"Printed and released in the system\""
    },
    {
      "id": "i14",
      "content": "and the process ends"
    },
    {
      "id": "i15",
      "content": "then POs are Created again"
    }
  ]
