init(i1)
action(n1, "Start ACME Resupply Cycle")
action(n2, "Check Inventory Levels")
branch(b1, XOR)
action(n3, "Generate Above Minimum Report")
action(n4, "End Resupply Cycle")
end(e1)
action(n5, "Generate Equal to or below minimum Report")
action(n6, "Create POs")
action(n7, "Review POs")
branch(b2, XOR)
action(n8, "Print and release in system")
end(e2)
action(n10, "Rework POs")
defines(v1, "Check Inventory Levels", {"Inventory greater than minimum", "Inventory below or equal to minimum"})
defines(v2, "Review POs", {"Approved", "Rejected"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, e1, n5, n6, n7, b2, n8, e2, n10])
precedence(i1, n1)
precedence(n2, b1)
precedence(n4, e1)
precedence(n7, b2)
precedence(n8, e2)
precedence(n1, n2)
precedence(b1, n3)
precedence(n3, n4)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, n7)
precedence(b2, n8)
precedence(b2, n10)
precedence(n10, n6)
guard(b1, n3, v1 = 'Inventory greater than minimum')
guard(b1, n5, v1 = 'Inventory below or equal to minimum')
guard(b2, n8, v2 = 'Approved')
guard(b2, n10, v2 = 'Rejected')