init(i1)
action(n2, "send: Course Packet Information Received")
action(n3, "send: Design to Faculty")
action(n14, "Faculty chooses the design")
action(n4, "identify content requiring copyright clearance and contact publisher")
action(n6, "notify: Contact Faculty to inform of denial and ask if new content should be added")
action(n7, "calculate: Course Packet Cost")
action(n8, "add: Bookstore margin to determine retail price")
action(n10, "notify: Notify Bookstore of Course packet  Course number  Faculty name  and sections")
action(n12, "reconsider content to decrease price")
action(n11, "end: Packet information notified to Bookstore")
branch(b1, XOR)
branch(b2, XOR)
end(e1)
defines(v1, "condition: if need to Contact Faculty to inform of denial and ask if new content should be added", {true, false})
defines(v2, "condition: if Price of the Course Packet is finalized", {true, false})
actor(faculty, "Faculty", [n14, n12])
actor(mpc, "MPC", [n7, n8, n10])
actor(a_default, "Default", [i1, n2, n3, n4, b1, n6, b2, n11, e1])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, n14)
precedence(n14, n4)
precedence(n4, b1)
precedence(b1, n6)
precedence(b1, n7)
precedence(n6, n4)
precedence(n7, n8)
precedence(n8, b2)
precedence(b2, n10)
precedence(b2, n12)
precedence(n10, n11)
precedence(n12, n7)
precedence(n11, e1)
guard(b1, n6, v1 = true)
guard(b1, n7, v1 = false)
guard(b2, n10, v2 = true)
guard(b2, n12, v2 = false)