        "action:n12"
      ],
      "verbatim_texts": [
        "If the invoices are still marked as \"Uncompleted\", they should be returned to the client via postal mail."
      ],
      "justification": "The action step precisely restates the return instruction for the uncompleted invoices without dropping qualifiers."
    },
    {
      "refs": [
        "action:n7",
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the invoices are returned to the client, receive the completed ones."
      ],
      "justification": "The converge nodes and duplicate receive actions correctly reflect the path rejoining and the post-return collection step. Redundancy does not alter behavior."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "mark the relevant box on the invoice entry form"
