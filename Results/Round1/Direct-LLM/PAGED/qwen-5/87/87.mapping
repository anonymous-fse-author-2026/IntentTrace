      ],
      "verbatim_texts": [
        "If they are marked as \"Uncompleted\", they should be returned to the client through postal mail."
      ],
      "justification": "The structural branch, the guard preserving the exact 'Uncompleted' marker, and the return action collectively and faithfully model this conditional path."
    },
    {
