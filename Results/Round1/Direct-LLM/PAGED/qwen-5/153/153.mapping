      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "Initiates the process and executes the first two sequential steps."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty, if not,"
      ],
      "justification": "Branch and negative guard capture the initial conditional check."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Direct execution of the continuation instruction."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Positive guard routes to the termination action."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again, if not,"
      ],
      "justification": "Second verification check modeled as action leading to branch and negative path."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Decision point for data completeness."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Positive path action faithfully restates the recording instruction."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "make a telephone call to the sender."
      ],
      "justification": "Negative path action matches the contact instruction."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "take the letter book and member register to Miranda."
      ],
      "justification": "Direct transport action match."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Exact match for stamping and dating the letter."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "write to them and inform them of the decision."
