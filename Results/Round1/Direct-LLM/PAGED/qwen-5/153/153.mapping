      ],
      "justification": "AND gateway correctly splits the simultaneous tasks."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Direct instruction match."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Termination node and action correspond to the closing statement."
    },
    {
