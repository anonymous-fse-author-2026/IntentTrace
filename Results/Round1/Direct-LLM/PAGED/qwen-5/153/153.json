  "input_elements": [
    {
      "id": "i1",
      "content": "To become a member, start the process at 8:00 am and then empty the mailbox."
    },
    {
      "id": "i2",
      "content": "Check if the mailbox is empty, if not,"
    },
    {
      "id": "i3",
      "content": "continue the process."
    },
    {
      "id": "i4",
      "content": "If it is empty, the process ends."
    },
    {
      "id": "i5",
      "content": "Check if the mailbox is empty again, if not,"
    },
    {
      "id": "i6",
      "content": "Verify if the information is complete."
    },
    {
      "id": "i7",
      "content": "add the incoming mail number, date, and record it in the letter book."
    },
    {
      "id": "i8",
      "content": "make a telephone call to the sender."
    },
    {
      "id": "i9",
      "content": "complete the data by adding the incoming mail number, date, and record it in the letter book."
    },
    {
      "id": "i10",
      "content": "Every Wednesday evening,"
    },
    {
      "id": "i11",
      "content": "take the letter book and member register to Miranda."
    },
    {
      "id": "i12",
      "content": "If the applicant becomes a member,"
    },
    {
      "id": "i13",
      "content": "stamp \"new Member\" on the letter and write the date on it."
    },
    {
      "id": "i14",
      "content": "write to them and inform them of the decision."
    },
    {
      "id": "i15",
      "content": "write the data."
    },
    {
      "id": "i16",
      "content": "Simultaneously, calculate the fee and hand the letter to Charles."
    },
    {
      "id": "i17",
      "content": "Ask Charles to write the amount in the register."
    },
    {
      "id": "i18",
      "content": "Print the membership card with all the data and send it to the new member."
    },
    {
      "id": "i19",
      "content": "The process ends."
    },
    {
      "id": "i20",
      "content": "Hand the letter to Charles and add the new member to the register."
    },
    {
      "id": "i21",
      "content": "Prepare an invoice for the new members"
    },
    {
      "id": "i22",
      "content": "Ask Charles to write the amount in the register and write the fee amount to the register."
    },
    {
      "id": "i23",
      "content": "write the fee amount to the register."
    }
