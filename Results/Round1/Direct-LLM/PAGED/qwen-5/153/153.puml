@startuml
!theme plain
|a_default| Default
|a_Miranda| Miranda
|a_Charles| Charles
|a_default|
start
:start the process at 8:00 am;
:empty the mailbox;
:v1: is the mailbox empty? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'No'])
:continue the process;
:is the mailbox empty?;
:v2: is the mailbox empty? ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'No'])
:continue the process;
:v3: is the information complete? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:add incoming mail number date and record it in letter book;
else ([v3 = 'No'])
:make a telephone call to the sender;
:add incoming mail number date and record it in letter book;
endif
:v4: is it Wednesday evening? ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
|a_Miranda|
:take letter book and member register to Miranda;
|a_default|
else ([v4 = 'No'])
:skip taking letter book and member register;
endif
:v5: has applicant become a member? ({Yes, No}); <<objectSignal>>
if () then ([v5 = 'Yes'])
:stamp new Member on letter and write date on letter;
:write the data;
split
:calculate fee;
split again
|a_Charles|
:hand letter to Charles;
end split
:ask Charles to write amount in register;
|a_default|
:print membership card and send to new member;
|a_Charles|
:hand letter to Charles;
|a_default|
:add new member to register;
:prepare invoice for new members;
|a_Charles|
:ask Charles to write amount in register;
|a_default|
:write fee amount to register;
:end process;
stop
else ([v5 = 'No'])
:write to applicant and inform decision;
stop
endif
else ([v2 = 'Yes'])
:end process;
stop
endif
else ([v1 = 'Yes'])
:end process;
stop
endif
@enduml