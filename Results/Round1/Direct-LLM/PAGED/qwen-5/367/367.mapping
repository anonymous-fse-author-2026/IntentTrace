{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "The init node and three action nodes collectively reproduce the opening instruction to start, initiate the cycle, and check inventory levels."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "The action poses the check, the branch represents the decision point, and the two guards capture the true/false outcomes of the condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report."
      ],
      "justification": "Direct correspondence to the low-inventory report generation step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report."
      ],
      "justification": "Direct correspondence to the high-inventory report generation step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)"
      ],
      "justification": "Exact match for the PO creation step triggered by the low-inventory report."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "The action and structural end node together implement the early termination clause for high inventory."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "The branch, rejection guard, and rework action faithfully model the negative PO outcome path."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "The approval guard and corresponding action accurately reflect the positive PO outcome path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Direct match for the mandatory review step following PO creation."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "The convergence node structurally handles the flow returning to the creation stage after rework."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "The AND gateway captures concurrent execution, splitting into the fund reservation and mailing actions."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "receive the Packing Slip."
      ],
      "justification": "Exact match for the packing slip reception step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive the inventory."
      ],
      "justification": "Exact match for the inventory reception step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "proceed to receive the Invoice."
      ],
      "justification": "Direct match for the invoice reception step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match."
      ],
      "justification": "Direct match for the three-way match verification step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "release the funds."
      ],
      "justification": "Exact match for the fund release step following successful matching."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "issue the payment."
      ],
      "justification": "Exact match for the payment issuance step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "The action and final end node jointly capture the cycle completion statement and process termination."
    }
  ],
