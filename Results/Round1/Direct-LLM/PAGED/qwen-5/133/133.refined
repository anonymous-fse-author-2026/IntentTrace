init(i1)
action(n1, "Start Expense Report process by receiving the expense report")
action(n2, "Verify the account")
action(n3, "Review the report")
action(n4, "Is the report accepted")
branch(b1, XOR)
action(n5, "Process the reimbursement")
action(n6, "Proceed with the payment")
end(e1)
action(n8, "Send Expense Rejection Notification")
end(e2)
defines(v1, "Is the report accepted", {"accepted", "rejected"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, n6, e1, n8, e2])
precedence(i1, n1)
precedence(n4, b1)
precedence(n6, e1)
precedence(n8, e2)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(b1, n5)
precedence(n5, n6)
precedence(b1, n8)
guard(b1, n5, v1 = 'accepted')
guard(b1, n8, v1 = 'rejected')
label(b1, n8, "Rejected")