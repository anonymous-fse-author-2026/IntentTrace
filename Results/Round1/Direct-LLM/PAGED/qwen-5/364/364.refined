init(i1)
action(n1, "start")
action(n2, "receive form")
action(n3, "check if form is complete")
branch(b1, XOR)
action(n4, "end process: form needs to be sent back")
end(e1)
action(n5, "check income")
action(n6, "check deductibles")
action(n7, "check house")
action(n8, "make decision")
branch(b2, XOR)
action(n9, "end process: check declaration")
end(e2)
action(n10, "invite declarant")
end(e3)
converge(c1)
branch(b3, AND)
defines(v1, "check if form is complete", {'sent_back', 'check_income'})
defines(v2, "make decision", {'check_declaration', 'invite_declarant'})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, e1, n5, n6, n7, n8, b2, n9, e2, n10, e3, c1, b3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, b3)
precedence(b3, n5)
precedence(b3, n6)
precedence(b3, n7)
precedence(n4, e1)
precedence(n5, c1)
precedence(n6, c1)
precedence(n7, c1)
precedence(c1, n8)
precedence(n8, b2)
precedence(b2, n9)
precedence(b2, n10)
precedence(n9, e2)
precedence(n10, e3)
guard(b1, n4, v1 = 'sent_back')
guard(b1, b3, v1 = 'check_income')
guard(b2, n9, v2 = 'check_declaration')
guard(b2, n10, v2 = 'invite_declarant')