  "input_elements": [
    {
      "id": "i1",
      "content": "To initiate the IDES process, begin by receiving the customer request."
    },
    {
      "id": "i2",
      "content": "proceed to enter the sales order."
    },
    {
      "id": "i3",
      "content": "check the item availability."
    },
    {
      "id": "i4",
      "content": "confirm the sales order."
    },
    {
      "id": "i5",
      "content": "move on to outbound delivery."
    },
    {
      "id": "i6",
      "content": "proceed to picking."
    },
    {
      "id": "i7",
      "content": "move on to packing."
    },
    {
      "id": "i8",
      "content": "post the goods issue."
    },
    {
      "id": "i9",
      "content": "This will update the inventory."
    },
    {
      "id": "i10",
      "content": "proceed to update the G/L accounts."
    },
    {
      "id": "i11",
      "content": "move on to billing."
    },
    {
      "id": "i12",
      "content": "pay attention to the cost of goods sold and inventory."
    },
    {
      "id": "i13",
      "content": "update the customer account."
    },
    {
      "id": "i14",
      "content": "proceed to update the G/L accounts again."
    },
    {
      "id": "i15",
      "content": "pay attention to revenue, discounts, etc."
    },
    {
      "id": "i16",
      "content": "posting the payment receipt."
    },
    {
      "id": "i17",
      "content": "Finally, the process ends."
    }
  ]
}