{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially,"
      ],
      "justification": "Explicitly marks the process initiation context."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
      "justification": "Both the check action and the subsequent XOR branch derive from this conditional clause."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "is selected"
      ],
      "justification": "Positive guard condition matching the selection state."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Direct mapping to the prescribed action upon selection."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the option is not selected"
      ],
      "justification": "Negative guard condition matching the alternative path trigger."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Single source span justifies both sequential actions on the negative arm."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule,"
      ],
      "justification": "Maps to the schedule validation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory."
      ],
      "justification": "Supports both the check action node and the implicit decision gateway."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Negative condition directing flow back to research."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\".",
        "If the schedule is not satisfactory, perform the action \"Research schedule\"."
      ],
      "justification": "Represents the repeated fallback action described across two source units."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory,"
      ],
      "justification": "Second satisfaction check driving another decision point."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory,"
      ],
      "justification": "Negative outcome guard for the secondary check."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "then \"provide indications\"."
      ],
      "justification": "Action triggered when the schedule remains unsatisfactory."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Positive condition advancing to ticket creation."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Alternative positive condition merging into the same downstream flow."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Convergence of positive paths leads directly into the ticket writing action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Direct mapping to the post-writing validation step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "First approval check supporting both action and gateway."
    },
    {
      "refs": [
        "guard:b4->e2"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Negative outcome leading to process termination."
    },
    {
      "refs": [
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Positive outcome directing flow to re-validation."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Matches the repeated validation instruction."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Second approval check mapped to action and gateway."
    },
    {
      "refs": [
        "guard:b5->n19"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Positive path continuing the validation loop."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Third iteration of the validation step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Final approval check supporting action and gateway."
    },
    {
      "refs": [
        "guard:b6->e4"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Final positive outcome terminating the process."
    },
    {
      "refs": [
        "guard:b5->e3"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Negative outcome after second check terminating the process."
    },
    {
      "refs": [
        "guard:b6->e5"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Negative outcome after third check terminating the process."
    }
  ],
