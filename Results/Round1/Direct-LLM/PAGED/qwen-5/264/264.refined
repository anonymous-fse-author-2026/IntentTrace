branch(b2, XOR)
action(n15, "process continues")
action(n16, "complete business case")
action(n20, "end of process")
end(e1)
converge(c1)
converge(c2)
defines(v1, "is resource internal or external", {"internal", "external"})
defines(v2, "does HR services receive the documentation", {"no variations", "variations"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, b1, n6, n7, c1, n8, n9, n10, n11, n12, b2, n15, n16, c2, n20, e1])
precedence(i1, n1)
precedence(n1, n2)
