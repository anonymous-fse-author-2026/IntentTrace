{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "The opening unit implicitly triggers the start node, includes the explicit 'start' action, and directly describes the first two substantive actions."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Models the completeness check, the XOR split, the negative guard for incompleteness, and the corresponding return action."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "The positive guard value ('Yes') faithfully represents the 'complete' condition that allows flow continuation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Captures the transition to the compliance evaluation step and the subsequent structural split for further checks."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Directly implements the phone-resolution action step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Directly implements the mail-back return action step."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Correctly segments the compound sentence into two sequential action nodes covering payment and compliance resolution."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Action node faithfully restates the billing step."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Awaiting response followed by the 10-day wait accurately reflects the temporal sequence."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Captures the client notification portion of the dual-clause step."
    },
    {
      "refs": [
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Models the reminder dispatch, the textual end description, and the structural end node."
    },
    {
      "refs": [
        "action:n18",
        "guard:b3->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Accurately chains the satisfaction check, the XOR gateway, the precise 'Unsatisfied' guard, and the discrepancy resolution action."
    },
    {
      "refs": [
        "guard:b3->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Matches the 'Satisfied' guard value and the explicit continuation action."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "reason": "The guard asserts `v2 = 'Non-Compliant'`, but the source explicitly conditions this path on whether the issue 'can be resolved with a phone call'. The operator/value pair misrepresents the routing logic."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "reason": "The guard asserts `v2 = 'Compliant'`, but the source conditions this alternative path on whether the issue 'requires mail back'. This reverses/mislabels the actual split criterion."
    },
    {
      "refs": [
        "label:n13->n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "reason": "The label reads 'Yes', implying a positive/affirmative response triggers the 10-day wait. The source explicitly states the wait occurs 'If there is no response', creating a logical contradiction."
    }
