      ],
      "verbatim_texts": [
        "If a loss claim report is lodged, approve the loss claim and the process ends."
      ],
      "justification": "The edge label captures the triggering condition, the action executes the approval and termination directive, and the end node marks the explicit process conclusion."
    },
    {
