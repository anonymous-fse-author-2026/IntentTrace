        "end:e1"
      ],
      "verbatim_texts": [
        "Reject the merchandise return and the process ends with the merchandise return request being rejected."
      ],
      "justification": "The structural end node directly corresponds to the explicit termination clause stated in this unit."
    },
    {
      "refs": [
        "label:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it has been 5 days, invoice the customer. Invoice the customer and the process ends with the customer being invoiced."
      ],
      "justification": "The label denotes the time condition, the action performs the invoicing step, and the end node reflects the stated termination."
    },
    {
