@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process;
:Ensure Freights are ready to be shipped;
:Ship Freight;
split
:Deliver Freight;
:v2: Process Branch Decision ({Invoice, Claim}); <<objectSignal>>
if () then ([v2 = 'Invoice'] 5 days have passed)
:Invoice the Customer;
stop
else ([v2 = 'Claim'] Loss Claim Lodged)
:Approve Loss Claim and End Process;
stop
endif
split again
:Notify Delivery;
split again
:Check for Merchandise Return Request;
:v1: Merchandise Return Status ({Accepted, Rejected}); <<objectSignal>>
if () then ([v1 = 'Accepted'])
:Accept Merchandise Return;
:Proceed with Returning Merchandise;
:Return the merchandise;
stop
else ([v1 = 'Rejected'])
:Reject Merchandise Return;
stop
endif
end split
@enduml