init(i1)
action(n1, "Start loan application process")
branch(b1, XOR)
action(n3, "End process due to rejection")
end(e1)
action(n5, "Disburse funds")
action(n6, "End process after disbursal")
end(e2)
defines(v1, "Is loan application rejected", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, b1, n3, e1, n5, n6, e2])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n3)
precedence(n3, e1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, e2)
guard(b1, n3, v1 = 'Yes')
guard(b1, n5, v1 = 'No')