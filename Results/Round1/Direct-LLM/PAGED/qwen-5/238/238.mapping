{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "The opening clause implicitly starts the process and directly describes the first action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check the Customer's Credit Limit"
      ],
      "justification": "Direct paraphrase of the credit check step."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\""
      ],
      "justification": "The XOR branch and guard capture the conditional logic for an 'Okay' response."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article"
      ],
      "justification": "Direct restatement of the availability check step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if the response is \"No\", send a Denial to the Customer"
      ],
      "justification": "Guard captures the 'No' condition; action captures sending the denial."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods"
      ],
      "justification": "Branch and guard model the unavailability condition; action captures production."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "if the Article is available, proceed to Collect the Goods"
      ],
      "justification": "Guard models availability; action captures collection."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "if the Article is available",
        "send an Order Confirmation"
      ],
      "justification": "Action captures the confirmation step; the preceding condition is implicit in the flow convergence."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "AND gateway correctly models the concurrent execution directive."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "complete the following steps: Ship the Goods and Send the Invoice"
      ],
      "justification": "Two action nodes faithfully split the compound step into shipping and invoicing."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Check the Payment status"
      ],
      "justification": "Direct paraphrase of the payment status check."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process"
      ],
      "justification": "Branch, guard, action, and end node collectively and accurately model the positive payment outcome and process termination."
    },
    {
      "refs": [
        "guard:b3->b4"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3"
      ],
      "justification": "Guard captures the unpaid condition; branch captures the subsequent reminder count decision."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order"
      ],
      "justification": "Guard models the threshold condition; action captures the write-off step."
    },
    {
      "refs": [
        "guard:b4->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "send a Reminder"
      ],
      "justification": "Guard and action correctly model the alternative path for sending a reminder."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process"
      ],
      "justification": "Action and end node faithfully implement the final closure and termination sequence."
    }
  ],
