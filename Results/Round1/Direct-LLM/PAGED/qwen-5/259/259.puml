@startuml
!theme plain
|a_default| Default
|a_default|
start
:identify the need for a new client;
split
:prepare a portfolio presentation;
split again
:analyze the market;
end split
:send an offer to the potential client;
:inform management about the potential client's responses;
:analyze the responses;
:begin negotiations;
:detail the offer according to the client's preferences;
:receive the client's response;
:is the client's response positive?;
:v2: is the client's response positive? ({positive, negative}); <<objectSignal>>
if () then ([v2 = 'positive'])
:prepare a contract for signing;
:sign the contract;
else ([v2 = 'negative'])
:analyze the reasons for rejection and learn from experience;
endif
stop
@enduml