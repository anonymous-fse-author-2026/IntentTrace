{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "The opening clause implicitly starts the process and directly describes the first action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Direct paraphrase capturing the reception step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Exact match in meaning, actor, and objective."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Faithfully restates the checking step."
    },
    {
      "refs": [
        "guard:n6->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized."
      ],
      "justification": "The conditional opens the XOR branch; the guard extracts the internal condition and the action performs the authorization."
    },
    {
      "refs": [
        "guard:n6->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Captures the alternative branch condition, corresponding action, and implicit rejoining of split paths."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Directly matches the sending instruction, payload, and target recipient."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Accurately reflects the scanning and recording steps into the specified system."
    },
    {
      "refs": [
        "guard:n13->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Correctly models the decision point, negative condition guard, and continuation action."
    },
    {
      "refs": [
        "guard:n13->n15"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed."
      ],
      "justification": "Models the positive variation branch and the completion action. The minor omission of 'attached' does not alter core workflow logic or outcomes."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed and attached."
      ],
      "justification": "Models the positive variation branch and the completion action. The minor omission of 'attached' does not alter core workflow logic or outcomes."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Covers the final reception step and explicitly signals the process termination."
    }
  ],
