{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "The opening clause implicitly starts the process (init) and explicitly describes the trigger and check actions."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "The XOR branch handles the conditional split; the guard represents the positive threshold arm; the action matches the order creation."
    },
    {
      "refs": [
        "guard:b1->e1"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "The guard captures the negative threshold arm, leading to the explicitly described process termination."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Directly implements the review step following purchase order creation."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "The XOR branch splits on purchase status; the guard represents the rejection arm; the action matches the rework step."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "The guard captures the approval arm, leading to the fund reservation action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Implements the secondary review action specified after rework."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Implements the supplier dispatch action specified after fund reservation."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "The AND branch initiates concurrent execution; converge rejoins the parallel paths; actions match the two receipt steps."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Directly implements the packing slip recording step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Directly implements the invoice recording step."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Marks the termination point explicitly described after recording the packing slip."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Marks the termination point explicitly described after recording the invoice."
    }
  ],
