      "verbatim_texts": [
        "Initially, if the option \"research schedule directly\" is selected"
      ],
      "justification": "The opening clause establishes the process start, creates the first XOR decision, applies the 'selected' guard, and executes the corresponding action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "The opening clause establishes the process start, creates the first XOR decision, applies the 'selected' guard, and executes the corresponding action."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the option is not selected",
        "then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Covers the negative branch guard and the two sequential actions described in the alternative path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the option is not selected",
        "then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Covers the negative branch guard and the two sequential actions described in the alternative path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected",
        "then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Covers the negative branch guard and the two sequential actions described in the alternative path."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Captures the validation step, models the satisfactoriness check as an action, and introduces the subsequent decision point."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Maps the negative condition of the first satisfactoriness check to its guard and the prescribed research action."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Maps the positive condition to its guard and the ticket-ordering action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory"
      ],
      "justification": "Models the re-evaluation condition as an action step feeding into the next XOR branch."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Captures the repeated failure condition and the indication-providing action."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "The positive guard converges back toward the ticket-ordering path described in the source."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Structural converge joins the divergent schedules, followed immediately by the explicit validation action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Models the approval verification as an action leading to an XOR branch."
    },
    {
      "refs": [
        "guard:b4->e2"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Negative approval guard directs flow to the first process termination."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Positive approval guard triggers the re-validation action."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->e3"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Covers the repeated check, the negative outcome guard, and the corresponding termination."
    },
    {
      "refs": [
        "guard:b5->n19",
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Includes the positive continuation guard, the implied intermediate validation, and the final approval check modeled as action/branch."
    },
    {
      "refs": [
        "guard:b6->e4",
        "guard:b6->e5"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Final decision splits to two terminal nodes covering both eventualities; converge handles post-decision flow merging."
    }
