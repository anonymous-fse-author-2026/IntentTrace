      ],
      "verbatim_texts": [
        "i1: To start the process for ACME,"
      ],
      "justification": "The opening phrase explicitly initializes the process and describes the first starting action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "i2: begin with the New Resupply Cycle"
      ],
      "justification": "Direct paraphrase of the cycle initiation step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "i3: and then Check Levels of Inventory."
      ],
      "justification": "Faithfully captures the sequential inventory checking step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "i4: If the inventory is below or equal to the minimum,",
        "i5: If the inventory is below or equal to the minimum"
      ],
      "justification": "The action phrases the condition as a verification question, and the branch node implements the resulting decision split."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "i6: generate an Equal to or below minimum Report."
      ],
      "justification": "Exact match of the report generation instruction."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "i7: If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Captures the alternative report generation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "i8: If the report indicates that the inventory is equal to or below the minimum,"
      ],
      "justification": "Action verifies the report indication, branch enacts the subsequent decision point."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "i9: create Purchase Orders (POs)."
      ],
      "justification": "Direct match of the PO creation step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "i10: the process ends."
      ],
      "justification": "Action states termination, structural node formally marks the end path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "i11: If the PO is rejected,"
      ],
      "justification": "Action poses the rejection check, branch models the exclusive decision."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "i12: it needs to be reworked."
      ],
      "justification": "Accurate representation of the rework requirement."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "i14: it is printed and released in the system."
      ],
      "justification": "Faithfully restates the print-and-release action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "i15: If the PO is created, it needs to be reviewed."
      ],
      "justification": "Captures the review requirement for created POs."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "i16: If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Directly maps to the recreation step following rework."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "i17: Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "Actions split the two concurrent tasks, AND gateway correctly models the 'Simultaneously' directive."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "i18: If funds are reserved for the released POs,"
      ],
      "justification": "Action checks fund reservation status, branch executes the conditional split."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "i19: receive the Packing Slip."
      ],
      "justification": "Exact match of the packing slip receipt step."
    },
    {
