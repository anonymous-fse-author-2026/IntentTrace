        "action:n36"
      ],
      "verbatim_texts": [
        "i20: receive the inventory."
      ],
      "justification": "Direct match of the inventory receipt step."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "i21: If the Packing Slip is received,"
      ],
      "justification": "Action verifies receipt, branch handles the subsequent decision."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "i22: proceed to receive the Invoice."
      ],
      "justification": "Accurately reflects the transition to invoice receipt."
    },
    {
      "refs": [
        "action:n38"
      ],
      "verbatim_texts": [
        "i23: If the inventory is received,"
      ],
      "justification": "Action confirms inventory arrival, branch manages the flow split."
    },
    {
