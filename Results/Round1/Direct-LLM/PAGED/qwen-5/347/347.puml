start
:start the process for ACME;
:begin New Resupply Cycle;
:Check Levels of Inventory;
:Is inventory below or equal to minimum;
:v1: Is inventory below or equal to minimum ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:generate Equal to or below minimum Report;
:Does report indicate inventory equal or below minimum;
:v2: Does report indicate inventory equal or below minimum ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:create Purchase Orders POs;
:PO needs to be reviewed;
:Is PO rejected;
:v3: Is PO rejected ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:rework PO;
:PO needs to be created again;
else ([v3 = 'No'])
:print and release PO in system;
split
:Simultaneously reserve funds for released POs;
repeat :Are funds reserved for the released POs;
:v5: Are funds reserved for the released POs ({Yes, No}); <<objectSignal>>
backward:Wait for funds reservation or recheck status;
repeat while () is ([v5 = 'No']) not ([v5 = 'Yes'])
:Receive Packing Slip;
split again
:Mail POs to supplier;
split
-> Yes;
split again
-> No;
:Wait for inventory or recheck status;
end split
:Receive Inventory;
repeat :Has Inventory been received;
:v8: Has Inventory been received ({Yes, No}); <<objectSignal>>
backward:Wait for inventory or recheck status;
repeat while () is ([v8 = 'No']) not ([v8 = 'Yes'])
:Receive Packing Slip;
end split
repeat :Has Packing Slip been received;
:v6: Has Packing Slip been received ({Yes, No}); <<objectSignal>>
backward:Wait for packing slip or recheck status;
repeat while () is ([v6 = 'No']) not ([v6 = 'Yes'])
:Receive Invoice;
repeat :Has Invoice been received;
:v7: Has Invoice been received ({Yes, No}); <<objectSignal>>
backward:Wait for invoice or recheck status;
repeat while () is ([v7 = 'No']) not ([v7 = 'Yes'])
:Proceed to Three way match;
:Is Three way match successful;
:v9: Is Three way match successful ({Yes, No}); <<objectSignal>>
if () then ([v9 = 'No'])
->;
else ([v9 = 'Yes'])
:Release funds;
:Issue payment;
:Resupply Cycle is complete process ends;
endif
stop
endif
else ([v2 = 'No'])
->;
endif
else ([v1 = 'No'])
:generate Above Minimum Report;
endif
:process ends;
