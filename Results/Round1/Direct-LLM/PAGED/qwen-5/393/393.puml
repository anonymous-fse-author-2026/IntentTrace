@startuml
!theme plain
|a_rec_mgr| Recruitment Manager
|a_next_mgr| Next Level Manager
|a_client_hr| Client HR
|a_ts_hr| TS HR Coordinator
|a_rec_mgr|
start
:start;
:advise unsuccessful candidates;
:are there more candidates?;
:v1: are there more candidates? ({true, false}); <<objectSignal>>
if () then ([v1 = false])
:re-advertise position;
else ([v1 = true])
:check if terms and conditions need to be sorted out;
:check voluntary redundancy acceptance;
:v_vr: voluntary redundancy accepted? ({true, false}); <<objectSignal>>
if () then ([v_vr = true])
:further investigation;
else ([v_vr = false])
->;
endif
:v2: check if terms and conditions need to be sorted out ({true, false}); <<objectSignal>>
if () then ([v2 = true])
:send appointment approval form;
|a_next_mgr|
:received by next level manager;
:is the approver an external resource?;
:v3: is the approver an external resource? ({true, false}); <<objectSignal>>
if () then ([v3 = false])
:continue process;
else ([v3 = true])
:approve form;
|a_client_hr|
:received by client HR;
:receive authorization decision;
:v4: was the form authorized by the external approver? ({true, false}); <<objectSignal>>
if () then ([v4 = true])
:scan and record form in GovSource;
else ([v4 = false])
:contact external approver for clarification;
endif
|a_next_mgr|
endif
|a_rec_mgr|
else ([v2 = false])
:continue process (no terms needed);
endif
:inform recruitment manager and liaise with HR representative;
:are there any variations?;
:v5: are there any variations? ({true, false}); <<objectSignal>>
if () then ([v5 = true])
:create business case;
else ([v5 = false])
:continue process;
:is medical assessment required (12% rate)?;
:v6: is medical assessment required (12% rate)? ({true, false}); <<objectSignal>>
if () then ([v6 = true])
:arrange and complete medical assessment (21 days);
|a_ts_hr|
:notify manager of assessment outcome;
|a_rec_mgr|
:is assessment satisfactory?;
:v7: is assessment satisfactory? ({true, false}); <<objectSignal>>
if () then ([v7 = false])
:contact next candidate on shortlist;
else ([v7 = true])
:continue process;
endif
else ([v6 = false])
->;
endif
split
:make formal verbal offer to candidate;
:does candidate accept offer?;
:v8: does candidate accept offer? ({true, false}); <<objectSignal>>
if () then ([v8 = true])
:create formal written offer;
else ([v8 = false])
:continue process;
endif
split again
:send commencement pack and letter of appointment;
end split
:is there a 40% rate?;
:v9: is there a 40% rate? ({true, false}); <<objectSignal>>
if () then ([v9 = true])
:renegotiate terms;
:are renegotiations successful?;
:v10: are renegotiations successful? ({true, false}); <<objectSignal>>
if () then ([v10 = false])
:identify next candidate on shortlist;
else ([v10 = true])
:continue process;
endif
else ([v9 = false])
->;
endif
endif
endif
:end of procedure;
stop
@enduml