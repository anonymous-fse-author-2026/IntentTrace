{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "the first step is to advise unsuccessful candidates"
      ],
      "justification": "Initiates the process and executes the first advising step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\", then the position should be re-advertised."
      ],
      "justification": "Models the candidate availability check, XOR split, re-advertising outcome, and implicit else routing."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "if the terms and conditions of the offer for a candidate need to be sorted out"
      ],
      "justification": "Evaluates whether terms/conditions require sorting and routes to form-sending or continuation accordingly."
    },
    {
      "refs": [
        "action:n_red_check"
      ],
      "verbatim_texts": [
        "it is necessary to check if the candidate has accepted a voluntary redundancy."
      ],
      "justification": "Implements the voluntary redundancy acceptance check and subsequent decision point."
    },
    {
      "refs": [
        "guard:b_red->c_vr"
      ],
      "verbatim_texts": [
        "If the candidate has not accepted, the process continues."
      ],
      "justification": "False path rejoins the main flow to continue the process."
    },
    {
      "refs": [
        "guard:b_red->n_investigate",
        "action:n_investigate"
      ],
      "verbatim_texts": [
        "On the other hand, if the candidate has accepted, further investigation is required."
      ],
      "justification": "True path triggers the required investigation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form"
      ],
      "justification": "Directly models sending the approval form."
    },
    {
      "refs": [
        "action:n_recv_mgr"
      ],
      "verbatim_texts": [
        "which is then received by the next level manager."
      ],
      "justification": "Captures the reception event by the next manager."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the manager is an external resource"
      ],
      "justification": "Checks whether the manager is an external resource."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the approver is an existing employee of the client, the process continues."
      ],
      "justification": "Internal approver path continues the process as specified."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the form is approved",
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "justification": "Validates approval and proceeds to scanning and recording in GovSource."
    },
    {
      "refs": [
        "guard:b4->n11"
      ],
      "verbatim_texts": [
        "If the form is approved",
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "justification": "Validates approval and proceeds to scanning and recording in GovSource."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the form is approved",
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "justification": "Validates approval and proceeds to scanning and recording in GovSource."
    },
    {
      "refs": [
        "action:n15",
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If there are any variations, a complete business case is required."
      ],
      "justification": "Checks for variations and triggers business case creation."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "Otherwise, the process continues."
      ],
      "justification": "Else path continues and rejoins flow."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate."
      ],
      "justification": "Evaluates medical assessment requirement."
    },
    {
      "refs": [
        "guard:b6->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "it can take up to 21 days to arrange and complete."
      ],
      "justification": "True path arranges and completes the assessment with the 21-day duration noted."
    },
    {
      "refs": [
        "guard:b6->c2"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate."
      ],
      "justification": "False path rejoins flow when assessment is not required."
    },
    {
      "refs": [
        "action:n21",
        "guard:b7->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory, the next candidate on the shortlist should be contacted."
      ],
      "justification": "Checks satisfaction status and contacts the next candidate if unsatisfactory."
    },
    {
      "refs": [
        "guard:b7->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "if the assessment is fine, the process continues."
      ],
      "justification": "Satisfactory path continues and rejoins flow."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "The recruitment manager makes a formal verbal offer of employment to the candidate."
      ],
      "justification": "Makes the formal verbal offer."
    },
    {
      "refs": [
        "action:n25",
        "guard:b8->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If the candidate accepts, the recruitment manager creates a formal written offer."
      ],
      "justification": "Checks candidate acceptance and creates the written offer."
    },
    {
      "refs": [
        "guard:b8->n27",
        "action:n27"
      ],
      "verbatim_texts": [
        "If the candidate declines, the process continues."
      ],
      "justification": "Decline path continues the process."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "Simultaneously, the commencement pack and letter of appointment are sent to the candidate."
      ],
      "justification": "AND gateway handles simultaneity; action sends the documents."
    },
    {
      "refs": [
        "action:n29",
        "guard:b9->n30",
        "action:n30"
      ],
      "verbatim_texts": [
        "if there is a \"40%\" rate, renegotiation is required."
      ],
      "justification": "Checks for the 40% rate and triggers renegotiation."
    },
    {
      "refs": [
        "guard:b9->c4"
      ],
      "verbatim_texts": [
        "if there is a \"40%\" rate, renegotiation is required."
      ],
      "justification": "Implicit else path rejoins flow when rate condition is false."
    },
    {
      "refs": [
        "action:n31",
        "guard:b10->n33",
        "action:n33"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful, the process continues."
      ],
      "justification": "Checks success status and continues process."
    },
    {
      "refs": [
        "guard:b10->n32",
        "action:n32"
      ],
      "verbatim_texts": [
        "if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified."
      ],
      "justification": "Unsuccessful path identifies the next candidate."
    },
    {
      "refs": [
        "action:n34"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Marks process termination."
    }
  ],
