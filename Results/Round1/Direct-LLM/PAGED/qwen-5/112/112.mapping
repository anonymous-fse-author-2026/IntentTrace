        "action:n21",
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue."
      ],
      "justification": "Exam pass check, XOR split, positive guard, and course pass action."
