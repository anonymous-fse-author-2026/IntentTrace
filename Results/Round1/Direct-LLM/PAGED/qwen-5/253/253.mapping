{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "The opening clause implicitly initiates the process and directly names the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\", then proceed to Create Purchase Order."
      ],
      "justification": "Faithfully extracts the exact threshold condition from the source, accurately capturing the decision criterion despite being modeled as an action step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\", then proceed to Create Purchase Order."
      ],
      "justification": "Directly captures the instructed purchase order creation step following the condition."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\", then proceed to Create Purchase Order.",
        "However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "Structural XOR gateway correctly representing the two mutually exclusive inventory level pathways described across both units."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "Termination node aligns with the explicit early-exit instruction in the source."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Action step accurately reflects the post-creation review requirement."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved, then reserve the funds for the purchase."
      ],
      "justification": "The condition modeled as an action step alongside the implicit XOR branch structure both faithfully correspond to the source conditional logic."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved, then reserve the funds for the purchase."
      ],
      "justification": "Directly matches the positive outcome action instructed in the source."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the Purchase Order is rejected, then rework the order."
      ],
      "justification": "Faithfully captures the negative outcome rework instruction."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Direct paraphrase of the supplier dispatch step with preserved ordering dependency."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Captures the re-review step; iterative context is preserved by the process flow back to the decision node."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: the Supplier sends a packing slip and an invoice."
      ],
      "justification": "AND gateway and action step jointly and accurately capture the concurrent supplier activities mandated by the source."
    },
    {
      "refs": [
        "label:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it."
      ],
      "justification": "Routing label and action step together faithfully cover the receipt trigger and recording instruction."
    },
    {
      "refs": [
        "label:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Similarly, when the invoice is received, record it as well."
      ],
      "justification": "Routing label and action step together faithfully cover the invoice receipt trigger and recording instruction."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice, release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "Converge node and action step jointly capture the synchronization point and the dual financial steps that follow."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Terminal node correctly corresponds to the final process completion statement."
    }
