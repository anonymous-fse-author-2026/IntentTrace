@startuml
!theme plain
|a_default| Default
|a_default|
start
:Resupply Cycle Triggered;
:Check Inventory Level;
:v1: Inventory Level at or below minimum ({below, above}); <<objectSignal>>
if () then ([v1 = "below"])
:Create Purchase Order;
:Reviewing Purchase Order;
:v2: Purchase Order Approved ({approved, rejected}); <<objectSignal>>
if () then ([v2 = "approved"])
:Reserve Funds for Purchase;
:Send Order to Suppliers;
split
:Supplier sends packing slip;
:Record packing slip;
split again
:Supplier sends invoice;
:Record invoice;
end split
:Release reserved funds;
:Issue payment to supplier;
stop
else ([v2 = "rejected"])
:Rework Order;
:Reviewing Purchase Order;
endif
else ([v1 = "above"])
stop
endif
@enduml