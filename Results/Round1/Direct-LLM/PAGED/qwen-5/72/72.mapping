    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with"
      ],
      "justification": "The init node and generic start action both directly correspond to the explicit opening phrase."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Bill for Purchased Goods/Services and then Receive Invoice"
      ],
      "justification": "Content exactly reproduces the sequential initial steps."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "The question step, XOR branch, and positive guard collectively capture the incompleteness condition and routing."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Models the explicit return action and the implicit terminal state of this branch."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Negative guard and continuation action align perfectly with the complete invoice path."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted. On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Branch, check step, compliant guard, and converge node accurately model the compliance divergence and rejoin."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Guard directs flow to the phone resolution step, matching the source condition."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Routes the mail-back condition to the appropriate return action and branch termination."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "AND gateway branches and billing action correctly implement the simultaneous execution requirement."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Condition check, branching, and waiting period action align precisely with the source."
    },
    {
      "refs": [
        "action:n11",
        "action:n18"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Payment and notification steps faithfully reproduce the source instruction."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Models the alternative path leading to the reminder dispatch and final process termination."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Branch and guard correctly route to discrepancy resolution for unsatisfied clients."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Guard and continuation action match the satisfied client condition exactly."
    }
