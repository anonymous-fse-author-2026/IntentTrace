  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "i1: To initiate the process, start by receiving the order."
      ],
      "justification": "The opening clause implicitly triggers the start node and directly specifies the first action."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "i2: At the same time, complete the following steps: check the order and check the customer."
      ],
      "justification": "Temporal concurrency marker justifies the AND branch, while the listed tasks map exactly to the two check actions."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "i3: If the order is okay, then continue with the process."
      ],
      "justification": "Conditional phrasing maps to the XOR branch and its positive guard, while the subject matter aligns with the check-action modeled as n4."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "i4: If the customer is not permitted, send a refusal."
      ],
      "justification": "The negative permission condition justifies the second XOR branch, the corresponding negative guard, and the evaluation action n7."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "i5: However, if the customer is permitted, continue with the process."
      ],
      "justification": "Directly supports the positive guard routing from branch b2 toward the subsequent process step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "i6: In this case, send a refusal and end the process.",
        "i7: end the process"
      ],
      "justification": "The refusal action and terminal state match the explicit instructions and concluding remark."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "i8: If the order is not okay, send a refusal and end the process."
      ],
      "justification": "Maps the negative outcome of the order check to its guard, refusal action, and termination node."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "i9: Release the order and then transfer the data in the database."
      ],
      "justification": "Sequential instructions faithfully reproduced as two consecutive action elements."
    },
    {
      "refs": [
        "action:n12",
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "i10: Once the data is transferred, check the worth of the order. If it is greater than 10.000 \u20ac,"
      ],
      "justification": "Threshold evaluation maps to the XOR branch, the numeric comparison guard, and the evaluation action n12."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "i11: sign off on the order."
      ],
      "justification": "Exact match for the positive-branch approval step."
    },
    {
      "refs": [
        "action:n14",
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "i12: Otherwise, continue with the process."
      ],
      "justification": "Fallback condition maps to the negative guard and the explicit continuation action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "i13: Sign off on the order and forward it to production."
      ],
      "justification": "Combined instruction accurately preserved in the action content."
    },
    {
