@startuml
!theme plain
|a_default| Default
|a_default|
start
:receive the invoice;
:check the invoice for mismatches;
:v1: determine action for invoice ({re-send the invoice to the customer, post the invoice, block the invoice}); <<objectSignal>>
switch ()
case ([v1 = 're-send the invoice to the customer'])
:re-send the invoice to the customer;
case ([v1 = 'post the invoice'])
:post the invoice;
case ([v1 = 'block the invoice'])
:block the invoice;
endswitch
:park the invoice;
:end the process;
stop
@enduml