@startuml
!theme plain
|a_customer| Customer
|a_we| We
|a_we|
start
|a_customer|
:customer makes an enquiry;
|a_we|
:is the article in stock;
if () then ([v1 = 'unavailable'])
:abort the enquiry and end process;
stop
else ([v1 = 'available'])
:reserve the article;
:calculate the price;
:send the offer;
:wait for the customer to accept the offer;
|a_customer|
:has the customer accepted the offer;
|a_we|
:await acceptance decision;
:dispatch the article;
stop
endif
@enduml