{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "The opening clause establishes the process start (init) and describes the first sending action (n2)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Directly maps to the approval receipt step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Faithfully captures the contact and clarification step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Matches the initial approval check step."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the resource is internal,"
      ],
      "justification": "The condition introduces the XOR split; the action node poses it as a question and the guard captures the positive path logic."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the appointment is authorized."
      ],
      "justification": "Matches the authorization outcome for the internal branch."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Captures the negative branch condition, the resulting action, and the implicit rejoining of the two resource paths."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Directly matches the documentation sending step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Faithfully reproduces the scanning and recording step."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Splits the compound sentence into two sequential actions matching the check-then-send flow described."
    },
    {
      "refs": [
        "action:n13",
        "action:n20"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Maps the reception action, the explicit termination statement, and the structural end node."
    },
    {
      "refs": [
        "action:n14",
        "guard:b2->n15"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues. However, if there are variations, a business case is completed."
      ],
      "justification": "Captures the variation check question, the XOR gateway, and the guard for the 'no variations' continuation path."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "the process continues."
      ],
      "justification": "Matches the continuation arm of the variation decision."
    },
    {
      "refs": [
        "guard:b2->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "a business case is completed and attached."
      ],
      "justification": "Matches the guard for the variations path, the composite completion action, and the implicit convergence before process termination."
    }
  ],
