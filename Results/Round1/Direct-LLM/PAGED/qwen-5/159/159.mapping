{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, it is important to check the Referee Reports."
      ],
      "justification": "The opening statement implicitly initiates the process and defines the first verification action."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If they have been completed,"
      ],
      "justification": "Establishes the XOR decision point and the positive guard condition."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "if they have not been completed,"
      ],
      "justification": "Defines the negative condition branching off the decision."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "you should flag it and send a reminder."
      ],
      "justification": "Directly corresponds to the prescribed handling step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "check again if the Referee Reports have been completed."
      ],
      "justification": "Describes the iterative check step and implies the subsequent decision node."
    },
    {
      "refs": [
        "guard:b4->c1"
      ],
      "verbatim_texts": [
        "If they have,"
      ],
      "justification": "Positive outcome condition that triggers flow convergence."
    },
    {
      "refs": [
        "guard:b4->n15"
      ],
      "verbatim_texts": [
        "If not,"
      ],
      "justification": "Negative outcome condition for the re-check loop."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If not, you should flag it again and send another reminder."
      ],
      "justification": "Explicitly matches the repeated escalation instruction."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "receive feedback from the interview candidates."
      ],
      "justification": "Exact match for the post-interview feedback step."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "check if a Psychometric Test is required."
      ],
      "justification": "Captures the requirement check, the associated decision gateway, and the implicit negative path."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If it is,"
      ],
      "justification": "Captures the affirmative condition proceeding to HR checks."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "check if an HR Specialist is required."
      ],
      "justification": "Corresponds to the nested requirement check and its decision node."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required,"
      ],
      "justification": "Defines the positive condition for third-party scheduling."
    },
    {
      "refs": [
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "Otherwise,"
      ],
      "justification": "Defines the alternative/negative condition path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "schedule the test with a third party."
      ],
      "justification": "Direct match for the external scheduling action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "proceed to complete the Psychometric Test."
      ],
      "justification": "Direct match for internal test completion."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "coordinate the second round of selection."
      ],
      "justification": "Exact match for the coordination step following the non-required path."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, you should request the final candidate ranking and continue with the process."
      ],
      "justification": "Covers the final administrative step and signals process termination."
    }
  ],
