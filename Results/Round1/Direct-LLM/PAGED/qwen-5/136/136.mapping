    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "i1: To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "The opening phrase signals process start (init) and explicitly describes placing an order (action)."
    },
    {
      "refs": [
        "action:n3",
        "action:n5"
      ],
      "verbatim_texts": [
        "i2: If the customer is \"not eligible to order\", inform them. Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "The conditional structure implies the XOR branch, and both positive/negative arms are captured by the corresponding action elements."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "i3: After informing the customer, the process ends."
      ],
      "justification": "Explicit termination signal matches the structural end node."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "i4: perform an availability check."
      ],
      "justification": "Direct restatement of the availability check step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n7",
        "guard:b2->c_join"
      ],
      "verbatim_texts": [
        "i5: Check if the product is \"available\". If it is not, start producing the missing parts."
      ],
      "justification": "Captures the availability check decision, the negative-arm action, the implicit rejoin, and both outcome conditions."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "i6: Prepare the products for shipment."
      ],
      "justification": "Exact paraphrase of the preparation step."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "i7: Simultaneously"
      ],
      "justification": "Timing keyword directly maps to the parallel AND gateway."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "i8: complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "Covers the three parallel tasks and their convergence point."
    },
    {
      "refs": [
        "action:n14",
        "guard:b3->n14",
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "i9: If the payment is received, close the order. If the payment is not received, send a reminder."
      ],
      "justification": "Maps the payment decision, the close-order action, and both payment-state guards."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "i10: ending the process."
      ],
      "justification": "Explicit termination phrase matches the end node."
    },
    {
      "refs": [
        "action:n18",
        "guard:b4->c4"
      ],
      "verbatim_texts": [
        "i11: If the number of reminders is less than 3, continue the process. Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Captures the reminder count decision, the lawyer notification action, the process end, and the continuation guard."
    }
