@startuml
!theme plain
|a_default| Default
|a_default|
start
:run: Password Verification;
:Verify Password;
:v1: condition  Select Cancel / Reset password / Retry ({Select Cancel, Reset password, Retry}); <<objectSignal>>
switch ()
case ([v1 = 'Select Cancel'])
:iforgot.apple.com;
case ([v1 = 'Reset password'])
:iforgot.apple.com;
case ([v1 = 'Retry'])
:re-enter password;
:verify re-entered password;
:go to iforgot.apple.com;
endswitch
:reset password;
:run: Return to iTunes purchases page;
:select price of the item;
:v2: condition  Enter Password / Enter Apple ID ({Enter Password, Enter Apple ID}); <<objectSignal>>
if () then ([v2 = 'Enter Password'])
:verify the password;
else ([v2 = 'Enter Apple ID'])
:enter the password;
endif
:enter the password and verify it;
stop
@enduml