init(i1)
action(n1, "Start immigration checks")
action(n2, "Select exit control check method")
branch(b1, XOR)
action(n3, "Undergo biometrics check")
action(n4, "Undergo ID documents check")
action(n5, "Evaluate exit control check permission")
branch(b2, XOR)
action(n6, "Passenger denied permission leave area")
action(n7, "Passenger allowed to continue proceed to next step")
action(n11, "End")
end(e1)
converge(c1)
converge(c2)
defines(v1, "Select exit control check method", {"biometrics", "id_documents"})
defines(v2, "Evaluate exit control check permission", {"denied", "allowed"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, b2, n6, n7, n11, e1, c1, c2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, c1)
precedence(n4, c1)
precedence(c1, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n7)
precedence(n6, c2)
precedence(n7, c2)
precedence(c2, n11)
precedence(n11, e1)
guard(b1, n3, v1 = 'biometrics')
guard(b1, n4, v1 = 'id_documents')
guard(b2, n6, v2 = 'denied')
guard(b2, n7, v2 = 'allowed')