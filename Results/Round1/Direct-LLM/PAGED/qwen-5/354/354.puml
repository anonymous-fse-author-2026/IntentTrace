@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start immigration checks;
:Select exit control check method;
:v1: Select exit control check method ({biometrics, id_documents}); <<objectSignal>>
if () then ([v1 = 'biometrics'])
:Undergo biometrics check;
else ([v1 = 'id_documents'])
:Undergo ID documents check;
endif
:Evaluate exit control check permission;
:v2: Evaluate exit control check permission ({denied, allowed}); <<objectSignal>>
if () then ([v2 = 'denied'])
:Passenger denied permission leave area;
else ([v2 = 'allowed'])
:Passenger allowed to continue proceed to next step;
endif
:End;
stop
@enduml