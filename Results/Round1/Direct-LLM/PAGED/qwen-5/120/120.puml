@startuml
!theme plain
|a_support| 1st Level Support
|a_developer| Developer
|a_manager| Account Manager
|a_support|
start
:start;
:Ask 1st Level Support if there is an issue;
:Is the issue resolved?;
:v1: Is the issue resolved? ({true, false}); <<objectSignal>>
if () then ([v1 = true])
:Provide feedback for account manager;
else ([v1 = false])
|a_developer|
:Ask developer for assistance;
:Is the issue resolved now?;
:v2: Is the issue resolved now? ({true, false}); <<objectSignal>>
if () then ([v2 = true])
:Provide feedback for account manager;
else ([v2 = false])
:Ask developer for help again;
:Is the issue resolved after re-assistance?;
:v3: Is the issue resolved after re-assistance? ({true, false}); <<objectSignal>>
if () then ([v3 = true])
:Provide feedback for account manager;
else ([v3 = false])
|a_manager|
:Ask the developer;
:Provide feedback for the 1st Level support;
:Provide feedback for the account manager;
|a_developer|
endif
endif
|a_support|
endif
|a_manager|
stop
@enduml