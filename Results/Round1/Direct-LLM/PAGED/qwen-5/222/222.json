  "input_elements": [
    {
      "id": "i1",
      "content": "To start the SSP process, first ensure that the Invoice is ready for verification."
    },
    {
      "id": "i2",
      "content": "After that,"
    },
    {
      "id": "i3",
      "content": "check for invoice completeness."
    },
    {
      "id": "i4",
      "content": "Once the invoice completeness is confirmed,"
    },
    {
      "id": "i5",
      "content": "proceed to check for SLA."
    },
    {
      "id": "i6",
      "content": "Once the SLA is checked,"
    },
    {
      "id": "i7",
      "content": "move on to checking for invoice compliance."
    },
    {
      "id": "i8",
      "content": "Once these checks are completed,"
    },
    {
      "id": "i9",
      "content": "the batched invoices are allocated to the Data Entry Officer and this is done by 9 am on the next working day."
    },
    {
      "id": "i10",
      "content": "The next step is"
    },
    {
      "id": "i11",
      "content": "process the invoice batch and then take it to the outbox."
    },
    {
      "id": "i12",
      "content": "this should be repeated until all invoices are processed."
    },
    {
      "id": "i13",
      "content": "After taking the batch to the outbox,"
    },
    {
      "id": "i14",
      "content": "make sure to clear the outbox of the Data Entry Officer every hour."
    },
    {
      "id": "i15",
      "content": "This process of clearing the outbox is done every hour until the outbox is completely cleared"
    },
    {
      "id": "i16",
      "content": "until the outbox is completely cleared"
    },
    {
      "id": "i17",
      "content": "which marks the end of the process."
    }
  ]
}