init(i1)
converge(c1)
action(n2, "Provide userdata for flickr login")
action(n3, "Is login successful")
branch(b1, XOR)
end(e1)
action(n5, "Choose to retry or abort")
branch(b2, XOR)
end(e2)
defines(v1, "Login outcome", {"Success", "Failure"})
defines(v2, "Post-failure choice", {"Retry", "Abort"})
actor(a_default, "Default", [i1, c1, n2, n3, b1, e1, n5, b2, e2])
precedence(i1, c1)
precedence(c1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, e1)
precedence(b1, n5)
precedence(n5, b2)
precedence(b2, c1)
precedence(b2, e2)
guard(b1, e1, v1 = 'Success')
guard(b1, n5, v1 = 'Failure')
guard(b2, c1, v2 = 'Retry')
guard(b2, e2, v2 = 'Abort')