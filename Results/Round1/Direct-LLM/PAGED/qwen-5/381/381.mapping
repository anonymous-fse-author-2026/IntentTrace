    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "Otherwise, if 24 hours have passed, you should call a travel agency."
      ],
      "reason": "Guard replaces the explicit time-based threshold (\"if 24 hours have passed\") with a status check (\"v2 = 'Unavailable'\"), fundamentally altering the trigger logic. Action also appends an unsupported \"(train)\" qualifier."
