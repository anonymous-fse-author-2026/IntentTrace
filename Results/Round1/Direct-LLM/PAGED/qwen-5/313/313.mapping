{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "Implicit start node and direct action mapping to the opening registration instruction."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request."
      ],
      "justification": "Question-form action and XOR branch model the conditional check; guard captures 'no fee' condition; action captures the post-seminar registration step."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "Guard captures the 'fee' condition on the alternate branch; action faithfully restates the purchase request creation step."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Structural end node correctly placed after the post-seminar registration step to denote process termination."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Action phrased as a question and XOR branch jointly implement the approval status check decision point."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Guard encodes the approval state; action directly mirrors receiving the approved notification."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Guard encodes the rejection state; action accurately reflects receiving the rejection notification."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Action registers the request following approval; structural end follows consistent with the earlier rule that post-seminar registration terminates the process."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Structural end node captures the explicit termination clause triggered by the rejection notification."
    }
  ],
