@startuml
!theme plain
|a_default| Default
|a_default|
start
:start reviewing incoming CV;
:decide whether to send a negative email or invite candidate;
:v1: decide whether to send a negative email or invite candidate ({send_negative_email, invite_candidate}); <<objectSignal>>
if () then ([v1 = 'send_negative_email'])
:send negative email and end process;
else ([v1 = 'invite_candidate'])
:schedule interview with candidate;
:conduct interview;
endif
stop
@enduml