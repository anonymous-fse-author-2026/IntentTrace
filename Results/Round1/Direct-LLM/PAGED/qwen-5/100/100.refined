init(i1)
action(n1, "start selling cars")
action(n2, "get a bonus?")
branch(b1, XOR)
converge(c1)
action(n3, "get a paycheck?")
branch(b2, XOR)
converge(n4)
action(n5, "pay the bill")
end(e2)
defines(v1, "get a bonus?", {"No", "Yes"})
defines(v2, "get a paycheck?", {"No", "Yes"})
actor(a_default, "Default", [i1, n1, n2, b1, c1, n3, b2, n4, n5, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, c1)
precedence(b1, c1)
precedence(c1, n3)
precedence(n3, b2)
precedence(b2, n4)
precedence(b2, n4)
precedence(n4, n5)
precedence(n5, e2)
guard(b1, c1, v1 = 'Yes')
guard(b1, c1, v1 = 'No')
guard(b2, n4, v2 = 'Yes')
guard(b2, n4, v2 = 'No')