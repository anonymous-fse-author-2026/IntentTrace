      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The opening clause implicitly initializes the process and describes the first action of receiving the claim."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Direct faithful reproduction of the creation and recording step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "Describes the decision action and implicitly introduces the XOR split point."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "Captures the rejection condition guard and the corresponding rejection action."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the claim is to be accepted"
      ],
      "justification": "Faithfully captures the positive condition for the XOR split."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "offer the benefit."
      ],
      "justification": "Direct match for the benefit offering step on the accepted path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Matches the review action; the conditional context is already handled by the upstream split."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Matches the discharge preparation step on the accepted path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Direct match for the benefit payment recording step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process."
      ],
      "justification": "Models the condition as an action step, creates the XOR decision point, and sets the positive guard."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Direct match for the continuation action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Matches the negative guard and shares the same continuation action node."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicitly marks the termination step and structural end point."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "'At the same time' implies an AND gateway splitting into two parallel actions that subsequently converge."
    }
