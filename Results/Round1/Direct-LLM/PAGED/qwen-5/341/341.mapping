      ],
      "verbatim_texts": [
        "The loan application process starts with receiving the loan application."
      ],
      "justification": "The opening clause establishes the process start (init) and directly describes the initial receiving action (n1)."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps should be completed: assessing the loan risk and checking the credit history."
      ],
      "justification": "The 'simultaneously' marker implies the AND split (b2) executing both assessment tasks (n2, n3) in parallel."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "After that,"
      ],
      "justification": "The sequential timing word signals the reconvergence of parallel paths before proceeding to the next step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the eligibility of the applicant is assessed."
      ],
      "justification": "Directly implements the eligibility assessment step immediately following the parallel stage."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the applicant is eligible",
        "If the applicant is not eligible"
      ],
      "justification": "The mutually exclusive conditional clauses establish the XOR decision point."
    },
    {
      "refs": [
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the applicant is eligible"
      ],
      "justification": "Maps the positive eligibility condition to the true guard path."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the applicant is not eligible"
      ],
      "justification": "Maps the negative eligibility condition to the false guard path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the acceptance pack is prepared.",
        "if the applicant is eligible, the acceptance pack is prepared."
