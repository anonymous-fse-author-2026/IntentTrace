      "justification": "Directly implements the preparation step, supported by both the original and redundantly repeated source sentences."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the application is rejected."
      ],
      "justification": "Directly implements the rejection step on the negative branch."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the application is rejected, the loan application process ends."
      ],
      "justification": "The conditional termination statement supports both the explicit end-action and the structural end node for the rejection path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "The prepared acceptance pack is then sent."
      ],
      "justification": "Directly implements the sending step following pack preparation."
