{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by checking the customer's order."
      ],
      "justification": "The init node and both actions faithfully capture the opening instruction to start and check the order."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer is a registered customer, then check their payment morale."
      ],
      "justification": "Condition evaluation, branch, guard, and morale check action align exactly with the source clause."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they are a new customer, then check their status."
      ],
      "justification": "The negative branch guard and status check action correspond to the new-customer case."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If their payment morale is good, continue with the process."
      ],
      "justification": "Morale evaluation, branch, positive guard, and continuation action match the source precisely."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n7",
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "If their payment morale is bad or if they are an end customer,"
      ],
      "justification": "The compound negative condition is correctly split into two converging path guards."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "reject the order and end the process."
      ],
      "justification": "Rejection action, explicit end action, and end node directly implement the termination clause."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the customer is a wholesaler, enter their data and take the order."
      ],
      "justification": "The alternative branch guard and combined data/order action faithfully restate the wholesaler rule."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, check the availability of the items."
      ],
      "justification": "Parallel split markers and the availability check action capture the simultaneous execution instruction."
    },
    {
      "refs": [
        "action:n13",
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the items are out of stock, start production."
      ],
      "justification": "Stock inquiry, branch, negative guard, and production start align perfectly with the out-of-stock rule."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If they are in stock, continue with the process."
      ],
      "justification": "Positive stock guard and continuation action match the in-stock path exactly."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Once the availability is checked, send the order confirmation."
      ],
      "justification": "Convergence nodes and confirmation action reflect the post-check synchronization and messaging step."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If production is started, produce the article and send the order confirmation."
      ],
      "justification": "Article production and second confirmation action explicitly model the production path outputs."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Simultaneously, send the invoice and deliver the product."
      ],
      "justification": "Combined invoice and delivery action matches the source phrasing without alteration."
    },
    {
      "refs": [
        "action:n20",
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "Check the payment status. If payment is received, close the order."
      ],
      "justification": "Payment inquiry, branch, positive guard, and order closure align with the successful payment rule."
    },
    {
      "refs": [
        "action:n22",
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If there are more than three reminders, engage a lawyer."
      ],
      "justification": "Threshold inquiry, branch, high-count guard, and lawyer engagement action correspond exactly."
    },
    {
      "refs": [
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are three or fewer reminders, send a reminder."
      ],
      "justification": "Low-count guard and reminder action match the source condition and instruction."
    }
  ],
