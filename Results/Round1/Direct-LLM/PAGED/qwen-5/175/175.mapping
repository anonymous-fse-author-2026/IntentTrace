{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Implicit start and explicit return action match the opening clause."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process."
      ],
      "justification": "XOR branch, guard condition, and action node accurately reflect the first conditional path."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Second conditional path accurately captured by guard and action."
    },
    {
      "refs": [
        "action:n_check"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Action content directly matches the counting/comparison step."
    },
    {
      "refs": [
        "guard:n5->b2"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process."
      ],
      "justification": "Branch structure and guard condition correctly represent the completion check."
    },
    {
      "refs": [
        "guard:n5->c2",
        "guard:b2->n6",
        "guard:n6->b3"
      ],
      "verbatim_texts": [
        "However, if the \"Order is incomplete and items are missing,\" we still continue the process."
      ],
      "justification": "Multiple redundant guards and branches consistently capture the missing items condition."
    },
    {
      "refs": [
        "guard:b2->n7",
        "guard:n6->c2",
        "action:n7"
      ],
      "verbatim_texts": [
        "Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Guards and action node faithfully restate the damaged items condition and email step."
    },
    {
      "refs": [
        "guard:b4->c2",
        "guard:b5->e2",
        "action:n8",
        "action:n18",
        "guard:b9->c5",
        "guard:b10->n20"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Repeating guards and actions accurately model the packing decision path."
    },
    {
      "refs": [
        "guard:b4->e2",
        "guard:b5->c2",
        "action:n9",
        "action:n19",
        "guard:b9->n20",
        "guard:b10->c5"
      ],
      "verbatim_texts": [
        "Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Repeating guards and actions accurately model the storage decision path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Action content faithfully captures the email notification for missing items."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Action content faithfully captures the inventory removal step for damaged items."
    },
    {
      "refs": [
        "guard:b3->n15",
        "guard:n15->b7",
        "guard:n16->c4",
        "guard:b7->c4",
        "guard:b8->e2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process."
      ],
      "justification": "Branches and guards consistently model the positive return path."
    },
    {
      "refs": [
        "guard:b3->n16",
        "guard:n16->b8",
        "guard:n15->c4",
        "guard:b8->c4",
        "guard:b7->e2"
      ],
      "verbatim_texts": [
        "However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Branches and guards consistently model the negative return path."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "End node and action accurately reflect the first termination point."
    },
    {
      "refs": [
        "guard:b6->n11",
        "guard:b6->n13",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process."
      ],
      "justification": "Branch, guards, and action accurately capture the repair/inventory path."
    },
    {
      "refs": [
        "guard:b6->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Guard and actions accurately capture the discard condition and subsequent email."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order."
      ],
      "justification": "Repeated action faithfully restates the packing step."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Repeated action faithfully restates the storage step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends.",
        "and the process is complete."
      ],
      "justification": "End node and action accurately reflect the final termination and completion statement."
    }
  ],
