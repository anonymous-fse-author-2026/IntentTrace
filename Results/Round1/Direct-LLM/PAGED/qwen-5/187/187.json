  "input_elements": [
    {
      "id": "i1",
      "content": "For the DMS Parts Provision Team, the first step is to gather information about the part from the customer, including the make, model, and year."
    },
    {
      "id": "i2",
      "content": "Once this information is obtained, the team proceeds to check the availability of the part in the local inventory."
    },
    {
      "id": "i3",
      "content": "If the part is found to be available locally, it is retrieved from the inventory."
    },
    {
      "id": "i4",
      "content": "However, if the part is not available locally, the team records the customer's details."
    },
    {
      "id": "i5",
      "content": "and then orders the part from Disuki."
    },
    {
      "id": "i6",
      "content": "Once the part is ordered from Disuki, the process comes to an end."
    }
  ]
