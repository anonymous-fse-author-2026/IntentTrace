{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "The opening clause establishes the process start and defines the initial setup action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Check Levels of Inventory"
      ],
      "justification": "Direct correspondence to the inventory check step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
      ],
      "justification": "Condition evaluated via action n3 and branch b1; positive guard routes to generating the specified report."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Negative branch guard triggers generation of the above-minimum report."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "Action captures the PO creation step conditioned on the low-inventory report."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Action and end node correspond to the early termination condition."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n10",
        "action:n10",
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked. If the PO is approved, it is printed and released in the system. If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Branch splits based on approval status; positive path prints/releases, negative path reroutes to rework. Condition modeled as action n9 per guidelines."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Direct match for the PO review step."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "AND gateway and converge model simultaneous execution of fund reservation and mailing steps."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Captures the packing slip receipt triggered by fund reservation."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Captures inventory receipt following PO mailing."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Captures invoice receipt step."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Sequential actions model proceeding to and performing the three-way match."
    },
    {
      "refs": [
        "guard:b4->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "XOR branch and positive guard lead to fund release upon successful matching."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Direct match for payment issuance."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Final action, convergence of paths, and end node align with cycle completion and process termination."
    }
  ],
