init(i1)
action(n2, "gather part information from customer including make model and year")
action(n3, "check availability of part in local inventory")
action(n4, "is part available locally")
branch(b1, XOR)
action(n5, "retrieve part from local inventory")
end(e1)
action(n7, "record customer details")
action(n8, "order part from Disuki")
end(e2)
defines(v1, "is part available locally", {true, false})
actor(a_default, "DMS Parts Provision Team", [i1, n2, n3, n4, b1, n5, e1, n7, n8, e2])
precedence(i1, n2)
precedence(n4, b1)
precedence(n5, e1)
