  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the DMS Parts Provision Team, the first step is to gather information about the part from the customer, including the make, model, and year."
      ],
      "justification": "The implicit process start and the first action step directly correspond to i1."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once this information is obtained, the team proceeds to check the availability of the part in the local inventory."
      ],
      "justification": "Direct implementation of the second sequential verification step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the part is found to be available locally,"
      ],
      "justification": "The redundant action step, XOR branch, and positive boolean guard collectively capture the conditional split described in i3."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "it is retrieved from the inventory."
      ],
      "justification": "Faithfully restates the retrieval action on the true branch."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if the part is not available locally, the team records the customer's details."
      ],
      "justification": "Negative guard and recording action implement the false branch condition and immediate follow-up step."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "After retrieving the part from the local inventory, the process comes to an end."
      ],
      "justification": "Structural end node corresponds to the explicit termination statement concluding the true path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "and then orders the part from Disuki."
      ],
      "justification": "Implements the subsequent ordering step on the false branch path."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Once the part is ordered from Disuki, the process comes to an end."
      ],
      "justification": "Structural end node corresponds to the explicit termination statement concluding the false path."
    }
  ],
