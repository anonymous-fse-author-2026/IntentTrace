{
  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Init marks process start; actions n2 and n3 directly implement the two specified UI interactions."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "Action n4 captures the condition query, branch b1 implements the decision split, and action n5 executes the review step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Action n8 faithfully represents the translation requirement check triggered by the lower expense path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Branch b3 splits the translation decision, and action n9 performs the translation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Action n10 correctly implements the fallback confirmation step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Action n11 and branch b4 directly model the review evaluation step and subsequent decision point."
    },
    {
      "refs": [
        "guard:b4->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Guard correctly routes on 'Rejected' status, leading to the exact edit action."
    },
    {
      "refs": [
        "guard:b4->n8"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Guard correctly routes on 'Approved' status back to the translation check node."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Actions n13 and n14 sequentially perform the translation and confirmation as specified."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Action n15 and branch b5 accurately model the final receipts evaluation step."
    },
    {
      "refs": [
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Guard routes on 'Accepted', triggering the expense processing action."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Guard routes on 'Rejected', triggering the report edit action."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Redundant but faithful representations of the terminal 'ending' step described in the closing sentence."
    }
  ],
