@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start;
:Note Vendor Number on Invoice Entry Form;
:Sort by Vendor or Amount?;
:v1: Sort by Vendor or Amount? ({Sort Invoice by vendor, Sort invoice by invoice amount}); <<objectSignal>>
if () then (["v1 = 'Sort Invoice by vendor'"])
:Sort Invoices by Vendor;
else (["v1 = 'Sort invoice by invoice amount'"])
:Sort Invoices by Amount;
endif
:Enter Invoice Data;
:Tick 'Invoice Entered' on Form;
:Place Invoice Batch in Urgent Outbox;
:Set Up Hourly Collection;
:End of Process;
stop
@enduml