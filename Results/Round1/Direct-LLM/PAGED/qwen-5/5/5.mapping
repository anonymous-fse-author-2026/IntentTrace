  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with Low Inventory."
      ],
      "justification": "The opening clause implicitly triggers the process start (init) and directly describes the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, proceed to Create P.R.."
      ],
      "justification": "Directly maps to the sequential step instruction; 'first time' suffix is a benign flow disambiguator."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, move on to Create P.R.,"
      ],
      "justification": "Faithfully reproduces the repeated step instruction with consistent disambiguation."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "followed by Submit P.O.."
      ],
      "justification": "Exact instruction alignment for the purchase order submission step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the P.O. is submitted, proceed to Ship Material."
      ],
      "justification": "Directly captures the material shipping trigger and action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "At this point, check if the shipment is okay."
      ],
      "justification": "The check action and the implied XOR decision node are both supported by this evaluation clause."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is, then proceed to Send Payment."
      ],
      "justification": "Captures the positive conditional path ('Okay') and the resulting payment action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if there are any problems with the shipment, communicate them accordingly."
      ],
      "justification": "Captures the negative conditional path ('Problem') and the corresponding communication step."
    },
    {
      "refs": [
        "action:n9",
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "After checking the shipment status again, if it is okay, proceed to Send Payment."
      ],
      "justification": "Single span supports the re-evaluation check, the XOR split, the positive guard, and the subsequent payment action."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "Otherwise, communicate any shipment problems."
      ],
      "justification": "Maps to the fallback negative guard condition and the problem communication action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, once the payment is sent, the process comes to an end."
      ],
      "justification": "Describes the final state transition, explicitly signals process termination (end), and implies path convergence prior to closure."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "In case there were any shipment problems, make sure to communicate them before proceeding to Ship Material."
      ],
      "justification": "Faithfully captures the exception-handling prerequisite step."
    }
  ],
