{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "The opening clause establishes the process start and explicitly instructs placing an order."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to Check the Customer's Credit Limit"
      ],
      "justification": "Directly implements the credit limit check step."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article. However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "The XOR branch and guards correctly split the flow based on the credit check response, routing to availability check or denial accordingly."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9",
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "After checking the availability, if the response is \"Okay\", proceed to Check the Availability of the Article again. If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Accurately models the secondary availability check decision and its respective outcomes."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13",
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods. However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Correctly captures the article availability decision, mapping 'available' to collection and 'not available' to production."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Faithfully restates the order confirmation step."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "The AND gateway correctly models the simultaneous execution of shipping and invoicing."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Direct match for the payment status check."
    },
    {
      "refs": [
        "guard:b4->n20",
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "Models the positive payment outcome, closing the order and terminating the process."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Routes unpaid orders to a reminder count evaluation, triggering the next decision node."
    },
    {
      "refs": [
        "guard:b5->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Correctly applies the threshold condition to trigger the write-off action."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Accurately sequences the post-write-off closure and process termination."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "reason": "The source text presents sending a reminder as an additional step accompanying the write-off logic. The model incorrectly places it on a mutually exclusive 'No' branch of the reminder count check, altering the intended control flow and conditionality."
    }
  ],
