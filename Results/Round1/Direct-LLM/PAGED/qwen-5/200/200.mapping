    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "The opening unit implicitly triggers the start node and directly describes the initial order placement and customer verification steps."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "The conditional splits the flow at the XOR gateway, routes via the guard matching the exact eligibility value, and executes the inform action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "The alternative guard preserves the exact eligibility value, and the action faithfully reproduces the ERP order creation instruction."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "The terminal structural node correctly captures the explicit end-of-process signal for the ineligible branch."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Open a new order in the ERP system and perform an availability check."
      ],
      "justification": "The action precisely captures the availability check step; the ERP order creation portion is redundantly covered by the previously matched action, which is acceptable."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\""
      ],
      "justification": "The XOR gateway structurally represents the binary availability decision point described in the source."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "The guard accurately translates the negative availability condition, and the action exactly matches the production instruction."
    },
    {
      "refs": [
        "guard:b2->c_prep",
        "action:n8"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process. Prepare the products for shipment."
      ],
      "justification": "The guard captures the positive availability outcome, and the action faithfully restates the preparation step, ignoring the filler announcer phrase."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "The AND gateway correctly models the simultaneous execution directive, and the three actions exactly correspond to the shipping, invoicing, and payment-checking instructions."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "The decision node, guard preserving the exact payment state, and closing action align perfectly with the source clause."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "The guard accurately reflects the negative payment condition, and the action faithfully reproduces the reminder step."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Modeling the condition evaluation as an action step is explicitly permitted; the subsequent gateway, guard preserving the exact threshold, and continuation action all match the source strictly."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "The guard preserves the exact equality threshold, the action matches the legal notification step, and the end node captures the explicit termination signal."
    }
  ],
