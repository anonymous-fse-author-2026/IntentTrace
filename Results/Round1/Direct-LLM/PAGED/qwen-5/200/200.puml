@startuml
!theme plain
|a_default| Default
|a_default|
start
:Place Order;
:Check Customer Eligibility;
:v1: Check Customer Eligibility ({not eligible to order, eligible to order}); <<objectSignal>>
if () then ([v1 = 'not eligible to order'])
:Inform Ineligible Customer;
:End Process - Ineligible;
stop
else ([v1 = 'eligible to order'])
:Open New Order in ERP System;
:Perform Availability Check;
:v2: Perform Availability Check ({available, not available}); <<objectSignal>>
if () then ([v2 = 'not available'])
:Start Producing Missing Parts;
else ([v2 = 'available'])
->;
endif
:Prepare Products for Shipment;
split
:Ship Products;
split again
:Send Invoice;
split again
:Check Payment Status;
end split
:v3: Check Payment Status ({payment is received, payment is not received}); <<objectSignal>>
if () then ([v3 = 'payment is received'])
:Close Order - Payment Received;
stop
else ([v3 = 'payment is not received'])
:Send Payment Reminder;
:Check Number of Reminders;
:v4: Check Number of Reminders ({less than 3, equal to 3}); <<objectSignal>>
if () then ([v4 = 'less than 3'])
:Continue Process;
else ([v4 = 'equal to 3'])
:Inform Lawyer;
stop
endif
endif
endif
@enduml