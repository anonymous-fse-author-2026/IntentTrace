  "input_elements": [
    {
      "id": "i1",
      "content": "the process begins with receiving an order request."
    },
    {
      "id": "i2",
      "content": "After that, the order is registered and evaluated."
    },
    {
      "id": "i3",
      "content": "If the evaluation result is \"NOK\", then the order is considered as \"NOK\" and the process comes to an end."
    },
    {
      "id": "i4",
      "content": "if the evaluation result is \"ok\", then the installation process takes place."
    },
    {
      "id": "i5",
      "content": "If the installation is not successful, the order is considered as \"NOK\" and the process ends."
    },
    {
      "id": "i6",
      "content": "if the installation is successful, the next step is to check the installation."
    },
    {
      "id": "i7",
      "content": "Once the installation is verified, the billing is prepared."
    },
    {
      "id": "i8",
      "content": "the order is marked as \"ok\" and the process is completed."
    }
