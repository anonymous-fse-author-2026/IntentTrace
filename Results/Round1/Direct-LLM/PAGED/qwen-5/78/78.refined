init(i1)
action(n1, "check if the order has been received")
action(n2, "check sum of order")
branch(b1, XOR)
action(n3, "compute 4% discount")
action(n4, "compute 3% discount")
action(n5, "compute 2% discount")
converge(c1)
action(n6, "continue with the process")
action(n7, "create the bill")
end(e1)
defines(v1, "order sum", {[0-]})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, c1, n6, n7, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n4)
precedence(b1, n5)
precedence(b1, c1)
precedence(n3, n6)
precedence(n4, c1)
precedence(n5, c1)
precedence(c1, n2)
precedence(n6, n7)
precedence(n7, e1)
guard(b1, n3, v1 > 2000)
guard(b1, n4, v1 >= 1000 and v1 <= 1500)
guard(b1, n5, v1 >= 500 and v1 < 1000)
guard(b1, c1, v1 < 500)
label(n1, n2, "Start")
label(n3, n6, "Bill")
label(n4, c1, "Recheck")
label(n5, c1, "Recheck")
label(b1, c1, "Continue")