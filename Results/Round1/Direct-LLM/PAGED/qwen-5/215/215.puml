@startuml
!theme plain
|a_default| Default
|a_supplier| Supplier
|a_default|
start
:start with Resupply Cycle Triggered;
:check Inventory Level;
:Inventory level is at or below the minimum;
:v1: Inventory Level ({Inventory Level is at or below the minimum, Inventory Level is above the minimum}); <<objectSignal>>
if () then ([v1 = 'Inventory Level is at or below the minimum'] Inventory Level is at or below the minimum)
:Create Purchase Order;
:Review Purchase Order;
:Purchase Order is approved;
:v2: Purchase Order Approval ({approved, rejected}); <<objectSignal>>
if () then ([v2 = 'approved'] approved)
:Reserve funds for purchase;
:Send Order to Suppliers;
split
|a_supplier|
:Supplier sends packing slip;
|a_default|
:record packing slip;
split again
|a_supplier|
:Supplier sends invoice;
|a_default|
:record invoice;
end split
:Release reserved funds and issue payment to supplier;
:End process after payment is issued;
stop
else ([v2 = 'rejected'] rejected)
:Rework the order;
:Review Purchase Order;
endif
else ([v1 = 'Inventory Level is above the minimum'] Inventory Level is above the minimum)
:End process;
stop
endif
@enduml