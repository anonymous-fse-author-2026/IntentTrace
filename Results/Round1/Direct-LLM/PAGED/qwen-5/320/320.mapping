{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially,"
      ],
      "justification": "The opening context establishes the process scope and triggers the initialization step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
      "justification": "The conditional clause drives the initial XOR split and its corresponding boolean outcome guards."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\""
      ],
      "justification": "Direct implementation of the action taken when the option is selected."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Covers both sequential actions mandated when the option remains unselected."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule,"
      ],
      "justification": "Explicitly performs the schedule validation step before proceeding."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory."
      ],
      "justification": "Models the satisfactoriness verification as an action node feeding into a decision gateway."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Captures both identical negative-outcome paths; the model uses a single reusable action node for this redundant source instruction."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\"."
      ],
      "justification": "Captures both identical negative-outcome paths; the model uses a single reusable action node for this redundant source instruction."
    },
    {
      "refs": [
        "guard:b2->c3",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "The positive-satisfactory path converges parallel flows and proceeds to ticket creation."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Implements the secondary negative-check decision and its prescribed indication outcome."
    },
    {
      "refs": [
        "guard:b3->c3"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "The secondary positive-check path merges back to the existing ticket-writing step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Directly executes the post-creation validation instruction."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Models the first approval verification step and subsequent branching."
    },
    {
      "refs": [
        "guard:b4->e1"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "The first rejection path correctly terminates the process."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "The first approval path triggers the next validation cycle."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Implements the second approval verification cycle accurately."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Implements the third approval verification cycle accurately."
    },
    {
      "refs": [
        "guard:b6->e3"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "The final approval outcome correctly terminates the process."
    }
  ],
