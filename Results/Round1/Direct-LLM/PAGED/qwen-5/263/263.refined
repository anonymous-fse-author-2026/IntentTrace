end(e4)
converge(c1)
branch(b4, AND)
defines(v1, "Is the informational meeting successful?", {true, false})
defines(v2, "Is the review successful?", {true, false})
defines(v3, "Is the rebuild approved?", {true, false})
defines(v_sb, "Is the storyboard successful?", {true, false})
defines(v_appr, "Is the approval complete?", {true, false})
actor(a_customer, "Customer", [i1, n1, n2, b1, n3, b_sb, n4, n6, n10, n11, b_appr, n12, e1, e2])
actor(a_webdesign, "Web Design Team", [c1, b4, n5, n7, n8, n9, b2, n13, n14, b3, n15, n16, n17, e3, e4])
