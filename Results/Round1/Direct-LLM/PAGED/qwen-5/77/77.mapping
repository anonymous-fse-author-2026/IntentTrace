      ],
      "justification": "Captures the re-evaluation condition, branching logic, and follow-up presentation step."
    },
    {
      "refs": [
        "action:n25",
        "guard:b8->n25"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
