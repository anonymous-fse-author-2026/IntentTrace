{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To start,"
      ],
      "justification": "Explicit temporal marker initiating the process flow."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "join the team and agree on the team's domain."
      ],
      "justification": "Direct correspondence to the first procedural step; minor typographical variation in possessive does not alter meaning."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "create a process model and check it."
      ],
      "justification": "Exact reproduction of the model creation and verification step."
    },
    {
      "refs": [
        "action:n4",
        "label:n3->n4"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\""
      ],
      "justification": "Captures the first quality gate condition, the XOR decision node it triggers, and the labeling of the decision path."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "then assign negative points."
      ],
      "justification": "Maps the penalty action to the affirmative outcome of the first quality check."
    },
    {
      "refs": [
        "action:n6",
        "label:n5->n6"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\""
      ],
      "justification": "Represents the repeated quality evaluation condition and its associated branch point."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "assign negative points again."
      ],
      "justification": "Corresponds to the repeated penalty action contingent on the second failing check."
    },
    {
      "refs": [
        "action:n8",
        "guard:b1->n9",
        "guard:b2->n8",
        "label:n8->c1"
      ],
      "verbatim_texts": [
        "you can continue with it."
      ],
      "justification": "Models the successful resolution path from the quality checks, including routing guards and the implicit merge back into the main flow."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If there are any issues,"
      ],
      "justification": "Direct match for the issue-detection decision point."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Faithfully reproduces the remediation action and scope extension."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points,"
      ],
      "justification": "Captures the conditional requirement for further process validation."
    },
    {
      "refs": [
        "action:n13",
        "guard:b4->n13"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Aligns with the default continuation path when the check-condition is met."
    },
    {
      "refs": [
        "action:n14",
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study,"
      ],
      "justification": "Matches the alternative conditional branch for domain analysis."
    },
    {
      "refs": [
        "action:n15",
        "guard:b5->n15"
      ],
      "verbatim_texts": [
        "assign roles in the team."
      ],
