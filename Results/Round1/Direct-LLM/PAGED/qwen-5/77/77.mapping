      "justification": "Models the approval condition and the immediate subsequent continuation step."
    },
    {
      "refs": [
        "action:n17",
        "action:n18",
        "guard:b6->n17",
        "guard:b6->n18"
      ],
      "verbatim_texts": [
        "perform work according to your assigned role."
      ],
