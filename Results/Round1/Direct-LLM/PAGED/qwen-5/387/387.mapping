{
  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "init:i1 captures the process start marker; action:n2 and action:n3 faithfully reproduce the two sequential operations described in the opening unit."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "branch:b1 represents the XOR decision point; guard:b1->n5 accurately encodes the threshold condition; action:n5 matches the prescribed task."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "guard:b1->n6 captures the alternative threshold; action:n6 and end:e1 jointly model the stated termination clause with equivalent logic."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Directly implements the review step specified in the source."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "branch:b2 models the status decision; guard:b2->n9 encodes the rejection condition; action:n9 executes the rework instruction."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "guard:b2->n13 captures the approval condition; action:n13 performs the fund reservation."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Captures the second conjunctive action; the first part (reserve funds) is already covered by the preceding conditional path."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "At the same time"
      ],
      "justification": "branch:b4 (AND gateway) correctly models the simultaneous execution directive; action:n15 and action:n16 implement the two parallel receipt tasks."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "branch:b4 (AND gateway) correctly models the simultaneous execution directive; action:n15 and action:n16 implement the two parallel receipt tasks."
    },
    {
      "refs": [
        "action:n17",
        "action:n19"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "action:n17 records the slip; action:n19 and end:e2 faithfully model the subsequent process termination."
    },
    {
      "refs": [
        "action:n18",
        "action:n20"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "action:n18 records the invoice; action:n20 and end:e3 faithfully model the subsequent process termination."
    }
