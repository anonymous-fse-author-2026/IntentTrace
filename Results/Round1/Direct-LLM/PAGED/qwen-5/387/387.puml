@startuml
!theme plain
|a_default| Default
|a_default|
start
:trigger the resupply cycle;
:check the inventory level;
:v1: is inventory level at or below minimum ({at_or_below_minimum, above_minimum}); <<objectSignal>>
if () then ([v1 = 'at_or_below_minimum'])
:create a purchase order;
repeat :;
:review the purchase order;
:v2: is purchase status rejected ({rejected, approved}); <<objectSignal>>
backward:rework the purchase order;
repeat while () is ([v2 = 'rejected']) not ([v2 = 'approved'])
:reserve the funds;
:send order to supplier;
split
:receive the packing slip;
:record the packing slip;
:process ends after recording packing slip;
stop
split again
:receive the invoice;
:record the invoice;
:process ends after recording invoice;
stop
end split
else ([v1 = 'above_minimum'])
:process ends because inventory above minimum;
stop
endif
@enduml