@startuml
!theme plain
|a_buyer| Buyer
|a_buyer|
start
:choose a book;
:v1: main choice ({details, new_copies, used_copies}); <<objectSignal>>
switch ()
case ([v1 = 'details'])
:view: book details;
:v2: details choice ({select_copy, view_new}); <<objectSignal>>
if () then ([v2 = 'select_copy'])
:select a copy;
else ([v2 = 'view_new'])
->;
endif
stop
case ([v1 = 'new_copies'])
:view: new copies;
stop
case ([v1 = 'used_copies'])
:view: used copies;
:evaluate and select a copy from the list;
endswitch
@enduml