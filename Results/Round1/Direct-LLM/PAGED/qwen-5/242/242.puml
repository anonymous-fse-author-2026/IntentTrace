@startuml
!theme plain
|a_customer| Customer
|a_we| We
|a_we|
start
:Request for Quotation;
|a_customer|
:Submit RFQ;
|a_we|
:Submit Quotation;
:Receive Quotation;
:Submit Purchase Order;
:v_path: Path ({Goods, Invoice}); <<objectSignal>>
fork
if () then ([v_path = 'Goods'])
:Send Goods;
stop
endif
fork again
if () then ([v_path = 'Invoice'])
:Send Invoice;
stop
endif
end fork
@enduml