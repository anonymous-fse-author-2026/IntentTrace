    {
      "id": "i1",
      "content": "The process starts with the Request for Quotation"
    },
    {
      "id": "i2",
      "content": "followed by the Customer submitting the RFQ."
    },
    {
      "id": "i3",
      "content": "After the RFQ is submitted, the Quotation is also submitted."
    },
    {
      "id": "i4",
      "content": "Once the Quotation is submitted, we receive it."
    },
    {
      "id": "i5",
      "content": "Upon receiving the Quotation, we then submit the Purchase Order."
    },
    {
      "id": "i6",
      "content": "Simultaneously"
    },
    {
      "id": "i7",
      "content": "sending the Goods and sending the Invoice."
    },
    {
      "id": "i8",
      "content": "After the Goods are sent, we mark them as sent."
    },
    {
      "id": "i9",
      "content": "Similarly, after the Invoice is sent, we mark it as sent."
    },
    {
      "id": "i10",
      "content": "The process ends when the Goods are sent or when the Invoice is sent."
