init(i1)
action(n1, "Start: Initiate New Resupply Cycle")
action(n2, "Check Inventory Levels")
branch(b1, XOR)
action(n3, "Generate Equal to or below minimum Report")
action(n4, "Generate Above Minimum Report")
action(n5, "End: Process Ends (Above Minimum)")
end(e1)
action(n6, "Create Purchase Order (PO)")
action(n7, "Review PO")
branch(b2, XOR)
action(n8, "Print and Release PO")
action(n9, "Rework PO")
action(n10, "Reserve Funds for Released POs")
action(n11, "Mail POs to Supplier")
action(n12, "Receive Packing Slip")
action(n13, "Receive Inventory")
action(n14, "Proceed to Receive Invoice")
action(n15, "Proceed to Receive Packing Slip")
action(n16, "Receive Invoice")
action(n17, "Three-way Match")
branch(b5, XOR)
action(n18, "Release Funds")
action(n19, "Issue Payment")
action(n20, "End: Resupply Cycle Complete")
end(e2)
branch(b6, AND)
converge(c0)
converge(c1)
action(n21, "Match Unsuccessful")
end(e3)
defines(v1, "Check Inventory Levels", {"Inventory <= Minimum", "Inventory > Minimum"})
defines(v2, "Review PO", {"Approved", "Rejected"})
defines(v5, "Three-way Match", {"Successful Match", "Failed Match"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, e1, n6, n7, b2, n8, n9, n10, n11, n12, n13, n14, n15, n16, n17, b5, n18, n19, n20, e2, b6, c0, c1, n21, e3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
