@startuml
!theme plain
|a_default| Default
|a_default|
start
:enter restaurant and ask for menu;
:check offers;
split
:order a glass of red wine;
split again
:order a salad;
end split
:wait for order to arrive and enjoy salad and wine;
:ask if you would like dessert (tiramisu);
:v1: ask if you would like dessert (tiramisu) ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:order tiramisu;
:wait for tiramisu to be served and enjoy it;
else ([v1 = 'No'])
:decline dessert;
endif
:ask for the bill and pay it;
:leave the restaurant;
stop
@enduml