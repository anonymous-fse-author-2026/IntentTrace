    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Action restates the completeness verification, and the XOR branch captures the subsequent split."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Guard identifies the complete state, and action executes the recording step with identical data requirements."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Guard identifies the incomplete state, and action executes the required phone call."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Action faithfully restates the post-call data completion and recording step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Action preserves the schedule, items, and destination exactly, with minor syntactic reordering."
    },
    {
      "refs": [
        "action:n10",
