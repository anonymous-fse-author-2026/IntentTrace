      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "init captures the process trigger, while action:n2 faithfully executes the mailbox emptying instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "Action performs the verification check, and the XOR branch models the resulting decision point."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
