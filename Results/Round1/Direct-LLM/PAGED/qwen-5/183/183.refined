init(i1)
action(n1, "start")
action(n2, "Add image description and upload image")
converge(c1)
branch(b1, XOR)
end(e1)
action(n5, "Try again?")
branch(b2, XOR)
end(e2)
defines(v1, "Was image upload successful?", {"Yes", "No"})
defines(v2, "Try again?", {"No", "Yes"})
actor(a_default, "Default", [i1, n1, n2, c1, b1, e1, n5, b2, e2])
precedence(i1, n1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, b1)
precedence(b1, e1)
precedence(b1, n5)
precedence(n5, b2)
precedence(b2, e2)
precedence(b2, c1)
guard(b1, e1, v1 = 'Yes')
guard(b1, n5, v1 = 'No')
guard(b2, e2, v2 = 'No')
guard(b2, c1, v2 = 'Yes')