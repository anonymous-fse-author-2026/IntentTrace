@startuml
!theme plain
|a_default| Default
|a_default|
start
:start customer on website;
:search desired item;
:click desired item;
:choose action from desired item page;
:v1: choose action from desired item page ({View quantity, Enter quantity}); <<objectSignal>>
if () then (["v1 = 'View quantity'"])
:view quantity amount;
else (["v1 = 'Enter quantity'"])
:enter quantity amount;
endif
:return to desired item page;
:add item to cart;
:choose action after item added;
:v2: choose action after item added ({Continue shopping, Check out}); <<objectSignal>>
if () then (["v2 = 'Continue shopping'"])
:continue shopping;
:return to desired item page;
else (["v2 = 'Check out'"])
:check out current item;
:proceed to check out;
:confirm item;
:choose action after confirm;
:v3: choose action after confirm ({Proceed to check out, Recalculate shipping, Enter coupon code}); <<objectSignal>>
switch ()
case (["v3 = 'Proceed to check out'"])
:proceed to check out page;
case (["v3 = 'Recalculate shipping'"])
:recalculate shipping;
case (["v3 = 'Enter coupon code'"])
:enter coupon code;
endswitch
:enter check-out page;
:enter billing information;
:end process;
stop
endif
@enduml