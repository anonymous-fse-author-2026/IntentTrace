      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "The structural init node and the action step jointly capture the process trigger and the first required task."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "The action and branch model the decision checkpoint, while the guard explicitly encodes the 'no candidate' condition (v1 = false)."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "advertise the vacancy"
      ],
      "justification": "Exact textual alignment with the prescribed action for the negative condition path."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available"
      ],
      "justification": "Models the complementary positive path of the initial decision, directing flow forward when a candidate is found."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available"
      ],
      "justification": "Replicates the second decision checkpoint and correctly assigns the 'still no candidate' guard (v2 = false) to the retry path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "advertise the vacancy again"
      ],
      "justification": "Directly implements the repeated advertising step specified in the source."
    },
    {
      "refs": [
        "guard:b2->c1",
        "action:n5",
        "guard:b3->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available"
      ],
      "justification": "Collectively models the final eligibility check, its positive routing (v3 = true), and the structural convergence point that reunites the flow before selection."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "proceed with selecting the appropriate applicant"
      ],
      "justification": "Faithfully restates the selection step with identical target and scope."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed"
      ],
      "justification": "Accurately captures the appointment milestone described in the source."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the process comes to an end"
      ],
      "justification": "The action and structural end node jointly satisfy the explicit termination statement."
    }
