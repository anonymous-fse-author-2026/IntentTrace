  "input_elements": [
    {
      "id": "i1",
      "content": "Passengers should start the process by undergoing immigration checks,"
    },
    {
      "id": "i2",
      "content": "and then they should select the method for exit control checks."
    },
    {
      "id": "i3",
      "content": "If the passenger chooses to use biometrics, they should undergo a check using biometrics."
    },
    {
      "id": "i4",
      "content": "However, if the passenger prefers to use ID documents, they should undergo checks using identity documents."
    },
    {
      "id": "i5",
      "content": "After the exit control checks,"
    },
    {
      "id": "i6",
      "content": "if the passenger is denied permission,"
    },
    {
      "id": "i7",
      "content": "they should leave the area."
    },
    {
      "id": "i8",
      "content": "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
    },
    {
      "id": "i9",
      "content": "If the exit control check outcome is unsuccessful,"
    },
    {
      "id": "i10",
      "content": "the passenger should leave the area and the process ends."
    },
    {
      "id": "i11",
      "content": "the process ends."
    },
    {
      "id": "i12",
      "content": "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
    }
  ]
}