init(i1)
converge(c1)
action(n2, "Add image description and upload image")
branch(b1, XOR)
end(e1)
branch(b2, XOR)
end(e2)
defines(v1, "Was image upload successful?", {"Yes", "No"})
defines(v2, "Try again?", {"No", "Yes"})
actor(a_default, "Default", [i1, c1, n2, b1, e1, b2, e2])
precedence(i1, c1)
precedence(c1, n2)
precedence(n2, b1)
precedence(b1, e1)
precedence(b1, b2)
precedence(b2, c1)
precedence(b2, e2)
guard(b1, e1, v1 = 'Yes')
guard(b1, b2, v1 = 'No')
guard(b2, c1, v2 = 'Yes')
guard(b2, e2, v2 = 'No')