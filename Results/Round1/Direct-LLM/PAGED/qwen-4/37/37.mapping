      ],
      "justification": "Captures the transition to the second decision point regarding article availability."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "\"Okay\""
      ],
      "justification": "Applies the positive condition to proceed to the second availability check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed to Check the Availability of the Article again."
      ],
      "justification": "Directly reproduces the repeated availability check step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the Article is"
      ],
