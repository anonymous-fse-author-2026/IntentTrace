  "mutations": [
    {
      "refs": [
        "guard:b5->n21"
      ],
      "verbatim_texts": [
        "is greater than or equal to 3"
      ],
      "reason": "The guard abstracts the explicit numeric threshold and operator to a generic boolean `v5 = 'Yes'`, dropping the required value/range specified in the source."
    },
    {
      "refs": [
        "guard:b5->n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "reason": "The guard imposes a `v5 = 'No'` condition that contradicts the source text, which states the reminder is sent 'Additionally' (unconditionally or concurrently), not exclusively on a negative outcome."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "reason": "Gateway type is set to OR, which models an exclusive/inclusive choice. The source phrase 'Additionally' implies concurrent execution or sequential addition (AND behavior), altering the process logic."
    }
  ],
