init(i1)
action(n1, "Start reviewing the incoming CV")
action(n2, "Decision to send a negative email")
branch(b1, XOR)
end(e1)
action(n4, "Schedule an interview with the candidate")
action(n5, "Conduct the interview")
end(e2)
defines(v1, "Decision", {"Send negative email", "Invite candidate"})
actor(a_default, "Default", [i1, n1, n2, b1, e1, n4, n5, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, e1)
precedence(b1, n4)
precedence(n4, n5)
precedence(n5, e2)
guard(b1, e1, v1 = 'Send negative email')
guard(b1, n4, v1 = 'Invite candidate')