{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For MyCorp, the process begins",
        "by entering expenses"
      ],
      "justification": "The opening clause implicitly triggers the start node, while the immediate continuation specifies the first concrete action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After entering expenses, the next step is to generate a spreadsheet."
      ],
      "justification": "Directly maps to the sequential step following expense entry."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "Once the spreadsheet is generated, the request can be approved or disapproved."
      ],
      "justification": "Describes the decision point that splits execution into two exclusive outcomes."
    },
    {
      "refs": [
        "guard:b1->c1",
        "label:b1->c1"
      ],
      "verbatim_texts": [
        "If the request is not approved, the process goes back to entering expenses."
      ],
      "justification": "Captures the negative condition, its labeled branch, and the implicit structural join point before looping back."
    },
    {
      "refs": [
        "guard:b1->n5",
        "label:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the request is approved, the expenses can be paid out."
      ],
      "justification": "Faithfully maps the positive condition, its outcome label, and the corresponding payout action."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Explicitly states the second decision/check point in the flow."
    },
    {
      "refs": [
        "guard:b2->c1",
        "label:b2->c1"
      ],
      "verbatim_texts": [
        "If it is not approved, the process goes back to entering expenses."
      ],
      "justification": "Captures the second negative condition and its labeled path."
    },
    {
      "refs": [
        "guard:b2->n8",
        "label:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if it is approved, the expenses can be paid out."
      ],
      "justification": "Maps the second positive condition, its outcome label, and the resulting payout action."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, after the expenses are paid out, the process comes to an end."
      ],
      "justification": "Explicitly marks the termination of the process."
    }
  ],
