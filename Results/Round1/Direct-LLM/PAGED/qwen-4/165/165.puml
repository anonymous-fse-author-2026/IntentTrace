@startuml
!theme plain
|a_default| DMS Parts Provision Team
|a_default|
start
:gather information about the part from the customer (make model year);
:check availability of the part in local inventory;
:v1: part_availability ({Available, Not Available}); <<objectSignal>>
if () then ([v1 = "Available"])
:retrieve part from local inventory;
:end process;
stop
else ([v1 = "Not Available"])
:record customer details;
:order part from Disuki;
:end process;
stop
endif
@enduml