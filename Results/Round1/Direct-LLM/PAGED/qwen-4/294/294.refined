init(i1)
action(n1, "review cv")
branch(b1, XOR)
action(n3, "send negative email")
end(e1)
action(n5, "invite candidate and schedule interview")
action(n6, "conduct interview")
end(e2)
defines(v1, "decision on cv review", {"Negative decision", "Positive decision"})
actor(a_default, "Default", [i1, n1, b1, n3, e1, n5, n6, e2])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n3)
precedence(n3, e1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, e2)
guard(b1, n3, v1 = 'Negative decision')
guard(b1, n5, v1 = 'Positive decision')