@startuml
!theme plain
|a_applicant| the applicant
|a_applicant|
start
:write a letter;
:obtain the written letter;
:check if the applicant is a member;
:v1: check if the applicant is a member ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:obtain a second letter;
:check again if the applicant is a member;
:v2: check again if the applicant is a member ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'Yes'])
:obtain a second letter;
:pay the fee;
:receive a card;
stop
else ([v2 = 'No'])
stop
endif
else ([v1 = 'No'])
stop
endif
@enduml