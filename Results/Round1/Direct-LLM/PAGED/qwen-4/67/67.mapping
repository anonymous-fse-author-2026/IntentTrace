{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "The opening clause explicitly starts the process and defines the first action step."
    },
    {
      "refs": [
        "action:n3",
        "action:n4",
        "guard:b1->n4",
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "The conditional introduces an exclusive choice (branch) and its question-form representation (action n3). The positive arm triggers the request action, encoded by the true/false guards."
    },
    {
      "refs": [
        "action:n5",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After the exception is approved, the next step is course enrollment, followed by seminar group enrollment."
      ],
      "justification": "The post-exception approval state re-converges the flow. The subsequent sequential steps are captured by the three actions."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the seminar group enrollment is completed, the homework assignment can be started."
      ],
      "justification": "Directly captures the initiation of the homework assignment phase."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After working on the homework, it should be turned in."
      ],
      "justification": "Faithfully restates the submission step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated, and the process can continue."
      ],
      "justification": "Matches the evaluation step described in the source."
    },
    {
      "refs": [
        "action:n11",
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Models the loop condition as a question/action, creates the XOR branch, and routes the 'not last' case via the false guard to reassignment."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if it was the last homework, the process can continue."
      ],
      "justification": "Routes the 'last homework' condition via the true guard to continuation, with a converge handling the loop exit rejoin."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "The concurrency marker 'at the same time' justifies the AND branch, splitting into the two parallel actions."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "After signing up for the exam, it should be attended."
      ],
      "justification": "Captures the sequential exam preparation steps exactly."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Once the exam is attended, it will be evaluated."
      ],
      "justification": "Directly matches the post-exam evaluation step."
    },
    {
      "refs": [
        "action:n19",
        "guard:b3->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue."
      ],
      "justification": "Models the pass/fail check as a question/action and branch. The true guard leads to course completion and process termination."
    },
    {
      "refs": [
        "guard:b3->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Routes the failure case via the false guard to re-registration, with converge nodes managing the retry loop re-entry."
    }
  ],
