  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "Structural start and primary action faithfully capture the initialization and metadata entry instruction."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After entering the metadata, proceed to the IN-Patient step."
      ],
      "justification": "Action directly implements the transition to the IN-Patient step."
    },
    {
      "refs": [
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: send data to suppliers and create a claim."
      ],
      "justification": "AND branch correctly models simultaneous execution; actions faithfully perform both listed substeps."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the data is sent to suppliers, extract the data from the suppliers and transfer it to the doctor's phone."
      ],
      "justification": "Convergence node marks the rejoin after parallel execution; subsequent actions match extraction and transfer."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, confirm the GOP and the process will come to an end."
      ],
      "justification": "Actions and structural end node capture the GOP confirmation and explicit process termination."
    },
    {
      "refs": [
        "action:n5",
        "action:n10",
        "action:n18",
        "action:n19",
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "Next, register the case and handle the claim."
      ],
      "justification": "Multiple redundant action nodes faithfully restate the case registration and claim handling sequence."
    },
    {
      "refs": [
        "action:n12",
        "action:n30",
        "action:n31"
      ],
      "verbatim_texts": [
        "Create a claim and handle the claim accordingly."
      ],
      "justification": "Actions correspond to the secondary claim creation and handling instruction."
    },
    {
      "refs": [
        "action:n15",
        "action:n16",
        "action:n27"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status."
      ],
      "justification": "Nodes cover data extraction and the conditional record entry/status confirmation option."
    },
    {
      "refs": [
        "action:n13",
        "action:n20",
        "action:n25",
        "action:n28",
        "action:n32"
      ],
      "verbatim_texts": [
        "Register the case, handle the claim, and then receive the payment."
      ],
      "justification": "Payment receipt actions align with the stated sequence following registration and handling steps."
    },
    {
      "refs": [
        "action:n17",
        "action:n22"
      ],
      "verbatim_texts": [
        "Enter the data on the patient's record or confirm the IN-Patient status, and then send the data back to the suppliers."
      ],
      "justification": "Actions faithfully execute the return of data to suppliers following record/status steps."
    },
    {
      "refs": [
        "action:n14",
        "action:n21",
        "action:n26",
        "action:n29",
        "action:n33"
      ],
      "verbatim_texts": [
        "Finally, receive the payment and conclude the process."
      ],
      "justification": "Termination actions redundantly but accurately reflect concluding the process after final payment receipt."
    }
  ],
