@startuml
!theme plain
|a_default| Default
|a_default|
start
:Initiate Resupply Cycle for ACME Company;
:Check Inventory Level;
:v1: Check Inventory Level ({Above Minimum, Below Minimum}); <<objectSignal>>
if () then (["v1 = 'Below Minimum'"])
:Create Purchase Order;
repeat :Review Purchase Order;
:v2: Review Purchase Order ({Accepted, Rejected}); <<objectSignal>>
backward:Rework Purchase Order;
repeat while () is (["v2 = 'Rejected'"]) not (["v2 = 'Accepted'"])
:Reserve Funds for Payment;
:Send Purchase Order to Supplier;
split
:Receive Packing Slip;
:Record Packing Slip;
split again
:Receive Invoice;
:Record Invoice;
end split
:Release Funds for Payment;
:Issue Payment to Supplier;
else (["v1 = 'Above Minimum'"])
->;
endif
:End of Process;
stop
@enduml