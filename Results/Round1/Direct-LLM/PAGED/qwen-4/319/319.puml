@startuml
!theme plain
|a_default| Default
|a_default|
start
:choose a book;
:v1: initial_choice ({details, new_copies, used_copies}); <<objectSignal>>
switch ()
case ([v1 = 'details'])
:view: book details;
:v2: details_follow_up ({select_copy, new_copies}); <<objectSignal>>
if () then ([v2 = 'select_copy'])
:select a copy;
stop
else ([v2 = 'new_copies'])
:view: new copies;
endif
case ([v1 = 'new_copies'])
:view: new copies;
case ([v1 = 'used_copies'])
:view: used copies;
:evaluate and select a copy from the list;
endswitch
stop
@enduml