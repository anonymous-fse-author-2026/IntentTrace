init(i1)
action(n1, "Start process in Admin Office")
action(n2, "Has process started")
action(n3, "Verify completeness of invoices")
action(n5, "Are invoices marked as Uncompleted")
branch(b2, XOR)
action(n6, "Return invoices to client via postal mail")
action(n7, "Receive completed invoices")
action(n8, "Mark relevant box on invoice entry form")
action(n9, "Has process been completed")
end(e3)
converge(c1)
defines(v1, "Has process started", {"Yes", "No"})
defines(v2, "Are invoices marked as Uncompleted", {"Uncompleted", "Completed"})
defines(v3, "Has process been completed", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, n3, n5, b2, n6, n7, n8, n9, e3, c1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n5)
precedence(n5, b2)
precedence(b2, n6)
precedence(n6, n7)
precedence(n7, c1)
precedence(b2, c1)
precedence(c1, n8)
precedence(n8, n9)
precedence(n9, e3)
guard(b2, n6, v2 = 'Uncompleted')
guard(b2, c1, v2 = 'Completed')