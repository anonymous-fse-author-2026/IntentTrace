    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For developers practicing BPMN execution TDD, the first step is to understand the BPMN Model."
      ],
      "justification": "The opening clause implicitly initiates the process and directly states the first action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, they should write a failing test."
      ],
      "justification": "Direct correspondence to the second sequential step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "To make the test pass, they need to extend BPMN/mocks."
      ],
      "justification": "Faithful restatement of the third step; minor punctuation variation does not change meaning."
    },
    {
      "refs": [
        "guard:b1->b2"
      ],
      "verbatim_texts": [
        "Once the test is green,"
      ],
      "justification": "The branch models the conditional fork point; the guard captures the positive outcome directing flow forward."
    },
    {
      "refs": [
        "guard:b1->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the test is not green, they should upgrade the test level."
      ],
      "justification": "Guard captures the negative test outcome; action matches the specified remediation step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "they should check if the level satisfies the project requirements."
      ],
      "justification": "Branch accurately models the decision point described in the text."
    },
    {
      "refs": [
        "guard:b2->e1"
      ],
      "verbatim_texts": [
        "If it does, the process ends."
      ],
      "justification": "Guard captures the positive requirement validation; end node correctly terminates the process path."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If not, they should continue the process."
      ],
      "justification": "Guard captures the negative requirement validation; action matches the continuation directive."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "After that, they need to check if the level satisfies the project requirements again."
      ],
      "justification": "Branch correctly models the repeated validation decision following the upgrade step."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If not, they should upgrade the test level once more."
      ],
      "justification": "Guard captures the failed secondary check; action matches the final escalation instruction."
    }
  ],
