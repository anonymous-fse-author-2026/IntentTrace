{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To begin the process,"
      ],
      "justification": "Explicit start signal maps directly to the init node."
    },
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "start by placing an order"
      ],
      "justification": "Action faithfully restates the first procedural step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "check the customer."
      ],
      "justification": "Direct action mapping for the customer verification step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them.",
        "otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "XOR branch structurally captures the binary eligibility decision."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Action and guard jointly implement the negative eligibility path and its condition."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Action and guard jointly implement the positive eligibility path and its condition."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Structural end node aligns with the explicit termination clause on the ineligible path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "and perform an availability check."
      ],
      "justification": "Direct action mapping for the inventory verification step."
    },
    {
      "refs": [
        "guard:b2->c_prep"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\"."
      ],
      "justification": "Branch and default guard capture the availability query and its affirmative outcome."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "Action and guard jointly implement the unavailable product path and its condition."
    },
    {
      "refs": [
        "converge:c_prep"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Converge node structurally handles the flow resuming/continuing after the availability decision."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Direct action mapping for the preparation step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n13"
      ],
      "verbatim_texts": [
        "ship the products and send the invoice while checking for payment."
      ],
      "justification": "AND gateway and three concurrent actions split the parallel shipping, invoicing, and payment-checking tasks."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order.",
        "If the payment is not received, send a reminder."
      ],
      "justification": "XOR branch structurally captures the binary payment outcome decision."
    },
    {
      "refs": [
        "action:n14",
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Action and guard jointly implement the successful payment path and its condition."
    },
    {
      "refs": [
        "action:n15",
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Action and guard jointly implement the failed payment path and its condition."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3,"
      ],
      "justification": "Check action, branch, and guard jointly model the reminder count evaluation and loop condition."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Action faithfully restates the loop continuation instruction."
    },
    {
      "refs": [
        "action:n18",
        "guard:b4->n18"
      ],
      "verbatim_texts": [
        "inform the lawyer and end the process."
      ],
      "justification": "Action, threshold guard, and end node collectively cover the final escalation, maximum-reminder condition, and termination."
    }
  ],
