@startuml
!theme plain
|a_default| Default
|a_miranda| Miranda
|a_charles| Charles
|a_default|
start
:start the process at 8:00 am;
:empty the mailbox;
:is the mailbox empty?;
:v1: is the mailbox empty? ({true, false}); <<objectSignal>>
if () then ([v1 = false] No)
:continue the process;
:is the mailbox empty?;
:v2: is the mailbox empty? ({true, false}); <<objectSignal>>
if () then ([v2 = false] No)
:continue the process;
:is the information complete?;
:v3: is the information complete? ({true, false}); <<objectSignal>>
if () then ([v3 = true] Yes)
:add incoming mail number date and record it in letter book;
else ([v3 = false] No)
:make a telephone call to the sender;
:add incoming mail number date and record it in letter book;
endif
:is it Wednesday evening?;
:v4: is it Wednesday evening? ({true, false}); <<objectSignal>>
if () then ([v4 = true] Yes)
|a_miranda|
:take letter book and member register to Miranda;
|a_default|
else ([v4 = false] No)
:skip taking letter book and member register;
endif
:has applicant become a member?;
:v5: has applicant become a member? ({true, false}); <<objectSignal>>
if () then ([v5 = true] Yes)
:stamp new Member on letter and write date on letter;
:write the data;
split
:calculate fee;
split again
|a_charles|
:hand letter to Charles;
end split
:ask Charles to write amount in register;
:print membership card and send to new member;
|a_default|
:end process;
|a_charles|
:hand letter to Charles;
:add new member to register;
:prepare invoice for new members;
:ask Charles to write amount in register;
:write fee amount to register;
|a_default|
:end process;
stop
else ([v5 = false] No)
:write to applicant and inform decision;
:after write to applicant;
stop
endif
else ([v2 = true] Yes)
:end process;
stop
endif
else ([v1 = true] Yes)
:end process;
stop
endif
@enduml