init(i1)
action(n1, "Start process for flickr login")
action(n2, "Provide userdata for flickr login")
action(n3, "Is login successful")
branch(b1, XOR)
action(n4, "End process after successful login")
end(e1)
action(n5, "Choose to try login again")
branch(b2, XOR)
action(n6, "Provide userdata for flickr login")
action(n7, "Choose to abort after retry option")
end(e2)
action(n8, "Resume login verification")
end(e3)
defines(v1, "Login Result", {"Success", "Failure"})
defines(v2, "User Decision", {"Retry", "Abort"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, e1, n5, b2, n6, n7, e2, n8, e3])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, e1)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n7)
precedence(n7, e2)
precedence(n6, n8)
precedence(n8, e3)
guard(b1, n4, v1 = 'Success')
guard(b1, n5, v1 = 'Failure')
guard(b2, n6, v2 = 'Retry')
guard(b2, n7, v2 = 'Abort')