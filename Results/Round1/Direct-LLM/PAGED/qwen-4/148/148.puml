@startuml
!theme plain
|a_default| Default
|a_default|
start
:wake up;
:v1: are you hungry? ({not hungry, hungry}); <<objectSignal>>
if () then ([v1 = 'not hungry'])
:take a shower;
else ([v1 = 'hungry'])
:have breakfast;
endif
:v2: still not hungry after first action? ({not hungry, hungry}); <<objectSignal>>
if () then ([v2 = 'not hungry'])
:take a shower;
else ([v2 = 'hungry'])
:have breakfast;
endif
:get on the bus and complete process;
stop
@enduml