  "input_elements": [
    {
      "id": "i1",
      "content": "For the customer, the process begins with a request to purchase a motorcycle."
    },
    {
      "id": "i2",
      "content": "continue the process if a production order is received"
    },
    {
      "id": "i3",
      "content": "if a production order is received"
    },
    {
      "id": "i4",
      "content": "update the sales information and proceed to order dispatch"
    },
    {
      "id": "i5",
      "content": "If there are unavailable materials"
    },
    {
      "id": "i6",
      "content": "they are ordered from the supplier."
    },
    {
      "id": "i7",
      "content": "a manufacturing order is placed."
    },
    {
      "id": "i8",
      "content": "Once the materials are received from the supplier,"
    },
    {
      "id": "i9",
      "content": "the goods are issued and the motorcycles are produced."
    },
    {
      "id": "i10",
      "content": "At the same time, the stock is updated and the motorcycles are dispatched."
    },
    {
      "id": "i11",
      "content": "the process ends."
    },
    {
      "id": "i12",
      "content": "Simultaneously, the stock is updated and the sales information is updated."
    }
  ]
