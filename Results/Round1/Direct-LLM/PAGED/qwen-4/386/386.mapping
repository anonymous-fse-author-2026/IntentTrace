{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we receive the contract for the marketing campaign."
      ],
      "justification": "The opening clause implicitly starts the process and explicitly describes the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once we have the contract, we take it to the department."
      ],
      "justification": "Direct correspondence to the second process step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "In the next step, we input the customer's details into NKE."
      ],
      "justification": "Exact match for the third step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the customer's details are missing,"
      ],
      "justification": "The conditional phrase triggers the XOR branch; the guard captures the 'Missing' state; the action restates the condition as a verification query."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "we contact the customers."
      ],
      "justification": "Direct match for the step following the missing-details condition."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if the customer's details are ready, we create a suitable team."
      ],
      "justification": "The guard captures the 'Ready' condition on the alternate branch; the action implements the consequent step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After contacting the customers, we receive additional customer details."
      ],
      "justification": "Faithfully reproduces the follow-up data collection step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Then, we create the team"
      ],
      "justification": "Matches the subsequent team formation step on this path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "and check previous campaigns for reusable material."
      ],
      "justification": "Exact match for the campaign history review step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "we create a new concept."
      ],
      "justification": "Direct match for the concept generation step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the new concept is created, we integrate new ideas and add further points."
      ],
      "justification": "Faithfully reproduces the refinement step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Next, we integrate the revised campaign into the database."
      ],
      "justification": "Exact match for the database update step."
    },
    {
      "refs": [
        "action:n16",
        "action:n21"
      ],
      "verbatim_texts": [
        "The concept is then presented to the relevant party for consideration."
      ],
      "justification": "Both elements represent the internal review step; n21 serves as a redundant loop-back representation after rework, which is structurally acceptable."
    },
    {
      "refs": [
        "guard:b3->n20"
      ],
      "verbatim_texts": [
        "If the concept is declined,"
      ],
      "justification": "Branch and guard correctly capture the rejection condition."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "we rework it."
      ],
      "justification": "Direct paraphrase of the revision step."
    },
    {
      "refs": [
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "On the other hand, if the concept is accepted, we proceed to present it to the customer."
      ],
      "justification": "The guard captures the acceptance outcome; the action implements the final external presentation step. Covers both corresponding input units."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "if the concept is accepted,"
      ],
      "justification": "The guard captures the acceptance outcome; the action implements the final external presentation step. Covers both corresponding input units."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "This marks the end of the process."
      ],
      "justification": "Explicitly signals process termination."
    }
  ],
