{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For EC-Lille:"
      ],
      "justification": "i1 defines the scope, implicitly initializing the process and matching the descriptive start action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected,"
      ],
      "justification": "i2 establishes the conditional trigger, modeled as an action step followed by the XOR branch."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected,"
      ],
      "justification": "Guard captures the positive boolean outcome of the condition in i2."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Guard captures the negative boolean outcome of the condition in i4."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Direct match to the prescribed action in i3."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "i4 describes two consecutive steps mapped to n4 and n5."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule,"
      ],
      "justification": "Direct match to the validation step in i5."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory."
      ],
      "justification": "i6 maps to the satisfaction check and its corresponding XOR branch."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "i7 specifies the negative outcome leading to the research schedule action."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "i8 specifies the positive outcome condition."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF.",
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Single action node implements the ticket writing step described in both i8 and i11."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory,"
      ],
      "justification": "i9 triggers the second satisfaction check and its XOR branch."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory,"
      ],
      "justification": "Guard captures the negative path of the re-check in i9."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "then \"provide indications\"."
      ],
      "justification": "Direct match to the fallback action in i10."
    },
    {
      "refs": [
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Guard captures the positive path of the re-check in i11, routing back to the ticket order action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Direct match to the validation step in i12."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "i13 maps to the approval check and its XOR branch."
    },
    {
      "refs": [
        "guard:b4->e1"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "i14 explicitly terminates the process on rejection."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "i15 directs an additional validation step upon approval."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "i16 initiates the second approval check and its XOR branch."
    },
    {
      "refs": [
        "guard:b5->e2"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Model resolves the implicit negative branch of i16 by terminating the process, consistent with prior termination patterns."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "i17 sets up the final approval check and its XOR branch."
    },
    {
      "refs": [
        "guard:b6->e3"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "i18 handles the affirmative termination."
    },
    {
      "refs": [
        "guard:b6->e4"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved.",
        "If it is, then the process ends."
      ],
      "justification": "Model symmetrically terminates on the negative path of the final check to complete the branching logic implied by i17/i18."
    }
  ],
