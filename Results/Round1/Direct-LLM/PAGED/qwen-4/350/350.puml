@startuml
!theme plain
|a_default| Default
|a_default|
start
:provide userdata for flickr;
:is the login successful;
:v1: is the login successful ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
stop
else ([v1 = 'No'] No)
:do you want to try again;
:v2: do you want to try again ({Try again, Abort}); <<objectSignal>>
if () then ([v2 = 'Try again'])
:provide userdata for flickr again after first failure;
:is the login successful after retry;
:v3: is the login successful after retry ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
stop
else ([v3 = 'No'] No)
:do you want to try again after second failure;
:v4: do you want to try again after second failure ({Try again, Abort}); <<objectSignal>>
if () then ([v4 = 'Try again'])
:provide userdata for flickr again after second failure;
:is the login successful after third try;
:v5: is the login successful after third try ({Yes, No}); <<objectSignal>>
if () then ([v5 = 'Yes'])
stop
else ([v5 = 'No'] No)
:end process abort after third failure;
stop
endif
else ([v4 = 'Abort'])
:abort process after second failure;
stop
endif
endif
else ([v2 = 'Abort'])
:abort process after first failure;
stop
endif
endif
@enduml