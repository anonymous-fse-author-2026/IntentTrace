    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Implicitly initiates the process and directly implements the first ordering step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then proceed to Check the Customer's Credit Limit"
      ],
      "justification": "Faithfully captures the credit limit verification action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article. However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Correctly models the XOR decision, both guard conditions, and the resulting actions with accurate values."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8",
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods. However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Accurately represents the availability branching logic and its two distinct outcomes."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "send an Order Confirmation."
      ],
      "justification": "Direct paraphrase of the confirmation dispatch step."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "AND gateway correctly splits into the two simultaneous shipping and invoicing actions."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Faithfully restates the payment verification step."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "Models the positive payment path, the closing action, and the explicit process termination."
    },
    {
      "refs": [
        "guard:b3->b4"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process. If the payment has not been received, check if the Reminder count is greater than or equal to 3.",
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Captures the branching decision point and the guard for the unpaid status that triggers the reminder count evaluation."
    },
    {
      "refs": [
        "action:n18",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order. Additionally, send a Reminder."
      ],
      "justification": "Accurately implements the write-off and reminder sending steps described in the source."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Matches the final administrative closing action and the terminal node."
    }
