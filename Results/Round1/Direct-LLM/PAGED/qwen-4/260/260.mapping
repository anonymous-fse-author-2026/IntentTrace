{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "The opening clause implicitly initiates the process and directly describes the first reception action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After receiving the invoice, it is sorted per client."
      ],
      "justification": "Direct restatement of the client sorting step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once sorted per client, it is then sorted per vendor."
      ],
      "justification": "Direct restatement of the vendor sorting step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "The next step is to attach the invoice entry form to the invoice."
      ],
      "justification": "Direct restatement of attaching the entry form."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After attaching the form, the required information is entered onto the form."
      ],
      "justification": "Direct restatement of entering required information."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Following that, the completeness of the invoice is checked."
      ],
      "justification": "Describes the completeness verification action and implicitly opens the subsequent XOR decision point."
    },
    {
      "refs": [
        "guard:b1->e1"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Captures the negative completeness condition that triggers immediate process termination."
    },
    {
      "refs": [
        "guard:b1->n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered. The date for completion is also entered",
        "and the priority is checked."
      ],
      "justification": "The positive condition routes to SLA/date entry and priority checking. n10 is a permissible behavioral redundancy of the priority check already contained in n9."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered. The date for completion is also entered",
        "and the priority is checked."
      ],
      "justification": "The positive condition routes to SLA/date entry and priority checking. n10 is a permissible behavioral redundancy of the priority check already contained in n9."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered. The date for completion is also entered",
        "and the priority is checked."
      ],
      "justification": "The positive condition routes to SLA/date entry and priority checking. n10 is a permissible behavioral redundancy of the priority check already contained in n9."
    },
    {
      "refs": [
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "If the priority is high"
      ],
      "justification": "Models the exclusive split for high priority and the corresponding stamping action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "a red stamp is placed on the entry invoice."
      ],
      "justification": "Models the exclusive split for high priority and the corresponding stamping action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is low"
      ],
      "justification": "Routes the low priority outcome to a convergence node that rejoins the main flow."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Direct restatement of the compliance verification step."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Models the experienced staff routing condition and its processing action."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Models the normal case condition routing to the client call action."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Models the catch-all condition, the postal mail action, and the associated process end."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO"
      ],
      "justification": "Implicit convergence precedes the final batching and allocation step."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO"
      ],
      "justification": "The final operational step implicitly concludes the successful process path."
    }
  ],
  "mutations": [],
  "omissions": [
    {
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "reason": "The source explicitly defines a distinct final step of calling the client and requesting information before batching, but the model's terminal sequence skips this step entirely."
    }
  ],
  "additions": [
