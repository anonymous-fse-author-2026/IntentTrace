{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts with the User Begin Creating Account,"
      ],
      "justification": "The opening clause explicitly initiates the workflow and defines the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        ", followed by User Create Account."
      ],
      "justification": "Directly specifies the sequential account creation action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the User Create Account is followed by Enter Country."
      ],
      "justification": "Clearly sequences the next required data-entry action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the country is entered, the next step is to Enter Credit Card and Bank Details."
      ],
      "justification": "Specifies the progression to the payment details entry step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the Credit Card and Bank Details are entered, the next step is to Enter Personal Details."
      ],
      "justification": "Directly maps to the personal details entry action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After entering the Personal Details, the next step is to Verify Personal Account."
      ],
      "justification": "Explicitly defines the account verification action step."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the account is not verified, then the Account Creation is rejected."
      ],
      "justification": "The conditional introduces the XOR decision point; the guard abstracts the negative verification condition; the action captures the exact rejection outcome."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if the account is verified, then the Account Creation is confirmed."
      ],
      "justification": "Defines the positive verification guard and the corresponding confirmation action with identical phrasing."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "In case of Account Creation Rejection, the process ends with the Account Creation being rejected."
      ],
      "justification": "Explicitly signals process termination on the rejection path, justifying the structural end node."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the Account Creation is confirmed, the process ends with the Account Successfully Created."
      ],
      "justification": "Describes the final successful state action and explicitly notes process termination, justifying both the action and end node."
    }
  ],
