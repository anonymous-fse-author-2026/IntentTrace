init(i1)
action(n1, "start registration for event participation")
action(n2, "check if there is a fee")
branch(b1, XOR)
action(n3, "register a post-seminar request")
action(n4, "create a purchase request")
action(n5, "End process after post-seminar request registration")
end(e1)
action(n6, "check if purchase request is approved")
branch(b2, XOR)
action(n7, "receive an approved notification")
action(n8, "receive a rejection notification")
action(n9, "register a post-seminar request after approval")
action(n10, "End process after rejection notification or post-seminar registration")
end(e2)
converge(c1)
defines(v1, "check if there is a fee", {true, false})
defines(v2, "check if purchase request is approved", {true, false})
actor(a_default, "Default", [i1, n1, n2, b1, n3, n4, n5, e1, n6, b2, n7, n8, n9, n10, e2, c1])
precedence(i1, n1)
precedence(n2, b1)
precedence(n5, e1)
precedence(n6, b2)
precedence(n10, e2)
precedence(c1, n10)
precedence(n1, n2)
precedence(b1, n3)
precedence(b1, n4)
precedence(n3, n5)
precedence(n4, n6)
precedence(b2, n7)
precedence(b2, n8)
precedence(n7, n9)
precedence(n8, c1)
precedence(n9, c1)
guard(b1, n3, v1 = false)
guard(b1, n4, v1 = true)
guard(b2, n7, v2 = true)
guard(b2, n8, v2 = false)