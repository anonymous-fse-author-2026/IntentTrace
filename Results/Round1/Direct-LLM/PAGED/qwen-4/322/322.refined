init(i1)
action(n2, "Receive Expense Report")
action(n3, "Verify account and review report")
branch(b1, XOR)
action(n5, "Process reimbursement")
action(n6, "Proceed with payment")
end(e1)
action(n8, "Send Expense Rejection Notification")
end(e2)
defines(v1, "Is report accepted?", {"Yes", "No"})
actor(a_default, "Default", [i1, n2, n3, b1, n5, n6, e1, n8, e2])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, e1)
precedence(b1, n8)
precedence(n8, e2)
guard(b1, n5, v1 = 'Yes')
guard(b1, n8, v1 = 'No')