init(i1)
action(n1, "start booking service")
action(n2, "book bus")
action(n3, "check availability of bus")
action(n4, "receive availability information")
branch(b1, XOR)
end(e1)
action(n7, "proceed to book bus")
end(e2)
defines(v1, "availability ok?", {"nok", "ok"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, e1, n7, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, e1)
precedence(b1, n7)
precedence(n7, e2)
guard(b1, e1, v1 = 'nok')
guard(b1, n7, v1 = 'ok')