{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "The opening clause implicitly starts the process (init) and directly describes the first action step. Content faithfully restates the source instructions."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "The conditional opens the XOR branch. The guard correctly captures the threshold (>1000), and the action matches the consequent step."
    },
    {
      "refs": [
        "guard:b1->b2",
        "action:n11"
      ],
      "verbatim_texts": [
        "if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation"
      ],
      "justification": "The guard captures the complementary threshold (<=1000), and the action accurately reflects the instruction to check for translation needs."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "The boolean guard ('true') aligns with 'translation is required', triggering the XOR branch and the corresponding translation action."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "The boolean guard ('false') correctly models the negative case, leading to the confirmation action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Direct match for the evaluation step following the initial translation/confirmation path."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "The guard value 'rejected' matches the source condition, routing to the correct edit action via the XOR branch."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "The guard value 'approved' matches the positive outcome, correctly reusing the translation-check action node."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "The repeated evaluation step justifies the converge/split context and reuses the evaluation action node, implying the subsequent XOR branch."
    },
    {
      "refs": [
        "guard:b6->n15",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "The 'approved' guard routes to the sequential actions of translating and confirming receipts, matching the source compound step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Direct paraphrase of the final evaluation step before the last routing decision."
    },
    {
      "refs": [
        "guard:b9->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "The 'accepted' guard correctly models the positive routing condition, leading to the expense processing action."
    },
    {
      "refs": [
        "guard:b9->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "The 'rejected' guard matches the negative outcome condition, correctly routing to the edit report action."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "The closing sentence implies paths converging (converge), performing the final end-step action, and terminating the process (end)."
    }
  ],
