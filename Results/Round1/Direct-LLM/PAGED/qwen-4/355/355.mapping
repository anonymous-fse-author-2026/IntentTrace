{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by checking the customer's order."
      ],
      "justification": "Implicit start node and direct paraphrase of the initial checking action."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer is a registered customer, then check their payment morale."
      ],
      "justification": "XOR branch, condition-as-action, guard value, and subsequent morale check all align with this clause."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they are a new customer, then check their status."
      ],
      "justification": "Guard 'No' (to registered) implies new customer status, mapping directly to the status check action."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If their payment morale is good, continue with the process."
      ],
      "justification": "Condition modeled as action/guard pair routes to the correct continuation action."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->c1",
        "guard:b3->c1",
        "action:n8"
      ],
      "verbatim_texts": [
        "If their payment morale is bad or if they are an end customer, reject the order and end the process."
      ],
      "justification": "Two guards capture the OR condition, converging to rejection action and process end."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "If the customer is a wholesaler"
      ],
      "justification": "Guard explicitly specifies the wholesaler branch path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "enter their data and take the order"
      ],
      "justification": "Direct action match for data entry and order taking."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, check the availability of the items."
      ],
      "justification": "AND gateway captures simultaneity, followed by the availability check action."
    },
    {
      "refs": [
        "action:n13",
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the items are out of stock, start production."
      ],
      "justification": "Stock condition modeled as action/guard routes correctly to starting production."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If they are in stock, continue with the process."
      ],
      "justification": "Positive stock guard leads directly to the continuation action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Once the availability is checked, send the order confirmation."
      ],
      "justification": "Converge node marks availability check completion, triggering the confirmation action."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If production is started, produce the article and send the order confirmation."
      ],
      "justification": "Two sequential actions faithfully implement production and confirmation, converging afterwards."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Simultaneously, send the invoice and deliver the product."
      ],
      "justification": "AND gateway models simultaneity, combined action covers both invoice and delivery."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check the payment status."
      ],
      "justification": "Action paraphrases checking status as verifying payment receipt."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If payment is received, close the order."
      ],
      "justification": "Branch and positive guard route to order closure and path termination."
    },
    {
      "refs": [
        "guard:b5->n22"
      ],
      "verbatim_texts": [
        "If no payment is received, check the number of reminders."
      ],
      "justification": "Negative guard correctly handles the unpaid payment branch."
    },
    {
      "refs": [
        "action:n22",
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If there are more than three reminders, engage a lawyer."
      ],
      "justification": "Reminder count check and branch/guard correctly route to lawyer engagement and end."
    },
    {
      "refs": [
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are three or fewer reminders, send a reminder."
      ],
      "justification": "Guard threshold matches source, leading to reminder action and path end."
    }
  ],
  "mutations": [],
  "omissions": [],
  "additions": [
    {
      "refs": [
        "label:n26->e4"
      ],
      "reason": "The label content '}' has no supporting source text and serves no functional purpose in the process description."
    }
  ],
