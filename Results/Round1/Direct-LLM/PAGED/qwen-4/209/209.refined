init(i1)
action(n2, "receive order request")
action(n3, "register order")
action(n4, "evaluate order")
branch(b1, XOR)
action(n6, "mark order as NOK")
end(e1)
action(n8, "perform installation")
branch(b2, XOR)
action(n10, "check installation")
action(n11, "prepare billing")
action(n13, "mark order as ok")
end(e2)
converge(c1)
defines(v1, "evaluation result ok", {"NOK", "ok"})
defines(v2, "installation successful", {"No", "Yes"})
actor(a_default, "Default", [i1, n2, n3, n4, b1, n6, e1, n8, b2, n10, n11, n13, e2, c1])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, c1)
precedence(b1, n8)
precedence(c1, n6)
precedence(n6, e1)
precedence(n8, b2)
precedence(b2, c1)
precedence(b2, n10)
precedence(n10, n11)
precedence(n11, n13)
precedence(n13, e2)
guard(b1, c1, v1 = 'NOK')
guard(b1, n8, v1 = 'ok')
guard(b2, c1, v2 = 'No')
guard(b2, n10, v2 = 'Yes')