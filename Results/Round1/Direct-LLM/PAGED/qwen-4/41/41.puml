@startuml
!theme plain
|a_default| Passenger
|a_default|
start
:start the process;
:undergo immigration checks;
:select method for exit control checks;
:v2: exit control method ({biometrics, id_documents}); <<objectSignal>>
if () then ([v2 = 'biometrics'])
:use biometrics for exit control checks;
else ([v2 = 'id_documents'])
:use ID documents for exit control checks;
endif
:v1: exit control outcome ({denied, allowed}); <<objectSignal>>
if () then ([v1 = 'denied'])
:leave the area;
else ([v1 = 'allowed'])
:proceed to the next step;
endif
stop
@enduml