init(i1)
action(n1, "start the process")
action(n2, "undergo immigration checks")
action(n3, "select method for exit control checks")
branch(b5, XOR)
action(n4, "use biometrics for exit control checks")
action(n5, "use ID documents for exit control checks")
converge(c1)
branch(b1, XOR)
action(n8, "leave the area")
action(n9, "proceed to the next step")
end(e1)
defines(v1, "exit control outcome", {"denied", "allowed"})
defines(v2, "exit control method", {"biometrics", "id_documents"})
actor(a_default, "Passenger", [i1, n1, n2, n3, b5, n4, n5, c1, b1, n8, n9, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b5)
precedence(b5, n4)
precedence(b5, n5)
precedence(n4, c1)
precedence(n5, c1)
precedence(c1, b1)
precedence(b1, n8)
precedence(b1, n9)
precedence(n8, e1)
precedence(n9, e1)
guard(b5, n4, v2 = 'biometrics')
guard(b5, n5, v2 = 'id_documents')
guard(b1, n8, v1 = 'denied')
guard(b1, n9, v1 = 'allowed')