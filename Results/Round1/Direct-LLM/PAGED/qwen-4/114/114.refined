init(i1)
action(n1, "start selling cars")
branch(b1, XOR)
action(n4, "No check paycheck")
branch(b2, XOR)
action(n8, "pay the bill")
end(e2)
converge(c1)
defines(v1, "did you get a bonus", {"Yes", "No"})
defines(v2, "did you get a paycheck", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, b1, n4, b2, n8, e2, c1])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n4)
precedence(b1, c1)
precedence(n4, b2)
precedence(b2, c1)
precedence(c1, n8)
precedence(n8, e2)
guard(b1, n4, v1 = 'No')
guard(b1, c1, v1 = 'Yes')
guard(b2, c1, v2 = 'Yes')
guard(b2, c1, v2 = 'No')