@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start process;
:Items returned by customer or picked up by delivery crew;
:v1: Items returned by customer or picked up by delivery crew ({Delivery crew picks up items at event site, Customer returns the items to the store}); <<objectSignal>>
if () then ([v1 = 'Delivery crew picks up items at event site'] [v1 = 'Customer returns the items to the store'])
->;
else ([v1 = 'Delivery crew picks up items at event site'] [v1 = 'Customer returns the items to the store'])
->;
endif
:Count and compare items to contract;
:Order status after count;
:v2: Order status after count ({All items returned, Items missing, Items damaged}); <<objectSignal>>
switch ()
case ([v2 = 'All items returned'])
:Items disposition for returned items;
:v3: Items disposition for returned items ({Stored for future orders, Packed for an existing order}); <<objectSignal>>
if () then ([v3 = 'Stored for future orders'] [v3 = 'Packed for an existing order'])
->;
else ([v3 = 'Stored for future orders'] [v3 = 'Packed for an existing order'])
->;
endif
:End process;
stop
case ([v2 = 'Items missing'])
:Email customer missing items and replacement charges;
:Customer returns missing items;
:v4: Customer returns missing items ({Customer does not return missing items, Customer returns the missing items}); <<objectSignal>>
if () then ([v4 = 'Customer does not return missing items'] [v4 = 'Customer returns the missing items'])
->;
else ([v4 = 'Customer does not return missing items'] [v4 = 'Customer returns the missing items'])
->;
endif
:End process;
stop
case ([v2 = 'Items damaged'])
:Email customer damage and additional charges;
:Temporarily remove damaged items from inventory;
:Can damaged items be repaired;
:v5: Can damaged items be repaired ({Can be repaired, Cannot be repaired}); <<objectSignal>>
if () then ([v5 = 'Can be repaired'])
:Repair items and add to inventory;
:Items disposition after repair;
:v6: Items disposition after repair ({Stored for future orders, Packed for an existing order}); <<objectSignal>>
if () then ([v6 = 'Stored for future orders'] [v6 = 'Packed for an existing order'])
->;
else ([v6 = 'Stored for future orders'] [v6 = 'Packed for an existing order'])
->;
endif
:End process;
stop
else ([v5 = 'Cannot be repaired'])
:Discard items and email customer replacement charges;
endif
endswitch
@enduml