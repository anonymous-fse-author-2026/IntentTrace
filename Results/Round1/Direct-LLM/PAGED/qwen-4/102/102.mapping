      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step,"
      ],
      "justification": "The opening clause implicitly triggers the process start and directly names the first action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
