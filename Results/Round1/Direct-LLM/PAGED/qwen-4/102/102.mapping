      ],
      "justification": "Explicitly signals termination for this specific path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "move on to Reviewing the Purchase Order."
      ],
      "justification": "Faithfully restates the next sequential step after PO creation."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved,"
      ],
      "justification": "Defines the second XOR decision and its positive guard condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "then reserve the funds for the purchase."
      ],
      "justification": "Exact alignment with the action taken upon approval."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "if the Purchase Order is rejected,"
      ],
      "justification": "Exact alignment with the negative branch condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then rework the order."
      ],
      "justification": "Directly matches the corrective action described."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Temporal lead-in does not alter the core instruction; the action content faithfully reproduces the step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
