      ],
      "justification": "Directly corresponds to the second sequential action."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\""
      ],
      "justification": "The conditional phrase establishes the XOR decision point and provides the exact guard condition for the positive branch."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then proceed to Create Purchase Order."
      ],
      "justification": "Exact match for the action taken when the inventory is low."
    },
    {
      "refs": [
        "guard:b1->e1"
      ],
      "verbatim_texts": [
        "However, if the \"Inventory Level is above the minimum\","
      ],
      "justification": "Captures the exact negated condition for the alternative branch."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
