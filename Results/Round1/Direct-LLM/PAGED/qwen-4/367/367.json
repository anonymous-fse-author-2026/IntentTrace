  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process for ACME, begin with the New Resupply Cycle"
    },
    {
      "id": "i2",
      "content": "then Check Levels of Inventory"
    },
    {
      "id": "i3",
      "content": "If the inventory is below or equal to the minimum"
    },
    {
      "id": "i4",
      "content": "generate an Equal to or below minimum Report"
    },
    {
      "id": "i5",
      "content": "generate an Above Minimum Report"
    },
    {
      "id": "i6",
      "content": "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
    },
    {
      "id": "i7",
      "content": "the process ends"
    },
    {
      "id": "i8",
      "content": "If the PO is rejected, it needs to be reworked. If the PO is approved, it is printed and released in the system."
    },
    {
      "id": "i9",
      "content": "If the PO is created, it needs to be reviewed. If the PO needs to be reworked, it needs to be created again."
    },
    {
      "id": "i10",
      "content": "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
    },
    {
      "id": "i11",
      "content": "If funds are reserved for the released POs, receive the Packing Slip. If the POs are mailed to the supplier, receive the inventory."
    },
    {
      "id": "i12",
      "content": "If the Packing Slip is received, proceed to receive the Invoice. If the inventory is received, proceed to receive the Packing Slip."
    },
    {
      "id": "i13",
      "content": "If the Invoice is received, proceed to the Three-way match. If the Three-way match is successful, release the funds."
    },
    {
      "id": "i14",
      "content": "Once the funds are released, issue the payment. After the payment is issued, the Resupply Cycle is complete"
    }
  ]
