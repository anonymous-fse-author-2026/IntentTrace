{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "Implicit process start and explicit first action step align perfectly with the opening instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\", then proceed to Create Purchase Order."
      ],
      "justification": "Structural XOR split and the positive-branch action directly correspond to the conditional path."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "However, if the \"Inventory Level is above the minimum\", then the process ends."
      ],
      "justification": "Structural termination node faithfully represents the explicit early-exit condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order."
      ],
      "justification": "Direct restatement of the sequential review step."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved, then reserve the funds for the purchase."
      ],
      "justification": "Decision gateway, condition modeled as an action step, and the reservation action jointly capture the approval path without loss of meaning."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the Purchase Order is rejected, then rework the order."
      ],
      "justification": "Direct paraphrase of the rejection/rework instruction."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers."
      ],
      "justification": "Exact alignment with the dispatch step following fund reservation."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Faithfully captures the iterative review instruction for reworked orders."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: the Supplier sends a packing slip and an invoice."
      ],
      "justification": "AND gateway and supplier action accurately model the concurrent supplier delivery tasks."
    },
    {
      "refs": [
        "label:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it."
      ],
      "justification": "Connection label and subsequent action jointly capture the receipt trigger and recording task."
    },
    {
      "refs": [
        "label:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Similarly, when the invoice is received, record it as well."
      ],
      "justification": "Connection label and subsequent action jointly capture the receipt trigger and recording task for the invoice."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice, release the reserved funds and issue the payment to the supplier."
      ],
      "justification": "Merge node and combined financial action directly match the post-recording settlement instructions."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier."
      ],
      "justification": "Explicit terminal statement matches the second end node marking process completion."
    }
  ],
