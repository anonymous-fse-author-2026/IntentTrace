    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "After this, we again check if the input is a \"URN\" or a \"URL\" and take the corresponding action."
      ],
      "justification": "Both guard variants correspond to the conditional outcomes specified in the text."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once we have resolved the URN to a domain-name, we send a DNS query."
      ],
      "justification": "The convergence of prior paths is implied before executing the next sequential action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
