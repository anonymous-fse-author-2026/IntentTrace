    },
    {
      "refs": [
        "action:n3",
        "label:b1->n3",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If it is, we proceed with the step of \"ONS-Resolving URN to a domain-name\"."
      ],
      "justification": "Matches the positive branch outcome, its connection label, and guard condition."
    },
    {
      "refs": [
        "action:n4",
        "label:b1->n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the input is a \"URL\", we simply continue with the process."
      ],
      "justification": "Matches the alternative branch outcome, its connection label, and guard condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
