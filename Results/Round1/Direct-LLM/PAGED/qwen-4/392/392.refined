init(i1)
action(n1, "Start User Task")
branch(b1, XOR)
action(n3, "Continue Process after Service Task 1")
action(n5, "Continue Process after Service Task 2")
action(n6, "End Process due to Service Task 3")
end(e1)
converge(c1)
branch(b3, XOR)
action(n9, "End Process if Manual Task Yes")
end(e2)
defines(v1, "Task Type", {"Service Task 1", "Service Task 2", "Service Task 3"})
defines(v3, "Has Manual Task", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, b1, n3, n5, n6, e1, c1, b3, n9, e2])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n3)
precedence(b1, n5)
precedence(b1, n6)
precedence(n6, e1)
precedence(n3, c1)
precedence(n5, c1)
precedence(c1, b3)
precedence(b3, n9)
precedence(n9, e2)
precedence(b3, e2)
guard(b1, n3, v1 = "Service Task 1")
guard(b1, n5, v1 = "Service Task 2")
guard(b1, n6, v1 = "Service Task 3")
guard(b3, n9, v3 = "Yes")
guard(b3, e2, v3 = "No")