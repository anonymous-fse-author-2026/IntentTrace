{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Covers process initialization and the first three sequential actions."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000",
        "is greater than 1000"
      ],
      "justification": "Models the conditional decision node for the expense threshold."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000"
      ],
      "justification": "Represents the true branch guard for the expense condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the report should be reviewed."
      ],
      "justification": "Direct mapping of the review action."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "is less than or equal to 1000"
      ],
      "justification": "Represents the false branch of the expense condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "check if there is a need for translation. If translation is required,"
      ],
      "justification": "Captures the translation requirement decision node."
    },
    {
      "refs": [
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "check if there is a need for translation. If translation is required,"
      ],
      "justification": "Positive guard for the translation requirement."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "proceed to translate the receipts."
      ],
      "justification": "Direct mapping of the translation step."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Maps the negative branch guard and confirmation action."
    },
    {
      "refs": [
        "action:n11",
        "action:n6"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Covers the first review decision evaluation step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Models the rejection branch and editing action."
    },
    {
      "refs": [
        "guard:b2->c1",
        "action:n20"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Maps the approval guard and subsequent translation check."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Direct mapping of the second review decision evaluation."
    },
    {
      "refs": [
        "action:n25",
        "action:n26",
        "guard:b7->n25"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Models the approval branch, translation, and confirmation steps."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision. If the receipts are accepted,"
      ],
      "justification": "Covers receipt decision evaluation node."
    },
    {
      "refs": [
        "guard:b5->n16"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision. If the receipts are accepted,"
      ],
      "justification": "Acceptance path guard for receipts decision."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "proceed to process the expense."
      ],
      "justification": "Direct mapping of expense processing."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Maps receipt rejection guard and editing action."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Covers termination actions and the end node."
    },
    {
      "refs": [
        "action:n12",
        "guard:b4->n12",
        "guard:b4->n20"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Redundant structural duplication of the rejection/edit path, faithfully restating source logic."
    },
    {
      "refs": [
        "action:n21",
        "action:n22",
        "guard:b6->n21",
        "guard:b6->n22"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Redundant structural duplication of the translation/confirmation path, matching source content."
    },
    {
      "refs": [
        "action:n24",
        "guard:b7->n24"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Redundant duplication of the second rejection path, consistent with source."
    }
  ],
