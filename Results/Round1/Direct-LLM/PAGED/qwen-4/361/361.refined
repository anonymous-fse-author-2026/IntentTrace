init(i1)
action(n2, "trigger: resupply cycle")
action(n3, "check: inventory level")
branch(b1, XOR)
action(n4, "end process: above minimum")
end(e1)
action(n5, "create: purchase order")
action(n6, "review: purchase order")
branch(b2, XOR)
action(n7, "rework: purchase order")
action(n8, "review: purchase order")
branch(b3, XOR)
action(n9, "reserve funds for purchase")
action(n10, "receive packing slip and release funds")
action(n12, "send to supplier")
branch(b4, AND)
converge(c_sync)
converge(c1)
converge(c_rework)
defines(v1, "check: inventory level", {'above_minimum', 'below_minimum'})
defines(v2, "review: purchase order", {'rejected', 'accepted'})
defines(v3, "review: purchase order", {'rejected', 'accepted'})
actor(a_default, "Default", [i1, n2, n3, b1, n4, e1, n5, n6, b2, n7, n8, b3, n9, n10, n12, b4, c_sync, c1, c_rework])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, e1)
precedence(n5, n6)
precedence(n6, b2)
precedence(b2, c_rework)
precedence(b2, c_sync)
precedence(c_rework, n7)
precedence(n7, n8)
precedence(n8, b3)
precedence(b3, c_rework)
precedence(b3, c_sync)
precedence(c_sync, b4)
precedence(b4, n9)
precedence(b4, n12)
precedence(n9, c1)
precedence(n12, c1)
precedence(c1, n10)
precedence(n10, e1)
guard(b1, n4, v1 = 'above_minimum')
guard(b1, n5, v1 = 'below_minimum')
guard(b2, c_rework, v2 = 'rejected')
guard(b2, c_sync, v2 = 'accepted')
guard(b3, c_rework, v3 = 'rejected')
guard(b3, c_sync, v3 = 'accepted')