if () then ([v10 = 'Yes'])
|a_default|
:end TS recruitment;
stop
|a_rec_mgr|
else ([v10 = 'No'])
|a_default|
:contact next candidate on shortlist;
|a_rec_mgr|
endif
split again
|a_default|
stop
end split
endif
|a_rec_mgr|
endif
|a_default|
