  "input_elements": [
    {
      "id": "i1",
      "content": "The process begins with receiving a Ministerial enquiry,"
    },
    {
      "id": "i2",
      "content": "followed by assigning the enquiry to a minister."
    },
    {
      "id": "i3",
      "content": "After assigning the enquiry, the next step is to investigate it."
    },
    {
      "id": "i4",
      "content": "Once the investigation is complete, the ministerial response is prepared and then reviewed."
    },
    {
      "id": "i5",
      "content": "If the response is not approved,"
    },
    {
      "id": "i6",
      "content": "not approved"
    },
    {
      "id": "i7",
      "content": "the Ministerial correspondence is addressed"
    },
    {
      "id": "i8",
      "content": "and the process comes to an end."
    },
    {
      "id": "i9",
      "content": "However, if the response is approved,"
    },
    {
      "id": "i10",
      "content": "the process continues."
    }
  ]
