{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The opening clause implicitly triggers the process start and explicitly defines the first action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Direct correspondence to the second sequential step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "Describes the evaluation step and inherently introduces the subsequent exclusive split."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "The conditional prefix maps to the guard condition, while the consequent maps to the rejection action."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted"
      ],
      "justification": "Captures the alternative conditional for the positive branch."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "offer the benefit"
      ],
      "justification": "Direct match to the positive branch outcome."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Follows the rejection path and accurately represents the review step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Correctly captures the preparation step following the acceptance branch."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Faithfully restates the recording step after discharge preparation."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process. But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Both conditional outcomes lead to the identical action, logically requiring a converge point before the single continuation step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicitly denotes process termination, supporting both the structural end node and the labeled action."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "At the same time"
      ],
      "justification": "Concurrency marker directly justifies an AND gateway splitting parallel work."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "operate outgoing payment"
      ],
      "justification": "Exact match for the first parallel task."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "close the claim."
      ],
      "justification": "Represents the final parallel task and the implicit synchronization point where concurrent flows rejoin."
    }
  ],
