      ],
      "verbatim_texts": [
        "For Talent Seek:"
      ],
      "justification": "Init node corresponds to the opening scope clause."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, it is important to check the Referee Reports."
      ],
      "justification": "Direct correspondence to the initial checking step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "monitor if the Referee Reports have been completed."
      ],
      "justification": "Action models the monitoring/checking instruction."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If they have been completed, you can proceed with the process."
      ],
      "justification": "Branch opens the decision; guard captures the positive condition; action executes the proceeding step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if they have not been completed, you should flag it and send a reminder."
      ],
      "justification": "Guard captures the negative condition; action executes the flagging and reminder."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "check again if the Referee Reports have been completed."
      ],
      "justification": "Both actions model the re-check instruction."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If they have, you can continue with the process."
      ],
      "justification": "Guard captures the positive re-check condition; action executes continuation."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If not, you should flag it again and send another reminder."
      ],
      "justification": "Guard captures the negative re-check condition; action executes the repeat flagging and reminder."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive feedback from the interview candidates."
      ],
      "justification": "Exact correspondence to the feedback collection step."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->c3"
      ],
      "verbatim_texts": [
        "check if a Psychometric Test is required."
      ],
      "justification": "Action performs the check; guard represents the negative outcome path."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is, you should then check if an HR Specialist is required."
      ],
      "justification": "Guard captures the positive condition; action executes the HR specialist check."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required, you should schedule the test with a third party."
      ],
      "justification": "Guard captures the condition; action executes the scheduling."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Otherwise, you can proceed to complete the Psychometric Test."
      ],
      "justification": "Guard captures the alternative condition; action executes test completion."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "request the final candidate ranking"
      ],
      "justification": "Exact correspondence to the final ranking request."
    }
