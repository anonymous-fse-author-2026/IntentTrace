{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "The opening clause implicitly starts the process and describes the initial prioritization action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information. If the customer exists,"
      ],
      "justification": "Captures the customer existence check, the resulting XOR split, and the positive guard condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "we move on to checking their payment history."
      ],
      "justification": "Direct correspondence to the payment history verification step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "On the other hand, if the customer does not exist, we need to verify their customer status."
      ],
      "justification": "Maps the negative branch guard and the subsequent status verification action."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process."
      ],
      "justification": "Models the condition as an action step, links the positive guard to the convergence point that continues the flow."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n6",
        "action:n6",
        "action:n8",
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Covers the private-customer condition, the branching decisions, and the dual (redundant) action nodes for sending the decline message."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Maps the alternative branch guard for wholesalers to the creation and availability-check actions."
    },
    {
      "refs": [
        "action:n11",
        "guard:b4->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Aligns the availability check, unavailability guard, production/decline action, explicit process termination action, and end node."
    },
    {
      "refs": [
        "guard:b4->c2",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Links the positive availability guard to the convergence point and the confirmation action."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "Correctly models the concurrent AND split, the two notification actions, and their subsequent merge."
    },
    {
      "refs": [
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Sequentially maps packing, invoicing, and the readiness/state confirmation actions."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Matches the pre-delivery convergence point and the delivery action."
    },
    {
      "refs": [
        "action:n22",
        "guard:b5->n23",
        "action:n23",
        "action:n29"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Covers the payment receipt check, XOR split, positive guard, closure action, terminal action, and end node."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Maps the negative payment guard to the reminder-checking action."
    },
    {
      "refs": [
        "action:n25",
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Captures the threshold condition, branch, positive guard, and continuation action."
    },
    {
      "refs": [
        "guard:b6->n27",
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Aligns the high-reminder guard, activation action, terminal action, and end node."
    }
  ],
  "mutations": [
    {
      "refs": [
        "guard:b6->n27"
      ],
      "verbatim_texts": [
        "If there are more than three reminders"
      ],
      "reason": "The guard evaluates to 'false' on the '< 3' condition, which mathematically yields '>= 3'. This shifts the threshold range to include exactly three reminders, whereas the source strictly specifies 'more than three' (> 3)."
    }
  ],
  "omissions": [],
  "additions": [
