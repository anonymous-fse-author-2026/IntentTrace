init(i1)
action(n1, "Start")
action(n2, "Obtain raw material from received list")
action(n3, "Is raw material available in stock?")
branch(b1, XOR)
action(n4, "Check raw material and conclude process (If Available)")
end(e1)
action(n6, "Select a supplier")
action(n7, "Send material purchase order")
action(n8, "Check raw material and conclude process (After PO)")
end(e2)
defines(v1, "Is raw material available in stock?", {true, false})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, e1, n6, n7, n8, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(n4, e1)
precedence(b1, n6)
precedence(n6, n7)
precedence(n7, n8)
precedence(n8, e2)
guard(b1, n4, v1 = true)
guard(b1, n6, v1 = false)