  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order"
      ],
      "justification": "Init node marks the process start; action faithfully captures the placing order step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then check the customer."
      ],
      "justification": "Action directly restates checking the customer."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\""
      ],
      "justification": "XOR branch correctly models the eligibility decision point."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "inform them."
      ],
      "justification": "Action corresponds exactly to informing the customer."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Structural end node matches the explicitly stated termination point."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "\"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Action faithfully captures opening the new order."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "perform an availability check."
      ],
      "justification": "Exact match for the availability check step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\"."
      ],
      "justification": "Branch accurately models the product availability decision."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "Guard and action capture the negative availability path and production step."
    },
    {
      "refs": [
        "guard:b2->c_prep"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\"."
      ],
      "justification": "Converge rejoins the production path; guard captures the positive availability path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Exact match for the preparation step."
    },
    {
      "refs": [
        "branch:b6"
      ],
      "verbatim_texts": [
        "Simultaneously,"
      ],
      "justification": "AND gateway correctly models simultaneous execution."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "Three actions accurately split the concurrent shipping, invoicing, and payment check tasks."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the payment is received,"
      ],
      "justification": "Converge rejoins parallel paths; action and branch model the payment receipt condition."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "close the order."
      ],
      "justification": "Guard and action model closing the order upon confirmed payment."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Guard and action model the reminder path for non-payment."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3,"
      ],
      "justification": "Action and branch model the reminder count condition accurately."
    },
    {
      "refs": [
        "guard:b4->c_status"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3,"
      ],
      "justification": "Converge and guard capture the continuation condition for fewer than 3 reminders."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Guard, action, and end node faithfully implement the final escalation, termination instruction, and process conclusion."
    }
