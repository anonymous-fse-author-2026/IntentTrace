@startuml
!theme plain
|a_default| Default
|a_default|
start
:check referee reports status;
:are referee reports completed?;
:v1: are referee reports completed? ({Completed, Referee Reports not completed}); <<objectSignal>>
if () then ([v1 = 'Referee Reports not completed'])
:flag and send reminder;
-> Referee Reports still not completed;
repeat :check again if referee reports are completed;
:are referee reports completed after reminder?;
:v2: are referee reports completed after reminder? ({Completed, Referee Reports still not completed after second check}); <<objectSignal>>
backward:flag and send another reminder;
repeat while () is ([v2 = 'Referee Reports still not completed after second check']) not ([v2 = 'Completed'])
else ([v1 = 'Completed'])
->;
endif
:proceed with process;
:organize interviews for selection panel with top candidates;
:receive feedback from interview candidates;
:is psychometric test required?;
:v3: is psychometric test required? ({Psychometric Test not required, HR Specialist required, Complete Psychometric Test}); <<objectSignal>>
switch ()
case ([v3 = 'Psychometric Test not required'])
:coordinate second round of selection;
-> Finalize process;
case ([v3 = 'HR Specialist required'])
:schedule psychometric test with third party;
-> Finalize process;
case ([v3 = 'Complete Psychometric Test'])
:complete psychometric test;
-> Finalize process;
endswitch
:request final candidate ranking and continue process;
stop
@enduml