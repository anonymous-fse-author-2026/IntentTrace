init(i1)
action(n1, "start the process by sending appointment approval form")
action(n2, "receive the approval")
action(n3, "contact TS to clarify the timing")
action(n4, "check the approval")
branch(n5, XOR)
action(n6, "authorize appointment for internal resource")
action(n7, "authorize appointment for external resource")
converge(c1)
action(n8, "send mandatory documentation and approval to HR services")
action(n9, "scan form and record into GovSource system")
action(n10, "check the approval again before sending to HR services")
action(n11, "send approval and mandatory documentation to HR services")
branch(n12, XOR)
action(n13, "no variations present")
action(n19, "complete business case and attach")
converge(c2)
action(n20, "end of process")
end(e1)
defines(v1, "is resource internal or external", {"internal", "external"})
defines(v3, "no variations present", {"no", "yes"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, n6, n7, c1, n8, n9, n10, n11, n12, n13, n19, c2, n20, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, n5)
precedence(n5, n6)
precedence(n5, n7)
precedence(n6, c1)
precedence(n7, c1)
precedence(c1, n8)
precedence(n8, n9)
precedence(n9, n10)
precedence(n10, n11)
precedence(n11, n12)
precedence(n12, n13)
precedence(n12, n19)
precedence(n13, c2)
precedence(n19, c2)
precedence(c2, n20)
precedence(n20, e1)
guard(n5, n6, v1 = "internal")
guard(n5, n7, v1 = "external")
guard(n12, n13, v3 = "no")
guard(n12, n19, v3 = "yes")