!theme plain
|a_default| Default
|a_default|
start
:wake up;
:are you hungry;
:v1: are you hungry ({hungry, not hungry}); <<objectSignal>>
if () then ([v1 = 'not hungry'])
:take shower;
else ([v1 = 'hungry'])
:have breakfast;
endif
:are you hungry again;
:v2: are you hungry again ({hungry, not hungry}); <<objectSignal>>
if () then ([v2 = 'not hungry'])
:take a shower;
else ([v2 = 'hungry'])
:have breakfast;
endif
:get on the bus;
stop
@enduml