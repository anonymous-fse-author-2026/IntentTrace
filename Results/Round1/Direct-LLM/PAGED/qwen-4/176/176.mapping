      "verbatim_texts": [
        "The loan application process starts with receiving the loan application."
      ],
      "justification": "The opening clause explicitly initiates the process and describes the first action step."
    },
    {
      "refs": [
        "action:n3",
        "action:n4",
        "label:b2->n3",
        "label:b2->n4"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps should be completed: assessing the loan risk and checking the credit history."
      ],
      "justification": "The term 'Simultaneously' triggers an AND gateway, and the enumerated tasks map directly to the parallel actions and their connection labels."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, the eligibility of the applicant is assessed."
      ],
      "justification": "'After that' implies the synchronization/convergence of the preceding parallel paths, followed by the eligibility assessment action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the applicant is eligible, the acceptance pack is prepared."
      ],
      "justification": "The conditional clause establishes an XOR branch and a positive guard condition, leading to the preparation action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the applicant is not eligible, the application is rejected."
      ],
      "justification": "The negative condition maps to the complementary guard value and the corresponding rejection action."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "If the application is rejected, the loan application process ends."
      ],
      "justification": "Explicitly denotes a process termination point following the rejection path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The prepared acceptance pack is then sent."
      ],
      "justification": "Directly corresponds to the send acceptance pack action step."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Once the acceptance pack is sent, the process ends."
      ],
      "justification": "Explicitly denotes the final process termination point on the successful path."
    }
  ],
