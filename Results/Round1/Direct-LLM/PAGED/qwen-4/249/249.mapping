{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To start the process for ACME Company,"
      ],
      "justification": "Explicit initiation phrase maps directly to the process start node."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "we first trigger the Resupply Cycle."
      ],
      "justification": "Action content faithfully reproduces the instruction to trigger the cycle."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, we check the inventory level."
      ],
      "justification": "Directly matches the inventory verification step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the inventory level is checked, we proceed to create a purchase order."
      ],
      "justification": "Faithfully captures the purchase order creation step."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the purchase order is not good, we reject it."
      ],
      "justification": "Branch represents the decision point, guard encodes the negative condition, and action executes the rejection."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if the purchase order is good, we approve it."
      ],
      "justification": "Guard encodes the positive condition and action executes the approval."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "In case the purchase order is rejected, we rework it."
      ],
      "justification": "Directly matches the rework instruction triggered by rejection."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase order is approved, we reserve funds for the purchase."
      ],
      "justification": "Faithfully reproduces the fund reservation step upon approval."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, we review it again."
      ],
      "justification": "Matches the mandatory review step following rework."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, we send the purchase order to the supplier."
      ],
      "justification": "Directly corresponds to transmitting the order to the supplier."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "Simultaneously",
        "we complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "AND gateway correctly models the concurrent execution explicitly signaled by 'Simultaneously'."
    },
    {
      "refs": [
        "action:n12",
        "action:n14"
      ],
      "verbatim_texts": [
        "we complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Two distinct actions faithfully split the compound instruction into individual receipt steps."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After receiving the packing slip, we record it."
      ],
      "justification": "Directly matches the recording step for the packing slip."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Similarly, after receiving the invoice, we record it as well."
      ],
      "justification": "Directly matches the recording step for the invoice."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Next, we release funds for payment and issue the payment."
      ],
      "justification": "Converge node joins the parallel receipt/recording paths before proceeding; actions faithfully split the combined funding/payment instruction."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued."
      ],
      "justification": "Explicit termination statement maps directly to the end node."
    }
  ],
