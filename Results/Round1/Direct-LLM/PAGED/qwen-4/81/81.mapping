  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For SSP: The first step is to receive and categorize the invoice."
      ],
      "justification": "The opening clause implicitly initiates the process and explicitly defines the first action step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the instruction is to \"Forward Invoice to Admin Officer\", then the next step is to sort the invoice."
      ],
      "justification": "The conditional opens the XOR branch, the guard captures the exact instruction value, and the action faithfully restates the sorting step."
    },
    {
      "refs": [
        "guard:b1->e2"
      ],
      "verbatim_texts": [
        "However, if the instruction is to \"Reject invoice\", then the process ends there."
      ],
      "justification": "The guard matches the rejection instruction exactly, and the end node corresponds to the explicit process termination described."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the instruction is to \"Return invoice to client for completion\", then the invoice is received and categorized again."
      ],
      "justification": "The guard and action capture the quoted instruction, while the converge node structurally models the loop-back implied by 'again'."
    },
    {
      "refs": [
        "guard:b1->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "Alternatively, if the instruction is to \"Process Invoice for SAP Entry\", then the invoice is forwarded for validation."
      ],
      "justification": "The guard precisely reflects the SAP entry instruction, and the action directly paraphrases the forwarding step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the invoice is forwarded for validation, it is then validated, and the process ends."
      ],
      "justification": "The action covers the validation step, and the end node aligns with the final termination clause."
    }
  ],
