@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start rector election process with rector's final year;
:Launch acceptance of proposals for rector candidates;
:Rector self-nominates as candidate;
:Stop acceptance of proposals;
:Candidate meets required criteria;
:v1: Candidate meets required criteria ({true, false}); <<objectSignal>>
if () then ([v1 = true])
:Include candidate in list of candidates;
:Make list of candidates public;
split
:Candidates promote ideas to public;
split again
:Organize public meeting of Academic Senate;
end split
repeat :;
:Begin public meeting for rectors voting;
:Conduct election and count votes;
:Voting successful;
:v2: Voting successful ({true, false}); <<objectSignal>>
backward:Conduct another election;
repeat while () is ([v2 = false]) not ([v2 = true])
:Announce election result;
:Conclude public meeting;
:Inform candidate of election results;
:End process;
stop
else ([v1 = false])
:Inform candidate of refusal and end process;
stop
endif
@enduml