{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "The opening clause establishes the process initiation and defines the first concrete action. The 'start' action faithfully extracts the lead-in phrasing without altering meaning."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request."
      ],
      "justification": "Captures the XOR decision point, the conditional check modeled as an action step, the 'No fee' guard routing to the positive arm, and the resulting registration action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "Maps the alternative branch condition ('Fee') and the corresponding mandatory action to create a purchase request."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Directly aligns with the explicit termination statement concluding the no-fee path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "Faithfully models the verification step as an action node that feeds directly into the second exclusive decision gateway."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Accurately reflects the positive approval condition and the subsequent notification receipt step."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Matches the negative rejection condition and the associated notification action on the alternate path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Precisely restates the required follow-up action triggered downstream of the approval notification."
    },
    {
      "refs": [
        "action:n10",
        "action:n12"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "Corresponds to the explicit termination clause on the rejection path. The duplicate end nodes/actions are included as permissible structural redundancy that does not alter flow behavior."
    }
  ],
