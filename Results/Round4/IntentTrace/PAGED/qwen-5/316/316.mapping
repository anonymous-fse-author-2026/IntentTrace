{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "The opening unit establishes the process start and describes the initial registration step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "Opens the XOR split, sets the 'Yes' guard for needing an exception, and models the request action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "label:n4->c1"
      ],
      "verbatim_texts": [
        "if an exception is not needed, the process can continue."
      ],
      "justification": "Sets the 'No' guard, models the continuation action, and adds a matching label on the flow."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "After the exception is approved, the next step is course enrollment,"
      ],
      "justification": "Models the approval check/wait as an action step, rejoins the flows, and proceeds to course enrollment. Re-typing a condition as an action preserves behaviour."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "followed by seminar group enrollment."
      ],
      "justification": "Direct paraphrase of the seminar enrollment step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the seminar group enrollment is completed, the homework assignment can be started."
      ],
      "justification": "Captures the transition to starting the homework assignment."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After working on the homework, it should be turned in."
      ],
      "justification": "Direct match for submitting the homework."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated, and the process can continue."
      ],
      "justification": "Direct match for the evaluation step."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Opens the homework loop split, uses 'No' for 'not last', and models assigning another homework."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "However, if it was the last homework, the process can continue."
      ],
      "justification": "Uses 'Yes' for 'last homework' and models the continuation action."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "Splits the parallel/concurrent steps into two actions and adds a converge point to preserve flow structure."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "After signing up for the exam,"
      ],
      "justification": "Direct match for the exam registration step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "it should be attended."
      ],
      "justification": "Direct match for attending the exam."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the exam is attended, it will be evaluated."
      ],
      "justification": "Direct match for the exam evaluation step."
    },
    {
      "refs": [
        "guard:b4->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue."
      ],
      "justification": "Opens the pass/fail split, sets 'Pass' guard, models the completion state, and adds structural converge/end nodes to close the flow."
    },
    {
      "refs": [
        "guard:b4->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Sets 'Fail' guard and models the retry sign-up action."
    }
  ],
