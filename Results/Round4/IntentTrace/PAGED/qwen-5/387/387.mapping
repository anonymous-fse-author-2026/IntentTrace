{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "Structural start and introductory action both align with the opening phrase."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "trigger the resupply cycle and then check the inventory level"
      ],
      "justification": "Captures the initial trigger step. The inventory check is decomposed into the subsequent branch/guards, which preserves behavior."
    },
    {
      "refs": [
        "guard:n3->n5"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum"
      ],
      "justification": "Opens the XOR decision for low inventory. Boolean guard variable abstracts the condition without changing decision logic."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "create a purchase order"
      ],
      "justification": "Direct match for the positive inventory branch outcome."
    },
    {
      "refs": [
        "guard:n3->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends"
      ],
      "justification": "Correctly models the high-inventory exit path and termination."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it"
      ],
      "justification": "Direct paraphrase of the review step."
    },
    {
      "refs": [
        "guard:n7->n9"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected"
      ],
      "justification": "Opens the second XOR decision and routes to the rejection path. Boolean guard preserves behavior."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "rework the purchase order"
      ],
      "justification": "Models the rework step. The converge node structurally captures the implicit loop back to review described in the source."
    },
    {
      "refs": [
        "guard:n7->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "reserve the funds"
      ],
      "justification": "Models the approval/reservation path. Approval is implied by the XOR branch opposite to rejection."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends"
      ],
      "justification": "Direct match for the packing slip recording and its corresponding process termination."
    }
  ],
