{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "Initial trigger and first two steps."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Eligibility decision and negative outcome."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Positive outcome of eligibility check."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Termination following the negative eligibility path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "perform an availability check."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b2->n7",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\"."
      ],
      "justification": "Sets up the availability decision and its two outgoing conditions."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not, start producing the missing parts."
      ],
      "justification": "Action taken when product is unavailable."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process."
      ],
      "justification": "Continuation path and structural rejoin after availability check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Prepare the products for shipment."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "AND-split and merge correctly model the simultaneous execution of three tasks."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Payment received decision and corresponding action."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Structural endpoint for the successful payment path."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Payment not received decision and corresponding action."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Loop condition ensuring continuation while reminders are below threshold."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Final threshold reached, triggers lawyer notification, explicit process action, and terminal node."
    }
  ],
