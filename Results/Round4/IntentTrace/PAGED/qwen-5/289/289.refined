init(i1)
end(e1)
action(a_start, "click Start then select Edit Report")
action(a_rev, "review the report")
action(a_chkTrans, "check if translation is needed")
action(a_trans, "translate the receipts")
action(a_conf, "confirm the receipts")
action(a_edit1, "edit the report")
