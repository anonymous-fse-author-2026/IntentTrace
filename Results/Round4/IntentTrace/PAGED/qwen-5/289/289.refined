action(a_transConf, "translate the receipts and then confirm them")
action(a_proc, "process the expense")
action(a_edit3, "edit the report")
branch(b_exp, XOR)
branch(b_trans, XOR)
branch(b_r1, XOR)
branch(b_r2, XOR)
branch(b_r3, XOR)
branch(b_r4, XOR)
branch(b_rec, XOR)
converge(c_rej)
converge(c_app)
defines(v_exp, "expense amount", {'>1000', '<=1000'})
defines(v_trans, "translation needed", {'Yes', 'No'})
defines(v_rev, "review decision", {'Rejected', 'Approved'})
defines(v_rec, "receipts decision", {'Accepted', 'Rejected'})
actor(a_default, "Default", [i1, a_start, a_rev, a_chkTrans, a_trans, a_conf, a_edit1, a_chkCont, a_edit2, a_transConf, a_proc, a_edit3, e1, b_exp, b_trans, b_r1, b_r2, b_r3, b_r4, b_rec, c_rej, c_app])
precedence(i1, a_start)
precedence(a_start, b_exp)
