precedence(a_edit2, e1)
precedence(a_proc, e1)
precedence(a_edit3, e1)
guard(b_exp, a_rev, v_exp = '>1000')
guard(b_exp, a_chkTrans, v_exp = '<=1000')
guard(b_trans, a_trans, v_trans = 'Yes')
guard(b_trans, a_conf, v_trans = 'No')
guard(b_r1, c_rej, v_rev = 'Rejected')
guard(b_r1, c_app, v_rev = 'Approved')
guard(b_r2, c_rej, v_rev = 'Rejected')
guard(b_r2, c_app, v_rev = 'Approved')
guard(b_r3, c_rej, v_rev = 'Rejected')
guard(b_r3, c_app, v_rev = 'Approved')
guard(b_r4, a_edit2, v_rev = 'Rejected')
guard(b_r4, a_transConf, v_rev = 'Approved')
guard(b_rec, a_proc, v_rec = 'Accepted')
guard(b_rec, a_edit3, v_rec = 'Rejected')