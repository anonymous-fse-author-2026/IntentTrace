      ],
      "verbatim_texts": [
        "The Parts Provision Team starts by requesting authorisation for extra Part(s)."
      ],
      "justification": "Covers process initiation and the initial authorization request step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the authorisation is given,"
      ],
      "justification": "Models the authorization check and the subsequent decision point."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "the requested Part(s) are obtained from stock"
      ],
      "justification": "Guard captures the positive condition; action models obtaining the parts."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Explicitly models the process termination described in the source."
    },
    {
      "refs": [
        "guard:b1->c2"
      ],
      "verbatim_texts": [
        "If the authorisation is not given,"
      ],
      "justification": "Guard models the negative condition directing flow to the stop/wait path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "work is stopped until the parts arrive."
      ],
      "justification": "Action models stopping work; converge nodes provide necessary structural plumbing for flow rejoin without changing behaviour."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the parts arrive,"
      ],
      "justification": "Action checks for part arrival; branch splits flow based on the arrival status."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "work resumes"
      ],
      "justification": "Guard and action model the positive arrival outcome leading to work resumption."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "work is stopped until the parts arrive."
      ],
      "justification": "Models the implicit loop-back condition when parts have not yet arrived, preserving the 'until' behaviour."
    }
  ],
