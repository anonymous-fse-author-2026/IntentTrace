{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "Initiates the process and executes the first compound step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "Branch splits flow based on inventory check; guard routes to the positive condition and subsequent action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Guard captures the negative condition; action restates it and terminates the process."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Direct implementation of the review step."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "Branch introduces the status decision; guard routes to the rejection path."
    },
    {
      "refs": [
        "guard:b2->n_reserve"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Guard routes to the approval path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Rework the purchase order and then review it."
      ],
      "justification": "Action performs the rework and implicit loop-back to review is structurally supported by the converge node."
    },
    {
      "refs": [
        "action:n_reserve"
      ],
      "verbatim_texts": [
        "Reserve the funds and send the order to the supplier."
      ],
      "justification": "Combines fund reservation and supplier dispatch into a single step, preserving behaviour."
    },
    {
      "refs": [
        "branch:b_par"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "AND gateway correctly models the simultaneous execution of the two receiving steps."
    },
    {
      "refs": [
        "action:n_recv_ps"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Direct implementation of the packing slip handling branch."
    },
    {
      "refs": [
        "action:n_recv_inv"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Direct implementation of the invoice handling branch."
    },
    {
      "refs": [
        "action:n_rec_ps"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Records the slip and terminates this parallel branch."
    },
    {
      "refs": [
        "action:n_rec_inv"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Records the invoice and terminates this parallel branch."
    }
  ],
