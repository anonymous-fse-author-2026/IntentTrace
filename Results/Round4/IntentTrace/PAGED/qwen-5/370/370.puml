!theme plain
|a_default| Default
|a_default|
start
:start the procedure;
:do you desire new hair;
:v1: do you desire new hair ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:visit the hairdresser;
:v_svc: hair service ({Wash, Cut, Dry}); <<objectSignal>>
switch ()
case ([v_svc = 'Wash'])
:have your hair washed;
case ([v_svc = 'Cut'])
:have your hair cut;
case ([v_svc = 'Dry'])
:have your hair dried;
endswitch
else ([v1 = 'No'])
->;
endif
:process complete you have obtained new hair;
