init(i1)
action(n1, "Identify Vacancy")
branch(b1, XOR)
action(n3, "Select Applicant")
action(n4, "Advertise Vacancy")
branch(b2, XOR)
action(n6, "Advertise Again")
end(e1)
defines(v1, "Any candidates available?", {"Yes", "No"})
defines(v2, "After advertising  any candidates?", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, b1, n3, n4, b2, n6, e1])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, b2)
precedence(b1, n4)
precedence(n4, b2)
precedence(b2, n3)
precedence(b2, n6)
precedence(n6, e1)
precedence(n3, e1)
guard(b1, b2, v1 = 'Yes')
guard(b1, n4, v1 = 'No')
guard(b2, n3, v2 = 'Yes')
guard(b2, n6, v2 = 'No')