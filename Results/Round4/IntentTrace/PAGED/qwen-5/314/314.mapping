    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "Condition for the negative path modeling unavailability."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then advertise the vacancy."
      ],
      "justification": "Action taken when no candidate is initially found."
    },
    {
      "refs": [
        "guard:b1->b2"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available"
      ],
      "justification": "Condition for the positive path proceeding to the next evaluation stage."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available",
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Second decision gateway re-evaluating availability before final selection."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available"
      ],
      "justification": "Condition for the second negative path modeling continued unavailability."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then advertise the vacancy again."
      ],
      "justification": "Action taken when a suitable candidate remains unavailable after continuation."
    },
    {
      "refs": [
        "guard:b2->n3"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Condition for the final positive path leading to selection."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Final selection step followed by process termination."
