{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks,"
      ],
      "justification": "Implicit start node and direct restatement of the initial action step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then they should select the method for exit control checks."
      ],
      "justification": "Directly captures the selection step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics, they should undergo a check using biometrics."
      ],
      "justification": "Models the XOR split and the biometric path with correct guarding and action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the passenger prefers to use ID documents, they should undergo checks using identity documents."
      ],
      "justification": "Models the alternative branch for ID documents."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends."
      ],
      "justification": "Covers the first instance of the negative outcome. Guard and action preserve the decision and flow."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Covers the corresponding positive outcome path and implicit continuation."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission, they should leave the area."
      ],
      "justification": "Covers the second, semantically identical description of the negative outcome. The model redundantly mirrors the source's repetition, which preserves behaviour."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Covers the second redundant description of the positive outcome and correctly marks process termination."
    }
  ],
