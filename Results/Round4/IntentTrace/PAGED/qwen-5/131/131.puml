@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process;
:empty the mailbox;
:check if mailbox is empty;
:v1: check if mailbox is empty ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:end process;
stop
else ([v1 = 'No'])
:check if mailbox is empty again;
:verify information completeness;
:v2: verify information completeness ({Complete, Not Complete}); <<objectSignal>>
if () then ([v2 = 'Complete'])
:add incoming mail number  date  and record in letter book;
else ([v2 = 'Not Complete'])
:make telephone call to sender;
:complete data by adding incoming mail number  date  and record in letter book;
endif
:take letter book and member register to Miranda every Wednesday evening;
:v3: check if applicant becomes a member ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:stamp 'new Member' on the letter and write date;
:After stamping "new Member" on the letter and writing the date on it, write the data.;
:calculate the fee and hand the letter to Charles. Ask Charles to write the amount in the register.;
:v4: post processing path ({card, invoice}); <<objectSignal>>
if () then ([v4 = 'card'])
:Print the membership card with all the data and send it to the new member.;
:The process ends.;
stop
else ([v4 = 'invoice'])
:Hand the letter to Charles and add the new member to the register.;
:Prepare an invoice for the new members and continue the process.;
:Ask Charles to write the amount in the register and write the fee amount to the register.;
endif
else ([v3 = 'No'])
:write to applicant and inform them of decision;
:end process;
endif
stop
endif
@enduml