@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the process;
:send: Course Packet Information Received;
repeat :;
:send: Design to Faculty;
:After sending the Design to Faculty, the Faculty will choose the design.;
:identify content requiring copyright clearance and contact publisher;
:v1: copyright status ({Denial, Cleared}); <<objectSignal>>
backward:notify: Contact Faculty to inform of denial and ask if new content should be added;
repeat while () is ([v1 = 'Denial']) not ([v1 = 'Cleared'])
:calculate: Course Packet Cost;
:add: Bookstore margin to determine retail price;
:v2: price status ({Finalized, Reconsider}); <<objectSignal>>
if () then ([v2 = 'Finalized'])
:notify: Notify Bookstore of Course packet  Course number  Faculty name  and sections;
:end: Packet information notified to Bookstore;
stop
else ([v2 = 'Reconsider'])
:reconsider content to decrease price;
endif
@enduml