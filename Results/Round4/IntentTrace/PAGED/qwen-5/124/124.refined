init(i1)
action(n2, "look at the order")
branch(b1, AND)
action(n4, "prepare assembling order")
action(n5, "check availability")
converge(c1)
branch(b2, XOR)
action(n7, "check availability again")
end(e1)
action(n9, "assemble bike")
action(n10, "ship product")
end(e2)
defines(v2, "backorder?", {"Yes", "No"})
actor(a_default, "Default", [i1, n2, b1, n4, n5, c1, b2, n7, e1, n9, n10, e2])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, c1)
precedence(n5, c1)
precedence(c1, b2)
precedence(b2, n7)
precedence(n7, e1)
precedence(b2, n9)
precedence(n9, n10)
precedence(n10, e2)
guard(b2, n7, v2 = 'Yes')
guard(b2, n9, v2 = 'No')