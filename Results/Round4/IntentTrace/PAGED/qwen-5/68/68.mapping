{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "Initializes the workflow and represents the starting trigger."
    },
    {
      "refs": [
        "guard:b1->n3",
        "guard:b1->n3_alt",
        "action:n2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process. However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Captures the initial method-of-return split and routes both paths forward."
    },
    {
      "refs": [
        "action:n3",
        "action:n3_alt"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Directly implements the inventory verification step following the return."
    },
    {
      "refs": [
        "guard:b2->n5",
        "guard:b2->n6",
        "guard:b2->n9",
        "action:n4",
        "action:n5",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Models the three-way decision on order status and applies the correct immediate actions for each branch."
    },
    {
      "refs": [
        "guard:b3->n15",
        "guard:b3->n15_alt",
        "action:n_i13",
        "action:n15",
        "action:n15_alt"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\" we continue the process. Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Correctly structures the first disposition decision between packing and storage."
    },
    {
      "refs": [
        "action:n_i14",
        "action:n6"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Implements the notification step for incomplete orders."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Directly matches the inventory removal action for damaged goods."
    },
    {
      "refs": [
        "guard:b4->n8",
        "guard:b4->n8_alt",
        "action:n7",
        "action:n_i16",
        "action:n8",
        "action:n8_alt"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process. However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Captures the conditional flow based on customer follow-up for missing items."
    },
    {
      "refs": [
        "guard:b5->n12",
        "guard:b5->n13",
        "action:n11",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Models the repair assessment split and corresponding outcomes accurately."
    },
    {
      "refs": [
        "guard:b6->n16",
        "guard:b6->n16_alt",
        "action:n14",
        "action:n16",
        "action:n16_alt"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\" we continue the process. If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Preserves the repeated disposition logic present later in the source text."
    }
  ],
