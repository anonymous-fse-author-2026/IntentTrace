      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "the process begins by entering expenses."
      ],
      "justification": "Captures process initiation and the first action step. The converge node structurally merges split flows returning to this point, which aligns with the described loop-back behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "generate a spreadsheet"
      ],
      "justification": "Directly corresponds to the second sequential step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the request can be approved or disapproved."
      ],
      "justification": "Models the first decision point where execution paths split based on the approval outcome."
    },
    {
      "refs": [
        "guard:b1->n1"
      ],
      "verbatim_texts": [
        "If the request is not approved, the process goes back to entering expenses."
      ],
      "justification": "Correctly captures the negative branch condition that routes control back to the expense-entry step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the request is approved"
      ],
      "justification": "Captures the positive branch condition that proceeds toward payout."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "expenses can be paid out."
      ],
      "justification": "Direct match for the payout action triggered by initial approval."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Models the second verification/decision point occurring after the payout step."
    },
    {
      "refs": [
        "guard:b2->n1"
      ],
      "verbatim_texts": [
        "If it is not approved, the process goes back to entering expenses."
      ],
      "justification": "Correctly models the second negative branch looping back to the initial expense-entry action."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "But if it is approved"
      ],
      "justification": "Captures the second positive branch condition that leads to process completion."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Finally, after the expenses are paid out, the process comes to an end."
      ],
      "justification": "Fulfils the final approval trigger and maps to the terminal action and end node."
    }
  ],
