      "id": "i1",
      "content": "To start the process, begin by receiving the claim."
    },
    {
      "id": "i2",
      "content": "Then, create the claim and record it."
    },
    {
      "id": "i3",
      "content": "After that, make a decision on the claim."
    },
    {
      "id": "i4",
      "content": "If the claim is to be rejected"
    },
    {
      "id": "i5",
      "content": "then reject it."
    },
    {
      "id": "i6",
      "content": "if the claim is to be accepted"
    },
    {
      "id": "i7",
      "content": "offer the benefit."
    },
    {
      "id": "i8",
      "content": "review the claim rejection."
    },
    {
      "id": "i9",
      "content": "prepare the claim discharge."
    },
    {
      "id": "i10",
      "content": "Once the claim discharge is prepared, record the benefit payment."
    },
    {
      "id": "i11",
      "content": "If the claim rejection is accepted"
    },
    {
      "id": "i12",
      "content": "continue the process."
    },
    {
      "id": "i13",
      "content": "But if the claim rejection is not accepted"
    },
    {
      "id": "i14",
      "content": "also continue the process."
    },
    {
      "id": "i17",
      "content": "operate outgoing payment and close the claim."
