{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by checking the customer's order."
      ],
      "justification": "Initial trigger and first action step correspond directly to the opening instruction."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the customer is a registered customer, then check their payment morale."
      ],
      "justification": "XOR gateway and positive guard route registered customers to payment morale check."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they are a new customer, then check their status."
      ],
      "justification": "Negative guard routes new customers to status check."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If their payment morale is good, continue with the process."
      ],
      "justification": "Decision on morale with good outcome continuing the flow."
    },
    {
      "refs": [
        "guard:b2->c1",
        "guard:b3->c1",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If their payment morale is bad or if they are an end customer, reject the order and end the process."
      ],
      "justification": "Converges bad morale and end-customer paths to execute rejection and termination. Structural elements preserve the disjunction."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the customer is a wholesaler, enter their data and take the order."
      ],
      "justification": "Wholesaler branch correctly executes data entry and order acceptance."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, check the availability of the items."
      ],
      "justification": "Directly models the availability check step."
    },
    {
      "refs": [
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the items are out of stock, start production."
      ],
      "justification": "Out-of-stock condition correctly triggers production."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If they are in stock, continue with the process."
      ],
      "justification": "In-stock condition correctly continues the main flow."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Once the availability is checked, send the order confirmation."
      ],
      "justification": "Models sending confirmation post-availability check."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If production is started, produce the article and send the order confirmation."
      ],
      "justification": "Splits compound sentence into two sequential actions, preserving behaviour."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Simultaneously, send the invoice and deliver the product."
      ],
      "justification": "Captures concurrent delivery/invoicing and merges parallel flows."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check the payment status."
      ],
      "justification": "Payment status verification modeled as an action step."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If payment is received, close the order."
      ],
      "justification": "Positive payment path closes the order and terminates this branch."
    },
    {
      "refs": [
        "guard:b5->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If no payment is received, check the number of reminders."
      ],
      "justification": "Negative payment path proceeds to reminder count evaluation."
    },
    {
      "refs": [
        "guard:b6->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If there are more than three reminders, engage a lawyer."
      ],
      "justification": "High reminder threshold correctly engages legal action and ends path."
    },
    {
      "refs": [
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are three or fewer reminders, send a reminder."
      ],
      "justification": "Low/equal reminder threshold sends reminder and collects flow."
    }
  ],
