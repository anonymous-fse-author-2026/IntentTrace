{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process, begin by supplying the requirement and then documenting it."
      ],
      "justification": "The opening unit implicitly starts the process and describes the initial supply and documentation steps."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the order is received via fax, input the order into an Excel file."
      ],
      "justification": "Captures the fax path of the channel decision and the resulting Excel input action."
    },
    {
      "refs": [
        "guard:b1->n5_x",
        "action:n5_x"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone, also input the order into an Excel file."
      ],
      "justification": "Captures the mail/phone path and logging action; shares the branch/converge structure with the fax path."
    },
    {
      "refs": [
        "action:n5_wait",
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete after a week, send it to the student."
      ],
      "justification": "Models the one-week wait condition and the subsequent sending step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list, type the orders into the MS-Access database."
      ],
      "justification": "Directly corresponds to the database typing step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed."
      ],
      "justification": "Matches the completion verification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the database is completed, control the incoming order."
      ],
      "justification": "Direct paraphrase of the control step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "At the same time, continue to do the check."
      ],
      "justification": "Exact restatement of the concurrent check step."
    },
    {
      "refs": [
        "action:n11",
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the order is correct, release it."
      ],
      "justification": "Opens the correctness decision and captures the positive release outcome."
    },
    {
      "refs": [
        "guard:b2->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Captures the negative correctness branch and the contact action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Send the Excel list to the student and upon receiving it, continue with the process."
      ],
      "justification": "Direct restatement of the follow-up process continuation step."
    },
    {
      "refs": [
        "action:n15",
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac, release it."
      ],
      "justification": "Opens the value decision and captures the lower-threshold release path."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "Captures the higher-threshold branch splitting into sign-off and continued check tasks."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
      ],
      "justification": "Directly models the agency contact and sign-off forwarding step."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Once the order is signed off, contact the client and release the order."
      ],
      "justification": "Combines client contact and order release as described."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "Matches the production initiation step."
    },
    {
      "refs": [
        "action:n24",
        "guard:b4->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order."
      ],
      "justification": "Opens the solvability decision and captures the cancellation path."
    },
    {
      "refs": [
        "guard:b4->n27",
        "action:n27"
      ],
      "verbatim_texts": [
        "If the issue can be solved, release the order."
      ],
      "justification": "Captures the solvable branch leading to order release."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "After PPC initiates production, the goods will be produced."
      ],
      "justification": "Directly models the goods production step."
    },
    {
      "refs": [
        "action:n31"
      ],
      "verbatim_texts": [
        "If not, check the quality of the goods."
      ],
      "justification": "Matches the alternative quality check step."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "justification": "Directly corresponds to the report creation and sending step."
    },
    {
      "refs": [
        "action:n33",
        "action:n34"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "justification": "Splits the memo release and warehouse verification into two aligned actions."
    },
    {
      "refs": [
        "guard:b_post->n35",
        "action:n35",
        "action:n36"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "justification": "Models the invoice path and financial reporting within the post-processing split."
    },
    {
      "refs": [
        "guard:b_post->n37",
        "action:n37",
        "action:n38"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods and sign and send the memo."
      ],
      "justification": "Models the goods commissioning and memo signing path."
    },
    {
      "refs": [
        "guard:b_post->n39",
        "action:n39",
        "action:n40"
      ],
      "verbatim_texts": [
        "Also, send the goods and ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "Models the goods dispatch and logistics verification path."
    },
    {
      "refs": [
        "action:n41"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order."
      ],
      "justification": "Directly matches the archival and closing step."
    },
    {
      "refs": [
        "action:n42"
      ],
      "verbatim_texts": [
        "This marks the end of the process."
      ],
      "justification": "Explicitly models the final termination point."
    }
  ],
