{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle."
      ],
      "justification": "The opening unit implicitly starts the process and describes the initial action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, check the current inventory level."
      ],
      "justification": "Direct correspondence to the second step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory level is above the minimum, then the process ends."
      ],
      "justification": "Captures the first branch condition, the 'above' guard value, the explicit end-action restatement, and the terminal node."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the inventory level is below the minimum, create a purchase order."
      ],
      "justification": "Captures the alternative branch condition ('below') and the resulting purchase order creation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the purchase order is created, review it."
      ],
      "justification": "Direct paraphrase of the review step following PO creation."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the purchase order is rejected, rework the purchase order."
      ],
      "justification": "Opens the second decision gateway, captures the 'rejected' guard, and models the rework action."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "But if the purchase order is accepted, continue the process."
      ],
      "justification": "Captures the positive outcome guard for the second decision."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After reworking the purchase order, review it again."
      ],
      "justification": "Matches the post-rework review step."
    },
    {
      "refs": [
        "label:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: reserve funds for the purchase and send the purchase order to the supplier."
      ],
      "justification": "The label preserves the concurrency marker ('At the same time'), and the action merges the two parallel steps described in the unit."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, release the reserved funds and then the process ends."
      ],
      "justification": "Models the final reception/action step, the explicit completion restatement, and the final termination node."
    }
  ],
