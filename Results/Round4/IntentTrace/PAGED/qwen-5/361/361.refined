init(i1)
action(n2, "trigger: resupply cycle")
action(n3, "check: inventory level")
branch(b1, XOR)
action(n4, "end process: above minimum")
end(e1)
action(n5, "create: purchase order")
action(n6, "review: purchase order")
branch(b2, XOR)
action(n7, "rework: purchase order")
action(n8, "review: purchase order")
action(n9, "reserve funds and send PO")
action(n10, "receive packing slip and release funds")
action(n11, "end process: completed")
end(e2)
defines(v1, "check: inventory level", {'above', 'below'})
defines(v2, "review: purchase order", {'rejected', 'accepted'})
actor(a_default, "Default", [i1, n2, n3, b1, n4, e1, n5, n6, b2, n7, n8, n9, n10, n11, e2])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(n4, e1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, b2)
precedence(b2, n9)
precedence(b2, n7)
precedence(n7, n8)
precedence(n8, b2)
precedence(n9, n10)
precedence(n10, n11)
precedence(n11, e2)
guard(b1, n4, v1 = 'above')
guard(b1, n5, v1 = 'below')
guard(b2, n9, v2 = 'accepted')
guard(b2, n7, v2 = 'rejected')
label(b2, n9, "At the same time")