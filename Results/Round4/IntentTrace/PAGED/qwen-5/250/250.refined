init(i1)
action(n2, "pick up order")
action(n3, "request stock check")
action(n4, "check inventory")
branch(b1, XOR)
action(n6, "end process - stock rejected")
end(e1)
action(n7, "request shipping details")
action(n8, "receive shipping details")
branch(b2, AND)
action(n9, "send goods")
action(n10, "send invoice")
converge(c1)
action(n11, "receive payment")
action(n12, "end process")
end(e2)
branch(b3, XOR)
defines(v1, "is stock rejected?", {"Yes", "No"})
defines(v2, "post request path", {"receive_details", "send_goods_invoice"})
actor(a_default, "Default", [i1, n2, n3, n4, b1, n6, e1, n7, n8, b2, n9, n10, c1, n11, n12, e2, b3])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n6)
precedence(b1, n7)
