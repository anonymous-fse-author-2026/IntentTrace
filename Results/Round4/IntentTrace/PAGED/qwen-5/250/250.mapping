    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the supplier, the first step is to pick up the order."
      ],
      "justification": "Implies process start and directly models the initial action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After picking up the order, the next step is to request a stock check."
      ],
      "justification": "Direct correspondence to the second step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the stock check is requested, the inventory should be checked."
      ],
      "justification": "Direct correspondence to the third step."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If the stock is rejected,"
      ],
      "justification": "Models the XOR decision point and captures the conditional trigger. Mapping rejection to v1='Yes' is a harmless re-typing that preserves the branch logic."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then the process ends."
      ],
      "justification": "Models the termination action and endpoint for the rejection path."
    },
    {
      "refs": [
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "Otherwise,"
      ],
      "justification": "Captures the negative/default branch of the decision."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the supplier should request shipping details."
      ],
      "justification": "Direct paraphrase of the continuation step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After requesting the shipping details, they should receive the shipping details."
      ],
      "justification": "Direct correspondence to receiving the details."
    },
    {
      "refs": [
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "After requesting the shipping details, they should receive the shipping details."
      ],
      "justification": "Structural plumbing routing flow toward the receive step. Does not alter behaviour."
    },
    {
      "refs": [
        "guard:b3->b2",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "At the same time, the supplier should also send the goods and send the invoice."
      ],
      "justification": "Routes flow to the AND-split and join, correctly modelling the concurrent execution described by 'at the same time'. Guard values are artificial routing labels that preserve the intended flow."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the payment is received,"
      ],
      "justification": "Captures the final payment step and the implicit process termination stated in the full sentence context."
    }
