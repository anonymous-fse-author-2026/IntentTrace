init(i1)
action(n1, "Resupply Cycle Triggered")
action(n2, "checking the Inventory Level")
branch(b1, XOR)
action(n4, "Create Purchase Order")
end(e1)
action(n6, "Reviewing the Purchase Order")
branch(b2, XOR)
action(n8, "reserve the funds for the purchase")
action(n9, "rework the order")
action(n10, "send the Order to Suppliers")
action(n12, "Supplier sends a packing slip")
action(n13, "Supplier sends an invoice")
action(n14, "record packing slip")
action(n15, "record invoice")
action(n16, "release the reserved funds and issue the payment to the supplier")
end(e2)
converge(c1)
branch(b3, AND)
converge(c2)
defines(v1, "Inventory Level", {'at or below minimum', 'above minimum'})
defines(v2, "Purchase Order Status", {'approved', 'rejected'})
actor(a_default, "Default", [i1, n1, n2, b1, n4, e1, n6, b2, n8, n9, n10, b3, n12, n13, n14, n15, c1, n16, e2, c2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, e1)
precedence(n4, c2)
precedence(c2, n6)
precedence(n6, b2)
precedence(b2, n8)
precedence(b2, n9)
precedence(n8, n10)
precedence(n9, c2)
precedence(n10, b3)
precedence(b3, n12)
precedence(b3, n13)
precedence(n12, n14)
precedence(n13, n15)
precedence(n14, c1)
precedence(n15, c1)
precedence(c1, n16)
precedence(n16, e2)
guard(b1, n4, v1 = 'at or below minimum')
guard(b1, e1, v1 = 'above minimum')
guard(b2, n8, v2 = 'approved')
guard(b2, n9, v2 = 'rejected')