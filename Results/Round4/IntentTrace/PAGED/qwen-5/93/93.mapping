{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "At the start, we receive a form."
      ],
      "justification": "Captures the process initiation and the first step of receiving the form."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "we check if it is complete"
      ],
      "justification": "Represents the completeness check and the resulting decision split."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If it needs to be sent back, the process ends."
      ],
      "justification": "Maps the 'sent back' condition, the corresponding action, and the process termination."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if we need to check the income, we continue with the process."
      ],
      "justification": "Captures the alternative income-check condition and the continuation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "At the same time, we complete the following steps: checking deductibles and checking the house."
      ],
      "justification": "Combines the two sub-steps into a single action node, preserving overall behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Then, we make a decision."
      ],
      "justification": "Represents the second decision point introduced before the final branching."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If we need to check the declaration, the process ends."
      ],
      "justification": "Maps the declaration-check condition directly to process termination."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Otherwise, if we need to invite the declarant, the process also ends."
      ],
      "justification": "Captures the final condition, the invitation step, and the resulting process end."
    }
  ],
