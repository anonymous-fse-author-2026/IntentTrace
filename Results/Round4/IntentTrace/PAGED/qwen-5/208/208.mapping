      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Tissue processing, check if \"Digitalization?\" is required."
      ],
      "justification": "Models concurrent tissue processing and establishes the XOR decision gateway for digitalization."
    },
    {
      "refs": [
        "guard:b1->n12"
      ],
      "verbatim_texts": [
