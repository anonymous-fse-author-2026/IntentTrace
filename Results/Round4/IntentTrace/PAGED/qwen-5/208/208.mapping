      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "Initiates the process and models receiving the gross pathology request as the first actionable step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed with the Registration gross pathology request."
      ],
      "justification": "Captures the registration step and the required barcode creation. Minor reordering/placement difference does not alter behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "make sure to create a barcode scan at the start."
      ],
      "justification": "Captures the registration step and the required barcode creation. Minor reordering/placement difference does not alter behaviour."
    },
    {
