@startuml
!theme plain
|a_default| Default
|a_default|
start
:analyze the insurance agreement;
:v1: coverage status ({Coverage, No Coverage}); <<objectSignal>>
if () then ([v1 = 'Coverage'])
:offer immediate help;
else ([v1 = 'No Coverage'])
:send out an offer for emergency help;
:v2: offer decision ({Accepted, Rejected}); <<objectSignal>>
if () then ([v2 = 'Rejected'])
:ask for a rejection notification;
else ([v2 = 'Accepted'])
:proceed with internal accounting;
endif
endif
:repeat the same steps if necessary;
:v3: repeat decision ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'No'])
:conclude the process once all steps have been completed;
stop
endif
@enduml