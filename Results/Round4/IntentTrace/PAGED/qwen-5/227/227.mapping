      "verbatim_texts": [
        "To begin the process, start with Insurance \"emergency\""
      ],
      "justification": "Structural start node aligned with the opening phrase indicating process initiation."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "analyze the insurance agreement"
      ],
      "justification": "Directly matches the first procedural step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there is coverage, offer immediate help."
      ],
      "justification": "Captures the positive decision branch, its condition, and the resulting action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is no coverage, send out an offer for emergency help."
      ],
      "justification": "Captures the alternative decision branch condition and corresponding action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the offer is rejected, ask for a rejection notification."
      ],
      "justification": "Models the rejection condition and follow-up step accurately."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is accepted, proceed with internal accounting."
      ],
      "justification": "Models the acceptance condition and follow-up step accurately."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->c1"
      ],
      "verbatim_texts": [
        "Repeat the same steps if necessary."
      ],
      "justification": "Correctly represents the conditional loop logic and flow convergence."
    },
    {
      "refs": [
        "action:n12",
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "The process concludes once all steps have been completed."
      ],
      "justification": "Accurately models the termination condition and final process endpoint."
    }
