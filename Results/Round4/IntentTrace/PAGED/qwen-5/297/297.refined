branch(b1, XOR)
action(n3b, "Check if the mailbox is empty again,")
action(n4, "The process ends.")
end(e1)
action(n5, "continue the process")
action(n6, "check if mailbox is empty again?")
action(n9, "verify if information is complete?")
branch(b3, XOR)
action(n10, "add incoming mail number  date and record in letter book")
action(n11, "make a telephone call to sender")
action(n12, "complete data by adding incoming mail number  date and record in letter book")
action(n13, "every wednesday evening: take books to miranda")
branch(b4, XOR)
action(n14, "applicant becomes member")
action(n15, "stamp 'new member' on the letter and write date")
action(n16, "write data in the letter book")
action(n17, "calculate fee")
action(n18, "hand the letter to charles and ask to write amount in register")
action(n19, "print membership card with all data and send to new member")
action(n22, "end the process")
end(e3)
action(n23, "applicant cannot become member")
action(n24, "write to applicant and inform decision")
end(e4)
converge(c1)
converge(c2)
branch(b7, AND)
action(n20, "Hand the letter to Charles and add the new member to the register")
action(n21, "Prepare an invoice for the new members and continue the process")
action(n17b, "Ask Charles to write the amount in the register.")
