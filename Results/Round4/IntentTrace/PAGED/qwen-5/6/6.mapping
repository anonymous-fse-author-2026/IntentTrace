      ],
      "verbatim_texts": [
        "To start, ask the 1st Level Support if there is an issue."
      ],
      "justification": "Covers the process initialization and the first step of contacting 1st Level Support."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the issue is resolved, provide feedback for the account manager."
      ],
      "justification": "Models the positive resolution branch with the correct condition and resulting feedback action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If it is a 1st Level issue, ask the developer for assistance."
      ],
      "justification": "Correctly captures the alternative branch for unresolved 1st Level issues and the corresponding developer request."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Then, check the result again."
      ],
      "justification": "Directly corresponds to re-evaluating the situation. The slight rewording preserves the intended check."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "After that, provide feedback for the account manager and end the process."
      ],
      "justification": "Captures the second resolution path: confirming resolution, providing feedback, and terminating. Splitting into actions preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is still a 1st Level issue, ask the developer for help."
      ],
      "justification": "Accurately models the condition where the issue persists after the second check, triggering the help request."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Ask the developer and then provide feedback for the 1st Level support."
      ],
      "justification": "Matches the sequential steps exactly, appropriately split into two action nodes."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Finally, provide feedback for the 1st Level support and then provide feedback for the account manager."
      ],
      "justification": "Direct match for the concluding steps and process termination."
    }
