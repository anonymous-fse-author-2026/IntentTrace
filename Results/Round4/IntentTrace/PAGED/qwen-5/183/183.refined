init(s0)
action(n2, "Add image description and upload image")
branch(b1, XOR)
action(n4, "End process (success)")
end(e1)
action(n5, "Try again?")
branch(b2, XOR)
action(n6, "End process with error")
end(e2)
converge(c1)
defines(v1, "Was image upload successful?", {"Yes", "No"})
defines(v2, "Try again?", {"No", "Yes"})
actor(a_default, "Default", [s0, n2, b1, n4, e1, n5, b2, n6, e2, c1])
precedence(s0, c1)
precedence(c1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, e1)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, c1)
precedence(n6, e2)
guard(b1, n4, v1 = 'Yes')
guard(b1, n5, v1 = 'No')
guard(b2, n6, v2 = 'No')
guard(b2, c1, v2 = 'Yes')