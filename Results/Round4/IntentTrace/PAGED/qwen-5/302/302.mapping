    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the Drop-off tech process, the customer is first informed about canceling the order."
      ],
      "justification": "Covers process initialization and the first actionable step of informing the customer."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "Then, the question arises: has the order already been fulfilled?"
      ],
      "justification": "Models the decision point and its two outcomes. Modeling the question as an action step plus a branch/guards preserves the intended XOR split."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the bag is marked as returned in IS.",
        "If the bag is indeed returned, it is marked as such in IS."
      ],
      "justification": "Both source units describe the same positive outcome. The source repetition is collapsed into a single step without altering behaviour."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the script(s) are marked as declined by the customer in IS.",
        "On the other hand, if the bag is not returned, the script(s) are marked as declined by the customer in IS."
      ],
      "justification": "Both source units describe the same negative outcome. Redundancy in the text is correctly unified into one model step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the bag is marked as returned in IS, the script bag is returned as well."
      ],
      "justification": "Direct correspondence to the follow-up action on the script bag."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Similarly, when the script(s) are marked as declined by the customer in IS, the script order is declined."
      ],
      "justification": "Direct correspondence to the follow-up action on the script order."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the customer notification is processed"
      ],
      "justification": "Direct match to the post-branch notification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the entire process comes to an end"
      ],
      "justification": "Captures the merging of paths, the explicit ending action, and the process termination node."
    }
  ],
