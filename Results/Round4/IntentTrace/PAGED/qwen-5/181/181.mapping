{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "Implicit process start and the first action of sending the form."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Direct match for receiving the approval."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Direct match for contacting TS."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Direct match for checking the approval."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized."
      ],
      "justification": "Correctly models the XOR split for internal resources with an accurate guard and corresponding action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Correctly models the alternative branch for external resources with matching guard and action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Faithfully restates the requirement to send documentation to HR."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Direct match for scanning and recording the form."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Redundant restatement of the sending step combined with checking; behaviour is preserved."
    },
    {
      "refs": [
        "action:n12",
        "action:n19"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Captures the reception step, the explicit process termination action, and the structural end node."
    },
    {
      "refs": [
        "guard:b2->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Correctly models the continuation path when no variations exist."
    },
    {
      "refs": [
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed."
      ],
      "justification": "Correctly models the variations path and the completion of the business case."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed and attached."
      ],
      "justification": "Slightly more detailed restatement of the business case step including attachment; converge rejoins the flow. Behaviour is preserved."
    }
  ],
