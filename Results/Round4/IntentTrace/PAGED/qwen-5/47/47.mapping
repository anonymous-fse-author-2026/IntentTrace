{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Captures the process start and the first two sequential actions exactly as described."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Models the completeness check as an action followed by a decision branch. The 'No' guard routes to returning the invoice, preserving the stated behaviour."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "The 'Yes' guard from the completeness decision routes flow forward to the next stage, matching the continuation logic."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Checks compliance status. The 'No' guard correctly directs non-compliant invoices to further checks, preserving the decision outcome."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "The 'Yes' guard routes compliant invoices forward, with the action explicitly stating process continuation. Behaviour matches."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Evaluates resolution method. The 'Yes' guard leads to resolving non-compliance via phone, aligning with the source condition and outcome."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "The 'No' guard routes issues requiring mail back to returning the invoice, matching the negative branch behaviour."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Structural convergence gathers flows before executing the invoice payment step. Behaviour is preserved."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Directly captures the client billing step. Parallel execution is handled by model structure; the action itself matches."
    },
    {
      "refs": [
        "action:n21",
        "guard:b8->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Checks for client response. The 'None' guard correctly triggers the 10-day wait period when no response occurs."
    },
    {
      "refs": [
        "action:n19",
        "guard:b8->n19"
      ],
      "verbatim_texts": [
        "If the invoice is returned, non-compliance is resolved."
      ],
      "justification": "Captures the conditional resolution of non-compliance upon return. The guard and action pair preserve the stated behaviour."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Corresponds to the client notification step following payment. Direct behavioural match."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Models sending the reminder and explicitly terminating the process. Matches the final step description."
    },
    {
      "refs": [
        "action:n27",
        "guard:b9->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Evaluates client satisfaction. The 'No' guard correctly routes dissatisfaction to discrepancy resolution."
    },
    {
      "refs": [
        "guard:b9->n29",
        "action:n29"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "The 'Yes' guard routes satisfied clients to process continuation, preserving the positive branch logic."
    }
  ],
