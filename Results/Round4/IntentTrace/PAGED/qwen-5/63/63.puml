@startuml
!theme plain
|a_default| Default
|a_default|
start
:start with Password Verification;
:Verify Password;
:v1: choose option ({Select Cancel, Reset password, Retry}); <<objectSignal>>
switch ()
case ([v1 = 'Select Cancel'])
:directed to iforgot.apple.com;
case ([v1 = 'Reset password'])
:automatically directed to iforgot.apple.com;
case ([v1 = 'Retry'])
:re-enter your password;
:verify it;
:go to iforgot.apple.com and proceed with Reset Password;
endswitch
:return to the iTunes purchases page;
:select the price of the item;
:v2: prompt to Enter Password or Enter Apple ID ({Enter Password, Enter Apple ID}); <<objectSignal>>
if () then ([v2 = 'Enter Password'])
:verify the password;
else ([v2 = 'Enter Apple ID'])
:enter the password;
:verify the password;
endif
:Finally, enter the password and verify it;
stop
@enduml