@startuml
!theme plain
|a_default| Default
|a_default|
start
:identify the parts;
:v1: branch_condition ({ElicitInfo, HaveAvail, PartsSupplied, RecordDetails}); <<objectSignal>>
switch ()
case ([v1 = 'HaveAvail'])
:already have availability information;
case ([v1 = 'ElicitInfo'])
:check availability of parts;
case ([v1 = 'PartsSupplied'])
:parts supplied to customer;
case ([v1 = 'RecordDetails'])
:order and receive part from Disuki;
endswitch
:contract the customer;
:proceed with payment;
:end process;
stop
@enduml