{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "Marks the implicit process start and captures the explicit initial action of identifying parts."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer, they should then check the availability of the parts."
      ],
      "justification": "Opens the decision gateway and models the first alternative path: the elicitation condition triggers checking availability."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "On the other hand, if they already have the availability information, they can proceed with the process."
      ],
      "justification": "Models the second alternative path: the pre-existing availability condition leads to proceeding."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer, the team can also continue with the process."
      ],
      "justification": "Models the third alternative path: the supplied-parts condition leads to continuing."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if they need to record the customer's details, they should order and receive the part from Disuki."
      ],
      "justification": "Models the fourth alternative path: the recording-details condition triggers ordering and receiving the part."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer, they should then check the availability of the parts.",
        "On the other hand, if they already have the availability information, they can proceed with the process.",
        "If the parts are supplied to the customer, the team can also continue with the process.",
        "However, if they need to record the customer's details, they should order and receive the part from Disuki."
      ],
      "justification": "Structural join point that reunites the four conditional paths before the process continues to the next phase."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "Directly models the contracting step that follows part receipt."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected, the team can proceed with the payment."
      ],
      "justification": "Directly models the payment step following part collection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "Models the final action and marks the explicit termination of the process."
    }
  ],
