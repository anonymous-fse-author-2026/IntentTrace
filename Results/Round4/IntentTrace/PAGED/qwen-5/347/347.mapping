      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "Covers process initiation and the first sequential steps. Splitting the opening sentence into three distinct actions preserves the original behaviour."
    },
    {
      "refs": [
        "guard:b1->a4",
        "action:a4"
      ],
      "verbatim_texts": [
        "is below or equal to the minimum, generate an Equal to or below minimum Report"
      ],
      "justification": "XOR branch and its positive arm. The guard uses an abstracted boolean variable, which correctly represents the threshold condition without changing behaviour."
    },
    {
      "refs": [
        "guard:b1->a5",
        "action:a5"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report"
      ],
      "justification": "Negative arm of the inventory check branch. Guard abstraction preserves decision logic."
    },
