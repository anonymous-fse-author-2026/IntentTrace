    },
    {
      "refs": [
        "guard:b2->a8",
        "action:a8"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Second XOR branch handling the rejection path. Abstract guard correctly routes to the rework action."
    },
    {
      "refs": [
        "guard:b2->a9",
        "action:a9"
