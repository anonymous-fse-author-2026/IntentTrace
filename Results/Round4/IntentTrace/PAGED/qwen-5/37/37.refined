init(i1)
action(n1, "start process for WIGGO by placing an Order")
action(n2, "Check the Customers Credit Limit")
action(n4, "Check the Availability of the Article")
branch(b1, XOR)
action(n5, "Send a Denial to the Customer due to Credit Limit")
branch(b3, XOR)
action(n10, "Produce the Goods")
action(n11, "Collect the Goods")
converge(c1)
action(n12, "Send an Order Confirmation")
branch(b6, AND)
action(n13, "Ship the Goods")
action(n14, "Send the Invoice")
converge(c2)
converge(c3)
action(n15, "Check the Payment status")
branch(b4, XOR)
action(n17, "Close the Order due to Payment received")
action(n18, "End process")
end(e1)
action(n19, "Is Reminder count greater or equal to 3")
action(n20, "Send a Reminder")
branch(b5, XOR)
action(n21, "Write off the Order")
action(n22, "Close the Order after Write off")
end(e_writeoff)
end(e_d1)
defines(v1, "Is Credit Limit Okay", {"Okay", "No"})
defines(v3, "Article Availability for Production", {"Not Available", "Available"})
defines(v4, "Has Payment been received", {"Yes", "No"})
defines(v5, "Is Reminder count greater or equal to 3", {"No", "Yes"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, n5, b3, n10, n11, c1, n12, b6, n13, n14, c2, c3, n15, b4, n17, n18, e1, n19, n20, b5, n21, n22, e_writeoff, e_d1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, e_d1)
precedence(n4, b3)
precedence(b3, n10)
precedence(b3, n11)
precedence(n10, c1)
precedence(n11, c1)
precedence(c1, n12)
precedence(n12, b6)
precedence(b6, n13)
precedence(b6, n14)
precedence(n13, c2)
precedence(n14, c2)
precedence(c2, c3)
precedence(c3, n15)
precedence(n15, b4)
precedence(b4, n17)
precedence(b4, n19)
precedence(n17, n18)
precedence(n18, e1)
precedence(n19, n20)
precedence(n20, b5)
precedence(b5, c3)
precedence(b5, n21)
precedence(n21, n22)
precedence(n22, e_writeoff)
guard(b1, n4, v1 = 'Okay')
guard(b1, n5, v1 = 'No')
guard(b3, n10, v3 = 'Not Available')
guard(b3, n11, v3 = 'Available')
guard(b4, n17, v4 = 'Yes')
guard(b4, n19, v4 = 'No')
guard(b5, c3, v5 = 'No')
guard(b5, n21, v5 = 'Yes')