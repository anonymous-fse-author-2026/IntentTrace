      ],
      "justification": "Direct sequential step on the eligible path after preparation."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the acceptance pack is sent, the process ends."
      ],
      "justification": "Termination path correctly linked to the sending action."
