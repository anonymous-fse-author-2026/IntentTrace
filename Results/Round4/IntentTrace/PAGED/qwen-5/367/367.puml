@startuml
!theme plain
|a_default| Default
|a_default|
start
:To start the process for ACME;
:begin with the New Resupply Cycle;
:then Check Levels of Inventory;
:v1: is inventory below or equal to minimum? ({above_minimum, below_or_equal_minimum}); <<objectSignal>>
if () then ([v1 = 'above_minimum'])
:generate an Above Minimum Report;
:the process ends;
else ([v1 = 'below_or_equal_minimum'])
:generate an Equal to or below minimum Report;
repeat :;
:create Purchase Orders (POs);
:it needs to be reviewed;
:v2: PO review result ({approved, rejected}); <<objectSignal>>
backward:it needs to be reworked;
repeat while () is ([v2 = 'rejected']) not ([v2 = 'approved'])
:it is printed and released in the system;
split
:reserve funds for the released POs;
split again
:mail the POs to the supplier;
:receive the inventory;
end split
:receive the Packing Slip;
:receive the Invoice;
:Three-way match;
:release the funds;
:issue the payment;
endif
stop
@enduml