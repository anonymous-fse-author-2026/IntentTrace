  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, the customer makes an enquiry."
    },
    {
      "id": "i2",
      "content": "After that, we check if the article is in stock."
    },
    {
      "id": "i3",
      "content": "If the article is available, we continue with the process."
    },
    {
      "id": "i4",
      "content": "However, if the article is not available, we abort the enquiry and end the process."
    },
    {
      "id": "i6",
      "content": "First, we reserve the article, and once it is reserved, we calculate the price."
    },
    {
      "id": "i7",
      "content": "After that, we send the offer, and once the offer is sent, we wait for the customer to accept it."
    },
    {
      "id": "i9",
      "content": "Once the customer accepts the offer, we dispatch the article."
    },
    {
      "id": "i10",
      "content": "Finally, once the article is dispatched, the process comes to an end."
    }
  ]
