      ],
      "justification": "Direct behavioural match for the second negative path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After the margin calculation,"
      ],
      "justification": "Temporal precondition accurately modeled as an explicit action step, preserving order."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the next step is the preparation of the offer."
      ],
      "justification": "Direct behavioural match."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the offer is prepared, the transport rate is calculated,"
      ],
      "justification": "Direct behavioural match."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "and the process comes to an end."
      ],
      "justification": "Models the process termination. The redundant action/end node pairing does not alter behaviour."
