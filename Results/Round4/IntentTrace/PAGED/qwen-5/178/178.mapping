    },
    {
      "refs": [
        "guard:b1->b2"
      ],
      "verbatim_texts": [
        "if the answer is \"yes\", then continue with the process."
      ],
      "justification": "Captures the first positive condition leading to the next decision."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed with the acquisition of the pricing."
      ],
      "justification": "Direct behavioural match for the first negative path."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If the answer is \"no\" again"
      ],
      "justification": "Captures the second decision point and its negative condition."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "if the answer is \"yes\" once more, then continue with the process."
      ],
      "justification": "Captures the second positive condition and the structural convergence back to the main flow."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
