      "refs": [
        "guard:b_login->i2",
        "action:i2"
      ],
      "verbatim_texts": [
        "If the login is successful, the process will end."
      ],
      "justification": "Captures the positive login outcome. The guard abstracts 'successful' to v_login='success', action restates the condition, and end reflects the process termination. Behaviour is preserved."
    },
    {
      "refs": [
        "guard:b_login->i3",
        "action:i3"
      ],
      "verbatim_texts": [
        "if the login fails, we will continue with the process"
