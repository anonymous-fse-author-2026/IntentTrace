@startuml
!theme plain
|a_default| Default
|a_default|
start
:To start, please provide the userdata for flickr.;
:v_login: login result ({success, fail}); <<objectSignal>>
if () then ([v_login = 'success'])
:If the login is successful, the process will end.;
else ([v_login = 'fail'])
:if the login fails, we will continue with the process;
:v_choice: user choice ({opt1, opt2, opt3, opt4}); <<objectSignal>>
switch ()
case ([v_choice = 'opt3'])
:If you want to try again, please provide the userdata for flickr.;
case ([v_choice = 'opt1'])
:if you choose to abort, the process will end.;
case ([v_choice = 'opt4'])
:If you still want to try again, please provide the userdata for flickr.;
case ([v_choice = 'opt2'])
:if you decide to abort, the process will end.;
endswitch
endif
stop
@enduml