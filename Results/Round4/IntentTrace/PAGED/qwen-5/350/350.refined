init(start)
action(i1, "To start, please provide the userdata for flickr.")
action(i2, "If the login is successful, the process will end.")
action(i3, "if the login fails, we will continue with the process")
action(i4, "If you want to try again, please provide the userdata for flickr.")
action(i5, "if you choose to abort, the process will end.")
action(i6, "If you still want to try again, please provide the userdata for flickr.")
action(i7, "if you decide to abort, the process will end.")
branch(b_login, XOR)
branch(b_cont, XOR)
end(e_end)
defines(v_login, "login result", {"success", "fail"})
defines(v_choice, "user choice", {"opt1", "opt2", "opt3", "opt4"})
actor(a_default, "Default", [start, i1, i2, i3, i4, i5, i6, i7, b_login, b_cont, e_end])
precedence(start, i1)
precedence(i1, b_login)
precedence(b_login, i2)
precedence(i2, e_end)
precedence(b_login, i3)
precedence(i3, b_cont)
precedence(b_cont, i5)
precedence(i5, e_end)
precedence(b_cont, i7)
precedence(i7, e_end)
precedence(b_cont, i4)
precedence(i4, i1)
precedence(b_cont, i6)
precedence(i6, i1)
guard(b_login, i2, v_login = 'success')
guard(b_login, i3, v_login = 'fail')
guard(b_cont, i5, v_choice = 'opt1')
guard(b_cont, i7, v_choice = 'opt2')
guard(b_cont, i4, v_choice = 'opt3')
guard(b_cont, i6, v_choice = 'opt4')