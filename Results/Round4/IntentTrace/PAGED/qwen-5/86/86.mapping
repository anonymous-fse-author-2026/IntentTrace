      "verbatim_texts": [
        "To begin the process for Metal Works, start by obtaining the raw material from the received list."
      ],
      "justification": "Initiates the process and captures the first behavioural step. 'Start' is harmless structural plumbing and does not alter behaviour."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the raw material is not available in stock",
        "if the raw material is available in stock"
      ],
      "justification": "Models the XOR gateway that splits the flow based on stock availability."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If the raw material is not available in stock"
