{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "The init node and first three actions collectively model the process startup and initial UI navigation described in the opening sentence."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "Models the expense threshold check and the positive branch outcome. Condition modeled as an action/gateway pair preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Covers the negative branch of the expense check and directs flow to the translation assessment."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Captures the translation requirement decision and its affirmative path."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Captures the translation decision negative path and confirmation step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Action and gateway represent the first review evaluation step."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Directly models the rejection outcome and subsequent editing action."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Directly models the approval outcome and follow-up check."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Represents the second review evaluation step and its branching point."
    },
    {
      "refs": [
        "guard:b5->n15",
        "action:n15",
        "guard:b5->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Covers the approval branch (combined translation+confirmation) and the accompanying rejection branch (edit report), preserving the complete decision logic."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Models the final receipts evaluation step and its decision gateway."
    },
    {
      "refs": [
        "guard:b6->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Accurately captures the acceptance condition and expense processing step."
    },
    {
      "refs": [
        "guard:b6->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Accurately captures the rejection condition and report editing step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Structural converge nodes, end action, and terminal end node align with the stated process conclusion."
    }
  ],
