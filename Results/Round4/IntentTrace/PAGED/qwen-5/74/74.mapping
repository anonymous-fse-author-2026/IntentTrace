        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "Captures process initiation and splits the opening instruction into starting and entering metadata."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to the IN-Patient step"
      ],
      "justification": "Direct correspondence to the next sequential step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "send data to suppliers"
      ],
      "justification": "Matches the first parallel step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "create a claim"
      ],
      "justification": "Matches the second parallel step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "send data to suppliers",
        "create a claim"
      ],
      "justification": "The AND gateway correctly models the simultaneous execution ('At the same time') described for these two steps."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "extract the data from the suppliers and transfer it to the doctor's phone"
      ],
      "justification": "Preserves the extraction and transfer step."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "confirm the GOP and the process will come to an end"
      ],
      "justification": "Models GOP confirmation and the subsequent termination of this flow path."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "register the case and handle the claim"
      ],
      "justification": "Splits the compound instruction into two equivalent action steps."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status"
      ],
      "justification": "Splits the re-extraction and conditional record update/status confirmation into two actions."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "send the data back to the suppliers"
      ],
      "justification": "Direct match for returning data to suppliers."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "receive the payment and conclude the process"
      ],
      "justification": "Models final payment receipt and process conclusion."
    }
