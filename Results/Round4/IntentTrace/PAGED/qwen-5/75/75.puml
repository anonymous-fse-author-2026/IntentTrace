@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:receive claim;
:create and record the claim;
:make a decision on the claim;
:v1: make a decision on the claim ({Rejected, Accepted}); <<objectSignal>>
if () then ([v1 = 'Rejected'])
:reject the claim;
:review the claim rejection;
:continue the process;
else ([v1 = 'Accepted'])
:offer the benefit;
:prepare the claim discharge;
:record the benefit payment;
endif
:v3: final_step ({End, PaymentClose}); <<objectSignal>>
if () then ([v3 = 'PaymentClose'])
:operate outgoing payment;
:close the claim;
else ([v3 = 'End'])
:end of process;
endif
stop
@enduml