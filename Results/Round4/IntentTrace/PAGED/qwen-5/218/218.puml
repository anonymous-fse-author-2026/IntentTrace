@startuml
!theme plain
|a_default| Default
|a_default|
start
repeat :enter expenses;
:generate spreadsheet;
:v1: is the request approved ({Yes, No}); <<objectSignal>>
repeat while () is ([v1 = "No"] Not Approved) not ([v1 = "Yes"] Approved)
:pay out expenses;
:v2: is the request approved ({Yes, No}); <<objectSignal>>
if () then ([v2 = "Yes"] Approved)
:pay out expenses;
stop
else ([v2 = "No"] Not Approved)
endif
@enduml