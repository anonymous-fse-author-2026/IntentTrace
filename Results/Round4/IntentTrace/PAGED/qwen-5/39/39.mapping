      "verbatim_texts": [
        "To begin the process, the inventory needs to be checked."
      ],
      "justification": "The opening unit implicitly starts the process and describes the initial inventory check. Actions 'start' and 'check inventory' redundantly restate this step without changing behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Mac compares the inventory levels in the spreadsheet with the sales"
      ],
      "justification": "Direct paraphrase of the comparison step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the inventory level is high, Mac doesn't need to manually count the inventory."
      ],
      "justification": "Captures the XOR split, the high-level guard, and the resulting skip-counting action."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "if the inventory level is low, Mac needs to manually count the inventory of items."
      ],
      "justification": "Captures the low-level guard and the manual counting action on that branch."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "they make a list of items that have a low stock count"
      ],
      "justification": "Direct paraphrase of creating the low-stock list."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Mac selects suppliers for the needed products and places the order(s)"
      ],
      "justification": "Direct paraphrase of supplier selection and ordering."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "After receiving the order, the process comes to an end."
      ],
      "justification": "Covers receiving the order and the process termination. The explicit 'process ends' action and structural end node together faithfully represent the conclusion."
    }
