{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by supplying the requirement and then documenting it."
      ],
      "justification": "Covers the implicit process start, the placeholder 'start' step, and the initial supply/document action."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the order is received via fax",
        "If the order is received via mail or phone"
      ],
      "justification": "Structural XOR split representing the two reception channel conditions."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the order is received via fax"
      ],
      "justification": "Condition guard for the fax branch path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "input the order into an Excel file."
      ],
      "justification": "Action executed when the fax condition is met."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone"
      ],
      "justification": "Condition guard for the mail/phone branch path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "also input the order into an Excel file."
      ],
      "justification": "Action executed when the mail/phone condition is met."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete after a week, send it to the student."
      ],
      "justification": "Directly captures the mailing action; timing detail is absorbed into flow structure without changing core behaviour."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list, type the orders into the MS-Access database."
      ],
      "justification": "Split into receiving/parallel kickoff and the actual database typing step; preserves original meaning."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed. Once the database is completed, control the incoming order. At the same time, continue to do the check."
      ],
      "justification": "Paraphrases the completion verification and concurrent control/check steps."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the order is correct, release it.",
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Models the correctness decision point and its implicit evaluation step."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the order is correct, release it."
      ],
      "justification": "Positive branch guard and corresponding release action."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Negative branch guard and corresponding agency contact action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac, release it.",
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "Structural split and evaluation step for the monetary threshold decision."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac, release it."
      ],
      "justification": "Guard and action for the under-5k path; threshold value matches source."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "Guard and action for the over-5k path; threshold value matches source."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "Once the order is signed off, contact the client and release the order."
      ],
      "justification": "Split into client contact and final release post-sign-off; behaviour preserved."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "Direct paraphrase of PPC production initiation."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order.",
        "If the issue can be solved, release the order."
      ],
      "justification": "Decision split and evaluation step for solvability check."
    },
    {
      "refs": [
        "guard:b4->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order."
      ],
      "justification": "Guard and action for the unsolvable/cancel path."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the issue can be solved, release the order."
      ],
      "justification": "Guard and action for the solvable/release path."
    },
    {
      "refs": [
        "branch:b5"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends.",
        "If not, check the quality of the goods."
      ],
      "justification": "Structural XOR split between cancellation termination and continuation to quality check."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends."
      ],
      "justification": "Guard and action representing the cancellation end path."
    },
    {
      "refs": [
        "guard:b5->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If not, check the quality of the goods."
      ],
      "justification": "Guard and action for the non-cancellation continuation path."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "justification": "Direct match for quality reporting step."
    },
    {
      "refs": [
        "action:n27",
        "action:n33"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "justification": "Split into memo release and warehouse achievement verification; behaviour intact."
    },
    {
      "refs": [
        "guard:b_end->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "justification": "Models the invoice/finance reporting path. Concurrency simplified to branching per relaxed modelling rules."
    },
    {
      "refs": [
        "guard:b_end->n29",
        "action:n29",
        "action:n30",
        "action:n34"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods and sign and send the memo. Also, send the goods and ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "Captures commissioning, memo signing/sending, and goods dispatch steps along the parallel/commission branch."
    },
    {
      "refs": [
        "action:n31",
        "action:n32"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order. This marks the end of the process."
      ],
      "justification": "Covers memo archiving, order closing, and structural process termination points."
    }
  ],
