{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start by claiming what is requested and then check the insured status of the claimant."
      ],
      "justification": "Captures the process initiation, the first two action steps, and the insured status verification."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the claimant is insured, proceed to evaluate the claim."
      ],
      "justification": "Models the XOR gateway, the positive branch condition, and the corresponding evaluation action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the claimant is not insured, reject the claim."
      ],
      "justification": "Models the negative branch condition and the rejection step."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the claim is rejected, notify the claimant and the process comes to an end."
      ],
      "justification": "Covers post-rejection notification, the explicit termination action, and the structural end node."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the claim is a simple one or a complex one, send the relevant forms accordingly."
      ],
      "justification": "Re-types the conditional assessment into sequential steps for evaluating complexity and sending forms, preserving behaviour."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the forms are returned, check them for completeness."
      ],
      "justification": "Direct match for the completeness verification step."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If all the relevant details are provided, proceed to register the claim."
      ],
      "justification": "Models the second decision gateway, its positive condition, and the registration action."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "However, if not all the relevant details are provided, inform the claimant to complete them."
      ],
      "justification": "Models the negative condition, the notification step, and the terminal node for this branch."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Once the claim is registered, the process comes to an end."
      ],
      "justification": "Covers the final registration confirmation action and the structural end node for this path."
    }
  ],
