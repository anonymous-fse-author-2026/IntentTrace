init(start)
action(i1, "For the company, the first step is to look at the order.")
action(i2, "If the order is to be rejected, the process should continue. If the order is to be accepted, the process should also continue.")
branch(i3, AND)
action(n_prepare, "Preparing the assembling order")
action(n_check_avail, "Checking availability")
converge(c_parallel)
branch(b_availability, XOR)
action(n_check_again, "Availability needs to be checked again")
end(i4)
action(i5, "If the item can be reserved, the process should continue.")
action(i6, "The next steps are to assemble the bike and then ship the product.")
end(e_final)
defines(v_availability, "Availability Status", {"Backorder", "Reserved"})
actor(a_default, "Default", [start, i1, i2, i3, n_prepare, n_check_avail, c_parallel, b_availability, n_check_again, i4, i5, i6, e_final])
precedence(start, i1)
precedence(i1, i2)
precedence(i2, i3)
precedence(i3, n_prepare)
precedence(i3, n_check_avail)
precedence(n_prepare, c_parallel)
precedence(n_check_avail, c_parallel)
precedence(c_parallel, b_availability)
precedence(b_availability, n_check_again)
precedence(b_availability, i5)
precedence(n_check_again, i4)
precedence(i5, i6)
precedence(i6, e_final)
guard(b_availability, n_check_again, v_availability = 'Backorder')
guard(b_availability, i5, v_availability = 'Reserved')