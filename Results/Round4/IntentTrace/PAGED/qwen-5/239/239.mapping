{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "For the company, the first step is to look at the order."
      ],
      "justification": "Initiates the process and performs the first action exactly as stated."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "If the order is to be rejected, the process should continue. If the order is to be accepted, the process should also continue."
      ],
      "justification": "Models the conditional statement as a single action step. Since both outcomes explicitly state the process should continue, treating it as a pass-through action preserves behaviour."
    },
    {
      "refs": [
        "action:n_prepare",
        "action:n_check_avail"
      ],
      "verbatim_texts": [
        "At the same time, two steps need to be completed: preparing the assembling order and checking availability."
      ],
      "justification": "Correctly splits the flow into an AND gateway for the two parallel preparation steps and merges them back upon completion."
    },
    {
      "refs": [
        "guard:b_availability->n_check_again",
        "action:n_check_again"
      ],
      "verbatim_texts": [
        "If there is a backorder, availability needs to be checked again and the process ends."
      ],
      "justification": "Captures the decision split for the backorder case, the re-check action, and the subsequent process termination."
    },
    {
      "refs": [
        "guard:b_availability->i5",
        "action:i5"
      ],
      "verbatim_texts": [
        "If the item can be reserved, the process should continue."
      ],
      "justification": "Captures the alternative reservation path. The action redundantly restates the condition after the guard, but this does not change behaviour."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "The next steps are to assemble the bike and then ship the product."
      ],
      "justification": "Executes the final assembly and shipping steps followed by process completion."
    }
  ],
