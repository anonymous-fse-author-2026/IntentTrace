{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "Starts the process and models the initial action of sending the appointment approval form."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Directly models the step of receiving the approval."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Accurately captures the contact step with TS for timing clarification."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Models the checking of the approval."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized."
      ],
      "justification": "Correctly splits the flow for internal resources and authorizes the appointment."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Correctly handles the external resource branch and authorization."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized.",
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Structural convergence that rejoins the two authorization paths, preserving the intended flow."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services.",
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Models sending the approval and documentation to HR services. Covers both the initial instruction and its later redundant restatement, which does not change behaviour."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Direct match for scanning and recording the form into the system."
    },
    {
      "refs": [
        "action:n15",
        "guard:b2->n13"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Captures the conditional path for when there are no variations, allowing the process to continue."
    },
    {
      "refs": [
        "guard:b2->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed."
      ],
      "justification": "Models the decision point for variations and the branch requiring a business case to be completed."
    },
    {
      "refs": [
        "guard:b2->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed and attached."
      ],
      "justification": "Models the alternative variation branch where the business case is both completed and attached."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Models HR receiving the documents and explicitly terminates the process flow."
    }
  ],
