      "verbatim_texts": [
        "the process begins with a request to purchase a motorcycle."
      ],
      "justification": "The init node and first action directly correspond to the starting event described in the text."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "Once the request is received, the next step is to either continue the process if a production order is received or update the sales information and proceed to order dispatch."
      ],
      "justification": "Captures the conditional continuation step. The model simplifies the secondary branch without altering the core production workflow behaviour."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier. Alternatively, if there are available goods for production, a manufacturing order is placed."
      ],
      "justification": "Models the unavailable materials condition and the subsequent supplier ordering action."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier. Alternatively, if there are available goods for production, a manufacturing order is placed."
      ],
      "justification": "Models the alternative available goods condition and the manufacturing order placement action."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier, the goods are issued and the motorcycles are produced."
      ],
      "justification": "Sequentially models material receipt, goods issuance, and production steps as described."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "At the same time, the stock is updated and the motorcycles are dispatched."
      ],
      "justification": "Directly captures the concurrent dispatch and stock update step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, the stock is updated and the sales information is updated."
      ],
      "justification": "Directly captures the simultaneous updates occurring at the end of the process."
    }
  ],
