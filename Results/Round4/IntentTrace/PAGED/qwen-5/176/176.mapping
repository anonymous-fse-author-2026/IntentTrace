      "verbatim_texts": [
        "The loan application process starts with receiving the loan application."
      ],
      "justification": "The process trigger and first action correspond directly to the opening sentence."
    },
    {
      "refs": [
        "label:b2->n3",
        "label:b2->n4",
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps should be completed: assessing the loan risk and checking the credit history."
      ],
      "justification": "The AND gateway correctly splits the flow for simultaneous tasks. The two actions and labels cover the specified steps, and the converge node structurally rejoins them. Redundant labels do not alter behaviour."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "After that, the eligibility of the applicant is assessed."
      ],
      "justification": "A conditional check modeled as an action step still preserves the intended behaviour and ordering."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the applicant is eligible, the acceptance pack is prepared."
      ],
      "justification": "Captures the positive branch of the eligibility decision and the subsequent preparation step. The abstract guard value preserves the intended logic."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the applicant is not eligible, the application is rejected."
      ],
      "justification": "Captures the negative branch of the eligibility decision and the rejection step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the application is rejected, the loan application process ends."
      ],
      "justification": "Explicit termination step followed by the end node for the rejection path matches the source flow."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The prepared acceptance pack is then sent."
      ],
      "justification": "Direct match for the sending step following pack preparation."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the acceptance pack is sent, the process ends."
      ],
      "justification": "Explicit termination step followed by the end node for the acceptance path matches the source flow."
    }
