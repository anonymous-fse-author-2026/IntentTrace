    {
      "id": "i1",
      "content": "To begin with, the first step is Course registration."
    },
    {
      "id": "i2",
      "content": "If an exception is needed"
    },
    {
      "id": "i3",
      "content": "a Request for the exception should be made"
    },
    {
      "id": "i4",
      "content": "if an exception is not needed, the process can continue"
    },
    {
      "id": "i6",
      "content": "After the exception is approved"
    },
    {
      "id": "i7",
      "content": "the next step is course enrollment"
    },
    {
      "id": "i8",
      "content": "followed by seminar group enrollment"
    },
    {
      "id": "i9",
      "content": "the homework assignment can be started"
    },
    {
      "id": "i10",
      "content": "it should be turned in"
    },
    {
      "id": "i11",
      "content": "The homework will then be evaluated"
    },
    {
      "id": "i12",
      "content": "If it was not the last homework"
    },
    {
      "id": "i13",
      "content": "another homework assignment will be given"
    },
    {
      "id": "i14",
      "content": "if it was the last homework"
    },
    {
      "id": "i15",
      "content": "At the same time, two additional steps should be completed"
    },
    {
      "id": "i16",
      "content": "granting accreditation"
    },
    {
      "id": "i18",
      "content": "announcing the date of the exam"
    },
    {
      "id": "i19",
      "content": "signing up for the exam"
    },
    {
      "id": "i20",
      "content": "it should be attended"
    },
    {
      "id": "i21",
      "content": "it will be evaluated"
    },
    {
      "id": "i22",
      "content": "If the exam is passed"
    },
    {
      "id": "i23",
      "content": "the course is considered passed"
    },
    {
      "id": "i24",
      "content": "if the exam is failed"
    },
    {
      "id": "i25",
      "content": "if the exam is failed, another sign-up for the exam is required"
    }
