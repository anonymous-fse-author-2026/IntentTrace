  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process for ACME Company, start by receiving the customer request and then check the current inventory level."
    },
    {
      "id": "i2",
      "content": "If the inventory level is at or below the minimum, accept the customer request. However, if the inventory level is above the minimum, reject the customer request."
    },
    {
      "id": "i7",
      "content": "create a purchase order"
    },
    {
      "id": "i8",
      "content": "If the customer request is rejected, the process ends."
    },
    {
      "id": "i9",
      "content": "review it"
    },
    {
      "id": "i10",
      "content": "If the purchase order is rejected, rework the purchase order. However, if the purchase order is approved, reserve the funds."
    },
    {
      "id": "i15",
      "content": "send the purchase order"
    },
    {
      "id": "i16",
      "content": "Simultaneously, complete the following steps: receive the packing slip and receive the invoice."
    },
    {
      "id": "i17",
      "content": "Upon receiving the packing slip, record it. Similarly, upon receiving the invoice, record it as well."
    },
    {
      "id": "i18",
      "content": "Release the reserved funds and issue the payment."
    },
    {
      "id": "i19",
      "content": "Finally, issue the payment and the process ends."
    }
  ]
