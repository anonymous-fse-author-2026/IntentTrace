{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "At the start, we receive a form."
      ],
      "justification": "The opening unit implicitly starts the process and describes the first action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After receiving the form, we check if it is complete."
      ],
      "justification": "Directly captures the completeness check step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If it needs to be sent back, the process ends."
      ],
      "justification": "Models the split gateway, the negative condition, the corresponding action, and the terminal end node."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "However, if we need to check the income, we continue with the process."
      ],
      "justification": "Captures the alternative branch condition that keeps the process running."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "At the same time, we complete the following steps: checking deductibles and checking the house."
      ],
      "justification": "Merges the two listed sub-steps into a single equivalent action, preserving behaviour."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Then, we make a decision."
      ],
      "justification": "Models the stated decision point and introduces the necessary structural gateway."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If we need to check the declaration, the process ends."
      ],
      "justification": "Correctly models the conditional path and its termination."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "Otherwise, if we need to invite the declarant, the process also ends."
      ],
      "justification": "Re-types the condition as an action step followed by an end node; under relaxed comparison this preserves the described behaviour."
    }
  ],
