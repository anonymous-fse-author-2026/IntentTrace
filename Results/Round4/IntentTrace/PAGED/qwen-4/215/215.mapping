      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "Initiates the process and executes the first stated step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "followed by checking the Inventory Level"
      ],
      "justification": "Direct correspondence to the inventory check step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\""
      ],
      "justification": "Captures the XOR decision point and the positive guard condition accurately."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then proceed to Create Purchase Order"
      ],
      "justification": "Positive arm action matching the source step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "\"Inventory Level is above the minimum\""
      ],
      "justification": "Negative guard condition preserving the exact threshold/text from the source."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then the process ends"
      ],
      "justification": "Action and structural nodes correctly implement the early termination path described."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After creating the Purchase Order, move on to Reviewing the Purchase Order"
      ],
      "justification": "Direct match to the review step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved"
      ],
      "justification": "Marks the second XOR decision point in the flow."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "Purchase Order is approved",
        "approved"
      ],
      "justification": "Guard variable assignment faithfully represents the approval condition."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "if the Purchase Order is rejected",
        "rejected"
      ],
      "justification": "Guard variable assignment faithfully represents the rejection condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then reserve the funds for the purchase"
      ],
      "justification": "Matches the fund reservation step on the approval path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the funds are reserved, send the Order to Suppliers"
      ],
      "justification": "Direct match to the order dispatch step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "then rework the order"
      ],
      "justification": "Matches the rework step on the rejection path."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again"
      ],
      "justification": "Correctly models the loop-back to review after reworking."
    },
    {
      "refs": [
        "label:n10->b3"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps"
      ],
      "justification": "AND gateway and label correctly capture the parallel execution instruction."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "the Supplier sends a packing slip and an invoice"
      ],
      "justification": "Models the supplier document generation step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it"
      ],
      "justification": "Direct match to recording the packing slip."
    },
    {
      "refs": [
        "action:n13",
        "action:n15"
      ],
      "verbatim_texts": [
        "when the invoice is received, record it as well"
      ],
      "justification": "n15 directly matches the recording step; n13 extracts the invoice receipt aspect without altering behaviour."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice, release the reserved funds and issue the payment to the supplier"
      ],
      "justification": "Convergence and combined action correctly implement the post-recording payment and release step."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, the process ends after the payment is issued to the supplier"
      ],
      "justification": "Final action and end node accurately reflect the process termination condition."
