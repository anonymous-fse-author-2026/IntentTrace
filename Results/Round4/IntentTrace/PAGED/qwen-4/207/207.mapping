  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, for CAB, the first step is to assess the change request."
      ],
      "justification": "Structural start and first action directly correspond to the opening sentence."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the affected systems for any impacts on the business unit"
      ],
      "justification": "Direct paraphrase of the system impact check step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "determine whether the change request should be approved or not"
      ],
      "justification": "Models the initial approval determination step."
    },
    {
      "refs": [
        "guard:b1->cv1"
      ],
      "verbatim_texts": [
        "If the change request should be approved in its current state, then it is approved."
      ],
      "justification": "Represents the XOR split and the positive (approved) path condition."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the change request should not be approved in its current state, further evaluation is needed to determine if the change will be acceptable with more information provided"
      ],
      "justification": "Captures the negative path condition and the subsequent evaluation step."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "If the change request is ultimately approved"
      ],
      "justification": "Exact restatement of the approval condition preceding implementation."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "the change is implemented."
      ],
      "justification": "Implementation action followed by process termination plumbing."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "if the change is deemed unacceptable, it is rejected."
      ],
      "justification": "Models the acceptability decision point and the rejection outcome path."
    },
    {
      "refs": [
        "guard:b2->cv1"
      ],
      "verbatim_texts": [
        "if the change request should not be approved in its current state, further evaluation is needed to determine if the change will be acceptable with more information provided"
      ],
      "justification": "Represents the implicit positive outcome of the further evaluation step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "a request for more information is made to the Change Coordinator."
      ],
      "justification": "Direct match for the information request step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "an email enquiry to the Change Coordinator."
      ],
      "justification": "Direct match for the email enquiry step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the approval register is updated within a timeframe of 3 business days."
      ],
      "justification": "Exact capture of the register update task and timeframe."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The email enquiry is also forwarded to the Change Requester."
      ],
      "justification": "Exact capture of the forwarding step."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If there are no further inquiries or issues, the process concludes after 3 business days."
      ],
      "justification": "Models the inquiry check split, the no-inquiry condition, and the concluding termination."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "if there are inquiries from the CAB, a response is expected within 1-3 business days."
      ],
      "justification": "Captures the inquiry condition and the expected response timeframe step."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "it is forwarded to the CAB for further evaluation."
      ],
      "justification": "Direct match for forwarding the response back to the CAB."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "a final determination is made regarding the approval of the change request."
      ],
      "justification": "Models the final decision step and subsequent process end."
    }
