{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "The start node and the initial action directly capture the opening step of prioritizing orders."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information."
      ],
      "justification": "Models the preliminary check and introduces the decision gateway for customer existence."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer exists, we move on to checking their payment history."
      ],
      "justification": "Captures the positive branch condition and the subsequent payment history verification step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "if the customer does not exist, we need to verify their customer status."
      ],
      "justification": "Captures the negative branch condition and the alternative status verification step."
    },
    {
      "refs": [
        "guard:b2->c_merge",
        "guard:b2->e5"
      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process."
      ],
      "justification": "Models the conditional continuation versus an implicit termination path when history is not good."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Split and action correctly model the private customer path resulting in a decline message."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Captures the wholesaler branch leading to customer creation and product availability check."
    },
    {
      "refs": [
        "guard:b4->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Accurately models the unavailability branch, the combined production/decline action, and the explicit process end."
    },
    {
      "refs": [
        "guard:b4->c_merge",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Matches the availability branch that leads back to the main flow with a confirmation action."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "The AND split and join correctly model the concurrent notifications to both departments."
    },
    {
      "refs": [
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Stepwise breakdown faithfully preserves the packing, invoicing, and readiness-for-delivery sequence."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Directly maps the closure prerequisite and subsequent delivery step."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Redundant restatement of the order closure step, which preserves behaviour without conflict."
    },
    {
      "refs": [
        "action:n24",
        "guard:b5->c_remind",
        "guard:b5->n24"
      ],
      "verbatim_texts": [
        "if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Models the outstanding payment trigger leading to the reminder quantity evaluation."
    },
    {
      "refs": [
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Captures the lower-threshold branch allowing the process to continue."
    },
    {
      "refs": [
        "guard:b6->n27",
        "action:n27"
      ],
      "verbatim_texts": [
        "if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Correctly models the higher-threshold branch, the donning activation, and the explicit process termination."
    }
  ],
