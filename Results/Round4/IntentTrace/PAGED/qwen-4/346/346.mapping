{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, the appointment approval form is sent."
      ],
      "justification": "Initiates the process and captures the first action of sending the form."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, the approval is received."
      ],
      "justification": "Directly models receiving the approval."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Following the approval, there is a contact with TS to clarify the timing."
      ],
      "justification": "Models the clarification contact step with TS."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Models the approval checking step."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the resource is internal, the appointment is authorized."
      ],
      "justification": "Captures the internal resource decision, its guard, the authorization action, and the subsequent convergence."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the resource is external, the appointment is also authorized."
      ],
      "justification": "Captures the external resource decision branch and authorization action. Abstract variable guard preserves behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Directly models sending documentation and approval to HR."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Models scanning and recording the form."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "The approval is checked and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Redundant restatement present in both source and model; behaviour is preserved, so classified as a match."
    },
    {
      "refs": [
        "action:n13",
        "action:n20"
      ],
      "verbatim_texts": [
        "HR services receive the documentations and this marks the end of the process."
      ],
      "justification": "Models HR receiving documents and explicitly terminates the process."
    },
    {
      "refs": [
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If there are no variations, the process continues."
      ],
      "justification": "Captures the 'no variations' condition, the continuation action, the branching point, and convergence."
    },
    {
      "refs": [
        "guard:b2->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed."
      ],
      "justification": "Models the variation condition and the corresponding business case completion step."
    },
    {
      "refs": [
        "guard:b2->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "However, if there are variations, a business case is completed and attached."
      ],
      "justification": "Handles the redundant source unit by modeling it as an equivalent alternative step. Preserves overall behaviour."
    }
  ],
