@startuml
!theme plain
|a_default| Default
|a_default|
start
:trigger: resupply cycle;
:check: inventory level;
:v1: check  inventory level ({above, below}); <<objectSignal>>
if () then ([v1 = "above"] above minimum)
stop
else ([v1 = "below"] below minimum)
:create: purchase order;
:review: purchase order;
:v2: review  purchase order ({rejected, accepted}); <<objectSignal>>
if () then ([v2 = "rejected"] rejected)
:rework: purchase order;
:review: purchase order;
else ([v2 = "accepted"] accepted)
->;
endif
split
-> reserve funds;
:reserve funds;
split again
-> send to supplier;
:send to supplier;
end split
:receive packing slip and release funds;
stop
endif
@enduml