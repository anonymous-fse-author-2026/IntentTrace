@startuml
!theme plain
|a_company| Company
|a_company|
start
:Look at the order;
split
:Preparing the assembling order;
split again
:Checking availability;
end split
:Check for Backorder;
:v2: Order Status ({Backorder, Reserved}); <<objectSignal>>
if () then ([v2 = "Backorder"])
:Checking availability again;
stop
else ([v2 = "Reserved"])
:Confirm Reservation;
:Assemble the bike;
:Ship the product;
stop
endif
@enduml