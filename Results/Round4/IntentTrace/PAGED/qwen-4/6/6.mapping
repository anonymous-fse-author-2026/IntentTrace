      "verbatim_texts": [
        "To start, ask the 1st Level Support if there is an issue."
      ],
      "justification": "Process initiation and the first action step."
    },
    {
      "refs": [
        "label:b1->n4",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the issue is resolved, provide feedback for the account manager."
      ],
      "justification": "First positive branch outcome and associated feedback action."
    },
    {
      "refs": [
        "label:b1->n5",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If it is a 1st Level issue, ask the developer for assistance."
      ],
      "justification": "First negative branch outcome and associated escalation action."
    },
