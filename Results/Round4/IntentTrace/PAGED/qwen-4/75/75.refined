init(i1)
action(n1, "start")
action(n2, "receive claim")
action(n3, "create and record the claim")
action(n4, "make a decision on the claim")
branch(b1, XOR)
action(n5, "reject the claim")
action(n6, "review the claim rejection")
action(n7, "If the claim rejection is accepted, continue the process. But if the claim rejection is not accepted, also continue the process.")
action(n8, "offer the benefit")
action(n9, "prepare the claim discharge")
action(n10, "record the benefit payment")
action(n11, "operate outgoing payment")
action(n12, "close the claim")
action(n13, "Finally, the process ends.")
end(e1)
converge(c1)
converge(c_join)
branch(b2, AND)
defines(v1, "make a decision on the claim", {"Rejected", "Accepted"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, b1, n5, n6, n7, n8, n9, n10, n11, n12, n13, e1, c1, c_join, b2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n5)
precedence(n5, n6)
precedence(n6, c_join)
precedence(c_join, n7)
precedence(n7, b2)
precedence(b2, n11)
precedence(b2, n12)
precedence(b1, n8)
precedence(n8, n9)
precedence(n9, n10)
precedence(n10, c_join)
precedence(n11, c1)
precedence(n12, c1)
precedence(c1, n13)
precedence(n13, e1)
guard(b1, n5, v1 = 'Rejected')
guard(b1, n8, v1 = 'Accepted')