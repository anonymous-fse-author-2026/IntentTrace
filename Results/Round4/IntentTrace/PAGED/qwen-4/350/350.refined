init(i_start)
action(n2, "provide userdata for flickr")
converge(c_login)
action(n3, "is the login successful")
branch(b1, XOR)
action(n4, "end process successful login")
end(e1)
action(n5, "do you want to try again")
branch(b2, XOR)
action(n6, "provide userdata for flickr again after first failure")
action(n7, "abort process after first failure")
action(n8, "provide userdata for flickr still try again")
action(n9, "abort process decide to abort")
defines(v_login, "is the login successful", {"Yes", "No"})
defines(v_retry, "retry option", {"Retry1", "Retry2", "Abort1", "Abort2"})
actor(a_default, "Default", [i_start, n2, c_login, n3, b1, n4, e1, n5, b2, n6, n7, n8, n9])
precedence(i_start, n2)
precedence(n2, c_login)
precedence(c_login, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, e1)
precedence(n5, b2)
precedence(b2, n6)
precedence(b2, n7)
precedence(b2, n8)
precedence(b2, n9)
precedence(n6, c_login)
precedence(n7, e1)
precedence(n8, c_login)
precedence(n9, e1)
guard(b1, n4, v_login = 'Yes')
guard(b1, n5, v_login = 'No')
guard(b2, n6, v_retry = 'Retry1')
guard(b2, n7, v_retry = 'Abort1')
guard(b2, n8, v_retry = 'Retry2')
guard(b2, n9, v_retry = 'Abort2')