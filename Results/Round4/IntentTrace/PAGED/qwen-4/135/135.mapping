{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with Low Inventory."
      ],
      "justification": "Initiates the process and captures the starting state/action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, proceed to Create P.R.."
      ],
      "justification": "Models the first instance of creating a Purchase Requisition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, move on to Create P.R.,"
      ],
      "justification": "Models the redundant/second mention of creating a PR in the source text."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "followed by Submit P.O.."
      ],
      "justification": "Captures the Purchase Order submission step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the P.O. is submitted, proceed to Ship Material."
      ],
      "justification": "Corresponds to the material shipping action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "At this point, check if the shipment is okay."
      ],
      "justification": "Models the first shipment validation as an action node feeding into an XOR gateway."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed to Send Payment."
      ],
      "justification": "Captures the positive outcome of the first check and routes to the payment action."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if there are any problems with the shipment, communicate them accordingly."
      ],
      "justification": "Captures the negative outcome of the first check and the corresponding communication step."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->c2",
        "action:n9"
      ],
      "verbatim_texts": [
        "After checking the shipment status again, if it is okay, proceed to Send Payment."
      ],
      "justification": "Models the second check action, its decision split, positive guard, and convergence to the same payment step."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Otherwise, communicate any shipment problems."
      ],
      "justification": "Captures the negative outcome of the second check and the follow-up communication step."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, once the payment is sent, the process comes to an end."
      ],
      "justification": "Marks the process termination following the payment step."
    }
  ],
