{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "Maps the process start and the initial registration action."
    },
    {
      "refs": [
        "guard:b_exception->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "Correctly models the decision point and the positive path action. Guard abstraction preserves the conditional logic."
    },
    {
      "refs": [
        "guard:b_exception->c_exception"
      ],
      "verbatim_texts": [
        "On the other hand, if an exception is not needed, the process can continue."
      ],
      "justification": "Models the negative path and flow convergence when no exception is required."
    },
    {
      "refs": [
        "action:n5",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After the exception is approved, the next step is course enrollment, followed by seminar group enrollment."
      ],
      "justification": "Captures the approval checkpoint and the two sequential enrollment steps."
    },
    {
      "refs": [
        "action:n8",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the seminar group enrollment is completed, the homework assignment can be started. After working on the homework, it should be turned in. The homework will then be evaluated, and the process can continue."
      ],
      "justification": "Models the full homework lifecycle (start, submit, evaluate) and convergence back to the main flow."
    },
    {
      "refs": [
        "guard:b_homework->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Correctly implements the loop-back condition and action for additional homework."
    },
    {
      "refs": [
        "guard:b_homework->b_parallel"
      ],
      "verbatim_texts": [
        "However, if it was the last homework, the process can continue."
      ],
      "justification": "Routes flow forward when the homework cycle completes."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "Correctly splits into parallel paths for the two concurrent steps and rejoins afterward."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "After signing up for the exam, it should be attended. Once the exam is attended, it will be evaluated."
      ],
      "justification": "Models the sequential exam preparation, attendance, and evaluation steps."
    },
    {
      "refs": [
        "guard:b_exam_result->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed and the process can continue."
      ],
      "justification": "Handles the passing outcome and marks process termination. Unit i13 is a redundant restatement of this branch and is behaviourally covered here."
    },
    {
      "refs": [
        "guard:b_exam_result->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "However, if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Handles the failing outcome and loops back to exam sign-up. Unit i13 redundantly restates this path, which is handled as a match."
    }
  ],
