    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "Start node and first action directly correspond to the opening instruction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Direct paraphrase of the second step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "guard:b1->n9"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "Action and branching structure with guards correctly model the stated decision point and its two implicit outcomes."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "Matches the rejection branch action."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "Models the acceptance outcome explicitly as an action step followed by offering the benefit, preserving the conditional behaviour."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Direct match for the rejection review step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "On the other hand, if the claim is accepted, prepare the claim discharge."
      ],
      "justification": "Direct match for the discharge preparation step in the acceptance path."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the claim discharge is prepared, record the benefit payment."
      ],
      "justification": "Direct match for recording the payment."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "Final steps and process termination align with the closing instructions."
    }
  ],
