@startuml
!theme plain
|a_default| Default
|a_default|
start
:undergo immigration checks;
:select method for exit control checks;
:v_method: exit control method ({biometrics, id_documents}); <<objectSignal>>
if () then ([v_method = 'biometrics'])
:use biometrics for exit control checks;
else ([v_method = 'id_documents'])
:use ID documents for exit control checks;
endif
:v_result: check outcome status ({denied_unsuccessful, allowed_successful}); <<objectSignal>>
if () then ([v_result = 'denied_unsuccessful'])
:leave the area;
else ([v_result = 'allowed_successful'])
:proceed to the next step;
endif
stop
@enduml