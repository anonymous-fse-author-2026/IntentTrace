      "verbatim_texts": [
        "The process starts with an informational meeting that lasts half a day"
      ],
      "justification": "Initiates the process and captures the first step and its duration."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the meeting is successful",
        "However, if the meeting is not successful"
      ],
      "justification": "Models the decision point immediately following the meeting."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the meeting is successful"
      ],
      "justification": "Guard representing the positive outcome condition."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "However, if the meeting is not successful"
      ],
      "justification": "Guard representing the negative outcome condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Terminates the flow when the meeting fails."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "work on the storyboard, which takes a full day"
      ],
      "justification": "Action executed on the success path."
    },
    {
      "refs": [
        "action:n6",
        "action:n5"
      ],
      "verbatim_texts": [
        "the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "Correctly splits the compound instruction into two distinct actions while preserving behaviour."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After that, the site development takes 2 days"
      ],
      "justification": "Direct match for the development step and duration."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the site is built, it goes through a review process that lasts 1 day."
      ],
      "justification": "Direct match for the review step and duration."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "moves on to the approval stage, which takes half a day."
      ],
      "justification": "Direct match for the approval step and duration."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the approval is complete, the process ends.",
        "if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
      ],
      "justification": "Models the decision point following the approval stage."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the approval is complete, the process ends."
      ],
      "justification": "Positive outcome path leading to process termination."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
      ],
      "justification": "Negative outcome path triggering the rebuild step."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "If the rebuild is complete, the process ends.",
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Models the second decision point after the rebuild attempt."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the rebuild is complete, the process ends."
      ],
      "justification": "Positive outcome path leading to termination."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Negative outcome path triggering the second rebuild attempt."
    }
