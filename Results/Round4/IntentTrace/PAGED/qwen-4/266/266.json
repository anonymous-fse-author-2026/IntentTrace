  "input_elements": [
    {
      "id": "i1",
      "content": "The process starts with an informational meeting that lasts half a day"
    },
    {
      "id": "i2",
      "content": "If the meeting is successful"
    },
    {
      "id": "i3",
      "content": "work on the storyboard, which takes a full day"
    },
    {
      "id": "i4",
      "content": "However, if the meeting is not successful"
    },
    {
      "id": "i5",
      "content": "the process ends."
    },
    {
      "id": "i7",
      "content": "the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
    },
    {
      "id": "i8",
      "content": "After that, the site development takes 2 days"
    },
    {
      "id": "i9",
      "content": "Once the site is built, it goes through a review process that lasts 1 day."
    },
    {
      "id": "i11",
      "content": "moves on to the approval stage, which takes half a day."
    },
    {
      "id": "i12",
      "content": "If the approval is complete, the process ends."
    },
    {
      "id": "i13",
      "content": "if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
    },
    {
      "id": "i14",
      "content": "If the rebuild is complete, the process ends."
    },
    {
      "id": "i15",
      "content": "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days."
    }
  ]
