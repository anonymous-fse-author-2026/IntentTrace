@startuml
!theme plain
|a_default| Default
|a_default|
start
:Informational meeting (half a day);
:v1: Meeting success ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:End process;
stop
else ([v1 = 'Yes'])
:Work on storyboard (full day);
:Prepare content;
:Design site (10 days);
:Develop site (2 days);
:Review site (1 day);
:Approval stage (half a day);
:v3: Approve site ({Approved, Rejected}); <<objectSignal>>
if () then ([v3 = 'Approved'])
:End process;
stop
else ([v3 = 'Rejected'])
:Rebuild site (3 days);
:v4: Rebuild result ({Complete, Rejected again}); <<objectSignal>>
if () then ([v4 = 'Complete'])
:End process;
else ([v4 = 'Rejected again'])
:Rebuild site again (3 days);
endif
stop
endif
endif
@enduml