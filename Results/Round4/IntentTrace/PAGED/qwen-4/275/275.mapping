{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process in the Admin Office,"
      ],
      "justification": "Initiates the process in the specified location. Action n1 restates the start condition."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "first check if it has started."
      ],
      "justification": "Directly captures the initial verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "verify the completeness of the invoices."
      ],
      "justification": "Direct match for the invoice completeness verification."
    },
    {
      "refs": [
        "guard:b1->n5",
        "guard:b1->n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they are marked as \"Uncompleted\", they should be returned to the client through postal mail."
      ],
      "justification": "Opens the decision gateway and routes the negative condition to the return action. Duplicate guard is redundant but behaviour-preserving."
    },
    {
      "refs": [
        "guard:b1->n6",
        "guard:b1->n8",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if they are marked as \"Completed\", the process should be continued."
      ],
      "justification": "Routes the positive condition to the continuation step. Duplicate guard is redundant but behaviour-preserving."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the invoices are returned to the client, receive the completed ones."
      ],
      "justification": "Matches the step to receive invoices after they are returned."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Then, mark the relevant box on the invoice entry form"
      ],
      "justification": "Direct match for updating the entry form."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "and proceed with checking if the process has been completed."
      ],
      "justification": "Acts as the rejoin/transition point before termination, preserving flow order."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Directly marks the process conclusion."
    }
  ],
