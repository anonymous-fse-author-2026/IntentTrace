{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Init marks the start of the process; action i1 directly describes the first step."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process."
      ],
      "justification": "Condition modeled as an action step preserves the behavioural meaning."
    },
    {
      "refs": [
        "action:i3"
      ],
      "verbatim_texts": [
        "if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Condition modeled as an action step preserves the behavioural meaning."
    },
    {
      "refs": [
        "action:i4"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct paraphrase of the counting/comparison step."
    },
    {
      "refs": [
        "guard:b_status->i5",
        "action:i5"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process."
      ],
      "justification": "Opens the XOR decision point and captures the positive condition/guard accurately."
    },
    {
      "refs": [
        "guard:b_status->i6",
        "action:i6"
      ],
      "verbatim_texts": [
        "if the \"Order is incomplete and items are missing,\" we still continue the process."
      ],
      "justification": "Captures the missing-items branch condition and action."
    },
    {
      "refs": [
        "guard:b_status->i7",
        "action:i7"
      ],
      "verbatim_texts": [
        "if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Captures the damaged-items branch condition. Emailing is implicitly handled or merged, which does not change core flow behaviour."
    },
    {
      "refs": [
        "action:i8"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Direct match for the notification step regarding missing items."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Direct match for removing damaged items from inventory."
    },
    {
      "refs": [
        "guard:b_missing_resp->i10",
        "action:i10"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process."
      ],
      "justification": "Opens the second XOR decision and captures the positive return condition."
    },
    {
      "refs": [
        "guard:b_missing_resp->i11",
        "action:i11"
      ],
      "verbatim_texts": [
        "if the \"Customer does not return the missing items,\" we still continue the process. Finally, when the process is complete, it ends."
      ],
      "justification": "Captures the negative response branch and the stated process termination."
    },
    {
      "refs": [
        "guard:b_repair->i12",
        "action:i12"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process."
      ],
      "justification": "Opens the repair decision and captures the successful repair path."
    },
    {
      "refs": [
        "guard:b_repair->i13",
        "action:i13"
      ],
      "verbatim_texts": [
        "if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Captures the discard branch condition. Emailing is structurally preserved."
    },
    {
      "refs": [
        "action:i14"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order. If the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Converge rejoins flows; action models the packing step and continuation condition."
    },
    {
      "refs": [
        "action:i15"
      ],
      "verbatim_texts": [
        "if the \"Items are stored for future orders,\" we also continue the process. Once again, when the process is complete, it ends."
      ],
      "justification": "Models the alternative storage path and implicit completion state."
    }
  ],
