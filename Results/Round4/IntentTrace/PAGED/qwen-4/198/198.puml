@startuml
!theme plain
|a_default| Default
|a_default|
start
:identify the parts;
:v3: scenario_choice ({Elicit, Have, Supplied, Record}); <<objectSignal>>
switch ()
case ([v3 = 'Have'])
:proceed with the process;
case ([v3 = 'Elicit'])
:check availability of parts;
case ([v3 = 'Supplied'])
:continue with the process;
case ([v3 = 'Record'])
:order and receive part from Disuki;
:contract the customer;
endswitch
:end process;
stop
@enduml