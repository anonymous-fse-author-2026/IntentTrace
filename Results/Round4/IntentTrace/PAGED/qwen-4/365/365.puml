@startuml
!theme plain
|a_passenger| Passenger
|a_passenger|
start
:Passengers undergo immigration checks;
:Select method for exit control checks;
:v_method: Exit control check method ({Biometrics, ID documents}); <<objectSignal>>
if () then ([v_method = 'Biometrics'])
:Undergo biometric check;
:v_result: Check outcome ({Denied, Allowed}); <<objectSignal>>
if () then ([v_result = 'Denied'])
:Leave the area;
stop
else ([v_result = 'Allowed'])
:Proceed to next step;
stop
endif
else ([v_method = 'ID documents'])
:Check using identity documents;
:v_result: Check outcome ({Denied, Allowed}); <<objectSignal>>
if () then ([v_result = 'Denied'])
:Leave the area;
stop
else ([v_result = 'Allowed'])
:Proceed to next step;
stop
endif
endif
@enduml