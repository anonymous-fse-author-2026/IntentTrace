init(i1)
action(n2, "Passengers undergo immigration checks")
action(n3, "Select method for exit control checks")
branch(b1, XOR)
action(n4, "Undergo biometric check")
action(n5, "Check using identity documents")
branch(b2, XOR)
action(n7, "Leave the area")
end(e1)
action(n8, "Proceed to next step")
end(e2)
branch(b3, XOR)
action(n11, "Leave the area")
end(e3)
action(n12, "Proceed to next step")
end(e4)
defines(v_method, "Exit control check method", {"Biometrics", "ID documents"})
defines(v_result, "Check outcome", {"Denied", "Allowed"})
actor(a_passenger, "Passenger", [i1, n2, n3, b1, n4, n5, b2, b3, n7, n8, n11, n12, e1, e2, e3, e4])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, b2)
precedence(n5, b3)
precedence(b2, n7)
precedence(b2, n8)
precedence(n7, e1)
precedence(n8, e2)
precedence(b3, n11)
precedence(b3, n12)
precedence(n11, e3)
precedence(n12, e4)
guard(b1, n4, v_method = 'Biometrics')
guard(b1, n5, v_method = 'ID documents')
guard(b2, n7, v_result = 'Denied')
guard(b2, n8, v_result = 'Allowed')
guard(b3, n11, v_result = 'Denied')
guard(b3, n12, v_result = 'Allowed')