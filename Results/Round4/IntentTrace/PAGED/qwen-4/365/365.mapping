{
  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks, and then they should select the method for exit control checks."
      ],
      "justification": "Initiates the process and covers the first two sequential steps described in the opening unit."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics"
      ],
      "justification": "Introduces the first XOR gateway and attaches the biometric selection condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should undergo a check using biometrics"
      ],
      "justification": "Directly implements the biometric check action."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the passenger prefers to use ID documents"
      ],
      "justification": "Captures the alternative selection condition for the first branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "they should undergo checks using identity documents"
      ],
      "justification": "Directly implements the document check action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission, they should leave the area."
      ],
      "justification": "Models the first phrasing of the denial branch, including the decision point, condition, action, and path termination."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Models the allowance arm of the first phrasing, capturing condition, progression, and termination."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends."
      ],
      "justification": "Redundant restatement of the denial path. Preserves the exact condition, action, and explicit end signal."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Redundant restatement of the success path. Preserves condition, progression, and explicit end signal."
    }
  ],
