  "input_elements": [
    {
      "id": "i1",
      "content": "Passengers should start the process by undergoing immigration checks, and then they should select the method for exit control checks."
    },
    {
      "id": "i2",
      "content": "If the passenger chooses to use biometrics"
    },
    {
      "id": "i4",
      "content": "they should undergo a check using biometrics"
    },
    {
      "id": "i5",
      "content": "However, if the passenger prefers to use ID documents"
    },
    {
      "id": "i7",
      "content": "they should undergo checks using identity documents"
    },
    {
      "id": "i8",
      "content": "After the exit control checks, if the passenger is denied permission, they should leave the area."
    },
    {
      "id": "i9",
      "content": "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
    },
    {
      "id": "i10",
      "content": "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends."
    },
    {
      "id": "i11",
      "content": "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
    }
  ]
