{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, you should choose your destination and calculate the distance."
      ],
      "justification": "Starts the process and models the initial planning step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "While doing so, continue to check if you need to book a train or a flight."
      ],
      "justification": "Represents the routing decision as an action step followed by an XOR split."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the answer is \"no\", then proceed to book a train."
      ],
      "justification": "Maps the negative condition to the train booking path."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if the answer is \"yes\", then book a flight."
      ],
      "justification": "Maps the positive condition to the flight booking path."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours, the process will end."
      ],
      "justification": "Captures the time-bound availability check and its affirmative termination path."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, if 24 hours have passed, you should call a travel agency."
      ],
      "justification": "Captures the fallback time condition and the subsequent action."
    },
    {
      "refs": [
        "guard:b4->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If a code is available, the process will end along with the hotel reservation."
      ],
      "justification": "Captures the post-agency availability check and its affirmative termination path."
    },
    {
      "refs": [
        "guard:b4->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "if a code is not available, you should cancel your journey."
      ],
      "justification": "Captures the negative availability condition and the cancellation step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "In that case, the process will end as well."
      ],
      "justification": "Explicitly terminates the process following cancellation."
    }
  ],
