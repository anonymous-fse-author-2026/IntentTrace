@startuml
!theme plain
|a_default| Default
|a_default|
start
:receive the order;
split
:check the order;
:v1: is order okay ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'No'])
:send refusal;
:end process;
stop
else ([v1 = 'Yes'])
->;
endif
split again
:check the customer;
end split
:v2: is customer permitted ({No, Yes}); <<objectSignal>>
if () then ([v2 = 'No'])
:send refusal;
:end process;
stop
else ([v2 = 'Yes'])
:release the order;
:transfer the data in the database;
:v3: is worth greater than 10000 Euro ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:sign off on the order;
else ([v3 = 'No'])
:continue with the process;
endif
:sign off on the order and forward it to production;
split
:check the product quality;
split again
:start production;
split again
:produce the product;
split again
:create a material report;
end split
split
:send material report to the warehouse;
split again
:create a quality report;
split again
:send the product to shipment;
split again
:send the order to accounting;
end split
:send quality report to Finance;
:ship the product and send the invoice;
:archive the report;
:check the payment;
:v4: is payment received ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:close the order;
:end process;
stop
else ([v4 = 'No'])
:is reminder sent more than three times;
endif
endif
@enduml