{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Start node and actions faithfully capture the initial startup steps. Redundant modeling of 'start'/'click'/'select' preserves behavior without changing the process flow."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "First branch handles the >1000 case leading to review. Guard uses abstract variable but correctly represents the positive condition path."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Negative branch of the first decision correctly routes to checking translation need."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Second decision positive arm correctly routes to translating receipts."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Second decision negative arm routes to confirming receipts, followed by convergence before the next evaluation step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Direct match for the evaluation step following the convergence."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Review decision rejection branch correctly routes to editing the report."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Review decision approval branch correctly routes to re-checking translation need."
    },
    {
      "refs": [
        "action:n12",
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision. If the report is rejected, edit the report. If it is approved,"
      ],
      "justification": "Covers the second evaluation step and the rejection loop back to editing."
    },
    {
      "refs": [
        "guard:b4->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "translate the receipts and then confirm them."
      ],
      "justification": "Approval path from the second evaluation correctly combines translation and confirmation into a single step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Final evaluation step and branching point for receipt acceptance/rejection."
    },
    {
      "refs": [
        "guard:b5->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Acceptance path leads to processing the expense and terminating the process."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Rejection path leads to editing the report and terminating the process."
    }
  ],
