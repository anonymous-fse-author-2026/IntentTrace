@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start Process;
:Enter Metadata;
:v2: Path Selection ({Patient, Supplier}); <<objectSignal>>
if () then ([v2 = 'Patient'])
:IN-Patient Step;
:v3: Case Handling ({Register, Extract}); <<objectSignal>>
if () then ([v3 = 'Register'])
:Register Case;
:Handle Claim;
else ([v3 = 'Extract'])
:Extract Data from Suppliers Again;
:Enter Data on Patient Record or Confirm IN-Patient Status;
:Send Data Back to Suppliers;
endif
:Receive Payment;
:End Process: Payment Received;
stop
else ([v2 = 'Supplier'])
split
:Send Data to Suppliers;
split again
:Create Claim;
end split
:Extract and Transfer Data from Suppliers to Doctor;
:Confirm GOP;
:End Process: GOP Confirmed;
stop
endif
@enduml