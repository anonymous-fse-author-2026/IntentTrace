      ],
      "verbatim_texts": [
        "To initiate the process for mobile application and integration with the suppliers network system, begin by starting and entering the metadata."
      ],
      "justification": "The opening unit implicitly triggers the process start and describes the first two sequential actions."
    },
    {
      "refs": [
        "action:n3",
        "guard:b_main->n3"
      ],
      "verbatim_texts": [
        "After entering the metadata, proceed to the IN-Patient step."
      ],
      "justification": "Directly maps to the IN-Patient step action. The branch and guard are structural plumbing that preserve the stated flow direction."
    },
    {
      "refs": [
        "guard:b_main->b3",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: send data to suppliers and create a claim."
      ],
      "justification": "Captures the explicit parallel execution ('At the same time') via an AND gateway splitting into the two described actions. The guard label aligns with the supplier-related path."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Once the data is sent to suppliers, extract the data from the suppliers and transfer it to the doctor's phone."
      ],
      "justification": "Faithful paraphrase combining the extraction and transfer steps into a single action node."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "confirm the GOP and the process will come to an end."
      ],
      "justification": "Models the confirmation step, the resulting end-of-process state, and uses convergence/end nodes as structural plumbing to terminate this path."
    },
    {
      "refs": [
        "guard:b_sub->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Next, register the case and handle the claim."
      ],
      "justification": "Maps the registration and claim handling steps. The branch and guard model the routing logic implied by the sequential narrative without altering behaviour."
    },
    {
      "refs": [
        "guard:b_sub->n11",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Extract the data from the suppliers and enter it on the patient's record or confirm the IN-Patient status."
      ],
      "justification": "Accurately captures the second extraction event and the subsequent record/status update step. Guard label matches the extraction concept."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "send the data back to the suppliers."
      ],
      "justification": "Direct match to the return transmission step."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "receive the payment and conclude the process."
      ],
      "justification": "Models the final payment reception and process conclusion, using convergence and end nodes as harmless structural terminators."
    }
