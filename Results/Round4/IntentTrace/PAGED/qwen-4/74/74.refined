branch(b_sub, XOR)
defines(v1, "Confirm GOP", {"Confirmed", "Not Confirmed"})
defines(v2, "Path Selection", {"Patient", "Supplier"})
defines(v3, "Case Handling", {"Register", "Extract"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, n6, n7, n8, e1, n9, n10, n11, n12, n13, n14, n15, e2, c2, c_merge, b3, b_main, b_sub])
