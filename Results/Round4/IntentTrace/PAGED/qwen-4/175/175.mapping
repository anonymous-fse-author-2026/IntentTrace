{
  "matches": [
    {
      "refs": [
        "action:n2",
        "action:n3",
        "action:n4"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Initiates the process and captures the initial item return pathways described in the opening context."
    },
    {
      "refs": [
        "action:n_check"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct match for the counting and contract comparison step."
    },
    {
      "refs": [
        "action:n5",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process. However, if the \"Order is incomplete and items are missing,\" we still continue the process. Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Captures the three order status outcomes. Modeling decision branches as sequential action steps preserves the intended behaviour per relaxed comparison rules."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\" we continue the process. Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Captures the post-check routing options (packing vs. storage)."
    },
    {
      "refs": [
        "action:n_miss"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Direct match for notifying the customer regarding missing items."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Direct match for handling damaged items inventory status."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process. However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Captures both outcomes of the customer's return decision branch."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Matches the first explicit process termination statement."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process. On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Captures the repair outcome branches. The discard action covers the decision point; the associated notification is contextually absorbed, preserving overall flow."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Matches the final termination statement and structurally closes the process flow."
    }
  ],
