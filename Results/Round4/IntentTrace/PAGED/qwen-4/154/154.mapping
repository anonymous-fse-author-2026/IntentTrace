      ],
      "verbatim_texts": [
        "To begin the process, the inventory needs to be checked."
      ],
      "justification": "Process start and initial inventory check. Redundant modeling preserves behavior."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Mac compares the inventory levels in the spreadsheet with the sales."
      ],
      "justification": "Direct paraphrase of the comparison step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the inventory level",
        "is high"
      ],
      "justification": "XOR gateway representing the inventory level decision point."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the inventory level",
        "is high"
      ],
      "justification": "Guard condition routing to the high-inventory path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Mac doesn't need to manually count the inventory."
      ],
      "justification": "Action taken when inventory is determined to be high."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "is low"
      ],
      "justification": "Guard condition routing to the low-inventory path."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Mac needs to manually count the inventory of items."
      ],
      "justification": "Actions covering the requirement to manually count items when low."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once Mac counts each item individually,",
        "they make a list of items that have a low stock count."
      ],
      "justification": "Step of creating a low-stock list following the manual count."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Mac selects suppliers for the needed products"
      ],
      "justification": "Supplier selection step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "places the order(s)"
      ],
      "justification": "Order placement step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "After receiving the order,"
      ],
      "justification": "Step capturing order receipt."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Final action and explicit process termination."
    }
