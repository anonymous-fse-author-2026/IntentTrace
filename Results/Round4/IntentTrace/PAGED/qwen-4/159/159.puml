@startuml
!theme plain
|a_default| Default
|a_default|
start
:Check if Referee Reports have been completed;
:v1: Check if Referee Reports have been completed ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:Flag and send reminder;
repeat :;
:Re-check Referee Reports status;
:v1: Check if Referee Reports have been completed ({No, Yes}); <<objectSignal>>
backward:Flag and send another reminder;
repeat while () is ([v1 = 'No']) not ([v1 = 'Yes'])
else ([v1 = 'Yes'])
->;
endif
:Proceed with organizing interviews;
:Organize interviews for Selection Panel;
repeat :Receive feedback from interview candidates;
:Check if Psychometric Test is required;
:v2: Check if Psychometric Test is required ({No, Yes}); <<objectSignal>>
backward:Check if HR Specialist is required;
repeat while () is ([v2 = 'Yes']) not ([v2 = 'No'])
:Coordinate second round of selection;
:Request final candidate ranking and continue process;
stop
@enduml