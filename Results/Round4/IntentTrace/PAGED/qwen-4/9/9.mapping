{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Init and the first two actions directly model the opening statement."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "XOR branch and its first arm correctly capture the incomplete/returned condition and step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Second arm of the branch captures the complete/continue path; modeled as an action step which preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Branches on compliance status; captures the non-compliant/further checks path."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Compliant path correctly modeled; phrasing retained as action content preserves behaviour."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Models the phone resolution condition and outcome."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Models the mail-back condition and return action."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Action captures the payment step described in this unit."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Directly models the concurrent billing step."
    },
    {
      "refs": [
        "guard:b9->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Models the waiting period upon no response."
    },
    {
      "refs": [
        "guard:b10->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "If the invoice is returned, non-compliance is resolved."
      ],
      "justification": "Models the resolution step when the invoice is returned."
    },
    {
      "refs": [
        "guard:b10->n27",
        "action:n27"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Handles the alternative flow repeating the no-response/wait condition; behaviour preserved."
    },
    {
      "refs": [
        "guard:b9->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Models the successful response path leading to payment and notification."
    },
    {
      "refs": [
        "action:n29",
        "action:n30"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Reminder action, explicit end action, and end node all map to this finalization unit."
    },
    {
      "refs": [
        "guard:b12->n32",
        "action:n32"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Models the unsatisfied condition and discrepancy resolution step."
    },
    {
      "refs": [
        "guard:b12->n33",
        "action:n33"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Models the satisfied condition, continuation action, and process termination."
    }
  ],
