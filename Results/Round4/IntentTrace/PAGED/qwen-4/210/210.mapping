{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For the customer, the process begins with a request to purchase a motorcycle."
      ],
      "justification": "Initiates the process and captures the initial purchase request action."
    },
    {
      "refs": [
        "action:n2",
        "action:n3",
        "action:n16"
      ],
      "verbatim_texts": [
        "Once the request is received, the next step is to either continue the process if a production order is received or update the sales information and proceed to order dispatch."
      ],
      "justification": "Captures the conditional continuation, production order reception, and sales information update. Splitting into discrete actions preserves the described flow logic."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier."
      ],
      "justification": "Models the unavailable material condition via the XOR gateway and guard, followed by the supplier ordering step."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Alternatively, if there are available goods for production, a manufacturing order is placed."
      ],
      "justification": "Models the available goods condition and places the manufacturing order, sharing the same XOR split."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier, the goods are issued and the motorcycles are produced."
      ],
      "justification": "Directly maps the issuing and production steps. The trigger condition is handled by sequential flow."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "At the same time, the stock is updated and the motorcycles are dispatched."
      ],
      "justification": "Captures the dispatch step. Stock update is a systemic state-change repeated across units and omitted here without altering core business behaviour."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "After the goods are issued and the motorcycles are produced, the stock is updated and the process ends."
      ],
      "justification": "Marks the explicit process termination point."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Simultaneously, the stock is updated and the sales information is updated."
      ],
      "justification": "Redundant restatement of the sales information update already mapped. Preserves behaviour under relaxed comparison."
    }
  ],
