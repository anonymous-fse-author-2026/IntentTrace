{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process"
      ],
      "justification": "Structural start node and a redundant action restating the initiation phase. Redundancy preserves behaviour."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "prioritize orders based on when they were received"
      ],
      "justification": "Direct paraphrase of the prioritization step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the customer's information"
      ],
      "justification": "Exact match for the initial verification action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If the customer exists"
      ],
      "justification": "Models the XOR split based on customer existence. Abstract guards correctly represent the positive/negative outcomes."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "we move on to checking their payment history"
      ],
      "justification": "Captures the two divergent actions triggered by the customer existence check."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "if the customer does not exist, we need to verify their customer status"
      ],
      "justification": "Captures the two divergent actions triggered by the customer existence check."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If the payment history is good"
      ],
      "justification": "Models the decision point diverging to private vs. wholesaler paths. n7 re-types the payment history condition as an action step, which is behaviour-preserving."
    },
    {
      "refs": [
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "if the customer is a private customer"
      ],
      "justification": "Models the decision point diverging to private vs. wholesaler paths. n7 re-types the payment history condition as an action step, which is behaviour-preserving."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer"
      ],
      "justification": "Models the decision point diverging to private vs. wholesaler paths. n7 re-types the payment history condition as an action step, which is behaviour-preserving."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "we send them a declining message"
      ],
      "justification": "Direct match for the private customer outcome."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer"
      ],
      "justification": "Direct match for the wholesaler onboarding step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "check for product availability"
      ],
      "justification": "Exact match for the availability check action."
    },
    {
      "refs": [
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If the products are not available",
        "If the products are available"
      ],
      "justification": "Models the XOR split based on product availability. n15 re-types the positive condition as an action step, preserving behaviour."
    },
    {
      "refs": [
        "guard:b4->b7"
      ],
      "verbatim_texts": [
        "If the products are not available",
        "If the products are available"
      ],
      "justification": "Models the XOR split based on product availability. n15 re-types the positive condition as an action step, preserving behaviour."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the products are not available",
        "If the products are available"
      ],
      "justification": "Models the XOR split based on product availability. n15 re-types the positive condition as an action step, preserving behaviour."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "produce the missing goods"
      ],
      "justification": "Covers production, decline message, and the explicitly stated process termination for unavailable products."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "send a decline message"
      ],
      "justification": "Covers production, decline message, and the explicitly stated process termination for unavailable products."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process"
      ],
      "justification": "Continues the main flow, sends confirmation, and uses an AND gateway (b7) to correctly model the simultaneous departmental notification."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "inform the stock and accounting departments"
      ],
      "justification": "Continues the main flow, sends confirmation, and uses an AND gateway (b7) to correctly model the simultaneous departmental notification."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice"
      ],
      "justification": "Direct match for the preparation phase before delivery."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "deliver the goods and invoice to the customer"
      ],
      "justification": "Exact match for the fulfillment step."
    },
    {
      "refs": [
        "guard:b5->c_close"
      ],
      "verbatim_texts": [
        "If payment has been received",
        "If payment has been received, we close the order"
      ],
      "justification": "Splits flow based on payment status, leading directly to order closure on the success path."
    },
    {
      "refs": [
        "guard:b5->n28"
      ],
      "verbatim_texts": [
        "If payment has been received",
        "If payment has been received, we close the order"
      ],
      "justification": "Splits flow based on payment status, leading directly to order closure on the success path."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "If payment has been received",
        "If payment has been received, we close the order"
      ],
      "justification": "Splits flow based on payment status, leading directly to order closure on the success path."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "if there is an outstanding payment, we check the quantity of reminders"
      ],
      "justification": "Re-types the reminder quantity check as a decision-prep action. Behaviour is preserved."
    },
    {
      "refs": [
        "guard:b6->n29"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process"
      ],
      "justification": "Models the final threshold decision. Abstract guards correctly map to the <3 and >3 outcomes."
    },
    {
      "refs": [
        "guard:b6->n30"
      ],
      "verbatim_texts": [
        "if there are more than three reminders, we activate the donning process"
      ],
      "justification": "Models the final threshold decision. Abstract guards correctly map to the <3 and >3 outcomes."
    },
    {
      "refs": [
        "action:n29"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process"
      ],
      "justification": "Content exactly restates the source unit. Converge node safely rejoins the main flow."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "if there are more than three reminders, we activate the donning process"
