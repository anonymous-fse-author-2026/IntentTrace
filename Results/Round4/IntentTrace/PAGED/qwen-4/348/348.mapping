{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n3"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Initiates the process and captures the first two sequential actions."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Models the incompleteness check and the return action. Guard uses a variable placeholder but preserves the negative condition."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Positive path continues to compliance checking, preserving flow."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Branch node structures the subsequent compliance-related splits."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Directly models the compliant path merging back into the main flow."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Correctly captures the phone resolution path."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Correctly captures the mail-back return path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Converges split flows and executes the combined payment/resolution step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Captures the parallel billing step; structural simplification does not alter behaviour."
    },
    {
      "refs": [
        "guard:b_resp->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Models the wait-for-response decision and the 10-day delay on the negative path."
    },
    {
      "refs": [
        "guard:b_resp->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Captures the positive response path leading to payment notification."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Follows the wait period with a reminder and terminates this branch."
    },
    {
      "refs": [
        "guard:b3->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Correctly branches on client dissatisfaction and resolves the discrepancy before ending."
    },
    {
      "refs": [
        "guard:b3->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Models the satisfaction path completing the process successfully."
    }
  ],
