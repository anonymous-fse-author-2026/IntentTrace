{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For MyCorp, the process begins by entering expenses."
      ],
      "justification": "Captures the implicit start of the process and the first explicit action step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After entering expenses, the next step is to generate a spreadsheet."
      ],
      "justification": "Directly models the sequential step following expense entry."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the spreadsheet is generated, the request can be approved or disapproved."
      ],
      "justification": "Models the first decision point. Using an action node plus a branch node is a behaviour-preserving re-typing of the conditional split."
    },
    {
      "refs": [
        "label:b1->n5",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the request is approved, the expenses can be paid out."
      ],
      "justification": "Correctly captures the positive branch outcome, the guard condition, and the resulting payout action."
    },
    {
      "refs": [
        "label:b1->n2",
        "guard:b1->n2"
      ],
      "verbatim_texts": [
        "If the request is not approved, the process goes back to entering expenses."
      ],
      "justification": "Correctly captures the negative branch guard and its routing back to the expense entry step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Faithfully models the second approval check described in the source, preserving the redundant sequential flow."
    },
    {
      "refs": [
        "label:b2->n8",
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if it is approved, the expenses can be paid out."
      ],
      "justification": "Maps the positive outcome of the second check, including its guard, label, and payout action."
    },
    {
      "refs": [
        "label:b2->n2",
        "guard:b2->n2"
      ],
      "verbatim_texts": [
        "If it is not approved, the process goes back to entering expenses."
      ],
      "justification": "Maps the negative outcome of the second check and its loop-back routing."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Finally, after the expenses are paid out, the process comes to an end."
      ],
      "justification": "Captures the terminal action and the explicit end point of the process."
    }
  ],
