{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "you should choose your destination and calculate the distance"
      ],
      "justification": "Covers process initialization, a redundant start action, and the first concrete step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "While doing so, continue to check if you need to book a train or a flight."
      ],
      "justification": "Captures the checking step and establishes the XOR gateway for the subsequent decision."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the answer is \"no\", then proceed to book a train."
      ],
      "justification": "Correctly models the negative condition and the corresponding train booking action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the answer is \"yes\", then book a flight."
      ],
      "justification": "Correctly models the positive condition and the corresponding flight booking action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If a code is available within 24 hours, the process will end."
      ],
      "justification": "Re-types the conditional check as an action step, adds necessary branching/guard structure, and terminates the flow. Logic is duplicated for train and flight branches but preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8",
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Otherwise, if 24 hours have passed, you should call a travel agency."
      ],
      "justification": "Implements the alternative time-based condition and the required call-to-agency step on both paths."
    },
    {
      "refs": [
        "guard:b4->n9",
        "action:n9",
        "guard:b5->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If a code is available, the process will end along with the hotel reservation."
      ],
      "justification": "Models the secondary availability check as an action, adds structural routing, and reaches an end state. Includes a redundant end node (e5) which does not alter behaviour."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14",
        "guard:b5->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "On the other hand, if a code is not available, you should cancel your journey."
      ],
      "justification": "Correctly implements the cancellation step under the negative condition, concluding with appropriate end nodes."
    }
  ],
