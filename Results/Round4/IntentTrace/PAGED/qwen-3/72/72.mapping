{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "The init node marks the explicit process start, and action:n2 directly paraphrases the initial steps described in this unit."
    },
    {
      "refs": [
        "guard:b1->n4",
        "guard:b1->n6",
        "action:n4",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned. However, if the invoice is complete, the process continues."
      ],
      "justification": "The branch and guards correctly model the completeness decision (Incomplete vs Complete), routing to return or continuation steps. Paraphrasing and re-typing preserve behaviour."
    },
    {
      "refs": [
        "guard:b2->n8",
        "guard:b2->n9",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted. On the other hand, if the invoice is compliant, the process continues. If the issue can be resolved with a phone call, non-compliance is resolved. But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "The branch and guards abstract the compliance/non-compliance checks and their resolution methods (phone call vs mail back) into a single decision point. Behaviour and outcomes are preserved."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Action:n12 directly states the required step. Modeling it as a compliant-path outcome is a structural/plumbing choice that does not alter the process behaviour."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "The branch and guard capture the 'no response' condition, correctly directing flow to the 10-day waiting period action."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Modeling payment/notification as the alternate path (response received) correctly preserves the sequential/logical relationship described in the source."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "a reminder is sent"
      ],
      "justification": "Action:n18 matches the reminder step. The multiple end nodes are structural termination points implied by 'the process ends' in the surrounding context; structural endings do not require explicit textual backing and are treated as matches."
    },
    {
      "refs": [
        "guard:b4->n16",
        "guard:b4->n17",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved. However, if the client is satisfied, the process continues."
      ],
      "justification": "The branch and guards accurately split the flow based on client satisfaction, routing to discrepancy resolution or continuation. Thresholds and logic align perfectly with the source."
    }
  ],
