    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For the customer, the process begins with a request to purchase a motorcycle."
      ],
      "justification": "Captures the process initiation and the first actionable step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "continue the process if a production order is received"
      ],
      "justification": "Models the conditional path where receiving a production order allows the process to continue."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "or update the sales information and proceed to order dispatch."
      ],
      "justification": "Models the alternative path updating sales data and moving toward dispatch."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier."
      ],
      "justification": "Splits flow to handle material unavailability by triggering a supplier order."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Alternatively, if there are available goods for production, a manufacturing order is placed."
      ],
      "justification": "Handles the available-goods scenario by placing a manufacturing order."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier,"
      ],
      "justification": "Rejoins preceding branches upon material receipt before continuing downstream steps."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "the goods are issued"
      ],
      "justification": "Directly represents the goods issuance step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "and the motorcycles are produced."
      ],
      "justification": "Directly represents the motorcycle production step."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "the stock is updated and the motorcycles are dispatched.",
        "After the goods are issued and the motorcycles are produced, the stock is updated"
      ],
      "justification": "A single structural OR gateway manages the concurrent and repetitive final operations described across these two spans."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13",
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "the stock is updated and the motorcycles are dispatched."
      ],
      "justification": "Multiple elements capture the first mention of the stock update within the final phase."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "the sales information is updated"
      ],
      "justification": "Models the final concurrent update to sales information."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Many elements (terminating action and structural endpoints) collectively map to the single conclusion statement."
