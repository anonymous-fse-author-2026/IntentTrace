    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After the approval, the mandatory documentation along with the approval is sent to HR services."
      ],
      "justification": "Direct match to sending documentation to HR."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The form is then scanned and recorded into the GovSource system."
      ],
      "justification": "Direct match to scanning and recording step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "The approval is checked"
      ],
      "justification": "Preserves the redundant check present in the source text."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "and then sent along with the mandatory documentation to HR services."
      ],
      "justification": "Preserves the redundant sending step present in the source text."
