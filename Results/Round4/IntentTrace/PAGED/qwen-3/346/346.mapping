      ],
      "justification": "Direct match to the TS contact step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the approval is received, it is checked."
      ],
      "justification": "Direct match to the approval check step."
    },
    {
      "refs": [
