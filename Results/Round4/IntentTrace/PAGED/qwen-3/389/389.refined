init(s0)
action(n1, "start BPMN execution TDD process")
action(n2, "understand the BPMN Model")
converge(c1)
action(n3, "write a failing test")
action(n4, "extend BPMN mocks to make the test pass")
branch(b1, XOR)
action(n6, "check if the level satisfies the project requirements")
branch(b2, XOR)
action(n8, "end process")
end(e1)
action(n10, "upgrade the test level")
branch(b3, XOR)
action(n13, "end process")
end(e2)
action(n14, "upgrade the test level once more")
action(n15, "end process")
end(e3)
defines(v1, "is the test green", {true, false})
defines(v2, "does the level satisfy the project requirements", {true, false})
defines(v3, "does the level satisfy the project requirements", {true, false})
actor(a_default, "Default", [s0, n1, n2, c1, n3, n4, b1, n6, b2, n8, e1, n10, b3, n13, e2, n14, n15, e3])
precedence(s0, n1)
precedence(n1, n2)
precedence(n2, c1)
precedence(b2, c1)
precedence(c1, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n6)
precedence(n6, b2)
precedence(b2, n8)
precedence(n8, e1)
precedence(b1, n10)
precedence(n10, b3)
precedence(b3, n13)
precedence(n13, e2)
precedence(b3, n14)
precedence(n14, n15)
precedence(n15, e3)
guard(b1, n6, v1 = true)
guard(b1, n10, v1 = false)
guard(b2, n8, v2 = true)
guard(b2, c1, v2 = false)
guard(b3, n13, v3 = true)
guard(b3, n14, v3 = false)
label(b2, c1, "continue the process")