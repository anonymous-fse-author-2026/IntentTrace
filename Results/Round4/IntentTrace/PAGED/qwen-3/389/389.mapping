{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For developers practicing BPMN execution TDD, the first step is to understand the BPMN Model."
      ],
      "justification": "The opening unit establishes the process context and first step. The model adds a generic start action and structures the initial understanding step, both preserving the original behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, they should write a failing test."
      ],
      "justification": "Direct correspondence to the second sequential step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "To make the test pass, they need to extend BPMN/mocks."
      ],
      "justification": "Direct paraphrase of the third step, combining purpose and action."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "Once the test is green"
      ],
      "justification": "Opens the XOR gateway and routes the flow along the positive condition path using an abstract guard, which preserves the decision logic."
    },
    {
      "refs": [
        "guard:b1->n10"
      ],
      "verbatim_texts": [
        "If the test is not green"
      ],
      "justification": "Routes the flow along the negative condition path, correctly complementing the positive guard."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "they should check if the level satisfies the project requirements."
      ],
      "justification": "Models the first requirement evaluation step exactly as stated."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it does, the process ends."
      ],
      "justification": "Positive outcome of the first check is correctly routed to process termination."
    },
    {
      "refs": [
        "guard:b2->c1",
        "label:b2->c1"
      ],
      "verbatim_texts": [
        "If not, they should continue the process."
      ],
      "justification": "Negative outcome routes back through a converge node with an explicit label, faithfully modeling the loop-back instruction."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "they should upgrade the test level."
      ],
      "justification": "Direct match for the remediation action when the test fails."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "they need to check if the level satisfies the project requirements again."
      ],
      "justification": "The second evaluation is modeled as a branch point that terminates the process upon success, preserving the textual flow."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "If not, they should upgrade the test level once more."
      ],
      "justification": "Captures the final fallback action and cleanly closes the path with structural termination nodes, maintaining behavioural equivalence."
    }
  ],
