converge(c1)
converge(c2)
action(n9, "reserve funds and send PO")
action(n10, "receive packing slip and release funds")
action(n11, "end process: completed")
end(e2)
defines(v1, "inventory_level", {"above_min", "below_min"})
defines(v2, "po_decision_1", {"rejected", "accepted"})
defines(v3, "po_decision_2", {"rejected", "accepted"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, e1, n5, n6, b2, n7, n8, b3, c1, c2, n9, n10, n11, e2])
