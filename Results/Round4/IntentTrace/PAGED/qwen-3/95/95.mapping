{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Initiates the WIGGO process and captures the initial order placement. Redundant start action is a harmless modeling choice that preserves behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then proceed to Check the Customer's Credit Limit."
      ],
      "justification": "Directly models the credit limit verification step."
    },
    {
      "refs": [
        "guard:b1->c3",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "Branches on the positive response and proceeds to check article availability."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Handles the negative credit response by sending a denial and terminating that path."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "if the response is \"Okay\", proceed to Check the Availability of the Article again."
      ],
      "justification": "Routes the re-evaluation flow when availability check returns Okay."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Terminates the process with a denial on the second negative response."
    },
    {
      "refs": [
        "guard:b3->n13",
        "guard:b3->n14",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods. However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Correctly splits the flow between production and collection based on article availability. Boolean guards preserve the decision logic."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Models the order confirmation step."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "Uses an AND gateway to correctly represent the parallel shipping and invoicing steps."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Direct match for checking payment status."
    },
    {
      "refs": [
        "guard:b4->n20",
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the payment has been received, close the Order and end the process."
      ],
      "justification": "Positive payment path closes the order and terminates."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the payment has not been received, check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Negative payment path routes to the reminder count evaluation. Condition modeled as an action step preserves behaviour."
    },
    {
      "refs": [
        "guard:b5->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Threshold met triggers order write-off."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Handles the reminder sending path. The XOR split reasonably covers the additional/alternative flow described."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Finalizes the process after write-off with closure and termination."
    }
  ],
