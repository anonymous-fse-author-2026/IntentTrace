{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "Init implicitly starts the process. Action directly paraphrases the first step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model and check it."
      ],
      "justification": "Direct match for the second step."
    },
    {
      "refs": [
        "action:n4",
        "action:n5",
        "guard:b1->n5",
        "label:n3->n4"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\", then assign negative points."
      ],
      "justification": "Condition modeled as an action node opens the XOR branch. Guard captures the exact threshold. Action performs the consequence. Label is harmless structural plumbing."
    },
    {
      "refs": [
        "action:n6",
        "action:n7",
        "guard:b2->n7",
        "guard:b2->c1",
        "label:n5->n6"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\", assign negative points again."
      ],
      "justification": "Captures the secondary check, branch, and assignment. Convergence rejoins the flow."
    },
    {
      "refs": [
        "action:n8",
        "action:n9",
        "guard:b1->n9"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Models the positive branch from the first decision. Splitting into two action nodes does not change behavior."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "guard:b3->n11",
        "guard:b3->c3"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Condition, split, and consequence correctly aligned. Guards cover both arms."
    },
    {
      "refs": [
        "action:n12",
        "action:n13",
        "guard:b4->n13",
        "guard:b4->c4"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "Accurately reflects the conditional continuation step."
    },
    {
      "refs": [
        "action:n14",
        "action:n15",
        "guard:b5->n15",
        "guard:b5->c5"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Accurately reflects the conditional role assignment step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Direct paraphrase."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n20",
        "action:n21",
        "guard:b7->n21"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it."
      ],
      "justification": "Captures the condition and positive outcome of the first acceptance decision."
    },
    {
      "refs": [
        "action:n22",
        "guard:b7->n22"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Captures the negative outcome and re-joins the flow."
    },
    {
      "refs": [
        "action:n23",
        "action:n24",
        "guard:b8->n24"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Models the repeated acceptance check and presentation."
    },
    {
      "refs": [
        "action:n25",
        "guard:b8->n25"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again."
      ],
      "justification": "Covers the implicit negative arm (continuing work) to complete the decision structure. Behavior is preserved."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Finally, present the project"
      ],
      "justification": "Direct match for the final presentation step."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "the process will come to an end."
      ],
      "justification": "Explicitly models process termination."
    }
  ],
