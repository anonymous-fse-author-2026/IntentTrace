@startuml
!theme plain
|a_default| Default
|a_default|
start
:start buyer process;
:choose a book;
:choose what to do after selecting book;
:v1: choose what to do after selecting book ({view_details, new_copies, used_copies}); <<objectSignal>>
switch ()
case ([v1 = 'view_details'])
:view book details;
:choose what to do after viewing book details;
:v2: choose what to do after viewing book details ({view_new_copies, select_copy}); <<objectSignal>>
if () then ([v2 = 'view_new_copies'])
:view list of new copies from book details;
else ([v2 = 'select_copy'])
:select a copy and complete process;
endif
case ([v1 = 'new_copies'])
:view list of new copies;
case ([v1 = 'used_copies'])
:view list of used copies;
:evaluate list of used copies;
:select preferred copy and complete process;
endswitch
stop
@enduml