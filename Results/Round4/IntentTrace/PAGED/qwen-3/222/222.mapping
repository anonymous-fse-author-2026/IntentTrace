        "action:n2"
      ],
      "verbatim_texts": [
        "To start the SSP process, first ensure that the Invoice is ready for verification."
      ],
      "justification": "Covers process initiation and the initial readiness verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, check for invoice completeness."
      ],
      "justification": "Directly matches the completeness check step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to check for SLA."
      ],
      "justification": "Directly matches the SLA check step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "move on to checking for invoice compliance."
      ],
      "justification": "Directly matches the compliance check step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the batched invoices are allocated to the Data Entry Officer and this is done by 9 am on the next working day."
      ],
      "justification": "Directly matches the allocation step including its timing constraint."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "process the invoice batch"
      ],
      "justification": "Directly matches the core processing step."
    },
    {
      "refs": [
        "action:n8",
        "guard:b1->n9",
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "this should be repeated until all invoices are processed."
      ],
      "justification": "Models the repetition loop for processing. Guards and structural nodes abstract the loop control but preserve the intended behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "then take it to the outbox."
      ],
      "justification": "Directly matches the transfer to outbox step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "make sure to clear the outbox of the Data Entry Officer every hour."
      ],
      "justification": "Directly matches the hourly clearing instruction."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "done every hour until the outbox is completely cleared"
      ],
      "justification": "Captures the termination condition for the outbox clearing loop."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "which marks the end of the process."
      ],
      "justification": "Covers the explicit process termination point."
    }
  ],
