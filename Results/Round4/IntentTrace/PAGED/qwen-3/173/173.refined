init(i1)
action(n1, "start by identifying the vacancy")
branch(b1, XOR)
action(n2, "advertise the vacancy")
converge(c1)
branch(b2, XOR)
action(n3, "advertise the vacancy again")
action(n4, "proceed with selecting the appropriate applicant")
action(n5, "appoint the candidate, process ends")
end(e1)
defines(v1, "Is there a suitable candidate available", {"Yes", "No"})
defines(v2, "Is there a suitable candidate available", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, b1, n2, c1, b2, n3, n4, n5, e1])
precedence(i1, n1)
precedence(n1, b1)
precedence(b1, n2)
precedence(b1, c1)
precedence(n2, c1)
precedence(c1, b2)
precedence(b2, n3)
precedence(b2, n4)
precedence(n3, e1)
precedence(n4, n5)
precedence(n5, e1)
guard(b1, n2, v1 = "No")
guard(b1, c1, v1 = "Yes")
guard(b2, n3, v2 = "No")
guard(b2, n4, v2 = "Yes")