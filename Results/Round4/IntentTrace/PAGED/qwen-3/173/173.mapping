{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Implicitly starts the process and executes the initial identification step."
    },
    {
      "refs": [
        "guard:b1->n2",
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "Establishes the first XOR decision point and routes based on candidate availability (abstracted to Yes/No flags)."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "Captures the negative branch action."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "Represents the positive branch flowing into structural convergence to proceed."
    },
    {
      "refs": [
        "guard:b2->n3",
        "guard:b2->n4"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available"
      ],
      "justification": "Establishes the second XOR decision point and routes based on remaining availability."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "Captures the follow-up negative branch action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Captures the follow-up positive branch action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "Combines the final appointment step and termination into a single action followed by the end node, preserving sequential behavior."
    }
  ],
