@startuml
!theme plain
|a_default| Default
|a_default|
start
:start by identifying the vacancy;
:v1: Is there a suitable candidate available ({Yes, No}); <<objectSignal>>
if () then ([v1 = "No"])
:advertise the vacancy;
else ([v1 = "Yes"])
->;
endif
:v2: Is there a suitable candidate available ({Yes, No}); <<objectSignal>>
if () then ([v2 = "No"])
:advertise the vacancy again;
else ([v2 = "Yes"])
:proceed with selecting the appropriate applicant;
:appoint the candidate, process ends;
endif
stop
@enduml