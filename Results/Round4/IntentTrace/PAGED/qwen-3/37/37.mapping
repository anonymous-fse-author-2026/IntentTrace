{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Initiates the process and performs the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed to Check the Customer's Credit Limit."
      ],
      "justification": "Direct match for the credit limit verification step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n5",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article. However, if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Covers the conditional check, XOR split, both guard values, and both resulting actions. Modeling the condition as an action (n3) preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Captures the structural split and the negative response path for the availability check."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Matches the 'not available' guard and production action."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Matches the 'available' guard and collection action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "send an Order Confirmation."
      ],
      "justification": "Direct match for the confirmation step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Ship the Goods and Send the Invoice."
      ],
      "justification": "Direct match for shipping and invoicing."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Models the payment status check. Condition re-typed as action (n16) and structural branch are behaviour-preserving."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "close the Order and end the process."
      ],
      "justification": "Positive payment path correctly leads to closing and ending the process."
    },
    {
      "refs": [
        "guard:b4->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Negative payment path transitions to the reminder count check. Condition modeled as action preserves behaviour."
    },
    {
      "refs": [
        "guard:b5->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Captures the threshold decision and the write-off action."
    },
    {
      "refs": [
        "guard:b5->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Models the alternative path (count < 3) where a reminder is sent. Preserves overall branching behaviour."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Final steps, structural convergence, and endpoint correctly reflect the post-write-off closure."
    }
  ],
