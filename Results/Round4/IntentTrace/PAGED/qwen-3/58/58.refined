init(start)
action(n1, "Prioritize orders based on when received")
action(n2, "Check customer information")
branch(b1, XOR)
action(n3, "Check payment history")
action(n4, "Continue with the process")
action(n5, "Verify customer status")
branch(b3, XOR)
action(n6, "Send declining message to private customer")
end(e_private)
action(n7, "Create new customer")
action(n8, "Check product availability")
branch(b4, XOR)
action(n9, "Produce missing goods and send decline message, thus ending the process")
end(e_no_prod)
action(n10, "Continue with the process and send order confirmation")
action(n13, "Pack goods and write invoice")
action(n14, "Goods ready for delivery and invoice sent")
action(n15, "Deliver goods and invoice to customer")
branch(b6, XOR)
action(n16, "Close order")
end(e_paid)
action(n17, "Check quantity of reminders")
branch(b7, XOR)
action(n18, "Continue with the process")
end(e_cont)
action(n19, "Activate donning process")
end(e_donning)
defines(v_cust_exist, "Customer exists", {true, false})
defines(v_pay_good, "Payment history good", {true, false})
defines(v_cust_type, "Customer type", {"private", "wholesaler"})
defines(v_prod_avail, "Products available", {true, false})
defines(v_pay_received, "Payment received", {true, false})
defines(v_reminders, "Number of reminders", {[0-10]})
actor(a_default, "Default", [start, n1, n2, b1, n3, n4, n5, b3, n6, e_private, n7, n8, b4, n9, e_no_prod, n10, n13, n14, n15, b6, n16, e_paid, n17, b7, n18, e_cont, n19, e_donning])
precedence(start, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(b1, n5)
precedence(n3, n4)
precedence(n4, n13)
precedence(n5, b3)
precedence(b3, n6)
precedence(b3, n7)
precedence(n6, e_private)
precedence(n7, n8)
precedence(n8, b4)
precedence(b4, n9)
precedence(b4, n10)
precedence(n9, e_no_prod)
precedence(n10, n13)
precedence(n13, n14)
precedence(n14, n15)
precedence(n15, b6)
precedence(b6, n16)
precedence(b6, n17)
precedence(n16, e_paid)
precedence(n17, b7)
precedence(b7, n18)
precedence(b7, n19)
precedence(n18, e_cont)
precedence(n19, e_donning)
guard(b1, n3, v_cust_exist = true)
guard(b1, n5, v_cust_exist = false)
guard(b3, n6, v_cust_type = "private")
guard(b3, n7, v_cust_type = "wholesaler")
guard(b4, n9, v_prod_avail = false)
guard(b4, n10, v_prod_avail = true)
guard(b6, n16, v_pay_received = true)
guard(b6, n17, v_pay_received = false)
guard(b7, n18, v_reminders < 3)
guard(b7, n19, v_reminders >= 3)