{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "Start node and first action directly correspond to the opening unit."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information."
      ],
      "justification": "Direct paraphrase of the second step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer exists, we move on to checking their payment history."
      ],
      "justification": "Branch and guard capture the 'customer exists' condition leading to the payment history check action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "On the other hand, if the customer does not exist, we need to verify their customer status."
      ],
      "justification": "Guard captures the negative branch condition leading to the verification action."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the payment history is good, we can continue with the process."
      ],
      "justification": "The conditional continuation is re-typed as a simple action step. Per guidelines, re-typing conditions as actions preserves behaviour and is a MATCH."
    },
    {
      "refs": [
        "guard:b3->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Branch, guard, and action correctly model the private customer path and outcome. End node is acceptable structural plumbing."
    },
    {
      "refs": [
        "guard:b3->n7",
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Guard and two actions correctly split the wholesaler path into creation and availability check."
    },
    {
      "refs": [
        "guard:b4->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Branch, guard, and action accurately capture the unavailable product path and termination."
    },
    {
      "refs": [
        "guard:b4->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Guard and action correctly model the available product continuation path."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Single source unit split into two sequential action steps in the model, preserving behaviour."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Direct match to the delivery step."
    },
    {
      "refs": [
        "guard:b6->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Branch, guard, and action correctly model the paid path and order closure."
    },
    {
      "refs": [
        "guard:b6->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Guard and action correctly model the unpaid path leading to reminder check."
    },
    {
      "refs": [
        "guard:b7->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Branch, guard, and action model the low-reminder continuation path. End node is harmless structural addition."
    },
    {
      "refs": [
        "guard:b7->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Guard and action correctly model the high-reminder path activating the donning process and terminating."
    }
  ],
  "mutations": [],
  "omissions": [
    {
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "reason": "A clear, behaviour-relevant parallel/informative step described in the source that is completely absent from the model."
    }
  ],
