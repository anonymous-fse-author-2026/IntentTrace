{
  "matches": [
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Initiates the process and models the initial decision with explicit Yes/No guards corresponding to the implied branching."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Positive branch action directly paraphrased."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process."
      ],
      "justification": "Negative branch continues the flow. Redundant step preserves behaviour."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Negative branch continues the flow. Redundant step preserves behaviour."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n6",
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Models the second decision point with explicit Yes/No guards."
    },
    {
      "refs": [
        "action:n6",
        "guard:b3->n8",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\", then continue to check if the change is within the set client limits."
      ],
      "justification": "Second-level decision on limits with correct Yes/No guards."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, relay the applicant's changes."
      ],
      "justification": "Negative limit-check arm."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is within the limits, continue with the process."
      ],
      "justification": "Positive limit-check arm."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "After that, relay the applicant's changes and continue with the process."
      ],
      "justification": "Structural convergence joins prior branches before executing this step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n17",
        "guard:b4->n18"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Decision point on acceptability with explicit Yes/No guards."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If they are, continue with the process."
      ],
      "justification": "Positive arm."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If not, select a new applicant from the list."
      ],
      "justification": "Negative arm."
    },
    {
      "refs": [
        "action:n22",
        "guard:b6->n23",
        "guard:b6->n24"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Final decision point with explicit Yes/No guards."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "If they do, the process ends."
      ],
      "justification": "Positive termination branch. Additional end nodes are harmless structural plumbing."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "Otherwise, select a new candidate from the list."
      ],
      "justification": "Negative termination branch."
    }
