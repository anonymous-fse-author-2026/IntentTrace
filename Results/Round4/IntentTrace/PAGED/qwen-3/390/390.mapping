{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To begin the process, start with Orders Required and then place a Bulk order."
      ],
      "justification": "Captures process initiation and the first sequential actions. The redundant 'start process' step does not alter behaviour."
    },
    {
      "refs": [
        "action:n4",
        "action:n5",
        "action:n6",
        "guard:b1->n4",
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If the condition is \"Order with prior internal credit allowance\", proceed with processing the order for delivery."
      ],
      "justification": "Models the credit allowance decision point, the positive path (processing order), and the negative path (outstanding balance). Guards correctly represent the split conditions."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "a new order is placed and the process ends at the Warehouse."
      ],
      "justification": "Action places the new order; the structural end node captures the process termination described in the unit."
    },
    {
      "refs": [
        "action:n9",
        "action:n10",
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If Payments are Received, the process continues."
      ],
      "justification": "Correctly models the payment receipt condition and the continuing process path."
    },
    {
      "refs": [
        "action:n11",
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "the order is dropped"
      ],
      "justification": "Models the negative payment path where the order is dropped and the flow terminates."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "identify the order for installation."
      ],
      "justification": "Direct correspondence to the identification step."
    },
    {
      "refs": [
        "action:n14",
        "action:n15",
        "guard:b3->n15"
      ],
      "verbatim_texts": [
        "If the installation needs to be scheduled, an Installer will be assigned."
      ],
      "justification": "Captures the installation scheduling condition and the corresponding assignment action."
    },
    {
      "refs": [
        "action:n16",
        "guard:b3->n16"
      ],
      "verbatim_texts": [
        "it will be packed for delivery."
      ],
      "justification": "Models the alternative path where installation is not required, leading to packing and process completion."
    }
  ],
  "mutations": [],
  "omissions": [
    {
      "verbatim_texts": [
        "it will be recorded in the Accounts Receivable."
      ],
      "reason": "The source explicitly describes an accounting step triggered when a new order is placed. No model element captures this recording behaviour."
    }
  ],
