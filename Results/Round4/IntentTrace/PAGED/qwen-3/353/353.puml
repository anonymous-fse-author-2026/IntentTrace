@startuml
!theme plain
|a_default| Default
|a_default|
start
:check if order has been received;
:orderSum: sum of the order ({[0-]}); <<objectSignal>>
switch ()
case ([orderSum <= 500])
:continue with the process;
case ([orderSum > 2000])
:compute a discount of 4%;
case ([orderSum >= 1000 and orderSum <= 1500])
:compute a discount of 3%;
case ([orderSum > 500 and orderSum <= 999])
:compute a discount of 2%;
endswitch
:create the bill;
stop
@enduml