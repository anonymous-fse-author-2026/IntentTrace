{
  "matches": [
    {
      "refs": [
        "action:n_check"
      ],
      "verbatim_texts": [
        "To start the process, begin by checking if the order has been received."
      ],
      "justification": "Starts the process and models the initial verification step described in the opening unit."
    },
    {
      "refs": [
        "guard:b_decide->n_cont",
        "action:n_cont"
      ],
      "verbatim_texts": [
        "If the sum of the order is less than 500, then continue with the process."
      ],
      "justification": "Opens the decision gateway and models the continuation path for low-value orders. The boundary adaptation to <= 500 preserves the overall flow without changing meaningful behaviour."
    },
    {
      "refs": [
        "guard:b_decide->n_d4",
        "action:n_d4"
      ],
      "verbatim_texts": [
        "However, if the sum of the order is greater than 2000, compute a discount of 4%."
      ],
      "justification": "Captures the high-threshold condition and the corresponding discount calculation accurately."
    },
    {
      "refs": [
        "guard:b_decide->n_d3",
        "action:n_d3"
      ],
      "verbatim_texts": [
        "If the sum of the order falls between 1000 and 1500, compute a discount of 3%."
      ],
      "justification": "Directly maps the middle-range condition and its associated discount step."
    },
    {
      "refs": [
        "guard:b_decide->n_d2",
        "action:n_d2"
      ],
      "verbatim_texts": [
        "Similarly, if the sum of the order falls between 500 and 999, compute a discount of 2%."
      ],
      "justification": "Matches the lower-middle range condition and discount action. The strict lower bound (> 500) cleanly separates it from the <= 500 branch, preserving intended logic."
    },
    {
      "refs": [
        "action:n_bill"
      ],
      "verbatim_texts": [
        "Finally, create the bill and the process will come to an end."
      ],
      "justification": "Models the rejoining of divergent paths, the final billing task, and process termination. Structural convergence is harmless plumbing."
    }
  ],
