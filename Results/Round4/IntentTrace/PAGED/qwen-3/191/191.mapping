{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "The opening unit establishes the process start and the initial registration action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request. However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "Captures the fee-check action, the XOR decision point, and the guarded paths for 'no fee' and 'fee' scenarios."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to register a post-seminar request"
      ],
      "justification": "Directly models the no-fee branch action; the end node aligns with the text's indication that the process terminates after this registration."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "create a purchase request"
      ],
      "justification": "Directly matches the action required when a fee exists."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "A conditional check modeled as an action step, which preserves the intended behaviour."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "Covers the approval decision split and the resulting notification action."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "Covers the rejection decision path and the corresponding notification action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "Directly restates the follow-up action triggered by an approval notification."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "The summary action and final end node correspond to the rejection termination path described in the text."
    }
  ],
