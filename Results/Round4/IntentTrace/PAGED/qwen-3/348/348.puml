@startuml
!theme plain
|a1| Default
|a1|
start
:Bill for Purchased Goods/Services;
:Receive Invoice;
:v1: Invoice Completion ({Incomplete, Complete}); <<objectSignal>>
if () then ([v1 = 'Complete'])
:v2: Invoice Compliance ({Non-Compliant, Compliant}); <<objectSignal>>
if () then ([v2 = 'Compliant'])
->;
else ([v2 = 'Non-Compliant'])
:Further Checks Conducted;
:v3: Resolution Method ({Phone, Mail}); <<objectSignal>>
if () then ([v3 = 'Phone'])
:Resolve Non-Compliance via Phone;
else ([v3 = 'Mail'])
:Return Invoice via Mail;
stop
endif
endif
:Pay Invoice;
:Bill Client;
:v4: Billing Outcome ({No Response, Notified}); <<objectSignal>>
if () then ([v4 = 'No Response'])
:Wait for 10 Days;
:Send Reminder;
stop
else ([v4 = 'Notified'])
:Notify Client of Payment;
:v5: Client Satisfaction ({Unsatisfied, Satisfied}); <<objectSignal>>
if () then ([v5 = 'Unsatisfied'])
:Resolve Payment Discrepancy;
stop
else ([v5 = 'Satisfied'])
:Continue Process;
stop
endif
endif
else ([v1 = 'Incomplete'])
:Return Invoice;
stop
endif
@enduml