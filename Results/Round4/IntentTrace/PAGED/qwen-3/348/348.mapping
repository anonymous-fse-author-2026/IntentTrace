{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts"
      ],
      "justification": "Marks the initiation of the process."
    },
    {
      "refs": [
        "action:n_bill"
      ],
      "verbatim_texts": [
        "Bill for Purchased Goods/Services"
      ],
      "justification": "Directly corresponds to the first step."
    },
    {
      "refs": [
        "action:n_rec"
      ],
      "verbatim_texts": [
        "and then Receive Invoice."
      ],
      "justification": "Directly corresponds to the second step."
    },
    {
      "refs": [
        "guard:b1->n_ret_inc",
        "action:n_ret_inc"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Captures the incomplete condition and the return action."
    },
    {
      "refs": [
        "guard:b1->b2"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Models the continuation path when the invoice is complete."
    },
    {
      "refs": [
        "guard:b2->n_checks",
        "action:n_checks"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Captures the non-compliant branch and the subsequent checks."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Models the continuation path for compliant invoices."
    },
    {
      "refs": [
        "guard:b3->n_phone",
        "action:n_phone"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Captures the phone resolution path."
    },
    {
      "refs": [
        "guard:b3->n_mail",
        "action:n_mail"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Captures the mail return path."
    },
    {
      "refs": [
        "action:n_bill_cli"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Directly corresponds to the parallel billing step."
    },
    {
      "refs": [
        "guard:b4->n_wait",
        "action:n_wait"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Captures the waiting period triggered by lack of response."
    },
    {
      "refs": [
        "action:n_pay",
        "action:n_notify",
        "guard:b4->n_notify"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Models payment and notification. The guard represents the complementary path, which is an acceptable behavioral re-typing."
    },
    {
      "refs": [
        "action:n_remind"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Captures the reminder action. The converge and multiple end nodes represent structural flow joins and termination points implied by the text. Added structural plumbing preserves behavior."
    },
    {
      "refs": [
        "guard:b5->n_unsat",
        "action:n_unsat"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Captures the unsatisfied client path and discrepancy resolution."
    },
    {
      "refs": [
        "guard:b5->n_sat",
        "action:n_sat"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Captures the satisfied client continuation path."
    }
  ],
