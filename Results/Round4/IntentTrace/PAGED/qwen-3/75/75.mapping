{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The opening unit establishes the process trigger and the first two sequential steps. Redundant 'start' action does not change behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "create the claim and record it"
      ],
      "justification": "Direct paraphrase of the second process step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "make a decision on the claim"
      ],
      "justification": "Describes the decision point; modeled as both an action step and an XOR gateway, which preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected, then reject it."
      ],
      "justification": "Captures the rejection condition and the corresponding action step."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8",
        "action:n14"
      ],
      "verbatim_texts": [
        "However, if the claim is to be accepted, offer the benefit."
      ],
      "justification": "Captures the acceptance condition and the subsequent action. Modeling the condition as an action step ('accept the claim') alongside the actual task ('offer the benefit') is a harmless re-typing that preserves behaviour."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "review the claim rejection"
      ],
      "justification": "Direct match for the rejection-review step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "prepare the claim discharge"
      ],
      "justification": "Direct match for the discharge preparation step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "record the benefit payment"
      ],
      "justification": "Direct match for recording the payment."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted, continue the process. But if the claim rejection is not accepted, also continue the process."
      ],
      "justification": "Both branches explicitly lead to continuation; modeled as a convergence node feeding into a 'continue' action. Behaviour is fully preserved."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicitly models the process termination."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: operate outgoing payment and close the claim."
      ],
      "justification": "'At the same time' signals parallel execution, correctly captured by an AND gateway splitting into the two specified actions."
    }
  ],
