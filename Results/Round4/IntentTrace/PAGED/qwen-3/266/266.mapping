{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts with an informational meeting that lasts half a day"
      ],
      "justification": "Initiates the process; 'start' action is a generic placeholder for the initial meeting step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the meeting is successful"
      ],
      "justification": "Models the conditional split for a successful meeting."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the next step is to work on the storyboard, which takes a full day"
      ],
      "justification": "Direct paraphrase of the storyboard creation step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "However, if the meeting is not successful, the process ends."
      ],
      "justification": "Models the conditional split for an unsuccessful meeting leading to termination."
    },
    {
      "refs": [
        "action:n6",
        "action:n5"
      ],
      "verbatim_texts": [
        "the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "Models site design and content preparation as sequential steps following storyboard success (implicitly assumed by default flow)."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After that, the site development takes 2 days and is also done by the web design team."
      ],
      "justification": "Direct match for site development."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the site is built, it goes through a review process that lasts 1 day."
      ],
      "justification": "Direct match for site review."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the review is successful",
        "it moves on to the approval stage, which takes half a day."
      ],
      "justification": "Models the transition to and execution of the approval stage; review success is implicit in the sequential flow."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the approval is complete, the process ends."
      ],
      "justification": "Models the approval completion condition and resulting termination."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "However, if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
      ],
      "justification": "Models the approval rejection condition and the rebuild action."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the rebuild is complete, the process ends."
      ],
      "justification": "Models the rebuild completion condition and resulting termination."
    },
    {
      "refs": [
        "guard:b4->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Models the rebuild rejection condition, second rebuild action, and termination."
    }
  ],
