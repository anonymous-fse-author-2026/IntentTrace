  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process,"
      ],
      "justification": "Implicit process start node paired with the explicit initialization action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "make sure the Freights are ready to be shipped"
      ],
      "justification": "Direct paraphrase of the freight readiness verification step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then ship the freight."
      ],
      "justification": "Direct match for the shipping execution step."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: deliver the freight and notify the delivery."
      ],
      "justification": "AND gateway splits the flow for parallel delivery and notification steps, with a converge point joining them back, matching the simultaneous execution requirement."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the request for merchandise return is lodged, continue with the process."
      ],
      "justification": "Conditional continuation modeled as an action step preserves the intended behaviour."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "invoice the customer.",
        "Invoice the customer and the process ends with the customer being invoiced."
      ],
      "justification": "Captures the core invoicing action referenced across multiple source units."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If it has been 5 days"
      ],
      "justification": "Models the terminal state triggered by the five-day condition for customer invoicing."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the return is accepted"
      ],
      "justification": "XOR gateway opens the decision path and routes to the acceptance action upon a positive outcome."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Return the merchandise and the process ends with the merchandise being returned."
      ],
      "justification": "Executes the physical return, records the terminal state, and concludes the sub-process."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Reject the merchandise return and the process ends with the merchandise return request being rejected."
      ],
      "justification": "Handles the rejection branch, records the outcome state, and terminates the flow accordingly."
    },
    {
      "refs": [
        "guard:b1->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If a loss claim report is lodged"
      ],
      "justification": "Guard captures the lodgement condition on the XOR gateway, directing flow to the approval action."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "approve the loss claim and the process ends."
      ],
      "justification": "Completes the loss claim approval and explicitly marks the process termination."
    }
