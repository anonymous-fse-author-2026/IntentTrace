  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process, begin by supplying the requirement and then documenting it."
    },
    {
      "id": "i2",
      "content": "If the order is received via fax"
    },
    {
      "id": "i3",
      "content": "input the order into an Excel file"
    },
    {
      "id": "i4",
      "content": "If the order is received via mail or phone"
    },
    {
      "id": "i5",
      "content": "also input the order into an Excel file"
    },
    {
      "id": "i6",
      "content": "Once the Excel list is complete after a week, send it to the student."
    },
    {
      "id": "i7",
      "content": "Upon receiving the Excel list, type the orders into the MS-Access database."
    },
    {
      "id": "i8",
      "content": "After typing the orders into the database, ensure that it is completed."
    },
    {
      "id": "i9",
      "content": "Once the database is completed, control the incoming order."
    },
    {
      "id": "i10",
      "content": "At the same time, continue to do the check."
    },
    {
      "id": "i11",
      "content": "If the order is correct"
    },
    {
      "id": "i14",
      "content": "However, if the order is incorrect, contact the selling agency."
    },
    {
      "id": "i15",
      "content": "If the order is worth less than 5.000 \u20ac"
    },
    {
      "id": "i16",
      "content": "If the order is worth more than 5.000 \u20ac"
    },
    {
      "id": "i17",
      "content": "send it for sign off and continue with the check."
    },
    {
      "id": "i18",
      "content": "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
    },
    {
      "id": "i19",
      "content": "Once the order is signed off, contact the client and release the order."
    },
    {
      "id": "i21",
      "content": "Once the order is received by PPC, they will initiate production."
    },
    {
      "id": "i22",
      "content": "If the issue cannot be solved"
    },
    {
      "id": "i24",
      "content": "If the issue can be solved"
    },
    {
      "id": "i25",
      "content": "After PPC initiates production, the goods will be produced."
    },
    {
      "id": "i26",
      "content": "If the order needs to be cancelled"
    },
    {
      "id": "i28",
      "content": "If not, check the quality of the goods."
    },
    {
      "id": "i29",
      "content": "Once the quality is checked, create and send a quality report to the finance department."
    },
    {
      "id": "i30",
      "content": "Release the order via memo and ensure that the memo is achieved in the warehouse."
    },
    {
      "id": "i31",
      "content": "Send the invoice and once it is sent, report the achievement to the finance department."
    },
    {
      "id": "i32",
      "content": "At the same time, commission the goods and sign and send the memo."
    },
    {
      "id": "i33",
      "content": "Also, send the goods and ensure that the signed memo is achieved in the logistic department."
    },
    {
      "id": "i34",
      "content": "Finally, archive the memo and close the order."
    }
  ]
