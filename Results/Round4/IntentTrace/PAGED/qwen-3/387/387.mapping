{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle"
      ],
      "justification": "Covers the process start and the initial trigger action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then check the inventory level. If the inventory level"
      ],
      "justification": "Directly maps to the inventory check step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "is at or below the minimum"
      ],
      "justification": "Captures the XOR decision point and the guard for low inventory."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "create a purchase order"
      ],
      "justification": "Matches the purchase order creation action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Captures the high-inventory guard, termination action, and end node."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Maps to the purchase order review step."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected"
      ],
      "justification": "Captures the second XOR decision and the rejection guard."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "rework the purchase order",
        "Rework the purchase order and then review it."
      ],
      "justification": "Matches the rework action; the second span is a redundant restatement of the same behavior."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "if the purchase status is approved, reserve the funds."
      ],
      "justification": "Captures the approval guard and the fund reservation action."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "send the order to the supplier."
      ],
      "justification": "Direct match for dispatching the order."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "Models the AND gateway for parallel execution."
    },
    {
      "refs": [
        "action:n15",
        "action:n17"
      ],
      "verbatim_texts": [
        "Receive the packing slip and then record it."
      ],
      "justification": "Maps to receiving and recording the packing slip."
    },
    {
      "refs": [
        "action:n16",
        "action:n18"
      ],
      "verbatim_texts": [
        "Receive the invoice and then record it."
      ],
      "justification": "Maps to receiving and recording the invoice."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Captures the packing slip recording completion and its associated end node."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Captures the invoice recording completion and its associated end node."
    }
