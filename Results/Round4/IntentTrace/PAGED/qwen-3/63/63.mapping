{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start with Password Verification, followed by Verifiy Password."
      ],
      "justification": "The opening unit explicitly starts the process and describes the initial verification steps. Structural init and two actions faithfully capture the beginning sequence."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If you choose \"Select Cancel\", you will be directed to iforgot.apple.com."
      ],
      "justification": "Captures the first branch option and its guard condition accurately. The redirect action matches the text."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if you select \"Reset password\", you will be automatically directed to iforgot.apple.com."
      ],
      "justification": "Second branch option and guard correctly modeled. Action preserves the automatic redirect behaviour."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "In case you choose \"Retry\", you will need to re-enter your password."
      ],
      "justification": "Third branch option and guard. Action correctly captures the re-entry requirement."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After that, go to iforgot.apple.com and proceed with Reset Password."
      ],
      "justification": "Follow-up step after the retry path. Content directly paraphrases the source unit."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once you are automatically directed to iforgot.apple.com, proceed with Reset Password."
      ],
      "justification": "Follow-up step for the reset-path redirect. Behaviour matches the source description."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If you need to re-enter your password, do so and then verify it."
      ],
      "justification": "Covers the verification step that follows re-entry. Splitting the re-entry/verify logic across two nodes preserves the intended behaviour."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "In case you choose \"Retry\", you will need to re-enter your password.",
        "After that, go to iforgot.apple.com and proceed with Reset Password.",
        "Once you are automatically directed to iforgot.apple.com, proceed with Reset Password."
      ],
      "justification": "Structural join that reunites the three divergent branch paths (Cancel, Reset, Retry) before proceeding to the common next step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the password is reset, you can return to the iTunes purchases page."
      ],
      "justification": "Directly models the post-reset navigation step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "From there, select the price of the item."
      ],
      "justification": "Exact behavioural match for the price selection step."
    },
    {
      "refs": [
        "guard:b2->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If prompted to \"Enter Password\", verify the password."
      ],
      "justification": "Models the second decision point and the positive prompt guard/action correctly."
    },
    {
      "refs": [
        "guard:b2->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "Alternatively, if asked to \"Enter Apple ID\", enter the password."
      ],
      "justification": "Correctly captures the alternative prompt condition and the corresponding entry action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Finally, enter the password and verify it."
      ],
      "justification": "Models the final verification step. Paraphrasing preserves the intended behaviour."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, enter the password and verify it."
      ],
      "justification": "Structural convergence nodes, a redundant 'end process' action, and the terminal node provide harmless plumbing to close the model. Behaviour is unchanged and consistent with the process conclusion."
    }
  ],
