{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Initialization node and the explicit starting action directly correspond to this opening unit."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000"
      ],
      "justification": "Models the threshold check, the branching gateway, and the positive guard correctly."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "less than or equal to 1000"
      ],
      "justification": "Captures the alternative threshold guard."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the report should be reviewed"
      ],
      "justification": "Directly matches the review step triggered for high-value expenses."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to check if there is a need for translation"
      ],
      "justification": "Structural converge joins paths, followed by the translation check node and its positive guard. Paraphrasing preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If translation is required"
      ],
      "justification": "Structural converge joins paths, followed by the translation check node and its positive guard. Paraphrasing preserves behaviour."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed to translate the receipts"
      ],
      "justification": "Matches the translation action."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Captures the negative translation guard."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "confirm the receipts"
      ],
      "justification": "Matches the confirmation step when translation is not needed."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Converge joins previous paths, leading to the first review evaluation node and gateway."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Correctly models the rejection branch and the associated edit action."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11",
        "guard:b6->n15",
        "guard:b6->n16"
      ],
      "verbatim_texts": [
        "If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Captures the approval guard, the repeated translation check action, and its implied branching/guards."
    },
    {
      "refs": [
        "action:n15",
        "action:n16",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Models the fallback translation/confirmation steps followed by the explicit re-evaluation gateway."
    },
    {
      "refs": [
        "guard:b7->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report."
      ],
      "justification": "Redundant restatement of the rejection/edit path for the second evaluation. Behaviour is preserved."
    },
    {
      "refs": [
        "guard:b7->n22",
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Splits the approval outcome into sequential translate and confirm steps, preserving the intended flow."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Maps the final evaluation node, gateway, and the acceptance guard correctly."
    },
    {
      "refs": [
        "guard:b9->n19"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Maps the final evaluation node, gateway, and the acceptance guard correctly."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Directly matches the expense processing step."
    },
    {
      "refs": [
        "guard:b9->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Correctly captures the rejection guard and the resulting edit action."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Explicitly models the finalization action and the process endpoint."
    }
  ],
