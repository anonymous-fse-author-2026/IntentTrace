      "verbatim_texts": [
        "To start the process, begin by selecting a filter and then applying it."
      ],
      "justification": "Process initiation and the first two actions directly correspond to the opening instruction."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After applying the filter, click on the Submit button."
      ],
      "justification": "Direct match for the submission step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, check if the option to submit is set to \"false\"."
      ],
      "justification": "The conditional check is modeled as an action node feeding into an XOR branch, which preserves the decision behavior."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is, then apply another filter."
      ],
      "justification": "Captures the branch taken when the condition is met (false option triggers another filter)."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the option to submit is set to \"true\", then continue with the process."
      ],
      "justification": "Captures the alternative branch when the option is true."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "If the option to submit is set to \"true\", then continue with the process."
      ],
      "justification": "Structural convergence point after the first decision split."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Additionally, check if there is another filter to apply."
      ],
      "justification": "Second decision point correctly modeled as a check action followed by a branch."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If there is, continue with the process."
      ],
      "justification": "True branch of the second decision."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If not, continue with the process."
      ],
      "justification": "False branch of the second decision."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "If not, continue with the process."
      ],
      "justification": "Structural convergence point after the second decision split."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Finally, if the option to submit is set to \"true\", continue with the process."
      ],
      "justification": "Final conditional check and process termination align with the concluding step."
    }
