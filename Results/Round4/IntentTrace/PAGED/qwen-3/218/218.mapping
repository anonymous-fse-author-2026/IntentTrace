  "matches": [
    {
      "refs": [
        "action:n2",
        "label:i1->c1"
      ],
      "verbatim_texts": [
        "For MyCorp, the process begins by entering expenses."
      ],
      "justification": "The opening unit implicitly starts the process and describes the first action. The label restates the same phrase."
    },
    {
      "refs": [
        "action:n3",
        "label:n2->n3"
      ],
      "verbatim_texts": [
        "After entering expenses, the next step is to generate a spreadsheet."
      ],
      "justification": "Describes the second step and its ordering relative to the first."
    },
    {
      "refs": [
        "action:n4",
        "label:n3->n4"
      ],
      "verbatim_texts": [
        "Once the spreadsheet is generated, the request can be approved or disapproved."
      ],
      "justification": "Introduces the first decision point. Modeling the condition as an action node before the branch preserves behaviour and is a match."
    },
    {
      "refs": [
        "action:n5",
        "label:b1->n5",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the request is approved, the expenses can be paid out."
      ],
      "justification": "Captures the positive branch outcome and the corresponding payout action. Guard value aligns with 'approved'."
    },
    {
      "refs": [
        "label:b1->c1",
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "the process goes back to entering expenses."
      ],
      "justification": "Describes the negative branch outcome looping back to the start. Converge point handles the rejoined flow."
    },
    {
      "refs": [
        "label:n5->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Describes the second decision point following the first payout."
    },
    {
      "refs": [
        "action:n8",
        "label:b2->n8",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "But if it is approved, the expenses can be paid out."
      ],
      "justification": "Captures the second positive branch outcome and action."
    },
    {
      "refs": [
        "label:b2->c1",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "the process goes back to entering expenses."
      ],
      "justification": "Describes the second negative branch outcome looping back."
    },
    {
      "refs": [
        "action:n10",
        "label:n8->n10"
      ],
      "verbatim_texts": [
        "Finally, after the expenses are paid out, the process comes to an end."
      ],
      "justification": "Describes the final termination step."
    }
  ],
