init(i1)
action(n1, "begin the process for ACME Company")
action(n2, "receive the customer request")
action(n3, "check the current inventory level")
branch(b1, XOR)
action(n4, "accept the customer request")
action(n4_1, "create a purchase order")
action(n5, "reject the customer request")
end(e1)
action(n6, "review the purchase order")
branch(b2, XOR)
action(n7, "rework the purchase order")
action(n16, "review the purchase order again")
action(n8, "reserve the funds")
action(n9, "send the purchase order")
action(n10, "receive the packing slip")
action(n11, "record the packing slip")
action(n12, "release the reserved funds and issue the payment")
action(n13, "receive the invoice")
action(n14, "record the invoice")
action(n15, "end the process")
end(e2)
converge(c1)
converge(c2)
branch(b3, AND)
defines(v1, "check inventory level", {"at_or_below", "above"})
defines(v2, "review purchase order", {"approved", "rejected"})
actor(a_default, "Default", [i1, n1, n2, n3, b1, n4, n4_1, n5, e1, n6, b2, n7, n16, n8, n9, b3, n10, n11, c1, n12, n13, n14, n15, e2, c2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, e1)
precedence(n4, n4_1)
precedence(n4_1, c2)
precedence(n6, b2)
precedence(b2, n7)
precedence(b2, n8)
precedence(n7, n16)
precedence(n16, c2)
precedence(c2, n6)
precedence(n8, n9)
precedence(n9, b3)
precedence(b3, n10)
precedence(b3, n13)
precedence(n10, n11)
precedence(n13, n14)
precedence(n11, c1)
precedence(n14, c1)
precedence(c1, n12)
precedence(n12, n15)
precedence(n15, e2)
guard(b1, n4, v1 = 'at_or_below')
guard(b1, n5, v1 = 'above')
guard(b2, n7, v2 = 'rejected')
guard(b2, n8, v2 = 'approved')