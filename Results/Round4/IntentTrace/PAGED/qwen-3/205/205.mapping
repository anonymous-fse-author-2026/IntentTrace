      ],
      "verbatim_texts": [
        "To initiate the process for ACME Company, the Resupply Cycle is triggered"
      ],
      "justification": "Covers the process start and the initial cycle trigger action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "checking the Inventory Level"
      ],
      "justification": "Direct action match."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the Inventory is greater than the Minimum Level",
        "Otherwise, a Purchase Order is created"
      ],
      "justification": "Represents the decision point based on inventory status."
    },
    {
      "refs": [
        "guard:b1->c2"
      ],
      "verbatim_texts": [
        "If the Inventory is greater than the Minimum Level"
      ],
      "justification": "Abstract guard preserves the 'greater' outcome leading to process termination."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "Otherwise, a Purchase Order is created"
      ],
      "justification": "Captures the alternative branch condition and resulting creation step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "The Purchase Order is then reviewed"
      ],
      "justification": "Direct match for the review step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected, it is reworked",
        "if the Purchase Order is accepted, funds are reserved for payment"
      ],
      "justification": "Models the review decision point. Source redundancy was collapsed into a single decision, preserving behaviour."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the Purchase Order is rejected, it is reworked"
      ],
      "justification": "Correctly captures rejection condition and rework action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "if the Purchase Order is accepted, funds are reserved for payment"
      ],
      "justification": "Correctly captures acceptance condition and fund reservation."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the Purchase Order is sent to the Supplier"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n9",
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: the Packing Slip is received and the Invoice is received"
      ],
      "justification": "AND gateway correctly models simultaneous reception of both documents."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Upon receiving the Packing Slip, it is recorded"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "upon receiving the Invoice, it is recorded"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Once the funds are released for payment, the payment is issued to the Supplier"
      ],
      "justification": "Temporal condition modeled as an explicit action step followed by payment issuance; behaviour-preserving re-typing."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "Finally, the process ends with the issuance of payment to the Supplier"
      ],
      "justification": "Matches the final termination point."
