{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts with an informational meeting that lasts half a day, involving the customer and the web design team."
      ],
      "justification": "Covers process initiation and the initial meeting step; 'Start' is a harmless abstraction/paraphrase that preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the meeting is successful, the next step is to work on the storyboard, which takes a full day"
      ],
      "justification": "Correctly captures the decision point, positive guard condition, and the subsequent storyboard action with accurate duration."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if the meeting is not successful, the process ends."
      ],
      "justification": "Captures the negative branch condition and the resulting process termination."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "the next steps are site design, which takes 10 days and is done by the web design team, and preparing the content."
      ],
      "justification": "Models the concurrent/subsequent steps for site design and content preparation using an AND split and converge, preserving parallelism."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After that, the site development takes 2 days and is also done by the web design team."
      ],
      "justification": "Direct behavioural match for the site development step and duration."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the site is built, it goes through a review process that lasts 1 day."
      ],
      "justification": "Direct match for the review step and duration."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the review is successful, it moves on to the approval stage, which takes half a day."
      ],
      "justification": "The conditional is modeled as an action step ('Is the review successful?'), which under relaxed rules is a behaviour-preserving match, followed by the approval stage action."
    },
    {
      "refs": [
        "guard:bA->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the approval is complete, the process ends."
      ],
      "justification": "Captures the positive approval outcome decision, guard, action, and termination point."
    },
    {
      "refs": [
        "guard:bA->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if the approval is rejected, the site needs to be rebuilt, which takes 3 days."
      ],
      "justification": "Captures the negative approval guard and the subsequent rebuild action with correct duration."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the rebuild is complete, the process ends."
      ],
      "justification": "Models the decision after rebuild, positive guard, and process termination."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the rebuild is rejected again, the site needs to be rebuilt again, which also takes 3 days."
      ],
      "justification": "Captures the negative rebuild guard, the second rebuild action, and the final termination step."
    }
  ],
