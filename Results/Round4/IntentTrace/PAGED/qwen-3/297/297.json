  "input_elements": [
    {
      "id": "i1",
      "content": "To become a member, start the process at 8:00 am and then empty the mailbox."
    },
    {
      "id": "i2",
      "content": "Check if the mailbox is empty"
    },
    {
      "id": "i3",
      "content": "if not, continue the process."
    },
    {
      "id": "i4",
      "content": "if it is empty, the process ends."
    },
    {
      "id": "i5",
      "content": "If it is empty, the process ends."
    },
    {
      "id": "i6",
      "content": "Check if the mailbox is empty again"
    },
    {
      "id": "i7",
      "content": "Verify if the information is complete."
    },
    {
      "id": "i8",
      "content": "If it is complete, add the incoming mail number, date, and record it in the letter book."
    },
    {
      "id": "i9",
      "content": "If it is not complete, make a telephone call to the sender."
    },
    {
      "id": "i10",
      "content": "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
    },
    {
      "id": "i11",
      "content": "Every Wednesday evening, take the letter book and member register to Miranda."
    },
    {
      "id": "i12",
      "content": "If the applicant cannot become a member, write to them and inform them of the decision."
    },
    {
      "id": "i13",
      "content": "Simultaneously, calculate the fee and hand the letter to Charles."
    },
    {
      "id": "i14",
      "content": "Ask Charles to write the amount in the register."
    },
    {
      "id": "i15",
      "content": "Print the membership card with all the data and send it to the new member."
    },
    {
      "id": "i17",
      "content": "Hand the letter to Charles and add the new member to the register."
    },
    {
      "id": "i19",
      "content": "Prepare an invoice for the new members and continue the process."
    },
    {
      "id": "i20",
      "content": "and write the fee amount to the register."
    },
    {
      "id": "i21",
      "content": "If the applicant becomes a member, stamp 'new Member' on the letter and write the date on it."
    },
    {
      "id": "i22",
      "content": "After stamping 'new Member' on the letter and writing the date on it, write the data."
    }
  ]
