@startuml
!theme plain
|a_default| Default
|a_default|
start
:start with Bill for Purchased Goods/Services;
:Receive Invoice;
:v1: Is the invoice incomplete? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Return Invoice;
else ([v1 = 'No'])
:Is the invoice non compliant?;
:v2: Is the invoice non compliant? ({No, Yes}); <<objectSignal>>
if () then ([v2 = 'No'])
:Continue with compliant invoice process;
else ([v2 = 'Yes'])
:Conduct further checks on non compliant invoice;
:Can the issue be resolved with phone call?;
:v3: Can the issue be resolved with phone call? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:Resolve non compliance with phone call;
else ([v3 = 'No'])
:Return Invoice;
endif
endif
:Pay Invoice;
:Bill Client;
:v9: Is there response from client? ({No, Yes}); <<objectSignal>>
if () then ([v9 = 'No'])
:Wait period of 10 days;
:Is invoice returned?;
:v10: Is invoice returned? ({Yes, No}); <<objectSignal>>
if () then ([v10 = 'Yes'])
:Non compliance resolved;
:Send reminder after 10 days;
stop
else ([v10 = 'No'])
->;
endif
else ([v9 = 'Yes'])
:Handle Response;
endif
:Pay Invoice and notify client of payment;
:Is client unsatisfied?;
:v12: Is client unsatisfied? ({Yes, No}); <<objectSignal>>
if () then ([v12 = 'Yes'])
:Resolve payment discrepancy;
else ([v12 = 'No'])
:Continue process;
endif
stop
endif
@enduml