@startuml
!theme plain
|a_default| Default
|a_default|
start
:wake up;
:v1: are you hungry? ({hungry, not hungry}); <<objectSignal>>
if () then ([v1 = 'not hungry'])
:take a shower;
:v2: are you still hungry? ({hungry, not hungry}); <<objectSignal>>
if () then ([v2 = 'not hungry'])
:take a shower;
else ([v2 = 'hungry'])
:have breakfast;
endif
else ([v1 = 'hungry'])
:have breakfast;
:take a shower;
endif
:get on the bus;
stop
@enduml