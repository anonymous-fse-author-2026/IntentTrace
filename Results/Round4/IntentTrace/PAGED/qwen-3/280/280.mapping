{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "Captures the explicit start event and the initialization step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Check Levels of Inventory"
      ],
      "justification": "Direct correspondence to the inventory check step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report."
      ],
      "justification": "Correctly models the decision gate, the lower-bound guard, and the corresponding report action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Captures the upper-bound guard and its associated report generation."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Models the early termination path when inventory is sufficient."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)"
      ],
      "justification": "Direct match to the PO creation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Captures the mandatory review step following creation."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system.",
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Splits flow based on approval status, executes correct branch actions, and includes structural convergence nodes for flow rejoining."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system.",
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Splits flow based on approval status, executes correct branch actions, and includes structural convergence nodes for flow rejoining."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system.",
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Splits flow based on approval status, executes correct branch actions, and includes structural convergence nodes for flow rejoining."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system.",
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Splits flow based on approval status, executes correct branch actions, and includes structural convergence nodes for flow rejoining."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "Correctly implements an AND gateway to trigger concurrent fund reservation and PO mailing."
    },
    {
      "refs": [
        "label:n11->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Labels the transition accurately and captures the inventory receipt action."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip.",
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Handles the packing slip receipt/procedure across the parallel branches, preserving the flow logic."
    },
    {
      "refs": [
        "action:n14",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Covers the progression from packing slip to invoice receipt via matched actions."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Directly maps to the three-way match execution step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds.",
        "Once the funds are released, issue the payment."
      ],
      "justification": "Chains successful match to fund release, uses a descriptive label for the transition, and executes the payment issuance."
    },
    {
      "refs": [
        "label:n18->n19"
      ],
      "verbatim_texts": [
