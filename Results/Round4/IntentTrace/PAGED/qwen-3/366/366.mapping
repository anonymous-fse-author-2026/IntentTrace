      "verbatim_texts": [
        "To begin the process, start by checking the order received"
      ],
      "justification": "Initiates the process and performs the initial order check. The extra 'Start process' action is a harmless structural restatement that does not alter behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the availability of the article"
      ],
      "justification": "Directly corresponds to the first availability verification step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the article is not available, the next step is to initiate the procurement process."
      ],
      "justification": "Correctly models the decision point, the negative condition, and the resulting procurement action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "if the article is available, proceed to ship it"
      ],
      "justification": "Correctly captures the positive condition and the immediate shipping action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After shipping the article, check its availability again."
      ],
      "justification": "Structural convergence leads directly into the second availability check as described."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is still not available, initiate the procurement process."
      ],
      "justification": "Models the second decision point, negative outcome, and corresponding procurement step."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "proceed to ship the article"
      ],
      "justification": "Matches the fallback shipping action when the article becomes available."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "complete the financial settlement"
      ],
      "justification": "Direct match for the financial settlement step following shipment."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "the process ends with the receipt of payment"
      ],
      "justification": "Final action aligns exactly with the stated process termination condition."
    }
