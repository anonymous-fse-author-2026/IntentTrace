{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "The start node and first action directly correspond to the opening instruction initiating the process."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "The XOR branch introduces the decision point, the guard captures the negative condition, and the action executes the advertising step."
    },
    {
      "refs": [
        "guard:b1->c2",
        "action:c1"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "The guard captures the positive condition, the action models the continuation directive, and the converge node structurally rejoins the flow."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "The action accurately reflects the re-advertising step; the implicit conditional flow is preserved by the surrounding process structure."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "The action faithfully restates the selection step following the alternative condition."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "The appointment step, the descriptive ending action, and the terminal end node all correspond to the final completion statement. Redundant restatement of the end condition does not change behaviour."
    }
  ],
