  "input_elements": [
    {
      "id": "i1",
      "content": "To start the process, begin by receiving the claim."
    },
    {
      "id": "i2",
      "content": "Then, create the claim and record it."
    },
    {
      "id": "i3",
      "content": "After that, make a decision on the claim."
    },
    {
      "id": "i4",
      "content": "If the claim is to be rejected, then reject it."
    },
    {
      "id": "i5",
      "content": "However, if the claim is to be accepted, offer the benefit."
    },
    {
      "id": "i6",
      "content": "If the claim is rejected, review the claim rejection."
    },
    {
      "id": "i7",
      "content": "On the other hand, if the claim is accepted, prepare the claim discharge."
    },
    {
      "id": "i8",
      "content": "Once the claim discharge is prepared, record the benefit payment."
    },
    {
      "id": "i9",
      "content": "If the claim rejection is accepted, continue the process."
    },
    {
      "id": "i10",
      "content": "But if the claim rejection is not accepted, also continue the process."
    },
    {
      "id": "i11",
      "content": "Finally, the process ends."
    },
    {
      "id": "i12",
      "content": "At the same time, complete the following steps: operate outgoing payment and close the claim."
    }
  ]
