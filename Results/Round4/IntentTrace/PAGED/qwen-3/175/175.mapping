      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Implicit start node and direct action mapping for the initial rental return step."
    },
    {
      "refs": [
        "guard:b_ret->i2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process.",
        "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Models the XOR split between store return and site pickup. Conditions are formalized as guards and re-typed as action steps, preserving the branching behaviour. Converge rejoins the flow."
    },
