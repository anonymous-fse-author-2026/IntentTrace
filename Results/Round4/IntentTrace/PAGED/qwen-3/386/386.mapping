  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we receive the contract for the marketing campaign."
      ],
      "justification": "The opening unit implicitly starts the process and describes the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Once we have the contract, we take it to the department."
      ],
      "justification": "Directly corresponds to the second step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "In the next step, we input the customer's details into NKE."
      ],
      "justification": "Direct match for the third step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the customer's details are missing"
      ],
      "justification": "Opens the XOR split for missing details and routes to the contact action. Abstract guard value preserves the conditional logic."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "we contact the customers."
      ],
      "justification": "Opens the XOR split for missing details and routes to the contact action. Abstract guard value preserves the conditional logic."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After contacting the customers, we receive additional customer details."
      ],
      "justification": "Follows the contact step and matches the source exactly."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "if the customer's details are ready, we create a suitable team."
      ],
      "justification": "Covers the alternative branch condition and its resulting action."
    },
    {
      "refs": [
        "action:n9c"
      ],
      "verbatim_texts": [
        "Then, we create the team and check previous campaigns for reusable material."
      ],
      "justification": "Converges the parallel paths and executes the second half of the combined step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Upon finding reusable ideas from previous campaigns,"
      ],
      "justification": "Condition re-typed as an interrogative action step preserves behaviour. Structural converge joins flow. Subsequent action matches directly."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "we create a new concept."
      ],
      "justification": "Condition re-typed as an interrogative action step preserves behaviour. Structural converge joins flow. Subsequent action matches directly."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the new concept is created, we integrate new ideas and add further points."
      ],
      "justification": "Direct paraphrase of the integration step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Next, we integrate the revised campaign into the database."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The concept is then presented to the relevant party for consideration."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b3->n20"
      ],
      "verbatim_texts": [
        "If the concept is declined,"
      ],
      "justification": "Opens the second XOR split for declined outcomes and routes to the rework action."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "we rework it."
      ],
      "justification": "Opens the second XOR split for declined outcomes and routes to the rework action."
    },
    {
      "refs": [
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "On the other hand, if the concept is accepted,"
      ],
      "justification": "Alternative branch condition leading to customer presentation. Preserves decision logic."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "we proceed to present it to the customer."
      ],
      "justification": "Alternative branch condition leading to customer presentation. Preserves decision logic."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "This marks the end of the process."
