      "justification": "Action step directly implements the required re-check on the backorder path."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Termination action and end event correctly model the process stopping on this branch."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If the item can be reserved, the process should continue."
      ],
      "justification": "Negative guard handles the reservation case, allowing the process to proceed to assembly."
    },
    {
      "refs": [
