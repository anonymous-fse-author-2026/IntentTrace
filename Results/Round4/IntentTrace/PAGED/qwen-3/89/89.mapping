{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To start the process"
      ],
      "justification": "Explicitly marks the process initiation."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Course Packet Information Received should be sent"
      ],
      "justification": "Directly models the first required send action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "followed by sending the Design to Faculty."
      ],
      "justification": "Captures the immediate subsequent sending step."
    },
    {
      "refs": [
        "action:n4_f"
      ],
      "verbatim_texts": [
        "After sending the Design to Faculty, the Faculty will choose the design."
      ],
      "justification": "Exact restatement of the faculty selection step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Next, identify the content that requires copyright clearance and contact the publisher to obtain clearance."
      ],
      "justification": "Condenses the identification and publisher contact steps accurately."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If there is a need to \"Contact Faculty to inform of denial and ask if new content should be added\", then the process should be continued."
      ],
      "justification": "Models the conditional branch and the specific notification action."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if the \"Entire Course Packet Copyright Cleared\", then the MPC should Calculate the Course Packet Cost."
      ],
      "justification": "Models the alternative clearance condition and the cost calculation step."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "If there is a need to \"Contact Faculty to inform of denial and ask if new content should be added\", then the process should be continued.",
        "However, if the \"Entire Course Packet Copyright Cleared\", then the MPC should Calculate the Course Packet Cost."
      ],
      "justification": "Structural plumbing that rejoins the two diverging paths back into a single flow."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After calculating the Course Packet Cost, the MPC should add the Bookstore margin to determine the retail price."
      ],
      "justification": "Accurately captures the margin addition step following cost calculation."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If the Faculty needs to reconsider the course packet content to decrease the price, then the process should be continued."
      ],
      "justification": "Models the reconsideration condition and the loop-back continuation."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "Alternatively, if the Price of the Course Packet is finalized, then the MPC should notify the Bookstore of the Course packet, Course number, Faculty name, and sections."
      ],
      "justification": "Models the price finalization condition and the comprehensive notification action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the MPC notifies the Bookstore, the Packet information should be notified to the Bookstore, and the process will end."
      ],
      "justification": "Captures the final notification restatement and explicitly terminates the process."
    }
  ],
