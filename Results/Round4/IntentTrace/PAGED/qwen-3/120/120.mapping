      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, ask the 1st Level Support if there is an issue."
      ],
      "justification": "The opening unit implicitly starts the process and describes the initial inquiry step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the issue is resolved, provide feedback for the account manager."
      ],
      "justification": "Captures the first XOR decision point, the affirmative guard, and the resulting action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is a 1st Level issue, ask the developer for assistance."
      ],
      "justification": "Captures the alternative branch condition and the corresponding developer escalation action."
    },
    {
      "refs": [
        "action:n_check"
      ],
      "verbatim_texts": [
        "Then, check the result again."
      ],
      "justification": "Direct restatement of the intermediate verification step."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue is resolved, provide feedback for the account manager."
      ],
      "justification": "Reuses the same source span to model the repeated resolution check and action later in the flow. Behaviour-preserving repetition."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is still a 1st Level issue, ask the developer for help."
      ],
      "justification": "Models the negative outcome of the second check and the corresponding help request."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After that, provide feedback for the account manager and end the process."
      ],
      "justification": "Covers the final feedback action and explicitly models the process termination."
    },
    {
      "refs": [
        "action:n_i9"
      ],
      "verbatim_texts": [
        "Ask the developer and then provide feedback for the 1st Level support."
      ],
      "justification": "Exact restatement of the subsequent combined step."
    },
    {
      "refs": [
        "action:n_i10"
      ],
      "verbatim_texts": [
        "Finally, provide feedback for the 1st Level support and then provide feedback for the account manager."
      ],
      "justification": "Exact restatement of the closing feedback sequence."
    }
  ],
