  "input_elements": [
    {
      "id": "i1",
      "content": "For EC-Lille: Initially, if the option \"research schedule directly\" is selected"
    },
    {
      "id": "i2",
      "content": "then the action to be taken is \"Research schedule\"."
    },
    {
      "id": "i3",
      "content": "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
    },
    {
      "id": "i4",
      "content": "After validating the schedule, check if the schedule is satisfactory."
    },
    {
      "id": "i5",
      "content": "If it is not, then perform the action \"Research schedule\". If it is, then proceed with writing a ticket order to SNCF."
    },
    {
      "id": "i6",
      "content": "If the schedule is not satisfactory, perform the action \"Research schedule\". If it is still not satisfactory, then \"provide indications\". Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
    },
    {
      "id": "i8",
      "content": "After writing the ticket order, validate it."
    },
    {
      "id": "i9",
      "content": "Check if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
    },
    {
      "id": "i10",
      "content": "Check again if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
    },
    {
      "id": "i11",
      "content": "Check once more if the ticket order is approved. If it is, then the process ends. If it is not, then the process ends."
    }
  ]
}