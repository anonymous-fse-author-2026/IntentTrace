    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially, if the option \"research schedule directly\" is selected"
      ],
      "justification": "Process initiation implied by the opening context and scope definition."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n3",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "For EC-Lille: Initially, if the option \"research schedule directly\" is selected"
      ],
      "justification": "Models the evaluation of the option and the resulting XOR split. Boolean placeholders preserve the original decision logic."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Positive outcome of the initial option check."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Negative outcome path and its merge back into the main workflow."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Captures the schedule validation step and the subsequent satisfaction assessment."
    },
    {
      "refs": [
        "guard:b2->c2",
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\". If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "First decision point on schedule satisfaction, routing to retry or forward progression."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->c2",
        "guard:b3->n23",
        "action:n23",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\". If it is still not satisfactory, then \"provide indications\". Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Second iteration of the satisfaction check, handling retries, fallback indications, and convergence toward the next phase."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF.",
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Corresponds to the ticket order creation step referenced redundantly across both satisfaction branches."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Direct match for the post-order validation step."
    },
    {
      "refs": [
        "action:n14",
        "guard:b4->e2",
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
      ],
      "justification": "First approval verification cycle and its branching outcomes."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->e3",
        "guard:b5->n19",
        "action:n19"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved. If it is not, then the process ends. If it is approved, then validate the ticket order."
      ],
      "justification": "Second approval verification cycle, preserving the repeated validation pattern."
    },
    {
      "refs": [
        "action:n20",
        "guard:b6->e4",
        "guard:b6->e5"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved. If it is, then the process ends. If it is not, then the process ends."
      ],
      "justification": "Final approval check and dual termination paths exactly as stated."
    }
