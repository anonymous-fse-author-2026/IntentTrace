      "verbatim_texts": [
        "To begin the process for Metal Works, start by obtaining the raw material from the received list."
      ],
      "justification": "The unit initiates the process and defines the first operational step. 'Start' is a harmless structural restatement that does not alter behaviour."
    },
    {
      "refs": [
        "guard:b1->n4",
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "If the raw material is available in stock"
      ],
      "justification": "Captures the decision point. The XOR gateway and Yes/No guards faithfully model the available/not-available split without changing the decision logic."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "proceed to check the raw material and conclude the process."
      ],
      "justification": "Models the immediate conclusion path when material is in stock."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "select a supplier"
      ],
      "justification": "Models the alternate path when material is out of stock."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "send the material purchase order"
      ],
      "justification": "Directly matches the step performed after supplier selection."
    },
    {
      "refs": [
        "action:n10",
        "action:n9"
      ],
      "verbatim_texts": [
        "proceed to check the raw material and conclude the process."
      ],
      "justification": "Restates the concluding step taken after the purchase order is sent. Redundancy and re-typing of 'End' as an action do not change process behaviour."
    }
