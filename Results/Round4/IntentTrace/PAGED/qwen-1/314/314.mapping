{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Process initiation and the first operational step directly correspond to the opening instruction."
    },
    {
      "refs": [
        "guard:b1->c2",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "The XOR gateway opens the first decision. Guard v1='No' captures the absence of a candidate, routing through the convergence point to the advertising action."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "Guard v1='Yes' captures candidate availability, routing to the continuation step. Shares the upstream branch from the previous entry."
    },
    {
      "refs": [
        "guard:b3->n6",
        "action:n6",
        "guard:b4->n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "Captures the second negative check and re-advertising action. The duplicate branch/guard pair (b4) is structurally redundant but preserves the described behaviour without altering it."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8",
        "guard:b4->n8"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Captures the positive alternative path and the selection step. Duplicate guards correspond to the identical source condition."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "The appointment condition is modeled as an explicit action step leading directly to the process termination node, preserving the final behaviour."
    }
  ],
