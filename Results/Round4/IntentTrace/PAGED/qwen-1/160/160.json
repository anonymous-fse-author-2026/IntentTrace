  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start by claiming what is requested and then check the insured status of the claimant."
    },
    {
      "id": "i2",
      "content": "If the claimant is insured, proceed to evaluate the claim."
    },
    {
      "id": "i3",
      "content": "However, if the claimant is not insured, reject the claim."
    },
    {
      "id": "i4",
      "content": "Once the claim is rejected, notify the claimant and the process comes to an end."
    },
    {
      "id": "i5",
      "content": "If the claim is a simple one or a complex one, send the relevant forms accordingly."
    },
    {
      "id": "i6",
      "content": "Once the forms are returned, check them for completeness."
    },
    {
      "id": "i7",
      "content": "If all the relevant details are provided, proceed to register the claim."
    },
    {
      "id": "i8",
      "content": "However, if not all the relevant details are provided, inform the claimant to complete them."
    },
    {
      "id": "i9",
      "content": "Once the claim is registered, the process comes to an end."
    }
  ]
