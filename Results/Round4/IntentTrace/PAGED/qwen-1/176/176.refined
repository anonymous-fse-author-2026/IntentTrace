init(i1)
action(n2, "Receive loan application")
branch(b_sim, AND)
action(n3_risk, "Assess loan risk")
action(n3_credit, "Check credit history")
converge(c_sim)
action(n5, "Is applicant eligible?")
branch(b1, XOR)
action(n6, "Prepare acceptance pack")
action(n7, "Send acceptance pack")
action(n8, "Reject application")
action(n9, "End: Acceptance pack sent")
end(e1)
action(n10, "End: Application rejected")
end(e2)
defines(v1, "Is applicant eligible?", {"Yes", "No"})
actor(a_default, "Default", [i1, n2, b_sim, n3_risk, n3_credit, c_sim, n5, b1, n6, n7, n8, n9, e1, n10, e2])
precedence(i1, n2)
precedence(n2, b_sim)
precedence(b_sim, n3_risk)
precedence(b_sim, n3_credit)
precedence(n3_risk, c_sim)
precedence(n3_credit, c_sim)
precedence(c_sim, n5)
precedence(n5, b1)
precedence(b1, n6)
precedence(n6, n7)
precedence(n7, n9)
precedence(n9, e1)
precedence(b1, n8)
precedence(n8, n10)
precedence(n10, e2)
guard(b1, n6, v1 = 'Yes')
guard(b1, n8, v1 = 'No')