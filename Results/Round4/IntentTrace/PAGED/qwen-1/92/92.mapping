{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "To start, please register your participation for the event."
      ],
      "justification": "The init node and first action correspond exactly to the opening step of the process."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no fee, you should proceed to register a post-seminar request."
      ],
      "justification": "The XOR branch, guard (v1='No'), and action capture the no-fee path and its resulting step correctly."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "However, if there is a fee, you need to create a purchase request."
      ],
      "justification": "The guard (v1='Yes') and action capture the fee path and its resulting step correctly."
    },
    {
      "refs": [
        "label:n3->e1",
        "label:n8->e2"
      ],
      "verbatim_texts": [
        "Once you have registered a post-seminar request, the process will come to an end."
      ],
      "justification": "Both labels and end nodes represent the process termination after registering a post-seminar request. The duplicated label on the second path is structural plumbing that preserves the same termination behaviour described in the source."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, you should check if the purchase request has been approved."
      ],
      "justification": "The action and subsequent XOR branch capture the approval-check decision point."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is approved, you will receive an approved notification."
      ],
      "justification": "The guard (v2='Approved') and action capture the positive approval outcome correctly."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if the purchase request is rejected, you will be notified of the rejection."
      ],
      "justification": "The guard (v2='Rejected') and action capture the negative approval outcome correctly."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If you receive an approved notification, you should then register a post-seminar request."
      ],
      "justification": "The action faithfully restates the final registration step triggered by an approved notification."
    },
    {
      "refs": [
        "label:n7->e1"
      ],
      "verbatim_texts": [
        "If you receive a rejection notification, the process will come to an end."
      ],
      "justification": "The label corresponds exactly to the termination condition for the rejection path."
    }
  ],
