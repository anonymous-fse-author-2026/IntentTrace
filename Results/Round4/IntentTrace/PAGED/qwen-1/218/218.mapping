      "verbatim_texts": [
        "entering expenses."
      ],
      "justification": "The init node and n1 provide structural/contextual framing for the process start, while n2 executes the first behavioral step. Together they preserve the intended initiation."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the next step is to generate a spreadsheet."
      ],
      "justification": "Direct correspondence to the second process step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the spreadsheet is generated, the request can be approved or disapproved."
      ],
      "justification": "Models the decision point as both an action step and a gateway. This re-typing preserves the branching behavior."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if the request is approved,"
      ],
      "justification": "Captures the positive branch condition accurately."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the expenses can be paid out."
      ],
      "justification": "Direct match for the positive branch action."
    },
    {
      "refs": [
        "guard:b1->c_pre_n2"
      ],
      "verbatim_texts": [
        "If the request is not approved,"
      ],
      "justification": "Captures the rejection condition for the first check."
    },
    {
      "refs": [
        "converge:c_pre_n2"
      ],
      "verbatim_texts": [
        "the process goes back to entering expenses."
      ],
      "justification": "Structural convergence node that implements the loop back to the start, preserving the described feedback cycle."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Direct match for the explicitly stated second verification step."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "But if it is approved,"
      ],
      "justification": "Captures the positive condition for the second check."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the expenses can be paid out."
      ],
      "justification": "Matches the repeated payout action described after the second check."
    },
    {
      "refs": [
        "guard:b2->c_pre_n2"
      ],
      "verbatim_texts": [
        "If it is not approved,"
      ],
      "justification": "Captures the rejection condition for the second check, routing back through the existing convergence structure."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Finally, after the expenses are paid out, the process comes to an end."
      ],
      "justification": "The action and end node jointly capture the termination condition and final process state."
    }
