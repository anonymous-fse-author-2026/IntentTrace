init(i1)
action(n2, "pick up order")
action(n3, "request stock check")
action(n4, "check inventory")
branch(b1, XOR)
action(n6, "end process - stock rejected")
end(e1)
action(n7, "request shipping details")
action(n8, "receive shipping details")
branch(b2, AND)
action(n9, "send goods")
action(n10, "send invoice")
converge(c2)
action(n11, "receive payment")
action(n12, "end process")
end(e2)
defines(v1, "stock status", {"rejected", "approved"})
actor(a_default, "Default", [i1, n2, n3, n4, b1, n6, e1, n7, n8, b2, n9, n10, c2, n11, n12, e2])
precedence(i1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n6)
precedence(b1, n7)
precedence(n6, e1)
precedence(n7, n8)
precedence(n8, b2)
precedence(b2, n9)
precedence(b2, n10)
precedence(n9, c2)
precedence(n10, c2)
precedence(c2, n11)
precedence(n11, n12)
precedence(n12, e2)
guard(b1, n6, v1 = 'rejected')
guard(b1, n7, v1 = 'approved')