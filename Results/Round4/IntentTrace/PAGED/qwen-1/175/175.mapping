{
  "matches": [
    {
      "refs": [
        "action:a_return"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Implicit start and explicit first action match the opening unit exactly."
    },
    {
      "refs": [
        "action:a_cust_ret",
        "guard:b_method->a_cust_ret"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process."
      ],
      "justification": "Branch opens the choice, action contains the step, and guard captures the customer-return condition faithfully."
    },
    {
      "refs": [
        "action:a_crew_pick",
        "guard:b_method->a_crew_pick"
      ],
      "verbatim_texts": [
        "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Alternative path and its guard preserve the delivery crew condition; converge rejoins the flow."
    },
    {
      "refs": [
        "action:a_compare"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct match to the comparison step."
    },
    {
      "refs": [
        "action:a_complete",
        "guard:b_status->a_complete"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process."
      ],
      "justification": "Branch and guard correctly model the complete-order condition."
    },
    {
      "refs": [
        "action:a_incomplete",
        "guard:b_status->a_incomplete"
      ],
      "verbatim_texts": [
        "However, if the \"Order is incomplete and items are missing,\" we still continue the process."
      ],
      "justification": "Action and guard accurately reflect the incomplete-order path."
    },
    {
      "refs": [
        "action:a_damaged",
        "guard:b_status->a_damaged"
      ],
      "verbatim_texts": [
        "Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Captures the damaged-item branch and its notification requirement."
    },
    {
      "refs": [
        "action:a_pack_cond1",
        "guard:b_ps1->a_pack_cond1"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Models the post-status packing condition and branch correctly."
    },
    {
      "refs": [
        "action:a_store_cond1",
        "guard:b_ps1->a_store_cond1"
      ],
      "verbatim_texts": [
        "Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Alternative storage condition and convergence are correctly aligned."
    },
    {
      "refs": [
        "action:a_email_miss"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Exact match to the missing-items notification step."
    },
    {
      "refs": [
        "action:a_take_inv"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Direct match to the inventory removal step."
    },
    {
      "refs": [
        "action:a_miss_yes",
        "guard:b_miss_ret->a_miss_yes"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process."
      ],
      "justification": "Branch and guard correctly handle the positive return condition."
    },
    {
      "refs": [
        "action:a_miss_no",
        "guard:b_miss_ret->a_miss_no"
      ],
      "verbatim_texts": [
        "However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Handles the negative return path and rejoins flow."
    },
    {
      "refs": [
        "action:a_repaired",
        "guard:b_repair->a_repaired"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process."
      ],
      "justification": "Correctly models the repair path and its condition."
    },
    {
      "refs": [
        "action:a_discarded",
        "guard:b_repair->a_discarded"
      ],
      "verbatim_texts": [
        "On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Accurately captures the discard path, email action, and convergence."
    },
    {
      "refs": [
        "action:a_pack_lastly"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order."
      ],
      "justification": "Direct match to the final packing step."
    },
    {
      "refs": [
        "action:a_pack_check",
        "guard:b_final_cond->a_pack_check"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Models the final packing check condition and branch."
    },
    {
      "refs": [
        "action:a_store_check",
        "guard:b_final_cond->a_store_check"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Alternative storage check and final convergence are correctly aligned."
    },
    {
      "refs": [
        "action:a_email_rep"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges, and the process is complete."
      ],
      "justification": "Captures the final email notification and both process termination points."
    }
  ],
  "mutations": [],
  "omissions": [],
  "additions": [],
