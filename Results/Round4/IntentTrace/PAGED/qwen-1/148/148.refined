init(i1)
action(n1, "wake up")
branch(b1, XOR)
action(n3, "take a shower")
action(n4, "have breakfast")
converge(c1)
action(n8, "get on the bus and the process will be complete")
end(e1)
defines(v1, "are you hungry?", {"not hungry", "hungry"})
actor(a_default, "Default", [i1, n1, b1, n3, n4, c1, n8, e1])
precedence(i1, n1)
precedence(n1, b1)
