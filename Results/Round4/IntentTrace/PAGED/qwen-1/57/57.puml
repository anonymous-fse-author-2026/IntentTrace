@startuml
!theme plain
|a_default| Default
|a_default|
start
:make purchase and connect to website;
repeat :;
:search for item;
:add item to cart / continue shopping;
:v1: shopping choice ({Add item to cart, Continue Shopping}); <<objectSignal>>
backward:continue shopping;
repeat while () is ([v1 = 'Continue Shopping']) not ([v1 = 'Add item to cart'])
:proceed to checkout;
split
:enter address shipping method and payment information;
split again
:authorize credit card and check inventory levels;
end split
:credit card approved and inventory in stock?;
:v2: approval status ({approved, denied}); <<objectSignal>>
if () then ([v2 = 'approved'])
:transaction approved;
:display order confirmation number;
:show final order to customer;
:confirm the order;
:send confirmation notice via email;
:order entry complete;
stop
else ([v2 = 'denied'])
stop
endif
@enduml