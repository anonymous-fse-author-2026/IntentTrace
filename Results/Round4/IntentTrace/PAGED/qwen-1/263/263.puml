start
:v1: Is the informational meeting successful? ({true, false}); <<objectSignal>>
if () then ([v1 = true])
:Work on storyboard (full day);
:Site design and development preparation (10 days);
:Content preparation;
:Site development (2 days);
:Review process (1 day);
:Is the review successful?;
:Approval stage (half a day);
:v4: Is the approval complete? ({true, false}); <<objectSignal>>
if () then ([v4 = false])
:Rebuild site (3 days);
:v3: Is the rebuild approved? ({true, false}); <<objectSignal>>
if () then ([v3 = false])
:Rebuild site again (3 days);
:The process ends;
stop
else ([v3 = true])
:The process ends;
stop
endif
else ([v4 = true])
:The process ends;
stop
endif
else ([v1 = false])
:End Process;
stop
endif
