{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with Insurance \"emergency\" and then analyze the insurance agreement."
      ],
      "justification": "Start node and first action directly reflect the opening instruction."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If there is coverage, offer immediate help."
      ],
      "justification": "Branches on coverage status; guard abstracts the positive condition (v1='Yes') leading to the immediate help action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is no coverage, send out an offer for emergency help."
      ],
      "justification": "Guard abstracts the negative condition (v1='No') leading to the offer action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the offer is rejected, ask for a rejection notification."
      ],
      "justification": "Second decision point handles the rejection path correctly."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is accepted, proceed with internal accounting."
      ],
      "justification": "Positive acceptance path correctly modeled."
    },
    {
      "refs": [
        "guard:b_end->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "Repeat the same steps if necessary."
      ],
      "justification": "Loop structure with convergence, decision, and feedback action captures the repetition requirement."
    },
    {
      "refs": [
        "guard:b_end->e1"
      ],
      "verbatim_texts": [
        "The process concludes once all steps have been completed."
      ],
      "justification": "Negative loop exit condition and end node correctly implement process termination."
    }
  ],
