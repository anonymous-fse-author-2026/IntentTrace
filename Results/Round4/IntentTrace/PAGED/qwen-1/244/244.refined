init(i1)
action(n2, "check loan application")
branch(b1, XOR)
action(n4, "end process")
end(e1)
action(n5, "are special terms agreed upon")
action(n7, "disburse funds")
action(n8, "end process")
end(e3)
defines(v1, "application outcome", {"Rejected", "Special Terms Agreed"})
actor(a_default, "Default", [i1, n2, b1, n4, e1, n5, n7, n8, e3])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(n4, e1)
precedence(b1, n5)
precedence(n5, n7)
precedence(n7, n8)
precedence(n8, e3)
guard(b1, n4, v1 = 'Rejected')
guard(b1, n5, v1 = 'Special Terms Agreed')