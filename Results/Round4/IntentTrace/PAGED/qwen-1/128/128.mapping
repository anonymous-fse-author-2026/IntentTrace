{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Process start and initial return action correspond directly to the opening unit."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process.",
        "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Decision prompt, XOR gateway, and merge for return method options."
    },
    {
      "refs": [
        "guard:b1->c_b1_merge"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process.",
        "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Guards capture the two alternative return conditions accurately."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct step match."
    },
    {
      "refs": [
        "action:n4",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process."
      ],
      "justification": "Decision prompt, XOR gateway, positive guard, and convergence for complete orders."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "However, if the \"Order is incomplete and items are missing,\" we still continue the process."
      ],
      "justification": "Guard and email action cover the missing items path and subsequent notification."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Guard and email action cover the missing items path and subsequent notification."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Guard and actions cover damage notification; inventory removal is a reasonable implicit operational step preserving behaviour."
    },
    {
      "refs": [
        "action:n6",
        "guard:b3->c_n9"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process."
      ],
      "justification": "Decision prompt, gateway, guard, and convergence for returning missing items."
    },
    {
      "refs": [
        "guard:b3->c1"
      ],
      "verbatim_texts": [
        "However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Negative guard merging back to the main flow."
    },
    {
      "refs": [
        "action:n9",
        "guard:b4->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process."
      ],
      "justification": "Prompt, gateway, guard, and action for successful repair path."
    },
    {
      "refs": [
        "guard:b4->n11",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Guard and actions cover discard outcome and notification."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order."
      ],
      "justification": "Packing step, decision prompt, gateway, guard, and convergence for existing order packing."
    },
    {
      "refs": [
        "guard:b5->c_n14"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Packing step, decision prompt, gateway, guard, and convergence for existing order packing."
    },
    {
      "refs": [
        "guard:b5->c_n15"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Guard and convergence for future storage option."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges, and the process is complete."
      ],
      "justification": "Final notification, completion marker, and explicit process end."
    }
  ],
