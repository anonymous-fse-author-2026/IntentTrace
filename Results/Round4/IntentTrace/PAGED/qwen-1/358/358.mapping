{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "In the beginning"
      ],
      "justification": "Structural start node and action both correspond to the opening unit that initiates the process."
    },
    {
      "refs": [
        "action:n_cont"
      ],
      "verbatim_texts": [
        "if the answer is \"No\", then we continue the process."
      ],
      "justification": "Direct textual and behavioural correspondence to the first continuation step."
    },
    {
      "refs": [
        "action:n_i3"
      ],
      "verbatim_texts": [
        "If the answer is \"No\" again, we continue the process."
      ],
      "justification": "Direct textual and behavioural correspondence to the repeated continuation step."
    },
    {
      "refs": [
        "action:n_pri1"
      ],
      "verbatim_texts": [
        "However, if the answer is \"Yes\", then we give it priority."
      ],
      "justification": "Direct textual and behavioural correspondence to the priority assignment step."
    },
    {
      "refs": [
        "action:n_lookup"
      ],
      "verbatim_texts": [
        "After that, we look up the Vendor on SAP."
      ],
      "justification": "Direct textual and behavioural correspondence to the vendor lookup step."
    },
    {
      "refs": [
        "guard:b2->n_master",
        "action:n_master"
      ],
      "verbatim_texts": [
        "If the answer is \"No\", then we need a Vendor master record and the process ends."
      ],
      "justification": "The branch and guard split the embedded condition from the action, which is an acceptable re-typing. Combined with the action, it faithfully preserves the decision logic and outcome."
    },
    {
      "refs": [
        "guard:b2->n_inv1",
        "action:n_inv1"
      ],
      "verbatim_texts": [
        "But if the answer is \"Yes\", then we enter the invoice in SAP."
      ],
      "justification": "Guard extracts the positive condition while the action retains the full description. This split preserves the original behaviour and decision boundary."
    },
    {
      "refs": [
        "action:n_inv2"
      ],
      "verbatim_texts": [
        "And if the answer is \"Yes\" again, then we enter the invoice in SAP."
      ],
      "justification": "Direct textual and behavioural correspondence to the secondary positive path."
    },
    {
      "refs": [
        "action:n_out"
      ],
      "verbatim_texts": [
        "Once the invoice is entered in SAP, we place the entered invoices in the normal Outbox and the process ends."
      ],
      "justification": "Captures the final routing action and the process termination points described in the concluding unit."
    }
  ],
