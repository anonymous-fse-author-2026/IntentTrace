  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "Captures the implicit process start and the initial identification step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer"
      ],
      "justification": "Models the XOR split and the elicitation guard. Abstract variable naming preserves the decision logic."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "they should then check the availability of the parts."
      ],
      "justification": "Direct match for the positive arm action following the elicitation condition."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if they already have the availability information, they can proceed with the process.",
        "If the parts are supplied to the customer, the team can also continue with the process."
      ],
      "justification": "Combines the two 'proceed/continue' conditions into a single compound guard. Decision boundaries are preserved."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "If the parts are supplied to the customer, the team can also continue with the process."
      ],
      "justification": "Structural join point where the alternative continuation paths merge back into the main flow."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "However, if they need to record the customer's details",
        "record the customer's details"
      ],
      "justification": "Models the third branch condition. Segmentation noise (i9) was dropped as it adds no behavioural meaning."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "record the customer's details"
      ],
      "justification": "Action corresponding to the record-details branch arm."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "they should order and receive the part from Disuki."
      ],
      "justification": "Follow-up action for the record-details branch, preserving the required workflow."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "Direct match for the contracting step after the branching paths complete."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected,"
      ],
      "justification": "Condition modeled as an action step. Re-typing does not change behaviour, so it is a match."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the team can proceed with the payment."
      ],
      "justification": "Direct match for the payment execution step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "Final termination step. Redundant action node named 'End' alongside the structural end node does not alter behaviour."
    }
