init(i1)
action(n1, "start the process by identifying the vacancy")
action(n2, "Is there a suitable candidate available")
branch(b0, XOR)
action(n3, "advertise the vacancy")
branch(b3, XOR)
action(n6, "advertise the vacancy again")
action(n7, "select the appropriate applicant")
action(n8, "appoint the candidate")
action(n9, "process ends")
end(e1)
converge(c1)
defines(v1, "Is there a suitable candidate available", {false, true})
actor(a_default, "Default", [i1, n1, b0, n2, n3, b3, n6, n7, n8, n9, e1, c1])
precedence(i1, n1)
precedence(n1, b0)
precedence(b0, n2)
precedence(b0, c1)
precedence(n2, n3)
precedence(n3, b3)
precedence(b3, n6)
precedence(b3, c1)
precedence(n6, e1)
precedence(c1, n7)
precedence(n7, n8)
precedence(n8, n9)
precedence(n9, e1)
guard(b0, n2, v1 = false)
guard(b0, c1, v1 = true)
guard(b3, n6, v1 = false)
guard(b3, c1, v1 = true)