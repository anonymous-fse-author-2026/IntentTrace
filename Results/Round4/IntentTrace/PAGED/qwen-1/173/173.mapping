{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Process initiation and the first concrete action."
    },
    {
      "refs": [
        "guard:b0->n2",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available, then advertise the vacancy."
      ],
      "justification": "Models the first decision point's negative arm. The condition is re-typed as an action step (n2), which preserves behaviour, followed by the advertisement action (n3)."
    },
    {
      "refs": [
        "guard:b0->c1"
      ],
      "verbatim_texts": [
        "However, if there is a suitable candidate available, then continue with the process."
      ],
      "justification": "Captures the positive branch guard for the first decision."
    },
    {
      "refs": [
        "guard:b3->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available, then advertise the vacancy again."
      ],
      "justification": "Models the second decision's negative branch and the re-advertisement step."
    },
    {
      "refs": [
        "guard:b3->c1",
        "action:n7"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Captures the second decision's positive branch guard and the subsequent applicant selection action."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed, the process comes to an end."
      ],
      "justification": "Covers the appointment step, explicit termination phrasing, the structural end node, and the convergence point that joins the parallel branches before termination."
    }
  ],
