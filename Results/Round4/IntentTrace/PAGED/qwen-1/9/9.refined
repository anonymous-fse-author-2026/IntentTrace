init(i1)
action(n1, "Bill for Purchased Goods/Services")
action(n2, "Receive Invoice")
branch(b1, XOR)
action(n3, "Return Invoice")
branch(b2, XOR)
action(n4, "Conduct further checks")
branch(b3, XOR)
action(n5, "Resolve non-compliance with phone call")
action(n6, "Return Invoice")
converge(c1)
converge(c2)
branch(b_sync, AND)
action(n7, "Pay Invoice")
branch(b_pay, XOR)
action(n8, "Non-compliance resolved")
action(n9, "Bill Client")
branch(b_resp, XOR)
action(n10, "Wait period of 10 days")
action(n11, "Send reminder after 10 days")
action(n12, "Non-compliance resolved")
action(n13, "Pay Invoice and notify client")
branch(b_sat, XOR)
action(n14, "Resolve payment discrepancy")
action(n15, "Continue process")
converge(c3)
end(e1)
defines(v1, "Invoice incomplete?", {"Yes", "No"})
defines(v2, "Invoice compliant?", {"Yes", "No"})
defines(v3, "Resolution method?", {"Phone", "Mail"})
defines(v4, "Returned after payment?", {"Yes", "No"})
defines(v5, "Client response type?", {"No response", "Returned", "Paid/Notified"})
defines(v6, "Client satisfaction?", {"Unsatisfied", "Satisfied"})
actor(a_default, "Default", [i1, n1, n2, b1, n3, b2, n4, b3, n5, n6, c1, c2, b_sync, n7, b_pay, n8, n9, b_resp, n10, n11, n12, n13, b_sat, n14, n15, c3, e1])
precedence(i1, n1)
precedence(n1, n2)
