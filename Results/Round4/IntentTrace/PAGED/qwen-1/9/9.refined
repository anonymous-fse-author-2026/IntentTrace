precedence(c3, e1)
guard(b1, n3, v1 = 'Yes')
guard(b1, b2, v1 = 'No')
guard(b2, c2, v2 = 'Yes')
guard(b2, n4, v2 = 'No')
guard(b3, n5, v3 = 'Phone')
guard(b3, n6, v3 = 'Mail')
