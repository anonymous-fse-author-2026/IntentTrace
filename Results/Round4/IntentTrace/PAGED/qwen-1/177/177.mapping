      ],
      "verbatim_texts": [
        "To start the process, make sure the Freights are ready to be shipped and then ship the freight."
      ],
      "justification": "Captures the process initiation and the initial freight preparation and shipping actions."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: deliver the freight and notify the delivery."
      ],
      "justification": "Models the concurrent delivery and notification steps along with their convergence point."
    },
    {
      "refs": [
        "guard:b1->b2",
        "guard:b1->b4"
      ],
      "verbatim_texts": [
        "If the request for merchandise return is lodged, continue with the process."
      ],
      "justification": "Represents the return-request condition as the first decision gateway. Abstract guards preserve the split logic."
    },
    {
      "refs": [
        "guard:b2->n8",
        "guard:b2->b3",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it has been 5 days, invoice the customer."
      ],
      "justification": "Models the time-based threshold and the resulting invoicing action. Guard variables correspond to the stated condition."
    },
    {
