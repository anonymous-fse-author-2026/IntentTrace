{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "Start node and first action both correspond to the opening step in i1."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then Check Levels of Inventory."
      ],
      "justification": "Directly matches the second initial step in i2."
    },
    {
      "refs": [
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "Branch gateway and guard for the lower-bound path accurately reflect the condition in i3."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report."
      ],
      "justification": "Action for the below/equal case matches i5."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report."
      ],
      "justification": "Guard and action for the upper-bound path align with i7."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Explicit termination step and end node correspond to i9."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)."
      ],
      "justification": "PO creation step directly matches i8."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Review step matches i12."
    },
    {
      "refs": [
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Decision branch and rejection guard match i10."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Rework action covers i13's requirement to recreate the PO."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Approval guard and corresponding action match i11."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "AND split and the two parallel actions correctly implement the simultaneous tasks in i14."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
