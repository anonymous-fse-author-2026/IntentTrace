      ],
      "verbatim_texts": [
        "To start the process, begin by adding the image description and uploading the image."
      ],
      "justification": "Implicitly starts the process and captures the initial upload action."
    },
    {
      "refs": [
        "guard:b1->i2",
        "action:i2"
      ],
      "verbatim_texts": [
        "If the message indicates a successful upload, the process will end."
      ],
      "justification": "Captures the first decision point and its positive outcome, correctly routing to a successful termination."
    },
    {
      "refs": [
        "guard:b1->i3",
        "action:i3"
      ],
      "verbatim_texts": [
        "if the message indicates an unsuccessful upload, then try again."
      ],
      "justification": "Captures the negative outcome of the first decision, prompting the retry step."
    },
    {
      "refs": [
        "guard:b2->i4",
        "action:i4"
      ],
      "verbatim_texts": [
        "If the option to try again is selected, the process will continue."
      ],
      "justification": "Models the second decision and its positive arm, looping back to continue the process via convergence."
    },
    {
      "refs": [
        "guard:b2->i5",
        "action:i5"
      ],
      "verbatim_texts": [
        "If the option to try again is not selected, then an error will occur and the process will end."
      ],
      "justification": "Models the second decision's negative arm, leading to an error termination."
    }
  ],
