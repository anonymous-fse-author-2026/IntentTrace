      ],
      "verbatim_texts": [
        "If they don't \"Know SLA\", they should \"Look up\"."
      ],
      "justification": "Captures the negative SLA condition and the resulting lookup action. Variable guard preserves the binary decision."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "they should \"continue the process\"."
      ],
      "justification": "Models the positive SLA outcome as process initiation/continuation via the default 'Yes' guard path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, they should enter the date."
      ],
      "justification": "Directly implements the subsequent date entry step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the task is \"Urgent\","
      ],
      "justification": "Opens the second XOR decision point based on task urgency."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "they should \"Red Stamp\"."
      ],
      "justification": "Correctly maps the urgent path guard ('Yes') to the red stamp action."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is \"Non Urgent\", they should \"continue the process\"."
      ],
      "justification": "Captures the non-urgent condition and its continuation outcome. Case differences and variable guards do not change behaviour."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Covers the final termination. Action nodes labeled 'End' alongside formal end nodes are harmless structural restatements."
    }
