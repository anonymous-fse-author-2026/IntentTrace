{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "The opening unit implicitly starts the process and describes receiving the initial request; modeled as an init node and two complementary action steps."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After that, proceed with the Registration gross pathology request."
      ],
      "justification": "Directly corresponds to completing the registration step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the registration is complete, assign a container to the gross pathology request."
      ],
      "justification": "Direct match to assigning the container."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During the \"Registration gross pathology request\" step, make sure to create a barcode scan at the start."
      ],
      "justification": "Captures the explicit requirement to create a barcode scan during registration."
    },
    {
      "refs": [
        "action:n6",
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "For the \"Specimen description\" step, pay attention to the scan start. Then, pay attention to the scan end. Finally, pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "The three scan-related actions faithfully restate the sequential start, end, and continuation scan instructions."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Following that, proceed with Macroscopic description writing."
      ],
      "justification": "Direct paraphrase of writing the macroscopic description."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n17"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Tissue processing, check if \"Digitalization?\" is required."
      ],
      "justification": "Models the simultaneous tissue processing and the initiation of the digitalization check. Splitting tissue processing and modeling the check as an action preceding a branch preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n12",
        "action:n12",
        "guard:b1->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\" continue the process. If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Correctly models the XOR decision gates, both explicit outcomes ('yes' proceeds to digitalization, 'no' skips it), and structurally rejoins the flow."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After that, assign cases to the pathologist and then move on to Microscopic examination and diagnosis."
      ],
      "justification": "Accurately captures case assignment immediately followed by microscopic examination."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the microscopic examination and diagnosis are complete, write the pathology report. After writing the report, confirm it."
      ],
      "justification": "Direct match for writing and subsequently confirming the report."
    },
    {
      "refs": [
        "action:n22",
        "action:n23"
      ],
      "verbatim_texts": [
        "Once the pathology report is confirmed, deliver it. Then, proceed with the post-report processing."
      ],
      "justification": "Captures the delivery step and transition to post-report processing."
    },
    {
      "refs": [
        "action:n24",
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "To conclude the pathology procedure, close it. Finally, deliver the pathology report and complete the post-report processing."
      ],
      "justification": "Final closing steps, the source's redundant restatement of delivery/processing, and process termination are all correctly modeled without altering behaviour."
    }
  ],
