{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For SSP, the process begins by receiving the invoice."
      ],
      "justification": "Covers process initiation and the first action. action:n1 is redundant structural plumbing, which is permitted."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is sorted per client."
      ],
      "justification": "Direct behavioural match."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor."
      ],
      "justification": "Direct behavioural match."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice."
      ],
      "justification": "Direct behavioural match."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form."
      ],
      "justification": "Direct behavioural match."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked."
      ],
      "justification": "Action performs the check and opens the XOR split."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Captures the negative condition and termination. Variable abstraction (v1='Incomplete') preserves decision logic."
    },
    {
      "refs": [
        "guard:b1->n9"
      ],
      "verbatim_texts": [
        "If it is complete"
      ],
      "justification": "Positive condition guard directing flow forward."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the information for the SLA is entered."
      ],
      "justification": "Merged step preserves behaviour alongside the next unit."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "The date for completion is also entered and the priority is checked."
      ],
      "justification": "Continues the merged action and opens the priority XOR decision."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the priority is high, a red stamp is placed on the entry invoice."
      ],
      "justification": "High priority branch and corresponding action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Low priority guard routes to a convergence node, correctly modeling continuation."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked."
      ],
      "justification": "Compliance check action followed by the next decision split."
    },
    {
      "refs": [
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff, the non-compliance invoice is processed."
      ],
      "justification": "Experienced staff condition and processing action."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If it is a normal case, the client is called."
      ],
      "justification": "Normal case condition and calling action."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If none of these conditions apply, a postal mail is sent requesting complete information and the process ends."
      ],
      "justification": "Default/fallback guard, mailing action, and termination node."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Flows converge and execute the final client call/information request."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO, and the process ends."
      ],
      "justification": "Batching/allocation action, explicit end-action restatement, and final end node."
    }
  ],
