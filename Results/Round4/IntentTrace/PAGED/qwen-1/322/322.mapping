      ],
      "verbatim_texts": [
        "To begin the Expense Report process, start by receiving the expense report."
      ],
      "justification": "Captures process initiation and the first reception step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "verify the account and review the report."
      ],
      "justification": "Directly matches the verification and review step."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the report is accepted,"
      ],
      "justification": "Opens the XOR decision point; guard 'Yes' correctly abstracts the acceptance condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed with processing the reimbursement."
      ],
      "justification": "Directly matches the reimbursement processing step."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "However, if the report is rejected,"
      ],
      "justification": "Guard 'No' correctly abstracts the rejection condition."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "send an Expense Rejection Notification and end the process."
      ],
      "justification": "Covers sending the notification and terminating this branch. The explicit 'End' action is structural redundancy that does not alter behaviour."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the reimbursement is processed, proceed with the payment and end the process."
      ],
      "justification": "Covers the payment step and subsequent termination. The explicit 'End' action is structural redundancy that does not alter behaviour."
    }
