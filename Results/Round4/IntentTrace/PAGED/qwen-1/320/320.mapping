      ],
      "verbatim_texts": [
        "For EC-Lille: Initially,"
      ],
      "justification": "Sets the scope and triggers the start of the process."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
      "justification": "First decision gateway and its positive guard."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the option is not selected"
      ],
      "justification": "Negative guard for the first decision."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\""
      ],
      "justification": "Direct mapping of the positive branch action."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Single source step split into two sequential model actions, preserving behaviour."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
