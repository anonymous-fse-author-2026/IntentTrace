        "action:n7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory."
      ],
      "justification": "Decision check modeled as an action node followed by a branch gateway."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If it is not,"
      ],
      "justification": "Guard capturing the unsatisfactory condition."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then perform the action \"Research schedule\""
      ],
      "justification": "Retry action when schedule is unsatisfactory."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If it is,"
      ],
      "justification": "Guard capturing the satisfactory condition."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Next step upon satisfactory schedule."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
