@startuml
!theme plain
|a_default| Default
|a_default|
start
:start;
:Bill for Purchased Goods/Services;
:Receive Invoice;
:Is Invoice Complete?;
:v1: Is Invoice Complete? ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:Return Invoice: Incomplete;
stop
else ([v1 = 'Yes'])
:Process Continues;
:Is Invoice Compliant?;
:v2: Is Invoice Compliant? ({Non-Compliant, Compliant}); <<objectSignal>>
if () then ([v2 = 'Non-Compliant'])
:v4: Resolution Method ({Phone, Mail}); <<objectSignal>>
if () then ([v4 = 'Phone'])
:Resolve Non-Compliance via Phone;
else ([v4 = 'Mail'])
:Return Invoice via Mail;
stop
endif
else ([v2 = 'Compliant'])
->;
endif
:v5: Process Path ({Payment, Billing}); <<objectSignal>>
if () then ([v5 = 'Payment'])
:Pay Invoice;
:Client Notified of Payment;
:v3: Check Client Satisfaction ({Unsatisfied, Satisfied}); <<objectSignal>>
if () then ([v3 = 'Unsatisfied'])
:Resolve Payment Discrepancy;
stop
else ([v3 = 'Satisfied'])
stop
endif
else ([v5 = 'Billing'])
:Bill Client;
:Wait for 10 Days;
:Send Reminder;
stop
endif
endif
@enduml