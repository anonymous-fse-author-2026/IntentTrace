{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with Low Inventory."
      ],
      "justification": "Implicitly initiates the process and captures the first defined state/action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "After that, proceed to Create P.R."
      ],
      "justification": "Direct match for the first P.R. creation step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Then, move on to Create P.R.,"
      ],
      "justification": "Captures the repeated P.R. step explicitly stated in the source text."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "followed by Submit P.O."
      ],
      "justification": "Direct match for the purchase order submission step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the P.O. is submitted, proceed to Ship Material."
      ],
      "justification": "Direct match for the material shipping step and its predecessor condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "At this point, check if the shipment is okay."
      ],
      "justification": "Models the shipment inspection as an action that triggers an XOR decision gateway."
    },
    {
      "refs": [
        "guard:b1->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is, then proceed to Send Payment."
      ],
      "justification": "Correctly abstracts the positive condition to 'Yes' and links it to the payment action."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if there are any problems with the shipment, communicate them accordingly."
      ],
      "justification": "Correctly abstracts the negative condition to 'No' and links it to the communication action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After checking the shipment status again,"
      ],
      "justification": "Models the second verification phase and its associated decision point."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "if it is okay, proceed to Send Payment."
      ],
      "justification": "Maps the second positive outcome to the corresponding payment action."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "Otherwise, communicate any shipment problems."
      ],
      "justification": "Maps the second negative outcome to the corresponding communication action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "In case there were any shipment problems, make sure to communicate them before proceeding to Ship Material."
      ],
      "justification": "Direct match for the conditional pre-shipment communication requirement."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, once the payment is sent, the process comes to an end."
      ],
      "justification": "Captures the terminal action, process end node, and necessary structural convergence points for the parallel/repeated branches."
    }
  ],
