{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process, start by receiving the order."
      ],
      "justification": "Captures the explicit start trigger and the initial reception step."
    },
    {
      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: check the order and check the customer."
      ],
      "justification": "Directly maps the two parallel validation steps described in the source."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the order is okay, then continue with the process."
      ],
      "justification": "The XOR branch and its guards abstractly encode the combined order/customer decision logic. The refusal actions correctly reflect the negative outcomes. Behavioral equivalence is preserved."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the customer is not permitted, send a refusal."
      ],
      "justification": "The XOR branch and its guards abstractly encode the combined order/customer decision logic. The refusal actions correctly reflect the negative outcomes. Behavioral equivalence is preserved."
    },
    {
      "refs": [
        "guard:b1->n10"
      ],
      "verbatim_texts": [
        "However, if the customer is permitted, continue with the process."
      ],
      "justification": "The XOR branch and its guards abstractly encode the combined order/customer decision logic. The refusal actions correctly reflect the negative outcomes. Behavioral equivalence is preserved."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "In this case, send a refusal and end the process."
      ],
      "justification": "The XOR branch and its guards abstractly encode the combined order/customer decision logic. The refusal actions correctly reflect the negative outcomes. Behavioral equivalence is preserved."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the order is not okay, send a refusal and end the process."
      ],
      "justification": "The XOR branch and its guards abstractly encode the combined order/customer decision logic. The refusal actions correctly reflect the negative outcomes. Behavioral equivalence is preserved."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "In this case, send a refusal and end the process."
      ],
      "justification": "Action and structural end nodes capturing the termination paths for failed validations."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the order is not okay, send a refusal and end the process."
      ],
      "justification": "Action and structural end nodes capturing the termination paths for failed validations."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "Release the order and then transfer the data in the database."
      ],
      "justification": "Direct sequential mapping of the release and database transfer steps."
    },
    {
      "refs": [
        "action:n12",
        "guard:b3->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the data is transferred, check the worth of the order. If it is greater than 10.000 \u20ac, sign off on the order."
      ],
      "justification": "Models the threshold check and positive outcome. Abstract guard variable preserves the decision boundary."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "Otherwise, continue with the process. Sign off on the order and forward it to production."
      ],
      "justification": "Captures the negative threshold branch and the subsequent signing/forwarding steps."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: check the product quality, start production, and produce the product."
      ],
      "justification": "Direct mapping of the three parallel production-initiation steps."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Also, create a material report. Check the product quality and create the material report."
      ],
      "justification": "Maps the material report creation step. Redundant phrasing in source does not change behavior."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once the report is created, send it to the warehouse."
      ],
      "justification": "Direct match for routing the material report."
    },
    {
      "refs": [
        "action:n22",
        "action:n23",
        "action:n24"
      ],
      "verbatim_texts": [
        "At the same time, create a quality report, send the product to shipment, and send the order to accounting."
      ],
      "justification": "Maps the three concurrent post-production distribution steps."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "Once the report is created, send it to Finance."
      ],
      "justification": "Direct match for Finance reporting."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Ship the product and send the invoice."
      ],
      "justification": "Direct match for shipping and invoicing."
    },
    {
      "refs": [
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "After sending the report, archive it. Archive the report and end the process."
      ],
      "justification": "Maps archiving and the corresponding process termination."
    },
    {
      "refs": [
        "action:n29",
        "action:n30",
        "guard:b4->n31",
        "action:n31"
      ],
      "verbatim_texts": [
        "Check the payment. If the payment is received, close the order."
      ],
      "justification": "Payment check and positive outcome mapped correctly. Condition modeled as an action step (n30) preserves behavior per guidelines."
    },
    {
      "refs": [
        "guard:b4->n32",
        "action:n32"
      ],
      "verbatim_texts": [
        "If the payment is not received, check if a reminder has been sent more than three times."
      ],
      "justification": "Negative payment branch leading to the reminder-frequency check. Modeled as an action node, which is behavior-preserving."
    },
    {
      "refs": [
        "guard:b5->n33"
      ],
      "verbatim_texts": [
        "If a reminder has been sent more than three times, acquire a lawyer.",
        "Acquire a lawyer and complete the court proceedings."
      ],
      "justification": "Correctly routes the high-reminder count path to legal escalation and court proceedings."
    },
    {
      "refs": [
        "action:n33"
      ],
      "verbatim_texts": [
        "If a reminder has been sent more than three times, acquire a lawyer.",
        "Acquire a lawyer and complete the court proceedings."
      ],
      "justification": "Correctly routes the high-reminder count path to legal escalation and court proceedings."
    },
