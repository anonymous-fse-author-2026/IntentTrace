{
  "matches": [
    {
      "refs": [
        "action:n1",
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected, then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Initializes the process and models the first XOR decision. The positive guard (v1=true) correctly routes to the 'Research schedule' action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Negative guard (v1=false) correctly routes to providing indications and then proceeding with the research schedule."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Validates the schedule and performs a satisfaction check. Modeling the check as an action before the split preserves the intended behaviour."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Guard v2=false correctly captures the 'not satisfactory' condition and triggers the research schedule action."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Guard v2=true correctly captures the satisfactory condition and proceeds to write the ticket order."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\". If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Re-evaluates schedule status. The model skips the redundant second 'Research schedule' mention in the source but correctly models the subsequent failure path leading to 'provide indications' via v3=false."
    },
    {
      "refs": [
        "guard:b3->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Guard v3=true correctly handles the alternative satisfactory path to writing the ticket order."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Direct match for validating the ticket order."
    },
    {
      "refs": [
        "action:n14",
        "guard:b4->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved. If it is not, then the process ends."
      ],
      "justification": "Checks approval status. Negative guard (v4=false) correctly terminates the process. Condition modeled as action preserves behaviour."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Positive guard (v4=true) correctly routes to re-validating the ticket order."
    },
    {
      "refs": [
        "action:n17",
        "guard:b5->n18",
        "action:n18",
        "guard:b5->e2"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved. If it is not, then the process ends."
      ],
      "justification": "Performs final approval check. Negative guard (v5=false) ends process, while positive guard (v5=true) also reaches an end state, fully capturing the source's termination logic."
    }
  ],
