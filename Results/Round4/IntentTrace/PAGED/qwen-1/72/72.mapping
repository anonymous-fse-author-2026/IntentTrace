      ],
      "verbatim_texts": [
        "Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Structural start and initial actions align with the opening billing and invoice receipt step. n1 is a redundant fragment of the announcer phrase and does not change behaviour."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Captures the condition for incomplete invoices, the return action, and the termination of this path. n5 is a harmless redundant restatement."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if the invoice is complete",
        "If the invoice is non-compliant"
      ],
      "justification": "Models the continuation for complete invoices and immediately branches to compliance checks. Re-typing conditions as guards/actions preserves the intended flow."
    },
    {
      "refs": [
        "guard:n6->n7"
      ],
      "verbatim_texts": [
