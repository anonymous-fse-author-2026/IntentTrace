{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am"
      ],
      "justification": "Initiates the process and captures the opening action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then empty the mailbox."
      ],
      "justification": "Directly models the first sequential action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty,"
      ],
      "justification": "Executes the initial check and opens the XOR decision gateway."
    },
    {
      "refs": [
        "guard:b1->e1"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Positive guard leading directly to the first termination point."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if not, continue the process."
      ],
      "justification": "Negative guard directing flow to the subsequent check."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again, if not, continue the process. If it is empty, the process ends."
      ],
      "justification": "Models the repeated check and provides the alternative termination path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Performs the completeness verification and splits the flow."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is complete, add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Guard and action for the complete-data path."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If it is not complete, make a telephone call to the sender."
      ],
      "justification": "Guard and action for the incomplete-data path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Handles post-call data recording and rejoins the parallel paths."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Direct match for the scheduled weekly transfer action."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member,"
      ],
      "justification": "Evaluates membership outcome and prepares the decision split."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member,"
      ],
      "justification": "Positive guard for successful membership application."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member, write to them and inform them of the decision."
      ],
      "justification": "Negative guard and corresponding rejection notification action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Action performed on accepted applications."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Follow-up data entry step after stamping."
    },
    {
      "refs": [
        "branch:b_xor_next"
      ],
      "verbatim_texts": [
        "calculate the fee",
        "hand the letter to Charles."
      ],
      "justification": "Splits flow into concurrent tasks using an AND gateway, preserving the 'simultaneously' requirement."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "calculate the fee"
      ],
      "justification": "First parallel task."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "hand the letter to Charles."
      ],
      "justification": "Second parallel task."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Rejoins concurrent paths and proceeds to the register update instruction."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Final processing step for successful applicants."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "The process ends."
      ],
      "justification": "Explicit terminal statement mapping to the process conclusion."
    }
  ],
