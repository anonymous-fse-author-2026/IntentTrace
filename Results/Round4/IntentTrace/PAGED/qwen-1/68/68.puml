@startuml
!theme plain
|a_default| Default
|a_default|
start
:Rental Items are Returned to the Store;
:v1: Items returned by customer or picked up by delivery crew ({Customer returns items, Delivery crew picks up items}); <<objectSignal>>
if () then ([v1 = 'Customer returns items'] [v1 = 'Delivery crew picks up items'])
:Count and compare items to contract;
:Check order status against original contract;
:v2: Order status after count ({All items returned, Items missing, Items damaged}); <<objectSignal>>
switch ()
case ([v2 = 'Items missing'])
:Email customer missing items and replacement charges;
:Check if customer returns missing items;
case ([v2 = 'All items returned'])
:Items disposition for returned items;
case ([v2 = 'Items damaged'])
endswitch
:Email customer damage and additional charges;
:Temporarily remove damaged items from inventory;
:Check if damaged items can be repaired;
:v5: Can damaged items be repaired ({Can be repaired, Cannot be repaired}); <<objectSignal>>
if () then ([v5 = 'Can be repaired'])
:Repair items and add to inventory;
else ([v5 = 'Cannot be repaired'])
->;
endif
:Items disposition after repair;
:v6: Items disposition after repair ({Packed for existing order, Stored for future orders}); <<objectSignal>>
if () then ([v6 = 'Packed for existing order'] [v6 = 'Stored for future orders'])
:Email customer replacement charges and end process;
stop
endif
endif
