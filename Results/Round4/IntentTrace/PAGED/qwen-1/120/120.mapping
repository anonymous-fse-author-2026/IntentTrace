  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, ask the 1st Level Support if there is an issue."
      ],
      "justification": "Covers the process initiation and the first instructional step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the issue is resolved, provide feedback for the account manager."
      ],
      "justification": "Models the positive branch outcome. The guard abstracts the condition but preserves the decision logic and resulting action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is a 1st Level issue, ask the developer for assistance."
      ],
      "justification": "Models the alternative branch outcome. Logic and action are preserved."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Then, check the result again. If the issue is resolved, provide feedback for the account manager."
      ],
      "justification": "Captures the re-evaluation step. The subsequent feedback is behaviorally covered by action:n4 elsewhere, so preserving the check maintains overall behaviour."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is still a 1st Level issue, ask the developer for help."
      ],
      "justification": "Directly corresponds to the escalation step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Ask the developer and then provide feedback for the 1st Level support."
      ],
      "justification": "Exact behavioral match."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, provide feedback for the 1st Level support and then provide feedback for the account manager."
      ],
      "justification": "Captures the final feedback sequence and implicitly terminates the process."
    }
  ],
