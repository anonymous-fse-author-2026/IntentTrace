      "justification": "Exact correspondence to the submission action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Next, check if the option to submit is set to \"false\"."
      ],
      "justification": "The conditional check is modeled as an action step that immediately opens an XOR branch. Re-typing preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "set to \"false\". If it is, then apply another filter."
      ],
      "justification": "Guard correctly captures the 'false' threshold from the source decision."
    },
    {
      "refs": [
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the option to submit is set to \"true\", then continue with the process."
      ],
      "justification": "Guard correctly captures the 'true' threshold from the source decision."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "set to \"false\". If it is, then apply another filter."
      ],
      "justification": "Matches the action required when the condition evaluates to false."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the option to submit is set to \"true\", then continue with the process."
      ],
      "justification": "Matches the positive branch outcome. Content is a loose paraphrase of continuing the process, which preserves behaviour."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "The process ends when all steps have been completed."
      ],
      "justification": "Explicitly models the stated termination condition."
    }
