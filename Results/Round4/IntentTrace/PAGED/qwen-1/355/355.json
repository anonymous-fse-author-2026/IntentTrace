  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start by checking the customer's order."
    },
    {
      "id": "i2",
      "content": "If the customer is a registered customer, then check their payment morale."
    },
    {
      "id": "i3",
      "content": "If they are a new customer, then check their status."
    },
    {
      "id": "i4",
      "content": "If their payment morale is good, continue with the process."
    },
    {
      "id": "i5",
      "content": "If their payment morale is bad or if they are an end customer, reject the order and end the process."
    },
    {
      "id": "i6",
      "content": "If the customer is a wholesaler,"
    },
    {
      "id": "i7",
      "content": "enter their data and take the order."
    },
    {
      "id": "i9",
      "content": "check the availability of the items."
    },
    {
      "id": "i10",
      "content": "If the items are out of stock, start production."
    },
    {
      "id": "i11",
      "content": "If they are in stock, continue with the process."
    },
    {
      "id": "i12",
      "content": "Once the availability is checked, send the order confirmation."
    },
    {
      "id": "i13",
      "content": "produce the article and send the order confirmation."
    },
    {
      "id": "i15",
      "content": "send the invoice and deliver the product."
    },
    {
      "id": "i16",
      "content": "Check the payment status."
    },
    {
      "id": "i17",
      "content": "If payment is received, close the order."
    },
    {
      "id": "i18",
      "content": "If no payment is received, check the number of reminders."
    },
    {
      "id": "i19",
      "content": "If there are more than three reminders, engage a lawyer."
    },
    {
      "id": "i20",
      "content": "If there are three or fewer reminders, send a reminder."
    }
  ]
