{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "Directly splits the opening instruction into the process start and its sequential preparatory actions. Behaviour fully preserved."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5",
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum, generate an Equal to or below minimum Report. If the inventory is greater than the minimum, generate an Above Minimum Report."
      ],
      "justification": "Captures the XOR decision, both conditional branches, and the corresponding report generation steps. The 'Above Minimum' branch correctly terminates the process (end:e2). Guard values abstract the textual conditions without altering the decision logic."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum"
      ],
      "justification": "The condition triggers PO creation. Modeled as a convergence point feeding the creation action, preserving the causal flow."
    },
    {
      "refs": [
        "action:n17",
        "guard:b3->n11",
        "action:n11",
        "guard:b3->n13",
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed. If the PO is rejected, it needs to be reworked. If the PO is approved, it is printed and released in the system. If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Covers the mandatory review step, the approval/rejection decision, the resulting parallel outcomes, and the rework recursion. Faithful paraphrase preserving all branching behaviour."
    },
    {
      "refs": [
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "Correctly models the explicit simultaneous execution using an AND gateway with two concurrent actions."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Condition modeled as direct sequential flow from the fund reservation step. Behaviour preserved."
    },
    {
      "refs": [
        "action:n36"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Condition modeled as direct sequential flow from the mailing step. Matches source."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Direct flow from packing slip reception to invoice reception. Matches source."
    },
    {
      "refs": [
        "action:n39"
      ],
      "verbatim_texts": [
        "If the inventory is received, proceed to receive the Packing Slip."
      ],
      "justification": "Captures the source-specified ordering/redundancy. Modelling choice preserves the stated flow."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match."
      ],
      "justification": "Converges the parallel supply/funding paths before proceeding to the match step. Structural plumbing preserves intended flow."
    },
    {
      "refs": [
        "action:n43",
        "action:n44",
        "action:n45"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds. Once the funds are released, issue the payment. After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Sequential steps exactly follow the source description, culminating in the final process end node. All conditions and terminal state preserved."
    }
  ],
