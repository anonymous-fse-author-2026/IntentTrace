      ],
      "verbatim_texts": [
        "To begin with, the first step is Course registration."
      ],
      "justification": "Captures the process initiation and the first explicit step. 'start' is benign structural plumbing."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If an exception is needed, then a Request for the exception should be made."
      ],
      "justification": "Models the positive exception branch correctly. Decision is re-typed as an action step plus gateway, which preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "if an exception is not needed"
      ],
      "justification": "Models the negative branch condition and flow convergence for skipping the exception request."
    },
    {
      "refs": [
        "action:n5",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After the exception is approved, the next step is course enrollment, followed by seminar group enrollment."
      ],
      "justification": "Directly captures the approval checkpoint and the two sequential enrollment steps."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the homework assignment can be started"
      ],
      "justification": "Direct correspondence to starting the homework."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "working on the homework"
      ],
      "justification": "Direct correspondence to performing the homework work."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "it should be turned in"
      ],
      "justification": "Direct correspondence to submitting the homework."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The homework will then be evaluated"
      ],
      "justification": "Direct correspondence to the evaluation step."
    },
    {
      "refs": [
        "action:n11",
        "guard:b2->n12",
        "action:n12"
      ],
      "verbatim_texts": [
        "If it was not the last homework, another homework assignment will be given."
      ],
      "justification": "Models the homework loop continuation condition and action correctly."
    },
    {
      "refs": [
        "guard:b2->n13",
        "action:n13"
      ],
      "verbatim_texts": [
        "if it was the last homework, the process can continue."
      ],
      "justification": "Models the homework loop exit condition correctly."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "At the same time, two additional steps should be completed: granting accreditation and announcing the date of the exam."
      ],
      "justification": "Captures the parallel execution of two administrative steps and their subsequent rejoin."
    },
    {
      "refs": [
        "action:n16",
        "action:n17"
      ],
      "verbatim_texts": [
        "After signing up for the exam, it should be attended."
      ],
      "justification": "Sequential steps for exam registration and attendance."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "it will be evaluated"
      ],
      "justification": "Direct correspondence to the exam evaluation step."
    },
    {
      "refs": [
        "action:n19",
        "guard:b3->n20",
        "action:n20"
      ],
      "verbatim_texts": [
        "If the exam is passed, the course is considered passed"
      ],
      "justification": "Models the exam pass outcome correctly."
    },
    {
      "refs": [
        "guard:b3->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "if the exam is failed, another sign-up for the exam is required."
      ],
      "justification": "Models the exam failure outcome, retry loop, and process termination/convergence. Structural nodes are implied by the flow."
    }
