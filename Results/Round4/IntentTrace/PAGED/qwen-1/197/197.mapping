      "refs": [
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process, the customer needs to gather the required items and then inquire about the availability of products."
      ],
      "justification": "Captures the process initiation, item gathering, and initial product availability inquiry described in the opening unit."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "After sending the inquiry, they should wait for the invoice."
      ],
      "justification": "Directly covers sending the inquiry and the subsequent waiting step."
    },
    {
      "refs": [
        "action:n6",
        "guard:b1->c_wait_inv",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "Once the invoice is received"
      ],
      "justification": "Models the temporal condition 'once received' as a polling/check structure with a decision gateway and guards. Re-typing a wait condition as a branch preserves behaviour."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "the customer should review the pricing and terms of the items and then send a purchase requisition"
      ],
      "justification": "Splits the compound instruction into two sequential action steps, preserving the original order and meaning."
    },
    {
      "refs": [
        "action:n9",
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "they need to wait for the purchase invoice and shipment"
      ],
      "justification": "Decomposes the single wait requirement into separate wait-and-check steps for the invoice and the shipment. Behaviour is fully preserved."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Once the purchase invoice and shipment are received, the customer can proceed to receive the invoice."
      ],
      "justification": "Directly captures the action of receiving the invoice after prerequisites are satisfied."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Upon receiving the invoice, they should make the payment."
      ],
      "justification": "Exact behavioural match for the payment step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Once the payment is made, the transaction is complete and the process ends."
      ],
      "justification": "Captures the completion state and maps to the explicit process termination node."
    }
  ],
