    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "For buyers, the process begins by choosing a book."
      ],
      "justification": "Captures the process initiation, buyer context, and the initial book selection step."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n5",
        "guard:b1->n6",
        "action:n4",
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "After selecting a book, they can either view the book details or see a list of new copies. Alternatively, they can also view a list of used copies."
      ],
      "justification": "Models the post-selection decision point and correctly splits into the three described options using guards and corresponding action nodes."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
        "guard:b2->n9",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If they choose to view the book details, they have the option to then view a list of new copies or proceed to select a copy and end the process."
      ],
      "justification": "Accurately represents the secondary branching after viewing details, covering both the 'view new copies' and 'select copy/end' paths."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "On the other hand, if they choose to view a list of used copies, they can evaluate the list and then select their preferred copy to complete the process."
      ],
      "justification": "Maps the evaluation action, the copy selection action, and the convergence/end points for the used-copies workflow."
    }
  ],
