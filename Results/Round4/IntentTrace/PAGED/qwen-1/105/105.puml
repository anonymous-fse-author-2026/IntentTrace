@startuml
!theme plain
|a_default| Default
|a_default|
start
:make an appointment at the hairdresser's;
:go to the hairdresser's;
:v1: hair service ({Wash, Dye, Cut}); <<objectSignal>>
switch ()
case ([v1 = "Wash"])
:wash hair;
case ([v1 = "Dye"])
:dye hair;
case ([v1 = "Cut"])
:cut hair;
endswitch
:pay the hairdresser;
stop
@enduml