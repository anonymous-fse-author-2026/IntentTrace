{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For MyCorp, the process begins by entering expenses."
      ],
      "justification": "Marks the process start and defines the initial action of entering expenses."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After entering expenses, the next step is to generate a spreadsheet."
      ],
      "justification": "Directly captures the spreadsheet generation step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the spreadsheet is generated, the request can be approved or disapproved."
      ],
      "justification": "Models the first approval evaluation as an action step and opens the corresponding XOR decision gateway. Re-typing a condition as an action preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n2"
      ],
      "verbatim_texts": [
        "If the request is not approved, the process goes back to entering expenses."
      ],
      "justification": "Correctly captures the negative branch condition and routes back to the enter expenses step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the request is approved, the expenses can be paid out."
      ],
      "justification": "Captures the positive branch condition and the subsequent payout action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "The process then checks again if the request is approved or not."
      ],
      "justification": "Models the second approval evaluation and opens the second XOR gateway, preserving the sequential flow described."
    },
    {
      "refs": [
        "guard:b2->n2"
      ],
      "verbatim_texts": [
        "If it is not approved, the process goes back to entering expenses."
      ],
      "justification": "Captures the second negative branch condition looping back to the start."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "But if it is approved, the expenses can be paid out."
      ],
      "justification": "Captures the second positive branch condition and payout action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Finally, after the expenses are paid out, the process comes to an end."
      ],
      "justification": "Represents the final concluding step and the process termination node."
    }
  ],
