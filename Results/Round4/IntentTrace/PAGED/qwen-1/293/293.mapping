{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For TS recruitment, the first step is to advise unsuccessful candidates."
      ],
      "justification": "Implicitly starts the process and performs the first advisory step."
    },
    {
      "refs": [
        "guard:b1->n2",
        "action:n2"
      ],
      "verbatim_texts": [
        "If there are \"no more candidates\", then the position should be re-advertised."
      ],
      "justification": "Structural split and its positive arm handling the 'no more candidates' condition and re-advertising action."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "However, if the terms and conditions of the offer for a candidate need to be sorted out,"
      ],
      "justification": "Alternative branch condition for sorting terms and conditions."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "it is necessary to check if the candidate has accepted a voluntary redundancy."
      ],
      "justification": "Directly models the mandatory redundancy acceptance check."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the candidate has not accepted, the process continues."
      ],
      "justification": "Second decision point negative arm preserving continuation behaviour."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if the candidate has accepted, further investigation is required."
      ],
      "justification": "Second decision point positive arm triggering investigation."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "If the candidate has not accepted, the process continues.",
        "On the other hand, if the candidate has accepted, further investigation is required."
      ],
      "justification": "Structural join bringing both voluntary redundancy outcomes back together."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "The recruitment manager sends an Appointment Approval form, which is then received by the next level manager."
      ],
      "justification": "Models sending and receiving the approval form."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the manager is an external resource, they may not authorize the form. However, if the approver is an existing employee of the client, the process continues."
      ],
      "justification": "Captures the approver status verification logic."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the form is approved, the recruitment manager sends the form and other documentation, which is received by the client HR."
      ],
      "justification": "Handles post-approval routing and documentation transfer."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The HR department scans the completed form and records the position against the stored position in GovSource."
      ],
      "justification": "Direct match for HR scanning and system recording."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If there are any variations, a complete business case is required. Otherwise, the process continues."
      ],
      "justification": "Preserves variation checking logic and branching behaviour."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The Appointment Approval is carried forward."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the position requires a medical assessment, it is applicable for a 12% rate. Otherwise, a medical assessment is not necessary."
      ],
      "justification": "Models the medical assessment necessity decision."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "For the step of the Preferred Candidate's medical assessments, it is important to note that it can take up to 21 days to arrange and complete."
      ],
      "justification": "Represents the arrangement step described in the note."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "The TS HR coordinator informs the recruitment manager, who then liaises with the HR representative to confirm the offer to the candidate."
      ],
      "justification": "Splits the compound sentence into two sequential coordination actions without changing behaviour."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "If the assessment is not satisfactory, the next candidate on the shortlist should be contacted. However, if the assessment is fine, the process continues."
      ],
      "justification": "Evaluates the assessment outcome as described."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "The recruitment manager makes a formal verbal offer of employment to the candidate."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the candidate accepts, the recruitment manager creates a formal written offer. If the candidate declines, the process continues."
      ],
      "justification": "Checks candidate response to the verbal offer."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Simultaneously, the commencement pack and letter of appointment are sent to the candidate."
      ],
      "justification": "Direct match for document dispatch."
    },
    {
      "refs": [
        "action:n21",
        "guard:b3->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "Once the candidate receives these documents, if there is a \"40%\" rate, renegotiation is required."
      ],
      "justification": "Checks the 40% rate condition and directs flow to renegotiation when applicable."
    },
    {
      "refs": [
        "guard:b3->n25",
        "action:n25"
      ],
      "verbatim_texts": [
        "Otherwise, if the candidate accepts, the process continues."
      ],
      "justification": "Alternative path when the 40% rate condition is false."
    },
    {
      "refs": [
        "guard:b4->n23",
        "action:n23",
        "guard:b4->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "If the renegotiation is successful, the process continues. However, if the renegotiation is unsuccessful, the next candidate on the shortlist should be identified."
      ],
      "justification": "Captures both success and failure outcomes of the renegotiation step."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Joins diverging paths, executes the final statement, and terminates the process."
    }
  ],
