@startuml
!theme plain
|a1| Default
|a1|
start
:advise unsuccessful candidates;
:v1: no more candidates? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:no more candidates - re-advertise position;
else ([v1 = 'No'])
:terms and conditions need sorting;
:check voluntary redundancy acceptance;
:v2: voluntary redundancy accepted? ({Yes, No}); <<objectSignal>>
if () then ([v2 = 'No'])
:not accepted - process continues;
else ([v2 = 'Yes'])
:accepted - further investigation required;
endif
:send Appointment Approval form;
:receive form & approver check;
:form approved & send docs to HR;
:HR scans & records position;
:variations check;
:carry forward Appointment Approval;
:medical assessment requirement check;
:arrange medical assessment;
:TS HR coordinator informs manager;
:liaise to confirm offer;
:assessment satisfactory check;
:make formal verbal offer;
:candidate response check;
:send commencement pack;
:rate is 40 percent check;
:v3: rate is 40 percent? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:renegotiation required;
:v4: renegotiation successful? ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:renegotiation successful - process continues;
else ([v4 = 'No'])
:renegotiation unsuccessful - identify next candidate;
endif
else ([v3 = 'No'])
:candidate accepts - process continues;
endif
endif
:finally process ends;
stop
@enduml