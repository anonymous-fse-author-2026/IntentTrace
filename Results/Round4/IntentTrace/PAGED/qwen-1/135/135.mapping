        "action:n7"
      ],
      "verbatim_texts": [
        "Once the P.O. is submitted, proceed to Ship Material."
      ],
      "justification": "Captures the shipping step following submission."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "At this point, check if the shipment is okay."
      ],
      "justification": "Models the condition check as an action step and opens the XOR branch. Re-typing preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9",
        "action:n17"
      ],
      "verbatim_texts": [
        "If it is, then proceed to Send Payment."
      ],
      "justification": "Guard captures the positive condition; actions redundantly restate the payment step. All behaviour-preserving."
    },
    {
      "refs": [
        "action:n18",
        "action:n16"
      ],
      "verbatim_texts": [
