    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start with Password Verification, followed by Verifiy Password."
      ],
      "justification": "Implicitly starts the process and captures the two initial verification actions. Minor spelling correction in the model preserves behaviour."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n4",
        "guard:b1->n5",
        "guard:b1->n6",
        "action:n4",
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "If you choose \"Select Cancel\", you will be directed to iforgot.apple.com. However, if you select \"Reset password\", you will be automatically directed to iforgot.apple.com. In case you choose \"Retry\", you will need to re-enter your password."
      ],
      "justification": "Models the three-way decision and its exact navigation/outcome paths. 'Check selection' and the converge node are structural equivalents that preserve the branching logic and flow."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "then verify it"
      ],
      "justification": "Directly matches the verification step that follows re-entering the password."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After that, go to iforgot.apple.com and proceed with Reset Password."
      ],
      "justification": "Captures the core reset action. The preceding navigation step is already covered by the earlier branch outcomes."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the password is reset, you can return to the iTunes purchases page."
      ],
      "justification": "Direct paraphrase of returning to the purchases page post-reset."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "select the price of the item."
      ],
      "justification": "Exact behavioural match for the pricing selection step."
    },
    {
      "refs": [
        "action:n11",
        "guard:b2->n12",
        "guard:b2->n13",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If prompted to \"Enter Password\", verify the password. Alternatively, if asked to \"Enter Apple ID\", enter the password."
      ],
      "justification": "Correctly models the prompt-type decision with both conditional guards and corresponding response actions. Converge node structurally rejoins the flow without changing behaviour."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, enter the password and verify it."
      ],
      "justification": "Final verification step and process termination point align exactly with the closing instruction."
    }
  ],
