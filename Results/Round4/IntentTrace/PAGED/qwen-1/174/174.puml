@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start Process;
:Bill for Purchased Goods/Services;
:Receive Invoice;
:Invoice Complete?;
:v1: Invoice Complete? ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:Return Invoice;
stop
else ([v1 = 'Yes'])
:Invoice Compliant?;
:v2: Invoice Compliant? ({No, Yes}); <<objectSignal>>
if () then ([v2 = 'No'])
:Conduct Further Checks;
:Issue Can Be Resolved With Phone Call?;
:v3: Issue Can Be Resolved With Phone Call? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:Resolve Non-Compliance;
else ([v3 = 'No'])
:Return Invoice;
endif
else ([v2 = 'Yes'])
->;
endif
:Pay Invoice;
:v4: Client Satisfied? ({No, Yes}); <<objectSignal>>
if () then ([v4 = 'No'])
:Resolve Payment Discrepancy;
else ([v4 = 'Yes'])
:Process Continues;
endif
stop
endif
@enduml