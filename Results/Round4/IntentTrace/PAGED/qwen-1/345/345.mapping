      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then proceed to Check Levels of Inventory."
      ],
      "justification": "Covers process initiation and the first two sequential steps."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the inventory is \"greater than\" the minimum, generate an \"Above Minimum Report\".",
        "If it is \"below or equal to\" the minimum, generate an \"Equal to or below minimum Report\"."
      ],
      "justification": "Structural XOR gateway corresponding to the two inventory evaluation paths."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the inventory is \"greater than\" the minimum, generate an \"Above Minimum Report\"."
      ],
      "justification": "Correctly captures the 'greater than' condition threshold."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If it is \"below or equal to\" the minimum, generate an \"Equal to or below minimum Report\"."
      ],
      "justification": "Correctly captures the 'below or equal to' condition threshold."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the inventory is \"greater than\" the minimum, generate an \"Above Minimum Report\"."
      ],
      "justification": "Paraphrases the report generation for the high-inventory path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If it is \"below or equal to\" the minimum, generate an \"Equal to or below minimum Report\"."
      ],
      "justification": "Paraphrases the report generation for the low/equal inventory path."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the process ends with the End Resupply Cycle."
      ],
      "justification": "Represents the termination path when inventory is above minimum."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "POs are Created."
      ],
      "justification": "Direct match for purchase order creation."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "they are subject to POs Review."
      ],
      "justification": "Direct match for the PO review step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the POs are \"rejected\", they need to be \"reworked\".",
        "If they are \"approved\", they are \"Printed and released in the system\" and the process ends."
      ],
      "justification": "Structural XOR gateway corresponding to the approval/rejection decision."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If the POs are \"rejected\", they need to be \"reworked\"."
      ],
      "justification": "Correctly captures the rejection condition."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If they are \"approved\", they are \"Printed and released in the system\" and the process ends."
      ],
      "justification": "Correctly captures the approval condition."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If the POs are \"rejected\", they need to be \"reworked\"."
      ],
      "justification": "Matches the rework requirement for rejected POs."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "If they are \"approved\", they are \"Printed and released in the system\" and the process ends."
      ],
      "justification": "Covers printing, releasing, and final termination for approved POs."
    },
