{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, it is important to check the Referee Reports."
      ],
      "justification": "Implicit process start and the initial checking action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "continue to monitor if the Referee Reports have been completed"
      ],
      "justification": "Monitoring step modeled as an action node."
    },
    {
      "refs": [
        "guard:b1->c3"
      ],
      "verbatim_texts": [
        "If they have been completed"
      ],
      "justification": "First decision point and its positive completion guard."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if they have not been completed"
      ],
      "justification": "Negative guard for the first completion check."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "you should flag it and send a reminder"
      ],
      "justification": "Action triggered by the negative guard."
    },
    {
      "refs": [
        "action:n5",
        "action:n6"
      ],
      "verbatim_texts": [
        "After that, you should check again if the Referee Reports have been completed."
      ],
      "justification": "Re-check step split into two equivalent action nodes; preserves behaviour."
    },
    {
      "refs": [
        "guard:b2->n_flag2"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Second decision point and its negative guard."
    },
    {
      "refs": [
        "action:n_flag2"
      ],
      "verbatim_texts": [
        "you should flag it again and send another reminder"
      ],
      "justification": "Follow-up reminder action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "If they have"
      ],
      "justification": "Positive re-check guard leading to flow convergence points."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the Referee Reports have been completed, you can move on to organizing interviews for the Selection Panel with the top candidates."
      ],
      "justification": "Interview organization step following report completion."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the interviews, it is necessary to receive feedback from the interview candidates."
      ],
      "justification": "Direct mapping to feedback collection action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Next, you need to check if a Psychometric Test is required."
      ],
      "justification": "Check action that opens the psychometric test decision branch."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If it is"
      ],
      "justification": "Positive guard indicating the test is required."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "you should then check if an HR Specialist is required"
      ],
      "justification": "Nested check action and its corresponding branch node."
    },
    {
      "refs": [
        "guard:b4->n11"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required"
      ],
      "justification": "Positive guard for the HR specialist requirement."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "you should schedule the test with a third party"
      ],
      "justification": "Scheduling action for third-party administration."
    },
    {
      "refs": [
        "guard:b4->n12"
      ],
      "verbatim_texts": [
        "Otherwise"
      ],
      "justification": "Negative guard for the HR specialist requirement."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "you can proceed to complete the Psychometric Test"
      ],
      "justification": "Action to complete the test internally."
    },
    {
      "refs": [
        "guard:b3->c4",
        "action:n13"
      ],
      "verbatim_texts": [
        "you can continue with the process and coordinate the second round of selection"
      ],
      "justification": "Guard captures the 'not required' continuation path. Structural converges merge flows appropriately before the coordination step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, you should request the final candidate ranking and continue with the process."
      ],
      "justification": "Final request action and explicit process termination."
    }
  ],
