{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Initially, you should check if the applicant wishes to discuss the terms and conditions."
      ],
      "justification": "Process start and initial inquiry action align with the opening instruction."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes\""
      ],
      "justification": "XOR gateway and affirmative guard capture the positive condition."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to discuss the terms and conditions with the candidate."
      ],
      "justification": "Action for the affirmative branch."
    },
    {
      "refs": [
        "guard:b1->n_continue"
      ],
      "verbatim_texts": [
        "Otherwise,"
      ],
      "justification": "Guard captures the negative/alternative condition."
    },
    {
      "refs": [
        "action:n_continue"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Default continuation step following the negative branch."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Next, check if the applicant wants to modify the terms and conditions."
      ],
      "justification": "Flow merge and subsequent modification request check."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "continue to check if the change is within the set client limits."
      ],
      "justification": "Secondary validation step preceding the limit decision."
    },
    {
      "refs": [
        "guard:b3->n6"
      ],
      "verbatim_texts": [
        "If it is not,"
      ],
      "justification": "Gateway and negative guard for the limit check."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "relay the applicant's changes."
      ],
      "justification": "Action executed when changes exceed limits."
    },
    {
      "refs": [
        "guard:b3->n7"
      ],
      "verbatim_texts": [
        "If it is within the limits,"
      ],
      "justification": "Positive guard for the limit check."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "relay the applicant's changes and continue with the process."
      ],
      "justification": "Action executed when changes are within limits."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Seek approval for the offer and continue with the process."
      ],
      "justification": "Merge point and approval request step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Modify the terms and conditions accordingly."
      ],
      "justification": "Terms modification step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Send the appointment approval and mandatory documentation to HR Services."
      ],
      "justification": "Documentation routing step."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Scan and upload the completed approval form to Cloud Source."
      ],
      "justification": "File upload step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Make a formal offer."
      ],
      "justification": "Formal offer generation step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Check if the changes are acceptable."
      ],
      "justification": "Acceptability evaluation and decision point."
    },
    {
      "refs": [
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If they are,"
      ],
      "justification": "Positive guard for acceptability check."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Continuation following positive acceptability."
    },
    {
      "refs": [
        "guard:b4->n15"
      ],
      "verbatim_texts": [
        "If not,"
      ],
      "justification": "Negative guard for acceptability check."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "select a new applicant from the list."
      ],
      "justification": "Fallback applicant selection step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Check if the client accepts the changes."
      ],
      "justification": "Final client acceptance evaluation and split."
    },
    {
      "refs": [
        "guard:b_client->n_end_proc"
      ],
      "verbatim_texts": [
        "If they do,"
      ],
      "justification": "Positive guard for client acceptance."
    },
    {
      "refs": [
        "action:n_end_proc"
      ],
      "verbatim_texts": [
        "the process ends."
      ],
      "justification": "Termination action and structural end nodes correspond to process conclusion."
    },
    {
      "refs": [
        "guard:b_client->n_sel_cand",
        "action:n_sel_cand"
      ],
      "verbatim_texts": [
        "select a new candidate from the list."
      ],
      "justification": "Negative acceptance guard and fallback candidate selection action."
    }
