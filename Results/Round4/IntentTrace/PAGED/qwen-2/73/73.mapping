    {
      "refs": [
        "guard:b2->e2"
      ],
      "verbatim_texts": [
        "check if the item is in stock."
      ],
      "justification": "Structural plumbing for the implicit negative branch of the stock check. Adds no new behaviour and preserves valid flow completion."
    }
