      ],
      "verbatim_texts": [
        "To begin the process for IT Infrastructure, start with the Loan Application and then proceed to Receive Loan Application."
      ],
      "justification": "Covers process initialization and the first two sequential steps exactly as described."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "check the Banking Privilege Status."
      ],
      "justification": "Models the status verification step. Content paraphrases the source while preserving the required behavior."
    },
    {
      "refs": [
        "guard:b1->n5",
        "guard:b1->n6",
        "action:n5"
      ],
      "verbatim_texts": [
        "If there is a \"Construct Error Response\", then the process ends with an \"Error Message\"."
      ],
      "justification": "Captures the first decision point and its negative outcome. Abstract guards represent the implied yes/no paths without altering behavior."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "\"Retrieve Customer Information\""
      ],
      "justification": "Directly matches the retrieval step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check the fulfillment of loan conditions."
      ],
      "justification": "Directly matches the condition verification step."
    },
    {
      "refs": [
        "guard:b2->n8",
        "guard:b2->n9",
        "action:n8"
      ],
      "verbatim_texts": [
        "If there is a \"Construct Error Response\", then the process ends with an \"Error Message\"."
      ],
      "justification": "Corresponds to the second occurrence of the error-response condition in the source text. Behavior is preserved."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Otherwise, if there is a \"Calculate threshold amount\", continue with the process."
      ],
      "justification": "Matches the threshold calculation continuation step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If there is a \"Check Creditworthiness\", designate the Status."
      ],
      "justification": "Splits the compound instruction into two sequential actions. This re-typing preserves the original behavior."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the Status is designated, initialize the Loan Form."
      ],
      "justification": "Directly matches the form initialization step."
    },
    {
      "refs": [
        "guard:b4->n14",
        "guard:b4->n15",
        "action:n14"
      ],
      "verbatim_texts": [
        "If there is a \"Construct Approve Response\", then the process ends with an \"Approved Message\"."
      ],
      "justification": "Models the approval branch and terminal message correctly."
    },
    {
      "refs": [
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Otherwise, if there is a \"Construct Reject Response\", then the process ends with a \"Reject Message\"."
      ],
      "justification": "Captures the rejection branch and terminal message. Splitting the condition/response into an action preserves behavior."
    }
  ],
