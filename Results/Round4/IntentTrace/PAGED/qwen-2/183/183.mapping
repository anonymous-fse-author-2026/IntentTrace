      "verbatim_texts": [
        "To start the process, begin by adding the image description and uploading the image."
      ],
      "justification": "The start node and initial action directly correspond to the opening instruction."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the message indicates a successful upload, the process will end."
      ],
      "justification": "The XOR gateway and success path correctly model the condition that a successful upload terminates the process."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the message indicates an unsuccessful upload, then try again."
      ],
      "justification": "The negative branch of the first decision leads to the retry prompt, preserving the intended flow."
    },
    {
      "refs": [
        "guard:b2->i1"
      ],
      "verbatim_texts": [
        "If the option to try again is selected, the process will continue."
      ],
      "justification": "The positive retry outcome loops back to the initial action, correctly implementing the continuation behaviour."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If the option to try again is not selected, then an error will occur and the process will end."
      ],
      "justification": "The negative retry outcome correctly triggers the error state and terminates the process."
    }
