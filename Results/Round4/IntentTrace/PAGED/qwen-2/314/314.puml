@startuml
!theme plain
|a_default| Default
|a_default|
start
:v1: Candidate Available Initially ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'No'])
:Advertise Vacancy;
repeat :;
:v2: Candidate Available After Advertising ({Yes, No}); <<objectSignal>>
backward:Advertise Again;
repeat while () is ([v2 = 'No']) not ([v2 = 'Yes'])
else ([v1 = 'Yes'])
->;
endif
:Select Applicant;
stop
@enduml