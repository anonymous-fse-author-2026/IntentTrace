    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available"
      ],
      "justification": "Second branch and its negative guard correspond to the repeated candidate availability check."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "then advertise the vacancy again"
      ],
      "justification": "Action accurately models the re-advertisement step on the second negative path."
    },
