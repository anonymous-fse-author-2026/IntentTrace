        "action:n3"
      ],
      "verbatim_texts": [
        "On the other hand, if there is a suitable candidate available, then proceed with selecting the appropriate applicant."
      ],
      "justification": "Positive guard routes flow to the selection action, preserving the conditional step exactly."
    }
