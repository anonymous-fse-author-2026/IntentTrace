{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "For the customer, the process begins with a request to purchase a motorcycle."
      ],
      "justification": "Covers process initiation and the first explicit action."
    },
    {
      "refs": [
        "action:n2",
        "guard:b2->n14",
        "guard:b2->n13"
      ],
      "verbatim_texts": [
        "Once the request is received, the next step is to either continue the process if a production order is received or update the sales information and proceed to order dispatch."
      ],
      "justification": "Models the secondary decision with abstract guards that correctly route flow to dispatch or sales update paths."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "If there are unavailable materials, they are ordered from the supplier."
      ],
      "justification": "Captures the unavailable-materials branch and the ordering action using an abstract boolean guard."
    },
    {
      "refs": [
        "guard:b1->n8",
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "Alternatively, if there are available goods for production, a manufacturing order is placed."
      ],
      "justification": "Captures the available-goods branch and the manufacturing order action using the complementary abstract guard."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "Once the materials are received from the supplier, the goods are issued and the motorcycles are produced."
      ],
      "justification": "Represents the synchronization point after procurement before production/dispatch steps; structural absorption preserves flow."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "At the same time, the stock is updated and the motorcycles are dispatched."
      ],
      "justification": "Direct paraphrase combining dispatch and stock update into one action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "After the goods are issued and the motorcycles are produced, the stock is updated and the process ends."
      ],
      "justification": "Covers the finalization step and process termination."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, the stock is updated and the sales information is updated."
      ],
      "justification": "Captures the parallel stock/sales update action and flow rejoining."
    }
  ],
