{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "To start the process, begin by supplying the requirement and then documenting it."
      ],
      "justification": "Init marks process start; action matches the opening step exactly."
    },
    {
      "refs": [
        "guard:b_ch->i2",
        "action:i2"
      ],
      "verbatim_texts": [
        "If the order is received via fax, input the order into an Excel file."
      ],
      "justification": "Branch splits flow; guard encodes fax condition; action matches content."
    },
    {
      "refs": [
        "guard:b_ch->i3",
        "action:i3"
      ],
      "verbatim_texts": [
        "If the order is received via mail or phone, also input the order into an Excel file."
      ],
      "justification": "Converge rejoins flow; guard encodes mail/phone condition; action matches content."
    },
    {
      "refs": [
        "action:i4"
      ],
      "verbatim_texts": [
        "Once the Excel list is complete after a week, send it to the student."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "Upon receiving the Excel list, type the orders into the MS-Access database."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "After typing the orders into the database, ensure that it is completed."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:i7"
      ],
      "verbatim_texts": [
        "Once the database is completed, control the incoming order."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:i8"
      ],
      "verbatim_texts": [
        "At the same time, continue to do the check."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b_corr->i9",
        "action:i9"
      ],
      "verbatim_texts": [
        "If the order is correct, release it."
      ],
      "justification": "Branch splits on correctness; guard/action match positive outcome."
    },
    {
      "refs": [
        "guard:b_corr->i10",
        "action:i10"
      ],
      "verbatim_texts": [
        "However, if the order is incorrect, contact the selling agency."
      ],
      "justification": "Guard/action match negative outcome."
    },
    {
      "refs": [
        "action:i11",
        "guard:b_val->i13"
      ],
      "verbatim_texts": [
        "If the order is worth less than 5.000 \u20ac, release it."
      ],
      "justification": "Condition modeled across action and guard; behaviour preserved."
    },
    {
      "refs": [
        "guard:b_val->i12",
        "action:i12"
      ],
      "verbatim_texts": [
        "If the order is worth more than 5.000 \u20ac, send it for sign off and continue with the check."
      ],
      "justification": "Branch splits on value; guard/action match >5k path."
    },
    {
      "refs": [
        "action:i13"
      ],
      "verbatim_texts": [
        "Contact the selling agency and upon receiving the actual issue, send the order for sign off."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:i14"
      ],
      "verbatim_texts": [
        "Once the order is signed off, contact the client and release the order."
      ],
      "justification": "Converge joins paths; action matches content."
    },
    {
      "refs": [
        "action:i15"
      ],
      "verbatim_texts": [
        "Once the order is received by PPC, they will initiate production."
      ],
      "justification": "Converge joins paths; action matches content."
    },
    {
      "refs": [
        "guard:b_iss->i18",
        "action:i16"
      ],
      "verbatim_texts": [
        "If the issue cannot be solved, cancel the order."
      ],
      "justification": "Branch splits on solvability; guard/action match cancellation path."
    },
    {
      "refs": [
        "guard:b_iss->i17",
        "action:i17"
      ],
      "verbatim_texts": [
        "If the issue can be solved, release the order."
      ],
      "justification": "Guard/action match resolution path."
    },
    {
      "refs": [
        "action:i18"
      ],
      "verbatim_texts": [
        "After PPC initiates production, the goods will be produced."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:i19",
        "guard:b_canc->i21"
      ],
      "verbatim_texts": [
        "If the order needs to be cancelled, the process ends."
      ],
      "justification": "Action states condition; branch/guard handle the decision split."
    },
    {
      "refs": [
        "guard:b_canc->c_20",
        "action:i20"
      ],
      "verbatim_texts": [
        "If not, check the quality of the goods."
      ],
      "justification": "Continuation path converges; guard/action match continuation."
    },
    {
      "refs": [
        "action:i21"
      ],
      "verbatim_texts": [
        "Once the quality is checked, create and send a quality report to the finance department."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b_fin->i22",
        "action:i22"
      ],
      "verbatim_texts": [
        "Release the order via memo and ensure that the memo is achieved in the warehouse."
      ],
      "justification": "OR branch enables parallel tasks; guard/action match first task."
    },
    {
      "refs": [
        "guard:b_fin->i23",
        "action:i23"
      ],
      "verbatim_texts": [
        "Send the invoice and once it is sent, report the achievement to the finance department."
      ],
      "justification": "Guard/action match second parallel task."
    },
    {
      "refs": [
        "guard:b_fin->i24",
        "action:i24"
      ],
      "verbatim_texts": [
        "At the same time, commission the goods and sign and send the memo."
      ],
      "justification": "Guard/action match third parallel task."
    },
    {
      "refs": [
        "guard:b_fin->i25",
        "action:i25"
      ],
      "verbatim_texts": [
        "Also, send the goods and ensure that the signed memo is achieved in the logistic department."
      ],
      "justification": "Guard/action match fourth parallel task."
    },
    {
      "refs": [
        "guard:b_fin->i26",
        "action:i26"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order."
      ],
      "justification": "Final step converges parallel flows; guard/action match archiving/closing."
    },
    {
      "refs": [
        "end:i_end"
      ],
      "verbatim_texts": [
        "Finally, archive the memo and close the order."
      ],
      "justification": "Process termination aligns with final step."
    }
  ],
