init(i1)
branch(b1, XOR)
action(n3, "Acquire Pricing A")
converge(c1)
branch(b2, XOR)
action(n5, "Acquire Pricing B")
converge(c2)
action(n6, "Margin Calculation")
action(n7, "Prepare Offer")
action(n8, "Calculate Transport Rate")
end(e1)
defines(v1, "Check Answer", {"No", "Yes"})
defines(v2, "Recheck Answer", {"No", "Yes"})
actor(a_default, "Default", [i1, b1, n3, c1, b2, n5, c2, n6, n7, n8, e1])
precedence(i1, b1)
precedence(b1, n3)
precedence(b1, c1)
precedence(n3, c1)
precedence(c1, b2)
precedence(b2, n5)
precedence(b2, c2)
precedence(n5, c2)
precedence(c2, n6)
precedence(n6, n7)
precedence(n7, n8)
precedence(n8, e1)
guard(b1, n3, v1 = 'No')
guard(b1, c1, v1 = 'Yes')
guard(b2, n5, v2 = 'No')
guard(b2, c2, v2 = 'Yes')