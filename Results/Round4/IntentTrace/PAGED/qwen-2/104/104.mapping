{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
      "justification": "Initiates the process and represents the initial decision point on the option."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Correctly models the positive branch action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Models the negative branch sequence with indications, research, and convergence."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "After validating the schedule,"
      ],
      "justification": "Schedule validation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory."
      ],
      "justification": "First satisfaction check and decision point."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Handles the first failure path leading to research."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\"."
      ],
      "justification": "Represents the loop/retry condition stated redundantly in the source."
    },
    {
      "refs": [
        "guard:b3->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Final negative path for unsatisfactory schedule leads to indications and termination."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Both satisfactory branches converge correctly."
    },
    {
      "refs": [
        "guard:b3->c2"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Both satisfactory branches converge correctly."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "write a ticket order to SNCF."
      ],
      "justification": "Direct mapping of the ticket order step."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Ticket order validation step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "First approval check and decision point."
    },
    {
      "refs": [
        "guard:b4->e2"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "First rejection path terminates the process."
    },
    {
      "refs": [
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Positive path continues with re-validation."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Second approval check and decision point."
    },
    {
      "refs": [
        "action:n19",
        "action:n20"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Final validation and check steps."
    },
    {
      "refs": [
        "guard:b5->e3",
        "guard:b5->n19"
      ],
      "verbatim_texts": [
        "If it is, then the process ends. If it is not, then the process ends."
      ],
      "justification": "Dual termination conditions mapped to end nodes and guards, preserving behaviour."
    }
  ],
