@startuml
!theme plain
|a_default| Default
|a_default|
start
:start of process;
:v1: is research schedule directly selected ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:Research schedule;
else ([v1 = 'No'])
:Provide indications;
:Research schedule;
endif
:Validate schedule;
:check if the schedule is satisfactory;
:v2: is schedule satisfactory first check ({No, Yes}); <<objectSignal>>
if () then ([v2 = 'No'])
:Research schedule;
:check if the schedule is satisfactory;
:v3: is schedule satisfactory second check ({No, Yes}); <<objectSignal>>
if () then ([v3 = 'No'])
:Provide indications;
stop
else ([v3 = 'Yes'])
->;
endif
else ([v2 = 'Yes'])
->;
endif
:Write ticket order to SNCF;
:Validate ticket order;
:is ticket order approved first check;
:v4: is ticket order approved first check ({No, Yes}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:Validate ticket order;
:Check again if the ticket order is approved;
:v5: is ticket order approved second check ({No, Yes}); <<objectSignal>>
if () then ([v5 = 'Yes'])
:Validate ticket order;
:Check once more if the ticket order is approved;
stop
else ([v5 = 'No'])
stop
endif
else ([v4 = 'No'])
stop
endif
@enduml