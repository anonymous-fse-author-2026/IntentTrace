{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived."
      ],
      "justification": "Captures the implicit process start and the initial request arrival action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "proceed with the Registration gross pathology request."
      ],
      "justification": "Maps the registration step and its explicitly required barcode creation sub-step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "During the \"Registration gross pathology request\" step, make sure to create a barcode scan at the start."
      ],
      "justification": "Maps the registration step and its explicitly required barcode creation sub-step."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "Once the registration is complete, assign a container to the gross pathology request."
      ],
      "justification": "Directly covers the container assignment following registration."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "move on to the Specimen description."
      ],
      "justification": "Accurately sequences the specimen description phase and the three specific scanning checkpoints."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "pay attention to the scan start."
      ],
      "justification": "Accurately sequences the specimen description phase and the three specific scanning checkpoints."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Then, pay attention to the scan end."
      ],
      "justification": "Accurately sequences the specimen description phase and the three specific scanning checkpoints."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Finally, pay attention to the scan start again for the Registration gross pathology request (cont.) step."
      ],
      "justification": "Accurately sequences the specimen description phase and the three specific scanning checkpoints."
    },
    {
      "refs": [
        "action:n9",
        "action:n10",
        "label:b3->n9",
        "label:b3->n10",
        "label:c3->n11"
      ],
      "verbatim_texts": [
        "proceed with Macroscopic description writing. Simultaneously, complete the following steps: Tissue processing,"
      ],
      "justification": "The AND gateway correctly models the simultaneous execution of macroscopic writing and tissue processing. Edge labels are structural metadata and do not alter behaviour."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required.",
        "If the answer is \"no,\" continue the process.",
        "If the answer is \"yes,\" proceed with Digitalization."
      ],
      "justification": "Correctly implements the first digitalization decision point, routing 'no' through the converge and 'yes' to the digitalization step."
    },
    {
      "refs": [
        "guard:b1->c1"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required.",
