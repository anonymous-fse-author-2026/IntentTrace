init(start)
action(n1, "start")
action(n2, "receive form")
action(n3, "check if form is complete")
branch(b1, XOR)
action(n4, "end process: form needs to be sent back")
end(e1)
action(n5, "check income")
branch(b3, XOR)
action(n6, "check deductibles")
action(n7, "check house")
converge(c1)
action(n8, "make decision")
branch(b2, XOR)
action(n9, "end process: check declaration")
end(e2)
action(n10, "invite declarant")
end(e3)
defines(v1, "check if form is complete", {"sent_back", "check_income"})
defines(v2, "make decision", {"check_declaration", "invite_declarant"})
defines(v3, "check_type", {"deductibles", "house"})
actor(a_default, "Default", [start, n1, n2, n3, b1, n4, e1, n5, b3, n6, n7, c1, n8, b2, n9, e2, n10, e3])
precedence(start, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n5, b3)
precedence(b3, n6)
precedence(b3, n7)
precedence(n6, c1)
precedence(n7, c1)
precedence(c1, n8)
precedence(n4, e1)
precedence(n8, b2)
precedence(b2, n9)
precedence(b2, n10)
precedence(n9, e2)
precedence(n10, e3)
guard(b1, n4, v1 = "sent_back")
guard(b1, n5, v1 = "check_income")
guard(b3, n6, v3 = "deductibles")
guard(b3, n7, v3 = "house")
guard(b2, n9, v2 = "check_declaration")
guard(b2, n10, v2 = "invite_declarant")