{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "The process starts when the customer enters the website"
      ],
      "justification": "Initiates the process and captures the initial website entry step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "and then searches for the desired item."
      ],
      "justification": "Directly models the search step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After finding the desired item, they click on it"
      ],
      "justification": "Models the clicking action following the search."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "and enter the desired item page. From there, they choose an action."
      ],
      "justification": "Captures navigating to the item page and selecting an action."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they choose to view the quantity amount, they can see the quantity amount."
      ],
      "justification": "Opens the XOR branch, applies the correct guard condition, and executes the view action."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "Alternatively, if they choose to enter a quantity amount, they can input it."
      ],
      "justification": "Applies the alternative guard condition and executes the input action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the quantity amount is viewed or entered, they return to the desired item page."
      ],
      "justification": "Joins the split flows and models the return navigation step."
    },
    {
      "refs": [
        "action:n8",
        "action:n9"
      ],
      "verbatim_texts": [
        "From there, they add the item to their cart, and once it's added, they choose another action."
      ],
      "justification": "Splits the sentence into adding to cart and choosing the next action; behaviour is fully preserved."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If they choose to continue shopping, they return to the desired item page."
      ],
      "justification": "Creates the second decision branch, applies the guard, and models both the choice and the explicit return step."
    },
    {
      "refs": [
        "guard:b2->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "However, if they choose to check out the current item, they proceed to check out."
      ],
      "justification": "Applies the alternative guard and models the checkout initiation steps."
    },
    {
      "refs": [
        "action:n14",
        "action:n15"
      ],
      "verbatim_texts": [
        "After checking out the item, they confirm it, and once it's confirmed, they choose another action."
      ],
      "justification": "Models the confirmation step and the subsequent action choice."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If they choose to proceed to check out, they go to the check-out page."
      ],
      "justification": "Opens the third decision point, applies the guard, and executes the navigation action."
    },
    {
      "refs": [
        "guard:b3->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "Alternatively, if they choose to recalculate the shipping, they can do so."
      ],
      "justification": "Applies the shipping recalculation guard and corresponding action."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Lastly, if they choose to enter a coupon code, they can enter it."
      ],
      "justification": "Applies the coupon code guard and corresponding action."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once they proceed to check out, recalculate the shipping, or enter a coupon code, they enter the check-out page."
      ],
      "justification": "Structural converges join the three alternative paths and the action models entering the checkout page."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "From there, they enter their billing information, and the process ends."
      ],
      "justification": "Models the final data entry step and the explicit process termination."
    }
  ],
