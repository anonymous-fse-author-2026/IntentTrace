@startuml
!theme plain
|a_default| Default
|a_default|
start
:start process;
:check customer order;
:is customer registered;
:v1: customer type ({Registered, New, Wholesaler}); <<objectSignal>>
switch ()
case ([v1 = 'Registered'])
:check payment morale;
:is payment morale good;
:v2: is payment morale good ({Bad, Good}); <<objectSignal>>
if () then ([v2 = 'Good'])
:continue with process;
:check item availability;
:are items in stock;
:v4: are items in stock ({Yes, No}); <<objectSignal>>
if () then ([v4 = 'Yes'])
:continue with process;
:send order confirmation;
else ([v4 = 'No'])
:start production;
:produce article;
:send order confirmation;
endif
:send invoice and deliver product;
:is payment received;
:v5: is payment received ({Yes, No}); <<objectSignal>>
if () then ([v5 = 'Yes'])
:close order;
stop
else ([v5 = 'No'])
:v6: are reminders more than 3 ({More than 3, 3 or fewer}); <<objectSignal>>
if () then ([v6 = 'More than 3'])
:engage lawyer;
stop
else ([v6 = '3 or fewer'])
:send reminder;
stop
endif
endif
else ([v2 = 'Bad'])
:reject order;
:end process;
stop
endif
case ([v1 = 'New'])
:check customer status;
:is end customer;
case ([v1 = 'Wholesaler'])
:enter data and take order;
endswitch
@enduml