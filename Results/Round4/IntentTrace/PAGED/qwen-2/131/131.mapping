{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To become a member, start the process at 8:00 am and then empty the mailbox."
      ],
      "justification": "Covers the process initiation and the first two sequential actions described in the opening unit."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "Models the initial verification step and introduces the corresponding decision gateway."
    },
    {
      "refs": [
        "guard:b1->c_mb",
        "action:n4"
      ],
      "verbatim_texts": [
        "If it is empty, the process ends."
      ],
      "justification": "Captures the positive outcome condition, the explicit termination action, and the structural end node."
    },
    {
      "refs": [
        "guard:b1->n20"
      ],
      "verbatim_texts": [
        "if not, continue the process."
      ],
      "justification": "Maps the negative branch condition to the continuation step and the second verification check."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again"
      ],
      "justification": "Maps the negative branch condition to the continuation step and the second verification check."
    },
    {
      "refs": [
        "guard:b5->c_mb"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Handles the outcomes of the second check and transitions to the completeness verification decision."
    },
    {
      "refs": [
        "guard:b5->n5"
      ],
      "verbatim_texts": [
        "If it is complete,"
      ],
      "justification": "Handles the outcomes of the second check and transitions to the completeness verification decision."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If it is not complete,"
      ],
      "justification": "Handles the outcomes of the second check and transitions to the completeness verification decision."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "add the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Positive branch for completeness leads directly to recording the mail details."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "make a telephone call to the sender."
      ],
      "justification": "Negative branch for completeness triggers the required phone contact."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "After the telephone call, complete the data by adding the incoming mail number, date, and record it in the letter book."
      ],
      "justification": "Directly models the post-call data completion step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda."
      ],
      "justification": "Exact paraphrase of the weekly administrative task."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member,"
      ],
      "justification": "Structural split and guards correctly capture the mutual exclusion between acceptance and rejection paths."
    },
    {
      "refs": [
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member,"
      ],
      "justification": "Structural split and guards correctly capture the mutual exclusion between acceptance and rejection paths."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "stamp \"new Member\" on the letter and write the date on it."
      ],
      "justification": "Matches the positive membership action."
    },
    {
      "refs": [
        "action:n12",
        "action:n24"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it, write the data."
      ],
      "justification": "Both elements cover the same data-writing step; redundancy does not alter behaviour, so it is a match."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "write to them and inform them of the decision."
      ],
      "justification": "Matches the negative membership notification action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, calculate the fee"
      ],
      "justification": "Direct match for the fee calculation step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "hand the letter to Charles.",
        "Ask Charles to write the amount in the register."
      ],
      "justification": "Merges two consecutive handoff/request steps into a single compatible action."
    },
    {
      "refs": [
        "guard:b_split->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "Print the membership card with all the data and send it to the new member."
      ],
      "justification": "Models the branching flow towards card production; split is a permissible structural representation of parallel/subsequent flows."
    },
    {
      "refs": [
        "guard:b_split->n21",
        "action:n21"
      ],
      "verbatim_texts": [
        "Hand the letter to Charles and add the new member to the register."
      ],
      "justification": "Captures the alternative/complementary register update and handoff path."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "Prepare an invoice for the new members"
      ],
      "justification": "Direct match for invoice preparation."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "Ask Charles to write the amount in the register and write the fee amount to the register."
      ],
      "justification": "Exact restatement of the final registration request."
    }
  ],
