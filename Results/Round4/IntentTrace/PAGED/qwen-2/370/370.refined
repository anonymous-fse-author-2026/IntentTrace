init(i1)
action(n1, "start the procedure")
action(n2, "do you desire new hair")
action(b1, "confirm new hair desire")
action(n3, "visit the hairdresser")
branch(b2, OR)
action(n5, "have your hair washed")
action(n7, "have your hair cut")
action(n9, "have your hair dried")
converge(n4)
end(e1)
defines(v1, "do you desire new hair", {true, false})
defines(v2, "do you want your hair washed", {true, false})
defines(v3, "do you want your hair cut", {true, false})
defines(v4, "do you want your hair dried", {true, false})
actor(a_default, "Default", [i1, n1, n2, b1, n3, b2, n5, n7, n9, n4, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(n3, b2)
precedence(b2, n5)
precedence(b2, n7)
precedence(b2, n9)
precedence(n5, n4)
precedence(n7, n4)
precedence(n9, n4)
precedence(n4, e1)
guard(b2, n5, v2 = true)
guard(b2, n7, v3 = true)
guard(b2, n9, v4 = true)