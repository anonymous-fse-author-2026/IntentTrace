init(start)
action(n_wake, "wake up")
branch(b_first, XOR)
action(n_shower1, "take a shower")
action(n_breakfast1, "have breakfast")
converge(c_merge1)
branch(b_second, XOR)
branch(b_third, XOR)
action(n_shower2, "take a shower")
converge(c_merge2)
converge(c_merge3)
action(n_bus, "get on the bus")
end(e_finish)
defines(v_hungry, "Are you hungry?", {"Yes", "No"})
defines(v_still_hungry, "Are you still hungry?", {"Yes", "No"})
actor(a_default, "Default", [start, n_wake, b_first, n_shower1, n_breakfast1, c_merge1, b_second, b_third, n_shower2, c_merge2, c_merge3, n_bus, e_finish])
precedence(start, n_wake)
precedence(n_wake, b_first)
precedence(b_first, n_shower1)
precedence(b_first, c_merge1)
precedence(n_shower1, b_second)
precedence(b_second, c_merge2)
precedence(b_second, c_merge1)
precedence(c_merge1, n_breakfast1)
precedence(n_breakfast1, b_third)
precedence(b_third, c_merge2)
precedence(b_third, c_merge3)
precedence(c_merge2, n_shower2)
precedence(n_shower2, c_merge3)
precedence(c_merge3, n_bus)
precedence(n_bus, e_finish)
guard(b_first, n_shower1, v_hungry = 'No')
guard(b_first, c_merge1, v_hungry = 'Yes')
guard(b_second, c_merge2, v_still_hungry = 'No')
guard(b_second, c_merge1, v_still_hungry = 'Yes')
guard(b_third, c_merge2, v_still_hungry = 'No')
guard(b_third, c_merge3, v_still_hungry = 'Yes')