init(i1)
action(n1, "start the process")
action(n2, "Ensure Freights are ready to be shipped")
action(n3, "Ship Freight")
action(n4, "Deliver Freight and Notify Delivery")
action(n6, "Process Merchandise Return Request")
branch(b1, XOR)
action(n7, "Accept Merchandise Return")
action(n8, "Reject Merchandise Return")
end(e1)
action(n9, "Proceed with Returning Merchandise")
end(e2)
action(n10, "Invoice the Customer")
end(e3)
action(n11, "Approve Loss Claim and End Process")
end(e4)
branch(b2, OR)
defines(v1, "Return Decision", {"Accepted", "Rejected"})
defines(v_cond, "Event Trigger", {"Return", "Invoice", "Claim"})
actor(a_default, "Default", [i1, n1, n2, n3, n4, n6, b1, n7, n8, e1, n9, e2, n10, e3, n11, e4, b2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b2)
precedence(b2, n6)
precedence(b2, n10)
precedence(b2, n11)
precedence(n6, b1)
precedence(b1, n7)
precedence(b1, n8)
precedence(n7, n9)
precedence(n8, e1)
precedence(n9, e2)
precedence(n10, e3)
precedence(n11, e4)
guard(b1, n7, v1 = 'Accepted')
guard(b1, n8, v1 = 'Rejected')
guard(b2, n6, v_cond = 'Return')
guard(b2, n10, v_cond = 'Invoice')
guard(b2, n11, v_cond = 'Claim')
label(b2, n10, "5 days have passed")
label(b2, n11, "Loss Claim Lodged")