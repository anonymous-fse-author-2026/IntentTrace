{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, trigger the resupply cycle and then check the inventory level."
      ],
      "justification": "Start node plus two actions directly correspond to the opening unit describing initialization and the first two steps."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the inventory level is at or below the minimum, create a purchase order."
      ],
      "justification": "Branch, guard, and action correctly capture the conditional threshold and the resulting step."
    },
    {
      "refs": [
        "guard:b1->e1"
      ],
      "verbatim_texts": [
        "Otherwise, if the inventory level is above the minimum, the process ends."
      ],
      "justification": "Guard and end node cover the alternative branch condition and process termination."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "After creating the purchase order, review it."
      ],
      "justification": "Direct correspondence to the post-creation review step."
    },
    {
      "refs": [
        "guard:b2->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the purchase status is rejected, rework the purchase order."
      ],
      "justification": "Branch, guard, and action correctly model the rejection condition and the rework step."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the purchase status is approved, reserve the funds."
      ],
      "justification": "Guard and action cover the approval condition and fund reservation step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "and then review it."
      ],
      "justification": "Models the required review step that follows the rework action."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "send the order to the supplier"
      ],
      "justification": "Direct match to the shipping step."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: receive the packing slip and receive the invoice."
      ],
      "justification": "AND gateway splits the flow into parallel receipt steps, and the converge node rejoins them. Preserves the simultaneous execution requirement."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "record it"
      ],
      "justification": "The generic recording instruction is expanded into two specific actions matching the two parallel streams. Behaviour is fully preserved."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "Record the packing slip and the process ends."
      ],
      "justification": "Covers the termination point after the packing slip is recorded."
    },
    {
      "refs": [
        "end:e3"
      ],
      "verbatim_texts": [
        "Record the invoice and the process ends."
      ],
      "justification": "Covers the termination point after the invoice is recorded."
    }
  ],
