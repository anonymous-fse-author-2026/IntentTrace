{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, begin by receiving the claim."
      ],
      "justification": "The opening unit implicitly defines the process start and explicitly states the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, create the claim and record it."
      ],
      "justification": "Direct paraphrase of the claim creation and recording step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, make a decision on the claim."
      ],
      "justification": "Models the decision action and opens the XOR gateway required for the subsequent accept/reject split."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the claim is to be rejected"
      ],
      "justification": "Correctly captures the rejection condition guarding the negative branch."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then reject it."
      ],
      "justification": "Exact restatement of the rejection action."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if the claim is to be accepted"
      ],
      "justification": "Correctly captures the acceptance condition guarding the positive branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "offer the benefit."
      ],
      "justification": "Direct match for the action taken when the claim is accepted."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the claim is rejected, review the claim rejection."
      ],
      "justification": "Matches the review step on the rejection path; the conditional context is handled by upstream flow."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "prepare the claim discharge."
      ],
      "justification": "Direct match for the preparation step on the acceptance path."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "record the benefit payment."
      ],
      "justification": "Direct match for recording the payment after discharge preparation."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If the claim rejection is accepted"
      ],
      "justification": "Opens the second decision point and correctly models the positive guard value."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Represents the continuation step described for both rejection outcomes."
    },
    {
      "refs": [
        "guard:b2->c_join"
      ],
      "verbatim_texts": [
        "not accepted"
      ],
      "justification": "Captures the negative condition leading to the convergence point."
    },
    {
      "refs": [
        "converge:c_join"
      ],
      "verbatim_texts": [
        "continue the process."
      ],
      "justification": "Structural join where both rejection-review paths merge; preserves the described flow."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "At the same time"
      ],
      "justification": "Temporal marker correctly translated into an AND gateway for parallel execution."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "operate outgoing payment"
      ],
      "justification": "First step in the parallel execution block."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "close the claim."
      ],
      "justification": "Second step in the parallel execution block."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Converges the parallel flows, executes the terminal action, and places the explicit end marker."
    }
