{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process in the Admin Office, first check if it has started."
      ],
      "justification": "Captures process initiation and the first validation step. Splitting the opening sentence into a start node and two sequential actions preserves the intended behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "After that, verify the completeness of the invoices."
      ],
      "justification": "Direct paraphrase of the verification step."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If they are marked as \"Uncompleted\", they should be returned to the client through postal mail."
      ],
      "justification": "Models the conditional check as an action step, opens an XOR branch, applies the correct threshold guard, and executes the return action. Re-typing the condition as an action is behaviour-preserving."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if they are marked as \"Completed\", the process should be continued."
      ],
      "justification": "Captures the continuation path from the first decision. The guard checks for Completed status and the action restates the continuation logic without altering behaviour."
    },
    {
      "refs": [
        "action:n8",
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the invoices are still marked as \"Uncompleted\", they should be returned to the client via postal mail."
      ],
      "justification": "Accurately models the second iterative check, branch point, equality guard, and postal return action."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "On the other hand, if they are marked as \"Completed\", the process should be continued."
      ],
      "justification": "The guard verifies the Completed status for the second branch, and the converge node functionally represents continuing/joining the main process flow."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the invoices are returned to the client, receive the completed ones."
      ],
      "justification": "Exact textual match for the receipt step following the return loops."
    },
    {
      "refs": [
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Then, mark the relevant box on the invoice entry form and proceed with checking if the process has been completed."
      ],
      "justification": "Splits the compound instruction into two distinct sequential actions (marking the form, then checking completion) while preserving order and meaning."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Explicit termination action paired with the structural end node directly corresponds to the final instruction."
    }
  ],
