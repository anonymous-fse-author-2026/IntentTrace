      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "For the Part Provision Team, the first step is to identify the parts."
      ],
      "justification": "Implicitly defines the process start and captures the initial identification step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "guard:b1->c1",
        "label:n2->b1"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer, they should then check the availability of the parts."
      ],
      "justification": "Models the XOR decision point, its outgoing conditions, and a connecting label that restates the branching logic."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer, they should then check the availability of the parts."
      ],
      "justification": "Captures the positive-arm action from the conditional statement."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "If the team needs to elicit information from the customer, they should then check the availability of the parts.",
        "On the other hand, if they already have the availability information, they can proceed with the process."
      ],
      "justification": "Joins the two alternative flows described across both units back into a single path."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "However, if they need to record the customer's details, they should order and receive the part from Disuki."
      ],
      "justification": "Splits the compound instruction into two sequential actions (ordering then receiving), preserving the intended behaviour."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Once the part is received, the team can then contract the customer."
      ],
      "justification": "Direct correspondence; minor wording variation does not alter the process behaviour."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "label:n10->n11"
      ],
      "verbatim_texts": [
        "After all the necessary parts are collected, the team can proceed with the payment."
      ],
      "justification": "Separates collection and payment into distinct steps linked by a descriptive label, faithfully reflecting the source sequence."
    },
    {
      "refs": [
        "action:n12",
        "label:n11->n12"
      ],
      "verbatim_texts": [
        "Once the payment is made, the process comes to an end."
      ],
      "justification": "Captures the finalization action, process termination node, and a restating label. Harmless redundancy preserves behaviour."
    }
  ],
