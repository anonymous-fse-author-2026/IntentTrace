init(i1)
action(n2, "request authorisation for extra Parts")
branch(b1, XOR)
action(n4, "obtain requested Parts from stock")
action(n5, "stop work and wait for parts")
action(n6, "have parts arrived")
branch(b2, XOR)
action(n7, "resume work")
end(e1)
converge(c2)
defines(v1, "authorisation given", {"Yes", "No"})
defines(v2, "have parts arrived", {"No", "Yes"})
actor(a_default, "Default", [i1, n2, b1, n4, c2, n5, n6, b2, n7, e1])
precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, c2)
precedence(c2, n5)
precedence(n5, n6)
precedence(n6, b2)
precedence(b2, c2)
precedence(b2, n7)
precedence(n4, e1)
precedence(n7, e1)
guard(b1, n4, v1 = 'Yes')
guard(b1, c2, v1 = 'No')
guard(b2, c2, v2 = 'No')
guard(b2, n7, v2 = 'Yes')