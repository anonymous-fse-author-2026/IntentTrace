  "matches": [
    {
      "refs": [
        "action:a4"
      ],
      "verbatim_texts": [
        "Initially, if the option \"research schedule directly\" is selected, then the action to be taken is \"Research schedule\"."
      ],
      "justification": "Start node and first research action align with the initial selection condition."
    },
    {
      "refs": [
        "action:a2"
      ],
      "verbatim_texts": [
        "If the option is not selected, then \"provide indications\" and proceed with the research schedule."
      ],
      "justification": "Captures the alternative path providing indications."
    },
    {
      "refs": [
        "action:a3"
      ],
      "verbatim_texts": [
        "After validating the schedule, check if the schedule is satisfactory."
      ],
      "justification": "Models schedule validation and introduces the first satisfaction decision point."
    },
    {
      "refs": [
        "guard:b1->a4"
      ],
      "verbatim_texts": [
        "If it is not, then perform the action \"Research schedule\"."
      ],
      "justification": "Correctly models the negative satisfaction branch guard."
    },
    {
      "refs": [
        "guard:b1->a5",
        "action:a5"
      ],
      "verbatim_texts": [
        "If it is, then proceed with writing a ticket order to SNCF."
      ],
      "justification": "Positive satisfaction branch guard and corresponding ticket order action."
    },
    {
      "refs": [
        "action:a6"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\"."
      ],
      "justification": "Matches the repeated research step for unsatisfactory schedules."
    },
    {
      "refs": [
        "guard:b2->a7",
        "action:a7"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory, then \"provide indications\"."
      ],
      "justification": "Second decision point and negative branch with correct guard and action."
    },
    {
      "refs": [
        "guard:b2->a8",
        "action:a8"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Second positive branch guard and action."
    },
    {
      "refs": [
        "action:a9"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Flow convergence and ticket validation step."
    },
    {
      "refs": [
        "action:a10"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "First approval check action and corresponding decision branch."
    },
    {
      "refs": [
        "guard:b3->e11"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Negative approval guard leading to process termination."
    },
    {
      "refs": [
        "guard:b3->a12",
        "action:a12"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "Positive approval guard and re-validation action."
    },
    {
      "refs": [
        "action:a13"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Direct match for the second approval check."
    },
    {
      "refs": [
        "action:a14"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Direct match for the third approval check."
    },
    {
      "refs": [
        "end:e15"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Final termination condition matches the source text."
