{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "Initially, it is important to check the Referee Reports."
      ],
      "justification": "Process initialization and generic start action align with the opening statement describing the beginning of the workflow."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Initially, it is important to check the Referee Reports."
      ],
      "justification": "Directly captures the initial checking and concurrent monitoring steps. Modeling the monitoring/condition as an action (n3) preserves behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "At the same time, you should continue to monitor if the Referee Reports have been completed."
      ],
      "justification": "Directly captures the initial checking and concurrent monitoring steps. Modeling the monitoring/condition as an action (n3) preserves behaviour."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If they have been completed, you can proceed with the process."
      ],
      "justification": "Captures the first decision point, the positive guard ('Yes'), and the corresponding proceed action."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "However, if they have not been completed"
      ],
      "justification": "Captures the negative guard ('No') and the corresponding flag/remind action."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "you should flag it and send a reminder."
      ],
      "justification": "Captures the negative guard ('No') and the corresponding flag/remind action."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "After that, you should check again if the Referee Reports have been completed."
      ],
      "justification": "Captures the re-check step and the subsequent decision question."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "you can continue with the process."
      ],
      "justification": "Captures the positive outcome of the re-check and the continuation step."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Captures the negative outcome of the re-check and the follow-up flag/remind action."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "you should flag it again and send another reminder."
      ],
      "justification": "Captures the negative outcome of the re-check and the follow-up flag/remind action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "you can move on to organizing interviews for the Selection Panel with the top candidates."
      ],
      "justification": "Direct match to the interview organization step."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "After the interviews, it is necessary to receive feedback from the interview candidates."
      ],
      "justification": "Direct match to the feedback collection step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Next, you need to check if a Psychometric Test is required."
      ],
      "justification": "Captures the psychometric check, the 'Yes' branch, and the subsequent HR specialist verification."
    },
    {
      "refs": [
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If it is"
      ],
      "justification": "Captures the psychometric check, the 'Yes' branch, and the subsequent HR specialist verification."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "you should then check if an HR Specialist is required."
      ],
      "justification": "Captures the psychometric check, the 'Yes' branch, and the subsequent HR specialist verification."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "If not, you can continue with the process and coordinate the second round of selection."
      ],
      "justification": "Captures the alternative path where the psychometric test is not required, leading to coordinating the second round."
    },
    {
      "refs": [
        "guard:b5->n17"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required"
      ],
      "justification": "Captures the 'Yes' branch for HR requirement and the third-party scheduling action."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "you should schedule the test with a third party."
      ],
      "justification": "Captures the 'Yes' branch for HR requirement and the third-party scheduling action."
    },
    {
      "refs": [
        "guard:b5->n18",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "Otherwise, you can proceed to complete the Psychometric Test."
      ],
      "justification": "Captures the 'No' branch for HR requirement. Splitting 'proceed to complete' into two sequential actions preserves behaviour."
    },
    {
      "refs": [
        "action:n20",
        "action:n21"
      ],
      "verbatim_texts": [
        "Finally, you should request the final candidate ranking and continue with the process."
      ],
      "justification": "Final action matches the ranking request. Structural elements (end, converges) provide necessary process termination and flow joins."
    }
  ],
