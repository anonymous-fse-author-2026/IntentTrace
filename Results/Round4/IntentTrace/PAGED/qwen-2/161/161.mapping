{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "To start, you should join the team and agree on the team's domain."
      ],
      "justification": "Process start node and first action directly correspond to the opening step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model and check it."
      ],
      "justification": "Direct paraphrase of model creation and initial check."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\", then assign negative points."
      ],
      "justification": "Captures the penalty action for the first failure condition."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\", assign negative points again."
      ],
      "justification": "Condition modeled as an action step (n7) followed by the repeated penalty (n8) preserves the iterative re-check and penalty logic."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Direct paraphrase of proceeding when the model is acceptable."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "If there are any issues, fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Captures issue resolution and scope extension accurately."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points, continue with the process."
      ],
      "justification": "Models the conditional continuation logic."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Direct match for role assignment triggered by field analysis."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "If the process is okay, continue with the process and perform work according to your assigned role."
      ],
      "justification": "Matches the transition to role-based execution."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct paraphrase of monitoring and problem consultation."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it."
      ],
      "justification": "Models the acceptance check as an action (n15) feeding a branch (b4); the guard and action capture the positive outcome."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Guard and action capture the negative outcome path correctly."
    },
    {
      "refs": [
        "action:n19",
        "action:n20",
        "guard:b5->n21",
        "guard:b5->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the project is accepted, present it again. If not, continue working according to your role."
      ],
      "justification": "Captures the second presentation attempt, the subsequent re-evaluation split, and routing to either final presentation/ending or continued work. Behaviour is fully preserved."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Final presentation step leads to process termination. Multiple end nodes are harmless structural redundancy."
    }
  ],
