{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "Marks the start of the workflow."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Rental Items are Returned to the Store."
      ],
      "justification": "Direct paraphrase of the initial step."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process.",
        "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Structural split for the two return methods described in the source."
    },
    {
      "refs": [
        "converge:c1"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process.",
        "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Rejoins the two return paths after continuation."
    },
    {
      "refs": [
        "action:n3",
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\" then we can continue the process."
      ],
      "justification": "Action and guard capture the customer return branch."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if the \"Delivery Crew picks-up items at the event site,\" then we also continue the process."
      ],
      "justification": "Action and guard capture the delivery crew branch."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct match for the verification step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process.",
        "However, if the \"Order is incomplete and items are missing,\" we still continue the process.",
        "Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Structural split for the three order-status scenarios."
    },
    {
      "refs": [
        "converge:c_b3"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process.",
        "However, if the \"Order is incomplete and items are missing,\" we still continue the process.",
        "Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Rejoins the order-status paths."
    },
    {
      "refs": [
        "action:n5",
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\" then we proceed with the process."
      ],
      "justification": "Captures the complete order path."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "However, if the \"Order is incomplete and items are missing,\" we still continue the process."
      ],
      "justification": "Captures the incomplete/missing items path."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "Similarly, if the \"Order is complete but items are damaged,\" we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Captures the damaged items notification path."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\" we continue the process.",
        "Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Structural split for post-verification routing."
    },
    {
      "refs": [
        "converge:c3"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\" we continue the process.",
        "Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Rejoins the packing/storage paths."
    },
    {
      "refs": [
        "action:n8",
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\" we continue the process."
      ],
      "justification": "Captures packing for existing order."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "Alternatively, if the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Captures storing for future orders."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges, we email the customer to inform them."
      ],
      "justification": "Direct match for notifying about missing items."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges, we temporarily take them out of inventory."
      ],
      "justification": "Direct match for removing damaged items from inventory."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process.",
        "However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Structural split for missing item resolution decisions."
    },
    {
      "refs": [
        "converge:c4"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process.",
        "However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Rejoins the resolution paths."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->n15"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\" we continue the process."
      ],
      "justification": "Captures customer returning missing items."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Captures customer not returning missing items."
    },
    {
      "refs": [
        "branch:b_final_split"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends.",
        "If the \"Items are repaired and added into inventory,\" we continue the process.",
        "On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Structural split for final disposition routes."
    },
    {
      "refs": [
        "converge:c5"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends.",
        "If the \"Items are repaired and added into inventory,\" we continue the process.",
        "On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Rejoins the final disposition paths."
    },
    {
      "refs": [
        "guard:b_final_split->e1"
      ],
      "verbatim_texts": [
        "Finally, when the process is complete, it ends."
      ],
      "justification": "Terminates the process upon completion condition."
    },
    {
      "refs": [
        "action:n12",
        "guard:b_final_split->n12"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\" we continue the process."
      ],
      "justification": "Captures repair and inventory addition path."
    },
    {
      "refs": [
        "action:n13",
        "guard:b_final_split->n13"
      ],
      "verbatim_texts": [
        "On the other hand, if the \"Items can't be repaired and are discarded,\" we email the customer with replacement charges."
      ],
      "justification": "Captures the discard condition; email action is modeled separately downstream, preserving flow."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Lastly, the items are packed for an existing order."
      ],
      "justification": "Direct match for final packing step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\" we also continue the process."
      ],
      "justification": "Direct match for final storage step."
    },
    {
      "refs": [
        "branch:b7"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends.",
        "The customer is then emailed with replacement charges",
        "and the process is complete."
      ],
      "justification": "Structural split for final wrap-up actions."
    },
    {
      "refs": [
        "action:n20",
        "guard:b7->n20"
      ],
      "verbatim_texts": [
        "Once again, when the process is complete, it ends."
      ],
      "justification": "Action and guard capture the explicit end signal."
    },
    {
      "refs": [
        "action:n17",
        "guard:b7->n17"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges"
      ],
      "justification": "Captures the final charge notification."
    },
    {
      "refs": [
        "end:e2"
      ],
      "verbatim_texts": [
        "and the process is complete."
      ],
      "justification": "Final termination point matching the completion statement."
    }
