      ],
      "verbatim_texts": [
        "For the company, the first step is to look at the order."
      ],
      "justification": "The init marks the implicit process start, and the action directly captures the first operational step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "If the order is to be rejected, the process should continue. If the order is to be accepted, the process should also continue."
      ],
      "justification": "The conditional is modeled as an action step ('order rejected?'). Since both outcomes lead to continuation, collapsing it into a single check preserves the flow and behavior."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "At the same time, two steps need to be completed: preparing the assembling order and checking availability."
      ],
      "justification": "Directly captures the two required steps. The concurrency phrasing does not alter the requirement that both actions must be performed."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If there is a backorder"
      ],
      "justification": "Opens the XOR decision point and sets up the positive guard for the backorder condition."
    },
    {
      "refs": [
        "action:n7",
        "action:n8"
      ],
      "verbatim_texts": [
        "availability needs to be checked again and the process ends."
      ],
      "justification": "Captures the re-check step, the explicit termination action, and the structural end node for the backorder path."
    },
    {
      "refs": [
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "If the item can be reserved, the process should continue."
      ],
      "justification": "Models the alternative path ('not backorder' / 'can be reserved') as the negative guard leading to continuation. Decision logic is preserved."
    },
    {
      "refs": [
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "The next steps are to assemble the bike and then ship the product."
      ],
      "justification": "Directly matches the final sequential steps and terminates the second process path correctly."
    }
