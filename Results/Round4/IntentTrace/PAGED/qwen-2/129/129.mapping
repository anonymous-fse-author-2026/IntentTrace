      "verbatim_texts": [
        "At the start, the loan application is checked."
      ],
      "justification": "Initiates the process and models the initial verification step. 'start' is harmless structural padding that does not change behaviour."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the application is rejected, the process ends."
      ],
      "justification": "Correctly introduces the decision point after the check, follows the rejection path, and terminates the process. The guard uses an abstracted variable but routes correctly to the specified outcome."
    },
    {
      "refs": [
        "guard:b1->b2",
        "action:b2"
      ],
      "verbatim_texts": [
        "However, if special terms are agreed upon, the process continues."
      ],
      "justification": "Models the alternative continuation path. The condition is captured via a guard and a correspondingly named action step, which preserves the intended flow."
    },
    {
      "refs": [
        "action:n6",
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the funds are disbursed, the process ends."
      ],
      "justification": "Accurately captures the fund disbursement step followed by a dedicated termination action and end node."
    }
  ],
