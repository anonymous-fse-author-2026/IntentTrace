{
  "matches": [
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Passengers should start the process by undergoing immigration checks,"
      ],
      "justification": "The init node implicitly begins the process, and the action directly implements the first step described in i1."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "and then they should select the method for exit control checks."
      ],
      "justification": "Direct paraphrase of the selection step in i2."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the passenger chooses to use biometrics, they should undergo a check using biometrics."
      ],
      "justification": "Captures the XOR decision split and the biometrics path accurately."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the passenger prefers to use ID documents, they should undergo checks using identity documents."
      ],
      "justification": "Captures the alternative ID documents path accurately."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission, they should leave the area."
      ],
      "justification": "Models the second decision point and the denied branch leading to leaving the area."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step."
      ],
      "justification": "Models the allowed branch leading to proceeding to the next step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends."
      ],
      "justification": "Explicitly models the termination clause stated in i7. Behaviour is preserved."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Explicitly models the termination clause stated in i8. Behaviour is preserved."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "After the exit control checks, if the passenger is denied permission, they should leave the area.",
        "On the other hand, if the passenger is allowed to continue, they should proceed to the next step.",
        "If the exit control check outcome is unsuccessful, the passenger should leave the area and the process ends.",
        "Conversely, if the outcome is successful, the passenger should continue to the next step and the process ends."
      ],
      "justification": "Structural join node that recombines the split flows described across i5-i8 before process termination."
    }
  ],
