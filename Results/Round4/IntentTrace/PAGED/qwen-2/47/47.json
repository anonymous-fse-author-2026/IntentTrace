  "input_elements": [
    {
      "id": "i1",
      "content": "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
    },
    {
      "id": "i2",
      "content": "If the invoice is incomplete, it is returned."
    },
    {
      "id": "i3",
      "content": "However, if the invoice is complete, the process continues."
    },
    {
      "id": "i4",
      "content": "If the invoice is non-compliant, further checks are conducted."
    },
    {
      "id": "i5",
      "content": "On the other hand, if the invoice is compliant, the process continues."
    },
    {
      "id": "i6",
      "content": "If the issue can be resolved with a phone call, non-compliance is resolved."
    },
    {
      "id": "i7",
      "content": "But if the issue requires mail back, the invoice is returned."
    },
    {
      "id": "i9",
      "content": "After that, the invoice is paid and if it is returned, non-compliance is resolved."
    },
    {
      "id": "i10",
      "content": "Simultaneously, the following steps are completed: Bill Client."
    },
    {
      "id": "i11",
      "content": "If there is no response, a period of 10 days is given."
    },
    {
      "id": "i12",
      "content": "If the invoice is returned, non-compliance is resolved."
    },
    {
      "id": "i13",
      "content": "The invoice is paid and the client is notified of the payment."
    },
    {
      "id": "i14",
      "content": "After 10 days, a reminder is sent and the process ends."
    },
    {
      "id": "i15",
      "content": "If the client is unsatisfied, payment discrepancy is resolved."
    },
    {
      "id": "i16",
      "content": "However, if the client is satisfied, the process continues."
    }
  ]
}