{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts with Bill for Purchased Goods/Services and then Receive Invoice."
      ],
      "justification": "Process start node and the two initial actions are captured directly from the opening segment."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Negative branch correctly routes to returning the invoice. Abstract guard value preserves the decision split."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "However, if the invoice is complete, the process continues."
      ],
      "justification": "Positive branch advances the flow to the subsequent compliance evaluation."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant, further checks are conducted."
      ],
      "justification": "Non-compliant path correctly triggers the additional checks described."
    },
    {
      "refs": [
        "guard:b2->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "On the other hand, if the invoice is compliant, the process continues."
      ],
      "justification": "Compliant path correctly bypasses checks and proceeds."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Phone resolution branch matches the source condition and outcome."
    },
    {
      "refs": [
        "guard:b3->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "But if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Mail-back branch returns the invoice; convergence node rejoins the parallel/alternative flows."
    },
    {
      "refs": [
        "action:n18",
        "guard:b4->n23",
        "action:n23"
      ],
      "verbatim_texts": [
        "After that, the invoice is paid and if it is returned, non-compliance is resolved."
      ],
      "justification": "Paying the invoice and conditionally resolving non-compliance are both captured. Modeling the compound sentence as sequential nodes preserves behaviour."
    },
    {
      "refs": [
        "guard:b4->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If there is no response, a period of 10 days is given."
      ],
      "justification": "Alternative branch from the previous decision correctly implements the 10-day wait period."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Simultaneously, the following steps are completed: Bill Client."
      ],
      "justification": "Billing step is captured. Its placement in the linear model representation does not change its required execution."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "If the invoice is returned, non-compliance is resolved."
      ],
      "justification": "Redundant restatement of the same resolution step found earlier in the text. Redundancy does not alter behaviour, so it remains a match."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Flows converge before the notification step, matching the source sequence."
    },
    {
      "refs": [
        "guard:b5->n28",
        "action:n28"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Unsatisfied path correctly branches to resolve the payment discrepancy."
    },
    {
      "refs": [
        "guard:b5->n29",
        "action:n29"
      ],
      "verbatim_texts": [
        "However, if the client is satisfied, the process continues."
      ],
      "justification": "Satisfied path continues execution as specified; convergence follows the split."
    },
    {
      "refs": [
        "action:n25",
        "action:n26"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Final reminder sending and process termination steps are accurately modeled."
    }
  ],
