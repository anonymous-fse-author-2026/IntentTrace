  "input_elements": [
    {
      "id": "i1",
      "content": "To begin the process, start by placing an order and then check the customer."
    },
    {
      "id": "i2",
      "content": "If the customer is \"not eligible to order\", inform them."
    },
    {
      "id": "i3",
      "content": "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
    },
    {
      "id": "i4",
      "content": "After informing the customer, the process ends."
    },
    {
      "id": "i5",
      "content": "Open a new order in the ERP system and perform an availability check."
    },
    {
      "id": "i6",
      "content": "Check if the product is \"available\". If it is not, start producing the missing parts."
    },
    {
      "id": "i7",
      "content": "Otherwise, continue the process. Prepare the products for shipment."
    },
    {
      "id": "i8",
      "content": "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
    },
    {
      "id": "i9",
      "content": "If the payment is received, close the order."
    },
    {
      "id": "i10",
      "content": "If the payment is not received, send a reminder."
    },
    {
      "id": "i11",
      "content": "If the number of reminders is less than 3, continue the process."
    },
    {
      "id": "i12",
      "content": "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
    }
  ]
