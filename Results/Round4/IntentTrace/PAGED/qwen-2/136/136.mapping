{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin the process, start by placing an order and then check the customer."
      ],
      "justification": "Captures the process start, initial order placement, and customer check step."
    },
    {
      "refs": [
        "guard:b1->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the customer is \"not eligible to order\", inform them."
      ],
      "justification": "Correctly models the eligibility decision gate and the negative branch action."
    },
    {
      "refs": [
        "end:e1"
      ],
      "verbatim_texts": [
        "After informing the customer, the process ends."
      ],
      "justification": "Explicit termination after the negative eligibility branch."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "Otherwise, if the customer is \"eligible to order\", open a new order in the ERP system."
      ],
      "justification": "Positive eligibility branch correctly guards the ERP order creation."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "Open a new order in the ERP system and perform an availability check."
      ],
      "justification": "Covers the subsequent availability check step following ERP order creation."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "Check if the product is \"available\". If it is not, start producing the missing parts."
      ],
      "justification": "Models the availability check decision and the production trigger for unavailable items."
    },
    {
      "refs": [
        "guard:b2->c2",
        "action:n8"
      ],
      "verbatim_texts": [
        "Otherwise, continue the process. Prepare the products for shipment."
      ],
      "justification": "Handles the available path, convergence, and preparation step."
    },
    {
      "refs": [
        "action:n10",
        "action:n11",
        "action:n12"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: ship the products and send the invoice while checking for payment."
      ],
      "justification": "AND gateway correctly splits the three concurrent steps and converges them afterward."
    },
    {
      "refs": [
        "guard:b3->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the payment is received, close the order."
      ],
      "justification": "Payment received branch correctly closes the order and terminates this flow path."
    },
    {
      "refs": [
        "guard:b3->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "If the payment is not received, send a reminder."
      ],
      "justification": "Payment not received branch correctly triggers the reminder action."
    },
    {
      "refs": [
        "guard:b4->c2"
      ],
      "verbatim_texts": [
        "If the number of reminders is less than 3, continue the process."
      ],
      "justification": "Loop-back condition correctly routes back when reminders are below threshold."
    },
    {
      "refs": [
        "guard:b4->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "Otherwise, if the number of reminders is equal to 3, inform the lawyer and end the process."
      ],
      "justification": "Threshold met branch correctly triggers lawyer notification and final termination."
    }
  ],
