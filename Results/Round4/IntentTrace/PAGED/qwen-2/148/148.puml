start
:wake up;
:v1: are you hungry? ({hungry, not hungry}); <<objectSignal>>
if () then ([v1 = 'not hungry'])
:take a shower (A);
else ([v1 = 'hungry'])
:have breakfast (A);
endif
:v2: still not hungry after first action? ({hungry, not hungry}); <<objectSignal>>
if () then ([v2 = 'not hungry'])
:take a shower (B);
else ([v2 = 'hungry'])
:have breakfast (B);
endif
:get on the bus and complete process;
