  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2",
        "action:n3"
      ],
      "verbatim_texts": [
        "To start the process, make sure the Freights are ready to be shipped and then ship the freight."
      ],
      "justification": "Captures the process start and the initial sequential shipping steps."
    },
    {
      "refs": [
        "action:n4",
        "action:n5"
      ],
      "verbatim_texts": [
        "At the same time, complete the following steps: deliver the freight and notify the delivery."
      ],
      "justification": "Maps to the two concurrent/follow-up delivery and notification steps."
    },
    {
      "refs": [
        "guard:b1->b2",
        "guard:b1->n16"
      ],
      "verbatim_texts": [
        "If the request for merchandise return is lodged, continue with the process."
      ],
      "justification": "Models the first decision point. Abstract guard values (v1) correctly preserve the yes/no branching logic described in the condition."
    },
    {
      "refs": [
        "guard:b2->n8",
        "guard:b2->b3",
        "action:n8"
      ],
      "verbatim_texts": [
        "If it has been 5 days, invoice the customer."
      ],
      "justification": "Captures the second decision and its positive outcome action. Abstract v2 preserves the temporal condition."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the process ends with the customer being invoiced."
      ],
      "justification": "Explicitly models the termination state following invoicing."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If the return is accepted, proceed with accepting the merchandise return."
      ],
      "justification": "Third decision point and the guard for the accepted path."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "If the return is rejected, reject the merchandise return."
      ],
      "justification": "Guard for the rejected path at the third decision point."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If the return is accepted, proceed with accepting the merchandise return."
      ],
      "justification": "Action taken on the accepted branch."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Return the merchandise"
      ],
      "justification": "Direct step on the accepted path."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "the process ends with the merchandise being returned."
      ],
      "justification": "Termination state for the return completion path."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If the return is rejected, reject the merchandise return."
      ],
      "justification": "Action taken on the rejected branch."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "the process ends with the merchandise return request being rejected."
      ],
      "justification": "Termination state for the rejection path."
    },
    {
      "refs": [
        "action:n16",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If a loss claim report is lodged, approve the loss claim and the process ends."
      ],
      "justification": "Condition modeled as an action step (n16), followed by approval and termination. Re-typing a condition as an action preserves behaviour per relaxed rules."
    }
  ],
