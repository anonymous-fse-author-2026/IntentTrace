@startuml
!theme plain
|a_default| Default
|a_default|
start
:identify the parts;
:v1: process branch condition ({CheckAvailability, ProceedDirectly, OrderAndReceive, SuppliedToCustomer}); <<objectSignal>>
switch ()
case ([v1 = 'CheckAvailability'])
:check availability of parts;
case ([v1 = 'ProceedDirectly'])
:they can proceed with the process;
case ([v1 = 'OrderAndReceive'])
:order and receive part from Disuki;
:contract the customer;
case ([v1 = 'SuppliedToCustomer'])
:parts supplied to customer;
:the team can also continue with the process;
endswitch
:proceed with payment;
:end process;
stop
@enduml