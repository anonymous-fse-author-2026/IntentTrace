{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Covers process initialization and the first explicit user action."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000"
      ],
      "justification": "Models the decision split and the positive guard for the high-expense case."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "the report should be reviewed"
      ],
      "justification": "Direct correspondence to the review step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000"
      ],
      "justification": "Captures the negative guard for the threshold decision."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "you should proceed to check if there is a need for translation"
      ],
      "justification": "Condition modeled as an action step still preserves the checking behaviour."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "If translation is required"
      ],
      "justification": "Opens the translation decision and captures the required/true branch."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "proceed to translate the receipts"
      ],
      "justification": "Direct match for the translation action."
    },
    {
      "refs": [
        "guard:b2->n6"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Captures the false branch of the translation decision."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "confirm the receipts"
      ],
      "justification": "Direct match for the confirmation action."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Joins parallel paths and initiates the first review evaluation and its subsequent split."
    },
    {
      "refs": [
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "If the report is rejected"
      ],
      "justification": "Captures the rejection condition on the first review."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report.",
        "edit the report."
      ],
      "justification": "Maps the rejection outcome to the corresponding edit action across both source fragments."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Captures the approval condition on the first review."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "continue to check if there is a need for translation."
      ],
      "justification": "Direct match for the loop-back/re-check step."
    },
    {
      "refs": [
        "action:n11",
        "guard:b4->n12",
        "guard:b4->n13"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Models the second review evaluation and its two outgoing decision guards."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "translate the receipts and then confirm them."
      ],
      "justification": "Splits the combined source step into two sequential actions, preserving behaviour."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision."
      ],
      "justification": "Initiates the final receipt evaluation and its subsequent split."
    },
    {
      "refs": [
        "guard:b5->n16"
      ],
      "verbatim_texts": [
        "If the receipts are accepted, proceed to process the expense."
      ],
      "justification": "Captures the acceptance condition and leads to processing."
    },
    {
      "refs": [
        "guard:b5->n17",
        "action:n17"
      ],
      "verbatim_texts": [
        "If they are rejected, edit the report."
      ],
      "justification": "Captures the rejection condition and the corresponding edit action."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Matches the expense processing step described as the final action before termination."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Matches the explicit process termination step."
    }
