{
  "matches": [
    {
      "refs": [
        "action:i1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process, begin by clicking on \"Start\" and then selecting \"Edit Report\"."
      ],
      "justification": "Process initiation and first action align directly with the opening instruction."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "If the expense is greater than 1000, the report should be reviewed."
      ],
      "justification": "XOR split and positive guard lead to reviewing the report, preserving the high-expense path."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "However, if the expense is less than or equal to 1000, you should proceed to check if there is a need for translation."
      ],
      "justification": "Negative guard and subsequent action capture the low-expense translation check path."
    },
    {
      "refs": [
        "guard:b2->n7",
        "action:n7"
      ],
      "verbatim_texts": [
        "If translation is required, proceed to translate the receipts."
      ],
      "justification": "Decision gateway and positive guard direct flow to translating receipts."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If not, confirm the receipts."
      ],
      "justification": "Negative guard and action handle the case where translation is not needed."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "After this, evaluate the review decision."
      ],
      "justification": "Direct match for the review evaluation step."
    },
    {
      "refs": [
        "guard:b3->c3",
        "guard:b3->n11",
        "action:n10",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report. If it is approved, continue to check if there is a need for translation."
      ],
      "justification": "Branches correctly route rejection to editing and approval to re-checking translation need."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision."
      ],
      "justification": "Exact textual match for the second review evaluation."
    },
    {
      "refs": [
        "guard:b4->c3",
        "guard:b4->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the report is rejected, edit the report. If it is approved, translate the receipts and then confirm them."
      ],
      "justification": "Second review decision correctly branches to editing on rejection, and translating then confirming on approval."
    },
    {
      "refs": [
        "action:n14",
        "guard:b5->n15",
        "guard:b5->n16",
        "action:n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Finally, evaluate the receipts decision. If the receipts are accepted, proceed to process the expense. If they are rejected, edit the report."
      ],
      "justification": "Final evaluation and branching accurately reflect acceptance leading to processing and rejection leading to editing."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "The process ends by processing the expense and then ending it."
      ],
      "justification": "Termination steps and structural convergence nodes align with the final process conclusion."
    }
  ],
