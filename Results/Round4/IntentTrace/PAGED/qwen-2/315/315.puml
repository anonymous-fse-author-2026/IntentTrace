@startuml
!theme plain
|a_default| Default
|a_default|
start
:make appointment at hairdresser's;
:go to hairdresser;
:v1: need hair washed? ({Yes, No})
v2: want hair dyed? ({Yes, No})
v3: need haircut? ({Yes, No}); <<objectSignal>>
fork
if () then ([v1 = 'Yes'])
:need hair washed?;
endif
fork again
if () then ([v2 = 'Yes'])
:want hair dyed?;
endif
fork again
if () then ([v3 = 'Yes'])
:need haircut?;
endif
end fork
-> pay hairdresser;
:end process;
stop
@enduml