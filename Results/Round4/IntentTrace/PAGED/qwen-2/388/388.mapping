    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "click on the Submit button"
      ],
      "justification": "Direct match for the submission step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "check if the option to submit is set to \"false\""
      ],
      "justification": "The conditional check is modeled as an action followed by a branching gateway, preserving behaviour."
    },
    {
      "refs": [
        "guard:b1->n6",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is, then apply another filter."
      ],
      "justification": "Guard captures the condition leading to the re-application action."
    },
    {
      "refs": [
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the option to submit is set to \"true\", then continue with the process."
      ],
      "justification": "Guard captures the alternative path when the option is true."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "check if there is another filter to apply."
      ],
      "justification": "Conditional check modeled as action plus branch gateway."
    },
    {
      "refs": [
        "guard:b2->c2"
      ],
      "verbatim_texts": [
        "If there is, continue with the process."
      ],
      "justification": "Positive branch condition directing flow to convergence."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If not, continue with the process."
      ],
      "justification": "Negative branch condition directing flow to the next check."
    },
    {
      "refs": [
        "action:n8",
        "action:n10"
      ],
      "verbatim_texts": [
        "Finally, if the option to submit is set to \"true\", continue with the process."
      ],
      "justification": "Models the final conditional check and continuation. Convergence and end node structurally complete the process flow as described."
    }
