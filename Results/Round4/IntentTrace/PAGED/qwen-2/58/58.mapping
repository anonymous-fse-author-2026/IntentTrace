{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process, we first prioritize orders based on when they were received."
      ],
      "justification": "The init node implicitly marks the start, and action:n1 directly paraphrases the prioritization step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Then, we proceed to check the customer's information."
      ],
      "justification": "Direct correspondence to the second process step."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the customer exists"
      ],
      "justification": "Opens the XOR decision and captures the positive condition using a standard guard abstraction."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "we move on to checking their payment history"
      ],
      "justification": "Captures the action taken when the condition is met."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if the customer does not exist"
      ],
      "justification": "Captures the negative branch condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "we need to verify their customer status"
      ],
      "justification": "Captures the alternative action for non-existing customers."
    },
    {
      "refs": [
        "guard:b3->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the customer is a private customer, we send them a declining message."
      ],
      "justification": "Models the customer-type split and the private customer outcome accurately."
    },
    {
      "refs": [
        "guard:b3->n9",
        "action:n9",
        "action:n10"
      ],
      "verbatim_texts": [
        "In the case of a wholesaler, we create a new customer and check for product availability."
      ],
      "justification": "Models the wholesaler branch. The source compound action is cleanly split into two equivalent steps, preserving behaviour."
    },
    {
      "refs": [
        "guard:b4->n12",
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "If the products are not available, we produce the missing goods and send a decline message, thus ending the process."
      ],
      "justification": "Correctly models the unavailability branch, the required actions, and the explicit process termination."
    },
    {
      "refs": [
        "guard:b4->n14",
        "action:n14"
      ],
      "verbatim_texts": [
        "If the products are available, we continue with the process and send an order confirmation."
      ],
      "justification": "Models the availability branch, continuation, confirmation, and flow convergence."
    },
    {
      "refs": [
        "guard:b_mid->n15",
        "action:n15"
      ],
      "verbatim_texts": [
        "Simultaneously, we inform the stock and accounting departments."
      ],
      "justification": "Uses a branch/converge pattern to model the simultaneous notification, a standard and behaviour-preserving structural choice."
    },
    {
      "refs": [
        "guard:b_mid->n17",
        "action:n17",
        "action:n18",
        "action:n19"
      ],
      "verbatim_texts": [
        "After packing the goods and writing the invoice, the goods are ready for delivery and the invoice is sent."
      ],
      "justification": "Breaks down the packing/invoicing sequence into discrete steps and models readiness as a state/action, preserving the workflow."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "Once the order is closed, we deliver the goods and invoice to the customer."
      ],
      "justification": "Directly corresponds to the delivery step."
    },
    {
      "refs": [
        "guard:b5->n24",
        "action:n24"
      ],
      "verbatim_texts": [
        "However, if there is an outstanding payment, we check the quantity of reminders."
      ],
      "justification": "Correctly models the outstanding payment condition and the subsequent reminder check."
    },
    {
      "refs": [
        "guard:b5->c_close",
        "action:n23"
      ],
      "verbatim_texts": [
        "If payment has been received, we close the order."
      ],
      "justification": "Models the received-payment path, flow convergence, and the order-closing action."
    },
    {
      "refs": [
        "guard:b6->n26",
        "action:n26"
      ],
      "verbatim_texts": [
        "If there are less than three reminders, we continue with the process."
      ],
      "justification": "Accurately captures the threshold condition (<3) and the continuation outcome."
    },
    {
      "refs": [
        "guard:b6->n27",
        "action:n27",
        "action:n28"
      ],
      "verbatim_texts": [
        "On the other hand, if there are more than three reminders, we activate the donning process, thus ending the process."
      ],
      "justification": "Correctly models the >3 reminder threshold, the activation step, explicit termination, and structural end nodes."
    }
  ],
