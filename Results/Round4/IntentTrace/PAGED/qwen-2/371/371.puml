@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start ExpenseReport process;
:select Edit Report;
:v1: expense greater than 1000? ({Yes, No}); <<objectSignal>>
if () then ([v1 = 'Yes'])
:review report;
else ([v1 = 'No'])
:check if translation required;
:v3: translation required? ({Yes, No}); <<objectSignal>>
if () then ([v3 = 'Yes'])
:translate receipts;
else ([v3 = 'No'])
:confirm receipts;
endif
endif
repeat :;
:evaluate review decision;
:v2: review decision ({Rejected, Approved}); <<objectSignal>>
backward:edit report;
repeat while () is ([v2 = 'Rejected']) not ([v2 = 'Approved'])
:continue to check translation;
repeat :;
:evaluate review decision again;
:v4: evaluate review decision ({Rejected, Approved}); <<objectSignal>>
backward:edit report;
repeat while () is ([v4 = 'Rejected']) not ([v4 = 'Approved'])
:translate and confirm receipts;
repeat :;
:evaluate receipts decision;
:v5: evaluate receipts decision ({Accepted, Rejected}); <<objectSignal>>
backward:edit report;
repeat while () is ([v5 = 'Rejected']) not ([v5 = 'Accepted'])
:process expense;
:End process;
stop
@enduml