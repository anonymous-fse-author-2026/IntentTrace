{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle and then Check Levels of Inventory."
      ],
      "justification": "The opening span implicitly starts the process and describes the first two sequential actions. Structural init and two action nodes faithfully capture this."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "Defines the XOR decision point and its positive guard. The boolean variable abstraction (v1 = true) preserves the branching logic without changing behaviour."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report."
      ],
      "justification": "Direct paraphrase of the action on the 'below/equal' branch."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report."
      ],
      "justification": "Captures the complementary branch guard (v1 = false) and the corresponding action. Behaviour is preserved."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Models the termination path for the 'above minimum' case. Action and end node correctly reflect the early exit."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)."
      ],
      "justification": "Paraphrases the action triggered when inventory is low. The conditional context is handled by the upstream flow, preserving behaviour."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the PO is created, it needs to be reviewed."
      ],
      "justification": "Direct match to the review step following PO creation."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected, it needs to be reworked."
      ],
      "justification": "Maps the rejection branch and rework action. Boolean guard (v2 = false) correctly represents the rejection path."
    },
    {
      "refs": [
        "guard:b2->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the PO is approved, it is printed and released in the system."
      ],
      "justification": "Maps the approval branch and print/release action. Boolean guard (v2 = true) correctly represents the approval path."
    },
    {
      "refs": [
        "action:n12",
        "action:n13"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs and mail the POs to the supplier."
      ],
      "justification": "The AND gateway models the simultaneous execution. Two actions and two converge nodes capture the parallel split and implicit rejoin, preserving the concurrent behaviour."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "If funds are reserved for the released POs, receive the Packing Slip."
      ],
      "justification": "Direct match to the packing slip receipt step."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "If the POs are mailed to the supplier, receive the inventory."
      ],
      "justification": "Direct match to the inventory receipt step."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "If the Packing Slip is received, proceed to receive the Invoice."
      ],
      "justification": "Direct match to the invoice receipt step."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "If the Invoice is received, proceed to the Three-way match."
      ],
      "justification": "Split into two equivalent steps ('proceed' and 'perform') that together preserve the original behaviour without adding or removing logic."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the Three-way match is successful, release the funds."
      ],
      "justification": "Direct paraphrase capturing the conditional fund release."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Once the funds are released, issue the payment."
      ],
      "justification": "Direct match to the final payment issuance step."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "After the payment is issued, the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Action and end node faithfully model the completion and termination of the cycle."
    }
  ],
