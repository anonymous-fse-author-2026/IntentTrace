{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO, start by placing an Order"
      ],
      "justification": "Start node and initial action correspond to the opening instruction."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "then proceed to Check the Customer's Credit Limit."
      ],
      "justification": "Direct match for the credit limit check step."
    },
    {
      "refs": [
        "guard:b1->n4",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the response is \"Okay\", proceed to Check the Availability of the Article."
      ],
      "justification": "Models the positive credit check outcome, branching gateway, guard condition, and subsequent availability check."
    },
    {
      "refs": [
        "guard:b1->n5",
        "action:n5"
      ],
      "verbatim_texts": [
        "if the response is \"No\", send a Denial to the Customer."
      ],
      "justification": "Models the negative credit check outcome, guard condition, and denial action."
    },
    {
      "refs": [
        "guard:b_art->n10",
        "action:n10"
      ],
      "verbatim_texts": [
        "If the Article is not available, proceed to Produce the Goods."
      ],
      "justification": "Models the unavailability decision, guard condition, and production step."
    },
    {
      "refs": [
        "guard:b_art->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "However, if the Article is available, proceed to Collect the Goods."
      ],
      "justification": "Models the availability decision guard and collection step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "After checking the availability of the Article, send an Order Confirmation."
      ],
      "justification": "Convergence after article check branches followed by confirmation step."
    },
    {
      "refs": [
        "action:n13",
        "action:n14"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps: Ship the Goods and Send the Invoice."
      ],
      "justification": "AND-split gateway, two parallel actions, and convergence match the simultaneous execution requirement."
    },
    {
      "refs": [
        "action:n15",
        "guard:b_pay->n16"
      ],
      "verbatim_texts": [
        "Check the Payment status."
      ],
      "justification": "Payment check action, branching gateway, and guard for the unpaid path leading to the reminder check."
    },
    {
      "refs": [
        "guard:b_pay->n17",
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "close the Order and end the process."
      ],
      "justification": "Guard for received payment and the corresponding close/end actions."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "check if the Reminder count is greater than or equal to 3."
      ],
      "justification": "Direct match for the reminder count check action."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "If the Reminder count is greater than or equal to 3, Write off the Order."
      ],
      "justification": "Matches the write-off action triggered by the count threshold."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Additionally, send a Reminder."
      ],
      "justification": "Direct match for sending a reminder."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "After writing off the Order, close the Order and end the process."
      ],
      "justification": "Final close action and process termination node."
    }
  ],
