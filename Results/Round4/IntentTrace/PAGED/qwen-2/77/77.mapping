{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start,"
      ],
      "justification": "Opening phrase implicitly triggers process start and describes the initial step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "join the team and agree on the team's domain."
      ],
      "justification": "Direct paraphrase of the first mandatory task."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Once that is done, create a process model and check it."
      ],
      "justification": "Direct match for model creation and verification step."
    },
    {
      "refs": [
        "guard:b1->n5",
        "guard:b1->c1",
        "action:n4"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\""
      ],
      "justification": "Condition modeled as action plus branch/guards preserves the decision logic."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then assign negative points."
      ],
      "justification": "Outcome of the negative condition directly mapped."
    },
    {
      "refs": [
        "guard:b2->n7",
        "guard:b2->c1",
        "action:n6"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\""
      ],
      "justification": "Second quality check condition correctly captured with supporting branch and guards."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "assign negative points again."
      ],
      "justification": "Repeated penalty action directly mapped."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "However, if the process is okay, you can continue with it."
      ],
      "justification": "Positive path continuation captured as an action step; harmless re-typing."
    },
    {
      "refs": [
        "action:n10",
        "guard:b3->n11",
        "guard:b3->n12"
      ],
      "verbatim_texts": [
        "If there are any issues,"
      ],
      "justification": "Issue detection condition and branching logic aligned with source."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "fix them in the next session and extend the process to levels 2 and 3."
      ],
      "justification": "Remediation steps directly mapped."
    },
    {
      "refs": [
        "action:n12",
        "guard:b4->n13",
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points,"
      ],
      "justification": "Conditional check and subsequent branching properly modeled."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Continuation action directly mapped."
    },
    {
      "refs": [
        "action:n14",
        "guard:b5->n15",
        "guard:b5->n16"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study,"
      ],
      "justification": "Field analysis condition and branching matched."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "assign roles in the team."
      ],
      "justification": "Role assignment action directly mapped."
    },
    {
      "refs": [
        "action:n16",
        "guard:b6->n17",
        "guard:b6->c4"
      ],
      "verbatim_texts": [
        "If the process is okay,"
      ],
      "justification": "Process approval condition and branching correctly captured."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "continue with the process and perform work according to your assigned role."
      ],
      "justification": "Continuation and role-based work split into two actions; behaviour preserved."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise."
      ],
      "justification": "Direct match for progress monitoring step."
    },
    {
      "refs": [
        "action:n20",
        "guard:b7->n21"
      ],
      "verbatim_texts": [
        "If the project is accepted,"
      ],
      "justification": "Project acceptance condition and branching correctly captured."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "present it."
      ],
      "justification": "Presentation action directly mapped."
    },
    {
      "refs": [
        "guard:b7->n22",
        "action:n22"
      ],
      "verbatim_texts": [
        "If not, continue working according to your role."
      ],
      "justification": "Negative acceptance branch and fallback continuation correctly modeled."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "present it again."
      ],
      "justification": "Direct match for the second presentation requirement."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Final presentation and process termination accurately modeled."
    }
  ],
