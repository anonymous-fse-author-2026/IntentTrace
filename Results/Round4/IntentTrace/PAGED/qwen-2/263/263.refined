end(e4)
branch(b4, AND)
defines(v1, "Meeting_successful", {true, false})
defines(v2, "Approval_successful", {true, false})
defines(v3, "Rebuild_approved", {true, false})
actor(a_default, "Default", [i1, n1, n_mt, n2, b1, n3, n4, e1, n5, n6, b4, c1, n7, n8, n9, n10, n11, b2, n12, e2, n13, b3, n15, e3, n16, n17, e4])
