    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study"
      ],
      "justification": "Condition modeled as an action step preserves behaviour."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "If you need to analyze the field of study, assign roles in the team."
      ],
      "justification": "Action step captured directly."
