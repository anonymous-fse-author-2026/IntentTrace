{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "the process begins by receiving the invoice"
      ],
      "justification": "Initiates the process and describes the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "it is sorted per client"
      ],
      "justification": "Direct match for sorting per client."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "it is then sorted per vendor"
      ],
      "justification": "Direct match for sorting per vendor."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "attach the invoice entry form to the invoice"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the required information is entered onto the form"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the completeness of the invoice is checked"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n8",
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "If the invoice is not complete, the process ends."
      ],
      "justification": "Captures the negative branch condition and the resulting end state."
    },
    {
      "refs": [
        "action:n7",
        "guard:b1->n7",
        "action:n9"
      ],
      "verbatim_texts": [
        "If it is complete, the information for the SLA is entered."
      ],
      "justification": "Captures the positive branch condition and the action taken."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "The date for completion is also entered"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the priority is checked"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n12",
        "guard:b2->n12"
      ],
      "verbatim_texts": [
        "If the priority is high"
      ],
      "justification": "Captures the high priority branch."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "a red stamp is placed on the entry invoice"
      ],
      "justification": "Direct match for the action in the high priority branch."
    },
    {
      "refs": [
        "action:n13",
        "guard:b2->n13"
      ],
      "verbatim_texts": [
        "If it is low, the process continues."
      ],
      "justification": "Captures the low priority branch and the convergence point."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "The invoice compliance is then checked"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n17",
        "guard:b3->n17"
      ],
      "verbatim_texts": [
        "If it is not complete, the check continues."
      ],
      "justification": "Captures the negative compliance branch condition."
    },
    {
      "refs": [
        "action:n18",
        "guard:b3->n18"
      ],
      "verbatim_texts": [
        "If it is complete, the process continues."
      ],
      "justification": "Captures the positive compliance branch condition."
    },
    {
      "refs": [
        "action:n20",
        "guard:b4->n20"
      ],
      "verbatim_texts": [
        "If the invoice needs to be sent to experienced staff"
      ],
      "justification": "Captures the experienced staff branch condition."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "the non-compliance invoice is processed"
      ],
      "justification": "Direct match for the experienced staff action."
    },
    {
      "refs": [
        "action:n21",
        "guard:b4->n21"
      ],
      "verbatim_texts": [
        "If it is a normal case"
      ],
      "justification": "Captures the normal case branch condition."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "the client is called"
      ],
      "justification": "Direct match for the normal case action."
    },
    {
      "refs": [
        "action:n24",
        "guard:b4->n24"
      ],
      "verbatim_texts": [
        "If none of these conditions apply"
      ],
      "justification": "Captures the fallback branch condition."
    },
    {
      "refs": [
        "action:n25"
      ],
      "verbatim_texts": [
        "a postal mail is sent requesting complete information and the process ends"
      ],
      "justification": "Captures the action and process end for the fallback branch."
    },
    {
      "refs": [
        "action:n26"
      ],
      "verbatim_texts": [
        "Finally, the client is called and information is requested."
      ],
      "justification": "Captures the convergence and the subsequent action."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "The invoice is then batched and allocated to DEO"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Captures the final end state of the process."
    }
  ],
