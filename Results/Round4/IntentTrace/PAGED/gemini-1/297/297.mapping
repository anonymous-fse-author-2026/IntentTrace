  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "start the process"
      ],
      "justification": "Starts the process and captures the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "empty the mailbox"
      ],
      "justification": "Direct match to the action of emptying the mailbox."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty"
      ],
      "justification": "Captures the decision check and opens the corresponding XOR branch."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "if not"
      ],
      "justification": "Negative arm of the mailbox check."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "continue the process"
      ],
      "justification": "Matches the action on the negative arm."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If it is empty"
      ],
      "justification": "Positive arm of the mailbox check."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Terminates the process for the positive arm."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->e2",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "Check if the mailbox is empty again"
      ],
      "justification": "Source text segmentation missed the outcomes for this second check, but these elements faithfully reproduce the explicit logic from the raw text ('if not, continue... If it is empty, the process ends')."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Verify if the information is complete."
      ],
      "justification": "Captures the completeness check and its corresponding branch."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "If it is complete"
      ],
      "justification": "Positive arm of the information check."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "add the incoming mail number, date, and record it in the letter book"
      ],
      "justification": "Matches the action on the positive arm."
    },
    {
      "refs": [
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "If it is not complete"
      ],
      "justification": "Negative arm of the information check."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "make a telephone call to the sender"
      ],
      "justification": "Matches the action on the negative arm."
    },
    {
      "refs": [
        "label:n11->n12"
      ],
      "verbatim_texts": [
        "After the telephone call"
      ],
      "justification": "Faithfully captures the timing constraint as a label."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "complete the data by adding the incoming mail number, date, and record it in the letter book"
      ],
      "justification": "Follow-up action after the call, implicitly rejoining the main flow."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Every Wednesday evening, take the letter book and member register to Miranda"
      ],
      "justification": "Direct match for the periodic action."
    },
    {
      "refs": [
        "guard:b4->n14"
      ],
      "verbatim_texts": [
        "If the applicant becomes a member"
      ],
      "justification": "Opens the branch for the membership outcome."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "applicant becomes a member"
      ],
      "justification": "Redundant action restating the condition, preserving behavior."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "stamp \"new Member\" on the letter and write the date on it"
      ],
      "justification": "Direct match for the stamping action."
    },
    {
      "refs": [
        "guard:b4->n23"
      ],
      "verbatim_texts": [
        "If the applicant cannot become a member"
      ],
      "justification": "Negative arm of the membership decision."
    },
    {
      "refs": [
        "action:n23"
      ],
      "verbatim_texts": [
        "applicant cannot become a member"
      ],
      "justification": "Redundant action restating the negative condition."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
        "write to them and inform them of the decision"
      ],
      "justification": "Matches the action and implied process end for the rejected path."
    },
    {
      "refs": [
        "label:n15->n16"
      ],
      "verbatim_texts": [
        "After stamping \"new Member\" on the letter and writing the date on it"
