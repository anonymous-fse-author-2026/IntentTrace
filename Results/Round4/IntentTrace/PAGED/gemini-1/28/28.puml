@startuml
!theme plain
|a_default| Default
|a_default|
start
:start the drop-off tech process;
:inform customer about canceling the order;
:has the order already been fulfilled;
:v1: has the order already been fulfilled ({Yes, No, Bag returned, Bag not returned}); <<objectSignal>>
switch ()
case ([v1 = 'Yes'])
:mark bag as returned in IS;
:script bag is returned;
case ([v1 = 'No'])
:mark script(s) as declined by the customer in IS;
:script order is declined;
case ([v1 = 'Bag returned'])
:it is marked as such in IS;
case ([v1 = 'Bag not returned'])
:mark script(s) as declined by the customer in IS;
endswitch
:process customer notification;
:process completed;
stop
@enduml