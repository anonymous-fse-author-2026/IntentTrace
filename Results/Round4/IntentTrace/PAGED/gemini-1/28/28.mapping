      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To initiate the Drop-off tech process"
      ],
      "justification": "The initial element and action correctly capture the start of the process."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "the customer is first informed about canceling the order"
      ],
      "justification": "Direct match to the step of informing the customer."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "has the order already been fulfilled?"
      ],
      "justification": "Captures the decision question as an action and structurally opens the evaluation."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the answer is \"Yes,\""
      ],
      "justification": "Positive branch condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the bag is marked as returned in IS"
      ],
      "justification": "Direct match for the action taken when the answer is yes."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "However, if the answer is \"No,\""
      ],
      "justification": "Negative branch condition."
    },
    {
      "refs": [
        "action:n6",
        "action:n10"
      ],
      "verbatim_texts": [
        "the script(s) are marked as declined by the customer in IS"
      ],
      "justification": "Both actions describe the same operation (declining scripts), which is supported by the text for both the 'No' and 'Bag not returned' cases."
    },
    {
      "refs": [
        "guard:b1->n11"
      ],
      "verbatim_texts": [
        "If the bag is indeed returned"
      ],
      "justification": "Condition for the bag being returned."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "it is marked as such in IS"
      ],
      "justification": "Action corresponding to the bag being returned."
    },
    {
      "refs": [
        "guard:b1->n10"
      ],
      "verbatim_texts": [
        "if the bag is not returned"
      ],
      "justification": "Condition for the bag not being returned."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Once the bag is marked as returned in IS, the script bag is returned as well."
      ],
      "justification": "Matches the consequential action of returning the script bag."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "when the script(s) are marked as declined by the customer in IS, the script order is declined."
      ],
      "justification": "Matches the consequential action of declining the script order."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "Finally, the customer notification is processed"
      ],
      "justification": "Direct match for the customer notification step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "and the entire process comes to an end."
      ],
      "justification": "Action, end event, and all structural converges aligning to close off the process successfully."
    }
