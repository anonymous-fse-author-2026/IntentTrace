{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, Rental Items are Returned to the Store."
      ],
      "justification": "Initiates the process and represents the first action of returning items to the store."
    },
    {
      "refs": [
        "action:n2",
        "guard:b1->n2"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the items to the store,\""
      ],
      "justification": "Models the decision branch, conditional check, and transition for the customer returning the items."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "then we can continue the process."
      ],
      "justification": "Represents the continuation of the process in the positive branch."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "However, if the \"Delivery Crew picks-up items at the event site,\""
      ],
      "justification": "Represents the alternative conditional check and transition for delivery crew pick-up."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "then we also continue the process."
      ],
      "justification": "Converges the flows and represents the continuation of the process."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "During this step, the items are counted and compared to the original contract."
      ],
      "justification": "Direct match for the item counting and comparison step."
    },
    {
      "refs": [
        "action:n7",
        "guard:b3->n7"
      ],
      "verbatim_texts": [
        "If the \"Order is complete and all items were returned,\""
      ],
      "justification": "Models the decision branch and conditional check for a complete returned order."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "then we proceed with the process."
      ],
      "justification": "Direct match for proceeding with the process."
    },
    {
      "refs": [
        "action:n9",
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "However, if the \"Order is incomplete and items are missing,\""
      ],
      "justification": "Represents the conditional check for an incomplete order."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "we still continue the process."
      ],
      "justification": "Direct match for proceeding with the process in the incomplete branch."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "Similarly, if the \"Order is complete but items are damaged,\""
      ],
      "justification": "Represents the conditional check and guard for a damaged order."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "we email the customer to inform them of the damage and additional charges."
      ],
      "justification": "Direct match for the action of emailing the customer about damage."
    },
    {
      "refs": [
        "action:n13",
        "guard:b6->n13"
      ],
      "verbatim_texts": [
        "After this, if the \"Items are packed for an existing order,\""
      ],
      "justification": "Models the branch and condition for items packed for an existing order."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "we continue the process."
      ],
      "justification": "Direct match for continuing the process."
    },
    {
      "refs": [
        "action:n15",
        "guard:b6->n15",
        "action:n16"
      ],
      "verbatim_texts": [
        "Alternatively, if the \"Items are stored for future orders,\""
      ],
      "justification": "Models the condition and a redundant continuation action for storing items for future orders. Redundancy preserves behaviour."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "In case of missing items and replacement charges,"
      ],
      "justification": "Models the condition of checking for missing items as an action step."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "we email the customer to inform them."
      ],
      "justification": "Direct match for emailing the customer regarding missing items."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Additionally, if there are damaged items and additional charges,"
      ],
      "justification": "Models the condition of checking for damaged items as an action step."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "we temporarily take them out of inventory."
      ],
      "justification": "Direct match for taking damaged items out of inventory."
    },
    {
      "refs": [
        "action:n21",
        "guard:b10->n21"
      ],
      "verbatim_texts": [
        "If the \"Customer returns the missing items,\""
      ],
      "justification": "Branch and conditional check for the customer returning missing items."
    },
    {
      "refs": [
        "action:n23",
        "guard:b10->n23"
      ],
      "verbatim_texts": [
        "However, if the \"Customer does not return the missing items,\" we still continue the process."
      ],
      "justification": "Condition and action modeled together for when the customer does not return missing items."
    },
    {
      "refs": [
        "action:n24",
        "guard:b9->n24",
        "action:n25"
      ],
      "verbatim_texts": [
        "If the \"Items are repaired and added into inventory,\""
      ],
      "justification": "Branch, condition, and a redundant continuation action modeled for repaired items. Behaviour is preserved."
    },
    {
      "refs": [
        "action:n26",
        "guard:b9->n26"
      ],
      "verbatim_texts": [
        "On the other hand, if the \"Items can't be repaired and are discarded,\""
      ],
      "justification": "Condition check for discarded items."
    },
    {
      "refs": [
        "action:n27"
      ],
      "verbatim_texts": [
        "we email the customer with replacement charges."
      ],
      "justification": "Direct match for emailing customer for discarded items."
    },
    {
      "refs": [
        "action:n28",
        "guard:b13->n28"
      ],
      "verbatim_texts": [
        "If the \"Items are packed for an existing order,\""
      ],
      "justification": "Branch and condition for the final packing for existing orders."
    },
    {
      "refs": [
        "action:n30",
        "guard:b13->n30"
      ],
      "verbatim_texts": [
        "If the \"Items are stored for future orders,\""
      ],
      "justification": "Condition check for final storing for future orders."
    },
    {
      "refs": [
        "action:n34"
      ],
      "verbatim_texts": [
        "The customer is then emailed with replacement charges"
      ],
      "justification": "Direct match for final email to customer."
    },
    {
      "refs": [
        "action:n33",
        "action:n36"
      ],
      "verbatim_texts": [
        "and the process is complete."
      ],
      "justification": "Converges the flows and ends the process, using redundant process-complete actions."
    }
  ],
