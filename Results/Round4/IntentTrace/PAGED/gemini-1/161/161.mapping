{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start"
      ],
      "justification": "Initializes the process and models the first step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "join the team and agree on the team's domain"
      ],
      "justification": "Direct match for the joining action."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "create a process model and check it"
      ],
      "justification": "Direct match for the process creation."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the process model is \"NOT OK\""
      ],
      "justification": "Models the decision logic and its negative path."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "assign negative points"
      ],
      "justification": "Direct match of the assigned points."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n8",
        "guard:b2->c_b6"
      ],
      "verbatim_texts": [
        "If it is still \"NOT OK\""
      ],
      "justification": "Secondary decision correctly modeled as an action condition and branch."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "assign negative points again"
      ],
      "justification": "Direct match of the secondary point assignment."
    },
    {
      "refs": [
        "guard:b1->i9"
      ],
      "verbatim_texts": [
        "However, if the process is okay"
      ],
      "justification": "The positive branch guard for process evaluation."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "you can continue with it"
      ],
      "justification": "Direct match of the positive continuation."
    },
    {
      "refs": [
        "action:i10",
        "guard:b_issues->n10",
        "guard:b_issues->c_issues"
      ],
      "verbatim_texts": [
        "If there are any issues"
      ],
      "justification": "Condition for resolving issues and structural plumbing correctly implemented."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "fix them in the next session and extend the process to levels 2 and 3"
      ],
      "justification": "Direct match for fixing issues."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "If you need to check the process and assign points",
        "If you need to analyze the field of study"
      ],
      "justification": "Consolidates and models the multiple checking/analyzing conditions into one action."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "assign roles in the team"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:i15",
        "guard:b_process_ok->n13",
        "guard:b_process_ok->c_proc_ok"
      ],
      "verbatim_texts": [
        "If the process is okay"
      ],
      "justification": "Models condition for continuing process according to assigned role."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "continue with the process and perform work according to your assigned role"
      ],
      "justification": "Direct match of role-based work continuation."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Check the progress and consult any problems that arise"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n15",
        "guard:b4->n15"
      ],
      "verbatim_texts": [
        "If the project is accepted"
      ],
      "justification": "Models project acceptance condition and branch."
    },
    {
      "refs": [
        "action:n16",
        "guard:b_present_type->n16"
      ],
      "verbatim_texts": [
        "present it"
      ],
      "justification": "Models presentation action and incorporates structural branches for repeated presentation flows."
    },
    {
      "refs": [
        "action:i20",
        "guard:b4->i20"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Rejection condition safely modeled."
    },
    {
      "refs": [
        "action:i21",
        "action:n18"
      ],
      "verbatim_texts": [
        "continue working according to your role"
      ],
      "justification": "Models the redundant action of continuing work and handles structural converge."
    },
    {
      "refs": [
        "action:i22",
        "guard:b_present_type->i22"
      ],
      "verbatim_texts": [
        "present it again"
      ],
      "justification": "Models the second occurrence of the presentation task safely."
    },
    {
      "refs": [
        "action:i23",
        "action:n17"
      ],
      "verbatim_texts": [
        "Finally, present the project and the process will come to an end."
      ],
      "justification": "Final presentation action and process conclusion modeled faithfully."
    }
