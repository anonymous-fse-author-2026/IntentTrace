  "input_elements": [
    {
      "id": "i1",
      "content": "the process begins with a request to purchase a motorcycle"
    },
    {
      "id": "i2",
      "content": "either continue the process if a production order is received"
    },
    {
      "id": "i3",
      "content": "or update the sales information and proceed to order dispatch"
    },
    {
      "id": "i4",
      "content": "If there are unavailable materials"
    },
    {
      "id": "i5",
      "content": "they are ordered from the supplier"
    },
    {
      "id": "i6",
      "content": "Alternatively, if there are available goods for production"
    },
    {
      "id": "i7",
      "content": "a manufacturing order is placed"
    },
    {
      "id": "i8",
      "content": "Once the materials are received from the supplier"
    },
    {
      "id": "i9",
      "content": "the goods are issued"
    },
    {
      "id": "i10",
      "content": "the motorcycles are produced"
    },
    {
      "id": "i12",
      "content": "the stock is updated and the motorcycles are dispatched"
    },
    {
      "id": "i13",
      "content": "the stock is updated and the process ends"
    },
    {
      "id": "i14",
      "content": "the sales information is updated"
    }
  ]
