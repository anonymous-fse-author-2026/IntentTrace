{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the ExpenseReport process"
      ],
      "justification": "Initializes the process and captures the starting action step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin by clicking on \"Start\""
      ],
      "justification": "Direct action step match."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "selecting \"Edit Report\""
      ],
      "justification": "Captures the step and acts as a structural convergence point for rejected loops."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the expense is"
      ],
      "justification": "Models the condition as an action and opens the decision gateway."
    },
    {
      "refs": [
        "label:b1->n5",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "greater than 1000"
      ],
      "justification": "Captures the positive threshold condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "the report should be reviewed"
      ],
      "justification": "Direct match to the process step."
    },
    {
      "refs": [
        "label:b1->n6",
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "is less than or equal to 1000"
      ],
      "justification": "Captures the negative threshold condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "check if there is a need for translation"
      ],
      "justification": "Captures the checking step and opens the subsequent decision gateway."
    },
    {
      "refs": [
        "label:b2->n7",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If translation is required"
      ],
      "justification": "Condition label and guard."
    },
    {
      "refs": [
        "action:n7",
        "action:n12"
      ],
      "verbatim_texts": [
        "translate the receipts"
      ],
      "justification": "Maps to both occurrences of the translation step described in the process."
    },
    {
      "refs": [
        "label:b2->n8",
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "If not"
      ],
      "justification": "Condition label and guard for the negative case."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "confirm the receipts"
      ],
      "justification": "Direct match to the step."
    },
    {
      "refs": [
        "label:i13->n9"
      ],
      "verbatim_texts": [
        "After this"
      ],
      "justification": "Structural convergence plumbing bringing the split flows back together."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "evaluate the review decision"
      ],
      "justification": "Evaluation step and subsequent decision gateway."
    },
    {
      "refs": [
        "label:b3->c_edit",
        "guard:b3->c_edit",
        "label:b4->c_edit",
        "guard:b4->c_edit"
      ],
      "verbatim_texts": [
        "If the report is rejected"
      ],
      "justification": "Negative condition arms leading to the edit step for both evaluation occurrences."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "edit the report"
      ],
      "justification": "Direct match to the step and structural plumbing merging loops that target this action."
    },
    {
      "refs": [
        "label:b3->n18",
        "guard:b3->n18",
        "label:b4->n12",
        "guard:b4->n12"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Positive condition arms leading forward in the process for both evaluation occurrences."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "continue to check if there is a need for translation."
      ],
      "justification": "Direct step match."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Once again, evaluate the review decision"
      ],
      "justification": "Captures the second evaluation step and opens its XOR decision."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "confirm them"
      ],
      "justification": "Direct step match."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "evaluate the receipts decision"
      ],
      "justification": "Evaluation action step and its associated decision gateway."
    },
    {
      "refs": [
        "label:b5->n15",
        "guard:b5->n15"
      ],
      "verbatim_texts": [
        "If the receipts are accepted"
      ],
      "justification": "Condition label and guard."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "process the expense"
      ],
      "justification": "Direct step match."
    },
    {
      "refs": [
        "label:b5->c_edit",
        "guard:b5->c_edit"
      ],
      "verbatim_texts": [
        "If they are rejected"
      ],
      "justification": "Condition label and guard."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "ending it"
      ],
      "justification": "Final modeled step and the process end node."
    }
