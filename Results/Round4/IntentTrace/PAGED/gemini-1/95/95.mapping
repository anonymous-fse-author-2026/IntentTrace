    },
    {
      "refs": [
        "action:n21",
        "action:n26"
      ],
      "verbatim_texts": [
        "end the process"
      ],
      "justification": "Action and end nodes correctly modeling the conclusion of the process paths."
    },
    {
      "refs": [
        "guard:b4->n22"
      ],
      "verbatim_texts": [
