  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process for WIGGO,"
      ],
      "justification": "Models the explicit start of the process."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "placing an Order"
      ],
      "justification": "Direct match for placing the order."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check the Customer's Credit Limit"
      ],
      "justification": "Direct match for checking credit limit."
    },
    {
      "refs": [
        "guard:b1->n7",
        "guard:b2->n9"
      ],
      "verbatim_texts": [
        "is \"Okay\""
      ],
      "justification": "Opens the XOR decision and captures the positive outcome. Reused correctly for both decision points."
    },
    {
      "refs": [
        "guard:b1->i7",
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "is \"No\""
      ],
      "justification": "Captures the negative outcome conditions."
    },
    {
      "refs": [
        "action:i7"
      ],
      "verbatim_texts": [
        "if the response"
      ],
      "justification": "A condition correctly modeled as an action step (behavior-preserving)."
    },
    {
      "refs": [
        "action:n5",
        "action:n10"
      ],
      "verbatim_texts": [
        "send a Denial to the Customer"
      ],
      "justification": "Captures the denial actions for both negative branch instances."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Check the Availability of the Article"
      ],
      "justification": "Direct match for the availability check step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "Check the Availability of the Article again"
      ],
      "justification": "Models the second availability check and implies the associated branch."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "If the Article"
      ],
      "justification": "Opens the decision based on article availability."
    },
    {
      "refs": [
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "is available"
      ],
      "justification": "Captures the positive condition for item availability."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "Collect the Goods"
      ],
      "justification": "Direct match for collecting goods."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "is not available"
      ],
      "justification": "Captures the negative condition for item availability."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "Produce the Goods"
      ],
      "justification": "Direct match for producing goods."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "send an Order Confirmation"
      ],
      "justification": "Direct match for sending order confirmation."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "Ship the Goods"
      ],
      "justification": "Models the action and implicitly opens the simultaneous AND split."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "Send the Invoice"
      ],
      "justification": "Models the simultaneous parallel action and closes the concurrent paths."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Check the Payment status"
      ],
      "justification": "Direct match for payment status check."
    },
    {
      "refs": [
