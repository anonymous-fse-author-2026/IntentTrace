      "id": "i1",
      "content": "To begin the process in the Admin Office"
    },
    {
      "id": "i2",
      "content": "check if it has started"
    },
    {
      "id": "i3",
      "content": "verify the completeness of the invoices"
    },
    {
      "id": "i4",
      "content": "If they are marked as \"Uncompleted\""
    },
    {
      "id": "i5",
      "content": "they should be returned to the client through postal mail"
    },
    {
      "id": "i6",
      "content": "if they are marked as \"Completed\""
    },
    {
      "id": "i7",
      "content": "the process should be continued"
    },
    {
      "id": "i8",
      "content": "If the invoices are still marked as \"Uncompleted\""
    },
    {
      "id": "i9",
      "content": "they should be returned to the client via postal mail"
    },
    {
      "id": "i11",
      "content": "receive the completed ones"
    },
    {
      "id": "i12",
      "content": "mark the relevant box on the invoice entry form"
    },
    {
      "id": "i13",
      "content": "checking if the process has been completed"
    },
    {
      "id": "i14",
      "content": "Finally, the process ends"
