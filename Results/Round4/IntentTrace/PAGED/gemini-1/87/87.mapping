      ],
      "justification": "Direct match for the verification step."
    },
    {
      "refs": [
        "guard:b3->n5"
      ],
      "verbatim_texts": [
        "If they are marked as \"Uncompleted\""
      ],
      "justification": "Opens the decision branch and captures the 'Uncompleted' condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "they should be returned to the client through postal mail"
      ],
      "justification": "Action triggered when invoices are uncompleted."
    },
    {
      "refs": [
        "guard:b3->n9"
      ],
      "verbatim_texts": [
        "if they are marked as \"Completed\""
      ],
      "justification": "Captures the alternative condition."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the process should be continued"
      ],
      "justification": "Action triggered when invoices are completed."
    },
    {
      "refs": [
        "guard:b4->n12",
        "guard:b4->c3"
      ],
      "verbatim_texts": [
        "If the invoices are still marked as \"Uncompleted\""
      ],
      "justification": "Captures the second decision point, the condition for uncompleted invoices, and implicitly its opposite for the alternative branch."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "they should be returned to the client via postal mail"
      ],
      "justification": "Action for the repeated uncompleted condition."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "receive the completed ones"
      ],
      "justification": "Captures the receiving action, which structurally acts as the convergence point for the prior splits."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "mark the relevant box on the invoice entry form"
      ],
      "justification": "Direct match for marking the form."
    },
    {
