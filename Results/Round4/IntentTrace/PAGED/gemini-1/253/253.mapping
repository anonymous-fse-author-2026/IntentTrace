{
  "matches": [
    {
      "refs": [
        "init:i1"
      ],
      "verbatim_texts": [
        "To begin the process"
      ],
      "justification": "Initializes the process."
    },
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "start with the Resupply Cycle Triggered step"
      ],
      "justification": "Captures the first step of the resupply cycle."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "checking the Inventory Level"
      ],
      "justification": "Models the checking of inventory as an action."
    },
    {
      "refs": [
        "branch:b1"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\""
      ],
      "justification": "Opens the XOR decision for inventory level."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "Inventory level is at or below the minimum"
      ],
      "justification": "Positive arm condition for the inventory check."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Create Purchase Order"
      ],
      "justification": "Action to create a purchase order when inventory is low."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "Inventory Level is above the minimum"
      ],
      "justification": "Negative arm condition for the inventory check."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Explicitly models process termination using an action and an end event."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Reviewing the Purchase Order"
      ],
      "justification": "Captures the purchase order review step."
    },
    {
      "refs": [
        "branch:b2"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved"
      ],
      "justification": "Opens the XOR decision for purchase order approval."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "is approved"
      ],
      "justification": "Condition representing an approved purchase order."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "reserve the funds for the purchase"
      ],
      "justification": "Captures the action to reserve funds."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "is rejected"
      ],
      "justification": "Condition representing a rejected purchase order."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "rework the order"
      ],
      "justification": "Action to rework the order upon rejection."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "send the Order to Suppliers"
      ],
      "justification": "Action capturing sending the order to suppliers."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "review the Purchase Order again"
      ],
      "justification": "Captures the loopback step and its associated structural join for reviewing the order again."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Structural AND gateway initiating parallel paths."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "the Supplier sends a packing slip and an invoice"
      ],
      "justification": "Action describing the supplier's task."
    },
    {
      "refs": [
        "label:b3->n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received"
      ],
      "justification": "Labels the incoming branch for the packing slip path."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received",
        "record it"
      ],
      "justification": "Combines the reception and recording of the packing slip into one behavior-preserving action."
    },
    {
      "refs": [
        "label:b3->n13"
      ],
      "verbatim_texts": [
        "when the invoice is received"
      ],
      "justification": "Labels the incoming branch for the invoice path."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "when the invoice is received",
        "record it as well"
      ],
      "justification": "Combines the reception and recording of the invoice into one behavior-preserving action."
    },
    {
      "refs": [
        "converge:c2"
      ],
      "verbatim_texts": [
        "After recording the packing slip and invoice"
      ],
      "justification": "Structural join that synchronizes the parallel branches."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "release the reserved funds and issue the payment to the supplier"
      ],
      "justification": "Captures the final payment process steps."
    }
  ],
