init(i1)
action(n1, "Start process for flickr login")
action(n2, "Provide userdata for flickr login")
branch(b1, XOR)
action(n4, "End process after successful login")
end(e1)
action(n5, "We will continue with the process")
branch(b2, XOR)
action(n7, "If you want to try again")
action(n8, "if you choose to abort")
action(n9, "If you still want to try again")
action(n10, "if you decide to abort")
converge(c3)
action(n12, "Provide userdata for flickr login")
end(e3)
converge(c2)
action(n11, "the process will end")
end(e2)
defines(v1, "Is login successful", {"Successful", "Failed"})
defines(v2, "Choose to try login again", {"Want to try again", "Choose to abort", "Still want to try again", "Decide to abort"})
actor(a_default, "Default", [i1, n1, n2, b1, n4, e1, n5, b2, n7, n8, n9, n10, c3, n12, e3, c2, n11, e2])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n4)
precedence(b1, n5)
precedence(n4, e1)
precedence(n5, b2)
precedence(b2, n7)
precedence(b2, n8)
precedence(b2, n9)
precedence(b2, n10)
precedence(n7, c3)
precedence(n9, c3)
precedence(c3, n12)
precedence(n12, e3)
precedence(n8, c2)
precedence(n10, c2)
precedence(c2, n11)
precedence(n11, e2)
guard(b1, n4, v1 = 'Successful')
guard(b1, n5, v1 = 'Failed')
guard(b2, n7, v2 = 'Want to try again')
guard(b2, n8, v2 = 'Choose to abort')
guard(b2, n9, v2 = 'Still want to try again')
guard(b2, n10, v2 = 'Decide to abort')