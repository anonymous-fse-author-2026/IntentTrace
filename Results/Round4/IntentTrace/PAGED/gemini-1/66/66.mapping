    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process in the Admin Office,"
      ],
      "justification": "Starts the process and represents the opening context."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "first check if it has started."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "verify the completeness of the invoices."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If they are marked as \"Uncompleted\","
      ],
      "justification": "Opens the XOR decision and captures the negative condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "they should be returned to the client through postal mail."
      ],
      "justification": "Models the action for the negative path."
    },
    {
      "refs": [
        "guard:b1->n7_2"
      ],
      "verbatim_texts": [
        "However, if they are marked as \"Completed\", the process should be continued."
      ],
      "justification": "Models the positive condition where the process continues."
    },
    {
      "refs": [
        "action:i7"
      ],
      "verbatim_texts": [
        "Once the invoices are returned to the client,"
      ],
      "justification": "A condition modeled as an action step preserves behaviour, so it is a MATCH."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "receive the completed ones."
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n7",
        "action:n7_2"
      ],
      "verbatim_texts": [
        "mark the relevant box on the invoice entry form"
      ],
      "justification": "The action is duplicated across branches, which is a behaviour-preserving modeling choice."
    },
    {
      "refs": [
        "action:n8",
        "action:n8_2"
      ],
      "verbatim_texts": [
        "proceed with checking if the process has been completed."
      ],
      "justification": "The action is duplicated across branches, which is a behaviour-preserving modeling choice."
    },
    {
      "refs": [
        "action:n9",
        "action:n9_2"
      ],
      "verbatim_texts": [
        "Finally, the process ends."
      ],
      "justification": "Models the end of the process. The redundant end actions and duplicated end events do not change the behaviour."
    }
  ],
