@startuml
!theme plain
|a_default| Default
|a_default|
start
:start with Insurance emergency;
:analyze the insurance agreement;
:v1: coverage ({yes, no}); <<objectSignal>>
if () then ([v1 = "yes"])
:offer immediate help;
else ([v1 = "no"])
:send out an offer for emergency help;
:v2: offer status ({rejected, accepted}); <<objectSignal>>
if () then ([v2 = "rejected"])
:ask for a rejection notification;
else ([v2 = "accepted"])
:proceed with internal accounting;
endif
endif
:v3: repeat steps ({yes, no}); <<objectSignal>>
if () then ([v3 = "no"])
:conclude the process;
stop
endif
