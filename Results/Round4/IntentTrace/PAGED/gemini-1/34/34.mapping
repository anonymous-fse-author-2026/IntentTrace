      ],
      "verbatim_texts": [
        "Initially, it is important to check the Referee Reports."
      ],
      "justification": "Initiates the process and represents the first checking step."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "At the same time,"
      ],
      "justification": "Temporal marker modeled as an action step; harmless restatement that does not change behavior."
    },
    {
      "refs": [
        "action:i3"
      ],
      "verbatim_texts": [
        "monitor if the Referee Reports have been completed"
      ],
      "justification": "Direct match to the monitoring step."
    },
    {
      "refs": [
        "action:i4",
        "guard:b1->i4"
      ],
      "verbatim_texts": [
        "If they have been completed,"
      ],
      "justification": "Opens the decision for report completion and correctly maps the positive outcome."
    },
    {
      "refs": [
        "action:i5",
        "guard:b1->i5"
      ],
      "verbatim_texts": [
        "flag it and send a reminder"
      ],
      "justification": "Correctly maps the negative outcome branch where a reminder is sent."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "check again if the Referee Reports have been completed"
      ],
      "justification": "Converges the previous branches and captures the second check."
    },
    {
      "refs": [
        "action:i7",
        "guard:b2->i7"
      ],
      "verbatim_texts": [
        "If they have,"
      ],
      "justification": "Decision and positive branch for the second report check."
    },
    {
      "refs": [
        "action:i8",
        "guard:b2->i8"
      ],
      "verbatim_texts": [
        "flag it again and send another reminder."
      ],
      "justification": "Negative branch for the second report check."
    },
    {
      "refs": [
        "action:i9"
      ],
      "verbatim_texts": [
        "organizing interviews for the Selection Panel with the top candidates"
      ],
      "justification": "Structural convergence moving forward into the interview organization step."
    },
    {
      "refs": [
        "action:i10"
      ],
      "verbatim_texts": [
        "receive feedback from the interview candidates"
      ],
      "justification": "Direct match to receiving feedback."
    },
    {
      "refs": [
        "action:i11"
      ],
      "verbatim_texts": [
        "check if a Psychometric Test is required"
      ],
      "justification": "Direct match to checking test requirements."
    },
    {
      "refs": [
        "action:i12",
        "guard:b3->i12"
      ],
      "verbatim_texts": [
