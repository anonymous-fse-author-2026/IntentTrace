      ],
      "justification": "Decision and positive branch for the Psychometric Test requirement."
    },
    {
      "refs": [
        "action:i13"
      ],
      "verbatim_texts": [
        "check if an HR Specialist is required"
      ],
      "justification": "Direct match to checking HR specialist requirement."
    },
    {
      "refs": [
        "action:i14",
        "guard:b3->i14"
      ],
      "verbatim_texts": [
        "coordinate the second round of selection"
      ],
      "justification": "Negative branch capturing the process continuation when no psychometric test is required."
    },
    {
      "refs": [
        "action:i15",
        "guard:b4->i15"
      ],
      "verbatim_texts": [
        "If an HR Specialist is required,"
      ],
      "justification": "Decision and positive branch for the HR specialist check."
    },
    {
      "refs": [
        "action:i16"
      ],
      "verbatim_texts": [
        "schedule the test with a third party"
      ],
      "justification": "Action to schedule with a third party."
    },
    {
      "refs": [
        "action:i17",
        "guard:b4->i17"
      ],
      "verbatim_texts": [
        "complete the Psychometric Test"
      ],
      "justification": "Negative branch for when an HR specialist is not required."
    },
    {
      "refs": [
        "action:i18"
      ],
      "verbatim_texts": [
        "Finally, you should request the final candidate ranking and continue with the process."
