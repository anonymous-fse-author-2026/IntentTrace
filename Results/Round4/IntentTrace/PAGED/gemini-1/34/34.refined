init(start)
action(i1, "Initially, it is important to check the Referee Reports.")
action(i2, "At the same time,")
action(i3, "monitor if the Referee Reports have been completed")
branch(b1, XOR)
action(i4, "If they have been completed,")
action(i5, "flag it and send a reminder")
converge(c2)
action(i6, "check again if the Referee Reports have been completed")
branch(b2, XOR)
action(i7, "If they have,")
action(i8, "flag it again and send another reminder.")
converge(c1)
action(i9, "organizing interviews for the Selection Panel with the top candidates")
action(i10, "receive feedback from the interview candidates")
action(i11, "check if a Psychometric Test is required")
branch(b3, XOR)
action(i12, "If it is,")
action(i13, "check if an HR Specialist is required")
action(i14, "coordinate the second round of selection")
branch(b4, XOR)
action(i15, "If an HR Specialist is required,")
action(i16, "schedule the test with a third party")
action(i17, "complete the Psychometric Test")
converge(c3)
action(i18, "Finally, you should request the final candidate ranking and continue with the process.")
end(e1)

defines(v1, "reports_completed", {"Yes", "No"})
defines(v2, "recheck_completed", {"Yes", "No"})
defines(v3, "psycho_required", {"Yes", "No"})
defines(v4, "hr_required", {"Yes", "No"})

actor(a_default, "Default", [start, i1, i2, i3, b1, i4, i5, c2, i6, b2, i7, i8, c1, i9, i10, i11, b3, i12, i13, i14, b4, i15, i16, i17, c3, i18, e1])

precedence(start, i1)
precedence(i1, i2)
precedence(i2, i3)
precedence(i3, b1)
precedence(b1, i4)
precedence(b1, i5)
precedence(i5, c2)
precedence(i8, c2)
precedence(c2, i6)
precedence(i6, b2)
precedence(b2, i7)
precedence(b2, i8)
precedence(i4, c1)
precedence(i7, c1)
precedence(c1, i9)
precedence(i9, i10)
precedence(i10, i11)
precedence(i11, b3)
precedence(b3, i12)
precedence(b3, i14)
precedence(i12, i13)
precedence(i13, b4)
precedence(b4, i15)
precedence(b4, i17)
precedence(i15, i16)
precedence(i14, c3)
precedence(i16, c3)
precedence(i17, c3)
precedence(c3, i18)
precedence(i18, e1)

guard(b1, i4, v1 = "Yes")
guard(b1, i5, v1 = "No")
guard(b2, i7, v2 = "Yes")
guard(b2, i8, v2 = "No")
guard(b3, i12, v3 = "Yes")
guard(b3, i14, v3 = "No")
guard(b4, i15, v4 = "Yes")
guard(b4, i17, v4 = "No")