  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "In the beginning, the process starts"
      ],
      "justification": "Models the start of the process, preserving the entry point."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Bill for Purchased Goods/Services and then Receive Invoice"
      ],
      "justification": "Captures the initial billing and invoice reception step."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete"
      ],
      "justification": "Captures the decision and the action of returning an incomplete invoice."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "If the invoice is incomplete, it is returned."
      ],
      "justification": "Captures the decision and the action of returning an incomplete invoice."
    },
    {
      "refs": [
        "action:n7",
        "guard:b1->n7"
      ],
      "verbatim_texts": [
        "If the invoice is non-compliant"
      ],
      "justification": "Captures the non-compliance condition, modeled redundantly as a guard and a checking action."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "further checks are conducted"
      ],
      "justification": "Directly matches the step to conduct further checks."
    },
    {
      "refs": [
        "guard:b2->n8",
        "action:n8"
      ],
      "verbatim_texts": [
        "If the issue can be resolved with a phone call, non-compliance is resolved."
      ],
      "justification": "Captures the decision branch, condition, and resolution via phone call."
    },
    {
      "refs": [
        "guard:b2->n9",
        "action:n9"
      ],
      "verbatim_texts": [
        "if the issue requires mail back, the invoice is returned."
      ],
      "justification": "Captures the alternative mail-back condition and the corresponding return step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "if it is returned, non-compliance is resolved."
      ],
      "justification": "Matches the non-compliance resolution step after a return."
    },
    {
      "refs": [
        "action:n12",
        "guard:b1->n12"
      ],
      "verbatim_texts": [
        "Bill Client"
      ],
      "justification": "Captures the billing client step and the implicit 'compliant' path that leads to this process continuation."
    },
    {
      "refs": [
        "action:n13",
        "guard:b3->n13"
      ],
      "verbatim_texts": [
        "If there is no response"
      ],
      "justification": "Captures the decision branch and 'no response' condition, including the redundantly modeled action check."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "a period of 10 days is given."
      ],
      "justification": "Direct match for the 10-day waiting period."
    },
    {
      "refs": [
        "action:n11",
        "guard:b3->n11"
      ],
      "verbatim_texts": [
        "The invoice is paid and the client is notified of the payment."
      ],
      "justification": "Matches the payment and notification action, and aligns the implicit 'response received' guard leading to it."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "After 10 days, a reminder is sent and the process ends."
      ],
      "justification": "Matches the reminder action and the explicit process termination."
    },
    {
      "refs": [
        "action:n16",
        "guard:b4->n16"
      ],
      "verbatim_texts": [
        "If the client is unsatisfied, payment discrepancy is resolved."
      ],
      "justification": "Captures the conditional check and action for an unsatisfied client."
    },
    {
      "refs": [
        "action:n17",
        "guard:b4->n17"
      ],
      "verbatim_texts": [
        "if the client is satisfied, the process continues."
      ],
      "justification": "Matches the continuation step and condition for a satisfied client."
    }
  ],
