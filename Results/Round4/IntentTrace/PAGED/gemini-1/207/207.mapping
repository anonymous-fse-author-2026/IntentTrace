{
  "matches": [
    {
      "refs": [
        "action:n1",
        "action:n2"
      ],
      "verbatim_texts": [
        "To begin with, for CAB, the first step is to assess the change request."
      ],
      "justification": "The init element starts the process, and the action elements accurately model the first step. The redundancy between n1 and n2 preserves behaviour."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "check the affected systems for any impacts on the business unit"
      ],
      "justification": "Direct match for the step checking affected systems."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "determine whether the change request should be approved or not"
      ],
      "justification": "Captures the decision task and the XOR split for evaluating the change request."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the change request should be approved in its current state, then it is approved."
      ],
      "justification": "Models the positive condition and corresponding approval step."
    },
    {
      "refs": [
        "action:n8",
        "guard:b1->n8"
      ],
      "verbatim_texts": [
        "However, if the change request should not be approved in its current state, further evaluation is needed to determine if the change will be acceptable with more information provided."
      ],
      "justification": "Models the condition requiring further evaluation and the corresponding step."
    },
    {
      "refs": [
        "action:n6",
        "action:n21",
        "guard:b4->n21",
        "action:n22"
      ],
      "verbatim_texts": [
        "If the change request is ultimately approved, the change is implemented."
      ],
      "justification": "Covers both the immediate implementation path and the deferred implementation path after final determination, along with the process ends."
    },
    {
      "refs": [
        "action:n9",
        "guard:b1->n9",
        "action:n24",
        "guard:b4->n24"
      ],
      "verbatim_texts": [
        "On the other hand, if the change is deemed unacceptable, it is rejected."
      ],
      "justification": "Maps to the immediate rejection path and the rejection path following the delayed final determination."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "In this case, a request for more information is made to the Change Coordinator."
      ],
      "justification": "Direct match for requesting more information."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "The request is then followed by an email enquiry to the Change Coordinator."
      ],
      "justification": "Direct match for sending the email enquiry."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "After that, the approval register is updated within a timeframe of 3 business days."
      ],
      "justification": "Direct match for updating the approval register."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "The email enquiry is also forwarded to the Change Requester."
      ],
      "justification": "Direct match for forwarding the enquiry."
    },
    {
      "refs": [
        "guard:b3->n16",
        "action:n16"
      ],
      "verbatim_texts": [
        "If there are no further inquiries or issues"
      ],
      "justification": "Models the split point and the negative condition branch. The condition modeled as an action step preserves behaviour."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "the process concludes after 3 business days."
      ],
      "justification": "Correctly captures the conclusion of the process when there are no inquiries."
    },
    {
      "refs": [
        "guard:b3->n18",
        "action:n18"
      ],
      "verbatim_texts": [
        "However, if there are inquiries from the CAB, a response is expected within 1-3 business days."
      ],
      "justification": "Captures the positive condition (inquiries exist) and the expected response action."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "Once the response is received from the requester, it is forwarded to the CAB for further evaluation."
      ],
      "justification": "Direct match for forwarding the response to the CAB."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "Based on the response, a final determination is made regarding the approval of the change request."
      ],
      "justification": "Models the final evaluation step and the split leading to ultimate approval or rejection."
    }
  ],
