  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process"
      ],
      "justification": "Starts the process and models the starting action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin with the New Resupply Cycle"
      ],
      "justification": "Direct match for initiating the resupply cycle."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check Levels of Inventory"
      ],
      "justification": "Action checks the inventory, and the branch opens the decision based on this check."
    },
    {
      "refs": [
        "action:n4",
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "Condition perfectly captured by the guard and re-stated as an action (which is a valid modelling choice)."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report"
      ],
      "justification": "Direct match."
    },
    {
      "refs": [
        "action:n5",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report"
      ],
      "justification": "Captures the generation of the report and the implicit condition 'above minimum'."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)"
      ],
      "justification": "Captures the step to create POs. The converge structural node resolves the loop returning to this step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Explicitly ends the process."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "needs to be reviewed"
      ],
      "justification": "The review action opens up the decision on whether the PO is rejected or approved."
    },
    {
      "refs": [
        "guard:b2->n9a",
        "action:n9a"
      ],
      "verbatim_texts": [
        "If the PO is rejected"
      ],
      "justification": "Captures the negative decision branch."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "needs to be reworked"
      ],
      "justification": "Direct match for the rework step."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "needs to be created again"
      ],
      "justification": "Direct match representing the loop action."
    },
    {
      "refs": [
        "guard:b2->n11",
        "action:n11"
      ],
      "verbatim_texts": [
        "approved, it is printed and released in the system"
      ],
      "justification": "Captures the positive decision condition and the subsequent action."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "The 'AND' branch perfectly corresponds to the concurrent behavior."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
