      "justification": "Models the decision point and the positive branch for trying again."
    },
    {
      "refs": [
        "action:n7",
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "if you choose to abort,"
      ],
      "justification": "Models the abort condition and the consequential termination of the process."
    }
