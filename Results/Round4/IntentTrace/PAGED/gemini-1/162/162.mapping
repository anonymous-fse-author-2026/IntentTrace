    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "the process will end."
      ],
      "justification": "Models the process termination step following a successful login."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "if the login fails,"
      ],
      "justification": "Models the negative guard for the login failure condition."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
