init(start)
action(i1, "For EC-Lille: Initially")
action(i2, 'if the option "research schedule directly" is selected')
branch(b1, XOR)
action(i3, 'then the action to be taken is "Research schedule"')
action(i4, 'then "provide indications"')
action(i5, "provide indications")
action(i6, "proceed with the research schedule")
converge(c1)
action(i7, "After validating the schedule")
action(i8, "check if the schedule is satisfactory")
branch(b2, XOR)
action(i9, 'perform the action "Research schedule"')
action(i11, 'If the schedule is not satisfactory, perform the action "Research schedule"')
action(i12, "If it is still not satisfactory")
action(i5_2, "provide indications")
action(i6_2, "proceed with the research schedule")
action(i7_2, "After validating the schedule")
action(i8_2, "check if the schedule is satisfactory")
branch(b2_2, XOR)
converge(c_i10)
action(i10, "proceed with writing a ticket order to SNCF")
converge(c_i13)
action(i13, "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF.")
converge(c2)
action(i14, "After writing the ticket order, validate it.")
action(i15, "Check if the ticket order is approved.")
branch(b4, XOR)
converge(c6)
action(i16, "If it is not, then the process ends.")
end(e1)
action(i17, "If it is approved, then validate the ticket order.")
action(i18, "Check again if the ticket order is approved.")
branch(b5, XOR)
action(i17_2, "If it is approved, then validate the ticket order.")
action(i19, "Check once more if the ticket order is approved.")
branch(b6, XOR)
action(i20, "If it is, then the process ends.")
end(e2)
end(e3)

defines(v1, "research schedule directly selected", {"Yes", "No"})
defines(v2, "is the schedule satisfactory", {"Yes", "Alternatively Yes", "No"})
defines(v2_2, "is the schedule satisfactory 2", {"Yes", "Alternatively Yes", "No"})
defines(v4, "is the ticket order approved", {"Yes", "No"})
defines(v5, "is the ticket order approved again", {"Yes", "No"})
defines(v6, "is the ticket order approved once more", {"Yes", "No"})

actor(a_default, "Default", [start, i1, i2, b1, i3, i4, i5, i6, c1, i7, i8, b2, i9, i11, i12, i5_2, i6_2, i7_2, i8_2, b2_2, c_i10, i10, c_i13, i13, c2, i14, i15, b4, c6, i16, e1, i17, i18, b5, i17_2, i19, b6, i20, e2, e3])

