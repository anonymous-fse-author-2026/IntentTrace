      ],
      "justification": "Starts the process and provides the initial context."
    },
    {
      "refs": [
        "action:i2",
        "guard:b1->i2",
        "guard:b1->i4"
      ],
      "verbatim_texts": [
        "if the option \"research schedule directly\" is selected"
      ],
      "justification": "Captures the first decision and its branch paths."
    },
    {
      "refs": [
        "action:i3"
      ],
      "verbatim_texts": [
        "then the action to be taken is \"Research schedule\""
      ],
      "justification": "Positive branch action."
    },
    {
      "refs": [
        "action:i4"
      ],
      "verbatim_texts": [
        "then \"provide indications\""
      ],
      "justification": "Negative branch action."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "provide indications"
      ],
      "justification": "Action step matched directly to text."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "proceed with the research schedule"
      ],
      "justification": "Proceeding step mapped to action and flow convergence."
    },
    {
      "refs": [
        "action:i7"
      ],
      "verbatim_texts": [
        "After validating the schedule"
      ],
      "justification": "Validation step before condition."
    },
    {
      "refs": [
        "action:i8"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory"
      ],
      "justification": "Decision step checking schedule satisfaction."
    },
    {
      "refs": [
        "action:i9",
        "guard:b2->i9"
      ],
      "verbatim_texts": [
        "perform the action \"Research schedule\""
      ],
      "justification": "Fallback loop step on negative path."
    },
    {
      "refs": [
        "action:i10",
        "guard:b2->c_i10"
      ],
      "verbatim_texts": [
        "proceed with writing a ticket order to SNCF"
      ],
      "justification": "Positive path towards writing ticket order."
    },
    {
      "refs": [
        "action:i11"
      ],
      "verbatim_texts": [
        "If the schedule is not satisfactory, perform the action \"Research schedule\""
      ],
      "justification": "Explicitly stated condition and action mapped accurately."
    },
    {
      "refs": [
        "action:i12",
        "action:i5_2",
        "action:i6_2",
        "action:i7_2",
        "action:i8_2",
        "guard:b2_2->c_i10",
        "guard:b2_2->c_i13",
        "guard:b2_2->e3"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory"
      ],
      "justification": "Unrolled loop representing the fallback steps repeated when the schedule remains unsatisfactory."
    },
    {
      "refs": [
        "action:i13",
        "guard:b2->c_i13"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory, write a ticket order to SNCF."
      ],
      "justification": "Alternative positive branch proceeding."
    },
    {
      "refs": [
        "action:i14"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it."
      ],
      "justification": "Converged sequence moving to validation."
    },
    {
      "refs": [
        "action:i15"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved."
      ],
      "justification": "Decision step checking for approval."
    },
    {
      "refs": [
        "action:i16",
        "guard:b4->c6"
      ],
      "verbatim_texts": [
        "If it is not, then the process ends."
      ],
      "justification": "Negative termination branch. This is reused by multiple loops accurately."
    },
    {
      "refs": [
        "action:i17",
        "guard:b4->i17"
      ],
      "verbatim_texts": [
        "If it is approved, then validate the ticket order."
      ],
      "justification": "First approval positive loop path."
    },
    {
      "refs": [
        "action:i18",
        "guard:b5->c6"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved."
      ],
      "justification": "Second approval check decision."
    },
    {
      "refs": [
        "action:i19",
        "guard:b5->i17_2",
        "action:i17_2",
        "guard:b6->c6"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved."
      ],
      "justification": "Final approval loop structures matching the unrolled repetition in the source."
    },
    {
      "refs": [
        "action:i20",
        "guard:b6->i20"
      ],
      "verbatim_texts": [
        "If it is, then the process ends."
      ],
      "justification": "Final termination point for the final check."
    }
