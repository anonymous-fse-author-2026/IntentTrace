{
  "matches": [
    {
      "refs": [
        "action:i1",
        "guard:b_start->i2"
      ],
      "verbatim_texts": [
        "Initially, if the option \"research schedule directly\" is selected"
      ],
      "justification": "Starts the process, describes the initial condition, sets up the branch and models the positive decision arm."
    },
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "the action to be taken is \"Research schedule\""
      ],
      "justification": "Direct match for the action in the positive branch."
    },
    {
      "refs": [
        "action:i3",
        "guard:b_start->i3"
      ],
      "verbatim_texts": [
        "If the option is not selected"
      ],
      "justification": "Models the negative condition of the initial branch."
    },
    {
      "refs": [
        "action:i4"
      ],
      "verbatim_texts": [
        "then \"provide indications\""
      ],
      "justification": "Converges the initial branching logic and executes the indication action."
    },
    {
      "refs": [
        "action:i5"
      ],
      "verbatim_texts": [
        "proceed with the research schedule"
      ],
      "justification": "Direct match for proceeding with the research schedule."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "After validating the schedule"
      ],
      "justification": "Provides the validation step and structural convergence."
    },
    {
      "refs": [
        "action:i7"
      ],
      "verbatim_texts": [
        "check if the schedule is satisfactory"
      ],
      "justification": "Models the checking action and opens the corresponding decision gateway."
    },
    {
      "refs": [
        "action:i8",
        "guard:b_i7->i8"
      ],
      "verbatim_texts": [
        "If it is not"
      ],
      "justification": "Captures the negative outcome condition."
    },
    {
      "refs": [
        "action:i10"
      ],
      "verbatim_texts": [
        "perform the action \"Research schedule\""
      ],
      "justification": "Direct match for the repeated research schedule action."
    },
    {
      "refs": [
        "action:i9",
        "guard:b_i7->i9"
      ],
      "verbatim_texts": [
        "If it is"
      ],
      "justification": "Captures the positive outcome condition."
    },
    {
      "refs": [
        "action:i11"
      ],
      "verbatim_texts": [
        "proceed with writing a ticket order to SNCF"
      ],
      "justification": "Direct match for the action."
    },
    {
      "refs": [
        "action:i12",
        "guard:b_i7->i12"
      ],
      "verbatim_texts": [
        "If it is still not satisfactory"
      ],
      "justification": "Captures the condition for an alternative negative case."
    },
    {
      "refs": [
        "action:i13",
        "guard:b_i7->i13"
      ],
      "verbatim_texts": [
        "Alternatively, if the schedule is satisfactory"
      ],
      "justification": "Captures the alternative positive case."
    },
    {
      "refs": [
        "action:i14"
      ],
      "verbatim_texts": [
        "write a ticket order to SNCF"
      ],
      "justification": "Direct match for the action."
    },
    {
      "refs": [
        "action:i15"
      ],
      "verbatim_texts": [
        "After writing the ticket order, validate it"
      ],
      "justification": "Provides structural convergence of previous branches and models the validation action."
    },
    {
      "refs": [
        "action:i16",
        "guard:b_i16->c_i17"
      ],
      "verbatim_texts": [
        "Check if the ticket order is approved"
      ],
      "justification": "Models the check, the decision gateway, and the implicit negative outcome pathway."
    },
    {
      "refs": [
        "action:i18",
        "guard:b_i16->i18"
      ],
      "verbatim_texts": [
        "If it is approved"
      ],
      "justification": "Captures the positive outcome condition."
    },
    {
      "refs": [
        "action:i19"
      ],
      "verbatim_texts": [
        "validate the ticket order"
      ],
      "justification": "Direct match for the action."
    },
    {
      "refs": [
        "action:i20",
        "guard:b_i20->c_i17"
      ],
      "verbatim_texts": [
        "Check again if the ticket order is approved"
      ],
      "justification": "Models the secondary check, the decision gateway, and its negative outcome pathway."
    },
    {
      "refs": [
        "action:i21",
        "guard:b_i20->i21"
      ],
      "verbatim_texts": [
        "Check once more if the ticket order is approved"
      ],
      "justification": "Captures the third check and its initiating positive guard."
    },
    {
      "refs": [
        "action:i17"
      ],
      "verbatim_texts": [
        "then the process ends"
      ],
      "justification": "Captures the terminal action and models the corresponding process end."
    }
  ],
