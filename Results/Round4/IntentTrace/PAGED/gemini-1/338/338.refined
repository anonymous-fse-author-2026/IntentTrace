init(start)
action(i1, "Initially, if the option \"research schedule directly\" is selected")
branch(b_start, XOR)
action(i2, "the action to be taken is \"Research schedule\"")
action(i3, "If the option is not selected")
converge(c_i4)
action(i4, "then \"provide indications\"")
action(i5, "proceed with the research schedule")
converge(c_i6)
action(i6, "After validating the schedule")
action(i7, "check if the schedule is satisfactory")
branch(b_i7, XOR)
action(i12, "If it is still not satisfactory")
action(i13, "Alternatively, if the schedule is satisfactory")
action(i14, "write a ticket order to SNCF")
action(i8, "If it is not")
action(i10, "perform the action \"Research schedule\"")
action(i9, "If it is")
action(i11, "proceed with writing a ticket order to SNCF")
converge(c_i15)
action(i15, "After writing the ticket order, validate it")
action(i16, "Check if the ticket order is approved")
branch(b_i16, XOR)
action(i18, "If it is approved")
action(i19, "validate the ticket order")
action(i20, "Check again if the ticket order is approved")
branch(b_i20, XOR)
action(i21, "Check once more if the ticket order is approved")
converge(c_i17)
action(i17, "then the process ends")
end(e_end)
defines(v_opt, "research schedule directly", {"Yes", "No"})
defines(v_sat, "schedule satisfactory", {"No", "Yes", "StillNo", "AltYes"})
defines(v_app1, "ticket approved 1", {"No", "Yes"})
defines(v_app2, "ticket approved 2", {"No", "Yes"})
actor(a_sys, "System", [start, i1, b_start, i2, i3, c_i4, i4, i5, c_i6, i6, i7, b_i7, i12, i13, i14, i8, i10, i9, i11, c_i15, i15, i16, b_i16, i18, i19, i20, b_i20, i21, c_i17, i17, e_end])
precedence(start, i1)
precedence(i1, b_start)
precedence(b_start, i2)
precedence(b_start, i3)
precedence(i2, c_i6)
precedence(i3, c_i4)
precedence(c_i4, i4)
precedence(i4, i5)
precedence(i5, c_i6)
precedence(c_i6, i6)
precedence(i6, i7)
precedence(i7, b_i7)
precedence(b_i7, i8)
precedence(b_i7, i9)
precedence(b_i7, i12)
precedence(b_i7, i13)
precedence(i12, c_i4)
precedence(i13, i14)
precedence(i14, c_i15)
precedence(i8, i10)
precedence(i10, c_i6)
precedence(i9, i11)
precedence(i11, c_i15)
precedence(c_i15, i15)
precedence(i15, i16)
precedence(i16, b_i16)
precedence(b_i16, c_i17)
precedence(b_i16, i18)
precedence(i18, i19)
precedence(i19, i20)
precedence(i20, b_i20)
precedence(b_i20, c_i17)
precedence(b_i20, i21)
precedence(i21, c_i17)
precedence(c_i17, i17)
precedence(i17, e_end)
guard(b_start, i2, v_opt = 'Yes')
guard(b_start, i3, v_opt = 'No')
guard(b_i7, i8, v_sat = 'No')
guard(b_i7, i9, v_sat = 'Yes')
guard(b_i7, i12, v_sat = 'StillNo')
guard(b_i7, i13, v_sat = 'AltYes')
guard(b_i16, c_i17, v_app1 = 'No')
guard(b_i16, i18, v_app1 = 'Yes')
guard(b_i20, c_i17, v_app2 = 'No')
guard(b_i20, i21, v_app2 = 'Yes')