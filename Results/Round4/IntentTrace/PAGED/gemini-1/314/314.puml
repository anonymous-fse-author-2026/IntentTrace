@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start by identifying the vacancy;
:v1: Any candidates available? ({Yes, No}); <<objectSignal>>
if () then ([v1="No"])
:If there is no suitable candidate available;
:Advertise Vacancy;
repeat :;
:If there is still no suitable candidate available;
:v2: After advertising  any candidates? ({Yes, No}); <<objectSignal>>
backward:Advertise Again;
repeat while () is ([v2="No"]) not ([v2="Yes"])
else ([v1="Yes"])
:Continue with the process;
endif
:Select Applicant;
:Once the candidate is appointed;
:End;
stop
@enduml