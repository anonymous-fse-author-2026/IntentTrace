    {
      "refs": [
        "guard:b2->i12"
      ],
      "verbatim_texts": [
        "If the order is correct",
        "control the incoming order."
      ],
      "reason": "The model incorrectly routes the condition for a 'correct' order to 'control the incoming order' (i12). In the source, controlling the order happens unconditionally before the decision, and 'correct' should instead target the 'release it' step."
    }
  ],
