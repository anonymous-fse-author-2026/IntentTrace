init(start_node)
action(i1, "To start the process")
action(i2, "begin by supplying the requirement")
action(i3, "and then documenting it")

branch(b1, XOR)
action(i4, "If the order is received via fax,")
action(i5, "via fax")
action(i7, "If the order is received via mail or phone")
action(i8, "via mail or phone")
converge(c_b1)

action(i6, "input the order into an Excel file.")
action(i9, "Once the Excel list is complete after a week, send it to the student.")
action(i10, "type the orders into the MS-Access database")
action(i11, "After typing the orders into the database, ensure that it is completed.")

action(i13, "At the same time, continue to do the check.")

branch(b2, XOR)
action(i12, "control the incoming order.")
action(i14, "If the order is correct")
action(i15, "is correct")
action(i19, "if the order is incorrect")
action(i20, "is incorrect")
action(i21, "contact the selling agency")
action(i22, "If the order is worth less than 5.000 €")
action(i23, "worth less than 5.000 €")
action(i24, "If the order is worth more than 5.000 €")
action(i25, "worth more than 5.000 €")
action(i26, "send it for sign off and continue with the check.")
action(i27, "Contact the selling agency and upon receiving the actual issue, send the order for sign off.")
action(i28, "Once the order is signed off, contact the client and release the order.")

converge(c_rel)
action(i16, "release it")
branch(b_rel, XOR)

action(i17, "Send the Excel list to the student")
action(i18, "and upon receiving it, continue with the process.")

action(i32, "If the issue cannot be solved")
action(i33, "cannot be solved")
action(i34, "cancel the order.")
action(i35, "If the issue can be solved")
action(i36, "can be solved")
action(i29, "release the order.")

converge(c3)

action(i30, "Once the order is received by PPC")
action(i31, "Once the order is received by PPC, they will initiate production.")
action(i37, "After PPC initiates production, the goods will be produced.")

action(i38, "If the order needs to be cancelled")
action(i39, "needs to be cancelled")
action(i40, "the process ends.")
end(e2)

action(i41, "If not")
action(i42, "check the quality of the goods.")
action(i43, "create and send a quality report to the finance department.")
action(i48, "At the same time, commission the goods and sign and send the memo.")

branch(b8, AND)
action(i44, "Release the order via memo")
action(i45, "and ensure that the memo is achieved in the warehouse.")
action(i46, "Send the invoice")
action(i47, "report the achievement to the finance department.")
action(i49, "Also, send the goods and ensure that the signed memo is achieved in the logistic department.")

converge(c4)
action(i50, "Finally, archive the memo and close the order.")
action(i51, "This marks the end of the process.")
end(e3)

defines(v1, "received method", {"fax", "mail or phone"})
defines(v2, "evaluate order", {"correct", "incorrect", "less than 5000", "more than 5000"})
defines(v_rel, "release path", {"correct", "less than 5000"})

actor(a_default, "Default", [start_node, i1, i2, i3, b1, i4, i5, i7, i8, c_b1, i6, i9, i10, i11, i13, b2, i12, i14, i15, i19, i20, i21, i22, i23, i24, i25, i26, i27, i28, c_rel, i16, b_rel, i17, i18, i32, i33, i34, i35, i36, i29, c3, i30, i31, i37, i38, i39, i40, e2, i41, i42, i43, i48, b8, i44, i45, i46, i47, i49, c4, i50, i51, e3])

precedence(start_node, i1)
precedence(i1, i2)
precedence(i2, i3)
precedence(i3, b1)

guard(b1, i4, v1 = 'fax')
precedence(b1, i4)
precedence(i4, i5)
precedence(i5, c_b1)

guard(b1, i7, v1 = 'mail or phone')
precedence(b1, i7)
precedence(i7, i8)
precedence(i8, c_b1)

precedence(c_b1, i6)
precedence(i6, i9)
precedence(i9, i10)
precedence(i10, i11)
precedence(i11, i13)
precedence(i13, b2)

guard(b2, i12, v2 = 'correct')
precedence(b2, i12)
precedence(i12, i14)
precedence(i14, i15)
precedence(i15, c_rel)

guard(b2, i19, v2 = 'incorrect')
precedence(b2, i19)
precedence(i19, i20)
precedence(i20, i21)
precedence(i21, i32)

guard(b2, i22, v2 = 'less than 5000')
precedence(b2, i22)
precedence(i22, i23)
precedence(i23, c_rel)

guard(b2, i24, v2 = 'more than 5000')
precedence(b2, i24)
precedence(i24, i25)
precedence(i25, i26)
precedence(i26, i27)
precedence(i27, i28)
precedence(i28, i35)

precedence(c_rel, i16)
precedence(i16, b_rel)

guard(b_rel, i17, v_rel = 'correct')
precedence(b_rel, i17)
precedence(i17, i18)
precedence(i18, c3)

guard(b_rel, c3, v_rel = 'less than 5000')
precedence(b_rel, c3)

precedence(i32, i33)
precedence(i33, i34)
precedence(i34, i38)

precedence(i35, i36)
precedence(i36, i29)
precedence(i29, c3)

precedence(c3, i30)
precedence(i30, i31)
precedence(i31, i37)
precedence(i37, i41)

precedence(i38, i39)
precedence(i39, i40)
precedence(i40, e2)

precedence(i41, i42)
precedence(i42, i43)
precedence(i43, i48)
precedence(i48, b8)

precedence(b8, i44)
precedence(i44, i45)
precedence(i45, c4)

precedence(b8, i46)
precedence(i46, i47)
precedence(i47, c4)

precedence(b8, i49)
precedence(i49, c4)

precedence(c4, i50)
precedence(i50, i51)
precedence(i51, e3)