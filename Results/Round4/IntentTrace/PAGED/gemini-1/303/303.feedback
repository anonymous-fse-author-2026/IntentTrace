Addition
- [N1] Added trace (model 3): init(start_node) -> action(i1,"To start the process") -> action(i2,"begin by supplying the requirement") -> action(i3,"and then documenting it") -> branch(b1,XOR) -> action(i4,"If the order is received via fax,") -> action(i5,"via fax") -> converge(c_b1) -> action(i6,"input the order into an Excel file.") -> action(i9,"Once the Excel list is complete after a week, send it to the student.") -> action(i10,"type the orders into the MS-Access database") -> action(i11,"After typing the orders into the database, ensure that it is completed.") -> action(i13,"At the same time, continue to do the check.") -> branch(b2,XOR) -> action(i12,"control the incoming order.") -> action(i14,"If the order is correct") -> action(i15,"is correct") -> converge(c_rel) -> action(i16,"release it") -> branch(b_rel,XOR) -> converge(c3) -> action(i30,"Once the order is received by PPC") -> action(i31,"Once the order is received by PPC, they will initiate production.") -> action(i37,"After PPC initiates production, the goods will be produced.") -> action(i41,"If not") -> action(i42,"check the quality of the goods.") -> action(i43,"create and send a quality report to the finance department.") -> action(i48,"At the same time, commission the goods and sign and send the memo.") -> branch(b8,AND) -> action(i44,"Release the order via memo") -> action(i45,"and ensure that the memo is achieved in the warehouse.") -> converge(c4) -> action(i50,"Finally, archive the memo and close the order.") -> action(i51,"This marks the end of the process.") -> end(e3)
