Addition
- [N1] Added trace (model 2): init(i1) -> action(n1,"To initiate the process in the Pathology Department, begin with the Gross pathology request that has arrived.") -> action(n3,"create a barcode scan at the start") -> action(n2,"proceed with the Registration gross pathology request") -> action(n4,"assign a container to the gross pathology request") -> action(n6,"pay attention to the scan start") -> action(n7,"pay attention to the scan end") -> action(n8,"pay attention to the scan start again for the Registration gross pathology request (cont.) step") -> action(n5,"Specimen description") -> action(n26,"Simultaneously, complete the following steps:") -> branch(b3,AND) -> action(n10,"Tissue processing") -> action(n11,"check if \"Digitalization?\" is required") -> branch(b1,XOR) -> action(n12,"If the answer is \"yes,\" proceed with Digitalization") -> converge(c3) -> action(n14,"check if \"Digitalization?\" is required again") -> branch(b2,XOR) -> action(n16,"If the answer is \"no,\" continue the process.") -> converge(c1) -> action(n17,"After that, assign cases to the pathologist") -> action(n27,"assign cases to the pathologist") -> action(n18,"Microscopic examination and diagnosis") -> action(n19,"write the pathology report") -> action(n20,"confirm it") -> action(n21,"deliver it") -> action(n22,"proceed with the post-report processing") -> action(n23,"To conclude the pathology procedure, close it.") -> action(n24,"deliver the pathology report") -> action(n25,"complete the post-report processing") -> end(e1)
