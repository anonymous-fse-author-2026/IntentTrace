@startuml
!theme plain
|a_default| Default
|a_default|
start
:Start process;
:claim what is requested;
:check insured status;
:v1: is claimant insured? ({No, Yes}); <<objectSignal>>
if () then ([v1 = 'No'])
:reject claim;
:notify claimant;
:end process rejection;
stop
else ([v1 = 'Yes'])
:If the claimant is insured;
:evaluate claim;
:is claim simple or complex?;
:v2: is claim simple or complex? ({simple, complex}); <<objectSignal>>
if () then ([v2 = 'simple'])
:simple one;
else ([v2 = 'complex'])
:complex one;
endif
:send the relevant forms accordingly;
:Once the forms are returned;
:check forms for completeness;
:v3: are all relevant details provided? ({No, Yes}); <<objectSignal>>
if () then ([v3 = 'No'])
:if not all the relevant details are provided;
:inform the claimant to complete them;
else ([v3 = 'Yes'])
:register claim;
:the process comes to an end;
stop
endif
endif
@enduml