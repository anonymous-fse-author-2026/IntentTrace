action(n7, 'pay attention to the scan end')
action(n8, 'pay attention to the scan start again for the Registration gross pathology request (cont.) step')
action(n9, 'proceed with Macroscopic description writing')
action(n10, 'Simultaneously, complete the following steps:')
branch(b3, AND)
action(n11, 'Tissue processing')
action(n12, 'check if "Digitalization?" is required')
branch(b1, XOR)
action(n13, 'If the answer is "no,"')
action(n14, 'continue the process')
action(n15, 'If the answer is "yes,"')
action(n16, 'proceed with Digitalization')
converge(c_xor1)
converge(c_and)
action(n17, 'check if "Digitalization?" is required again')
branch(b2, XOR)
action(n27, 'If the answer is "no,"')
action(n28, 'continue the process')
action(n29, 'If the answer is "yes,"')
action(n30, 'proceed with Digitalization')
converge(c_xor2)
action(n18, 'After that, assign cases to the pathologist')
action(n19, 'move on to Microscopic examination and diagnosis')
action(n20, 'write the pathology report')
action(n21, 'confirm it')
action(n22, 'deliver it')
action(n23, 'proceed with the post-report processing')
action(n24, 'To conclude the pathology procedure')
action(n25, 'close it')
action(n26, 'Finally, deliver the pathology report and complete the post-report processing.')
end(e1)

defines(v1, "digitalization required", {"Yes", "No"})
defines(v2, "digitalization required again", {"Yes", "No"})

actor(a_default, "Default", [i1, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, b3, n11, n12, b1, n13, n14, n15, n16, c_xor1, c_and, n17, b2, n27, n28, n29, n30, c_xor2, n18, n19, n20, n21, n22, n23, n24, n25, n26, e1])

