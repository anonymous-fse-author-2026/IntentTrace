init(i1)
action(n1, 'To initiate the process in the Pathology Department')
action(n2, 'begin with the Gross pathology request that has arrived')
action(n3, 'create a barcode scan')
action(n4, 'Registration gross pathology request')
action(n5, 'assign a container to the gross pathology request')
