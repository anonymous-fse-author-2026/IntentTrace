      ],
      "justification": "Direct match for the step."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "assign a container to the gross pathology request"
      ],
      "justification": "Direct match for the step."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "create a barcode scan"
      ],
      "justification": "Direct match for the step."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "For the \"Specimen description\" step, pay attention to the scan start"
      ],
      "justification": "Direct match for the step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "pay attention to the scan end"
      ],
      "justification": "Direct match for the step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "pay attention to the scan start again for the Registration gross pathology request (cont.) step"
      ],
      "justification": "Direct match for the step."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "proceed with Macroscopic description writing"
      ],
      "justification": "Direct match for the step."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "Simultaneously, complete the following steps:"
      ],
      "justification": "Captures the parallel split, the converge, and the announcement as an action."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "Tissue processing"
      ],
      "justification": "Direct match for the step."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required"
      ],
      "justification": "Captures the decision step, the XOR split, and the convergence."
    },
    {
      "refs": [
        "action:n13",
        "guard:b1->n13"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\""
      ],
      "justification": "Negative condition for digitalization."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "continue the process"
      ],
      "justification": "Negative branch outcome."
    },
    {
      "refs": [
        "action:n15",
        "guard:b1->n15"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\""
      ],
      "justification": "Positive condition for digitalization."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "proceed with Digitalization"
      ],
      "justification": "Positive branch outcome."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "check if \"Digitalization?\" is required again"
      ],
      "justification": "Captures the second decision step, XOR split, and convergence."
    },
    {
      "refs": [
        "action:n27",
        "guard:b2->n27"
      ],
      "verbatim_texts": [
        "If the answer is \"no,\""
      ],
      "justification": "Negative condition for the second digitalization check (using the identical text phrase)."
    },
    {
      "refs": [
        "action:n28"
      ],
      "verbatim_texts": [
        "continue the process"
      ],
      "justification": "Negative branch outcome for the second check."
    },
    {
      "refs": [
        "action:n29",
        "guard:b2->n29"
      ],
      "verbatim_texts": [
        "If the answer is \"yes,\""
      ],
      "justification": "Positive condition for the second digitalization check."
    },
    {
      "refs": [
        "action:n30"
      ],
      "verbatim_texts": [
        "proceed with Digitalization"
      ],
      "justification": "Positive branch outcome for the second check."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "After that, assign cases to the pathologist"
      ],
      "justification": "Direct match for the step."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "move on to Microscopic examination and diagnosis"
      ],
      "justification": "Direct match for the step."
