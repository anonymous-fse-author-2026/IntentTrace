{
  "elements": [
    {
      "id": "i1",
      "type": "init"
    },
    {
      "id": "n1",
      "type": "action",
      "content": "To initiate the process in the Pathology Department"
    },
    {
      "id": "n2",
      "type": "action",
      "content": "begin with the Gross pathology request that has arrived"
    },
    {
      "id": "n3",
      "type": "action",
      "content": "create a barcode scan"
    },
    {
      "id": "n4",
      "type": "action",
      "content": "Registration gross pathology request"
    },
    {
      "id": "n5",
      "type": "action",
      "content": "assign a container to the gross pathology request"
    },
    {
      "id": "n6",
      "type": "action",
      "content": "For the \"Specimen description\" step, pay attention to the scan start"
    },
    {
      "id": "n7",
      "type": "action",
      "content": "pay attention to the scan end"
    },
    {
      "id": "n8",
      "type": "action",
      "content": "pay attention to the scan start again for the Registration gross pathology request (cont.) step"
    },
    {
      "id": "n9",
      "type": "action",
      "content": "proceed with Macroscopic description writing"
    },
    {
      "id": "n10",
      "type": "action",
      "content": "Simultaneously, complete the following steps:"
    },
    {
      "id": "b3",
      "type": "branch",
      "gateway": "AND"
    },
    {
      "id": "n11",
      "type": "action",
      "content": "Tissue processing"
    },
    {
      "id": "n12",
      "type": "action",
      "content": "check if \"Digitalization?\" is required"
    },
    {
      "id": "b1",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "n13",
      "type": "action",
      "content": "If the answer is \"no,\""
    },
    {
      "id": "n14",
      "type": "action",
      "content": "continue the process"
    },
    {
      "id": "n15",
      "type": "action",
      "content": "If the answer is \"yes,\""
    },
    {
      "id": "n16",
      "type": "action",
      "content": "proceed with Digitalization"
    },
    {
      "id": "c_xor1",
      "type": "converge"
    },
    {
      "id": "c_and",
      "type": "converge"
    },
    {
      "id": "n17",
      "type": "action",
      "content": "check if \"Digitalization?\" is required again"
    },
    {
      "id": "b2",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "n27",
      "type": "action",
      "content": "If the answer is \"no,\""
    },
    {
      "id": "n28",
      "type": "action",
      "content": "continue the process"
    },
    {
      "id": "n29",
      "type": "action",
      "content": "If the answer is \"yes,\""
    },
    {
      "id": "n30",
      "type": "action",
      "content": "proceed with Digitalization"
    },
    {
      "id": "c_xor2",
      "type": "converge"
    },
    {
      "id": "n18",
      "type": "action",
      "content": "After that, assign cases to the pathologist"
    },
    {
      "id": "n19",
      "type": "action",
      "content": "move on to Microscopic examination and diagnosis"
    },
    {
      "id": "n20",
      "type": "action",
      "content": "write the pathology report"
    },
    {
      "id": "n21",
      "type": "action",
      "content": "confirm it"
    },
    {
      "id": "n22",
      "type": "action",
      "content": "deliver it"
    },
    {
      "id": "n23",
      "type": "action",
      "content": "proceed with the post-report processing"
    },
    {
      "id": "n24",
      "type": "action",
      "content": "To conclude the pathology procedure"
    },
    {
      "id": "n25",
      "type": "action",
      "content": "close it"
    },
    {
      "id": "n26",
      "type": "action",
      "content": "Finally, deliver the pathology report and complete the post-report processing."
    },
    {
      "id": "e1",
      "type": "end"
    }
  ],
