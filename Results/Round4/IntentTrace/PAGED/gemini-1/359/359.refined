init(i1)
action(n1, "Start the process by identifying the vacancy")
action(n2, "Is there a suitable candidate available initially")
branch(b1, XOR)
action(n_i2, "If there is no suitable candidate available")
action(n3, "Advertise the vacancy")
action(n_i4, "if there is a suitable candidate available")
action(n_cont, "Continue with the process")
converge(c3)
branch(b2, XOR)
action(n_i6, "If there is still no suitable candidate available")
action(n5, "Advertise the vacancy again")
converge(c1)
action(n6, "Select the appropriate applicant")
action(n7, "Candidate is appointed")
action(n8, "Process ends after candidate appointment")
end(e1)
defines(v1, "Is there a suitable candidate available initially", {"Yes", "No"})
defines(v2, "Is there a suitable candidate available after advertising", {"Yes", "No"})
actor(a_default, "Default", [i1, n1, n2, b1, n_i2, n3, n_i4, n_cont, c3, b2, n_i6, n5, c1, n6, n7, n8, e1])
precedence(i1, n1)
precedence(n1, n2)
precedence(n2, b1)
precedence(b1, n_i2)
precedence(n_i2, n3)
precedence(b1, n_i4)
precedence(n_i4, n_cont)
precedence(n3, c3)
precedence(n5, c3)
precedence(c3, b2)
precedence(b2, n_i6)
precedence(n_i6, n5)
precedence(b2, c1)
precedence(n_cont, c1)
precedence(c1, n6)
precedence(n6, n7)
precedence(n7, n8)
precedence(n8, e1)
guard(b1, n_i2, v1 = "No")
guard(b1, n_i4, v1 = "Yes")
guard(b2, n_i6, v2 = "No")
guard(b2, c1, v2 = "Yes")