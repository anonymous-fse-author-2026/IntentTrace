{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start by identifying the vacancy."
      ],
      "justification": "Starts the process and models the initial vacancy identification step."
    },
    {
      "refs": [
        "action:n2",
        "action:n_i2",
        "guard:b1->n_i2"
      ],
      "verbatim_texts": [
        "If there is no suitable candidate available"
      ],
      "justification": "Models the condition as an action step (which is acceptable), opens the XOR decision, and captures the negative path."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "advertise the vacancy."
      ],
      "justification": "Action step for advertising."
    },
    {
      "refs": [
        "action:n_i4",
        "guard:b1->n_i4"
      ],
      "verbatim_texts": [
        "if there is a suitable candidate available"
      ],
      "justification": "Captures the positive path condition, modeled redundantly as an action and a guard."
    },
    {
      "refs": [
        "action:n_cont"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Action step to continue and structural convergence point."
    },
    {
      "refs": [
        "action:n_i6",
        "guard:b2->n_i6"
      ],
      "verbatim_texts": [
        "If there is still no suitable candidate available"
      ],
      "justification": "Opens the second XOR decision and captures the negative path condition."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "advertise the vacancy again."
      ],
      "justification": "Action step for advertising the vacancy again."
    },
    {
      "refs": [
        "action:n6",
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "proceed with selecting the appropriate applicant."
      ],
      "justification": "Captures the positive path to proceed, the structural convergence, and the selection step. The missing source condition is implicitly covered by this resulting step."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "Once the candidate is appointed"
      ],
      "justification": "Models the candidate appointment as an action step."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "the process comes to an end."
      ],
      "justification": "Models the end of the process as an action step and a structural end event."
    }
  ],
