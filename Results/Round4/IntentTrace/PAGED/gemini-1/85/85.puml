@startuml
!theme plain
|a_default| Default
|a_default|
start
:start process for ACME Company;
:receive customer request;
:check current inventory level;
:v1: inventory level ({at or below the minimum, above the minimum}); <<objectSignal>>
if () then ([v1 = 'at or below the minimum'])
:accept customer request;
:create purchase order;
:review it;
:v2: purchase order ({approved, rejected}); <<objectSignal>>
if () then ([v2 = 'approved'])
:reserve funds;
:send purchase order;
split
:receive packing slip;
:record packing slip;
split again
:receive invoice;
:record invoice;
end split
:release reserved funds and issue payment;
:issue the payment;
:end process;
stop
else ([v2 = 'rejected'])
:rework the purchase order;
:needs to be reworked, review it again;
endif
else ([v1 = 'above the minimum'])
:reject customer request;
:end process for rejected request;
stop
endif
@enduml