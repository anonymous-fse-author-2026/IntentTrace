  "elements": [
    {
      "id": "init1",
      "type": "init"
    },
    {
      "id": "e1",
      "type": "end"
    },
    {
      "id": "i1",
      "type": "action",
      "content": "the first step is"
    },
    {
      "id": "i2",
      "type": "action",
      "content": "advise unsuccessful candidates"
    },
    {
      "id": "b1",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i3",
      "type": "action",
      "content": "If there are \"no more candidates\""
    },
    {
      "id": "i4",
      "type": "action",
      "content": "the position should be re-advertised"
    },
    {
      "id": "i5",
      "type": "action",
      "content": "if the terms and conditions of the offer for a candidate need to be sorted out"
    },
    {
      "id": "i6",
      "type": "action",
      "content": "check if the candidate has accepted a voluntary redundancy"
    },
    {
      "id": "b_vol",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i7",
      "type": "action",
      "content": "the process continues"
    },
    {
      "id": "i8",
      "type": "action",
      "content": "if the candidate has accepted, further investigation is required"
    },
    {
      "id": "c_vol",
      "type": "converge"
    },
    {
      "id": "i9",
      "type": "action",
      "content": "sends an Appointment Approval form"
    },
    {
      "id": "b_app",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i10",
      "type": "action",
      "content": "If the manager is an external resource"
    },
    {
      "id": "i11",
      "type": "action",
      "content": "they may not authorize the form"
    },
    {
      "id": "i40",
      "type": "action",
      "content": "However, if the approver is an existing employee of the client, the process continues."
    },
    {
      "id": "i12",
      "type": "action",
      "content": "If the form is approved"
    },
    {
      "id": "i13",
      "type": "action",
      "content": "sends the form and other documentation, which is received by the client HR"
    },
    {
      "id": "i14",
      "type": "action",
      "content": "scans the completed form and records the position against the stored position in GovSource"
    },
    {
      "id": "b_var",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i15",
      "type": "action",
      "content": "If there are any variations"
    },
    {
      "id": "i16",
      "type": "action",
      "content": "a complete business case is required"
    },
    {
      "id": "i41",
      "type": "action",
      "content": "Otherwise"
    },
    {
      "id": "c_var",
      "type": "converge"
    },
    {
      "id": "i17",
      "type": "action",
      "content": "The Appointment Approval is carried forward."
    },
    {
      "id": "b_med",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i18",
      "type": "action",
      "content": "If the position requires a medical assessment, it is applicable for a 12% rate"
    },
    {
      "id": "i19",
      "type": "action",
      "content": "take up to 21 days to arrange and complete"
    },
    {
      "id": "i20",
      "type": "action",
      "content": "informs the recruitment manager, who then liaises with the HR representative"
    },
    {
      "id": "b_sat",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i21",
      "type": "action",
      "content": "If the assessment is not satisfactory"
    },
    {
      "id": "i22",
      "type": "action",
      "content": "the next candidate on the shortlist should be contacted"
    },
    {
      "id": "i42",
      "type": "action",
      "content": "Otherwise, a medical assessment is not necessary."
    },
    {
      "id": "i43",
      "type": "action",
      "content": "if the assessment is fine"
    },
    {
      "id": "c_med",
      "type": "converge"
    },
    {
      "id": "i23",
      "type": "action",
      "content": "makes a formal verbal offer of employment to the candidate"
    },
    {
      "id": "b_acc",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i24",
      "type": "action",
      "content": "If the candidate accepts"
    },
    {
      "id": "i25",
      "type": "action",
      "content": "creates a formal written offer"
    },
    {
      "id": "i44",
      "type": "action",
      "content": "If the candidate declines"
    },
    {
      "id": "c_acc",
      "type": "converge"
    },
    {
      "id": "i26",
      "type": "action",
      "content": "Simultaneously"
    },
    {
      "id": "i27",
      "type": "action",
      "content": "the commencement pack and letter of appointment are sent to the candidate"
    },
    {
      "id": "i45",
      "type": "action",
      "content": "Once the candidate receives these documents,"
    },
    {
      "id": "b_40",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i28",
      "type": "action",
      "content": "if there is a \"40%\" rate"
    },
    {
      "id": "i29",
      "type": "action",
      "content": "renegotiation is required"
    },
    {
      "id": "b_ren",
      "type": "branch",
      "gateway": "XOR"
    },
    {
      "id": "i30",
      "type": "action",
      "content": "If the renegotiation is successful"
    },
    {
      "id": "i31",
      "type": "action",
      "content": "the next candidate on the shortlist should be identified"
    },
    {
      "id": "i46",
      "type": "action",
      "content": "Otherwise, if the candidate accepts"
    },
    {
      "id": "c_40",
      "type": "converge"
    },
    {
      "id": "i32",
      "type": "action",
      "content": "the process ends"
    }
  ],
