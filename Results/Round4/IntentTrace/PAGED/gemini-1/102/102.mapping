      ],
      "justification": "Captures the supplier sending the invoice."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "Once the packing slip is received, record it"
      ],
      "justification": "Direct match for recording the packing slip."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "when the invoice is received, record it as well"
      ],
      "justification": "Direct match for recording the invoice."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
