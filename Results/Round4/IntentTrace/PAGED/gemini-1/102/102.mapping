{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To begin the process, start with the Resupply Cycle Triggered step"
      ],
      "justification": "Starts the process and initiates the resupply cycle step."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "checking the Inventory Level"
      ],
      "justification": "Direct match for the inventory checking step."
    },
    {
      "refs": [
        "guard:b1->n3"
      ],
      "verbatim_texts": [
        "If the \"Inventory level is at or below the minimum\""
      ],
      "justification": "Opens the decision branch and correctly guards the path where inventory is low."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "proceed to Create Purchase Order"
      ],
      "justification": "Direct match for creating the purchase order."
    },
    {
      "refs": [
        "guard:b1->n4"
      ],
      "verbatim_texts": [
        "if the \"Inventory Level is above the minimum\""
      ],
      "justification": "Guards the alternative path where inventory is sufficient."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "then the process ends"
      ],
      "justification": "Captures the end of the process. The redundant action node preserves behaviour, so it is a valid match."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "Reviewing the Purchase Order"
      ],
      "justification": "Direct match for the review step."
    },
    {
      "refs": [
        "guard:b2->n7"
      ],
      "verbatim_texts": [
        "If the Purchase Order is approved"
      ],
      "justification": "Opens the second decision branch and guards the approval path."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "reserve the funds for the purchase"
      ],
      "justification": "Direct match for reserving funds."
    },
    {
      "refs": [
        "guard:b2->n8"
      ],
      "verbatim_texts": [
        "if the Purchase Order is rejected"
      ],
      "justification": "Guards the rejection path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "rework the order"
      ],
      "justification": "Direct match for reworking the order."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "In case the order needs to be reworked, review the Purchase Order again."
      ],
      "justification": "Direct match for reviewing the reworked order."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "send the Order to Suppliers"
      ],
      "justification": "Direct match for sending the order."
    },
    {
      "refs": [
        "branch:b3"
      ],
      "verbatim_texts": [
        "Simultaneously"
      ],
      "justification": "Models the parallel split for simultaneous events."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "the Supplier sends a packing slip"
      ],
      "justification": "Captures the supplier sending the packing slip."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
