@startuml
!theme plain
|a_default| Default
|a_default|
start
:trigger resupply cycle;
:check inventory level;
:v1: inventory level ({at or below minimum, above minimum}); <<objectSignal>>
if () then ([v1 = "at or below minimum"])
:create purchase order;
:review purchase order;
:v2: purchase status ({rejected, approved}); <<objectSignal>>
if () then ([v2 = "rejected"])
:rework purchase order;
:Rework the purchase order and then review it.;
else ([v2 = "approved"])
:reserve funds;
:send order to supplier;
split
:receive packing slip;
:record packing slip;
split again
:receive invoice;
:record invoice;
end split
endif
else ([v1 = "above minimum"])
->;
endif
stop
@enduml