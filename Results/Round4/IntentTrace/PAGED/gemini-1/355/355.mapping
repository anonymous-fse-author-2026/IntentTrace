{
  "matches": [
    {
      "refs": [
        "action:i2"
      ],
      "verbatim_texts": [
        "To begin the process, start by checking the customer's order."
      ],
      "justification": "Starts the process and models the initial order checking step."
    },
    {
      "refs": [
        "action:i3",
        "guard:b1->i3"
      ],
      "verbatim_texts": [
        "If the customer is a registered customer,"
      ],
      "justification": "Condition captured as action, split node, and guard."
    },
    {
      "refs": [
        "action:i4"
      ],
      "verbatim_texts": [
        "then check their payment morale."
      ],
      "justification": "Direct match for the action step."
    },
    {
      "refs": [
        "action:i5",
        "guard:b1->i5"
      ],
      "verbatim_texts": [
        "If they are a new customer,"
      ],
      "justification": "Captures the alternative branch and guard."
    },
    {
      "refs": [
        "action:i6"
      ],
      "verbatim_texts": [
        "then check their status."
      ],
      "justification": "Direct match for the action."
    },
    {
      "refs": [
        "action:i7",
        "guard:b2->i7"
      ],
      "verbatim_texts": [
        "If their payment morale is good,"
      ],
      "justification": "Condition modeled as action, branch gateway, and guard."
    },
    {
      "refs": [
        "action:i8"
      ],
      "verbatim_texts": [
        "continue with the process."
      ],
      "justification": "Continues process flow as stated."
    },
    {
      "refs": [
        "action:i9",
        "guard:b2->i9"
      ],
      "verbatim_texts": [
        "If their payment morale is bad"
      ],
      "justification": "Negative condition captured."
    },
    {
      "refs": [
        "action:i10",
        "guard:b3->i10"
      ],
      "verbatim_texts": [
        "or if they are an end customer,"
      ],
      "justification": "Alternative condition mapped as action, gateway, and guard."
    },
    {
      "refs": [
        "action:i11"
      ],
      "verbatim_texts": [
        "reject the order"
      ],
      "justification": "Rejection step and convergence point."
    },
    {
      "refs": [
        "action:i12"
      ],
      "verbatim_texts": [
        "and end the process."
      ],
      "justification": "Modeled as an action and a formal end node."
    },
    {
      "refs": [
        "action:i13",
        "guard:b3->i13"
      ],
      "verbatim_texts": [
        "If the customer is a wholesaler,"
      ],
      "justification": "Wholesaler condition and guard."
    },
    {
      "refs": [
        "action:i14"
      ],
      "verbatim_texts": [
        "enter their data and take the order."
      ],
      "justification": "Data entry action."
    },
    {
      "refs": [
        "action:i15"
      ],
      "verbatim_texts": [
        "At the same time,"
      ],
      "justification": "Parallelism announcer mapped redundantly as an action."
    },
    {
      "refs": [
        "action:i16"
      ],
      "verbatim_texts": [
        "check the availability of the items."
      ],
      "justification": "Action and routing node for availability checking."
    },
    {
      "refs": [
        "action:i17",
        "guard:b4->i17"
      ],
      "verbatim_texts": [
        "If the items are out of stock,"
      ],
      "justification": "Condition matched to gateway, guard, and action."
    },
    {
      "refs": [
        "action:i18"
      ],
      "verbatim_texts": [
        "start production."
      ],
      "justification": "Production action."
    },
    {
      "refs": [
        "guard:b4->i19"
      ],
      "verbatim_texts": [
        "If they are in stock,"
      ],
      "justification": "Guard for the in-stock branch."
    },
    {
      "refs": [
        "action:i19"
      ],
      "verbatim_texts": [
        "Once the availability is checked,"
      ],
      "justification": "Condition mapped redundantly as an action."
    },
    {
      "refs": [
        "action:i20"
      ],
      "verbatim_texts": [
        "send the order confirmation."
      ],
      "justification": "Action step."
    },
    {
      "refs": [
        "action:i21"
      ],
