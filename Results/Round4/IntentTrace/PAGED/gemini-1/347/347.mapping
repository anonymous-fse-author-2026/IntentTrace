{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME"
      ],
      "justification": "Implicitly starts the process and captures the initial action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "begin with the New Resupply Cycle"
      ],
      "justification": "Captures the action to begin the resupply cycle."
    },
    {
      "refs": [
        "action:n3"
      ],
      "verbatim_texts": [
        "Check Levels of Inventory"
      ],
      "justification": "Action to check inventory levels."
    },
    {
      "refs": [
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "is below or equal to the minimum"
      ],
      "justification": "Condition for below or equal to minimum."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report"
      ],
      "justification": "Action to generate the report."
    },
    {
      "refs": [
        "guard:b1->n6"
      ],
      "verbatim_texts": [
        "is greater than the minimum"
      ],
      "justification": "Condition for greater than minimum."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report"
      ],
      "justification": "Action to generate above minimum report."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is equal to or below the minimum, create Purchase Orders (POs)"
      ],
      "justification": "Action capturing the creation of POs based on the report."
    },
    {
      "refs": [
        "action:n9"
      ],
      "verbatim_texts": [
        "the process ends"
      ],
      "justification": "Captures the process ending on the above minimum path."
    },
    {
      "refs": [
        "branch:b4"
      ],
      "verbatim_texts": [
        "If the PO"
      ],
      "justification": "Branching structure for PO review."
    },
    {
      "refs": [
        "guard:b4->n11"
      ],
      "verbatim_texts": [
        "is rejected"
      ],
      "justification": "Condition mapping to rejected PO."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "needs to be reworked"
      ],
      "justification": "Action for reworking the PO."
    },
    {
      "refs": [
        "guard:b4->n13"
      ],
      "verbatim_texts": [
        "is approved"
      ],
      "justification": "Condition mapping to approved PO."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "is printed and released in the system"
      ],
      "justification": "Action for printing and releasing the PO."
    },
    {
      "refs": [
        "action:n17"
      ],
      "verbatim_texts": [
        "needs to be reviewed"
      ],
      "justification": "Action to review the PO."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "needs to be created again"
      ],
      "justification": "Action to recreate the PO if needed."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "Simultaneously, reserve funds for the released POs"
      ],
      "justification": "Captures the AND split, corresponding converge, and the action to reserve funds."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "mail the POs to the supplier"
      ],
      "justification": "Action for mailing the POs."
    },
    {
      "refs": [
        "action:n24"
      ],
      "verbatim_texts": [
