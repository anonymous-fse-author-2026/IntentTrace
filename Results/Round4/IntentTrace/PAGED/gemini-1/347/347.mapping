      "verbatim_texts": [
        "receive the Invoice"
      ],
      "justification": "Action to receive invoice."
    },
    {
      "refs": [
        "action:n32"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match"
      ],
      "justification": "Action for three-way match."
    },
    {
      "refs": [
        "action:n43"
      ],
      "verbatim_texts": [
        "release the funds"
      ],
      "justification": "Action to release funds."
    },
