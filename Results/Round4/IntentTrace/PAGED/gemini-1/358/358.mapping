{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "In the beginning,"
      ],
      "justification": "Initializes the process and models the starting step."
    },
    {
      "refs": [
        "guard:b2->c1"
      ],
      "verbatim_texts": [
        "if the answer is \"No\", then we continue the process."
      ],
      "justification": "Models the first conditional branch and its normal continuation flow."
    },
    {
      "refs": [
        "guard:b2->n3",
        "action:n3"
      ],
      "verbatim_texts": [
        "If the answer is \"No\" again, we continue the process."
      ],
      "justification": "Captures the 'No again' branch and its corresponding action."
    },
    {
      "refs": [
        "guard:b2->n5"
      ],
      "verbatim_texts": [
        "However, if the answer is \"Yes\","
      ],
      "justification": "Captures the positive condition out of the first branch."
    },
    {
      "refs": [
        "action:n5",
        "action:n14"
      ],
      "verbatim_texts": [
        "then we give it priority."
      ],
      "justification": "Models the actions of assigning priority, occurring at multiple points."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "we look up the Vendor on SAP."
      ],
      "justification": "Models the paths converging and executing the vendor lookup step."
    },
    {
      "refs": [
        "guard:b3->n8"
      ],
      "verbatim_texts": [
        "If the answer is \"No\","
      ],
      "justification": "Opens the second decision gateway and handles the negative path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "we need a Vendor master record"
      ],
      "justification": "Captures the requirement step for a missing vendor."
    },
    {
      "refs": [
        "action:n9",
        "action:n19"
      ],
      "verbatim_texts": [
        "and the process ends."
      ],
      "justification": "Covers multiple endpoints where the process terminates gracefully."
    },
    {
      "refs": [
        "guard:b3->n10"
      ],
      "verbatim_texts": [
        "But if the answer is \"Yes\","
      ],
      "justification": "Models the positive path for an existing vendor."
    },
    {
      "refs": [
        "action:n10",
        "action:n16"
      ],
      "verbatim_texts": [
        "then we enter the invoice in SAP."
      ],
      "justification": "Captures the step of entering invoices at the respective process stages."
    },
    {
      "refs": [
        "guard:b3->n14"
      ],
      "verbatim_texts": [
        "if the answer is \"Yes\""
      ],
      "justification": "Models the subsequent repeated positive condition."
    },
    {
      "refs": [
        "guard:b4->n16",
        "guard:b4->e5"
      ],
      "verbatim_texts": [
        "And if the answer is \"Yes\" again"
      ],
      "justification": "Models the 'Yes again' gateway, its condition, and effectively handles the implicit unstated alternative path."
    },
    {
      "refs": [
        "action:n18"
      ],
      "verbatim_texts": [
        "we place the entered invoices in the normal Outbox"
      ],
      "justification": "Models the merging of branches into the outbox placement action."
    }
  ],
