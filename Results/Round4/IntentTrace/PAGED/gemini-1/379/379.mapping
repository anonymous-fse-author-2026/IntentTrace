{
  "matches": [
    {
      "refs": [
        "action:n1"
      ],
      "verbatim_texts": [
        "To start the process for ACME, begin with the New Resupply Cycle"
      ],
      "justification": "Initiates the process and defines the first action."
    },
    {
      "refs": [
        "action:n2"
      ],
      "verbatim_texts": [
        "Check Levels of Inventory"
      ],
      "justification": "Matches the check inventory action."
    },
    {
      "refs": [
        "guard:b1->n4",
        "guard:b1->n5"
      ],
      "verbatim_texts": [
        "If the inventory is below or equal to the minimum"
      ],
      "justification": "Captures the decision branch and its binary outcomes based on the inventory level condition."
    },
    {
      "refs": [
        "action:n4"
      ],
      "verbatim_texts": [
        "generate an Equal to or below minimum Report"
      ],
      "justification": "Matches the report generation for low inventory."
    },
    {
      "refs": [
        "action:n5"
      ],
      "verbatim_texts": [
        "generate an Above Minimum Report"
      ],
      "justification": "Matches the report generation for adequate inventory."
    },
    {
      "refs": [
        "action:n7"
      ],
      "verbatim_texts": [
        "create Purchase Orders (POs)"
      ],
      "justification": "Matches the creation of POs."
    },
    {
      "refs": [
        "action:n6"
      ],
      "verbatim_texts": [
        "If the report indicates that the inventory is above the minimum, the process ends."
      ],
      "justification": "Correctly describes ending the process for the above minimum path."
    },
    {
      "refs": [
        "action:n8"
      ],
      "verbatim_texts": [
        "it needs to be reviewed"
      ],
      "justification": "Matches the review of the PO."
    },
    {
      "refs": [
        "guard:b2->n11"
      ],
      "verbatim_texts": [
        "If the PO is rejected"
      ],
      "justification": "Captures the rejected branch of the PO review decision."
    },
    {
      "refs": [
        "action:n11"
      ],
      "verbatim_texts": [
        "it needs to be reworked"
      ],
      "justification": "Matches the rework action for rejected POs."
    },
    {
      "refs": [
        "guard:b2->n10"
      ],
      "verbatim_texts": [
        "If the PO is approved"
      ],
      "justification": "Captures the approved branch of the PO review decision."
    },
    {
      "refs": [
        "action:n10"
      ],
      "verbatim_texts": [
        "it is printed and released in the system."
      ],
      "justification": "Matches the print and release action for approved POs."
    },
    {
      "refs": [
        "action:n22"
      ],
      "verbatim_texts": [
        "If the PO needs to be reworked, it needs to be created again."
      ],
      "justification": "Matches the recreation step and provides the structural convergence point for the rework loop."
    },
    {
      "refs": [
        "action:n12"
      ],
      "verbatim_texts": [
        "reserve funds for the released POs"
      ],
      "justification": "Captures the parallel split and matches the funds reservation action."
    },
    {
      "refs": [
        "action:n13"
      ],
      "verbatim_texts": [
        "mail the POs to the supplier"
      ],
      "justification": "Matches mailing the POs."
    },
    {
      "refs": [
        "action:n14"
      ],
      "verbatim_texts": [
        "receive the Packing Slip"
      ],
      "justification": "Matches receiving the packing slip and provides the structural convergence point for parallel activities."
    },
    {
      "refs": [
        "action:n15"
      ],
      "verbatim_texts": [
        "receive the inventory"
      ],
      "justification": "Matches receiving the inventory."
    },
    {
      "refs": [
        "action:n16"
      ],
      "verbatim_texts": [
        "receive the Invoice"
      ],
      "justification": "Matches receiving the invoice."
    },
    {
      "refs": [
        "action:n17",
        "action:n18"
      ],
      "verbatim_texts": [
        "proceed to the Three-way match"
      ],
      "justification": "Matches the action of proceeding to and executing the three-way match. Splitting the action is behaviourally equivalent."
    },
    {
      "refs": [
        "action:n19"
      ],
      "verbatim_texts": [
        "release the funds"
      ],
      "justification": "Matches releasing funds."
    },
    {
      "refs": [
        "action:n20"
      ],
      "verbatim_texts": [
        "issue the payment"
      ],
      "justification": "Matches issuing payment."
    },
    {
      "refs": [
        "action:n21"
      ],
      "verbatim_texts": [
        "the Resupply Cycle is complete and the process ends."
      ],
      "justification": "Matches the final wrap-up step and the structural end of the process."
    }
  ],
