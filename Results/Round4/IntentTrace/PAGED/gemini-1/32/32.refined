init(i1)
action(n1, "start")
converge(c1)
action(n2, "Enter Expenses")
action(n3, "Generate Spreadsheet")
action(n4, "Approval Check 1")
branch(b1, XOR)
action(n5, "Payout")
action(n6, "Approval Check 2")
branch(b2, XOR)
action(n7, "Payout")
end(i12)
converge(c2)
action(n8, "goes back to entering expenses")
defines(v1, "Approval Check 1", {"Approved", "Not Approved"})
defines(v2, "Approval Check 2", {"Approved", "Not Approved"})
actor(a_default, "Default", [i1, n1, c1, n2, n3, n4, b1, n5, n6, b2, n7, i12, c2, n8])
precedence(i1, n1)
precedence(n1, c1)
precedence(c1, n2)
precedence(n2, n3)
precedence(n3, n4)
precedence(n4, b1)
precedence(b1, n5)
precedence(b1, c2)
precedence(n5, n6)
precedence(n6, b2)
precedence(b2, n7)
precedence(b2, c2)
precedence(n7, i12)
precedence(c2, n8)
precedence(n8, c1)
guard(b1, n5, v1 = "Approved")
guard(b1, c2, v1 = "Not Approved")
guard(b2, n7, v2 = "Approved")
guard(b2, c2, v2 = "Not Approved")
label(b1, c2, "If the request is not approved")
label(b1, n5, "if the request is approved")
label(b2, c2, "If it is not approved")
label(b2, n7, "if it is approved")