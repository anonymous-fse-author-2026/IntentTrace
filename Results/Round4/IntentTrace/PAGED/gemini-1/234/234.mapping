  "mutations": [
    {
      "refs": [
        "guard:b2->i11"
      ],
      "verbatim_texts": [
        "control the incoming order",
        "continue to do the check",
        "If the order is correct",
        "if the order is incorrect"
      ],
      "reason": "The model erroneously applies the 'Correct' and 'Incorrect' decision outcomes to route *into* the checking tasks themselves ('control the incoming order' and 'continue to do the check'), rather than applying them after the check is performed. This reverses the causal order and significantly changes the logical flow."
    },
    {
      "refs": [
        "guard:b2->i12"
      ],
      "verbatim_texts": [
        "control the incoming order",
        "continue to do the check",
        "If the order is correct",
        "if the order is incorrect"
      ],
      "reason": "The model erroneously applies the 'Correct' and 'Incorrect' decision outcomes to route *into* the checking tasks themselves ('control the incoming order' and 'continue to do the check'), rather than applying them after the check is performed. This reverses the causal order and significantly changes the logical flow."
    }
  ],
