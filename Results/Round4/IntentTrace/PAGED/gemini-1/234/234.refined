action(i18, "If the order is worth")
branch(b3, XOR)
action(i19, "less than 5.000 €")
action(i20, "more than 5.000 €")
action(i21, "send it for sign off")
action(i23, "contact the client")
action(i28, "If the issue can be solved")
converge(c3)
action(i24, "release the order")
action(i25, "Once the order is received by PPC, they will initiate production.")
branch(b4, XOR)
action(i26, "If the issue cannot be solved")
action(i27, "cancel the order.")
action(i29, "After PPC initiates production, the goods will be produced.")
converge(c5)
branch(b5, XOR)
action(i30, "If the order needs to be cancelled")
action(i31, "the process ends.")
end(e1)
action(i32, "If not")
action(i33, "check the quality of the goods.")
action(i34, "create and send a quality report to the finance department.")
action(i35, "Release the order via memo and ensure that the memo is achieved in the warehouse.")
branch(b6, AND)
action(i36, "Send the invoice")
action(i37, "report the achievement to the finance department.")
action(i38, "commission the goods")
action(i39, "sign and send the memo")
action(i40, "Also, send the goods")
converge(c4)
action(i41, "ensure that the signed memo is achieved in the logistic department.")
action(i42, "Finally, archive the memo")
action(i43, "close the order.")
action(i44, "This marks the end of the process.")
end(e2)

