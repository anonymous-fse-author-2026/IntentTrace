init(i1)
action(i2, "begin by supplying the requirement and then documenting it")
branch(b1, XOR)
action(i3, "If the order is received")
action(i4, "via fax, input the order into an Excel file")
action(i5, "If the order is received via mail or phone, also input the order into an Excel file")
converge(c1)
action(i6, "Once the Excel list is complete")
action(i7, "send it to the student.")
action(i8, "Upon receiving the Excel list")
action(i9, "type the orders into the MS-Access database.")
action(i10, "ensure that it is completed")
