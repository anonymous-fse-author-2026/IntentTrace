@startuml
!theme plain
|a_default| Default
|a_default|
start
:To start, please provide the userdata for flickr.;
:v_login1: login status 1 ({Successful, Fails}); <<objectSignal>>
if () then ([v_login1 = 'Successful'])
:If the login is successful,;
:the process will end.;
stop
else ([v_login1 = 'Fails'])
:if the login fails,;
:v_fail1: fail decision 1 ({Try, Abort}); <<objectSignal>>
if () then ([v_fail1 = 'Abort'])
:if you choose to abort,;
:the process will end.;
stop
else ([v_fail1 = 'Try'])
:If you want to try again,;
:please provide the userdata for flickr.;
:v_login2: login status 2 ({Successful, Fails}); <<objectSignal>>
if () then ([v_login2 = 'Successful'])
:If the login is successful,;
:the process will end.;
stop
else ([v_login2 = 'Fails'])
:if the login fails,;
:v_fail2: fail decision 2 ({StillTry, DecideAbort}); <<objectSignal>>
if () then ([v_fail2 = 'DecideAbort'])
:if you decide to abort,;
:the process will end.;
stop
else ([v_fail2 = 'StillTry'])
:If you still want to try again,;
:please provide the userdata for flickr.;
stop
endif
endif
endif
endif
@enduml