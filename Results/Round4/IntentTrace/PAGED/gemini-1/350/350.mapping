      "verbatim_texts": [
        "To start, please provide the userdata for flickr."
      ],
      "justification": "Matches the initial process start and the first action of providing user data."
    },
    {
      "refs": [
        "action:i3",
        "guard:b_login1->i3",
        "action:i3_2",
        "guard:b_login2->i3_2"
      ],
      "verbatim_texts": [
        "If the login is successful,"
      ],
      "justification": "Captures the successful login conditions across the first and second attempts. Modeling conditions as both guards and actions is redundant but behavior-preserving."
    },
    {
      "refs": [
        "action:i4",
        "action:i4_2",
        "action:i4_3",
        "action:i4_4"
      ],
      "verbatim_texts": [
        "the process will end."
      ],
      "justification": "Maps to all the structural end nodes and corresponding restatement actions where the process explicitly finishes."
    },
    {
      "refs": [
        "action:i5",
        "guard:b_login1->i5",
        "action:i5_2",
        "guard:b_login2->i5_2"
      ],
      "verbatim_texts": [
        "if the login fails,"
      ],
      "justification": "Matches the failed login conditions and sets up the subsequent branches (XOR) for the user's next choice."
    },
    {
      "refs": [
        "action:i7",
        "guard:b_fail1->i7"
      ],
      "verbatim_texts": [
        "if you choose to abort,"
      ],
      "justification": "Captures the first abort choice correctly."
    },
    {
      "refs": [
        "action:i6",
        "guard:b_fail1->i6"
      ],
      "verbatim_texts": [
        "If you want to try again,"
      ],
      "justification": "Captures the first try-again choice correctly."
    },
    {
      "refs": [
        "action:i2",
        "action:i2_2"
      ],
      "verbatim_texts": [
        "please provide the userdata for flickr."
      ],
      "justification": "Maps the subsequent actions of providing user data, branching based on the login result, and structurally ending when no further steps are defined."
    },
    {
      "refs": [
        "action:i8",
        "guard:b_fail2->i8"
      ],
      "verbatim_texts": [
        "If you still want to try again,"
      ],
      "justification": "Captures the second try-again choice accurately."
