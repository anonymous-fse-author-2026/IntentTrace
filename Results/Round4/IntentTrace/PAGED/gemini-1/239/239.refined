init(i1)
action(n2, "look at the order")
branch(b1, XOR)
action(n3, "If the order is to be rejected")
action(n4, "the process should continue")
end(e3)
action(n5, "If the order is to be accepted, the process should also continue.")
branch(b2, AND)
action(n7, "preparing the assembling order")
action(n8, "checking availability")
branch(b3, XOR)
action(n9, "If there is a backorder")
action(n10, "availability needs to be checked again")
action(n11, "the process ends")
end(e1)
action(n12, "If the item can be reserved, the process should continue.")
converge(c2)
action(n13, "The next steps are to assemble the bike")
action(n14, "ship the product")
end(e2)

defines(v1, "Order Rejected", {"Yes", "No"})
defines(v2, "Backorder Required", {"Yes", "No"})

actor(a_default, "Default", [i1, n2, b1, n3, n4, e3, n5, b2, n7, n8, b3, n9, n10, n11, e1, n12, c2, n13, n14, e2])

precedence(i1, n2)
precedence(n2, b1)
precedence(b1, n3)
precedence(n3, n4)
precedence(n4, e3)
precedence(b1, n5)
precedence(n5, b2)
precedence(b2, n7)
precedence(n7, c2)
precedence(b2, n8)
precedence(n8, b3)
precedence(b3, n9)
precedence(n9, n10)
precedence(n10, n11)
precedence(n11, e1)
precedence(b3, n12)
precedence(n12, c2)
precedence(c2, n13)
precedence(n13, n14)
precedence(n14, e2)

guard(b1, n3, v1 = "Yes")
guard(b1, n5, v1 = "No")
guard(b3, n9, v2 = "Yes")
guard(b3, n12, v2 = "No")