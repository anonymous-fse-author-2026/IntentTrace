init(in)
action(i1, 'To start the ExpenseReport process, begin by clicking on "Start" and then selecting "Edit Report"')
branch(b1, XOR)
action(i2, "If the expense is greater than 1000")
action(i3, "the report should be reviewed")
action(i8, "evaluate the review decision")
branch(b2, XOR)
action(i9, "If the report is rejected")
converge(c4)
action(i10, "edit the report")
action(i11, "If it is approved")
converge(c2)
action(i4, "check if there is a need for translation")
branch(b3, XOR)
action(i5, "If translation is required")
action(i6, "translate the receipts")
action(i12, "confirm them")
converge(c3)
action(i7, "confirm the receipts")
action(i13, "evaluate the receipts decision")
branch(b4, XOR)
action(i14, "If the receipts are accepted")
action(i15, "process the expense")
action(i16, "and then ending it")
end(e1)
defines(v1, "Is expense greater than 1000", {"Yes", "No"})
defines(v2, "Is translation needed", {"Yes", "No"})
defines(v4, "Is report rejected after review", {"Yes", "No"})
defines(v10, "Are receipts accepted", {"Yes", "No"})
actor(a_default, "Default", [in, i1, b1, i2, i3, i8, b2, i9, c4, i10, i11, c2, i4, b3, i5, i6, i12, c3, i7, i13, b4, i14, i15, i16, e1])
precedence(in, i1)
precedence(i1, b1)
precedence(b1, i2)
precedence(b1, c2)
precedence(i2, i3)
precedence(i3, i8)
precedence(i8, b2)
precedence(b2, i9)
precedence(b2, i11)
precedence(i9, c4)
precedence(i11, c2)
precedence(c2, i4)
precedence(i4, b3)
precedence(b3, i5)
precedence(b3, i7)
precedence(i5, i6)
precedence(i6, i12)
precedence(i12, c3)
precedence(i7, c3)
precedence(c3, i13)
precedence(i13, b4)
precedence(b4, i14)
precedence(b4, c4)
precedence(c4, i10)
precedence(i10, e1)
precedence(i14, i15)
precedence(i15, i16)
precedence(i16, e1)
guard(b1, i2, v1 = "Yes")
guard(b1, c2, v1 = "No")
guard(b2, i9, v4 = "Yes")
guard(b2, i11, v4 = "No")
guard(b3, i5, v2 = "Yes")
guard(b3, i7, v2 = "No")
guard(b4, i14, v10 = "Yes")
guard(b4, c4, v10 = "No")